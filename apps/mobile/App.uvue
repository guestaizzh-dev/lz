<script setup lang="uts">
    import {startStudySync,studyForeground} from './lib/study-queue'
    import {restoreSession,currentUser,sessionGeneration,sessionNotice} from './lib/session'
    import {request} from './lib/api'
    import type {AppUser} from './lib/session'
    import {refreshPush} from './lib/notifications'
    import {shareCodeFromScheme} from './lib/share-link'
    async function checkSession(){restoreSession();if(sessionNotice.value)uni.showToast({title:sessionNotice.value,icon:'none'});if(!currentUser.value)return;const generation=sessionGeneration();try{const user=await request<AppUser>('/auth/me');if(generation===sessionGeneration())currentUser.value=user;}catch(e){}}

	// #ifdef APP-ANDROID || APP-HARMONY
	let firstBackTime = 0
	// #endif

	onLaunch(() => {
		startStudySync()
        // #ifdef APP
        uni.loadFontFace({ global: true, family: 'AcademySans', source: "url('/static/fonts/AcademySans.otf')" })
        uni.loadFontFace({ global: true, family: 'AcademySerif', source: "url('/static/fonts/AcademySerif.ttf')" })
        uni.loadFontFace({ global: true, family: 'AcademyCalligraphy', source: "url('/static/fonts/AcademyCalligraphy.ttf')" })
        // #endif
	})

	onAppShow((options) => {
		studyForeground(true)
        void checkSession().then(()=>refreshPush()).catch(()=>{})
        const invitation=/^daoxueacademy:\/\/invite\?code=([A-F0-9]{16})$/.exec(options.appScheme??'')
        if(invitation)setTimeout(()=>uni.navigateTo({url:'/pages/marketing/referrals?code='+invitation[1]}),0)
        const shareCode=shareCodeFromScheme(options.appScheme??'')
        if(shareCode)setTimeout(()=>uni.navigateTo({url:'/pages/shared/index?code='+encodeURIComponent(shareCode)}),0)
	})

	onAppHide(() => {
		studyForeground(false)
	})

	// #ifdef APP-ANDROID || APP-HARMONY
	onLastPageBackPress(() => {
		console.log('App LastPageBackPress')
		if (firstBackTime == 0) {
			uni.showToast({
				title: '再按一次退出应用',
				position: 'bottom',
			})
			firstBackTime = Date.now()
			setTimeout(() => {
				firstBackTime = 0
			}, 2000)
		} else if (Date.now() - firstBackTime < 2000) {
			firstBackTime = Date.now()
			uni.exit()
		}
	})

	onExit(() => {
		console.log('App Exit')
	})
	// #endif
</script>

<style>
	/* #ifdef WEB */
	@font-face { font-family: AcademyCalligraphy; src: url('/static/fonts/AcademyCalligraphy.ttf'); font-display: swap; }
	@font-face { font-family: AcademySerif; src: url('/static/fonts/AcademySerif.ttf'); font-weight: 500; font-display: swap; }
	@font-face { font-family: AcademySans; src: url('/static/fonts/AcademySans.otf'); font-weight: 400; font-display: swap; }
	page, body, uni-page-body { background-color:#F5F0E6; font-family: AcademySans, -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif; }
	uni-button::after { border: none; }
	uni-button, uni-input, uni-textarea { box-sizing:border-box; }
	uni-button { transition:background-color 140ms ease,opacity 140ms ease,box-shadow 140ms ease; }
	uni-button:focus-visible, a:focus-visible, [role="tab"]:focus-visible { outline:2px solid #235663;outline-offset:3px; }
	uni-input:focus-within, uni-textarea:focus-within { outline:2px solid #235663;outline-offset:2px; }
	uni-input input:focus, uni-textarea textarea:focus { outline:none; }
	uni-input input, uni-textarea textarea { caret-color:#235663; }
	uni-button[disabled], uni-button[aria-disabled="true"] { opacity:0.5;cursor:not-allowed; }
	.primary-button[disabled], .bar-primary[disabled], .compose-submit[disabled] { background-color:#235663!important;color:#FCF9F2!important; }
	@media (hover:hover) and (pointer:fine) {
		uni-button:not([disabled]):not([aria-disabled="true"]):hover { opacity:0.86; }
	}
	@media (prefers-reduced-motion:reduce) {
		uni-button { transition:none; }
		.section { animation:none!important; }
	}
	@media (min-width:600px) {
		.login-content { max-width:440px;box-sizing:border-box;width:100%;margin:0 auto; }
	}
	/* #endif */
	/* Native button/view hover classes provide touch feedback without extra event handlers. */
	.button-hover, .row-pressed { opacity:0.78; }
	/*每个页面公共css */
	.uni-row {
		flex-direction: row;
	}

	.uni-column {
		flex-direction: column;
	}
</style>
