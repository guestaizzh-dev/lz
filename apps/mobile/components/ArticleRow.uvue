<template>
<view hover-class="row-pressed" class="article-row" @click="goArticle(article.id)">
<ArtImage :src="article.cover" :kind="artwork(article.cover)" :width="92" :height="100" />
<view class="article-copy">
<text class="article-name">{{article.title}}</text>
<text class="article-caption">{{article.summary}}</text>
<text class="article-meta">{{article.categoryLabel??article.category}} · {{article.visibility==='MEMBER'?'会员专享':article.author}}</text>
</view>
</view>
</template>
<script setup lang="ts">
import ArtImage from './ArtImage.uvue';
import { goArticle } from '../lib/api';
import type { Article } from '../lib/api';
import { artwork } from '../lib/presentation';
defineProps<{article: Article}>();
</script>
<style>.article-row{border-style:solid;border-width:0;flex-direction:row;padding:14px 0;border-bottom-width:1px;border-bottom-color:#E3DCCF;}.article-copy{flex:1;min-width:0;padding-left:13px;}.article-name{font-family:AcademySerif;color:#182B31;font-size:16.5px;font-weight:600;line-height:25px;}.article-caption{font-family:AcademySans;font-size:13px;color:#5F6B6E;line-height:21px;margin-top:5px;max-height:42px;overflow:hidden;}.article-meta{font-family:AcademySans;font-size:11px;color:#6A7578;line-height:18px;margin-top:7px;}</style>
