<template>
  <view v-if="items.length || error" class="section"
    ><text class="ui-text section-heading">一起研习 · 训练营</text
    ><button
      v-for="c in items"
      :key="c.id"
      class="ui-button cohort-link"
      @click="openPage('cohort/detail?id=' + c.id)"
      ><text class="ui-text item-title">{{ c.title }}</text
      ><text class="ui-text meta"
        >{{ formatChinaDate(c.startsAt) }} — {{ formatChinaDate(c.endsAt) }} ·
        {{ c.enrolled ? '已报名' : '剩余' + c.available + '席' }} ›</text
      ></button
    ><button v-if="error" class="ui-button text-button" @click="load"
      >营期加载失败，点击重试</button
    ></view
  >
</template>
<script setup lang="ts">
import { pageRefresh } from '../lib/page-refresh';
import { request } from '../lib/api';
import { openPage } from '../lib/presentation';
import { formatChinaDate } from '../lib/date-time';
import type { Cohort } from '../lib/cohorts';
const props = defineProps<{ courseId: string }>(),
  items = ref<Cohort[]>([]),
  error = ref('');
let generation = 0;
async function load() {
  if (!props.courseId) return;
  const run = ++generation;
  try {
    const r = await request<Cohort[]>('/cohorts/courses/' + props.courseId);
    if (run === generation) {
      items.value = r;
      error.value = '';
    }
  } catch (e) {
    if (run === generation) error.value = (e as Error).message;
  }
}
watch(
  () => props.courseId,
  () => {
    items.value = [];
    void refreshPanel(true);
  },
  { immediate: false },
);
const refreshPanel = pageRefresh(load, () => !error.value);
onMounted(() => void refreshPanel());
defineExpose({ refresh: refreshPanel });
</script>
<style>
@import '../styles/app.css';
.cohort-link {
  border-width: 0;
  border-style: solid;
  white-space: normal;
  text-align: left;
  padding: 14px 0;
  margin: 0;
  background-color: transparent;
  border-bottom: 1px solid #e3dccf;
  line-height: 25px;
}
</style>
