<template><view v-if="orderId||eligible" class="reward-note"><text class="reward-title">消费奖励</text><text v-if="loading" class="meta">正在读取奖励规则…</text><template v-else-if="data"><text v-if="data!.reward" class="body-copy">{{data!.reward!.statusText??consumptionStates[data!.reward!.state]??data!.reward!.state}} · 当前 {{data!.reward!.points}} 积分 / {{data!.reward!.growth}} 成长值</text><text v-if="data!.reward?.state==='OBSERVATION'&&data!.reward!.eligibleAt" class="meta">预计 {{formatChinaTime(data!.reward!.eligibleAt)}}（北京）结算，实际退款及履约变化会重新核对。</text><text class="footer-note" :user-select="true">{{data!.text}}</text><button v-if="orderId&&data!.enabled" class="text-action" @click="openPage('profile/progression')">查看积分与结算明细 ›</button></template><view v-else-if="error"><text class="meta">{{error}}</text><button class="text-action" @click="load">重试读取奖励规则 ›</button></view></view></template>
<script setup lang="ts">
import {request} from '../lib/api';import {currentUser} from '../lib/session';import {formatChinaTime} from '../lib/date-time';import {openPage} from '../lib/presentation';import {consumptionStates} from '../lib/consumption';
type Reward={statusText?:string|null;state:string;points:string;growth:number;eligibleAt:string|null};type Data={enabled?:boolean;text:string;reward?:Reward|null};
const props=withDefaults(defineProps<{orderId?:string;revision?:unknown;eligible?:boolean}>(),{orderId:'',eligible:true}),data=ref<Data|null>(null),loading=ref(false),error=ref('');let generation=0;
async function load(){const turn=++generation;data.value=null;error.value='';if(!props.orderId&&!props.eligible)return;if(props.orderId&&!currentUser.value)return;loading.value=true;try{const result=await request<Data>(props.orderId?'/me/progression/consumption/'+encodeURIComponent(props.orderId):'/catalog/consumption-rule');if(turn===generation)data.value=result;}catch(e){if(turn===generation)error.value=(e as Error).message;}finally{if(turn===generation)loading.value=false;}}
watch(()=>[props.orderId,props.revision,props.eligible,currentUser.value?.id],()=>load(),{immediate:true});onUnmounted(()=>generation++);
</script><style>@import '../styles/app.css';.reward-note{padding:20px 0;border-top-style:solid;border-top-width:1px;border-top-color:#E4DFD4;}.reward-title{font-family:AcademySerif;font-size:16px;font-weight:600;line-height:24px;color:#17292D;}</style>
