<template>
  <view :class="['content-state',error?'content-state-error':loading?'content-state-loading':'']">
    <view :class="['state-mark',error?'state-mark-error':loading?'state-mark-loading':'']">
<AppIcon :name="error ? 'cloud-slash' : loading ? 'hourglass' : 'book-open'" :size="29" />
</view>
    <text class="state-title">{{ error ? '暂时无法打开' : loading ? '正在整理内容' : title }}</text>
    <text :class="['state-copy',error?'state-copy-error':'']">{{ error || (loading ? '请稍候，书院内容即将呈现。' : description) }}</text>
    <button v-if="error" class="state-retry" @click="emit('retry')">重新加载</button>
    <button v-else-if="!loading && actionLabel" class="state-retry" @click="emit('action')">{{ actionLabel }}</button>
  </view>
</template>
<script setup lang="ts">
import AppIcon from './AppIcon.uvue';
withDefaults(defineProps<{ loading?: boolean; error?: string; title?: string; description?: string; actionLabel?: string }>(), { loading: false, error: '', title: '暂无内容', description: '内容发布后会在这里显示。', actionLabel: '' });
const emit = defineEmits<{ retry: []; action: [] }>();
</script>
<style>
.content-state { padding: 32px 16px; align-items: center; }
.state-mark { width: 60px; height: 60px; border-radius: 30px; background-color: #EAE5DC; align-items: center; justify-content: center; margin-bottom: 16px; }
.state-title { font-family: AcademySerif; color: #17292D; font-size: 17px; line-height:27px;text-align:center;}
.state-copy { font-family:AcademySans;margin-top: 8px; color: #637276; font-size: 13px; line-height: 24px; text-align: center; }
.state-mark-error { background-color:#F0E1DB; }
.state-copy-error { color:#914A3E; }
.state-mark-loading { background-color:#E1E9E5; }
.state-retry {border-style:solid;border-width:0; background-color: #245564; color: #F4F0E7; border-radius: 22px; font-family:AcademySans;font-size: 14px; min-height:44px;padding: 11px 22px; margin:20px 0 0;line-height:22px;}
/* #ifdef WEB */
.state-copy { max-width:34em;overflow-wrap:anywhere; }
@media (prefers-reduced-motion:no-preference) {
 .state-mark-loading { animation:state-breath 1.6s ease-in-out infinite; }
 @keyframes state-breath { 50% { opacity:0.55; } }
}
/* #endif */
</style>
