<template><view v-if="items.length||error" class="course-cases"><text class="section-title">研习实践案例</text><text class="hint case-hint">作者明确授权，主讲点评；适用于当前研习版本。</text><ContentState v-if="error" :error="error" @retry="load"/><view v-for="item in items" :key="item.id" class="case-row"><text class="item-title">{{item.title}}</text><text class="body-copy case-copy" :user-select="true">{{item.text}}</text><text class="hint case-hint" :user-select="true">主讲点评：{{item.teacherComment}}</text></view></view></template>
<script setup lang="ts">
import ContentState from './ContentState.uvue';import {request} from '../lib/api';import {currentUser} from '../lib/session';const props=defineProps<{courseId:string}>(),items=ref<{id:string;title:string;text:string;teacherComment:string}[]>([]),error=ref('');let generation=0;async function load(){const seq=++generation;if(!props.courseId)return;try{const r=await request<{items:typeof items.value}>('/community-enhancements/courses/'+props.courseId+'/cases');if(seq===generation){items.value=r.items;error.value='';}}catch(e){if(seq===generation){items.value=[];error.value=(e as Error).message;}}}watch(()=>props.courseId,()=>load(),{immediate:true});watch(()=>currentUser.value?.id,()=>load());onUnmounted(()=>generation++);
</script><style>@import '../styles/marketing.css';.course-cases{margin-top:24px;}.case-row{padding:18px 0;}.case-copy{margin-top:10px;}.case-hint{margin-top:10px;}</style>
