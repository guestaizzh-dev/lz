<template><view class="course-reviews"><view class="row between review-head"><text class="meta">{{total}} 条公开评价{{average!==null?' · '+average!.toFixed(1)+' 分':''}}</text><view class="row"><button class="review-action" @click="load()">刷新</button><button class="review-action review-action-strong" @click="begin">{{mine?'编辑评价':'写评价'}}</button></view></view>
<ContentState v-if="loading||error" :loading="loading" :error="error" @retry="load(failedAppend)"/>
<view v-if="mine" class="my-review"><view class="row between"><view class="pill pill-teal">我的评价 · {{states[mine!.reviewState]}}</view><text class="review-score">{{mine!.rating}} 分</text></view><text class="review-body" :user-select="true">{{mine!.body}}</text><view class="row between review-foot"><text class="meta">{{formatChinaDate(mine!.createdAt)}}</text><button v-if="!mine!.deletedAt" :class="['review-action',saving?'is-disabled':'']" @click="withdraw">撤回评价</button></view></view>
<view v-for="row in items" :key="row.id" class="review-row"><view class="row between"><text class="review-name">{{row.nickname}}</text><view class="pill pill-gold">{{row.rating}} 分</view></view><text class="review-body" :user-select="true">{{row.body}}</text><text class="review-date">{{formatChinaDate(row.createdAt)}}</text></view>
<ContentState v-if="!loading&&!error&&!items.length" title="暂无公开评价" description="真实学员的研习反馈，审核后会在这里显示。"/>
<button v-if="items.length<total" :class="['secondary-button',loading?'is-disabled':'']" @click="load(true)">查看更多评价</button>
<ComposeSheet :visible="visible" title="课程研习评价" subtitle="先研习，再分享。评价审核通过后公开展示。" v-model="draft" :saving="saving" :error="editorError" :disabled="!draft.trim()" :maxlength="5000" submitLabel="提交评价" @close="visible=false" @submit="submit"><view class="rating-row"><button v-for="score in [1,2,3,4,5]" :key="score" :class="['rating-button',rating===score?'rating-selected':'']" @click="chooseScore(score)">{{score}} 分</button></view></ComposeSheet></view></template>
<script setup lang="ts">
import {formatChinaDate} from '../lib/date-time';
import {ref,watch,onMounted} from 'vue';import ContentState from './ContentState.uvue';import ComposeSheet from './ComposeSheet.uvue';import {request} from '../lib/api';import {currentUser,needLogin} from '../lib/session';
type Review={id:string;rating:number;body:string;nickname:string;createdAt:string};type MyReview={id:string;version:number;rating:number;body:string;reviewState:string;deletedAt:string|null};
type ReviewEnvelope={review:MyReview|null};
const props=defineProps<{courseId:string}>(),items=ref<Review[]>([]),mine=ref<MyReview|null>(null),total=ref(0),average=ref<number|null>(null),loading=ref(false),error=ref(''),visible=ref(false),draft=ref(''),rating=ref(5),saving=ref(false),editorError=ref('');const states:Record<string,string>={PENDING:'待审核',APPROVED:'已公开',REJECTED:'未通过审核',REMOVED:'已撤回或隐藏'};let generation=0,page=1,failedAppend=false;
async function load(append=false){if(append&&loading.value)return;const turn=++generation,next=append?page+1:1;failedAppend=append;loading.value=true;error.value='';if(!append)items.value=[];try{const [data,own]=await Promise.all([request<{items:Review[];total:number;average:number|null}>('/catalog/courses/'+props.courseId+'/reviews?page='+next),currentUser.value?request<ReviewEnvelope>('/me/courses/'+props.courseId+'/review').then(result=>result.review):Promise.resolve(null)]);if(turn!==generation)return;items.value=append?[...items.value,...data.items]:data.items;mine.value=own;total.value=data.total;average.value=data.average;page=next;}catch(e){if(turn===generation)error.value=(e as Error).message;}finally{if(turn===generation)loading.value=false;}}
function begin(){if(needLogin())return;if(!draft.value){draft.value=mine.value?.body??'';rating.value=mine.value?.rating??5;}editorError.value='';visible.value=true;}
function chooseScore(score:number){if(!saving.value)rating.value=score;}
async function submit(){if(saving.value||!draft.value.trim()||needLogin())return;saving.value=true;editorError.value='';try{mine.value=await request<MyReview>('/me/courses/'+props.courseId+'/review',{method:'POST',data:{expectedVersion:mine.value?.version??0,rating:rating.value,body:draft.value.trim()}});draft.value='';visible.value=false;await load();uni.showToast({title:'评价已提交审核',icon:'none'});}catch(e){editorError.value=(e as Error).message;}finally{saving.value=false;}}
function withdraw(){if(!mine.value||saving.value)return;const row=mine.value;uni.showModal({title:'撤回这条评价？',content:'撤回后不再公开展示，可重新编辑后提交审核。',success:async result=>{if(!result.confirm)return;saving.value=true;try{await request('/me/course-reviews/'+row.id,{method:'DELETE',data:{expectedVersion:row.version}});await load();}catch(e){uni.showToast({title:(e as Error).message,icon:'none'});}finally{saving.value=false;}}});}
watch(()=>currentUser.value?.id,()=>{mine.value=null;draft.value='';visible.value=false;load();});watch(()=>props.courseId,()=>{mine.value=null;draft.value='';visible.value=false;load();});onMounted(()=>load());
</script>
<style>@import '../styles/app.css';.course-reviews{margin-top:8px;}.review-head{margin-bottom:6px;}.review-action{font-size:12px;line-height:22px;min-height:44px;padding:11px 8px;margin:0;background-color:transparent;border-width:0;color:#6A7578;}.review-action-strong{color:#235663;font-weight:600;}.review-row{padding:16px;background-color:#FCF9F2;border-style:solid;border-width:1px;border-color:#E3DCCF;border-radius:12px;margin-top:12px;}.review-name{font-family:AcademySerif;font-size:15px;line-height:23px;color:#182B31;font-weight:600;}.review-body{font-size:14px;line-height:25px;color:#344C54;margin-top:8px;}.review-date{font-size:11px;line-height:18px;color:#8A9497;margin-top:10px;}.review-score{font-family:AcademySerif;font-size:15px;color:#8A6635;}.my-review{padding:16px;background-color:#EFE9DC;border-radius:12px;margin-top:8px;}.review-foot{margin-top:10px;}.rating-row{flex-direction:row;justify-content:space-between;margin-bottom:8px;}.rating-button{min-width:44px;min-height:44px;font-size:13px;line-height:22px;padding:11px 8px;margin:0;background-color:transparent;border-width:1px;border-style:solid;border-color:#D3C9B8;border-radius:10px;color:#6A7578;}.rating-selected{color:#8A6635;border-color:#A67C46;background-color:#F1E8D8;font-weight:600;}</style>
