<template>
<view class="course-row" @click="goCourse(course.id)">
<ArtImage :src="course.cover" :kind="artwork(course.cover)" :width="94" :height="100" />
<view class="course-copy">
<text class="course-name">{{course.title}}</text>
<text class="course-subtitle">{{course.subtitle}}</text>
<view class="row">
<text class="course-type">{{courseType(course)}}</text>
<text class="course-meta">{{course.chaptersCount}}讲 · {{course.durationMinutes}}分钟</text>
</view>
<text class="course-price">¥{{money(course.price)}}</text>
</view>
</view>
</template>
<script setup lang="ts">
import ArtImage from './ArtImage.uvue';
import { goCourse, money } from '../lib/api';
import type { Course } from '../lib/api';
import { artwork, courseType } from '../lib/presentation';
defineProps<{course: Course}>();
</script>
<style>@import '../styles/app.css';.course-row{border-style:solid;border-width:0;flex-direction:row;padding:9px 0;border-bottom-width:1px;border-bottom-color:#DFD9CF;}.course-copy{flex:1;padding-left:12px;}.course-name{font-family:AcademySerif;font-size:15px;line-height:23px;font-weight:600;color:#17292D;}.course-subtitle{font-family:AcademySerif;font-size:11px;line-height:19px;color:#637276;margin-top:2px;}.course-type{border-style:solid;border-width:0;font-size:9px;color:#245564;border-width:1px;border-color:#D8D4CA;padding:1px 4px;border-radius:2px;margin-top:7px;margin-right:7px;line-height:14px;}.course-meta{font-size:10px;color:#788084;margin-top:7px;line-height:15px;}.course-price{font-size:16px;color:#B95543;margin-top:7px;line-height:24px;}</style>
