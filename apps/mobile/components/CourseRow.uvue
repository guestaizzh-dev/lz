<template>
  <view hover-class="row-pressed" class="course-row" @click="goCourse(course.id)">
    <ArtImage
      :src="course.cover"
      :kind="artwork(course.cover)"
      :width="114"
      :height="76"
      :radius="8"
      fit="aspectFit"
    />
    <view class="course-copy">
      <text class="ui-text course-name">{{ course.title }}</text>
      <text
        v-if="course.subtitle.trim() && course.subtitle.trim() !== course.title.trim()"
        class="ui-text course-subtitle"
        >{{ course.subtitle }}</text
      >
      <view class="row course-facts">
        <text class="ui-text course-type">{{ courseType(course) }}</text>
        <text class="ui-text course-meta"
          >{{ course.chaptersCount }}讲{{
            course.durationMinutes > 0 ? ' · ' + course.durationMinutes + '分钟' : ''
          }}</text
        >
      </view>
      <text class="ui-text course-price">{{
        course.format === 'COHORT'
          ? '按营期报名'
          : course.price === 0
            ? '免费研习'
            : '¥' + money(course.price)
      }}</text>
    </view>
  </view>
</template>
<script setup lang="ts">
import ArtImage from './ArtImage.uvue';
import { goCourse, money } from '../lib/api';
import type { Course } from '../lib/api';
import { artwork, courseType } from '../lib/presentation';
defineProps<{ course: Course }>();
</script>
