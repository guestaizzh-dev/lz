<template>
<view hover-class="row-pressed" class="course-row" @click="goCourse(course.id)">
<ArtImage :src="course.cover" :kind="artwork(course.cover)" :width="94" :height="100" />
<view class="course-copy">
<text class="course-name">{{course.title}}</text>
<text class="course-subtitle">{{course.subtitle}}</text>
<view class="row course-facts">
<text class="course-type">{{courseType(course)}}</text>
<text class="course-meta">{{course.chaptersCount}}讲{{course.durationMinutes>0?' · '+course.durationMinutes+'分钟':''}}</text>
</view>
<text class="course-price">{{course.format==='COHORT'?'按营期报名':course.price===0?'免费研习':'¥'+money(course.price)}}</text>
</view>
</view>
</template>
<script setup lang="ts">
import ArtImage from './ArtImage.uvue';
import { goCourse, money } from '../lib/api';
import type { Course } from '../lib/api';
import { artwork, courseType } from '../lib/presentation';
defineProps<{course: Course}>();
</script>
<style>@import '../styles/app.css';.course-row{border-style:solid;border-width:0;flex-direction:row;padding:12px 0;border-bottom-width:1px;border-bottom-color:#E4DFD4;}.course-copy{flex:1;min-width:0;padding-left:12px;}.course-name{font-family:AcademySerif;font-size:16px;line-height:25px;font-weight:600;color:#17292D;}.course-facts{flex-wrap:wrap;}.course-subtitle{font-family:AcademySans;font-size:12px;line-height:20px;color:#6B7578;margin-top:4px;max-height:40px;overflow:hidden;}.course-type{border-style:solid;border-width:0;font-size:11px;color:#245564;border-width:1px;border-color:#DCD6CB;padding:2px 6px;border-radius:4px;margin-top:7px;margin-right:8px;line-height:16px;}.course-meta{font-family:AcademySans;font-size:12px;color:#6B7578;margin-top:8px;line-height:20px;}.course-price{font-size:16px;color:#B95543;margin-top:8px;line-height:24px;}</style>
