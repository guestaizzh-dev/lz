<template>
<view class="forum-media">
  <video v-if="type==='video'&&url" :id="playerId" class="forum-video" :src="url" :initial-time="position" :controls="true" @timeupdate="position=$event.detail.currentTime" @play="started" @pause="playing=false" @ended="playing=false" @loadedmetadata="restoreVideo" @error="failed"/>
  <view v-if="type==='audio'" class="forum-audio"><view class="row between"><view class="row"><AppIcon name="headphones" :size="22"/><text class="audio-title">音频心得</text></view><text class="meta">{{duration(position)}} / {{duration(seconds)}}</text></view><slider :value="dragging?dragPosition:position" :max="Math.max(1,seconds)" activeColor="#235663" :disabled="!url||loading" @changing="dragging=true;dragPosition=$event.detail.value" @change="seek($event.detail.value)"/><button class="audio-action" :disabled="!url||loading" @click="toggle">{{playing?'暂停音频':'播放音频'}}</button></view>
  <text v-if="loading&&!url" class="meta">正在准备{{type==='video'?'视频':'音频'}}…</text><text v-if="error" class="media-error">{{error}}</text><button v-if="error" class="media-retry" :disabled="loading" @click="load">重新加载</button>
</view>
</template>
<script setup lang="ts">
import AppIcon from './AppIcon.uvue';
import {claimForumPlayback,releaseForumPlayback} from '../lib/forum-playback';
import {request,apiBase} from '../lib/api';
import {currentUser,sessionGeneration} from '../lib/session';
import {studyEventId,duration} from '../lib/learning';
import type {ForumMediaTicket} from '../lib/forum-media';
const props=defineProps<{threadId?:string;assetId?:string;uploadId?:string;type:string}>();
const url=ref(''),loading=ref(false),error=ref(''),playing=ref(false),position=ref(0),seconds=ref(0),dragging=ref(false),dragPosition=ref(0),playerId='forum-'+studyEventId();
let audio:ReturnType<typeof uni.createInnerAudioContext>|null=null,timer:ReturnType<typeof setTimeout>|null=null,sequence=0,visible=true,restorePlaying=false;
function started(){claimForumPlayback(playerId,stop);playing.value=true;}
function stop(){releaseForumPlayback(playerId);audio?.pause();uni.createVideoContext(playerId)?.pause();playing.value=false;}
function clearTimer(){if(timer)clearTimeout(timer);timer=null;}
function failed(){stop();url.value='';error.value='媒体暂时无法播放，位置已保留，可重新加载。';}
function restoreVideo(){const ctx=uni.createVideoContext(playerId);if(position.value)ctx?.seek(position.value);if(restorePlaying){restorePlaying=false;ctx?.play();}}
async function load(){
  clearTimer();const token=++sequence,generation=sessionGeneration();loading.value=true;error.value='';
  try{
    const path=props.uploadId?'/forum/media/uploads/'+props.uploadId+'/preview':'/forum/threads/'+props.threadId+'/media/'+props.assetId;
    const result=await request<ForumMediaTicket>(path,{method:'POST'});if(token!==sequence||generation!==sessionGeneration()||!visible)return;
    restorePlaying=playing.value;stop();audio?.destroy();audio=null;url.value=apiBase+result.path;seconds.value=result.durationSeconds;
    if(props.type==='audio'){
      const ctx=uni.createInnerAudioContext();audio=ctx;ctx.src=url.value;
      ctx.onCanplay(()=>{if(audio!==ctx)return;if(position.value)ctx.seek(position.value);if(restorePlaying){restorePlaying=false;ctx.play();}});
      ctx.onTimeUpdate(()=>{if(audio===ctx&&!dragging.value)position.value=ctx.currentTime;});ctx.onPlay(()=>{if(audio===ctx)started();});ctx.onPause(()=>{if(audio===ctx)playing.value=false;});ctx.onEnded(()=>{if(audio===ctx)playing.value=false;});ctx.onError(()=>{if(audio===ctx)failed();});
    }
    timer=setTimeout(()=>void load(),Math.max(1000,Math.min(240000,Date.parse(result.expiresAt)-Date.now()-45000)));
  }catch(e){if(token===sequence){stop();audio?.destroy();audio=null;url.value='';error.value=(e as Error).message;}}
  finally{if(token===sequence)loading.value=false;}
}
function toggle(){if(playing.value)audio?.pause();else audio?.play();}
function seek(value:number){position.value=value;dragging.value=false;audio?.seek(value);}
watch(()=>[props.threadId,props.assetId,props.uploadId],()=>{position.value=0;void load();});
watch(()=>currentUser.value?.id,()=>{sequence++;stop();audio?.destroy();audio=null;url.value='';clearTimer();loading.value=false;});
onMounted(()=>void load());onShow(()=>{visible=true;if(!url.value&&!loading.value)void load();});onHide(()=>{visible=false;sequence++;stop();audio?.destroy();audio=null;url.value='';clearTimer();loading.value=false;});onUnmounted(()=>{visible=false;sequence++;stop();audio?.destroy();clearTimer();});
</script>
<style>
.meta{font-size:13px;line-height:22px;color:#6A7578;}.row{flex-direction:row;align-items:center;flex-wrap:wrap;}.between{justify-content:space-between;}
.forum-media{margin-top:16px;margin-bottom:16px;}.forum-video{width:100%;height:210px;border-radius:8px;background-color:#182B31;}.forum-audio{padding:16px;background-color:#EFE9DC;border-radius:8px;}.audio-title{font-size:15px;line-height:24px;color:#235663;margin-left:10px;}.audio-action,.media-retry{min-height:44px;line-height:24px;font-size:14px;color:#235663;background-color:transparent;border-width:0;margin:0;padding:10px 12px;}.media-error{font-size:13px;line-height:24px;color:#B4533F;margin-top:10px;}
</style>
