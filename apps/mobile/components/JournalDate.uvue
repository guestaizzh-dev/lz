<template><view class="journal-date"><button class="date-toggle" @click="expanded=!expanded">{{modelValue}} · {{modelValue===today?'今天':'修改日期'}}</button><view v-if="expanded" class="calendar"><view class="calendar-heading"><button class="month-control" aria-label="上个月" @click="move(-1)">‹</button><text class="month-label">{{year}} 年 {{month+1}} 月</text><button class="month-control" aria-label="下个月" :disabled="year===nowYear&&month===nowMonth" @click="move(1)">›</button></view><view class="calendar-grid"><text v-for="day in weekdays" :key="day" class="weekday">{{day}}</text><view v-for="(day,index) in days" :key="index" class="day-cell"><button v-if="day" :class="date(day)===modelValue?'day-button day-selected':'day-button'" :disabled="date(day)>today" @click="emit('update:modelValue',date(day));expanded=false">{{day}}</button></view></view></view></view></template>
<script setup lang="ts">
import {ref,computed,watch} from 'vue';
const props=defineProps<{modelValue:string;today:string}>(),emit=defineEmits<{'update:modelValue':[day:string]}>();
const nowYear=Number(props.today.slice(0,4)),nowMonth=Number(props.today.slice(5,7))-1,year=ref(nowYear),month=ref(nowMonth),expanded=ref(false),weekdays=['一','二','三','四','五','六','日'];
watch(()=>props.modelValue,day=>{year.value=Number(day.slice(0,4));month.value=Number(day.slice(5,7))-1;expanded.value=false;});
const days=computed(()=>{const first=(new Date(year.value,month.value,1).getDay()+6)%7,count=new Date(year.value,month.value+1,0).getDate();return[...Array(first).fill(0),...Array.from({length:count},(_,i)=>i+1)];});
function date(day:number){return year.value+'-'+String(month.value+1).padStart(2,'0')+'-'+String(day).padStart(2,'0');}
function move(delta:number){const next=new Date(year.value,month.value+delta,1);year.value=next.getFullYear();month.value=next.getMonth();}
</script>
<style>.journal-date{margin-bottom:12px;}.date-toggle{flex-direction:row;align-items:center;justify-content:space-between;width:100%;min-height:44px;font-size:14px;color:#235663;background-color:transparent;border-width:0;margin:0;padding:8px 0;}.calendar{background-color:#F5F0E6;padding:8px;border-radius:8px;}.calendar-heading{flex-direction:row;align-items:center;justify-content:space-between;}.month-label{font-size:14px;color:#182B31;}.month-control{width:44px;height:44px;font-size:22px;line-height:28px;color:#235663;background-color:transparent;border-width:0;margin:0;}.calendar-grid{flex-direction:row;flex-wrap:wrap;}.weekday{width:14.28%;text-align:center;font-size:12px;line-height:28px;color:#7C878A;}.day-cell{width:14.28%;height:44px;align-items:center;}.day-button{width:100%;max-width:44px;height:44px;border-radius:22px;font-size:14px;line-height:20px;padding:12px 0;border-width:0;margin:0;color:#182B31;background-color:transparent;}.day-selected{background-color:#235663;color:#FCF9F2;}</style>
