<template>
<view hover-class="row-pressed" :class="['lesson-row',active?'lesson-row-active':'']" @click="select()">
<view :class="['lesson-index',lesson.progress?.completedAt?'lesson-index-done':'']"><text class="lesson-number">{{String(lesson.position).padStart(2,'0')}}</text></view>
<view class="lesson-copy">
<view class="row lesson-title-row"><text class="lesson-title" @click.stop="select()">{{lesson.title}}</text><text v-if="lesson.trial" class="lesson-badge">试听</text></view>
<view class="row lesson-meta-row"><AppIcon :name="lesson.format==='TEXT'?'book-open':lesson.format==='AUDIO'?'headphones':'video-camera'" :size="12"/><text class="lesson-meta">{{lessonType(lesson.format)}}{{lesson.format==='TEXT'?'':' · '+duration(lesson.durationSeconds)}}{{lesson.progress?.completedAt?' · 已完成':''}}</text></view>
<text v-if="lesson.live" class="lesson-meta">{{formatChinaTime(lesson.live!.scheduledAt)}}（北京） · {{liveStates[lesson.live!.state]??'直播安排'}}</text>
<text v-if="lesson.opensAt" class="lesson-meta">{{lesson.accessible?'已开放':'待开放'}} · {{formatChinaTime(lesson.opensAt!)}}（北京）</text>
</view>
<view :class="['lesson-state',lesson.progress?.completedAt?'lesson-state-done':'']"><AppIcon :name="lesson.progress?.completedAt?'check':!lesson.accessible?'lock':lesson.format==='TEXT'?'book-open':lesson.format==='AUDIO'?'headphones':'play'" :size="14"/></view>
</view>
</template>
<script setup lang="ts">
import {formatChinaTime} from '../lib/date-time';import AppIcon from './AppIcon.uvue';import {duration,lessonType} from '../lib/learning';import type {LessonSummary} from '../lib/learning';const liveStates:Record<string,string>={SCHEDULED:'预告',PREPARING:'准备中',LIVE:'正在直播',ENDED:'已结束',REPLAY_READY:'回放已发布',CANCELLED:'已取消'};const props=defineProps<{lesson:LessonSummary;active?:boolean}>();const emit=defineEmits<{select:[lesson:LessonSummary]}>();function select(){emit('select',props.lesson);}
</script>
<style>@import '../styles/app.css';.lesson-row{flex-direction:row;align-items:center;min-height:76px;padding:14px 0;border-bottom-width:1px;border-bottom-style:solid;border-bottom-color:#E3DCCF;}.lesson-index{width:32px;height:32px;border-radius:16px;background-color:#EFE9DC;align-items:center;justify-content:center;margin-right:12px;flex-shrink:0;}.lesson-index-done{background-color:#E6EDE9;}.lesson-number{font-family:AcademySans;font-size:11px;line-height:16px;color:#6A7578;}.lesson-copy{flex:1;min-width:0;padding-right:8px;}.lesson-title-row{flex-direction:row;align-items:center;flex-wrap:wrap;}.lesson-title{font-family:AcademySerif;font-size:16px;line-height:24px;color:#182B31;flex-shrink:1;min-width:0;}.lesson-badge{font-size:10px;color:#8A6635;background-color:#F1E8D8;border-radius:8px;padding:2px 6px;margin-left:6px;line-height:14px;flex-shrink:0;}.lesson-meta-row{flex-direction:row;align-items:center;margin-top:3px;}.lesson-meta{font-size:11px;line-height:18px;color:#6A7578;margin-left:4px;}.lesson-state{width:30px;height:30px;border-radius:15px;background-color:#EFE9DC;align-items:center;justify-content:center;margin-left:8px;flex-shrink:0;}.lesson-state-done{background-color:#E6EDE9;}.lesson-row-active{background-color:#FCF9F2;border-radius:10px;padding-left:12px;padding-right:10px;}</style>
