<template>
  <view
    hover-class="row-pressed"
    :class="['lesson-row', active ? 'lesson-row-active' : '']"
    @click="select()"
  >
    <view :class="['lesson-index', lesson.progress?.completedAt ? 'lesson-index-done' : '']"
      ><text class="ui-text lesson-number">{{
        String(lesson.position).padStart(2, '0')
      }}</text></view
    >
    <view class="lesson-copy">
      <view class="row lesson-title-row"
        ><text class="ui-text lesson-title" @click.stop="select()">{{ lesson.title }}</text></view
      >
      <view class="row lesson-meta-row"
        ><AppIcon
          :name="
            lesson.format === 'TEXT'
              ? 'book-open'
              : lesson.format === 'AUDIO'
                ? 'headphones'
                : 'video-camera'
          "
          :size="12"
        /><text class="ui-text lesson-meta"
          >{{ lessonType(lesson.format)
          }}{{ lesson.format === 'TEXT' ? '' : ' · ' + duration(lesson.durationSeconds)
          }}{{ lesson.progress?.completedAt ? ' · 已完成' : '' }}</text
        ><text v-if="lesson.trial" class="ui-text lesson-badge">试听</text></view
      >
      <text v-if="lesson.live" class="ui-text lesson-meta"
        >{{ formatChinaTime(lesson.live!.scheduledAt) }}（北京） ·
        {{ liveStates[lesson.live!.state] ?? '直播安排' }}</text
      >
      <text v-if="lesson.opensAt" class="ui-text lesson-meta"
        >{{ lesson.accessible ? '已开放' : '待开放' }} ·
        {{ formatChinaTime(lesson.opensAt!) }}（北京）</text
      >
    </view>
    <view :class="['lesson-state', lesson.progress?.completedAt ? 'lesson-state-done' : '']"
      ><AppIcon
        :name="
          lesson.progress?.completedAt
            ? 'check'
            : !lesson.accessible
              ? 'lock'
              : lesson.format === 'TEXT'
                ? 'book-open'
                : lesson.format === 'AUDIO'
                  ? 'headphones'
                  : 'play'
        "
        :size="14"
    /></view>
  </view>
</template>
<script setup lang="ts">
import { formatChinaTime } from '../lib/date-time';
import AppIcon from './AppIcon.uvue';
import { duration, lessonType } from '../lib/learning';
import type { LessonSummary } from '../lib/learning';
const liveStates: Record<string, string> = {
  SCHEDULED: '预告',
  PREPARING: '准备中',
  LIVE: '正在直播',
  ENDED: '已结束',
  REPLAY_READY: '回放已发布',
  CANCELLED: '已取消',
};
const props = defineProps<{ lesson: LessonSummary; active?: boolean }>();
const emit = defineEmits<{ select: [lesson: LessonSummary] }>();
function select() {
  emit('select', props.lesson);
}
</script>
<style>
@import '../styles/app.css';
.lesson-row {
  flex-direction: row;
  align-items: center;
  min-height: 88px;
  padding: 16px;
  margin-top: 10px;
  border-width: 1px;
  border-style: solid;
  border-color: #e8e3d8;
  border-radius: 16px;
  background-color: rgba(255, 253, 248, 0.94);
}
.lesson-index {
  width: 38px;
  height: 38px;
  border-radius: 19px;
  background-color: #edf1e8;
  align-items: center;
  justify-content: center;
  margin-right: 12px;
  flex-shrink: 0;
}
.lesson-index-done {
  background-color: #e6ede9;
}
.lesson-number {
  font-family: sans-serif;
  font-size: 14px;
  line-height: 20px;
  font-weight: 600;
  color: #437a60;
}
.lesson-copy {
  flex: 1;
  min-width: 0;
  padding-right: 4px;
}
.lesson-title-row {
  flex-direction: row;
  align-items: center;
  flex-wrap: wrap;
}
.lesson-title {
  font-family: sans-serif;
  font-size: 16px;
  line-height: 24px;
  color: #182b31;
  flex-shrink: 1;
  min-width: 0;
}
.lesson-badge {
  font-size: 11px;
  color: #8a6635;
  background-color: #f1e8d8;
  border-radius: 10px;
  padding: 3px 8px;
  margin-left: 8px;
  line-height: 17px;
  flex-shrink: 0;
  align-self: center;
}
.lesson-meta-row {
  flex-direction: row;
  align-items: center;
  margin-top: 3px;
}
.lesson-meta {
  font-size: 12px;
  line-height: 20px;
  color: #5c6869;
  margin-left: 4px;
}
.lesson-state {
  width: 34px;
  height: 34px;
  border-radius: 17px;
  background-color: #edf1e8;
  align-items: center;
  justify-content: center;
  margin-left: 8px;
  flex-shrink: 0;
}
.lesson-state-done {
  background-color: #e6ede9;
}
.lesson-row-active {
  background-color: #fcfdf8;
  border-color: #9db5a4;
}
</style>
