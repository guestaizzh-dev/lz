<template><view v-if="available||error" class="live-gifts"><view class="gift-heading"><text class="gift-title">一份心意</text><button class="gift-wallet" @click="openPage('profile/gifts')">书香点 {{balance}} ›</button></view><text class="gift-caption">自愿赠礼，与免费积分独立；不影响正常观看与提问。</text><text class="gift-sent" :style="{opacity:sent?1:0}">心意已送达，愿与老师共研经典</text><text v-if="error" class="gift-error">{{error}}</text><view class="gift-list"><button v-for="item in items" :key="item.id" class="gift-item" :disabled="busy" @click="give(item)"><text class="gift-name">{{item.title}}</text><text class="gift-cost">{{item.creditCost}} 书香点</text></button></view><button v-if="error" class="gift-wallet" @click="load">刷新礼物</button></view></template>
<script setup lang="ts">
import {request} from '../lib/api';import {currentUser,sessionGeneration} from '../lib/session';import {studyEventId} from '../lib/learning';import {openPage} from '../lib/presentation';import type {GiftItem} from '../lib/gifts';
const props=defineProps<{sessionId:string}>(),items=ref<GiftItem[]>([]),available=ref(false),balance=ref('0'),error=ref(''),busy=ref(false),sent=ref(false);let sentTimer:ReturnType<typeof setTimeout>|null=null;let alive=true,key=studyEventId(),pending:GiftItem|null=null;
async function load(){if(!currentUser.value)return;error.value='';try{const catalog=await request<{available:boolean;items:GiftItem[]}>('/gifts/sessions/'+props.sessionId),wallet=await request<{balance:string}>('/gifts/wallet?size=1');if(!alive)return;available.value=catalog.available;items.value=catalog.items;balance.value=wallet.balance;}catch(e){if(alive)error.value=(e as Error).message;}}
function give(item:GiftItem){if(busy.value)return;if(pending&&pending.id!==item.id){uni.showToast({title:'上次赠礼结果待确认，请先重试同一份礼物',icon:'none'});return;}if(Number(balance.value)<Number(item.creditCost)){uni.showModal({title:'书香点不足',content:'本次需要 '+item.creditCost+' 书香点。可前往礼物余额查看充值与退款说明。',confirmText:'查看余额',success:r=>{if(r.confirm)openPage('profile/gifts');}});return;}
uni.showModal({title:pending?'确认上次赠礼结果？':'赠送「'+item.title+'」？',content:'消费 '+item.creditCost+' 书香点（人民币 '+(Number(item.creditCost)/100).toFixed(2)+' 元）。赠送后这部分不支持自助退款。',confirmText:pending?'核对结果':'确认赠送',success:async r=>{if(!r.confirm||busy.value)return;const owner=currentUser.value?.id,generation=sessionGeneration();busy.value=true;error.value='';pending=item;try{const result=await request<{balance:string}>('/gifts/give',{method:'POST',data:{giftId:item.id,sessionId:props.sessionId,requestKey:key,quantity:1,expectedVersion:item.version,accepted:true}});if(!alive||owner!==currentUser.value?.id||generation!==sessionGeneration())return;balance.value=result.balance;key=studyEventId();pending=null;sent.value=true;if(sentTimer)clearTimeout(sentTimer);sentTimer=setTimeout(()=>{sent.value=false;},2500);}catch(e){if(alive){const status=(e as Error&{status?:number}).status??0;if(status>=400&&status<500&&status!==408){pending=null;key=studyEventId();void load();}error.value=(e as Error).message+'；结果不确定时请重试同一份礼物，不会重复扣除。';}}finally{busy.value=false;}}});}
onMounted(()=>void load());onUnmounted(()=>{alive=false;if(sentTimer)clearTimeout(sentTimer);});
</script><style>.live-gifts{padding:20px 0;border-top-width:1px;border-top-color:#DFD9CF;margin-top:20px;}.gift-heading{flex-direction:row;align-items:center;justify-content:space-between;}.gift-title{font-family:AcademySerif;font-size:18px;color:#293B34;}.gift-wallet{margin-left:8px;font-size:13px;color:#31564F;background-color:transparent;border-width:0;margin-right:0;margin-top:0;margin-bottom:0;padding:10px 0;min-height:44px;line-height:22px;}.gift-caption{font-size:12px;color:#7F847D;line-height:20px;margin:2px 0 10px;}.gift-list{flex-direction:row;flex-wrap:wrap;}.gift-item{margin:0 8px 8px 0;padding:12px;min-height:64px;border-width:1px;border-color:#DFD9CF;border-radius:5px;background-color:#F4F1E9;align-items:center;}.gift-name{font-family:AcademySerif;font-size:16px;line-height:24px;color:#31564F;}.gift-cost{font-size:12px;line-height:20px;color:#7F847D;}.gift-sent{font-size:13px;color:#31564F;line-height:22px;transition-property:opacity;transition-duration:300ms;}.gift-error{font-size:13px;color:#A44F42;line-height:22px;margin-bottom:10px;}</style>
