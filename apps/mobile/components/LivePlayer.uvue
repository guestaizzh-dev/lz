<template><view>
<!-- #ifdef WEB -->
<view :id="elementId" :style="{height:height+'px'}"/>
<!-- #endif -->
<!-- #ifdef APP-ANDROID || APP-IOS -->
<NativeRtc :key="source" :leaseKey="source.split('#')[1]??''" mode="LIVE" :height="height" @error="emit('error')" @reconnect="emit('reconnect')"/>
<!-- #endif -->
</view></template>
<script setup lang="ts">
import {onMounted,onUnmounted,watch} from 'vue';
import NativeRtc from './NativeRtc.uvue';
const props=defineProps<{source:string;height:number}>(),emit=defineEmits<{error:[];reconnect:[]}>(),elementId='live-'+Math.random().toString(36).slice(2);
// #ifdef WEB
let frame:HTMLIFrameElement|null=null;
function render(){const root=document.getElementById(elementId);if(!root)return;root.replaceChildren();const next=document.createElement('iframe');next.title='书院直播画面';next.src=props.source;next.allow='autoplay; fullscreen';next.referrerPolicy='no-referrer';next.style.cssText='width:100%;height:100%;border:0;border-radius:6px;';root.append(next);frame=next;}
onMounted(render);watch(()=>props.source,render);onUnmounted(()=>{frame?.remove();frame=null;});
// #endif
</script>
