<template>
  <view class="quantity-stepper">
    <view :class="['quantity-control', decreaseDisabled ? 'quantity-control-disabled' : '']">
      <AppIcon name="minus" :size="16" :active="true" />
      <button
        class="quantity-hit"
        aria-label="减少数量"
        :disabled="decreaseDisabled"
        @click="change(-1)"
      ></button>
    </view>
    <view class="quantity-number"
      ><text class="quantity-number-text">{{ value }}</text></view
    >
    <view :class="['quantity-control', increaseDisabled ? 'quantity-control-disabled' : '']">
      <AppIcon name="plus" :size="16" :active="true" />
      <button
        class="quantity-hit"
        aria-label="增加数量"
        :disabled="increaseDisabled"
        @click="change(1)"
      ></button>
    </view>
  </view>
</template>
<script setup lang="ts">
import AppIcon from './AppIcon.uvue';
const props = withDefaults(
  defineProps<{ value: number; max: number; min?: number; disabled?: boolean }>(),
  { disabled: false, min: 1 },
);
const emit = defineEmits<{ (event: 'change', delta: number): void }>();
const decreaseDisabled = computed(() => props.disabled || props.value <= props.min);
const increaseDisabled = computed(() => props.disabled || props.value >= props.max);
function change(delta: number) {
  if (delta < 0 ? decreaseDisabled.value : increaseDisabled.value) return;
  emit('change', delta);
}
</script>
<style>
.quantity-stepper {
  flex-direction: row;
  align-items: center;
  flex-shrink: 0;
  height: 44px;
}
.quantity-control {
  position: relative;
  width: 44px;
  height: 44px;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
}
.quantity-control-disabled {
  opacity: 0.3;
}
.quantity-hit {
  position: absolute;
  left: 0;
  top: 0;
  width: 44px;
  height: 44px;
  min-height: 44px;
  min-width: 0;
  margin: 0;
  padding: 0;
  border-width: 0;
  border-style: solid;
  border-radius: 0;
  background-color: transparent;
  opacity: 0;
}
.quantity-number {
  min-width: 36px;
  height: 32px;
  padding: 0 6px;
  background-color: #f0ede7;
  border-radius: 6px;
  align-items: center;
  justify-content: center;
}
.quantity-number-text {
  font-family: sans-serif;
  font-size: 15px;
  line-height: 32px;
  color: #182b31;
  text-align: center;
  font-weight: 600;
}
/* #ifdef WEB */
.quantity-hit::after {
  border: 0;
}
.quantity-hit:focus-visible {
  opacity: 1;
  outline: 2px solid #235663;
  outline-offset: -3px;
}
/* #endif */
</style>
