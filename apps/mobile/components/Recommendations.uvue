<template>
  <view v-if="cards.length" class="recommendations">
    <view class="section-head"
      ><text class="ui-text section-heading">继续探索</text
      ><button class="ui-button recommendation-refresh" :disabled="loading" @click="refresh">{{
        loading ? '加载中…' : '刷新推荐'
      }}</button></view
    >
    <view class="product-grid">
      <view
        v-for="item in cards"
        :key="item.type + ':' + item.id"
        class="recommendation"
        hover-class="row-pressed"
        @click="openContent(item)"
      >
        <ArtImage
          v-if="item.cover"
          :src="item.cover"
          :kind="artwork(item.cover)"
          :width="cardWidth"
          :height="imageHeight"
          :radius="0"
          fit="aspectFit"
          :natural="true"
        />
        <view v-else class="recommendation-placeholder" :style="{ height: imageHeight + 'px' }">
          <AppIcon :name="coverIcons[item.type] ?? 'book-open'" :size="28" />
        </view>
        <view class="recommendation-copy">
          <text class="ui-text recommendation-type">{{ typeNames[item.type] }}</text>
          <text class="ui-text recommendation-title">{{ item.title }}</text>
        </view>
      </view>
    </view>
  </view>
</template>
<script setup lang="ts">
import ArtImage from './ArtImage.uvue';
import AppIcon from './AppIcon.uvue';
import { request } from '../lib/api';
import { currentUser } from '../lib/session';
import { openContent, typeNames } from '../lib/discovery';
import type { DiscoveryItem } from '../lib/discovery';
import { artwork } from '../lib/presentation';
const props = defineProps<{ width: number }>();
const cardWidth = computed(() => props.width * 0.485 - 2);
const imageHeight = computed(() => Math.round(cardWidth.value * 0.72));
const coverIcons: Record<string, string> = {
  ARTICLE: 'note-pencil',
  COURSE: 'book-open',
  EVENT: 'calendar-blank',
  PRODUCT: 'bag',
  TEACHER: 'user',
  THREAD: 'chat-circle',
};
const items = ref<DiscoveryItem[]>([]),
  loading = ref(false);
const cards = computed(() => {
  const displayed = new Set<string>();
  return items.value
    .filter((item) => {
      if (item.type === 'LIVE') return false;

      const key = item.type + ':' + item.title.trim();
      if (displayed.has(key)) return false;
      displayed.add(key);
      return true;
    })
    .slice(0, 4);
});
let generation = 0;
async function refresh() {
  if (loading.value) return;
  const turn = ++generation;
  loading.value = true;
  try {
    const r = await request<{ items: DiscoveryItem[] }>('/discovery/recommendations');
    if (turn === generation) items.value = r.items;
  } catch {
    if (turn === generation && cards.value.length)
      uni.showToast({ title: '推荐暂未更新，请重试', icon: 'none' });
  } finally {
    if (turn === generation) loading.value = false;
  }
}
onMounted(refresh);
watch(
  () => currentUser.value?.id,
  () => {
    generation++;
    loading.value = false;
    items.value = [];
    refresh();
  },
);
</script>
<style>
@import '../styles/app.css';
.recommendations {
  margin-top: 24px;
}
.recommendation {
  width: 48.5%;
  margin-bottom: 10px;
  border-radius: 12px;
  border-style: solid;
  border-width: 1px;
  border-color: #e7dfd2;
  overflow: hidden;
  background-color: #fffdf8;
}
.recommendation-placeholder {
  align-items: center;
  justify-content: center;
  background-color: #e6ede9;
}
.recommendation-copy {
  padding: 8px 10px 10px;
}
.recommendation-type {
  font-size: 11px;
  line-height: 18px;
  color: #657a73;
}
.recommendation-refresh {
  font-size: 12px;
  line-height: 20px;
  color: #235663;
  background-color: transparent;
  border-width: 0;
  padding: 10px 0;
  min-height: 44px;
  margin: 0;
}
.recommendation-title {
  color: #182b31;
  font-size: 15px;
  font-weight: 600;
  line-height: 22px;
  margin-top: 2px;
  max-height: 44px;
  overflow: hidden;
  text-overflow: ellipsis;
}
</style>
