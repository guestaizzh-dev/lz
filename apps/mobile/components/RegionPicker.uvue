<template><view v-if="visible" class="region-mask" @click="emit('close')"><view class="region-panel" @click.stop=""><view class="region-heading"><text class="region-title">选择所在地区</text><button class="region-close" @click="emit('close')">关闭</button></view><view class="region-tabs"><button class="region-tab" @click="step=0">{{province?.name??'省 / 直辖市'}}</button><button v-if="province" class="region-tab" @click="step=1">{{city?.name??'选择城市'}}</button><text v-if="step===2" class="region-current">选择区县</text></view><scroll-view class="region-scroll" direction="vertical"><button v-for="item in options" :key="item.code" class="region-option" @click="choose(item)">{{item.name}}</button></scroll-view></view></view></template>
<script setup lang="ts">
import {ref,computed,watch} from 'vue';import regions from '../static/regions.json';
type Region={code:string;name:string;children?:Region[]};
const props=defineProps<{visible:boolean}>(),emit=defineEmits<{close:[];select:[value:{province:string;city:string;district:string}]}>();
const step=ref(0),province=ref<Region|null>(null),city=ref<Region|null>(null),options=computed(()=>step.value===0?regions as Region[]:step.value===1?province.value?.children??[]:city.value?.children??[]);
watch(()=>props.visible,visible=>{if(visible){step.value=0;province.value=null;city.value=null;}});
function choose(item:Region){if(step.value===0){province.value=item;city.value=null;step.value=1;}else if(step.value===1){city.value=item;if(item.children?.length)step.value=2;else finish(item.name);}else finish(item.name);}
function finish(district:string){emit('select',{province:province.value!.name,city:city.value!.name,district});emit('close');}
</script>
<style>.region-mask{position:fixed;top:0;left:0;right:0;bottom:0;background-color:rgba(23,41,45,0.35);justify-content:flex-end;z-index:1100;}.region-panel{background-color:#FAF8F2;padding:16px 20px 24px;border-top-left-radius:16px;border-top-right-radius:16px;}.region-heading{flex-direction:row;align-items:center;justify-content:space-between;}.region-title{font-family:AcademySerif;font-size:18px;line-height:28px;color:#17292D;}.region-close,.region-tab{background-color:transparent;border-width:0;min-height:44px;font-size:13px;line-height:22px;color:#245564;padding:11px 8px;margin:0;}.region-tabs{flex-direction:row;align-items:center;border-bottom-width:1px;border-bottom-style:solid;border-bottom-color:#D8D4CA;flex-wrap:wrap;}.region-current{font-size:13px;color:#637276;}.region-scroll{height:320px;}.region-option{width:100%;text-align:left;font-size:15px;line-height:24px;min-height:48px;padding:12px 0;background-color:transparent;border-width:0;margin:0;color:#17292D;}</style>
