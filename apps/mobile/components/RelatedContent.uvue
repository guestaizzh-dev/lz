<template>
  <view v-if="visibleItems.length || error" class="related-section"
    ><text class="ui-text eyebrow">继续研习</text
    ><text class="ui-text section-heading">延伸内容</text
    ><button
      v-for="item in visibleItems"
      :key="item.id"
      class="ui-button related-link"
      @click="openContent(item)"
      ><view class="row between"
        ><text class="ui-text pill pill-gold">{{ typeNames[item.type] }}</text
        ><text class="ui-text related-go">查看 ›</text></view
      ><text class="ui-text related-title">{{ item.title }}</text
      ><text class="ui-text related-summary">{{ item.summary }}</text></button
    ><button v-if="error" class="ui-button text-button" @click="load"
      >关联内容加载失败，点击重试</button
    ></view
  >
</template>
<script setup lang="ts">
import { pageRefresh } from '../lib/page-refresh';
import { request } from '../lib/api';
import { openContent, typeNames } from '../lib/discovery';
import type { DiscoveryItem } from '../lib/discovery';
const props = defineProps<{ resourceId: string; excludeIds?: string[] }>(),
  items = ref<DiscoveryItem[]>([]),
  error = ref('');
let generation = 0;
async function load() {
  if (!props.resourceId) return;
  const id = props.resourceId,
    run = ++generation;
  error.value = '';
  try {
    const r = await request<{ items: DiscoveryItem[] }>('/discovery/related/' + id);
    if (run === generation) items.value = r.items;
  } catch (e) {
    if (run === generation) {
      items.value = [];
      error.value = (e as Error).message;
    }
  }
}
watch(
  () => props.resourceId,
  () => {
    items.value = [];
    void refreshPanel(true);
  },
  { immediate: false },
);
const visibleItems = computed(() =>
  items.value.filter((item) => !props.excludeIds?.includes(item.id)),
);
const refreshPanel = pageRefresh(load, () => !error.value);
onMounted(() => void refreshPanel());
defineExpose({ refresh: refreshPanel });
</script>
<style>
@import '../styles/app.css';
.related-section {
  margin-top: 30px;
  padding-top: 22px;
  border-top-width: 1px;
  border-top-style: solid;
  border-top-color: #d3c9b8;
}
.related-link {
  border-width: 0;
  border-style: solid;
  white-space: normal;
  text-align: left;
  background-color: transparent;
  margin: 0;
  padding: 16px 0;
  border-bottom-width: 1px;
  border-bottom-style: solid;
  border-bottom-color: #e3dccf;
  line-height: 24px;
}
.related-go {
  font-size: 11px;
  color: #6a7578;
  line-height: 18px;
}
.related-title {
  font-family: AcademySerif;
  font-size: 17px;
  color: #182b31;
  line-height: 27px;
  margin-top: 8px;
  font-weight: 600;
}
.related-summary {
  font-size: 12px;
  color: #6a7578;
  line-height: 21px;
  margin-top: 6px;
}
</style>
