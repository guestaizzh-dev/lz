<template><view v-if="visibleItems.length||error" class="related-section"><text class="section-heading">延伸研习</text><button v-for="item in visibleItems" :key="item.id" class="related-link" @click="openContent(item)"><view class="row between"><text class="tag">{{typeNames[item.type]}}</text><text class="meta">查看 ›</text></view><text class="related-title">{{item.title}}</text><text class="related-summary">{{item.summary}}</text></button><button v-if="error" class="text-button" @click="load">关联内容加载失败，点击重试</button></view></template>
<script setup lang="ts">
import {request} from '../lib/api';import {openContent,typeNames} from '../lib/discovery';import type {DiscoveryItem} from '../lib/discovery';const props=defineProps<{resourceId:string;excludeIds?:string[]}>(),items=ref<DiscoveryItem[]>([]),error=ref('');let generation=0;async function load(){if(!props.resourceId)return;const id=props.resourceId,run=++generation;error.value='';try{const r=await request<{items:DiscoveryItem[]}>('/discovery/related/'+id);if(run===generation)items.value=r.items;}catch(e){if(run===generation){items.value=[];error.value=(e as Error).message;}}}watch(()=>props.resourceId,()=>{items.value=[];load();},{immediate:true});
const visibleItems=computed(()=>items.value.filter(item=>!props.excludeIds?.includes(item.id)));
defineExpose({refresh:load});
</script><style>@import '../styles/app.css';.related-section{margin-top:28px;padding-top:20px;border-top:1px solid #D8D4CA;}.related-link{border-width:0;border-style:solid;white-space:normal;text-align:left;background-color:transparent;margin:0;padding:16px 0;border-bottom:1px solid #E5E0D6;line-height:24px;}.related-title{font-family:AcademySerif;font-size:17px;color:#17292D;line-height:27px;margin-top:8px;}.related-summary{font-size:13px;color:#637276;line-height:22px;margin-top:6px;}</style>
