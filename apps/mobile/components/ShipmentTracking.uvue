<template><view class="tracking"><button class="secondary-button" :disabled="busy" @click="query">{{busy?'查询中…':'查询真实物流轨迹'}}</button><text v-if="error" class="hint">{{error}}</text><view v-if="result"><text class="hint">{{result!.notice}}</text><view v-for="(point,index) in result!.items" :key="index" class="tracking-point"><text class="meta">{{formatChinaTime(point.time)}}（北京）</text><text class="body-copy" :user-select="true">{{point.context}}</text></view><text v-if="result!.checkedAt" class="meta">上次查询 {{formatChinaTime(result!.checkedAt!)}}</text></view></view></template>
<script setup lang="ts">
import {request} from '../lib/api';import {formatChinaTime} from '../lib/date-time';type Point={time:string;context:string};type Tracking={items:Point[];notice:string;checkedAt:string|null};const props=defineProps<{orderId:string;shipmentId:string}>(),busy=ref(false),error=ref(''),result=ref<Tracking|null>(null);function query(){if(busy.value)return;uni.showModal({title:'查询本单物流？',content:'将向快递100提交本包裹的单号，顺丰另需收货手机号后四位，用于向承运商核实轨迹。拒绝不影响复制单号自行查询。',success:async r=>{if(!r.confirm||busy.value)return;busy.value=true;error.value='';try{result.value=await request<Tracking>('/commerce/product-orders/'+props.orderId+'/shipments/'+props.shipmentId+'/tracking',{method:'POST',data:{consent:true}});}catch(e){error.value=(e as Error).message;}finally{busy.value=false;}}});}
</script><style>@import '../styles/marketing.css';.tracking-point{padding:14px 0;border-bottom-width:1px;border-bottom-style:solid;border-bottom-color:#DFD9CF;}.tracking{margin-top:12px;}</style>
