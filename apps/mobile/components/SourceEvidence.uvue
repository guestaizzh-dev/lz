<template>
  <view v-if="items.length" class="evidence-panel">
    <text class="ui-text section-heading">{{ title ?? '来源与授权' }}</text>
    <view v-for="item in items" :key="item.id" class="evidence-item">
      <text class="ui-text item-title">{{ item.title }}</text>

      <text class="ui-text meta">{{
        [item.author, item.edition].filter(Boolean).join(' · ')
      }}</text>
      <text class="ui-text evidence-body" :user-select="true"
        >{{ item.rightsHolder ? '权利人：' + item.rightsHolder + '\n' : ''
        }}{{ item.licenseScope ?? '' }}</text
      >
      <text v-if="item.validUntil" class="ui-text meta"
        >有效至 {{ formatChinaDate(item.validUntil) }}</text
      >
      <button v-if="item.sourceUrl" class="ui-button evidence-copy" @click="copy(item.sourceUrl)"
        >复制公开来源链接</button
      >
    </view>
  </view>
</template>
<script setup lang="ts">
import { formatChinaDate } from '../lib/date-time';
import type { PublicEvidence } from '../lib/api';
defineProps<{ items: PublicEvidence[]; title?: string }>();
function copy(url: string) {
  uni.setClipboardData({ data: url });
}
</script>
