<template><view v-if="ad" class="sponsored"><button class="sponsored-card" :disabled="busy" @click="open"><view class="row between"><text class="sponsored-label">广告 · {{ad!.sponsor}}</text><text class="meta">了解详情 ›</text></view><view class="sponsored-body"><image v-if="ad!.cover" class="sponsored-cover" :src="ad!.cover" mode="aspectFill"/><view class="sponsored-copy"><text class="sponsored-title">{{ad!.title}}</text><text class="sponsored-summary">{{ad!.summary}}</text></view></view></button></view></template>
<script setup lang="ts">
import {request} from '../lib/api';import {openContent} from '../lib/discovery';import type {DiscoveryItem} from '../lib/discovery';
type Advertisement={id:string;sponsor:string;title:string;summary:string;cover:string;endsAt:string;serverTime:string};
const props=defineProps<{surface:string}>(),ad=ref<Advertisement|null>(null),busy=ref(false);let generation=0,expiry:ReturnType<typeof setTimeout>|null=null;
async function load(){const run=++generation;if(expiry)clearTimeout(expiry);ad.value=null;try{const r=await request<{item:Advertisement|null}>('/advertising?surface='+encodeURIComponent(props.surface));if(run!==generation)return;ad.value=r.item;if(r.item){const wait=Date.parse(r.item.endsAt)-Date.parse(r.item.serverTime);if(wait<=0)ad.value=null;else expiry=setTimeout(()=>{ad.value=null;},Math.min(wait,2147483647));}}catch{ad.value=null;}}
async function open(){if(!ad.value||busy.value)return;busy.value=true;try{const r=await request<{target:DiscoveryItem}>('/advertising/'+ad.value.id+'/resolve');openContent(r.target);}catch(e){ad.value=null;uni.showToast({title:(e as Error).message,icon:'none'});}finally{busy.value=false;}}
watch(()=>props.surface,load,{immediate:true});onUnmounted(()=>{generation++;if(expiry)clearTimeout(expiry);});defineExpose({refresh:load});
</script>
<style>@import '../styles/app.css';.sponsored{margin-top:20px;margin-bottom:12px;}.sponsored-card{border:1px solid #E4DED2;background-color:#F6F3EC;border-radius:8px;padding:14px;text-align:left;white-space:normal;line-height:22px;}.sponsored-label{font-family:AcademySans;font-size:11px;color:#74817A;flex:1;margin-right:12px;}.sponsored-body{flex-direction:row;margin-top:10px;}.sponsored-cover{width:64px;height:64px;border-radius:4px;margin-right:12px;}.sponsored-copy{flex:1;}.sponsored-title{font-family:AcademySerif;font-size:16px;line-height:24px;color:#263E3A;}.sponsored-summary{font-family:AcademySans;font-size:12px;line-height:20px;color:#6F7872;margin-top:4px;}</style>
