<template>
  <view :style="{ width: size + 'px', height: size + 'px', borderRadius: size / 2 + 'px' }" class="teacher-avatar">
    <image v-if="portrait" :src="portrait" class="avatar-photo" mode="aspectFill" />
    <ArtImage v-else-if="demo" kind="portrait" :width="size" :height="size" :radius="size / 2" />
    <AppIcon v-else name="user" :size="size * 0.5" />
  </view>
</template>
<script setup lang="ts">
import ArtImage from './ArtImage.uvue';
import AppIcon from './AppIcon.uvue';
withDefaults(defineProps<{ portrait?: string | null; demo?: boolean; size?: number }>(), { portrait: null, demo: false, size: 42 });
</script>
<style>.teacher-avatar { overflow: hidden; flex-shrink: 0; background-color: #E3E0D7; align-items: center; justify-content: center; }.avatar-photo { width: 100%; height: 100%; }</style>
