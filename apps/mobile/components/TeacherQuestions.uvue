<template><view class="questions"><view class="question-tools"><button v-if="!mineOnly" class="question-tab" :class="!mine?'selected-tab':''" @click="switchView(false)">公开问答</button><button class="question-tab" :class="mine?'selected-tab':''" @click="switchView(true)">我的提问</button><view class="grow"/><button v-if="teacherId&&!mineOnly" class="question-tab" @click="begin">提问</button></view>
<ContentState v-if="loading||error" :loading="loading" :error="error" @retry="load(failedAppend)"/>
<view v-for="item in items" :key="item.id" class="question-card"><text class="question-label">{{item.teacherName?item.teacherName+' · ':''}}{{item.visibility==='PRIVATE'?'私问 · 仅自己与老师可见':'研习提问'}}{{item.memberQuestion?' · 会员专属':''}}{{item.priority?' · 优先队列':''}}{{item.answer?.featured?' · 精选':''}}</text><text class="question-body" :user-select="true">{{item.body}}</text><view v-if="item.answer" class="teacher-answer"><text class="question-label">老师答复{{item.answer!.reviewState==='PENDING'?' · 待审核':''}}</text><text class="question-body" :user-select="true">{{item.answer!.body}}</text></view><text v-else class="meta">{{item.state==='CLOSED'?'已取消'+(item.memberQuestion?' · 预占额度已释放':''):item.state==='REJECTED'?'老师暂时无法答复'+(item.memberQuestion?' · 预占额度已释放':''):item.state==='ANSWERED'?'答复正在审核，通过后可查看':'等待老师答复'}}</text><text v-if="mine&&item.resolutionNote" class="meta">{{item.resolutionNote}}</text><button v-if="mine&&item.state==='OPEN'" class="question-tab" :disabled="saving" @click="cancelQuestion(item)">取消提问</button></view>
<ContentState v-if="!loading&&!error&&!items.length" :title="mine?'还没有提问':'暂无公开答复'" description="把研习中遇到的问题写下来，与老师一起推敲。"/>
<button v-if="items.length<total" class="secondary-button" :disabled="loading" @click="load(true)">查看更多问答</button>
<ComposeSheet :visible="visible" title="向老师提问" :subtitle="privateQuestion?'仅自己与老师可见':'答复审核通过后公开展示'" v-model="draft" :saving="saving" :error="editorError" :disabled="!draft.trim()||(useMemberQuota&&(quotaLoading||!!quotaError||remaining<1))" :maxlength="5000" submitLabel="提交问题" @close="visible=false" @submit="submit"><view class="question-privacy"><text class="question-label">{{quotaLoading?'正在读取会员问答额度…':quotaError?'会员额度读取失败，可重试或继续普通提问。':'本老师适用的会员问答，本周期剩余 '+remaining+' 次'}}</text><button v-if="quotaError" class="question-tab" @click="loadQuota">重试会员额度</button><button v-if="remaining>0" class="question-tab" :disabled="quotaLoading||saving" @click="useMemberQuota=!useMemberQuota">{{useMemberQuota?'☑ 使用会员专属问答额度':'□ 普通提问 · 点击使用会员额度'}}</button><text v-if="useMemberQuota" class="question-label">提交预占一次，答复通过后计次；答复前取消或老师拒绝退回预占。优先按已购套餐约定，不承诺即时答复。</text></view><view class="question-privacy" @click="privateQuestion=!privateQuestion"><text class="question-label">{{privateQuestion?'☑ 私人提问':'□ 私人提问'}} · 点击切换</text></view></ComposeSheet></view></template>
<script setup lang="ts">
import {ref,watch,onMounted} from 'vue';import ContentState from './ContentState.uvue';import ComposeSheet from './ComposeSheet.uvue';import {studyEventId} from '../lib/learning';import {request} from '../lib/api';import {currentUser,needLogin} from '../lib/session';
type Answer={body:string;reviewState:string;featured:boolean};type Question={id:string;teacherName?:string;version:number;state:string;memberQuestion?:boolean;priority?:boolean;resolutionNote?:string|null;body:string;visibility:string;answer:Answer|null};
const props=defineProps<{teacherId:string;mineOnly?:boolean}>(),items=ref<Question[]>([]),loading=ref(false),error=ref(''),total=ref(0),mine=ref(!!props.mineOnly),visible=ref(false),draft=ref(''),privateQuestion=ref(true),saving=ref(false),editorError=ref(''),remaining=ref(0),quotaLoading=ref(false),quotaError=ref(''),useMemberQuota=ref(false);let failedAppend=false,page=1,generation=0,requestKey='',sentBody='',sentVisibility='',sentMemberQuota=false,quotaGeneration=0;
const questionReturnUrl=()=>props.mineOnly?'/pages/teacher/questions'+(props.teacherId?'?teacherId='+props.teacherId:''):'/pages/teacher/detail?id='+props.teacherId+'&tab=questions';
async function load(append=false){if(append&&loading.value)return;const turn=++generation;if(mine.value&&needLogin(questionReturnUrl()))return;failedAppend=append;loading.value=true;error.value='';const next=append?page+1:1;try{const result=await request<{items:Question[];total:number}>(mine.value?'/me/questions?page='+next+(props.teacherId?'&teacherId='+props.teacherId:''):'/teachers/'+props.teacherId+'/questions?page='+next);if(turn!==generation)return;items.value=append?[...items.value,...result.items]:result.items;total.value=result.total;page=next;}catch(e){if(turn===generation)error.value=(e as Error).message;}finally{if(turn===generation)loading.value=false;}}
function switchView(value:boolean){if(value&&needLogin(questionReturnUrl()))return;mine.value=value;items.value=[];total.value=0;load();}
function begin(){if(!needLogin(questionReturnUrl())){editorError.value='';useMemberQuota.value=false;visible.value=true;void loadQuota();}}
async function loadQuota(){const g=++quotaGeneration,owner=currentUser.value?.id;quotaLoading.value=true;quotaError.value='';try{const r=await request<{remaining:number}>('/teachers/'+props.teacherId+'/question-benefits');if(g===quotaGeneration&&owner===currentUser.value?.id)remaining.value=r.remaining;}catch(e){if(g===quotaGeneration)quotaError.value=(e as Error).message;}finally{if(g===quotaGeneration)quotaLoading.value=false;}}
function cancelQuestion(item:Question){if(saving.value)return;uni.showModal({title:'取消这条提问？',content:'答复前取消会释放预占的会员问答次数；已完成的答复不能取消。',confirmText:'取消提问',success:async r=>{if(!r.confirm||saving.value)return;saving.value=true;try{await request('/me/questions/'+item.id+'/cancel',{method:'POST',data:{expectedVersion:item.version}});await load();uni.showToast({title:'提问已取消',icon:'none'});}catch(e){uni.showToast({title:(e as Error).message,icon:'none'});}finally{saving.value=false;}}});}
async function submit(){if(saving.value||!draft.value.trim()||needLogin(questionReturnUrl()))return;saving.value=true;editorError.value='';const owner=currentUser.value?.id,teacherId=props.teacherId;try{const visibility=privateQuestion.value?'PRIVATE':'PUBLIC';if(!requestKey||sentBody!==draft.value.trim()||sentVisibility!==visibility||sentMemberQuota!==useMemberQuota.value){requestKey=studyEventId();sentBody=draft.value.trim();sentVisibility=visibility;sentMemberQuota=useMemberQuota.value;}await request('/teachers/'+props.teacherId+'/questions',{method:'POST',data:{requestKey,body:sentBody,visibility:sentVisibility,useMemberQuota:sentMemberQuota}});if(owner!==currentUser.value?.id||teacherId!==props.teacherId)return;draft.value='';requestKey='';visible.value=false;switchView(true);uni.showToast({title:'问题已提交',icon:'none'});}catch(e){if(owner===currentUser.value?.id&&teacherId===props.teacherId)editorError.value=(e as Error).message;}finally{saving.value=false;}}
watch(()=>currentUser.value?.id,()=>{quotaGeneration++;remaining.value=0;useMemberQuota.value=false;requestKey='';items.value=[];draft.value='';visible.value=false;mine.value=!!props.mineOnly;load();});watch(()=>props.teacherId,()=>{generation++;quotaGeneration++;requestKey='';items.value=[];remaining.value=0;useMemberQuota.value=false;visible.value=false;draft.value='';void load();});onMounted(()=>load());
</script>
<style>@import '../styles/app.css';.questions{padding-top:12px;}.question-tools{flex-direction:row;align-items:center;border-bottom-width:1px;border-bottom-style:solid;border-bottom-color:#DFD9CF;}.question-tab{margin:0;background-color:transparent;border-width:0;min-height:44px;padding:10px 12px;color:#788084;font-size:14px;line-height:24px;}.selected-tab{color:#245564;}.question-card{padding:20px 0;border-bottom-width:1px;border-bottom-style:solid;border-bottom-color:#DFD9CF;}.question-label{font-size:12px;line-height:22px;color:#637276;}.question-body{font-size:16px;line-height:28px;color:#17292D;margin:8px 0;}.teacher-answer{padding:12px 14px;background-color:#EEE9DF;border-left-width:2px;border-left-style:solid;border-left-color:#C3B79F;margin-top:12px;}.question-privacy{min-height:44px;justify-content:center;}</style>
