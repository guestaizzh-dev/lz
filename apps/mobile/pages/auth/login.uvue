<template>
  <view class="page"
    ><InkBackdrop />
    <scroll-view :show-scrollbar="false" class="page-scroll" direction="vertical">
      <view class="login-content">
        <SafeTop />
        <view class="icon-button icon-control"
          ><AppIcon name="arrow-left" :size="21" /><button
            class="ui-button icon-hit-target"
            aria-label="返回"
            @click="back()"
          ></button
        ></view>
        <view class="login-brand">
          <view class="row">
            <text class="ui-text login-logo">老子道学书院</text>
            <view class="login-stamp">
              <text class="ui-text login-stamp-text">书院</text>
            </view>
          </view>
          <text class="ui-text login-motto">传承经典 · 研习道学 · 知行合一</text>
        </view>
        <view class="login-tabs">
          <text class="ui-text login-tab-active">{{
            socialTicket ? '验证手机号，保留原有学习账号' : '手机号登录 / 注册'
          }}</text>
        </view>
        <text v-if="socialTicket" class="ui-text social-note"
          >首次授权需验证手机号。原账号的订单、笔记与学习进度会保留。</text
        >
        <view :class="['form-input-row', phoneFocused ? 'form-input-focused' : '']">
          <AppIcon name="user" :size="18" />
          <input
            class="ui-input form-input"
            type="number"
            maxlength="11"
            placeholder="请输入手机号"
            v-model="phone"
            @focus="phoneFocused = true"
            @blur="phoneFocused = false"
          />
        </view>
        <view class="code-row">
          <view :class="['form-input-row code-field', codeFocused ? 'form-input-focused' : '']">
            <AppIcon name="shield-check" :size="18" />
            <input
              class="ui-input form-input"
              type="number"
              maxlength="6"
              placeholder="请输入验证码"
              v-model="code"
              @focus="codeFocused = true"
              @blur="codeFocused = false"
              @confirm="signIn()"
            />
          </view>
          <button
            class="ui-button send-code"
            :class="sending || countdown > 0 ? 'is-disabled' : ''"
            @click="send()"
            >{{
              countdown > 0 ? countdown + '秒后重发' : sending ? '发送中' : '获取验证码'
            }}</button
          >
        </view>
        <text v-if="error" class="ui-text form-error">{{ error }}</text>
        <button
          class="ui-button primary-button login-submit"
          :class="submitting ? 'is-disabled' : ''"
          @click="signIn()"
          >{{ submitting ? '正在登录…' : '登录 / 注册' }}</button
        >
        <view class="consent-row">
          <view class="consent-touch" @click="accepted = !accepted">
            <view :class="['consent-check', accepted ? 'consent-checked' : '']">
              <text v-if="accepted" class="ui-text consent-tick">✓</text>
            </view>
          </view>
          <text class="ui-text consent-copy" @click="privacy()"
            >我已阅读并同意《用户协议》和《隐私说明》</text
          >
        </view>

        <text class="ui-text login-footnote">未注册手机号将自动创建账号</text>
        <button
          v-if="socialTicket"
          class="ui-button social-button"
          :disabled="submitting"
          @click="socialTicket = null"
          >取消绑定，使用手机号登录</button
        >
        <view v-if="socialProviders.length && !socialTicket" class="social-logins"
          ><text class="ui-text social-caption">其他登录方式</text
          ><button
            v-for="provider in socialProviders"
            :key="provider"
            class="ui-button social-button"
            :disabled="submitting"
            @click="socialSignIn(provider)"
            >{{ provider === 'WECHAT' ? '微信登录' : '通过 Apple 登录' }}</button
          ></view
        >
      </view>
      <view class="login-landscape">
        <ArtImage kind="boat" :width="artWidth" :height="130" :radius="0" />
      </view>
    </scroll-view>
  </view>
</template>
<script setup lang="ts">
import InkBackdrop from '../../components/InkBackdrop.uvue';
const phoneFocused = ref(false),
  codeFocused = ref(false);
import SafeTop from '../../components/SafeTop.uvue';
import AppIcon from '../../components/AppIcon.uvue';
import ArtImage from '../../components/ArtImage.uvue';
const artWidth = Math.max(280, uni.getWindowInfo().windowWidth);
import { request } from '../../lib/api';
import { saveSession, sessionGeneration } from '../../lib/session';
import {
  availableSocialProviders,
  authorizeSocial,
  requiresSocialPhone,
} from '../../lib/social-login';
import type { SocialProvider, SocialTicket } from '../../lib/social-login';
import type { LoginResult } from '../../lib/session';
const phone = ref(''),
  code = ref(''),
  accepted = ref(false),
  error = ref(''),
  sending = ref(false),
  submitting = ref(false),
  countdown = ref(0),
  development = ref(false);
const socialProviders = ref<SocialProvider[]>([]),
  socialTicket = ref<SocialTicket | null>(null);
let active = true;
function finishLogin(result: LoginResult) {
  saveSession(result);
  const pages = getCurrentPages(),
    previous = pages.length > 1 ? pages[pages.length - 2].route : '';
  if (!returnPath || returnPath.split('?')[0] === '/' + previous) back();
  else uni.redirectTo({ url: returnPath });
}
async function socialSignIn(provider: SocialProvider) {
  if (submitting.value) return;
  if (!accepted.value) {
    error.value = '请先阅读并同意服务与隐私说明';
    return;
  }
  const generation = sessionGeneration();
  submitting.value = true;
  error.value = '';
  try {
    const authorized = await authorizeSocial(provider);
    if (!active || generation !== sessionGeneration()) return;
    if (requiresSocialPhone(authorized.result)) {
      socialTicket.value = authorized.ticket;
      code.value = '';
      challengeId = '';
    } else finishLogin(authorized.result);
  } catch (e) {
    if (active && generation === sessionGeneration()) error.value = (e as Error).message;
  } finally {
    if (active) submitting.value = false;
  }
}
onMounted(() => {
  void availableSocialProviders()
    .then((items) => {
      if (active) socialProviders.value = items;
    })
    .catch(() => {});
});
let challengeId = '',
  returnPath = '',
  timer: ReturnType<typeof setInterval> | null = null;
const back = () => {
  if (getCurrentPages().length > 1) uni.navigateBack();
  else uni.switchTab({ url: '/pages/profile/index' });
};
const privacy = () => uni.navigateTo({ url: '/pages/profile/privacy' });
async function send() {
  if (sending.value || countdown.value > 0) return;
  if (!/^1[3-9]\d{9}$/.test(phone.value)) {
    error.value = '请填写有效的 11 位手机号';
    return;
  }
  const requestedPhone = phone.value;
  sending.value = true;
  error.value = '';
  try {
    const result = await request<{ challengeId: string; retryAfter: number; channel: string }>(
      '/auth/sms',
      { method: 'POST', data: { phone: requestedPhone } },
    );
    if (!active || phone.value !== requestedPhone) return;
    challengeId = result.challengeId;
    development.value = result.channel === 'DEVELOPMENT' || result.channel === 'PREVIEW';
    countdown.value = result.retryAfter;
    if (timer !== null) clearInterval(timer);
    timer = setInterval(() => {
      countdown.value = Math.max(0, countdown.value - 1);
      if (countdown.value === 0 && timer !== null) {
        clearInterval(timer);
        timer = null;
      }
    }, 1000);
  } catch (e) {
    if (active && phone.value === requestedPhone) error.value = (e as Error).message;
  } finally {
    sending.value = false;
  }
}
watch(phone, () => {
  challengeId = '';
  code.value = '';
  development.value = false;
  countdown.value = 0;
  if (timer !== null) {
    clearInterval(timer);
    timer = null;
  }
});
async function signIn() {
  if (submitting.value) return;
  if (!accepted.value) {
    error.value = '请先阅读并同意服务与隐私说明';
    return;
  }
  if (!challengeId || !/^\d{6}$/.test(code.value)) {
    error.value = '请先获取并填写 6 位验证码';
    return;
  }
  submitting.value = true;
  error.value = '';
  try {
    if (socialTicket.value && Date.parse(socialTicket.value.expiresAt) <= Date.now())
      throw new Error('第三方授权已过期，请取消绑定后重新授权');
    const result = await request<LoginResult>(
      socialTicket.value ? '/auth/social/phone' : '/auth/login',
      {
        method: 'POST',
        data: {
          phone: phone.value,
          code: code.value,
          challengeId,
          ...(socialTicket.value
            ? { ticketId: socialTicket.value.ticketId, state: socialTicket.value.state }
            : {}),
        },
      },
    );
    if (active) finishLogin(result);
  } catch (e) {
    if (active) error.value = (e as Error).message;
  } finally {
    if (active) submitting.value = false;
  }
}
onLoad((options) => {
  let path = options?.redirect ?? '';
  try {
    if (path.startsWith('%2F')) path = decodeURIComponent(path);
  } catch {
    path = '';
  }
  if (
    /^\/pages\/teacher\/detail\?id=[a-f0-9-]{36}(&tab=questions)?$/.test(path) ||
    /^\/pages\/teacher\/questions(\?teacherId=[a-f0-9-]{36})?$/.test(path) ||
    /^\/pages\/booking\/purchase\?(orderId=[a-f0-9-]{36}|kind=(appointment|registration)&resourceId=[a-f0-9-]{36}&quantity=([1-9]|1[0-9]|20)(&skuId=[a-f0-9-]{36})?)$/.test(
      path,
    ) ||
    [
      '/pages/profile/progression',
      '/pages/marketing/points',
      '/pages/marketing/coupons',
      '/pages/marketing/coupons?tab=wallet',
      '/pages/booking/mine',
      '/pages/booking/workbench',
      '/pages/booking/orders',
      '/pages/cohort/orders',
    ].includes(path) ||
    /^\/pages\/cohort\/purchase\?(cohortId|orderId)=[a-f0-9-]{36}$/.test(path) ||
    /^\/pages\/booking\/confirm\?eventId=[a-f0-9-]{36}$/.test(path) ||
    /^\/pages\/booking\/credential\?id=[a-f0-9-]{36}$/.test(path) ||
    /^\/pages\/course\/(practice|checkin)\?id=[a-f0-9-]{36}(&cohortId=[a-f0-9-]{36})?$/.test(
      path,
    ) ||
    /^\/pages\/cohort\/detail\?id=[a-f0-9-]{36}$/.test(path) ||
    /^\/pages\/course\/purchase\?(courseId|orderId)=[a-f0-9-]{36}$/.test(path) ||
    /^\/pages\/membership\/purchase\?(planId|orderId)=[a-f0-9-]{36}$/.test(path)
  )
    returnPath = path;
});
onUnload(() => {
  active = false;
  socialTicket.value = null;
  if (timer !== null) clearInterval(timer);
});
</script>
<style>
@import '../../styles/app.css';
