  margin-bottom: 16px;
}
.form-input-row {
  border-style: solid;
  border-width: 1px;
  border-color: #cfc5b1;
  flex-direction: row;
  align-items: center;
  height: 48px;
  padding: 0 12px;
  border-radius: 10px;
  background-color: #fcf9f2;
}
