  color: #235663;
  font-family: sans-serif;
  font-size: 13px;
  line-height: 22px;
  min-height: 48px;
  padding: 11px 12px;
  margin: 0 0 0 8px;
  border-radius: 10px;
  flex-shrink: 0;
}
.send-code.is-disabled {
  opacity: 1;
  border-color: #e4ded2;
  background-color: #e4ded2;
  color: #6f6a5f;
}
