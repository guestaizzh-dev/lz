<template>
<view class="page"><PageHead :title="eventId?'活动报名':'预约老师'"/><scroll-view class="page-scroll" direction="vertical"><view class="content">
<text class="section-heading">{{eventId?'选择场次与席位':'选择服务与时段'}}</text><text class="meta">所有时间均为北京时间 · 名额以提交结果为准</text>
<ContentState v-if="loading||loadError" :loading="loading" :error="loadError" @retry="load"/>
<view v-else>
<view v-if="!eventId"><text class="section-heading">选择服务</text><view v-for="o in offerings" :key="o.id" :class="['choice',offeringId===o.id?'chosen':'']"><button class="choice-button" @click="chooseOffering(o.id)">{{o.title}} · {{o.durationMinutes}}分钟</button><text class="meta">{{o.teacherName}} · {{o.price===0?'免费':o.price===null?'价格待配置':'¥'+money(o.price!)}}</text></view><ContentState v-if="!offerings.length" title="暂无可预约服务" description="老师开放时段后会在这里展示。"/>
<view v-if="offering" class="section"><text class="body-copy" :user-select="true">{{offering!.deliveryPolicy}}</text><text class="meta">安排：{{offering!.locationPolicy}}</text><text class="meta">开始前{{offering!.cancelBeforeMinutes}}分钟可自助取消</text></view>
<text v-if="offering" class="section-heading">选择时段</text><ContentState v-if="slotLoading" :loading="true"/><text v-if="slotError" class="error">{{slotError}}</text><button v-if="slotError" class="text-button" @click="chooseOffering(offeringId)">重试获取时段</button>
<button v-for="s in slots" :key="s.id" :class="['time-choice',slotId===s.id?'chosen':'']" :disabled="s.available<1||offering?.price===null" @click="selectSlot(s.id)">{{formatChinaTime(s.startsAt)}} — {{formatChinaTime(s.endsAt).slice(11)}}{{s.available<1?' · 已约满':''}}</button><text v-if="offering&&!slotLoading&&!slots.length" class="meta">暂无开放时段，请稍后查看。</text></view>
<view v-else><button class="text-button" :disabled="loading||busy" @click="load">刷新场次</button><view v-for="s in sessions" :key="s.id" class="section"><text class="item-title">{{formatChinaTime(s.startsAt)}}</text><text class="meta">{{s.location}} · 取消截止 {{formatChinaTime(s.cancelDeadline)}}</text><button v-for="t in s.tickets" :key="t.id" :class="['time-choice',ticketId===t.id?'chosen':'']" :disabled="(!t.bookingEnabled&&!t.purchaseAvailable)||t.available<1" @click="selectTicket(t.id,s.id)">{{t.title}} · {{t.price===0?'免费':t.price===null?'价格待配置':'¥'+money(t.price!)}} · 剩余{{t.available}}席</button><text v-if="s.memberOpenAt" class="meta">会员优先开放：{{formatChinaTime(s.memberOpenAt)}}</text><text class="meta">公众开放：{{formatChinaTime(s.publicOpenAt)}}</text><button v-if="s.priorityWindow&&!currentUser" class="secondary-button" @click="loginForPriority">登录核查优先报名权益</button><text v-if="s.priorityWindow" class="tag">{{s.priorityEligible?'你拥有本活动优先报名权益':'当前为会员优先时段，公众开放后可报名'}}</text></view><ContentState v-if="!sessions.length" title="暂无开放场次" description="书院公布场次后，可在这里选择报名。"/></view>
<text v-if="offerings.some(o=>!o.bookingEnabled)||sessions.some(s=>s.tickets.some(t=>t.price!==0))" class="footer-note">免费安排直接确认；付费安排先查看购买说明，是否可付款以订单页面为准。</text>
<view v-if="(slotId||ticketId)&&!paid" class="booking-form section"><text class="section-heading">确认联系信息</text><text class="field-label">联系人</text><input class="booking-input" v-model="name" maxlength="50" placeholder="方便书院称呼你的姓名" :disabled="busy"/><text class="field-label">手机号码</text><input class="booking-input" v-model="phone" type="number" maxlength="11" placeholder="本次预约使用的手机号码" :disabled="busy"/>
<view v-if="eventId" class="row between"><text class="field-label grow">参加人数</text><button class="number-control" :disabled="quantity<=1||busy" @click="changeQuantity(-1)">−</button><text>{{quantity}}人</text><button class="number-control" :disabled="quantity>=maxQuantity||busy" @click="changeQuantity(1)">＋</button></view>
<button class="consent-button" :disabled="busy" @click="consent=!consent"><text>{{consent?'☑':'□'}} 我同意负责老师 / 书院使用本次联系信息安排服务，并已阅读上述取消规则。</text></button><text v-if="submitError" class="error">{{submitError}}</text><text class="price">本次费用：免费</text></view>
</view></view></scroll-view><BottomBar><button class="bar-primary" :disabled="busy||(!paid&&!consent)||!(slotId||ticketId)||slotLoading" @click="submit">{{busy?'正在确认…':!(slotId||ticketId)?eventId?'请先选择场次与席位':'请先选择预约时段':paid?'查看费用与购买说明':!consent?'请确认联系信息与规则':eventId?'确认报名':'确认预约'}}</button></BottomBar></view>
</template>
<script setup lang="ts">
import PageHead from '../../components/PageHead.uvue';import BottomBar from '../../components/BottomBar.uvue';import ContentState from '../../components/ContentState.uvue';import {request,money} from '../../lib/api';import {formatChinaTime} from '../../lib/date-time';import {currentUser,needLogin} from '../../lib/session';import {studyEventId} from '../../lib/learning';import type {Offering,Slot,EventSession} from '../../lib/bookings';
const offerings=ref<Offering[]>([]),slots=ref<Slot[]>([]),sessions=ref<EventSession[]>([]),offeringId=ref(''),slotId=ref(''),ticketId=ref(''),sessionId=ref(''),name=ref(''),phone=ref(''),quantity=ref(1),consent=ref(false),busy=ref(false),loading=ref(false),slotLoading=ref(false),loadError=ref(''),slotError=ref(''),submitError=ref(''),eventId=ref('');let teacherId='',skuId='',initialOffering='',requestKey=studyEventId(),owner='',slotGeneration=0;
const paid=computed(()=>(eventId.value?ticket.value?.price:offering.value?.price)!==null&&Number(eventId.value?ticket.value?.price:offering.value?.price)>0);
const offering=computed(()=>offerings.value.find(o=>o.id===offeringId.value)??null),ticket=computed(()=>sessions.value.find(s=>s.id===sessionId.value)?.tickets.find(t=>t.id===ticketId.value)??null),maxQuantity=computed(()=>Math.min(ticket.value?.available??1,ticket.value?.perUserLimit??1));
function loginForPriority(){needLogin('/pages/booking/confirm?eventId='+eventId.value);}
function resetKey(){requestKey=studyEventId();submitError.value='';consent.value=false;}
function selectSlot(id:string){if(busy.value)return;slotId.value=id;resetKey();}function selectTicket(id:string,session:string){if(busy.value)return;ticketId.value=id;sessionId.value=session;quantity.value=1;resetKey();}function changeQuantity(delta:number){quantity.value=Math.max(1,Math.min(maxQuantity.value,quantity.value+delta));resetKey();}
async function chooseOffering(id:string){if(busy.value)return;offeringId.value=id;slotId.value='';slots.value=[];resetKey();slotLoading.value=true;slotError.value='';const generation=++slotGeneration;try{const result=await request<Slot[]>('/bookings/offerings/'+id+'/slots');if(generation===slotGeneration)slots.value=result;}catch(e){if(generation===slotGeneration)slotError.value=(e as Error).message;}finally{if(generation===slotGeneration)slotLoading.value=false;}}
async function load(){if(loading.value||busy.value)return;loading.value=true;loadError.value='';try{if(eventId.value)sessions.value=await request<EventSession[]>('/bookings/events/'+eventId.value+'/sessions');else{offerings.value=initialOffering?[await request<Offering>('/bookings/offerings/'+initialOffering)]:await request<Offering[]>('/bookings/teachers/'+teacherId+'/offerings');if(offerings.value.length)await chooseOffering(offeringId.value||offerings.value[0].id);}}catch(e){loadError.value=(e as Error).message;}finally{loading.value=false;}}
async function submit(){if(busy.value)return;if(paid.value){uni.navigateTo({url:'/pages/booking/purchase?kind='+(eventId.value?'registration':'appointment')+'&resourceId='+(eventId.value?ticketId.value:slotId.value)+'&quantity='+quantity.value+(skuId?'&skuId='+skuId:'')});return;}if(needLogin())return;if(!name.value.trim()||!/^1[3-9]\d{9}$/.test(phone.value)){submitError.value='请填写联系人和有效的11位手机号码';return;}if(!consent.value)return;busy.value=true;submitError.value='';try{await request('/me/bookings/'+(eventId.value?'registrations':'appointments'),{method:'POST',data:{requestKey,name:name.value.trim(),phone:phone.value,contactConsent:true,...(eventId.value?{ticketTypeId:ticketId.value,quantity:quantity.value}:{slotId:slotId.value,expectedVersion:offering.value!.version,...(skuId?{skuId}:{})})}});uni.redirectTo({url:'/pages/booking/mine'});}catch(e){submitError.value=(e as Error).message;}finally{busy.value=false;}}
watch([name,phone],()=>{if(!busy.value){requestKey=studyEventId();submitError.value='';}});
onLoad(options=>{teacherId=options?.teacherId??'';initialOffering=options?.offeringId??'';skuId=options?.skuId??'';eventId.value=options?.eventId??'';load();});onShow(()=>{const next=currentUser.value?.id??'';if(owner!==next){owner=next;name.value=currentUser.value?.nickname??'';phone.value='';consent.value=false;requestKey=studyEventId();if(eventId.value){ticketId.value='';sessionId.value='';load();}}});
</script>
<style>@import '../../styles/app.css';.choice{padding:12px 14px;border-radius:4px;border:1px solid #DDD8CE;margin-top:10px;}.choice-button{min-height:44px;background-color:transparent;color:#17292D;text-align:left;font-size:15px;margin:0;padding:0;line-height:30px;}.chosen{border-color:#245564;background-color:#EAF0EB;}.time-choice{background-color:#FAF8F2;white-space:normal;margin:10px 0;padding:14px;font-size:14px;line-height:24px;text-align:left;color:#17292D;border:1px solid #DDD8CE;border-radius:4px;}.time-choice.chosen{background-color:#EAF0EB;}.booking-input{height:48px;border-bottom:1px solid #D8D4CA;margin-bottom:16px;color:#17292D;font-size:15px;}.field-label{font-size:13px;color:#637276;line-height:25px;}.number-control{width:44px;min-height:44px;padding:10px 0;margin:0;border-width:0;border-radius:22px;line-height:24px;background-color:#EEE9DF;color:#245564;font-size:18px;}.consent-button{white-space:normal;background-color:transparent;margin:18px 0;padding:0;text-align:left;font-size:13px;line-height:24px;color:#637276;}.error{color:#9B3F32;font-size:13px;line-height:23px;margin:10px 0;}</style>
