<template>
  <view class="page"
    ><InkBackdrop /><PageHead title="在线咨询" /><scroll-view
      class="page-scroll"
      direction="vertical"
      ><view class="content"
        ><ContentState
          v-if="loading || error"
          :loading="loading"
          :error="error"
          :error-title="
            purchasePlatform() === 'WEB'
              ? '网页端不支持'
              : error.includes('网络')
                ? '暂时无法加载'
                : '无法进入本次咨询'
          "
          :retryable="purchasePlatform() !== 'WEB' && error.includes('网络')"
          :action-label="purchasePlatform() === 'WEB' || !error.includes('网络') ? '返回预约' : ''"
          @retry="join"
          @action="back"
        /><view v-if="key"
          ><text class="ui-text section-heading">{{ title }}</text
          ><text class="ui-text consult-role">{{
            role === 'TEACHER' ? '负责老师' : '本次预约学员'
          }}</text
          ><text class="ui-text deadline">北京时间 {{ formatChinaTime(endsAt) }} 前可进入</text
          ><NativeRtc :key="key" :leaseKey="key" mode="CONSULTATION" :height="height" /><text
            class="ui-text consult-note"
            >咨询仅用于文化研习交流，不替代医疗或其他专业服务。结束连接不会自动确认服务完成，请返回预约核对履约。</text
          ></view
        ><button v-if="key" class="ui-button secondary-button consult-back" @click="back"
          >返回预约</button
        ></view
      ></scroll-view
    ></view
  >
</template>
<script setup lang="ts">
import InkBackdrop from '../../components/InkBackdrop.uvue';
import { purchasePlatform } from '../../lib/course-sales';
import PageHead from '../../components/PageHead.uvue';
import ContentState from '../../components/ContentState.uvue';
import NativeRtc from '../../components/NativeRtc.uvue';
import { request } from '../../lib/api';
import { needLogin } from '../../lib/session';
import { formatChinaTime } from '../../lib/date-time';
import { viewWidth } from '../../lib/presentation';
const id = ref(''),
  key = ref(''),
  title = ref(''),
  role = ref(''),
  endsAt = ref(''),
  loading = ref(false),
  error = ref(''),
  height = Math.round(viewWidth() * 0.75);
let visible = false,
  generation = 0;
async function join() {
  if (purchasePlatform() === 'WEB') {
    error.value = '在线音视频咨询请使用Android或iOS App，网页暂不开放设备采集。';
    return;
  }
  if (needLogin('/pages/booking/consult?id=' + id.value) || loading.value) return;
  loading.value = true;
  error.value = '';
  const current = ++generation;
  try {
    const data = await request<{ key: string; title: string; role: string; endsAt: string }>(
      '/rtc/consultations/' + id.value + '/join',
      { method: 'POST' },
    );
    if (current !== generation || !visible) {
      void request('/rtc/consultations/leave', { method: 'POST', data: { key: data.key } }).catch(
        () => {},
      );
      return;
    }
    title.value = data.title;
    role.value = data.role;
    endsAt.value = data.endsAt;
    key.value = data.key;
  } catch (e) {
    if (current === generation) error.value = (e as Error).message;
  } finally {
    loading.value = false;
  }
}
function back() {
  uni.navigateBack({ fail: () => uni.redirectTo({ url: '/pages/booking/mine' }) });
}
onLoad((o) => {
  id.value = o?.id ?? '';
});
onShow(() => {
  visible = true;
  void join();
});
onHide(() => {
  visible = false;
  generation++;
  key.value = '';
});
onUnload(() => {
  visible = false;
  generation++;
  key.value = '';
});
</script>
<style>
@import '../../styles/app.css';
.content {
  padding-top: 16px;
}
.consult-role {
  font-size: 13px;
  line-height: 22px;
  color: #5c6869;
  margin-top: 4px;
}
.deadline {
  font-size: 15px;
  line-height: 26px;
  color: #344c54;
  margin-top: 4px;
  margin-bottom: 16px;
}
.consult-note {
  font-size: 13px;
  line-height: 22px;
  color: #5c6869;
  margin-top: 16px;
}
.consult-back {
  align-self: flex-start;
  margin-top: 16px;
}
</style>
