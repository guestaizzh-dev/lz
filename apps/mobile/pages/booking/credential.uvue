<template>
  <view class="page"
    ><InkBackdrop /><PageHead title="活动核销凭证" /><scroll-view
      class="page-scroll"
      direction="vertical"
      ><view class="content"
        ><ContentState
          v-if="loading || error"
          :loading="loading"
          :error="error"
          :error-title="error.includes('网络') ? '暂时无法加载' : '无权查看此凭证'"
          :retryable="error.includes('网络')"
          :action-label="error.includes('网络') ? '' : '返回我的预约'"
          @retry="load"
          @action="openPage('booking/mine')"
        /><view v-else-if="credential" class="credential-card"
          ><text class="ui-text section-heading">本次报名 · {{ credential!.quantity }}人</text
          ><view class="qr-frame"
            ><image class="credential-qr" :src="credential!.qr" mode="aspectFit" /></view
          ><text class="ui-text deadline"
            >有效至 {{ formatChinaTime(credential!.expiresAt) }}（北京时间）</text
          ><text class="ui-text credential-note"
            >向本场次工作人员出示二维码，每位参加者分别确认到场。刷新后旧凭证失效。</text
          ><button class="ui-button secondary-button" @click="copy">复制核销凭证</button
          ><button class="ui-button text-button refresh-link" :disabled="loading" @click="load"
            >刷新二维码</button
          ></view
        ></view
      ></scroll-view
    ></view
  >
</template>
<script setup lang="ts">
import InkBackdrop from '../../components/InkBackdrop.uvue';
import PageHead from '../../components/PageHead.uvue';
import ContentState from '../../components/ContentState.uvue';
import { request } from '../../lib/api';
import { needLogin, currentUser } from '../../lib/session';
import { formatChinaTime } from '../../lib/date-time';
import { openPage } from '../../lib/presentation';
type Credential = { code: string; qr: string; expiresAt: string; quantity: number };
const credential = ref<Credential | null>(null),
  loading = ref(false),
  error = ref('');
let id = '',
  owner = '';
async function load() {
  if (loading.value || needLogin('/pages/booking/credential?id=' + id)) return;
  loading.value = true;
  error.value = '';
  credential.value = null;
  try {
    credential.value = await request<Credential>(
      '/me/bookings/registrations/' + id + '/checkin-code',
      { method: 'POST' },
    );
  } catch (e) {
    error.value = (e as Error).message;
  } finally {
    loading.value = false;
  }
}
function copy() {
  if (!credential.value) return;
  if (new Date(credential.value.expiresAt).valueOf() <= Date.now()) {
    uni.showToast({ title: '凭证已过期，请刷新', icon: 'none' });
    return;
  }
  uni.setClipboardData({ data: credential.value.code });
}
onLoad((o) => {
  id = o?.id ?? '';
});
onShow(() => {
  if (owner !== (currentUser.value?.id ?? '')) {
    credential.value = null;
    owner = currentUser.value?.id ?? '';
  }
  if (id) load();
});
onHide(() => {
  credential.value = null;
});
</script>
<style>
@import '../../styles/app.css';
.content {
  padding-top: 16px;
}
.credential-card {
  align-items: center;
  padding: 24px 16px;
  background-color: #fcf9f2;
  border-style: solid;
  border-width: 1px;
  border-color: #cfc5b1;
  border-radius: 14px;
  margin-top: 16px;
}
.qr-frame {
  padding: 24px;
  background-color: #fcf9f2;
  border-radius: 10px;
  margin: 24px 0 16px;
}
.credential-qr {
  width: 200px;
  height: 200px;
}
.deadline {
  font-size: 15px;
  line-height: 26px;
  color: #344c54;
  text-align: center;
}
.credential-note {
  font-size: 13px;
  line-height: 22px;
  color: #5c6869;
  text-align: center;
  margin-top: 8px;
}
.secondary-button {
  align-self: center;
  min-width: 180px;
  margin-top: 24px;
}
.refresh-link {
  align-self: center;
  text-align: center;
}
</style>
