<template><view class="page"><PageHead title="活动核销凭证"/><scroll-view class="page-scroll" direction="vertical"><view class="content"><ContentState v-if="loading||error" :loading="loading" :error="error" @retry="load"/><view v-else-if="credential" class="credential-card"><text class="section-heading">本次报名 · {{credential!.quantity}}人</text><image class="credential-qr" :src="credential!.qr" mode="aspectFit"/><text class="meta">有效至 {{formatChinaTime(credential!.expiresAt)}}（北京时间）</text><text class="footer-note">向本场次工作人员出示二维码，每位参加者分别确认到场。刷新后旧凭证失效。</text><button class="secondary-button" @click="copy">复制核销凭证</button><button class="text-button" :disabled="loading" @click="load">刷新二维码</button></view></view></scroll-view></view></template>
<script setup lang="ts">
import PageHead from '../../components/PageHead.uvue';import ContentState from '../../components/ContentState.uvue';import {request} from '../../lib/api';import {needLogin,currentUser} from '../../lib/session';import {formatChinaTime} from '../../lib/date-time';
type Credential={code:string;qr:string;expiresAt:string;quantity:number};const credential=ref<Credential|null>(null),loading=ref(false),error=ref('');let id='',owner='';
async function load(){if(loading.value||needLogin('/pages/booking/credential?id='+id))return;loading.value=true;error.value='';credential.value=null;try{credential.value=await request<Credential>('/me/bookings/registrations/'+id+'/checkin-code',{method:'POST'});}catch(e){error.value=(e as Error).message;}finally{loading.value=false;}}
function copy(){if(!credential.value)return;if(new Date(credential.value.expiresAt).valueOf()<=Date.now()){uni.showToast({title:'凭证已过期，请刷新',icon:'none'});return;}uni.setClipboardData({data:credential.value.code});}
onLoad(o=>{id=o?.id??'';});onShow(()=>{if(owner!==(currentUser.value?.id??'')){credential.value=null;owner=currentUser.value?.id??'';}if(id)load();});onHide(()=>{credential.value=null;});
</script><style>@import '../../styles/app.css';.credential-card{align-items:center;padding:24px 16px;background-color:#FFFEFA;border:1px solid #DFD9CF;border-radius:8px;margin-top:24px;}.credential-qr{width:256px;height:256px;margin:20px 0;}</style>
