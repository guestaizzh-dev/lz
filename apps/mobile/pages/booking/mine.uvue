<template>
  <view class="page"
    ><InkBackdrop /><PageHead title="我的预约与报名" /><scroll-view
      class="page-scroll"
      direction="vertical"
      ><view class="content"
        ><view class="list-toolbar"
          ><text class="ui-text list-toolbar-copy">咨询与活动安排 · 北京时间</text
          ><button
            class="ui-button text-button list-toolbar-action"
            @click="openPage('booking/orders')"
            >订单与售后 ›</button
          ></view
        ><button
          v-if="bookingId"
          class="ui-button text-button"
          @click="
            bookingId = '';
            reload();
          "
          >查看全部预约与报名 ›</button
        ><ContentState
          v-if="error || (loading && !items.length)"
          :loading="loading"
          :error="error"
          :error-title="error.includes('网络') ? '暂时无法加载' : '无法查看预约与报名'"
          @retry="reload"
        /><ContentState
          v-else-if="ready && !items.length"
          :title="bookingId ? '该预约不存在或无法访问' : '还没有预约或报名'"
          description="选择一场书院活动，或与老师约一次交流。"
          actionLabel="浏览书院活动"
          @action="openPage('event/index')"
        /><button
          v-if="ready && !loading && !error && !items.length"
          class="ui-button text-button empty-alternative"
          @click="openPage('teacher/index')"
          >找老师聊一聊 ›</button
        ><view v-for="b in items" :key="b.id" class="booking-card"
          ><view class="row between"
            ><text class="ui-text tag">{{
              b.kind === 'appointment' ? '老师预约' : '活动报名'
            }}</text
            ><text class="ui-text meta">{{
              b.scheduleCancelled && ['CONFIRMED', 'CANCEL_PENDING'].includes(b.state)
                ? '原安排已取消 · 退款办理中'
                : b.schedulePending
                  ? '待确认新安排'
                  : b.kind === 'registration' && b.state === 'COMPLETED'
                    ? '已签到'
                    : (bookingStates[b.state] ?? b.state)
            }}</text></view
          ><text class="ui-text booking-title">{{ b.title }}</text
          ><text class="ui-text booking-time"
            >{{ formatChinaTime(b.startsAt) }} — {{ formatChinaTime(b.endsAt).slice(11) }}</text
          ><text class="ui-text meta">{{ b.location }} · {{ b.quantity }}人</text
          ><text class="ui-text meta" :user-select="true">{{ b.policy }}</text
          ><view v-if="b.changeReason" class="schedule-change"
            ><text v-if="b.originalStartsAt !== b.startsAt" class="ui-text meta"
              >原安排：{{ formatChinaTime(b.originalStartsAt) }}</text
            ><text class="ui-text body-copy" :user-select="true">{{ b.changeReason }}</text
            ><text v-if="b.schedulePending" class="ui-text meta">{{
              new Date(b.startsAt).getTime() > serverNow
                ? '请确认新安排；如不方便参加，可退出，付费订单在售后入口全额退款。'
                : '你尚未确认此安排，可取消本次预约；不会直接记为缺席。'
            }}</text></view
          ><text
            v-if="
              b.state === 'CONFIRMED' &&
              (!b.schedulePending || new Date(b.cancelAt).getTime() > serverNow)
            "
            class="ui-text deadline"
            >取消截止：{{ formatChinaTime(b.cancelAt) }}</text
          ><text v-if="b.checkedCount > 0" class="ui-text meta"
            >已到场{{ b.checkedCount }} / {{ b.quantity }}人 · 已签到报名请联系书院处理变更</text
          ><view v-if="b.fulfilment" class="schedule-change"
            ><text class="ui-text section-heading"
              >{{ fulfilmentOutcomes[b.fulfilment!.outcome] }} ·
              {{ b.fulfilment!.deliveredCount }} / {{ b.quantity }}人</text
            ><text class="ui-text body-copy" :user-select="true">{{
              b.fulfilment!.publicSummary
            }}</text
            ><text class="ui-text meta"
              >{{ formatChinaTime(b.fulfilment!.createdAt) }} · 第{{
                b.fulfilment!.revision
              }}次记录</text
            ></view
          ><text
            v-else-if="
              b.kind === 'registration' &&
              new Date(b.endsAt).valueOf() <= serverNow &&
              ['CONFIRMED', 'COMPLETED'].includes(b.state)
            "
            class="ui-text meta"
            >活动已结束，等待书院记录实际履约结果</text
          ><button
            v-if="b.schedulePending && new Date(b.startsAt).getTime() > serverNow"
            class="ui-button primary-button schedule-accept"
            :disabled="busy"
            @click="accept(b)"
            >确认新安排</button
          ><button
            v-if="
              b.kind === 'registration' &&
              !b.scheduleCancelled &&
              !b.schedulePending &&
              ['CONFIRMED', 'COMPLETED'].includes(b.state) &&
              new Date(b.endsAt).valueOf() > serverNow
            "
            class="ui-button secondary-button"
            @click="openPage('booking/credential?id=' + b.id)"
            >出示活动核销凭证</button
          ><button
            v-if="b.orderId"
            class="ui-button secondary-button"
            @click="openPage('booking/purchase?orderId=' + b.orderId)"
            >查看订单与售后</button
          ><button
            v-if="b.canCancel && (b.schedulePending || new Date(b.cancelAt).getTime() > serverNow)"
            class="ui-button cancel-button"
            :disabled="busy"
            @click="cancel(b)"
            >取消{{ b.kind === 'appointment' ? '预约' : '报名' }}</button
          ></view
        ><button
          v-if="hasMore"
          class="ui-button retry"
          :disabled="loading || busy"
          @click="loadMore"
          >更多记录</button
        ></view
      ></scroll-view
    ></view
  >
</template>
<script setup lang="ts">
import InkBackdrop from '../../components/InkBackdrop.uvue';
import { pageRefresh } from '../../lib/page-refresh';
import PageHead from '../../components/PageHead.uvue';
import ContentState from '../../components/ContentState.uvue';
import { request } from '../../lib/api';
import { openPage } from '../../lib/presentation';
import { formatChinaTime } from '../../lib/date-time';
import { needLogin, currentUser } from '../../lib/session';
import { bookingStates, fulfilmentOutcomes } from '../../lib/bookings';
import type { Booking } from '../../lib/bookings';
const bookingId = ref('');
const items = ref<Booking[]>([]),
  loading = ref(false),
  busy = ref(false),
  error = ref(''),
  hasMore = ref(false),
  serverNow = ref(Date.now()),
  ready = ref(false);
let page = 1,
  owner = '';
async function load(append = false) {
  if (loading.value || needLogin()) return;
  loading.value = true;
  error.value = '';
  try {
    const result = await request<{ items: Booking[]; hasMore: boolean; serverTime: string }>(
      '/me/bookings?page=' +
        page +
        '&size=20' +
        (bookingId.value ? '&bookingId=' + encodeURIComponent(bookingId.value) : ''),
    );
    items.value = append ? [...items.value, ...result.items] : result.items;
    hasMore.value = result.hasMore;
    serverNow.value = new Date(result.serverTime).getTime();
  } catch (e) {
    error.value = (e as Error).message;
  } finally {
    loading.value = false;
    ready.value = true;
  }
}
function reload() {
  page = 1;
  load();
}
async function loadMore() {
  page++;
  await load(true);
  if (error.value) page--;
}
function accept(b: Booking) {
  if (busy.value) return;
  uni.showModal({
    title: '确认新安排',
    content: formatChinaTime(b.startsAt) + '\n' + b.location,
    confirmText: '确认参加',
    success: async (r) => {
      if (!r.confirm || busy.value) return;
      busy.value = true;
      try {
        await request(
          '/me/bookings/' +
            (b.kind === 'appointment' ? 'appointments' : 'registrations') +
            '/' +
            b.id +
            '/accept-schedule',
          { method: 'POST', data: { expectedScheduleVersion: b.scheduleVersion } },
        );
        uni.showToast({ title: '已确认新安排', icon: 'none' });
        reload();
      } catch (e) {
        uni.showToast({ title: (e as Error).message, icon: 'none' });
        reload();
      } finally {
        busy.value = false;
      }
    },
    fail: (e) => {
      console.error('Booking confirmation dialog failed', e);
      uni.showToast({ title: '确认窗口未能打开，请重新进入后再试', icon: 'none' });
    },
  });
}
function cancel(b: Booking) {
  if (busy.value) return;
  uni.showModal({
    title: '取消' + (b.kind === 'appointment' ? '预约' : '报名'),
    content: '取消后将释放名额，重新预约以当时剩余名额为准。',
    confirmText: '确认取消',
    success: async (r) => {
      if (!r.confirm || busy.value) return;
      busy.value = true;
      try {
        await request(
          '/me/bookings/' +
            (b.kind === 'appointment' ? 'appointments' : 'registrations') +
            '/' +
            b.id +
            '/cancel',
          { method: 'POST', data: { reason: '用户自助取消' } },
        );
        uni.showToast({ title: '已取消', icon: 'none' });
        reload();
      } catch (e) {
        uni.showToast({ title: (e as Error).message, icon: 'none' });
        reload();
      } finally {
        busy.value = false;
      }
    },
    fail: (e) => {
      console.error('Booking dialog failed', e);
      uni.showToast({ title: '操作窗口未能打开，请重新进入后再试', icon: 'none' });
    },
  });
}
onLoad((options) => {
  bookingId.value = options?.bookingId ?? '';
});
onShow(() => {
  if (owner !== (currentUser.value?.id ?? '')) {
    items.value = [];
    owner = currentUser.value?.id ?? '';
  }
  void refreshPage();
});

const refreshPage = pageRefresh(
  async () => {
    await load();
  },
  () => !error.value && !loading.value,
  60000,
);
</script>
<style>
@import '../../styles/app.css';
.content {
  padding-top: 16px;
}
.empty-alternative {
  align-self: center;
  margin-top: 0;
}
.booking-card {
  background-color: #fcf9f2;
  padding: 16px;
  border-style: solid;
  border-width: 1px;
  border-color: #cfc5b1;
  border-radius: 14px;
  margin-top: 16px;
}
.booking-title {
  font-family: AcademySerif;
  font-size: 19px;
  line-height: 28px;
  color: #182b31;
  margin: 12px 0 8px;
}
.booking-time {
  font-size: 15px;
  line-height: 26px;
  color: #344c54;
}
.deadline {
  font-size: 15px;
  line-height: 26px;
  color: #344c54;
  margin-top: 4px;
}
.cancel-button {
  align-self: flex-end;
  margin: 16px 0 0;
  padding: 10px 16px;
  min-height: 44px;
  line-height: 22px;
  font-size: 13px;
  background-color: transparent;
  color: #5c6869;
  border-style: solid;
  border-width: 1px;
  border-color: #c9bfad;
  border-radius: 10px;
}
.schedule-change {
  padding: 12px;
  background-color: #f0eadd;
  border-radius: 10px;
  margin: 12px 0;
}
.schedule-accept {
  margin-top: 16px;
  font-size: 15px;
}
</style>
