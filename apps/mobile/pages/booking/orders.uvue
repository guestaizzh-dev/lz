<template><view class="page"><PageHead title="预约与活动订单"/><scroll-view class="page-scroll" direction="vertical"><view class="content"><text class="intro">每笔订单保留原安排与取消规则。</text><ContentState v-if="error||(loading&&!items.length)" :loading="loading" :error="error" @retry="reload"/><ContentState v-else-if="ready&&!items.length" title="还没有付费预约订单" description="免费安排在我的预约与报名中查看。" actionLabel="查看我的预约与报名" @action="openPage('booking/mine')"/><view v-for="o in items" :key="o.id" class="order-card"><view class="row between"><text class="tag">{{bookingOrderLabel(o)}}</text><text class="price">¥{{money(Number(o.amount))}}</text></view><text class="item-title">{{o.booking.title}}</text><text class="meta">{{formatChinaTime(o.booking.startsAt)}} · {{o.booking.quantity}}人</text><text class="meta">{{o.booking.location}}</text><button class="secondary-button" @click="openPage('booking/purchase?orderId='+o.id)">查看订单与售后</button></view><button v-if="hasMore" class="text-button" :disabled="loading" @click="more">{{moreError?'重新加载':'更多订单'}}</button><text v-if="moreError" class="footer-note">{{moreError}}</text></view></scroll-view></view></template>
<script setup lang="ts">
import PageHead from '../../components/PageHead.uvue';import ContentState from '../../components/ContentState.uvue';import {request,money} from '../../lib/api';import {formatChinaTime} from '../../lib/date-time';import {openPage} from '../../lib/presentation';import {currentUser,needLogin} from '../../lib/session';import {bookingOrderLabel} from '../../lib/booking-sales';import type {BookingOrder} from '../../lib/booking-sales';
const items=ref<BookingOrder[]>([]),loading=ref(false),error=ref(''),hasMore=ref(false),ready=ref(false),moreError=ref('');let page=1,owner='';
async function load(append=false){if(loading.value||needLogin('/pages/booking/orders'))return;loading.value=true;error.value='';moreError.value='';try{const r=await request<{items:BookingOrder[];total:number}>('/commerce/booking-orders?page='+page+'&size=20');items.value=append?[...items.value,...r.items]:r.items;hasMore.value=page*20<r.total;}catch(e){if(append){moreError.value=(e as Error).message;page--;}else error.value=(e as Error).message;}finally{loading.value=false;ready.value=true;}}
function reload(){page=1;load();}function more(){page++;load(true);}onShow(()=>{if(owner!==(currentUser.value?.id??'')){items.value=[];owner=currentUser.value?.id??'';}reload();});
</script><style>@import '../../styles/app.css';.order-card{background-color:#FCF9F2;padding:16px;border-style:solid;border-width:1px;border-color:#E3DCCF;border-radius:12px;margin-top:12px;}</style>
