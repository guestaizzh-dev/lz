<template>
  <view class="page"
    ><InkBackdrop /><PageHead :title="order ? '预约与活动订单' : '确认预约与报名'" /><scroll-view
      class="page-scroll"
      direction="vertical"
      ><view class="content">
        <ContentState
          v-if="loading || error"
          :loading="loading"
          :error="error"
          :error-title="error.includes('网络') ? '暂时无法加载' : '无法查看此订单'"
          :retryable="error.includes('网络')"
          :action-label="error.includes('网络') ? '' : '返回我的预约'"
          @retry="load"
          @action="openPage('booking/mine')"
        />
        <view v-else-if="purchase"
          ><text class="ui-text eyebrow">书院之约</text
          ><text class="ui-text page-title">{{ purchase!.title }}</text
          ><text class="ui-text meta"
            >{{ purchase!.teacherName ?? purchase!.ticketTitle ?? '书院活动' }} ·
            {{ purchase!.quantity }}人</text
          >
          <view class="section"
            ><text class="ui-text item-title">{{ formatChinaTime(purchase!.startsAt) }}</text
            ><text class="ui-text meta"
              >至 {{ formatChinaTime(purchase!.endsAt).slice(11) }} · 北京时间</text
            ><text class="ui-text body-copy" :user-select="true">{{ purchase!.location }}</text
            ><text class="ui-text body-copy" :user-select="true">{{
              purchase!.deliveryPolicy
            }}</text></view
          >
          <view v-if="order?.booking.changeReason" class="policy"
            ><text class="ui-text section-heading">{{
              order!.booking.cancelled
                ? '原安排已取消'
                : order!.booking.schedulePending
                  ? '请确认新安排'
                  : '安排变更记录'
            }}</text
            ><text class="ui-text meta"
              >原时间：{{ formatChinaTime(order!.booking.originalStartsAt) }} —
              {{ formatChinaTime(order!.booking.originalEndsAt).slice(11) }}</text
            ><text class="ui-text meta">原地点：{{ order!.booking.originalLocation }}</text
            ><text class="ui-text body-copy" :user-select="true">{{
              order!.booking.changeReason
            }}</text
            ><text class="ui-text meta">{{
              order!.booking.cancelled
                ? '书院将自动办理整单原路退款；渠道确认后释放名额。'
                : order!.booking.schedulePending
                  ? '若新安排不方便，可退出并全额原路退款；未确认不会直接记为缺席。'
                  : '已确认延期的安排，可在新开始前退出并全额原路退款。'
            }}</text
            ><button
              v-if="order!.booking.schedulePending && Date.parse(order!.booking.startsAt) > clock"
              class="ui-button secondary-button"
              :disabled="busy"
              @click="acceptSchedule"
              >确认新安排</button
            ></view
          >
          <view v-if="purchase!.memberBenefit" class="policy"
            ><text class="ui-text section-heading">{{
              purchase!.memberBenefit!.code === 'CONSULTATION_CREDIT'
                ? '会员咨询抵扣'
                : purchase!.memberBenefit!.basisPoints === 0
                  ? '会员免费报名'
                  : '会员活动优惠'
            }}</text
            ><text class="ui-text meta"
              >服务 / 票种原价合计 ¥{{ money(Number(purchase!.originalTotal)) }} · 本次减免 ¥{{
                money(Number(purchase!.memberBenefit!.savings))
              }}</text
            ><text class="ui-text body-copy"
              >{{
                purchase!.memberBenefit!.code === 'CONSULTATION_CREDIT'
                  ? '本次预占原会员咨询额度，实际服务后计次；如需补差价按页面金额付款，取消或未交付返还原份额。'
                  : purchase!.memberBenefit!.basisPoints === 0
                    ? '本次已减免全部票价，确认报名即可，无需付款。'
                    : '按原票价的 ' +
                      purchase!.memberBenefit!.basisPoints / 100 +
                      '% 计费，退款按实付金额办理。'
              }}已确认的服务或活动安排不因会员到期取消。</text
            ></view
          >
          <view class="row between section"
            ><text class="ui-text section-heading">{{ order ? '订单金额' : '本次费用' }}</text
            ><text class="ui-text price"
              >¥{{ money(Number(order?.amount ?? quote?.total ?? 0)) }}</text
            ></view
          >
          <ConsumptionReward
            :order-id="order?.id"
            :revision="order"
            :eligible="Number(order?.amount ?? quote?.total ?? 0) > 0"
          /><view class="policy"
            ><text class="ui-text section-heading">取消与退款说明</text
            ><text class="ui-text deadline"
              >{{
                order?.booking.cancelled
                  ? '原取消截止'
                  : order?.booking.schedulePending
                    ? '确认新安排前可退出；新开始时间'
                    : '取消截止'
              }}：{{ formatChinaTime(purchase!.cancelDeadline) }}</text
            ><text class="ui-text body-copy" :user-select="true">{{
              purchase!.refundPolicy
            }}</text></view
          >
          <view v-if="order" class="section"
            ><view class="row between"
              ><text class="ui-text tag">{{ bookingOrderLabel(order!) }}</text
              ><button class="ui-button text-button" @click="copyNo">复制单号</button></view
            ><text class="ui-text meta" :user-select="true">{{ order!.orderNo }}</text
            ><text class="ui-text meta"
              >{{ paymentChannelLabel(order!.channel) }} · 创建于
              {{ formatChinaTime(order!.createdAt) }}</text
            ><text v-if="order!.state === 'PENDING'" class="ui-text body-copy">{{
              remaining > 0
                ? '名额保留还剩 ' + Math.ceil(remaining / 60000) + ' 分钟'
                : '名额保留已到期，请查询渠道结果后释放名额'
            }}</text
            ><text v-if="order!.state === 'PENDING'" class="ui-text meta"
              >支付结果未知时请先查询，勿重复付款。</text
            ><button
              v-if="order!.state === 'PAID' || order!.state === 'COMPLETED'"
              class="ui-button secondary-button"
              @click="openPage('booking/mine')"
              >查看预约 / 报名记录</button
            >
            <ServiceDeliveryResult
              v-if="order!.delivery"
              :delivery="order!.delivery!"
              :can-dispute="order!.canDispute"
            /><view v-for="r in order!.refunds" :key="r.id" class="refund-record"
              ><text class="ui-text section-heading"
                >{{ r.state === 'APPROVED' ? '请确认退款方案' : refundLabel(r.state) }} · ¥{{
                  money(Number(r.approvedAmount ?? r.requestedAmount))
                }}</text
              ><text class="ui-text body-copy" :user-select="true">{{ r.description }}</text
              ><text v-if="r.reviewNote" class="ui-text meta" :user-select="true"
                >处理意见：{{ r.reviewNote }}</text
              ><view v-if="r.assessmentSnapshot" class="policy"
                ><text class="ui-text body-copy">{{ r.assessmentSnapshot!.withdrawalScope }}</text
                ><text class="ui-text meta"
                  >原安排：{{ formatChinaTime(r.assessmentSnapshot!.startsAt) }} · 已签到
                  {{ r.assessmentSnapshot!.checkedCount }} /
                  {{ r.assessmentSnapshot!.quantity }} 人</text
                ><text v-if="r.approvedAmount" class="ui-text body-copy"
                  >拟原路退回 ¥{{ money(Number(r.approvedAmount)) }} · 保留 ¥{{
                    money(Number(r.assessmentSnapshot!.deductionAmount ?? 0))
                  }}</text
                ><text v-if="r.acceptedAt" class="ui-text meta"
                  >你已于 {{ formatChinaTime(r.acceptedAt) }} 确认方案</text
                ><button
                  v-if="r.state === 'APPROVED'"
                  class="ui-button secondary-button"
                  :disabled="busy"
                  @click="decideRefund(r, 'ACCEPT')"
                  >确认金额并退出</button
                ><button
                  v-if="r.state === 'APPROVED'"
                  class="ui-button text-button"
                  :disabled="busy"
                  @click="decideRefund(r, 'DECLINE')"
                  >不接受方案，保留原报名</button
                ></view
              ><text class="ui-text meta">{{ formatChinaTime(r.createdAt) }}</text></view
            ><button
              v-if="order!.canRefund"
              class="ui-button secondary-button"
              :disabled="busy"
              @click="
                disputeMode = false;
                showRefund = true;
              "
              >{{
                order!.refundReason !== 'BOOKING_RETURN'
                  ? '退出并全额原路退款'
                  : '申请取消并原路退款'
              }}</button
            ><button
              v-if="!order!.canRefund && order!.canDispute"
              class="ui-button secondary-button"
              :disabled="busy"
              @click="
                disputeMode = true;
                showRefund = true;
              "
              >申请服务核查与协商退款</button
            ></view
          >
          <view v-else class="section"
            ><text v-if="!quote?.paymentEnabled && !benefitReady" class="ui-text footer-note">{{
              quote?.unavailableReason
            }}</text
            ><view v-if="quote?.paymentEnabled || benefitReady"
              ><text class="ui-text field-label">联系人</text
              ><input
                class="ui-input booking-input"
                v-model="name"
                maxlength="50"
                placeholder="方便老师或书院称呼你的姓名"
                :disabled="busy || uncertain"
              /><text class="ui-text field-label">本次联系手机</text
              ><input
                class="ui-input booking-input"
                v-model="phone"
                type="number"
                maxlength="11"
                placeholder="11位手机号码"
                :disabled="busy || uncertain"
              /><button
                class="ui-button consent-button"
                :disabled="busy || uncertain"
                @click="agreed = !agreed"
                >{{ agreed ? '☑' : '□' }} 我已阅读取消规则，同意负责老师 /
                书院使用本次联系信息安排服务。</button
              ><button
                class="ui-button"
                v-for="c in benefitReady ? [] : choices"
                :key="c.channel"
                :class="['channel-choice', selectedChannel === c.channel ? 'chosen' : '']"
                :disabled="busy || uncertain"
                @click="selectedChannel = c.channel"
                >{{ c.label }}</button
              ><text v-if="!benefitReady && !choices.length" class="ui-text meta"
                >本平台暂未开放这款付款方式，可选择其他方式或联系书院。</text
              ></view
            ><text v-if="uncertain" class="ui-text error"
              >下单结果尚未确认，请重试原提交；联系信息与请求编号已保留。</text
            ></view
          >
          <text v-if="notice" class="ui-text error">{{ notice }}</text
          ><button
            v-if="order && order!.canPay && clientSupports(order!.channel) && remaining > 0"
            class="ui-button text-button"
            :disabled="busy"
            @click="refreshOrder"
            >查询订单与退款结果</button
          ><button
            v-else-if="!order && !uncertain"
            class="ui-button text-button"
            :disabled="busy"
            @click="load"
            >刷新报价与名额</button
          >
        </view></view
      ></scroll-view
    ><BottomBar v-if="purchase && !loading && !error"
      ><button
        v-if="order?.canCancel"
        class="ui-button bar-secondary"
        :disabled="busy"
        @click="cancelOrder"
        >取消订单</button
      ><button
        class="ui-button bar-primary"
        :disabled="
          busy ||
          (!order &&
            !quote?.pendingOrderId &&
            !uncertain &&
            ((!paymentReady && !benefitReady) || !agreed))
        "
        @click="primary"
        >{{
          busy
            ? '正在处理…'
            : order
              ? order!.canPay && clientSupports(order!.channel) && remaining > 0
                ? '继续支付'
                : '查询订单结果'
              : quote?.pendingOrderId
                ? '查看待支付订单'
                : uncertain
                  ? '重试原提交'
                  : benefitReady
                    ? '确认免费报名'
                    : paymentReady
                      ? '确认并保留名额'
                      : '付款暂未开放'
        }}</button
      ></BottomBar
    >
    <ComposeSheet
      :visible="showRefund"
      :title="disputeMode ? '申请服务核查' : '取消预约 / 报名'"
      :subtitle="
        disputeMode
          ? '说明服务问题；核查期间暂停继续参加，退款方案由你确认后才执行'
          : order?.refundReason !== 'BOOKING_RETURN'
            ? '安排变更可全额退回原实付；退款期间暂停参加，渠道确认后释放名额'
            : '说明原因；审核和退款期间暂停参加，渠道确认后释放名额'
      "
      v-model="refundReason"
      :maxlength="500"
      :saving="busy"
      :disabled="refundReason.trim().length < 2"
      :error="refundError"
      submitLabel="提交申请"
      @close="showRefund = false"
      @submit="submitRefund"
    />
  </view>
</template>
<script setup lang="ts">
import InkBackdrop from '../../components/InkBackdrop.uvue';
import { openNativePayment } from '../../lib/native-payment';
import ConsumptionReward from '../../components/ConsumptionReward.uvue';
import ServiceDeliveryResult from '../../components/ServiceDeliveryResult.uvue';
import PageHead from '../../components/PageHead.uvue';
import BottomBar from '../../components/BottomBar.uvue';
import ContentState from '../../components/ContentState.uvue';
import ComposeSheet from '../../components/ComposeSheet.uvue';
import { request, money } from '../../lib/api';
import { formatChinaTime } from '../../lib/date-time';
import { currentUser, needLogin } from '../../lib/session';
import { openPage } from '../../lib/presentation';
import { studyEventId } from '../../lib/learning';
import { purchasePlatform, paymentChannelLabel, refundLabel } from '../../lib/course-sales';
import { courseWechatAppId, courseAlipayAppId } from '../../lib/payment-config';
import { bookingOrderLabel } from '../../lib/booking-sales';
import type { BookingOrder, BookingQuote, BookingRefund } from '../../lib/booking-sales';
const platform = purchasePlatform(),
  quote = ref<BookingQuote | null>(null),
  order = ref<BookingOrder | null>(null),
  loading = ref(false),
  error = ref(''),
  notice = ref(''),
  busy = ref(false),
  agreed = ref(false),
  name = ref(''),
  phone = ref(''),
  selectedChannel = ref('WECHAT_NATIVE'),
  uncertain = ref(false),
  showRefund = ref(false),
  disputeMode = ref(false),
  refundReason = ref(''),
  refundError = ref(''),
  clock = ref(Date.now());
let kind = '',
  resourceId = '',
  skuId = '',
  quantity = 1,
  orderId = '',
  owner = '',
  offset = 0,
  requestKey = studyEventId(),
  refundKey = studyEventId(),
  pendingBody: Record<string, unknown> | null = null,
  pendingBenefit = false;
let timer: ReturnType<typeof setInterval> | null = null;
const purchase = computed(() => order.value?.booking ?? quote.value),
  remaining = computed(() =>
    order.value ? Math.max(0, Date.parse(order.value.expiresAt) - clock.value) : 0,
  ),
  choices = computed(
    () => quote.value?.channels.filter((c) => c.enabled && clientSupports(c.channel)) ?? [],
  ),
  paymentReady = computed(
    () =>
      !!quote.value?.paymentEnabled &&
      choices.value.some((c) => c.channel === selectedChannel.value),
  );
const benefitReady = computed(
  () => !!quote.value?.benefitConfirmationEnabled && Number(quote.value?.total) === 0,
);
function clientSupports(channel: string) {
  return (
    platform === 'ANDROID' &&
    (channel === 'WECHAT_NATIVE'
      ? true
      : channel === 'WECHAT_APP'
        ? !!courseWechatAppId
        : channel === 'ALIPAY_APP'
          ? !!courseAlipayAppId
          : false)
  );
}
function returnUrl() {
  return (
    '/pages/booking/purchase?' +
    (orderId
      ? 'orderId=' + orderId
      : 'kind=' +
        kind +
        '&resourceId=' +
        resourceId +
        '&quantity=' +
        quantity +
        (skuId ? '&skuId=' + skuId : ''))
  );
}
function clockFrom(row: { serverTime: string }) {
  offset = Date.parse(row.serverTime) - Date.now();
  clock.value = Date.now() + offset;
}
async function load() {
  if (loading.value || busy.value) return;
  const next = currentUser.value?.id ?? '';
  if (owner !== next) {
    owner = next;
    order.value = null;
    quote.value = null;
    uncertain.value = false;
    name.value = currentUser.value?.nickname ?? '';
    phone.value = '';
    agreed.value = false;
    requestKey = studyEventId();
    refundKey = studyEventId();
    pendingBody = null;
    pendingBenefit = false;
  }
  if (needLogin(returnUrl()) || uncertain.value) return;
  loading.value = true;
  error.value = '';
  try {
    if (orderId) {
      const result = await request<BookingOrder>('/commerce/booking-orders/' + orderId);
      if (next !== (currentUser.value?.id ?? '')) return;
      order.value = result;
      clockFrom(result);
    } else {
      const result = await request<BookingQuote>('/commerce/bookings/quote', {
        method: 'POST',
        data: { kind, resourceId, quantity, platform, ...(skuId ? { skuId } : {}) },
      });
      if (next !== (currentUser.value?.id ?? '')) return;
      if (quote.value?.quoteHash !== result.quoteHash) {
        agreed.value = false;
        requestKey = studyEventId();
      }
      quote.value = result;
      clockFrom(result);
      if (!choices.value.some((c) => c.channel === selectedChannel.value))
        selectedChannel.value = choices.value[0]?.channel ?? 'WECHAT_APP';
    }
  } catch (e) {
    if (next === (currentUser.value?.id ?? '')) error.value = (e as Error).message;
  } finally {
    loading.value = false;
  }
}
async function refreshOrder() {
  if (!order.value || busy.value) return;
  busy.value = true;
  notice.value = '';
  try {
    order.value = await request<BookingOrder>(
      '/commerce/booking-orders/' + order.value.id + '/refresh',
      { method: 'POST' },
    );
    clockFrom(order.value);
  } catch (e) {
    notice.value = (e as Error).message;
    order.value = { ...order.value, canPay: false };
  } finally {
    busy.value = false;
  }
}
async function pay() {
  const account = currentUser.value?.id,
    current = order.value;
  if (!current?.canPay || !clientSupports(current.channel)) return;
  if (current.channel === 'WECHAT_NATIVE') {
    await openNativePayment('BOOKING', current.id);
    notice.value = '请在微信完成扫码付款，返回后可查询原订单。';
    return;
  }
  const payment = await request<{ provider: 'wxpay' | 'alipay'; orderInfo: string }>(
    '/commerce/booking-orders/' + current.id + '/payment',
    { method: 'POST' },
  );
  if (account !== currentUser.value?.id) return;
  if (payment.provider === 'wxpay') {
    const sdk = JSON.parse(payment.orderInfo) as { appid: string };
    if (current.channel !== 'WECHAT_APP' || sdk.appid !== courseWechatAppId)
      throw Error('支付应用配置不匹配，请联系书院');
  } else if (
    current.channel !== 'ALIPAY_APP' ||
    payment.orderInfo.match(/(?:^|&)app_id=(\d+)(?:&|$)/)?.[1] !== courseAlipayAppId
  )
    throw Error('支付宝应用配置不匹配，请联系书院');
  await new Promise<void>((resolve, reject) =>
    uni.requestPayment({
      provider: payment.provider,
      orderInfo: payment.orderInfo,
      success: () => resolve(),
      fail: (e) => reject(Error(e.errMsg)),
    }),
  );
  if (account !== currentUser.value?.id) return;
  notice.value = '已返回支付结果，正在向渠道核查';
  const refreshed = await request<BookingOrder>(
    '/commerce/booking-orders/' + current.id + '/refresh',
    { method: 'POST' },
  );
  if (account !== currentUser.value?.id) return;
  order.value = refreshed;
  clockFrom(refreshed);
}
async function primary() {
  if (busy.value || needLogin(returnUrl())) return;
  if (
    order.value &&
    (!order.value.canPay || !clientSupports(order.value.channel) || remaining.value <= 0)
  ) {
    await refreshOrder();
    return;
  }
  if (!order.value && quote.value?.pendingOrderId) {
    orderId = quote.value.pendingOrderId;
    await load();
    return;
  }
  if (
    !order.value &&
    !uncertain.value &&
    ((!paymentReady.value && !benefitReady.value) ||
      !agreed.value ||
      !name.value.trim() ||
      !/^1[3-9]\d{9}$/.test(phone.value))
  ) {
    notice.value = '请填写联系人和有效手机号码，并阅读取消规则';
    return;
  }
  const account = currentUser.value?.id;
  let refreshNeeded = false;
  busy.value = true;
  notice.value = '';
  try {
    if (!order.value) {
      if (!pendingBody) {
        pendingBenefit = benefitReady.value;
        pendingBody = {
          kind,
          resourceId,
          quantity,
          platform,
          ...(!pendingBenefit ? { channel: selectedChannel.value } : {}),
          requestKey,
          quoteHash: quote.value!.quoteHash,
          name: name.value.trim(),
          phone: phone.value,
          contactConsent: true,
          ...(skuId ? { skuId } : {}),
        };
      }
      if (pendingBenefit) {
        const result = await request<{ id: string; state: string }>(
          '/commerce/bookings/confirm-benefit',
          { method: 'POST', data: pendingBody },
        );
        if (account !== currentUser.value?.id) return;
        uncertain.value = false;
        pendingBody = null;
        pendingBenefit = false;
        uni.redirectTo({ url: '/pages/booking/mine?bookingId=' + result.id });
        return;
      }
      const result = await request<BookingOrder>('/commerce/booking-orders', {
        method: 'POST',
        data: pendingBody,
      });
      if (account !== currentUser.value?.id) return;
      order.value = result;
      orderId = result.id;
      uncertain.value = false;
      pendingBody = null;
      clockFrom(result);
    }
    await pay();
  } catch (e) {
    if (account !== currentUser.value?.id) return;
    notice.value = (e as Error).message;
    if (!order.value) {
      const status = (e as Error & { status?: number }).status;
      if (status && [400, 403, 404, 409, 422, 503].includes(status)) {
        uncertain.value = false;
        pendingBody = null;
        pendingBenefit = false;
        requestKey = studyEventId();
        agreed.value = false;
        refreshNeeded = status === 409;
      } else uncertain.value = true;
    } else order.value = { ...order.value, canPay: false };
  } finally {
    busy.value = false;
    if (account !== currentUser.value?.id || refreshNeeded) void load();
  }
}
function cancelOrder() {
  if (!order.value || busy.value) return;
  uni.showModal({
    title: '取消待支付订单',
    content: '先向渠道核查支付结果；已付款订单保留并进入售后，未付款才释放名额。',
    confirmText: '确认取消',
    success: async (r) => {
      if (!r.confirm || !order.value || busy.value) return;
      busy.value = true;
      try {
        order.value = await request<BookingOrder>(
          '/commerce/booking-orders/' + order.value.id + '/cancel',
          { method: 'POST' },
        );
        clockFrom(order.value);
      } catch (e) {
        notice.value = (e as Error).message;
        order.value = { ...order.value, canPay: false };
      } finally {
        busy.value = false;
      }
    },
  });
}
async function submitRefund() {
  if (!order.value || busy.value) return;
  busy.value = true;
  refundError.value = '';
  try {
    order.value = await request<BookingOrder>(
      '/commerce/booking-orders/' + order.value.id + (disputeMode.value ? '/dispute' : '/refund'),
      { method: 'POST', data: { requestKey: refundKey, reason: refundReason.value.trim() } },
    );
    showRefund.value = false;
    refundKey = studyEventId();
    refundReason.value = '';
    clockFrom(order.value);
  } catch (e) {
    refundError.value = (e as Error).message;
  } finally {
    busy.value = false;
  }
}
function acceptSchedule() {
  const current = order.value;
  if (!current || busy.value) return;
  uni.showModal({
    title: '确认新安排',
    content: formatChinaTime(current.booking.startsAt) + '\n' + current.booking.location,
    confirmText: '确认参加',
    success: async (r) => {
      if (!r.confirm || busy.value) return;
      busy.value = true;
      notice.value = '';
      try {
        await request(
          '/me/bookings/' +
            (current.booking.kind === 'appointment' ? 'appointments' : 'registrations') +
            '/' +
            current.booking.id +
            '/accept-schedule',
          { method: 'POST', data: { expectedScheduleVersion: current.booking.scheduleVersion } },
        );
        order.value = await request<BookingOrder>('/commerce/booking-orders/' + current.id);
        clockFrom(order.value);
      } catch (e) {
        notice.value = (e as Error).message;
      } finally {
        busy.value = false;
      }
    },
    fail: () => {
      notice.value = '确认窗口未能打开，请重试';
    },
  });
}
function decideRefund(refund: BookingRefund, action: string) {
  if (!order.value || busy.value) return;
  const id = order.value.id;
  uni.showModal({
    title: action === 'ACCEPT' ? '确认退款金额与退出范围' : '不接受此方案',
    content:
      action === 'ACCEPT'
        ? '原路退回 ¥' +
          money(Number(refund.approvedAmount)) +
          '，保留 ¥' +
          money(Number(refund.assessmentSnapshot?.deductionAmount ?? 0)) +
          '。成功后终止本次剩余服务，已有参加记录保留。'
        : '保留原报名与原参加状态，不延长原取消期限；如仍有异议，可重新申请核查。',
    confirmText: action === 'ACCEPT' ? '确认并退出' : '保留报名',
    success: async (result) => {
      if (!result.confirm || busy.value) return;
      busy.value = true;
      notice.value = '';
      try {
        order.value = await request<BookingOrder>(
          '/commerce/booking-orders/' + id + '/refunds/' + refund.id + '/decision',
          { method: 'POST', data: { expectedVersion: refund.version, action } },
        );
        clockFrom(order.value);
      } catch (e) {
        notice.value = (e as Error).message;
      } finally {
        busy.value = false;
      }
    },
    fail: () => {
      notice.value = '确认窗口未能打开，请重试';
    },
  });
}
function copyNo() {
  if (order.value)
    uni.setClipboardData({
      data: order.value.orderNo,
      fail: () => {
        notice.value = '复制失败，请长按单号复制';
      },
    });
}
watch([name, phone, selectedChannel], () => {
  if (!busy.value && !uncertain.value) requestKey = studyEventId();
});
onLoad((o) => {
  kind = o?.kind ?? '';
  resourceId = o?.resourceId ?? '';
  skuId = o?.skuId ?? '';
  quantity = Number(o?.quantity ?? 1);
  orderId = o?.orderId ?? '';
});
onShow(() => {
  if (owner && (currentUser.value?.id ?? '') !== owner) {
    uncertain.value = false;
    pendingBody = null;
    order.value = null;
  }
  load();
  if (!timer)
    timer = setInterval(() => {
      clock.value = Date.now() + offset;
    }, 1000);
});
onHide(() => {
  if (timer) {
    clearInterval(timer);
    timer = null;
  }
});
onUnload(() => {
  if (timer) clearInterval(timer);
});
</script>
