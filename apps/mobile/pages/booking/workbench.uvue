<template>
  <view class="page"
    ><InkBackdrop /><PageHead title="现场工作台" /><scroll-view
      class="page-scroll"
      direction="vertical"
      ><view class="content"
        ><text class="ui-text intro">只处理获委派场次，逐人核对到场</text
        ><ContentState
          v-if="error || (loading && !sessions.length)"
          :loading="loading"
          :error="error"
          :error-title="error.includes('网络') ? '暂时无法加载' : '无权查看现场工作台'"
          :retryable="error.includes('网络')"
          :action-label="error.includes('网络') ? '' : '联系书院管理员'"
          @retry="load"
          @action="openPage('profile/service')"
        /><ContentState
          v-if="ready && !loading && !error && !sessions.length"
          title="暂无委派场次"
          description="由运营人员为你分配场次后，可在这里核销。"
        /><view v-if="sessions.length"
          ><text class="ui-text section-heading">选择场次</text
          ><button
            v-for="s in sessions"
            :key="s.id"
            class="ui-button session-choice"
            :class="selected?.id === s.id ? 'chosen' : ''"
            @click="select(s)"
            ><text class="ui-text item-title">{{ s.title }}</text
            ><text class="ui-text meta"
              >{{ formatChinaTime(s.startsAt) }} · {{ s.location }}</text
            ></button
          ><view v-if="selected" class="section"
            ><text class="ui-text section-heading">核对报名凭证</text
            ><button class="ui-button primary-button" :disabled="busy" @click="scan"
              >扫码核销</button
            ><textarea
              class="ui-input code-input"
              v-model="code"
              :disabled="busy || pending !== null"
              placeholder="也可以粘贴学员出示的完整核销凭证"
              aria-label="核销凭证"
              :maxlength="160"
            /><button
              class="ui-button secondary-button"
              :disabled="busy || !code.trim()"
              @click="inspect"
              >核对报名</button
            ><view v-if="inspection" class="inspection"
              ><text class="ui-text item-title"
                >{{ inspection!.name }} · {{ inspection!.quantity }}人</text
              ><text class="ui-text meta">{{ inspection!.phone }}</text
              ><button
                v-for="no in attendeeNumbers"
                :key="no"
                class="ui-button secondary-button"
                :class="inspection!.checkedAttendees.includes(no) ? 'seat-done' : ''"
                :disabled="
                  busy ||
                  inspection!.checkedAttendees.includes(no) ||
                  (pending !== null && pending!.attendeeNo !== no)
                "
                @click="checkin(no)"
                >{{
                  inspection!.checkedAttendees.includes(no)
                    ? '第' + no + '位已签到'
                    : '确认第' + no + '位到场'
                }}</button
              ></view
            ><text v-if="actionError" class="ui-text action-error">{{ actionError }}</text></view
          ><view v-if="selected" class="section"
            ><text class="ui-text section-heading">本场次到场记录</text
            ><text v-if="rosterError" class="ui-text action-error">{{ rosterError }}</text
            ><button class="ui-button text-button" :disabled="busy" @click="loadRoster()"
              >刷新记录</button
            ><view v-for="r in records" :key="r.id" class="arrival-row"
              ><text class="ui-text item-title">{{ r.name }} · {{ r.quantity }}人</text
              ><text class="ui-text meta"
                >{{ r.phone }} · {{ r.checkins.filter((c) => !c.revokedAt).length }}人已到场</text
              ><view v-for="c in r.checkins" :key="c.id"
                ><text class="ui-text meta"
                  >第{{ c.attendeeNo }}位 · {{ formatChinaTime(c.checkedAt)
                  }}{{ c.revokedAt ? ' · 已撤销' : '' }}</text
                ><text v-if="c.revokeReason" class="ui-text footer-note">{{ c.revokeReason }}</text
                ><button
                  v-if="selected!.canRevoke && !c.revokedAt"
                  class="ui-button text-button"
                  :disabled="busy"
                  @click="beginRevoke(c)"
                  >撤销误签到</button
                ></view
              ></view
            ><button
              v-if="records.length < total"
              class="ui-button secondary-button"
              :disabled="busy"
              @click="loadRoster(true)"
              >查看更多报名</button
            ></view
          ></view
        ></view
      ></scroll-view
    ><ComposeSheet
      :visible="!!reversing"
      title="撤销误签到"
      v-model="reason"
      :saving="busy"
      :error="actionError"
      :disabled="!reason.trim()"
      submit-label="确认撤销"
      @close="reversing = null"
      @submit="revoke"
  /></view>
</template>
<script setup lang="ts">
import InkBackdrop from '../../components/InkBackdrop.uvue';
import PageHead from '../../components/PageHead.uvue';
import ContentState from '../../components/ContentState.uvue';
import ComposeSheet from '../../components/ComposeSheet.uvue';
import { request } from '../../lib/api';
import { needLogin, currentUser } from '../../lib/session';
import { formatChinaTime } from '../../lib/date-time';
import { studyEventId } from '../../lib/learning';
import { openPage } from '../../lib/presentation';
type Session = {
  id: string;
  title: string;
  startsAt: string;
  endsAt: string;
  location: string;
  canRevoke: boolean;
};
type Arrival = {
  id: string;
  attendeeNo: number;
  checkedAt: string;
  revokedAt: string | null;
  revokeReason: string | null;
};
type RecordRow = { id: string; name: string; phone: string; quantity: number; checkins: Arrival[] };
type Inspection = {
  sessionId: string;
  name: string;
  phone: string;
  quantity: number;
  checkedAttendees: number[];
};
type Attempt = { code: string; attendeeNo: number; requestKey: string };
const sessions = ref<Session[]>([]),
  selected = ref<Session | null>(null),
  records = ref<RecordRow[]>([]),
  inspection = ref<Inspection | null>(null),
  pending = ref<Attempt | null>(null),
  loading = ref(false),
  busy = ref(false),
  error = ref(''),
  actionError = ref(''),
  rosterError = ref(''),
  code = ref(''),
  total = ref(0),
  reversing = ref<Arrival | null>(null),
  reason = ref(''),
  ready = ref(false);
let page = 1,
  owner = '',
  generation = 0;
const attendeeNumbers = computed(() =>
  Array.from({ length: inspection.value?.quantity ?? 0 }, (_, i) => i + 1),
);
async function load() {
  if (loading.value || needLogin('/pages/booking/workbench')) return;
  loading.value = true;
  error.value = '';
  try {
    sessions.value = await request<Session[]>('/me/event-workbench');
    if (selected.value && !sessions.value.some((s) => s.id === selected.value!.id)) {
      selected.value = null;
      records.value = [];
      inspection.value = null;
      pending.value = null;
    }
    if (!selected.value && sessions.value.length) selected.value = sessions.value[0];
    if (selected.value) await loadRoster();
  } catch (e) {
    error.value = (e as Error).message;
  } finally {
    loading.value = false;
    ready.value = true;
  }
}
function select(s: Session) {
  if (busy.value || pending.value) return;
  selected.value = s;
  inspection.value = null;
  code.value = '';
  actionError.value = '';
  loadRoster();
}
async function loadRoster(append = false) {
  if (!selected.value) return;
  const id = selected.value.id,
    g = ++generation,
    target = append ? page + 1 : 1;
  rosterError.value = '';
  try {
    const r = await request<{ items: RecordRow[]; total: number }>(
      '/me/event-workbench/sessions/' + id + '/roster?page=' + target + '&size=20',
    );
    if (g !== generation || selected.value?.id !== id) return;
    records.value = append ? [...records.value, ...r.items] : r.items;
    page = target;
    total.value = r.total;
  } catch (e) {
    if (g === generation) rosterError.value = (e as Error).message;
  }
}
function scan() {
  if (busy.value || pending.value) return;
  try {
    uni.scanCode({
      scanType: ['qrCode'],
      success: (r) => {
        code.value = r.result;
        inspect();
      },
      fail: () => {
        actionError.value = '未读取二维码，可重新扫描或粘贴凭证。';
      },
    });
  } catch {
    actionError.value = '当前环境无法扫码，请粘贴学员出示的凭证。';
  }
}
async function inspect() {
  if (busy.value) return;
  busy.value = true;
  actionError.value = '';
  try {
    const r = await request<Inspection>('/me/event-workbench/inspect', {
      method: 'POST',
      data: { code: code.value.trim() },
    });
    if (r.sessionId !== selected.value?.id) {
      actionError.value = '凭证属于其他场次，请先选择对应场次。';
      inspection.value = null;
      return;
    }
    inspection.value = r;
    if (pending.value && r.checkedAttendees.includes(pending.value.attendeeNo))
      pending.value = null;
  } catch (e) {
    actionError.value = (e as Error).message;
    inspection.value = null;
    if ((e as Error & { status?: number }).status === 409) pending.value = null;
  } finally {
    busy.value = false;
  }
}
async function checkin(no: number) {
  if (busy.value || !inspection.value) return;
  pending.value ??= { code: code.value.trim(), attendeeNo: no, requestKey: studyEventId() };
  busy.value = true;
  actionError.value = '';
  try {
    await request('/me/event-workbench/checkin', { method: 'POST', data: pending.value });
    pending.value = null;
    inspection.value = await request<Inspection>('/me/event-workbench/inspect', {
      method: 'POST',
      data: { code: code.value.trim() },
    });
    await loadRoster();
    uni.showToast({ title: '签到已记录', icon: 'none' });
  } catch (e) {
    actionError.value = (e as Error).message;
    const status = (e as Error & { status?: number }).status;
    if (status && status >= 400 && status < 500 && status !== 408) pending.value = null;
  } finally {
    busy.value = false;
  }
}
function beginRevoke(c: Arrival) {
  if (busy.value) return;
  reversing.value = c;
  reason.value = '';
  actionError.value = '';
}
async function revoke() {
  if (busy.value || !reversing.value || !reason.value.trim()) return;
  busy.value = true;
  actionError.value = '';
  try {
    await request('/me/event-workbench/checkins/' + reversing.value.id + '/revoke', {
      method: 'POST',
      data: { reason: reason.value.trim() },
    });
    reversing.value = null;
    inspection.value = null;
    await loadRoster();
    uni.showToast({ title: '误签到已撤销', icon: 'none' });
  } catch (e) {
    actionError.value = (e as Error).message;
  } finally {
    busy.value = false;
  }
}
onShow(() => {
  if (owner !== (currentUser.value?.id ?? '')) {
    owner = currentUser.value?.id ?? '';
    generation++;
    sessions.value = [];
    selected.value = null;
    records.value = [];
    inspection.value = null;
    pending.value = null;
    code.value = '';
    reversing.value = null;
  }
  load();
});
</script>
<style>
@import '../../styles/app.css';
.content {
  padding-top: 16px;
}
.session-choice {
  white-space: normal;
  text-align: left;
  background-color: #fcf9f2;
  border-style: solid;
  border-width: 1px;
  border-color: #cfc5b1;
  border-radius: 14px;
  padding: 14px;
  margin: 12px 0 0;
  min-height: 72px;
}
.chosen {
  border-width: 2px;
  border-color: #235663;
  background-color: #e6ede9;
}
.code-input {
  min-height: 92px;
  padding: 12px;
  background-color: #fcf9f2;
  border-style: solid;
  border-width: 1px;
  border-color: #cfc5b1;
  border-radius: 10px;
  font-size: 15px;
  line-height: 26px;
  margin-top: 16px;
}
.inspection {
  padding: 16px;
  background-color: #f0eadd;
  border-radius: 10px;
  margin-top: 16px;
}
.seat-done {
  border-color: #235663;
  background-color: #e6ede9;
  color: #235663;
}
.arrival-row {
  padding: 16px 0;
  border-bottom-style: solid;
  border-bottom-width: 1px;
  border-bottom-color: #e0d8c8;
}
.action-error {
  font-size: 13px;
  line-height: 22px;
  color: #b4533f;
  margin-top: 12px;
}
</style>
