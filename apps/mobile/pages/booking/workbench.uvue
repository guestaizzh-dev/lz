<template><view class="page"><PageHead title="现场工作台"/><scroll-view class="page-scroll" direction="vertical"><view class="content"><text class="meta">只处理获委派场次，逐人核对到场</text><ContentState v-if="loading||error" :loading="loading" :error="error" @retry="load"/><ContentState v-if="!loading&&!error&&!sessions.length" title="暂无委派场次" description="由运营人员为你分配场次后，可在这里核销。"/><view v-if="sessions.length"><text class="section-heading">选择场次</text><button v-for="s in sessions" :key="s.id" class="session-choice" @click="select(s)"><text class="item-title">{{s.title}}{{selected?.id===s.id?' · 当前场次':''}}</text><text class="meta">{{formatChinaTime(s.startsAt)}} · {{s.location}}</text></button><view v-if="selected" class="section"><text class="section-heading">核对报名凭证</text><button class="primary-button" :disabled="busy" @click="scan">扫码核销</button><textarea class="code-input" v-model="code" :disabled="busy||pending!==null" placeholder="也可以粘贴学员出示的完整核销凭证" aria-label="核销凭证" :maxlength="160"/><button class="secondary-button" :disabled="busy||!code.trim()" @click="inspect">核对报名</button><view v-if="inspection" class="inspection"><text class="item-title">{{inspection!.name}} · {{inspection!.quantity}}人</text><text class="meta">{{inspection!.phone}}</text><button v-for="no in attendeeNumbers" :key="no" class="secondary-button" :disabled="busy||inspection!.checkedAttendees.includes(no)||pending!==null&&pending!.attendeeNo!==no" @click="checkin(no)">{{inspection!.checkedAttendees.includes(no)?'第'+no+'位已签到':'确认第'+no+'位到场'}}</button></view><text v-if="actionError" class="action-error">{{actionError}}</text></view><view v-if="selected" class="section"><text class="section-heading">本场次到场记录</text><text v-if="rosterError" class="action-error">{{rosterError}}</text><button class="text-button" :disabled="busy" @click="loadRoster()">刷新记录</button><view v-for="r in records" :key="r.id" class="arrival-row"><text class="item-title">{{r.name}} · {{r.quantity}}人</text><text class="meta">{{r.phone}} · {{r.checkins.filter(c=>!c.revokedAt).length}}人已到场</text><view v-for="c in r.checkins" :key="c.id"><text class="meta">第{{c.attendeeNo}}位 · {{formatChinaTime(c.checkedAt)}}{{c.revokedAt?' · 已撤销':''}}</text><text v-if="c.revokeReason" class="footer-note">{{c.revokeReason}}</text><button v-if="selected!.canRevoke&&!c.revokedAt" class="text-button" :disabled="busy" @click="beginRevoke(c)">撤销误签到</button></view></view><button v-if="records.length<total" class="secondary-button" :disabled="busy" @click="loadRoster(true)">查看更多报名</button></view></view></view></scroll-view><ComposeSheet :visible="!!reversing" title="撤销误签到" v-model="reason" :saving="busy" :error="actionError" :disabled="!reason.trim()" submit-label="确认撤销" @close="reversing=null" @submit="revoke"/></view></template>
<script setup lang="ts">
import PageHead from '../../components/PageHead.uvue';import ContentState from '../../components/ContentState.uvue';import ComposeSheet from '../../components/ComposeSheet.uvue';import {request} from '../../lib/api';import {needLogin,currentUser} from '../../lib/session';import {formatChinaTime} from '../../lib/date-time';import {studyEventId} from '../../lib/learning';
type Session={id:string;title:string;startsAt:string;endsAt:string;location:string;canRevoke:boolean};type Arrival={id:string;attendeeNo:number;checkedAt:string;revokedAt:string|null;revokeReason:string|null};type RecordRow={id:string;name:string;phone:string;quantity:number;checkins:Arrival[]};type Inspection={sessionId:string;name:string;phone:string;quantity:number;checkedAttendees:number[]};type Attempt={code:string;attendeeNo:number;requestKey:string};
const sessions=ref<Session[]>([]),selected=ref<Session|null>(null),records=ref<RecordRow[]>([]),inspection=ref<Inspection|null>(null),pending=ref<Attempt|null>(null),loading=ref(false),busy=ref(false),error=ref(''),actionError=ref(''),rosterError=ref(''),code=ref(''),total=ref(0),reversing=ref<Arrival|null>(null),reason=ref('');let page=1,owner='',generation=0;
const attendeeNumbers=computed(()=>Array.from({length:inspection.value?.quantity??0},(_,i)=>i+1));
async function load(){if(loading.value||needLogin('/pages/booking/workbench'))return;loading.value=true;error.value='';try{sessions.value=await request<Session[]>('/me/event-workbench');if(selected.value&&!sessions.value.some(s=>s.id===selected.value!.id)){selected.value=null;records.value=[];inspection.value=null;pending.value=null;}if(!selected.value&&sessions.value.length)selected.value=sessions.value[0];if(selected.value)await loadRoster();}catch(e){error.value=(e as Error).message;}finally{loading.value=false;}}
function select(s:Session){if(busy.value||pending.value)return;selected.value=s;inspection.value=null;code.value='';actionError.value='';loadRoster();}
async function loadRoster(append=false){if(!selected.value)return;const id=selected.value.id,g=++generation,target=append?page+1:1;rosterError.value='';try{const r=await request<{items:RecordRow[];total:number}>('/me/event-workbench/sessions/'+id+'/roster?page='+target+'&size=20');if(g!==generation||selected.value?.id!==id)return;records.value=append?[...records.value,...r.items]:r.items;page=target;total.value=r.total;}catch(e){if(g===generation)rosterError.value=(e as Error).message;}}
function scan(){if(busy.value||pending.value)return;try{uni.scanCode({scanType:['qrCode'],success:r=>{code.value=r.result;inspect();},fail:()=>{actionError.value='未读取二维码，可重新扫描或粘贴凭证。';}});}catch{actionError.value='当前环境无法扫码，请粘贴学员出示的凭证。';}}
async function inspect(){if(busy.value)return;busy.value=true;actionError.value='';try{const r=await request<Inspection>('/me/event-workbench/inspect',{method:'POST',data:{code:code.value.trim()}});if(r.sessionId!==selected.value?.id){actionError.value='凭证属于其他场次，请先选择对应场次。';inspection.value=null;return;}inspection.value=r;if(pending.value&&r.checkedAttendees.includes(pending.value.attendeeNo))pending.value=null;}catch(e){actionError.value=(e as Error).message;inspection.value=null;if((e as Error&{status?:number}).status===409)pending.value=null;}finally{busy.value=false;}}
async function checkin(no:number){if(busy.value||!inspection.value)return;pending.value??={code:code.value.trim(),attendeeNo:no,requestKey:studyEventId()};busy.value=true;actionError.value='';try{await request('/me/event-workbench/checkin',{method:'POST',data:pending.value});pending.value=null;inspection.value=await request<Inspection>('/me/event-workbench/inspect',{method:'POST',data:{code:code.value.trim()}});await loadRoster();uni.showToast({title:'签到已记录',icon:'none'});}catch(e){actionError.value=(e as Error).message;const status=(e as Error&{status?:number}).status;if(status&&status>=400&&status<500&&status!==408)pending.value=null;}finally{busy.value=false;}}
function beginRevoke(c:Arrival){if(busy.value)return;reversing.value=c;reason.value='';actionError.value='';}
async function revoke(){if(busy.value||!reversing.value||!reason.value.trim())return;busy.value=true;actionError.value='';try{await request('/me/event-workbench/checkins/'+reversing.value.id+'/revoke',{method:'POST',data:{reason:reason.value.trim()}});reversing.value=null;inspection.value=null;await loadRoster();uni.showToast({title:'误签到已撤销',icon:'none'});}catch(e){actionError.value=(e as Error).message;}finally{busy.value=false;}}
onShow(()=>{if(owner!==(currentUser.value?.id??'')){owner=currentUser.value?.id??'';generation++;sessions.value=[];selected.value=null;records.value=[];inspection.value=null;pending.value=null;code.value='';reversing.value=null;}load();});
</script><style>@import '../../styles/app.css';.session-choice{white-space:normal;text-align:left;background-color:#FFFEFA;border:1px solid #E3DCCF;border-radius:4px;padding:16px;margin:12px 0 0;line-height:26px;}.code-input{min-height:92px;padding:12px;background-color:#FFFEFA;border:1px solid #E3DCCF;border-radius:4px;font-size:14px;line-height:24px;margin-top:16px;}.inspection{padding:16px;background-color:#EFE9DC;margin-top:16px;}.arrival-row{padding:16px 0;border-bottom:1px solid #E3DCCF;}.action-error{font-size:13px;line-height:23px;color:#9B3F32;margin-top:12px;}</style>
