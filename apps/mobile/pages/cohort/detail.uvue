<template><view class="page"><PageHead title="训练营"/><scroll-view class="page-scroll" direction="vertical"><view class="content"><ContentState v-if="!cohort" :loading="loading" :error="error" @retry="load"/><view v-else><text class="tag">{{cohort!.suspended?'退出与退款处理中':cohort!.enrolled?'已报名 · '+phase:'书院共学'}}</text><text class="detail-title">{{cohort!.title}}</text><text class="intro">{{cohort!.course.title}}</text><view class="section"><text class="section-heading">营期安排</text><text class="body-copy">{{formatChinaTime(cohort!.startsAt)}} 至 {{formatChinaTime(cohort!.endsAt)}}</text><text class="meta">报名截止 {{formatChinaTime(cohort!.enrollDeadline)}} · 剩余{{cohort!.available}}席</text><text class="meta">以上时间均为北京时间</text><text class="body-copy">本期费用：{{cohort!.price===null||cohort!.price===undefined?'待配置':Number(cohort!.price)===0?'免费':'¥'+money(Number(cohort!.price))}}</text></view><view v-if="cohort!.changeReason" class="section"><text class="section-heading">{{cohort!.state==='CANCELLED'?'本期已取消':'营期安排变更'}}</text><text class="body-copy" :user-select="true">{{cohort!.changeReason}}</text><text v-if="cohort!.originalSchedule" class="meta">原报名安排：{{formatChinaTime(cohort!.originalSchedule!.startsAt)}} 至 {{formatChinaTime(cohort!.originalSchedule!.endsAt)}}（北京）</text><text v-if="cohort!.registrationSchedule&&!cohort!.enrolled" class="meta">退出时安排：{{formatChinaTime(cohort!.registrationSchedule!.startsAt)}} 至 {{formatChinaTime(cohort!.registrationSchedule!.endsAt)}}（北京）</text><text v-if="cohort!.schedulePending&&!cohort!.suspended" class="footer-note">请核对上方最新安排。{{cohort!.scheduleAction==='EXTEND'?'本次只延长结营期限，原章节、作业与打卡日期保留。':''}}确认后才能进入学习与讨论；{{cohort!.paid?'不便参加可从原订单全额退出，渠道退款成功后释放席位。':'不便参加可取消本期报名，席位会立即释放。'}}</text><button v-if="cohort!.canAcceptSchedule" class="primary-button" :disabled="busy" @click="acceptSchedule">确认新的营期安排</button><text v-else-if="cohort!.schedulePending&&!cohort!.suspended" class="footer-note">新营期已开始，无法再确认；你仍可退出本期，或联系书院处理。</text></view><view class="section"><text class="section-heading">本期研习</text><text class="body-copy" :user-select="true">{{cohort!.course.description}}</text><text class="footer-note">本期章节按公布的时间陆续开放，结束后营期学习权限到期。营内讨论只向本期学员开放。{{cohort!.paid?'付费报名请从原订单申请退出，退款以渠道确认结果为准。':'开营前可自助取消报名。'}}</text><text class="footer-note">独立购课与每期共学分别记录进度，可继续报名同课程的其他营期。报名费用仅用于本期研习与教学；作业、打卡与老师点评均按本期独立保存。</text></view><view v-if="cohort!.lessonSchedule?.length" class="section"><text class="section-heading">章节安排</text><view v-for="item in cohort!.lessonSchedule" :key="item.id" class="schedule-row"><text class="body-copy">{{item.position}}. {{item.title}}</text><text class="meta">{{item.opensOnDay?'开营第'+item.opensOnDay+'天 · ':''}}{{item.opensAt?formatChinaTime(item.opensAt!)+'（北京）':'待安排'}}</text></view></view><button v-if="cohort!.enrolled&&!cohort!.suspended&&!cohort!.schedulePending" class="secondary-button" @click="openPage('course/practice?id='+cohort!.courseId+'&cohortId='+id)">本期作业与老师点评</button><button v-if="cohort!.enrolled&&!cohort!.suspended&&!cohort!.schedulePending" class="secondary-button" @click="openPage('course/checkin?id='+cohort!.courseId+'&cohortId='+id)">本期实践打卡</button><button v-if="cohort!.hasCertificate" class="secondary-button" @click="openPage('course/certificate?id='+cohort!.courseId+'&cohortId='+id)">查看本期研习完成记录</button><button v-if="cohort!.sectionId&&!cohort!.suspended" class="secondary-button" @click="openPage('community/index?cohortId='+id)">进入营内讨论</button><text v-if="cohort!.suspended" class="footer-note">本期退出申请正在办理，学习、作业、打卡和讨论暂停；渠道退款成功后释放席位。</text><button v-if="cohort!.orderId" class="secondary-button" @click="openPage('cohort/purchase?orderId='+cohort!.orderId)">查看本期订单与售后</button><button v-if="cohort!.canCancel" class="text-button" :disabled="busy" @click="cancel">取消本期报名</button><text v-if="error" class="error">{{error}}</text></view></view></scroll-view><BottomBar v-if="cohort"><button v-if="cohort!.canStudy" class="bar-primary" @click="openPage('course/player?id='+cohort!.courseId+'&cohortId='+id)">开始本期研习</button><button v-else-if="cohort!.purchaseAvailable" class="bar-primary" @click="openPage('cohort/purchase?cohortId='+id)">查看费用与购买说明</button><button v-else class="bar-primary" :disabled="busy||cohort!.enrolled||!cohort!.bookingEnabled||cohort!.available<1" @click="join">{{busy?'正在确认…':cohort!.state==='CANCELLED'?'本期已取消':cohort!.schedulePending?'请先确认新安排':cohort!.enrolled?phase==='未开营'?'已报名 · 等待开营':'本期已结束':cohort!.bookingEnabled?'免费报名本期':'报名暂未开放'}}</button></BottomBar></view></template>
<script setup lang="ts">
import PageHead from '../../components/PageHead.uvue';import BottomBar from '../../components/BottomBar.uvue';import ContentState from '../../components/ContentState.uvue';import {request,money} from '../../lib/api';import {formatChinaTime} from '../../lib/date-time';import {openPage} from '../../lib/presentation';import {needLogin,currentUser} from '../../lib/session';import type {Cohort} from '../../lib/cohorts';const cohort=ref<Cohort|null>(null),loading=ref(false),busy=ref(false),error=ref('');let id='',owner='';const phase=computed(()=>!cohort.value||new Date(cohort.value.startsAt).getTime()>Date.now()?'未开营':new Date(cohort.value.endsAt).getTime()<=Date.now()?'已结束':'研习中');
async function load(){if(loading.value)return;loading.value=true;error.value='';try{cohort.value=await request<Cohort>('/cohorts/'+id);}catch(e){error.value=(e as Error).message;}finally{loading.value=false;}}
function join(){if(needLogin('/pages/cohort/detail?id='+id)||busy.value)return;uni.showModal({title:'确认免费报名',content:'营期结束后本期权限到期；开营前可取消。本次报名保留既有购课记录，独立购课和其他营期权益不受影响，本期进度单独记录。',confirmText:'确认报名',success:async r=>{if(!r.confirm)return;busy.value=true;try{await request('/me/cohorts/'+id+'/join',{method:'POST'});await load();uni.showToast({title:'本期报名已确认',icon:'none'});}catch(e){error.value=(e as Error).message;}finally{busy.value=false;}}});}
function acceptSchedule(){const version=cohort.value?.scheduleVersion;if(!version||busy.value)return;uni.showModal({title:'确认新的营期安排',content:'新开营：'+formatChinaTime(cohort.value!.startsAt)+'；结营：'+formatChinaTime(cohort.value!.endsAt)+'（北京时间）。'+(cohort.value!.scheduleAction==='EXTEND'?'只延长结营期限，原章节、作业与打卡日期不变。':'章节、作业与打卡整体顺延。'),confirmText:'确认新安排',success:async r=>{if(!r.confirm||busy.value)return;busy.value=true;try{await request('/me/cohorts/'+id+'/accept-schedule',{method:'POST',data:{expectedScheduleVersion:version}});await load();uni.showToast({title:'新安排已确认',icon:'none'});}catch(e){const failure=(e as Error).message;await load();error.value=failure;}finally{busy.value=false;}}});}
function cancel(){uni.showModal({title:'取消本期报名？',content:'取消后释放席位，再次报名以剩余名额和截止时间为准。',confirmText:'确认取消',success:async r=>{if(!r.confirm||busy.value)return;busy.value=true;try{await request('/me/cohorts/'+id+'/cancel',{method:'POST'});await load();}catch(e){error.value=(e as Error).message;}finally{busy.value=false;}}});}
onLoad(o=>{id=o?.id??'';});onShow(()=>{if(owner!==(currentUser.value?.id??'')){cohort.value=null;owner=currentUser.value?.id??'';}if(id)load();});
</script><style>@import '../../styles/app.css';.schedule-row{padding:14px 0;border-bottom-width:1px;border-bottom-style:solid;border-bottom-color:#D8D4CA;}.error{font-size:13px;line-height:23px;color:#9B3F32;padding:16px 0;}</style>
