<template><view class="page"><PageHead title="我的训练营"/><scroll-view class="page-scroll" direction="vertical"><view class="content"><view class="list-toolbar"><text class="list-toolbar-copy">按期研习，记录共学所得</text><button class="text-button list-toolbar-action" @click="openPage('cohort/orders')">订单与售后 ›</button></view><ContentState v-if="error||(loading&&!items.length)" :loading="loading" :error="error" @retry="reload"/><ContentState v-else-if="ready&&!items.length" title="还没有参加训练营" description="与学友共读经典，按期完成研习与实践。" actionLabel="看看开放的训练营" @action="openPage('academy/index?format=COHORT')"/><button v-for="c in items" :key="c.id" class="cohort-card" @click="openPage('cohort/detail?id='+c.id)"><text class="tag">{{c.state==='CANCELLED'?'本期已取消':!c.enrolled?'已退出':c.suspended?'售后处理中':c.schedulePending?'待确认新安排':c.canStudy?'研习中':new Date(c.startsAt).getTime()>Date.now()?'等待开营':'已结束'}}</text><text class="cohort-title">{{c.title}}</text><text class="meta">{{formatChinaDate(!c.enrolled&&c.registrationSchedule?c.registrationSchedule!.startsAt:c.startsAt)}} — {{formatChinaDate(!c.enrolled&&c.registrationSchedule?c.registrationSchedule!.endsAt:c.endsAt)}} ›</text></button><button v-if="hasMore" class="retry" :disabled="loading" @click="more">更多记录</button></view></scroll-view></view></template>
<script setup lang="ts">import PageHead from '../../components/PageHead.uvue';import ContentState from '../../components/ContentState.uvue';import {request} from '../../lib/api';import {formatChinaDate} from '../../lib/date-time';import {openPage} from '../../lib/presentation';import {needLogin,currentUser} from '../../lib/session';import type {Cohort} from '../../lib/cohorts';const items=ref<Cohort[]>([]),loading=ref(false),error=ref(''),hasMore=ref(false),ready=ref(false);let page=1,owner='';async function load(append=false){if(loading.value||needLogin())return;loading.value=true;error.value='';try{const r=await request<{items:Cohort[];hasMore:boolean}>('/me/cohorts?page='+page+'&size=20');items.value=append?[...items.value,...r.items]:r.items;hasMore.value=r.hasMore;}catch(e){error.value=(e as Error).message;}finally{loading.value=false;ready.value=true;}}function reload(){page=1;load();}async function more(){page++;await load(true);if(error.value)page--;}onShow(()=>{if(owner!==(currentUser.value?.id??'')){items.value=[];owner=currentUser.value?.id??'';}reload();});</script>
<style>@import '../../styles/app.css';.cohort-card{white-space:normal;text-align:left;background-color:#FCF9F2;border-style:solid;border-width:1px;border-color:#E3DCCF;border-radius:12px;padding:16px;margin:12px 0 0;line-height:25px;}.cohort-title{font-family:AcademySerif;font-size:19px;color:#182B31;line-height:29px;margin:10px 0;}</style>
