<template><view class="page"><PageHead title="训练营订单"/><scroll-view class="page-scroll" direction="vertical"><view class="content"><text class="intro">每笔报名保留本期安排与退出规则。</text><ContentState v-if="loading||error" :loading="loading" :error="error" @retry="reload"/><ContentState v-else-if="!items.length" title="还没有付费训练营订单" description="免费报名在我的训练营中查看。" actionLabel="查看我的训练营" @action="openPage('cohort/index')"/><view v-for="o in items" :key="o.id" class="order-card"><view class="row between"><text class="tag">{{cohortOrderLabel(o)}}</text><text class="price">¥{{money(Number(o.amount))}}</text></view><text class="item-title">{{o.cohort.title}}</text><text class="meta">{{formatChinaTime(o.cohort.startsAt)}} · {{1}}人</text><text class="meta">{{o.cohort.courseTitle}}</text><button class="secondary-button" @click="openPage('cohort/purchase?orderId='+o.id)">查看订单与售后</button></view><button v-if="hasMore" class="text-button" :disabled="loading" @click="more">更多订单</button></view></scroll-view></view></template>
<script setup lang="ts">
import PageHead from '../../components/PageHead.uvue';import ContentState from '../../components/ContentState.uvue';import {request,money} from '../../lib/api';import {formatChinaTime} from '../../lib/date-time';import {openPage} from '../../lib/presentation';import {currentUser,needLogin} from '../../lib/session';import {cohortOrderLabel} from '../../lib/cohort-sales';import type {CohortOrder} from '../../lib/cohort-sales';
const items=ref<CohortOrder[]>([]),loading=ref(false),error=ref(''),hasMore=ref(false);let page=1,owner='';
async function load(append=false){if(loading.value||needLogin('/pages/cohort/orders'))return;loading.value=true;error.value='';try{const r=await request<{items:CohortOrder[];total:number}>('/commerce/cohort-orders?page='+page+'&size=20');items.value=append?[...items.value,...r.items]:r.items;hasMore.value=page*20<r.total;}catch(e){error.value=(e as Error).message;if(append)page--;}finally{loading.value=false;}}
function reload(){page=1;load();}function more(){page++;load(true);}onShow(()=>{if(owner!==(currentUser.value?.id??'')){items.value=[];owner=currentUser.value?.id??'';}reload();});
</script><style>@import '../../styles/app.css';.order-card{background-color:#FFFEFA;padding:18px 16px;border:1px solid #E2DDD3;border-radius:4px;margin-top:18px;}</style>
