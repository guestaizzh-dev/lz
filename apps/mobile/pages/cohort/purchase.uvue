<template><view class="page"><PageHead title="训练营报名订单"/><scroll-view class="page-scroll" direction="vertical"><view class="content">
<ContentState v-if="loading||error" :loading="loading" :error="error" @retry="load"/>
<view v-else-if="purchase"><text class="eyebrow">同行共学</text><text class="page-title">{{purchase!.title}}</text><text class="meta">{{purchase!.courseTitle}} · {{purchase!.teacherName}}</text>
<view class="section"><text class="section-heading">{{order?'购买时原安排':'本期安排'}}</text><text class="body-copy">{{formatChinaTime(purchase!.startsAt)}} 至 {{formatChinaTime(purchase!.endsAt)}}</text><text class="meta">报名截止 {{formatChinaTime(purchase!.enrollDeadline)}} · 北京时间</text><text class="meta">本期固定版本 · {{purchase!.contentFormats.map(f=>f==='TEXT'?'文字':f==='AUDIO'?'音频':'视频').join(' / ')}}</text></view>
<view v-if="order&&order!.currentSchedule.scheduleVersion!==order!.cohort.scheduleVersion" class="policy"><text class="section-heading">{{order!.currentSchedule.cancelled?'本期已取消':'最新营期安排'}}</text><text class="body-copy">{{formatChinaTime(order!.currentSchedule.startsAt)}} 至 {{formatChinaTime(order!.currentSchedule.endsAt)}}（北京）</text><text class="meta" :user-select="true">{{order!.currentSchedule.changeReason}}</text><text v-if="order!.currentSchedule.action==='EXTEND'" class="meta">仅延长结营期限，原章节、作业和打卡日期保持。</text><text v-if="order!.currentSchedule.schedulePending&&!order!.registration?.suspendedAt" class="meta">请确认最新安排后继续参与；不便参加可全额退出。</text><button v-if="order!.currentSchedule.canAcceptSchedule" class="secondary-button" :disabled="busy" @click="acceptSchedule">确认最新营期安排</button><text v-if="order!.currentSchedule.cancelled" class="meta">书院自动全额原路退款，渠道成功后释放席位，请查询处理结果。</text></view><view class="row between section"><text class="section-heading">{{order?'原订单金额':'本期费用'}}</text><text class="price">¥{{money(Number(order?.amount??quote?.total??0))}}</text></view>
<ConsumptionReward :order-id="order?.id" :revision="order" :eligible="Number(order?.amount??quote?.total??0)>0"/><view class="policy"><text class="section-heading">退出与退款说明</text><text class="body-copy" :user-select="true">{{policyExpanded?purchase!.refundPolicy:'开营前可全额退出；安排变更可确认或全额退出。开营后核查实际交付，由你确认退款方案；书院取消全额退回。申请期间暂停本期交付，渠道退款成功后释放席位。'}}</text><button class="text-button" @click="policyExpanded=!policyExpanded">{{policyExpanded?'收起完整规则':'查看完整退出与退款规则'}}</button><text class="meta">报名只获得本期研习与教学权限，结营到期；独立购课和其他营期分别保存。</text></view>
<view v-if="order" class="section"><view class="row between"><text class="tag">{{cohortOrderLabel(order!)}}</text><button class="text-button" @click="copyNo">复制单号</button></view><text class="meta" :user-select="true">{{order!.orderNo}}</text><text class="meta">{{paymentChannelLabel(order!.channel)}} · 创建于 {{formatChinaTime(order!.createdAt)}}</text><text v-if="order!.state==='PENDING'" class="body-copy">{{remaining>0?'占位还剩 '+Math.ceil(remaining/60000)+' 分钟':'占位已到期，请查询支付结果后释放席位'}}</text><text v-if="order!.state==='PENDING'" class="meta">支付结果未知时请先查询，勿重复付款。</text>
<button v-if="order!.registration" class="secondary-button" @click="openPage('cohort/detail?id='+order!.cohort.cohortId)">查看本期学习与教学安排</button>
<ServiceDeliveryResult v-if="order!.delivery" :delivery="order!.delivery!" :can-dispute="order!.canDispute"/><view v-for="r in order!.refunds" :key="r.id" class="refund-record"><text class="section-heading">{{refundLabel(r.state)}} · ¥{{money(Number(r.approvedAmount??r.requestedAmount))}}</text><text class="body-copy" :user-select="true">{{r.description}}</text><text v-if="r.reviewNote" class="meta" :user-select="true">处理意见：{{r.reviewNote}}</text><view v-if="r.assessmentSnapshot" class="proposal"><text class="meta">已打开 {{r.assessmentSnapshot!.openedLessons}} 讲 · 完成 {{r.assessmentSnapshot!.completedLessons}} 讲 · 提交 {{r.assessmentSnapshot!.submittedAssignments}} 次作业 · 打卡 {{r.assessmentSnapshot!.checkinDays}} 次</text><text class="meta">学习数量不直接折算扣费，以核查的交付依据和本人确认金额为准。</text><text v-if="r.assessmentSnapshot!.deductionAmount" class="body-copy">{{r.state==='APPROVED'?'拟退款':'方案退款'}} ¥{{money(Number(r.approvedAmount))}} · 保留款 ¥{{money(Number(r.assessmentSnapshot!.deductionAmount))}}</text><text class="meta" :user-select="true">{{r.assessmentSnapshot!.withdrawalScope}}</text><text v-if="r.acceptedAt" class="meta">本人已于 {{formatChinaTime(r.acceptedAt!)}} 确认方案</text><view v-if="r.state==='APPROVED'&&r.reasonCode==='COHORT_DISPUTE'&&!order!.currentSchedule.cancelled" class="section"><button class="secondary-button" :disabled="busy" @click="decideRefund(r,'ACCEPT')">同意方案并退出本期</button><button class="text-button" :disabled="busy" @click="decideRefund(r,'DECLINE')">不同意，保留原营期</button></view></view><text class="meta">{{formatChinaTime(r.createdAt)}}</text></view>
<button v-if="order!.canCancel" class="text-button" :disabled="busy" @click="cancelOrder">取消待支付订单</button><button v-if="order!.canRefund" class="secondary-button" :disabled="busy" @click="openRefund(false)">{{order!.refundReason==='COHORT_SCHEDULE_RETURN'?'不接受新安排，申请全额退出':'申请退出并原路退款'}}</button><button v-if="order!.canDispute&&!order!.canRefund" class="secondary-button" :disabled="busy" @click="openRefund(true)">申请服务核查与协商退款</button><button v-if="order!.state==='PAID'&&!order!.canRefund&&!order!.canDispute&&!order!.registration?.suspendedAt" class="text-button" @click="openPage('profile/service')">联系书院核查服务与售后</button></view>
<view v-else-if="quote"><view v-if="quote!.paymentEnabled" class="section"><text class="section-heading">付款方式</text><button v-for="c in choices" :key="c.channel" class="channel-choice" :class="{'chosen':selectedChannel===c.channel}" :disabled="busy||uncertain" @click="selectedChannel=c.channel">{{c.label}}</button><button class="consent-button" :disabled="busy||uncertain" @click="agreed=!agreed">{{agreed?'☑':'□'}} 我已阅读营期时间、固定版本、到期与退出规则</button></view><text v-else class="error">{{quote!.unavailableReason}}</text></view><text v-if="notice" class="error">{{notice}}</text>
</view></view></scroll-view><BottomBar v-if="purchase"><button class="bar-primary" :disabled="busy||(!order&&!uncertain&&!quote?.pendingOrderId&&(!paymentReady||!agreed))" @click="primary">{{busy?'正在处理…':order?order!.canPay&&clientSupports(order!.channel)&&remaining>0?'继续支付':'查询订单与退款结果':quote?.pendingOrderId?'查看原待支付订单':uncertain?'核查刚才的报名订单':'确认报名 · ¥'+money(Number(quote?.total??0))}}</button></BottomBar>
<ComposeSheet :visible="showRefund" :title="dispute?'服务核查与协商退款':'申请退出本期训练营'" :subtitle="dispute?'说明实际问题。核查期间暂停本期交付，财务提出金额与依据，由你确认后才退款；不同意可保留原营期。':'开营前或安排变更可全额退出；申请期间暂停本期交付，渠道退款成功后释放席位。其他营期及独立购课独立。'" placeholder="简要说明退出原因" v-model="refundReason" :error="refundError" :saving="busy" :disabled="refundReason.trim().length<2" :maxlength="500" :submit-label="dispute?'提交服务核查':'提交退出申请'" @close="showRefund=false" @submit="submitRefund"/>
</view></template>
<script setup lang="ts">
import ConsumptionReward from '../../components/ConsumptionReward.uvue';
import ServiceDeliveryResult from '../../components/ServiceDeliveryResult.uvue';
import PageHead from '../../components/PageHead.uvue';import BottomBar from '../../components/BottomBar.uvue';import ContentState from '../../components/ContentState.uvue';import ComposeSheet from '../../components/ComposeSheet.uvue';import {request,money} from '../../lib/api';import {formatChinaTime} from '../../lib/date-time';import {currentUser,needLogin} from '../../lib/session';import {openPage} from '../../lib/presentation';import {studyEventId} from '../../lib/learning';import {purchasePlatform,paymentChannelLabel,refundLabel} from '../../lib/course-sales';import {courseWechatAppId,courseAlipayAppId} from '../../lib/payment-config';import {cohortOrderLabel} from '../../lib/cohort-sales';import type {CohortOrder,CohortQuote,CohortRefund} from '../../lib/cohort-sales';
const platform=purchasePlatform(),quote=ref<CohortQuote|null>(null),order=ref<CohortOrder|null>(null),loading=ref(false),error=ref(''),notice=ref(''),busy=ref(false),agreed=ref(false),selectedChannel=ref('WECHAT_APP'),uncertain=ref(false),showRefund=ref(false),dispute=ref(false),policyExpanded=ref(false),refundReason=ref(''),refundError=ref(''),clock=ref(Date.now());let cohortId='',orderId='',owner='',offset=0,requestKey=studyEventId(),refundKey=studyEventId(),pendingBody:Record<string,unknown>|null=null;let timer:ReturnType<typeof setInterval>|null=null;
const purchase=computed(()=>order.value?.cohort??quote.value),remaining=computed(()=>order.value?Math.max(0,Date.parse(order.value.expiresAt)-clock.value):0),choices=computed(()=>quote.value?.channels.filter(c=>c.enabled&&clientSupports(c.channel))??[]),paymentReady=computed(()=>!!quote.value?.paymentEnabled&&choices.value.some(c=>c.channel===selectedChannel.value));
function clientSupports(channel:string){return platform==='ANDROID'&&(channel==='WECHAT_APP'?!!courseWechatAppId:channel==='ALIPAY_APP'?!!courseAlipayAppId:false);}
function returnUrl(){return '/pages/cohort/purchase?'+(orderId?'orderId='+orderId:'cohortId='+cohortId);}
function clockFrom(row:{serverTime:string}){offset=Date.parse(row.serverTime)-Date.now();clock.value=Date.now()+offset;}
async function load(){if(loading.value||busy.value||uncertain.value||needLogin(returnUrl()))return;const next=currentUser.value?.id??'';if(owner!==next){owner=next;order.value=null;quote.value=null;agreed.value=false;requestKey=studyEventId();refundKey=studyEventId();refundReason.value='';refundError.value='';showRefund.value=false;dispute.value=false;pendingBody=null;}loading.value=true;error.value='';try{if(orderId){order.value=await request<CohortOrder>('/commerce/cohort-orders/'+orderId);clockFrom(order.value);}else{const result=await request<CohortQuote>('/commerce/cohorts/quote',{method:'POST',data:{cohortId,platform}});if(quote.value?.quoteHash!==result.quoteHash){agreed.value=false;requestKey=studyEventId();}quote.value=result;clockFrom(result);if(!choices.value.some(c=>c.channel===selectedChannel.value))selectedChannel.value=choices.value[0]?.channel??'WECHAT_APP';}}catch(e){error.value=(e as Error).message;}finally{loading.value=false;}}
async function refreshOrder(){if(!order.value||busy.value)return;busy.value=true;notice.value='';try{order.value=await request<CohortOrder>('/commerce/cohort-orders/'+order.value.id+'/refresh',{method:'POST'});clockFrom(order.value);}catch(e){notice.value=(e as Error).message;order.value={...order.value,canPay:false};}finally{busy.value=false;}}
async function pay(){const current=order.value;if(!current?.canPay||!clientSupports(current.channel))return;const payment=await request<{provider:'wxpay'|'alipay';orderInfo:string}>('/commerce/cohort-orders/'+current.id+'/payment',{method:'POST'});if(payment.provider==='wxpay'){if(current.channel!=='WECHAT_APP'||(JSON.parse(payment.orderInfo) as {appid:string}).appid!==courseWechatAppId)throw Error('支付应用配置不匹配，请联系书院');}else if(current.channel!=='ALIPAY_APP'||payment.orderInfo.match(/(?:^|&)app_id=(\d+)(?:&|$)/)?.[1]!==courseAlipayAppId)throw Error('支付宝应用配置不匹配，请联系书院');await new Promise<void>((resolve,reject)=>uni.requestPayment({provider:payment.provider,orderInfo:payment.orderInfo,success:()=>resolve(),fail:e=>reject(Error(e.errMsg))}));notice.value='正在向支付渠道核查报名结果';order.value=await request<CohortOrder>('/commerce/cohort-orders/'+current.id+'/refresh',{method:'POST'});clockFrom(order.value);}
async function primary(){if(busy.value||needLogin(returnUrl()))return;if(order.value&&(!order.value.canPay||!clientSupports(order.value.channel)||remaining.value<=0)){await refreshOrder();return;}if(!order.value&&quote.value?.pendingOrderId){orderId=quote.value.pendingOrderId;await load();return;}if(!order.value&&!uncertain.value&&(!paymentReady.value||!agreed.value))return;busy.value=true;notice.value='';try{if(!order.value){pendingBody??={cohortId,platform,channel:selectedChannel.value,requestKey,quoteHash:quote.value!.quoteHash};order.value=await request<CohortOrder>('/commerce/cohort-orders',{method:'POST',data:pendingBody});orderId=order.value.id;uncertain.value=false;pendingBody=null;clockFrom(order.value);}await pay();}catch(e){notice.value=(e as Error).message;if(!order.value){const status=(e as Error&{status?:number}).status;if(status&&[400,403,404,409,422,503].includes(status)){uncertain.value=false;pendingBody=null;requestKey=studyEventId();agreed.value=false;}else uncertain.value=true;}else order.value={...order.value,canPay:false};}finally{busy.value=false;}}
function cancelOrder(){if(!order.value||busy.value)return;uni.showModal({title:'取消待支付营期订单',content:'先向渠道核查结果，未付款才释放席位；已经付款则保留报名并进入售后。',confirmText:'确认取消',success:async r=>{if(!r.confirm||!order.value||busy.value)return;busy.value=true;try{order.value=await request<CohortOrder>('/commerce/cohort-orders/'+order.value.id+'/cancel',{method:'POST'});clockFrom(order.value);}catch(e){notice.value=(e as Error).message;order.value={...order.value,canPay:false};}finally{busy.value=false;}}});}
async function submitRefund(){if(!order.value||busy.value)return;busy.value=true;refundError.value='';try{order.value=await request<CohortOrder>('/commerce/cohort-orders/'+order.value.id+(dispute.value?'/dispute':'/refund'),{method:'POST',data:{requestKey:refundKey,reason:refundReason.value.trim()}});showRefund.value=false;refundKey=studyEventId();refundReason.value='';clockFrom(order.value);}catch(e){refundError.value=(e as Error).message;}finally{busy.value=false;}}
function openRefund(service:boolean){if(busy.value)return;if(dispute.value!==service){refundReason.value='';refundKey=studyEventId();}dispute.value=service;refundError.value='';showRefund.value=true;}
function acceptSchedule(){const row=order.value;if(!row?.currentSchedule.canAcceptSchedule||busy.value)return;uni.showModal({title:'确认最新营期安排',content:formatChinaTime(row.currentSchedule.startsAt)+' 至 '+formatChinaTime(row.currentSchedule.endsAt)+'（北京）。'+(row.currentSchedule.action==='EXTEND'?'只延长结营期限，原教学日期保留。':'章节与教学日期随开营整体顺延。'),confirmText:'确认新安排',success:async result=>{if(!result.confirm||busy.value)return;busy.value=true;try{await request('/me/cohorts/'+row.cohort.cohortId+'/accept-schedule',{method:'POST',data:{expectedScheduleVersion:row.currentSchedule.scheduleVersion}});order.value=await request<CohortOrder>('/commerce/cohort-orders/'+row.id);clockFrom(order.value);}catch(e){notice.value=(e as Error).message;}finally{busy.value=false;}}});}
function decideRefund(refund:CohortRefund,action:string){const row=order.value;if(!row||busy.value)return;uni.showModal({title:action==='ACCEPT'?'确认退款并退出本期？':'不同意方案，保留原营期？',content:action==='ACCEPT'?'退款 ¥'+money(Number(refund.approvedAmount))+'，保留款 ¥'+money(Number(refund.assessmentSnapshot?.deductionAmount??0))+'。'+(refund.reviewNote??'')+'；渠道成功后终止本期剩余交付，既有记录保留。':'恢复原期限与安排确认状态，时间不会延长。仍有异议可以重新提交核查。',confirmText:action==='ACCEPT'?'同意并退出':'保留原营期',success:async result=>{if(!result.confirm||busy.value)return;busy.value=true;notice.value='';try{order.value=await request<CohortOrder>('/commerce/cohort-orders/'+row.id+'/refunds/'+refund.id+'/decision',{method:'POST',data:{expectedVersion:refund.version,action}});clockFrom(order.value);}catch(e){notice.value=(e as Error).message;}finally{busy.value=false;}}});}
function copyNo(){if(order.value)uni.setClipboardData({data:order.value.orderNo,fail:()=>{notice.value='复制失败，请长按单号复制';}});}
watch(selectedChannel,()=>{if(!busy.value&&!uncertain.value)requestKey=studyEventId();});onLoad(o=>{cohortId=o?.cohortId??'';orderId=o?.orderId??'';});onShow(()=>{if(owner&&(currentUser.value?.id??'')!==owner){uncertain.value=false;pendingBody=null;order.value=null;}load();if(!timer)timer=setInterval(()=>{clock.value=Date.now()+offset;},1000);});onHide(()=>{if(timer){clearInterval(timer);timer=null;}});onUnload(()=>{if(timer)clearInterval(timer);});
</script><style>@import '../../styles/app.css';.text-button{background-color:transparent;border-width:0;border-style:solid;color:#245564;font-size:13px;line-height:22px;min-height:44px;padding:10px 0;margin:4px 0;}.policy{padding:16px;background-color:#F3F0E8;border-left:2px solid #8B7350;margin-top:12px;}.channel-choice{margin:10px 0;padding:12px;font-size:14px;text-align:left;border:1px solid #DDD8CE;color:#17292D;}.chosen{border-color:#245564;background-color:#EAF0EB;}.consent-button{white-space:normal;background-color:transparent;margin:16px 0;padding:0;text-align:left;font-size:13px;line-height:24px;color:#637276;}.proposal{padding:12px;background-color:#F3F0E8;margin-top:12px;}.refund-record{padding:14px 0;border-bottom:1px solid #E2DDD3;}.error{color:#9B3F32;font-size:13px;line-height:23px;margin:12px 0;}</style>
