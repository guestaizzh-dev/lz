<template>
  <view class="page"
    ><InkBackdrop /><PageHead title="研习讨论" /><scroll-view
      class="page-scroll"
      direction="vertical"
      :show-scrollbar="false"
      ><view class="content"
        ><ContentState
          v-if="loading || error"
          :loading="loading"
          :error="error"
          :error-title="
            error.indexOf('不存在') >= 0
              ? '这篇帖子已下线'
              : error.indexOf('权') >= 0
                ? '无权查看这篇帖子'
                : '帖子暂时无法读取'
          "
          :retryable="error.indexOf('不存在') < 0 && error.indexOf('权') < 0"
          :action-label="
            error.indexOf('不存在') >= 0 || error.indexOf('权') >= 0 ? '返回社区列表' : ''
          "
          @action="openPage('community/index')"
          @retry="load"
        />
        <template v-if="thread"
          ><text class="ui-text thread-kicker"
            >{{ thread!.section.title }}{{ thread!.essence ? ' · 精华' : '' }}</text
          ><text class="ui-text thread-title">{{ thread!.title }}</text
          ><view class="row between thread-foot"
            ><text class="ui-text thread-author"
              >{{ thread!.author.nickname
              }}{{
                thread!.author.teachingRole === 'TEACHER'
                  ? ' · 老师'
                  : thread!.author.teachingRole === 'ASSISTANT'
                    ? ' · 助教'
                    : ''
              }}
              · {{ formatChinaDate(thread!.createdAt) }}</text
            ><button class="ui-button small-action" @click="more">更多</button></view
          ><text
            v-if="thread!.state !== 'PUBLISHED' || thread!.deletedAt"
            class="ui-text review-note"
            >{{
              thread!.deletedAt
                ? '已撤回或隐藏'
                : thread!.state === 'REVIEW'
                  ? '待审核，仅自己可见'
                  : thread!.state === 'REJECTED'
                    ? '未通过审核'
                    : '内容已下架'
            }}</text
          ><template v-for="(block, index) in thread!.blocks" :key="index"
            ><text
              class="ui-text"
              v-if="block.type === 'text' || block.type === 'articleQuote'"
              :class="['thread-copy', block.type === 'articleQuote' ? 'thread-quote' : '']"
              :user-select="true"
              >{{ block.text }}</text
            ><ForumMedia
              v-else-if="block.type === 'video' || block.type === 'audio'"
              :threadId="id"
              :assetId="block.assetId"
              :type="block.type"
            /><image
              v-else-if="block.type === 'image' && urls[block.assetId ?? '']"
              class="thread-picture"
              :src="urls[block.assetId ?? '']"
              mode="widthFix"
              @click="preview(urls[block.assetId ?? ''])"
            /><button
              v-else-if="block.type === 'image'"
              class="ui-button small-action"
              @click="loadImages"
              >{{ imageError || '点击加载图片' }}</button
            ></template
          ><button
            v-if="thread!.citation"
            class="ui-button citation-card"
            @click="openPage('article/detail?id=' + thread!.citation!.articleId)"
            >引用书院文章 · {{ thread!.citation!.title }} ›</button
          >
          <text v-if="thread!.tags.length" class="ui-text thread-tags"
            >话题 · {{ thread!.tags.join(' · ') }}</text
          ><button
            v-if="
              thread!.author.id === currentUser?.id &&
              thread!.state === 'PUBLISHED' &&
              !thread!.deletedAt
            "
            class="ui-button small-action"
            @click="applyPin"
            >申请会员置顶</button
          ><view class="thread-reactions"
            ><button
              class="ui-button reaction-button"
              :disabled="acting || thread!.state !== 'PUBLISHED' || !!thread!.deletedAt"
              @click="reaction('LIKE')"
              >{{ thread!.liked ? '已赞同' : '赞同' }} · {{ thread!.likes }}</button
            ><button
              class="ui-button reaction-button"
              :disabled="acting || thread!.state !== 'PUBLISHED' || !!thread!.deletedAt"
              @click="reaction('FAVORITE')"
              >{{ thread!.favorited ? '已收藏' : '收藏' }} · {{ thread!.favorites }}</button
            ></view
          >
          <template v-if="thread!.state === 'PUBLISHED' && !thread!.deletedAt"
            ><view class="section-header"
              ><text class="ui-text section-title">交流 · {{ total }}</text
              ><button class="ui-button small-action" @click="reply(null)">写回复</button></view
            ><ContentState
              v-if="commentError"
              :error="commentError"
              error-title="回复暂时无法读取"
              @retry="loadComments(failedAppend)"
            /><view v-for="item in comments" :key="item.id" class="reply-row"
              ><view class="row between"
                ><text class="ui-text reply-author"
                  >{{ item.author?.nickname ?? '书院学友'
                  }}{{
                    item.author?.teachingRole === 'TEACHER'
                      ? ' · 老师'
                      : item.author?.teachingRole === 'ASSISTANT'
                        ? ' · 助教'
                        : ''
                  }}</text
                ><text class="ui-text meta">{{ formatChinaDate(item.createdAt) }}</text></view
              ><text v-if="item.parentId" class="ui-text meta">回复学友的讨论</text
              ><text class="ui-text reply-copy" :user-select="true">{{ item.body }}</text
              ><text v-if="item.reviewState !== 'APPROVED'" class="ui-text meta">{{
                item.reviewState === 'PENDING' ? '待审核 · 仅自己可见' : '未通过审核 · 仅自己可见'
              }}</text
              ><view class="row reply-actions"
                ><button
                  v-if="item.reviewState === 'APPROVED'"
                  class="ui-button small-action reply-action"
                  @click="reply(item)"
                  >回复</button
                ><button
                  v-if="item.authorId === currentUser?.id"
                  class="ui-button small-action reply-action"
                  :disabled="acting"
                  @click="withdrawComment(item)"
                  >撤回</button
                ><button
                  v-else-if="item.reviewState === 'APPROVED'"
                  class="ui-button small-action reply-action"
                  @click="report(item.id)"
                  >举报</button
                ></view
              ></view
            ><ContentState
              v-if="!comments.length && !commentLoading && !commentError"
              title="还没有公开回复"
              description="从自己的理解出发，与学友安静交流。"
            /><button
              v-if="comments.length < total"
              class="ui-button secondary-button"
              :disabled="commentLoading"
              @click="loadComments(true)"
              >更多回复</button
            ></template
          ></template
        >
      </view></scroll-view
    ><ComposeSheet
      :visible="visible"
      :title="parent ? '回复 ' + parent!.author?.nickname : '写回复'"
      :quote="parent?.body"
      v-model="body"
      :saving="saving"
      :error="editorError"
      :disabled="!body.trim()"
      submitLabel="提交审核"
      @close="visible = false"
      @submit="submit" /><ReportModal
      v-if="reportVisible"
      :resourceId="id"
      :commentId="reportId || undefined"
      resourceType="THREAD"
      @close="reportVisible = false"
  /></view>
</template>
<script setup lang="ts">
import InkBackdrop from '../../components/InkBackdrop.uvue';
import ForumMedia from '../../components/ForumMedia.uvue';
import { formatChinaDate } from '../../lib/date-time';
import PageHead from '../../components/PageHead.uvue';
import ContentState from '../../components/ContentState.uvue';
import ComposeSheet from '../../components/ComposeSheet.uvue';
import ReportModal from '../../components/report-modal.uvue';
import { request, apiBase } from '../../lib/api';
import { currentUser, needLogin } from '../../lib/session';
import { studyEventId } from '../../lib/learning';
import { openPage } from '../../lib/presentation';
type Section = { title: string };
type Block = { type: string; text?: string; assetId?: string };
type Citation = { articleId: string; title: string };
type Author = { id: string; nickname: string; teachingRole: string | null };
type Reply = {
  id: string;
  authorId: string;
  author: Author | null;
  body: string;
  reviewState: string;
  createdAt: string;
  parentId: string | null;
  version: number;
};
type Thread = {
  id: string;
  title: string;
  author: Author;
  createdAt: string;
  section: Section;
  tags: string[];
  blocks: Block[];
  state: string;
  deletedAt: string | null;
  essence: boolean;
  liked: boolean;
  favorited: boolean;
  likes: number;
  favorites: number;
  version: number;
  citation: Citation | null;
};
const thread = ref<Thread | null>(null),
  loading = ref(false),
  error = ref(''),
  comments = ref<Reply[]>([]),
  commentLoading = ref(false),
  commentError = ref(''),
  total = ref(0),
  urls = ref<Record<string, string>>({}),
  imageError = ref(''),
  acting = ref(false),
  visible = ref(false),
  body = ref(''),
  parent = ref<Reply | null>(null),
  saving = ref(false),
  editorError = ref(''),
  reportVisible = ref(false),
  reportId = ref('');
let id = '',
  page = 1,
  generation = 0,
  owner = '',
  key = '',
  signature = '',
  failedAppend = false;
const drafts = new Map<string, string>();
async function load() {
  const seq = ++generation;
  loading.value = true;
  error.value = '';
  try {
    const result = await request<Thread>('/forum/threads/' + id);
    if (seq !== generation) return;
    thread.value = result;
    urls.value = {};
    await loadImages();
    if (result.state === 'PUBLISHED' && !result.deletedAt) await loadComments();
    else comments.value = [];
  } catch (e) {
    if (seq === generation) {
      thread.value = null;
      error.value = (e as Error).message;
    }
  } finally {
    if (seq === generation) loading.value = false;
  }
}
async function loadImages() {
  if (!thread.value) return;
  imageError.value = '';
  try {
    const rows = await Promise.all(
      thread.value.blocks
        .filter((b) => b.type === 'image')
        .map(async (b) => ({
          id: b.assetId!,
          url:
            apiBase +
            (
              await request<{ path: string }>('/forum/threads/' + id + '/images/' + b.assetId, {
                method: 'POST',
              })
            ).path,
        })),
    );
    urls.value = Object.fromEntries(rows.map((r) => [r.id, r.url]));
  } catch (e) {
    imageError.value = (e as Error).message;
  }
}
function preview(path: string) {
  uni.previewImage({ current: path, urls: Object.values(urls.value) });
}
async function loadComments(append = false) {
  if (commentLoading.value) return;
  failedAppend = append;
  commentLoading.value = true;
  commentError.value = '';
  try {
    const next = append ? page + 1 : 1,
      result = await request<{ items: Reply[]; total: number }>(
        '/forum/threads/' + id + '/comments?page=' + next,
      );
    comments.value = append ? [...comments.value, ...result.items] : result.items;
    total.value = result.total;
    page = next;
  } catch (e) {
    commentError.value = (e as Error).message;
  } finally {
    commentLoading.value = false;
  }
}
function reply(item: Reply | null) {
  if (needLogin()) return;
  drafts.set(parent.value?.id ?? '', body.value);
  parent.value = item;
  body.value = drafts.get(item?.id ?? '') ?? '';
  editorError.value = '';
  visible.value = true;
}
async function submit() {
  if (saving.value || needLogin()) return;
  const data = { body: body.value.trim(), ...(parent.value ? { parentId: parent.value.id } : {}) };
  const value = JSON.stringify(data);
  if (value !== signature) {
    signature = value;
    key = studyEventId();
  }
  saving.value = true;
  editorError.value = '';
  try {
    await request('/forum/threads/' + id + '/comments', {
      method: 'POST',
      data: { ...data, requestKey: key },
    });
    drafts.delete(parent.value?.id ?? '');
    body.value = '';
    key = '';
    signature = '';
    visible.value = false;
    await loadComments();
    uni.showToast({ title: '回复已提交审核', icon: 'none' });
  } catch (e) {
    editorError.value = (e as Error).message;
  } finally {
    saving.value = false;
  }
}
function applyPin() {
  if (!thread.value || acting.value) return;
  uni.showModal({
    title: '申请会员置顶？',
    content: '须有本期置顶申请额度，经运营审核后限期展示。拒绝退回用量，不能跳过社区审核。',
    success: async (r) => {
      if (!r.confirm || acting.value) return;
      acting.value = true;
      try {
        await request('/me/community-enhancements/threads/' + id + '/pin', {
          method: 'POST',
          data: { requestKey: studyEventId() },
        });
        uni.showToast({ title: '申请已提交，请在书院共创查看', icon: 'none' });
      } catch (e) {
        uni.showToast({ title: (e as Error).message, icon: 'none' });
      } finally {
        acting.value = false;
      }
    },
  });
}
async function reaction(kind: string) {
  if (acting.value || !thread.value || needLogin()) return;
  acting.value = true;
  try {
    thread.value = await request<Thread>('/forum/threads/' + id + '/reactions', {
      method: 'POST',
      data: { kind, active: kind === 'LIKE' ? !thread.value.liked : !thread.value.favorited },
    });
  } catch (e) {
    uni.showToast({ title: (e as Error).message, icon: 'none' });
  } finally {
    acting.value = false;
  }
}
function report(commentId = '') {
  if (!needLogin()) {
    reportId.value = commentId;
    reportVisible.value = true;
  }
}
function more() {
  if (!thread.value) return;
  const own = thread.value.author.id === currentUser.value?.id;
  uni.showActionSheet({
    itemList: own ? ['撤回帖子'] : ['举报帖子', '拉黑作者'],
    success: (r) => {
      if (own) withdraw();
      else if (r.tapIndex === 0) report();
      else block();
    },
  });
}
function withdraw() {
  if (!thread.value || acting.value) return;
  uni.showModal({
    title: '撤回这篇帖子？',
    content: '撤回后不再公开。',
    confirmText: '撤回',
    success: async (r) => {
      if (!r.confirm || acting.value) return;
      acting.value = true;
      try {
        await request('/forum/threads/' + id + '/withdraw', {
          method: 'POST',
          data: { expectedVersion: thread.value!.version },
        });
        await load();
      } catch (e) {
        uni.showToast({ title: (e as Error).message, icon: 'none' });
      } finally {
        acting.value = false;
      }
    },
  });
}
function withdrawComment(item: Reply) {
  uni.showModal({
    title: '撤回这条回复？',
    success: async (r) => {
      if (!r.confirm || acting.value) return;
      acting.value = true;
      try {
        await request('/forum/comments/' + item.id + '/withdraw', {
          method: 'POST',
          data: { expectedVersion: item.version },
        });
        await loadComments();
      } catch (e) {
        uni.showToast({ title: (e as Error).message, icon: 'none' });
      } finally {
        acting.value = false;
      }
    },
  });
}
function block() {
  if (!thread.value || needLogin()) return;
  uni.showModal({
    title: '拉黑这位作者？',
    content: '他的内容将不再出现在你的讨论列表，可在拉黑管理中恢复。',
    success: async (r) => {
      if (!r.confirm) return;
      try {
        await request('/forum/blocks/' + thread.value!.author.id, { method: 'POST' });
        uni.navigateBack();
      } catch (e) {
        uni.showToast({ title: (e as Error).message, icon: 'none' });
      }
    },
  });
}
onLoad((options) => {
  id = options?.id ?? '';
});
onShow(() => {
  const userId = currentUser.value?.id ?? '';
  if (owner !== userId) {
    owner = userId;
    thread.value = null;
    comments.value = [];
    urls.value = {};
    body.value = '';
    visible.value = false;
    drafts.clear();
  }
  if (!visible.value && !saving.value) load();
});
</script>
<style>
@import '../../styles/app.css';
.thread-kicker {
  font-size: 11px;
  line-height: 17px;
  color: #8a6635;
  font-weight: 600;
  letter-spacing: 0.6px;
}
.thread-title {
  margin-top: 8px;
  font-family: AcademySerif;
  font-size: 24px;
  line-height: 34px;
  color: #182b31;
  font-weight: 600;
  letter-spacing: 0.4px;
  max-height: 68px;
  overflow: hidden;
}
.thread-foot {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-top: 12px;
  padding-bottom: 12px;
  border-bottom-width: 1px;
  border-bottom-style: solid;
  border-bottom-color: #e0d8c8;
}
.thread-author {
  flex: 1;
  min-width: 0;
  padding-right: 8px;
  font-size: 12px;
  line-height: 20px;
  color: #5c6869;
}
.small-action {
  min-height: 44px;
  font-size: 13px;
  line-height: 22px;
  padding: 10px 0;
  margin: 0;
  color: #235663;
  background-color: transparent;
  border-width: 0;
  align-self: flex-start;
  flex-shrink: 0;
}
.review-note {
  margin-top: 12px;
  padding: 12px 14px;
  background-color: #f1e8d8;
  border-radius: 10px;
  font-size: 13px;
  line-height: 22px;
  color: #6f6a5f;
}
.thread-copy {
  font-family: sans-serif;
  font-size: 15px;
  line-height: 26px;
  color: #344c54;
  margin-top: 16px;
}
.thread-quote {
  padding: 12px 14px;
  background-color: #f0eadd;
  border-radius: 10px;
  border-left-width: 2px;
  border-left-style: solid;
  border-left-color: #cfc5b1;
}
.thread-picture {
  width: 100%;
  border-radius: 10px;
  margin-top: 12px;
}
.thread-tags {
  margin-top: 12px;
  font-size: 12px;
  line-height: 20px;
  color: #5c6869;
}
.citation-card {
  margin-top: 12px;
  padding: 12px 14px;
  background-color: #f0eadd;
  border-radius: 10px;
  border-width: 0;
  font-size: 13px;
  line-height: 22px;
  color: #235663;
  text-align: left;
  white-space: normal;
}
.thread-reactions {
  flex-direction: row;
  margin-top: 16px;
  padding: 12px 0;
  border-top-width: 1px;
  border-top-style: solid;
  border-top-color: #e0d8c8;
  border-bottom-width: 1px;
  border-bottom-style: solid;
  border-bottom-color: #e0d8c8;
}
.reaction-button {
  flex: 1;
  min-width: 0;
  font-size: 14px;
  line-height: 24px;
  min-height: 46px;
  padding: 10px 12px;
  margin: 0 4px;
  color: #235663;
  background-color: #e6ede9;
  border-width: 1px;
  border-style: solid;
  border-color: #cfc5b1;
  border-radius: 23px;
  text-align: center;
}
.section-header {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-top: 24px;
}
.section-title {
  font-family: AcademySerif;
  font-size: 19px;
  line-height: 28px;
  color: #182b31;
  font-weight: 600;
}
.reply-row {
  padding: 15px 0;
  border-bottom-width: 1px;
  border-bottom-style: solid;
  border-bottom-color: #e0d8c8;
}
.reply-author {
  flex: 1;
  min-width: 0;
  padding-right: 8px;
  font-size: 14px;
  line-height: 24px;
  color: #182b31;
}
.reply-copy {
  font-size: 15px;
  line-height: 26px;
  margin-top: 8px;
  color: #344c54;
}
.reply-actions {
  flex-direction: row;
  align-items: center;
  margin-top: 4px;
}
.reply-action {
  margin-right: 16px;
}
</style>
