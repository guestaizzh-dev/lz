<template><view class="page"><PageHead title="研习讨论"/><scroll-view class="page-scroll" direction="vertical" :show-scrollbar="false"><view class="content"><ContentState v-if="loading||error" :loading="loading" :error="error" @retry="load"/>
<template v-if="thread"><text class="tag">{{thread!.section.title}}{{thread!.essence?' · 精华':''}}</text><text class="page-title">{{thread!.title}}</text><view class="row between"><text class="meta">{{thread!.author.nickname}}{{thread!.author.teachingRole==='TEACHER'?' · 老师':thread!.author.teachingRole==='ASSISTANT'?' · 助教':''}} · {{formatChinaDate(thread!.createdAt)}}</text><button class="small-action" @click="more">更多</button></view><text v-if="thread!.state!=='PUBLISHED'||thread!.deletedAt" class="review-note">{{thread!.deletedAt?'已撤回或隐藏':thread!.state==='REVIEW'?'待审核，仅自己可见':thread!.state==='REJECTED'?'未通过审核':'内容已下架'}}</text><template v-for="(block,index) in thread!.blocks" :key="index"><text v-if="block.type==='text'||block.type==='articleQuote'" :class="['thread-copy',block.type==='articleQuote'?'thread-quote':'']" :user-select="true">{{block.text}}</text><ForumMedia v-else-if="block.type==='video'||block.type==='audio'" :threadId="id" :assetId="block.assetId" :type="block.type"/><image v-else-if="block.type==='image'&&urls[block.assetId??'']" class="thread-picture" :src="urls[block.assetId??'']" mode="widthFix" @click="preview(urls[block.assetId??''])"/><button v-else-if="block.type==='image'" class="small-action" @click="loadImages">{{imageError||'点击加载图片'}}</button></template><button v-if="thread!.citation" class="citation-card" @click="openPage('article/detail?id='+thread!.citation!.articleId)">引用书院文章 · {{thread!.citation!.title}} ›</button>
<text v-if="thread!.tags.length" class="meta">话题 · {{thread!.tags.join(' · ')}}</text><button v-if="thread!.author.id===currentUser?.id&&thread!.state==='PUBLISHED'&&!thread!.deletedAt" class="small-action" @click="applyPin">申请会员置顶</button><view class="thread-reactions"><button class="reaction-button" :disabled="acting||thread!.state!=='PUBLISHED'||!!thread!.deletedAt" @click="reaction('LIKE')">{{thread!.liked?'已赞同':'赞同'}} · {{thread!.likes}}</button><button class="reaction-button" :disabled="acting||thread!.state!=='PUBLISHED'||!!thread!.deletedAt" @click="reaction('FAVORITE')">{{thread!.favorited?'已收藏':'收藏'}} · {{thread!.favorites}}</button></view>
<template v-if="thread!.state==='PUBLISHED'&&!thread!.deletedAt"><view class="section-header"><text class="section-title">交流 · {{total}}</text><button class="small-action" @click="reply(null)">写回复</button></view><ContentState v-if="commentError" :error="commentError" @retry="loadComments(failedAppend)"/><view v-for="item in comments" :key="item.id" class="reply-row"><view class="row between"><text class="reply-author">{{item.author?.nickname??'书院学友'}}{{item.author?.teachingRole==='TEACHER'?' · 老师':item.author?.teachingRole==='ASSISTANT'?' · 助教':''}}</text><text class="meta">{{formatChinaDate(item.createdAt)}}</text></view><text v-if="item.parentId" class="meta">回复学友的讨论</text><text class="reply-copy" :user-select="true">{{item.body}}</text><text v-if="item.reviewState!=='APPROVED'" class="meta">{{item.reviewState==='PENDING'?'待审核 · 仅自己可见':'未通过审核 · 仅自己可见'}}</text><view class="row"><button v-if="item.reviewState==='APPROVED'" class="small-action reply-action" @click="reply(item)">回复</button><button v-if="item.authorId===currentUser?.id" class="small-action reply-action" :disabled="acting" @click="withdrawComment(item)">撤回</button><button v-else-if="item.reviewState==='APPROVED'" class="small-action reply-action" @click="report(item.id)">举报</button></view></view><ContentState v-if="!comments.length&&!commentLoading&&!commentError" title="还没有公开回复" description="从自己的理解出发，与学友安静交流。"/><button v-if="comments.length<total" class="secondary-button" :disabled="commentLoading" @click="loadComments(true)">更多回复</button></template></template>
</view></scroll-view><ComposeSheet :visible="visible" :title="parent?'回复 '+parent!.author?.nickname:'写回复'" :quote="parent?.body" v-model="body" :saving="saving" :error="editorError" :disabled="!body.trim()" submitLabel="提交审核" @close="visible=false" @submit="submit"/><ReportModal v-if="reportVisible" :resourceId="id" :commentId="reportId||undefined" resourceType="THREAD" @close="reportVisible=false"/></view></template>
<script setup lang="ts">
import ForumMedia from '../../components/ForumMedia.uvue';
import {formatChinaDate} from '../../lib/date-time';
import PageHead from '../../components/PageHead.uvue';import ContentState from '../../components/ContentState.uvue';import ComposeSheet from '../../components/ComposeSheet.uvue';import ReportModal from '../../components/report-modal.uvue';import {request,apiBase} from '../../lib/api';import {currentUser,needLogin} from '../../lib/session';import {studyEventId} from '../../lib/learning';import {openPage} from '../../lib/presentation';
type Section={title:string};type Block={type:string;text?:string;assetId?:string};type Citation={articleId:string;title:string};type Author={id:string;nickname:string;teachingRole:string|null};type Reply={id:string;authorId:string;author:Author|null;body:string;reviewState:string;createdAt:string;parentId:string|null;version:number};type Thread={id:string;title:string;author:Author;createdAt:string;section:Section;tags:string[];blocks:Block[];state:string;deletedAt:string|null;essence:boolean;liked:boolean;favorited:boolean;likes:number;favorites:number;version:number;citation:Citation|null};
const thread=ref<Thread|null>(null),loading=ref(false),error=ref(''),comments=ref<Reply[]>([]),commentLoading=ref(false),commentError=ref(''),total=ref(0),urls=ref<Record<string,string>>({}),imageError=ref(''),acting=ref(false),visible=ref(false),body=ref(''),parent=ref<Reply|null>(null),saving=ref(false),editorError=ref(''),reportVisible=ref(false),reportId=ref('');let id='',page=1,generation=0,owner='',key='',signature='',failedAppend=false;const drafts=new Map<string,string>();
async function load(){const seq=++generation;loading.value=true;error.value='';try{const result=await request<Thread>('/forum/threads/'+id);if(seq!==generation)return;thread.value=result;urls.value={};await loadImages();if(result.state==='PUBLISHED'&&!result.deletedAt)await loadComments();else comments.value=[];}catch(e){if(seq===generation){thread.value=null;error.value=(e as Error).message;}}finally{if(seq===generation)loading.value=false;}}
async function loadImages(){if(!thread.value)return;imageError.value='';try{const rows=await Promise.all(thread.value.blocks.filter(b=>b.type==='image').map(async b=>({id:b.assetId!,url:apiBase+(await request<{path:string}>('/forum/threads/'+id+'/images/'+b.assetId,{method:'POST'})).path})));urls.value=Object.fromEntries(rows.map(r=>[r.id,r.url]));}catch(e){imageError.value=(e as Error).message;}}
function preview(path:string){uni.previewImage({current:path,urls:Object.values(urls.value)});}
async function loadComments(append=false){if(commentLoading.value)return;failedAppend=append;commentLoading.value=true;commentError.value='';try{const next=append?page+1:1,result=await request<{items:Reply[];total:number}>('/forum/threads/'+id+'/comments?page='+next);comments.value=append?[...comments.value,...result.items]:result.items;total.value=result.total;page=next;}catch(e){commentError.value=(e as Error).message;}finally{commentLoading.value=false;}}
function reply(item:Reply|null){if(needLogin())return;drafts.set(parent.value?.id??'',body.value);parent.value=item;body.value=drafts.get(item?.id??'')??'';editorError.value='';visible.value=true;}
async function submit(){if(saving.value||needLogin())return;const data={body:body.value.trim(),...(parent.value?{parentId:parent.value.id}:{})};const value=JSON.stringify(data);if(value!==signature){signature=value;key=studyEventId();}saving.value=true;editorError.value='';try{await request('/forum/threads/'+id+'/comments',{method:'POST',data:{...data,requestKey:key}});drafts.delete(parent.value?.id??'');body.value='';key='';signature='';visible.value=false;await loadComments();uni.showToast({title:'回复已提交审核',icon:'none'});}catch(e){editorError.value=(e as Error).message;}finally{saving.value=false;}}
function applyPin(){if(!thread.value||acting.value)return;uni.showModal({title:'申请会员置顶？',content:'须有本期置顶申请额度，经运营审核后限期展示。拒绝退回用量，不能跳过社区审核。',success:async r=>{if(!r.confirm||acting.value)return;acting.value=true;try{await request('/me/community-enhancements/threads/'+id+'/pin',{method:'POST',data:{requestKey:studyEventId()}});uni.showToast({title:'申请已提交，请在书院共创查看',icon:'none'});}catch(e){uni.showToast({title:(e as Error).message,icon:'none'});}finally{acting.value=false;}}});}
async function reaction(kind:string){if(acting.value||!thread.value||needLogin())return;acting.value=true;try{thread.value=await request<Thread>('/forum/threads/'+id+'/reactions',{method:'POST',data:{kind,active:kind==='LIKE'?!thread.value.liked:!thread.value.favorited}});}catch(e){uni.showToast({title:(e as Error).message,icon:'none'});}finally{acting.value=false;}}
function report(commentId=''){if(!needLogin()){reportId.value=commentId;reportVisible.value=true;}}
function more(){if(!thread.value)return;const own=thread.value.author.id===currentUser.value?.id;uni.showActionSheet({itemList:own?['撤回帖子']:['举报帖子','拉黑作者'],success:r=>{if(own)withdraw();else if(r.tapIndex===0)report();else block();}});}
function withdraw(){if(!thread.value||acting.value)return;uni.showModal({title:'撤回这篇帖子？',content:'撤回后不再公开。',confirmText:'撤回',success:async r=>{if(!r.confirm||acting.value)return;acting.value=true;try{await request('/forum/threads/'+id+'/withdraw',{method:'POST',data:{expectedVersion:thread.value!.version}});await load();}catch(e){uni.showToast({title:(e as Error).message,icon:'none'});}finally{acting.value=false;}}});}
function withdrawComment(item:Reply){uni.showModal({title:'撤回这条回复？',success:async r=>{if(!r.confirm||acting.value)return;acting.value=true;try{await request('/forum/comments/'+item.id+'/withdraw',{method:'POST',data:{expectedVersion:item.version}});await loadComments();}catch(e){uni.showToast({title:(e as Error).message,icon:'none'});}finally{acting.value=false;}}});}
function block(){if(!thread.value||needLogin())return;uni.showModal({title:'拉黑这位作者？',content:'他的内容将不再出现在你的讨论列表，可在拉黑管理中恢复。',success:async r=>{if(!r.confirm)return;try{await request('/forum/blocks/'+thread.value!.author.id,{method:'POST'});uni.navigateBack();}catch(e){uni.showToast({title:(e as Error).message,icon:'none'});}}});}
onLoad(options=>{id=options?.id??'';});onShow(()=>{const userId=currentUser.value?.id??'';if(owner!==userId){owner=userId;thread.value=null;comments.value=[];urls.value={};body.value='';visible.value=false;drafts.clear();}if(!visible.value&&!saving.value)load();});
</script><style>@import '../../styles/app.css';.thread-quote{padding:12px 16px;background-color:#EEE9DF;border-left-width:2px;border-left-color:#B7AC95;}.thread-copy{font-family:AcademySans;font-size:17px;line-height:31px;color:#17292D;margin:20px 0;}.thread-picture{width:100%;border-radius:6px;margin:12px 0;}.small-action{min-height:44px;font-size:13px;line-height:24px;padding:10px 0;margin:0;color:#245564;background-color:transparent;border-width:0;align-self:flex-start;}.review-note{font-size:13px;line-height:24px;padding:12px;background-color:#EEE9DF;border-radius:6px;color:#637276;}.thread-reactions{flex-direction:row;justify-content:space-around;padding:12px 0;border-top-width:1px;border-top-style:solid;border-top-color:#DFD9CF;border-bottom-width:1px;border-bottom-style:solid;border-bottom-color:#DFD9CF;}.reaction-button{font-size:14px;line-height:24px;min-height:44px;padding:10px 18px;color:#245564;background-color:transparent;border-width:0;margin:0;}.reply-row{padding:18px 0;border-bottom-width:1px;border-bottom-style:solid;border-bottom-color:#DFD9CF;}.reply-author{font-size:14px;line-height:24px;color:#17292D;}.reply-copy{font-size:15px;line-height:26px;margin-top:8px;color:#17292D;}.reply-action{margin-right:20px;}.citation-card{font-size:13px;line-height:24px;padding:12px;background-color:#EEE9DF;border-radius:6px;border-width:0;color:#245564;}</style>
