<template>
  <view class="page"
    ><InkBackdrop /><PageHead :title="courseId ? '课程讨论' : '书院社区'" /><scroll-view
      class="page-scroll"
      direction="vertical"
      :show-scrollbar="false"
      ><view class="content">
        <text class="ui-text intro forum-intro">{{
          courseId ? '仅本课学员可参与，讨论先审后发。' : '以经典为引，以实践相照。发言审核后公开。'
        }}</text>
        <scroll-view
          direction="horizontal"
          :show-scrollbar="false"
          class="horizontal-scroll forum-tabs"
          ><button
            class="ui-button"
            v-for="section in sections"
            :key="section.id"
            :class="['forum-tab', selected === section.id && !mine ? 'forum-tab-active' : '']"
            @click="select(section.id)"
            >{{ section.title }}</button
          ><button
            class="ui-button"
            :class="['forum-tab', mine ? 'forum-tab-active' : '']"
            @click="myPosts"
            >我的帖子</button
          ></scroll-view
        >
        <scroll-view
          v-if="tags.length"
          direction="horizontal"
          :show-scrollbar="false"
          class="horizontal-scroll forum-tag-row"
          ><button
            class="ui-button"
            :class="['tag-chip', !tag ? 'tag-chip-active' : '']"
            @click="
              tag = '';
              load();
            "
            >全部话题</button
          ><button
            class="ui-button"
            v-for="item in tags"
            :key="item.name"
            :class="['tag-chip', tag === item.name ? 'tag-chip-active' : '']"
            @click="
              tag = item.name;
              load();
            "
            >{{ item.name }}</button
          ></scroll-view
        ><view class="row between forum-tools"
          ><button class="ui-button section-link forum-link" @click="sortNext"
            >{{ sort === 'recent' ? '最新' : sort === 'popular' ? '热度' : '精华' }} ▾</button
          ><button class="ui-button section-link forum-link" @click="openPage('community/manage')"
            >拉黑 / 举报记录</button
          ></view
        >
        <button
          v-if="!courseId"
          class="ui-button section-link forum-link"
          @click="openPage('marketing/community')"
          >主题征文与书院共创 ›</button
        ><ContentState
          v-if="loading || error"
          :loading="loading"
          :error="error"
          :error-title="
            error.indexOf('权') >= 0 || error.indexOf('学员') >= 0
              ? '无权查看该讨论区'
              : '讨论暂时无法读取'
          "
          :retryable="error.indexOf('权') < 0 && error.indexOf('学员') < 0"
          @retry="load(failedAppend)"
        />
        <view
          v-for="item in items"
          :key="item.id"
          class="forum-row"
          hover-class="row-pressed"
          @click="openPage('community/detail?id=' + item.id)"
          ><view
            v-if="
              (item.pinnedUntil && new Date(item.pinnedUntil) > new Date()) || item.essence || mine
            "
            class="row forum-tags"
            ><text
              v-if="item.pinnedUntil && new Date(item.pinnedUntil) > new Date()"
              class="ui-text pill forum-pill pill-gold"
              >置顶</text
            ><text v-if="item.essence" class="ui-text pill forum-pill pill-gold">精华</text
            ><text v-if="mine" class="ui-text pill forum-pill pill-teal">{{
              states[item.state] ?? item.state
            }}</text></view
          ><text class="ui-text item-title forum-title">{{ item.title }}</text
          ><text class="ui-text article-summary forum-summary">{{ item.summary }}</text
          ><view class="row between forum-foot"
            ><view class="row forum-byline"
              ><text class="ui-text forum-author">{{ item.authorName }}</text
              ><text class="ui-text forum-date">{{ formatChinaDate(item.createdAt) }}</text></view
            ><text class="ui-text forum-likes">{{ item.likes }} 人赞同</text></view
          ></view
        >
        <ContentState
          v-if="!loading && !error && !items.length"
          :title="mine ? '你还没有发帖' : '这里还没有公开讨论'"
          description="写下研习所得，让交流从这里开始。"
        /><button
          class="ui-button"
          v-if="items.length < total"
          :class="['secondary-button', loading ? 'is-disabled' : '']"
          @click="load(true)"
          >更多帖子</button
        >
      </view></scroll-view
    ><BottomBar
      ><button class="ui-button bar-primary" :class="selected ? '' : 'is-disabled'" @click="create"
        >写研习帖子</button
      ></BottomBar
    ></view
  >
</template>
<script setup lang="ts">
import InkBackdrop from '../../components/InkBackdrop.uvue';
import { pageRefresh } from '../../lib/page-refresh';
import { formatChinaDate } from '../../lib/date-time';
import PageHead from '../../components/PageHead.uvue';
import ContentState from '../../components/ContentState.uvue';
import BottomBar from '../../components/BottomBar.uvue';
import { request } from '../../lib/api';
import { currentUser, needLogin } from '../../lib/session';
import { openPage } from '../../lib/presentation';
type Section = { id: string; title: string };
type Thread = {
  id: string;
  title: string;
  summary: string;
  state: string;
  authorName: string;
  createdAt: string;
  likes: number;
  essence: boolean;
  pinnedUntil: string | null;
};
const tag = ref(''),
  tags = ref<{ name: string; count: number }[]>([]);
const sections = ref<Section[]>([]),
  selected = ref(''),
  items = ref<Thread[]>([]),
  mine = ref(false),
  sort = ref('recent'),
  loading = ref(false),
  error = ref(''),
  total = ref(0);
const states: Record<string, string> = {
  REVIEW: '待审核',
  PUBLISHED: '已公开',
  REJECTED: '未通过审核',
  ARCHIVED: '已撤回或隐藏',
};
let courseId = '',
  cohortId = '',
  owner = '',
  page = 1,
  generation = 0,
  failedAppend = false;
async function load(append = false) {
  if (append && loading.value) return;
  const token = ++generation;
  failedAppend = append;
  loading.value = true;
  error.value = '';
  if (!append) {
    items.value = [];
    total.value = 0;
  }
  try {
    if (!sections.value.length) {
      const result = await request<{ items: Section[] }>(
        '/forum/sections' +
          (cohortId ? '?cohortId=' + cohortId : courseId ? '?courseId=' + courseId : ''),
      );
      if (token !== generation) return;
      sections.value = result.items;
      selected.value = selected.value || result.items[0]?.id || '';
    }
    if (!selected.value) return;
    if (!append) tags.value = await request('/forum/sections/' + selected.value + '/tags');
    const next = append ? page + 1 : 1;
    const result = await request<{ items: Thread[]; total: number }>(
      '/forum/' +
        (mine.value ? 'mine' : 'threads') +
        '?sectionId=' +
        selected.value +
        '&sort=' +
        sort.value +
        '&page=' +
        next +
        (tag.value ? '&tag=' + encodeURIComponent(tag.value) : ''),
    );
    if (token !== generation) return;
    items.value = append ? [...items.value, ...result.items] : result.items;
    total.value = result.total;
    page = next;
  } catch (e) {
    if (token === generation) error.value = (e as Error).message;
  } finally {
    if (token === generation) loading.value = false;
  }
}
function select(id: string) {
  selected.value = id;
  tag.value = '';
  mine.value = false;
  load();
}
function myPosts() {
  if (needLogin()) return;
  mine.value = true;
  load();
}
function sortNext() {
  uni.showActionSheet({
    itemList: ['最新讨论', '最多赞同', '精华讨论'],
    success: (r) => {
      sort.value = ['recent', 'popular', 'essence'][r.tapIndex];
      load();
    },
  });
}
function create() {
  if (!selected.value || needLogin()) return;
  openPage('community/editor?sectionId=' + selected.value);
}
onLoad((options) => {
  courseId = options?.courseId ?? '';
  cohortId = options?.cohortId ?? '';
});
onShow(() => {
  const id = currentUser.value?.id ?? '';
  if (owner !== id) {
    owner = id;
    sections.value = [];
    selected.value = '';
    mine.value = false;
    items.value = [];
  }
  void refreshPage();
});

const refreshPage = pageRefresh(
  async () => {
    await load();
  },
  () => !error.value && !loading.value,
  60000,
);
</script>
<style>
@import '../../styles/app.css';
.forum-intro {
  padding: 0 0 12px;
}
/* 第一层：板块 chips（纸面卡、选中描边青），第二层：话题 chips（淡洗底、选中淡金），层级靠底色与字重区分。 */
.forum-tabs {
  flex-direction: row;
  margin-top: 0;
  margin-bottom: 12px;
}
.forum-tab {
  font-size: 13px;
  line-height: 22px;
  min-height: 44px;
  flex-shrink: 0;
  padding: 11px 14px;
  margin: 0 8px 0 0;
  background-color: #fcf9f2;
  border-style: solid;
  border-width: 1px;
  border-color: #cfc5b1;
  border-radius: 10px;
  color: #5c6869;
  font-weight: 400;
  white-space: nowrap;
}
.forum-tab-active {
  color: #235663;
  background-color: #e6ede9;
  border-color: #235663;
  font-weight: 600;
}
.forum-tag-row {
  margin-top: 0;
  margin-bottom: 12px;
}
.tag-chip {
  min-height: 44px;
  flex-shrink: 0;
  padding: 11px 12px;
  margin: 0 8px 0 0;
  background-color: #f0eadd;
  border-style: solid;
  border-width: 0;
  border-radius: 10px;
  font-family: sans-serif;
  font-size: 12px;
  line-height: 20px;
  color: #5c6869;
  font-weight: 400;
}
.tag-chip-active {
  background-color: #f1e8d8;
  color: #8a6635;
  font-weight: 600;
}
.forum-tools {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}
.forum-link {
  padding: 10px 0;
  min-height: 44px;
  margin: 0;
  background-color: transparent;
  border-width: 0;
  font-size: 13px;
  line-height: 22px;
  color: #235663;
}
.forum-row {
  background-color: #fcf9f2;
  border-style: solid;
  border-width: 1px;
  border-color: #cfc5b1;
  border-radius: 14px;
  padding: 16px;
  margin-top: 12px;
}
.forum-tags {
  flex-wrap: wrap;
  margin-bottom: 8px;
}
.forum-pill {
  margin-right: 8px;
  flex-shrink: 0;
  white-space: nowrap;
}
.forum-title {
  font-size: 17px;
  line-height: 26px;
  max-height: 52px;
  overflow: hidden;
}
.forum-summary {
  font-size: 13px;
  line-height: 22px;
  max-height: 44px;
  overflow: hidden;
  margin-top: 8px;
}
.forum-foot {
  margin-top: 12px;
}
/* 元信息分主次：作者用次墨，日期用辅助色且单行不换行。 */
.forum-byline {
  flex: 1;
  min-width: 0;
  padding-right: 12px;
}
.forum-author {
  font-size: 12px;
  line-height: 20px;
  color: #344c54;
  max-width: 140px;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.forum-date {
  flex-shrink: 0;
  margin-left: 6px;
  font-size: 12px;
  line-height: 20px;
  color: #5c6869;
  white-space: nowrap;
}
.forum-likes {
  flex-shrink: 0;
  font-size: 12px;
  line-height: 20px;
  color: #344c54;
  font-weight: 600;
  white-space: nowrap;
}
</style>
