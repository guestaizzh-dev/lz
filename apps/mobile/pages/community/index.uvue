<template><view class="page"><PageHead :title="courseId?'课程讨论':'书院社区'"/><scroll-view class="page-scroll" direction="vertical" :show-scrollbar="false"><view class="content">
<text class="meta">{{courseId?'仅本课学员可参与，讨论先审后发。':'以经典为引，以实践相照。发言审核后公开。'}}</text>
<scroll-view direction="horizontal" :show-scrollbar="false" class="horizontal-scroll forum-tabs"><button v-for="section in sections" :key="section.id" :class="['forum-tab',selected===section.id&&!mine?'forum-tab-active':'']" @click="select(section.id)">{{section.title}}</button><button :class="['forum-tab',mine?'forum-tab-active':'']" @click="myPosts">我的帖子</button></scroll-view>
<scroll-view v-if="tags.length" direction="horizontal" :show-scrollbar="false" class="horizontal-scroll forum-tabs"><button :class="['forum-tab',!tag?'forum-tab-active':'']" @click="tag='';load()">全部话题</button><button v-for="item in tags" :key="item.name" :class="['forum-tab',tag===item.name?'forum-tab-active':'']" @click="tag=item.name;load()">{{item.name}}</button></scroll-view><view class="row between"><button class="section-link forum-link" @click="sortNext">{{sort==='recent'?'最新':sort==='popular'?'热度':'精华'}} ▾</button><button class="section-link forum-link" @click="openPage('community/manage')">拉黑 / 举报记录</button></view>
<button v-if="!courseId" class="section-link forum-link" @click="openPage('marketing/community')">主题征文与书院共创 ›</button><ContentState v-if="loading||error" :loading="loading" :error="error" @retry="load(failedAppend)"/>
<view v-for="item in items" :key="item.id" class="forum-row" @click="openPage('community/detail?id='+item.id)"><view class="row"><text v-if="item.pinnedUntil&&new Date(item.pinnedUntil)>new Date()" class="tag">置顶 · </text><text v-if="item.essence" class="tag">精华 · </text><text v-if="mine" class="tag">{{states[item.state]??item.state}}</text></view><text class="item-title">{{item.title}}</text><text class="article-summary">{{item.summary}}</text><text class="meta">{{item.authorName}} · {{formatChinaDate(item.createdAt)}} · {{item.likes}} 人赞同</text></view>
<ContentState v-if="!loading&&!error&&!items.length" :title="mine?'你还没有发帖':'这里还没有公开讨论'" description="写下研习所得，让交流从这里开始。"/><button v-if="items.length<total" class="secondary-button" :disabled="loading" @click="load(true)">更多帖子</button>
</view></scroll-view><BottomBar><button class="bar-primary" :disabled="!selected" @click="create">写研习帖子</button></BottomBar></view></template>
<script setup lang="ts">
import {formatChinaDate} from '../../lib/date-time';
import PageHead from '../../components/PageHead.uvue';import ContentState from '../../components/ContentState.uvue';import BottomBar from '../../components/BottomBar.uvue';import {request} from '../../lib/api';import {currentUser,needLogin} from '../../lib/session';import {openPage} from '../../lib/presentation';
type Section={id:string;title:string};type Thread={id:string;title:string;summary:string;state:string;authorName:string;createdAt:string;likes:number;essence:boolean;pinnedUntil:string|null};
const tag=ref(''),tags=ref<{name:string;count:number}[]>([]);const sections=ref<Section[]>([]),selected=ref(''),items=ref<Thread[]>([]),mine=ref(false),sort=ref('recent'),loading=ref(false),error=ref(''),total=ref(0);const states:Record<string,string>={REVIEW:'待审核',PUBLISHED:'已公开',REJECTED:'未通过审核',ARCHIVED:'已撤回或隐藏'};let courseId='',cohortId='',owner='',page=1,generation=0,failedAppend=false;
async function load(append=false){if(append&&loading.value)return;const token=++generation;failedAppend=append;loading.value=true;error.value='';if(!append){items.value=[];total.value=0;}try{if(!sections.value.length){const result=await request<{items:Section[]}>('/forum/sections'+(cohortId?'?cohortId='+cohortId:courseId?'?courseId='+courseId:''));if(token!==generation)return;sections.value=result.items;selected.value=selected.value||result.items[0]?.id||'';}if(!selected.value)return;if(!append)tags.value=await request('/forum/sections/'+selected.value+'/tags');const next=append?page+1:1;const result=await request<{items:Thread[];total:number}>('/forum/'+(mine.value?'mine':'threads')+'?sectionId='+selected.value+'&sort='+sort.value+'&page='+next+(tag.value?'&tag='+encodeURIComponent(tag.value):''));if(token!==generation)return;items.value=append?[...items.value,...result.items]:result.items;total.value=result.total;page=next;}catch(e){if(token===generation)error.value=(e as Error).message;}finally{if(token===generation)loading.value=false;}}
function select(id:string){selected.value=id;tag.value='';mine.value=false;load();}function myPosts(){if(needLogin())return;mine.value=true;load();}function sortNext(){uni.showActionSheet({itemList:['最新讨论','最多赞同','精华讨论'],success:r=>{sort.value=['recent','popular','essence'][r.tapIndex];load();}});}function create(){if(!needLogin())openPage('community/editor?sectionId='+selected.value);}
onLoad(options=>{courseId=options?.courseId??'';cohortId=options?.cohortId??'';});onShow(()=>{const id=currentUser.value?.id??'';if(owner!==id){owner=id;sections.value=[];selected.value='';mine.value=false;items.value=[];}load();});
</script><style>@import '../../styles/app.css';.forum-tabs{flex-direction:row;margin-top:20px;margin-bottom:8px;}.forum-tab{font-size:13px;line-height:22px;min-height:44px;flex-shrink:0;padding:11px 12px;margin:0;background-color:transparent;border-width:0;color:#637276;}.forum-tab-active{color:#245564;background-color:#EEE9DF;border-radius:6px;}.forum-row{padding:20px 0;border-bottom-width:1px;border-bottom-style:solid;border-bottom-color:#DFD9CF;}.forum-link{padding:10px 0;min-height:44px;margin:0;background-color:transparent;border-width:0;}</style>
