<template>
  <view class="page"
    ><InkBackdrop /><PageHead title="讨论记录与管理" /><scroll-view
      class="page-scroll"
      direction="vertical"
      :show-scrollbar="false"
      ><view class="content"
        ><ContentState
          v-if="loading || error"
          :loading="loading"
          :error="error"
          :error-title="error.indexOf('权') >= 0 ? '无权查看管理记录' : '讨论记录暂时无法读取'"
          :retryable="error.indexOf('权') < 0"
          @retry="load"
        /><text class="ui-text manage-section manage-first">已拉黑用户</text
        ><view v-for="user in blocks" :key="user.id" class="manage-row row between"
          ><text class="ui-text manage-name">{{ user.nickname }}</text
          ><button
            class="ui-button small-action"
            :disabled="!!pending"
            @click="unblock(user.blockedId)"
            >{{ pending === user.blockedId ? '处理中…' : '解除拉黑' }}</button
          ></view
        ><text v-if="!blocks.length && !loading" class="ui-text manage-empty">没有拉黑用户</text
        ><text class="ui-text manage-section">我的举报</text
        ><view v-for="report in reports" :key="report.id" class="manage-row"
          ><text
            class="ui-text"
            :class="['manage-reason', report.state === 'PENDING' ? '' : 'manage-reason-done']"
            >{{ report.state === 'PENDING' ? '待处理' : '已处理' }} ·
            {{ formatChinaDate(report.createdAt) }}</text
          ><text class="ui-text manage-copy" :user-select="true">{{
            report.description || reasons[report.reasonCode] || '内容举报'
          }}</text
          ><text v-if="report.resolution" class="ui-text manage-note" :user-select="true"
            >处理反馈：{{ report.resolution }}</text
          ></view
        ><text v-if="!reports.length && !loading" class="ui-text manage-empty">没有举报记录</text
        ><button
          v-if="reports.length < total"
          class="ui-button secondary-button"
          :disabled="loading"
          @click="load(true)"
          >更多记录</button
        ></view
      ></scroll-view
    ></view
  >
</template>
<script setup lang="ts">
import InkBackdrop from '../../components/InkBackdrop.uvue';
import { pageRefresh } from '../../lib/page-refresh';
import { formatChinaDate } from '../../lib/date-time';
import PageHead from '../../components/PageHead.uvue';
import ContentState from '../../components/ContentState.uvue';
import { request } from '../../lib/api';
import { currentUser, needLogin } from '../../lib/session';
const blocks = ref<{ id: string; blockedId: string; nickname: string }[]>([]),
  reports = ref<
    {
      id: string;
      state: string;
      description: string;
      reasonCode: string;
      resolution: string | null;
      createdAt: string;
    }[]
  >([]),
  loading = ref(false),
  error = ref(''),
  pending = ref(''),
  total = ref(0);
let owner = '',
  page = 1;
const reasons: Record<string, string> = {
  SPAM: '垃圾广告',
  INAPPROPRIATE: '内容不当',
  MISLEADING: '误导信息',
  COPYRIGHT: '版权问题',
  OTHER: '其他',
};
async function load(append = false) {
  const userId = currentUser.value?.id ?? '';
  if (owner !== userId) {
    owner = userId;
    blocks.value = [];
    reports.value = [];
    total.value = 0;
  }
  if (loading.value || needLogin()) return;
  loading.value = true;
  error.value = '';
  try {
    const next = append ? page + 1 : 1,
      [a, b] = await Promise.all([
        request<{ items: typeof blocks.value }>('/forum/blocks'),
        request<{ items: typeof reports.value; total: number }>('/forum/reports?page=' + next),
      ]);
    blocks.value = a.items;
    reports.value = append ? [...reports.value, ...b.items] : b.items;
    total.value = b.total;
    page = next;
  } catch (e) {
    error.value = (e as Error).message;
  } finally {
    loading.value = false;
  }
}
async function unblock(id: string) {
  if (pending.value) return;
  pending.value = id;
  try {
    await request('/forum/blocks/' + id, { method: 'DELETE' });
    blocks.value = blocks.value.filter((b) => b.blockedId !== id);
  } catch (e) {
    uni.showToast({ title: (e as Error).message, icon: 'none' });
  } finally {
    pending.value = '';
  }
}
onShow(() => refreshPage());

const refreshPage = pageRefresh(
  async () => {
    await load();
  },
  () => !error.value && !loading.value,
  60000,
);
</script>
<style>
@import '../../styles/app.css';
.manage-section {
  font-family: AcademySerif;
  font-size: 19px;
  line-height: 28px;
  color: #182b31;
  font-weight: 600;
  margin-top: 32px;
  margin-bottom: 8px;
}
.manage-first {
  margin-top: 16px;
}
.manage-row {
  padding: 15px 0;
  border-bottom-width: 1px;
  border-bottom-style: solid;
  border-bottom-color: #e0d8c8;
}
.manage-name {
  flex: 1;
  min-width: 0;
  padding-right: 12px;
  font-size: 15px;
  line-height: 26px;
  color: #182b31;
}
.manage-reason {
  font-size: 12px;
  line-height: 20px;
  color: #8a6635;
  font-weight: 600;
  letter-spacing: 0.4px;
}
.manage-reason-done {
  color: #5c6869;
  font-weight: 400;
}
.manage-copy {
  margin-top: 8px;
  font-size: 14px;
  line-height: 24px;
  color: #344c54;
}
.manage-note {
  margin-top: 8px;
  font-size: 13px;
  line-height: 22px;
  color: #5c6869;
}
.manage-empty {
  padding: 12px 0;
  font-size: 13px;
  line-height: 22px;
  color: #5c6869;
}
.small-action {
  flex-shrink: 0;
  min-height: 44px;
  margin: 0;
  padding: 10px 0;
  font-size: 13px;
  line-height: 22px;
  color: #235663;
  background-color: transparent;
  border-width: 0;
}
</style>
