<template><view class="page"><PageHead title="讨论记录与管理"/><scroll-view class="page-scroll" direction="vertical" :show-scrollbar="false"><view class="content"><ContentState v-if="loading||error" :loading="loading" :error="error" @retry="load"/><text class="section-heading">已拉黑用户</text><view v-for="user in blocks" :key="user.id" class="manage-row row between"><text class="body-copy">{{user.nickname}}</text><button class="small-action" :disabled="!!pending" @click="unblock(user.blockedId)">{{pending===user.blockedId?'处理中…':'解除拉黑'}}</button></view><text v-if="!blocks.length&&!loading" class="meta">没有拉黑用户</text><text class="section-heading">我的举报</text><view v-for="report in reports" :key="report.id" class="manage-row"><text class="tag">{{report.state==='PENDING'?'待处理':'已处理'}} · {{formatChinaDate(report.createdAt)}}</text><text class="body-copy" :user-select="true">{{report.description||reasons[report.reasonCode]||'内容举报'}}</text><text v-if="report.resolution" class="meta" :user-select="true">处理反馈：{{report.resolution}}</text></view><text v-if="!reports.length&&!loading" class="meta">没有举报记录</text><button v-if="reports.length<total" class="secondary-button" :disabled="loading" @click="load(true)">更多记录</button></view></scroll-view></view></template>
<script setup lang="ts">
import {formatChinaDate} from '../../lib/date-time';
import PageHead from '../../components/PageHead.uvue';import ContentState from '../../components/ContentState.uvue';import {request} from '../../lib/api';import {currentUser,needLogin} from '../../lib/session';
const blocks=ref<{id:string;blockedId:string;nickname:string}[]>([]),reports=ref<{id:string;state:string;description:string;reasonCode:string;resolution:string|null;createdAt:string}[]>([]),loading=ref(false),error=ref(''),pending=ref(''),total=ref(0);let owner='',page=1;const reasons:Record<string,string>={SPAM:'垃圾广告',INAPPROPRIATE:'内容不当',MISLEADING:'误导信息',COPYRIGHT:'版权问题',OTHER:'其他'};
async function load(append=false){const userId=currentUser.value?.id??'';if(owner!==userId){owner=userId;blocks.value=[];reports.value=[];total.value=0;}if(loading.value||needLogin())return;loading.value=true;error.value='';try{const next=append?page+1:1,[a,b]=await Promise.all([request<{items:typeof blocks.value}>('/forum/blocks'),request<{items:typeof reports.value;total:number}>('/forum/reports?page='+next)]);blocks.value=a.items;reports.value=append?[...reports.value,...b.items]:b.items;total.value=b.total;page=next;}catch(e){error.value=(e as Error).message;}finally{loading.value=false;}}
async function unblock(id:string){if(pending.value)return;pending.value=id;try{await request('/forum/blocks/'+id,{method:'DELETE'});blocks.value=blocks.value.filter(b=>b.blockedId!==id);}catch(e){uni.showToast({title:(e as Error).message,icon:'none'});}finally{pending.value='';}}
onShow(()=>load());
</script><style>@import '../../styles/app.css';.manage-row{padding:16px 0;border-bottom-width:1px;border-bottom-style:solid;border-bottom-color:#E3DCCF;}.section-heading{margin-top:24px;}.small-action{min-height:44px;font-size:13px;line-height:24px;padding:10px 0;margin:0;color:#235663;background-color:transparent;border-width:0;}</style>
