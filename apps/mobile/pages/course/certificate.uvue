<template><view class="page"><PageHead title="研习完成记录"/><scroll-view class="page-scroll" direction="vertical" :show-scrollbar="false"><view class="content"><ContentState v-if="loading||error" :loading="loading" :error="error" @retry="load"/><view v-if="certificate" class="certificate-paper"><view class="row between"><text class="certificate-brand">老子道学书院</text><AcademySeal/></view><ScrollDivider/><text class="certificate-title">研习完成记录</text><text v-if="certificate!.cohortTitle" class="tag">{{certificate!.cohortTitle}}</text><text class="certificate-name">{{certificate!.nickname}}</text><text class="body-copy">已完成《{{certificate!.courseTitle}}》本版本 {{certificate!.lessonCount}} 讲必修章节的研习。</text><text class="meta">完成日期 · {{formatChinaDate(certificate!.completedAt)}}</text><ScrollDivider/><text class="certificate-code" :user-select="true">{{number}}</text><button class="secondary-button" @click="copy">复制记录编号</button></view></view></scroll-view></view></template>
<script setup lang="ts">
import {formatChinaDate} from '../../lib/date-time';
import PageHead from '../../components/PageHead.uvue';import ContentState from '../../components/ContentState.uvue';import AcademySeal from '../../components/AcademySeal.uvue';import ScrollDivider from '../../components/ScrollDivider.uvue';import {request} from '../../lib/api';import {currentUser,needLogin} from '../../lib/session';
type Certificate={id:string;courseTitle:string;lessonCount:number;completedAt:string;nickname:string;cohortTitle?:string};const certificate=ref<Certificate|null>(null),loading=ref(false),error=ref(''),number=computed(()=>certificate.value?'LZ-'+certificate.value.id.replace(/-/g,'').toUpperCase():'');let id='',cohortId='',owner='';
async function load(){if(owner!==(currentUser.value?.id??'')){owner=currentUser.value?.id??'';certificate.value=null;}if(needLogin()||loading.value)return;loading.value=true;error.value='';try{certificate.value=await request<Certificate>('/learning/courses/'+id+'/certificate'+(cohortId?'?cohortId='+encodeURIComponent(cohortId):''),{method:'POST'});}catch(e){error.value=(e as Error).message;}finally{loading.value=false;}}
function copy(){uni.setClipboardData({data:number.value});}onLoad(options=>{id=options?.id??'';cohortId=options?.cohortId??'';});onShow(()=>load());
</script>
<style>@import '../../styles/app.css';.certificate-paper{padding:28px 22px;margin-top:20px;border-width:1px;border-style:solid;border-color:#D3C9B8;background-color:#FCF9F2;}.certificate-brand{font-family:AcademySerif;color:#6A7578;font-size:16px;line-height:28px;}.certificate-title{font-family:AcademySerif;font-size:26px;line-height:40px;color:#182B31;margin:22px 0;}.certificate-name{font-family:AcademySerif;font-size:20px;line-height:32px;color:#235663;}.certificate-code{font-size:11px;line-height:20px;color:#6A7578;margin:16px 0;}</style>
