<template>
  <view class="page"
    ><InkBackdrop /><PageHead title="研习打卡" /><scroll-view
      class="page-scroll"
      direction="vertical"
      :show-scrollbar="false"
      ><view class="content"
        ><ContentState
          v-if="loading || error"
          :loading="loading"
          :error="error"
          :error-title="
            error.indexOf('登录') >= 0
              ? '请先登录'
              : error.indexOf('权限') >= 0
                ? '无权查看本期打卡'
                : '打卡记录未能加载'
          "
          :retryable="error.indexOf('登录') < 0 && error.indexOf('权限') < 0"
          :action-label="error.indexOf('权限') >= 0 ? '返回学习档案' : ''"
          @action="openPage('course/library')"
          @retry="load"
        />
        <template v-if="result"
          ><text v-if="result!.cohort" class="ui-text meta"
            >本期研习 · {{ result!.cohort!.title }}</text
          ><text v-if="result!.canParticipate === false" class="ui-text checkin-notice"
            >本期尚未开放或已结束，可回看实践记录与点评。</text
          ><text class="ui-text checkin-intro"
            >每天记录一次实践，打卡与图片仅自己和本课老师可见。</text
          >
          <view v-for="task in result!.items" :key="task.id" class="task-card"
            ><view class="row between"
              ><text class="ui-text section-heading grow task-card-section-heading">{{
                task.title
              }}</text
              ><text class="ui-text tag task-card-tag">{{
                task.complete ? '已完成' : task.required ? '必修' : '选修'
              }}</text></view
            ><text class="ui-text body-copy task-card-body-copy" :user-select="true">{{
              task.instructions.text
            }}</text
            ><text class="ui-text meta task-card-meta"
              >已打卡 {{ task.completedDays }} / {{ task.requiredDays }} 天 · 连续
              {{ task.streak }} 天</text
            ><view class="days"
              ><view
                v-for="label in ['一', '二', '三', '四', '五', '六', '日']"
                :key="label"
                class="weekday"
                ><text class="ui-text day-number">{{ label }}</text></view
              ><view
                v-for="(day, index) in calendar"
                :key="index"
                :class="[
                  'checkin-day',
                  day === 0
                    ? 'empty-day'
                    : task.checkins.some((c) => c.businessDay.slice(0, 10) === date(day))
                      ? 'checked-day'
                      : '',
                ]"
                ><text
                  class="ui-text"
                  :class="[
                    'day-number',
                    day !== 0 && task.checkins.some((c) => c.businessDay.slice(0, 10) === date(day))
                      ? 'checked-number'
                      : '',
                  ]"
                  >{{ day || '' }}</text
                ></view
              ></view
            ><text class="ui-text meta task-card-meta"
              >{{ result!.month }} · 有色日期为已打卡日</text
            ><view v-for="row in task.checkins" :key="row.id" class="checkin-record"
              ><text class="ui-text meta task-card-meta">{{ row.businessDay.slice(0, 10) }}</text
              ><text class="ui-text body-copy task-card-body-copy" :user-select="true">{{
                row.body
              }}</text
              ><view v-if="row.review" class="review-note"
                ><text class="ui-text tag task-card-tag"
                  >老师点评{{
                    row.review!.score !== null ? ' · ' + row.review!.score + '分' : ''
                  }}</text
                ><text class="ui-text body-copy task-card-body-copy" :user-select="true">{{
                  row.review!.body
                }}</text></view
              ><button
                v-if="row.assetIds.length"
                class="ui-button image-add"
                @click="viewImages(row)"
                >查看 {{ row.assetIds.length }} 张实践图片</button
              ></view
            ><button
              v-if="result!.month !== result!.today.slice(0, 7)"
              class="ui-button primary-button"
              @click="
                month = '';
                load();
              "
              >回到本月打卡</button
            ><button
              v-else
              class="ui-button primary-button"
              :disabled="
                !available(task) ||
                task.checkins.some((c) => c.businessDay.slice(0, 10) === result!.today)
              "
              @click="begin(task)"
              >{{
                task.checkins.some((c) => c.businessDay.slice(0, 10) === result!.today)
                  ? '今日已打卡'
                  : available(task)
                    ? '记录今日实践'
                    : '任务已结束或尚未开始'
              }}</button
            ></view
          >
          <ContentState
            v-if="!result!.items.length"
            title="老师尚未布置打卡任务"
            description="发布后可在这里记录实践、查看日历与连续天数。"
            action-label="返回学习档案"
            @action="openPage('course/library')"
          />
          <view class="month-switch row between"
            ><button
              class="ui-button secondary-button month-switch-secondary-button"
              @click="move(-1)"
              >上个月</button
            ><text class="ui-text meta">{{ result!.month }}</text
            ><button
              class="ui-button secondary-button month-switch-secondary-button"
              :disabled="result!.month === result!.today.slice(0, 7)"
              @click="move(1)"
              >下个月</button
            ></view
          ></template
        >
      </view></scroll-view
    ><ComposeSheet
      :visible="visible"
      title="今日研习打卡"
      :quote="selected?.title"
      v-model="body"
      :saving="saving || uploading"
      :error="editorError"
      :disabled="!body.trim()"
      @close="visible = false"
      @submit="submit"
      ><view class="images"
        ><view v-for="(image, index) in images" :key="image.id"
          ><image
            class="checkin-image"
            :src="image.path"
            mode="aspectFill"
            @click="preview(image.path)"
          /><button
            class="ui-button image-remove"
            :disabled="saving || uploading"
            @click="images.splice(index, 1)"
            >移除</button
          ></view
        ></view
      ><button
        class="ui-button image-add"
        :disabled="saving || uploading || images.length >= 6"
        @click="choose"
        >{{ uploading ? '上传中…' : '添加实践图片（最多6张）' }}</button
      ></ComposeSheet
    ></view
  >
</template>
<script setup lang="ts">
import InkBackdrop from '../../components/InkBackdrop.uvue';
import PageHead from '../../components/PageHead.uvue';
import ContentState from '../../components/ContentState.uvue';
import ComposeSheet from '../../components/ComposeSheet.uvue';
import { request, apiBase } from '../../lib/api';
import { currentUser, needLogin } from '../../lib/session';
import { uploadHomeworkImage } from '../../lib/teaching';
type TaskInstructions = { text: string; active?: boolean };
type PracticeReview = { body: string; score: number | null };
type Checkin = {
  id: string;
  businessDay: string;
  body: string;
  assetIds: string[];
  review: PracticeReview | null;
};
type Task = {
  id: string;
  title: string;
  instructions: TaskInstructions;
  required: boolean;
  requiredDays: number;
  completedDays: number;
  complete: boolean;
  streak: number;
  startsOn: string | null;
  endsOn: string | null;
  checkins: Checkin[];
};
type PracticeCohort = { id: string; title: string };
type Tasks = {
  cohort?: PracticeCohort | null;
  canParticipate?: boolean;
  items: Task[];
  today: string;
  month: string;
};
type ImageDraft = { id: string; path: string };
type Draft = { body: string; images: ImageDraft[] };
const result = ref<Tasks | null>(null),
  loading = ref(false),
  error = ref(''),
  selected = ref<Task | null>(null),
  visible = ref(false),
  body = ref(''),
  images = ref<ImageDraft[]>([]),
  saving = ref(false),
  uploading = ref(false),
  editorError = ref('');
let id = '',
  cohortId = '',
  month = '',
  owner = '';
const contextQuery = () => (cohortId ? '?cohortId=' + cohortId : '');
const drafts = new Map<string, Draft>();
const calendar = computed(() => {
  if (!result.value) return [];
  const year = Number(result.value.month.slice(0, 4)),
    month = Number(result.value.month.slice(5, 7)) - 1,
    offset = (new Date(year, month, 1).getDay() + 6) % 7;
  return [
    ...Array.from({ length: offset }, () => 0),
    ...Array.from({ length: new Date(year, month + 1, 0).getDate() }, (_, i) => i + 1),
  ];
});
function date(day: number) {
  return result.value!.month + '-' + String(day).padStart(2, '0');
}
function available(task: Task) {
  return (
    result.value!.canParticipate !== false &&
    task.instructions.active !== false &&
    (!task.startsOn || task.startsOn.slice(0, 10) <= result.value!.today) &&
    (!task.endsOn || task.endsOn.slice(0, 10) >= result.value!.today)
  );
}
async function load() {
  if (owner !== (currentUser.value?.id ?? '')) {
    owner = currentUser.value?.id ?? '';
    result.value = null;
    selected.value = null;
    visible.value = false;
    drafts.clear();
  }
  if (needLogin() || loading.value) return;
  loading.value = true;
  error.value = '';
  try {
    result.value = await request<Tasks>(
      '/learning/courses/' +
        id +
        '/practices' +
        contextQuery() +
        (month ? (cohortId ? '&' : '?') + 'month=' + month : ''),
    );
  } catch (e) {
    error.value = (e as Error).message;
  } finally {
    loading.value = false;
  }
}
function move(delta: number) {
  if (!result.value || loading.value) return;
  const value = new Date(
    Number(result.value.month.slice(0, 4)),
    Number(result.value.month.slice(5, 7)) - 1 + delta,
    1,
  );
  month = value.getFullYear() + '-' + String(value.getMonth() + 1).padStart(2, '0');
  load();
}
function begin(task: Task) {
  if (needLogin()) return;
  if (selected.value)
    drafts.set(selected.value.id, { body: body.value, images: [...images.value] });
  selected.value = task;
  body.value = drafts.get(task.id)?.body ?? '';
  images.value = drafts.get(task.id)?.images ?? [];
  editorError.value = '';
  visible.value = true;
}
async function viewImages(row: Checkin) {
  try {
    const urls = await Promise.all(
      row.assetIds.map(
        async (id) =>
          apiBase +
          (
            await request<{ path: string }>('/learning/checkins/' + row.id + '/images/' + id, {
              method: 'POST',
            })
          ).path,
      ),
    );
    uni.previewImage({ urls });
  } catch (e) {
    uni.showToast({ title: (e as Error).message, icon: 'none' });
  }
}
function preview(path: string) {
  uni.previewImage({ current: path, urls: images.value.map((i) => i.path) });
}
function choose() {
  if (saving.value || uploading.value) return;
  uni.chooseImage({
    count: 6 - images.value.length,
    sizeType: ['compressed'],
    success: async (data) => {
      uploading.value = true;
      try {
        for (const path of data.tempFilePaths) {
          const asset = await uploadHomeworkImage(path);
          images.value.push({ id: asset.id, path });
        }
      } catch (e) {
        editorError.value = (e as Error).message;
      } finally {
        uploading.value = false;
      }
    },
  });
}
async function submit() {
  if (saving.value || uploading.value || !selected.value || needLogin()) return;
  saving.value = true;
  editorError.value = '';
  try {
    await request('/learning/practices/' + selected.value.id + '/checkins' + contextQuery(), {
      method: 'POST',
      data: { body: body.value.trim(), assetIds: images.value.map((i) => i.id) },
    });
    drafts.delete(selected.value.id);
    body.value = '';
    images.value = [];
    selected.value = null;
    visible.value = false;
    await load();
    uni.showToast({ title: '今日实践已记录', icon: 'none' });
  } catch (e) {
    editorError.value = (e as Error).message;
  } finally {
    saving.value = false;
  }
}
onLoad((options) => {
  id = options?.id ?? '';
  cohortId = options?.cohortId ?? '';
});
onShow(() => {
  if (!visible.value && !uploading.value) load();
});
</script>
<style>
@import '../../styles/app.css';
/* 研习打卡：页首 16，任务卡 16 内边距，日历 12/20，记录行 15/15 弱线。 */
.content {
  padding-top: 16px;
  padding-bottom: 40px;
}
.checkin-intro {
  font-family: sans-serif;
  font-size: 13px;
  line-height: 22px;
  color: #5c6869;
  margin-top: 12px;
}
.checkin-notice {
  padding: 12px 16px;
  background-color: #f0eadd;
  border-left-width: 2px;
  border-left-style: solid;
  border-left-color: #8a6635;
  border-radius: 10px;
  margin-top: 12px;
  font-family: sans-serif;
  font-size: 13px;
  line-height: 22px;
  color: #5c6869;
}
.task-card {
  padding: 16px;
  background-color: #fcf9f2;
  border-width: 1px;
  border-style: solid;
  border-color: #cfc5b1;
  border-radius: 14px;
  margin-top: 16px;
}
.task-card-section-heading {
  font-size: 17px;
  line-height: 26px;
}
.task-card-tag {
  font-family: sans-serif;
  font-size: 11px;
  line-height: 17px;
  color: #235663;
  margin-left: 12px;
}
.task-card-body-copy {
  font-family: sans-serif;
  font-size: 13px;
  line-height: 22px;
  color: #5c6869;
  margin-top: 8px;
}
.task-card-meta {
  font-family: sans-serif;
  font-size: 12px;
  line-height: 20px;
  color: #5c6869;
  margin-top: 12px;
}
.days {
  flex-direction: row;
  flex-wrap: wrap;
  margin-top: 12px;
}
.weekday {
  width: 14.28%;
  min-height: 24px;
  align-items: center;
  justify-content: center;
}
.review-note {
  padding: 16px;
  margin-top: 12px;
  background-color: #f0eadd;
  border-radius: 10px;
}
.checkin-day {
  width: 14.28%;
  margin-bottom: 4px;
  min-height: 32px;
  align-items: center;
  justify-content: center;
  border-radius: 10px;
  background-color: #f0eadd;
}
.day-number {
  font-family: sans-serif;
  font-size: 12px;
  line-height: 20px;
  color: #5c6869;
}
.empty-day {
  background-color: transparent;
}
.checked-day {
  background-color: #235663;
}
.checked-number {
  color: #fcf9f2;
}
.checkin-record {
  padding: 15px 0;
  border-bottom-width: 1px;
  border-bottom-style: solid;
  border-bottom-color: #e0d8c8;
}
.month-switch {
  margin-top: 24px;
  align-items: center;
}
.month-switch-secondary-button {
  margin-top: 0;
  min-height: 46px;
  font-size: 13px;
  padding: 12px 16px;
}
.images {
  flex-direction: row;
  flex-wrap: wrap;
  margin-top: 12px;
}
.checkin-image {
  width: 72px;
  height: 72px;
  margin-right: 8px;
  border-radius: 10px;
}
.image-remove,
.image-add {
  font-family: sans-serif;
  font-size: 12px;
  min-height: 44px;
  line-height: 20px;
  padding: 11px 0;
  margin: 0;
  background-color: transparent;
  border-width: 0;
  color: #235663;
}
</style>
