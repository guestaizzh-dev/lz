<template>
<view class="page">
<PageHead title="课程详情" action="share" @action="share"/>
<scroll-view :show-scrollbar="false" class="page-scroll" direction="vertical">
<view class="content">
<ContentState v-if="!course" :loading="!error" :error="error" @retry="load"/>
<view v-else>
<view class="course-cover" @click="play()">
<ArtImage :src="course!.cover" kind="study" :width="width" :height="186"/>
<view class="cover-shade">
<text class="cover-title">{{course!.title}}</text>
<text class="cover-subtitle">{{course!.subtitle}}</text>
<view class="cover-tag">
<AppIcon name="play" :size="16"/>
<text class="cover-tag-text">{{courseType(course!)}}</text>
</view>
</view>
</view>
<text class="detail-title">{{course!.title}}</text>
<text class="course-subtitle">{{course!.subtitle}}</text>
<view class="row course-metadata">
<AppIcon :name="course!.format==='AUDIO'?'headphones':'video-camera'" :size="15"/>
<text class="course-metadata-text">{{courseType(course!)}}　｜　{{course!.chaptersCount}}讲　｜　{{course!.durationMinutes}}分钟</text>
</view>
<view class="notice-strip row between">
<text class="price">¥{{money(course!.price)}}</text>
<text class="tag">{{course!.isDemo?'示例课程':'课程价格'}}</text>
<text class="tag" @click="openPage('membership/index')">会员权益 ›</text>
</view>
<view class="teacher-row row" @click="openPage('teacher/detail?id='+course!.teacher.id)">
<TeacherAvatar :portrait="course!.teacher.portrait" :demo="course!.teacher.isDemo" :size="45"/>
<view class="teacher-copy grow">
<text class="item-title">{{course!.teacher.name}}</text>
<text class="meta">{{course!.teacher.title}}</text>
</view>
<AppIcon name="arrow-right" :size="15"/>
</view>
<view class="detail-tabs">
<view v-for="item in ['介绍','目录','评价']" :key="item" :class="['detail-tab',tab===item?'detail-tab-active':'']" @click="tab=item">
<text :class="['detail-tab-text',tab===item?'detail-tab-selected':'']">{{item}}</text>
</view>
</view>
<view v-if="tab==='介绍'" class="section">
<text class="section-heading">课程简介</text>
<text class="body-copy">{{course!.description}}</text>
<view class="section">
<text class="section-heading">研习方向</text>
<text class="body-copy">{{course!.tags.join(' · ')}}</text>
</view>
</view>
<view v-else-if="tab==='目录'"><LessonRow v-for="item in curriculum?.lessons??[]" :key="item.id" :lesson="item" @select="playLesson($event)"/><ContentState v-if="!curriculum?.lessons.length" title="课程目录尚未发布" description="章节上传后，将在这里展示试听和完整课程目录。"/></view>
<ContentState v-else title="暂无学员评价" description="真实学员的研习反馈将在这里展示。"/>
<text class="footer-note">{{curriculum?.course.accessDays?'课程有效期：'+curriculum!.course.accessDays+'天':'获得课程权限后，长期访问所交付版本'}} · {{curriculum?.course.refundPolicy??''}}</text>
<button v-if="curriculum&&curriculum!.access!=='TRIAL'" class="secondary-button" @click="openPage('course/practice?id='+id)">研习作业 · 查看要求与老师点评</button>
<text v-if="course!.isDemo" class="demo-note">开发示例 · 正式授课与交易尚未开放</text>
</view>
</view>
</scroll-view>
<view v-if="course" class="bottom-bar">
<button class="bar-secondary" @click="play()">试听</button>
<button class="bar-primary" :disabled="enrolling" @click="buy()">{{curriculum?.access!=='TRIAL'&&curriculum?'继续学习':course!.price===0?'加入研习':'立即购买'}}</button>
</view>
</view>
</template>
<script setup lang="ts">
import PageHead from '../../components/PageHead.uvue';import ArtImage from '../../components/ArtImage.uvue';import AppIcon from '../../components/AppIcon.uvue';import TeacherAvatar from '../../components/TeacherAvatar.uvue';import ContentState from '../../components/ContentState.uvue';import LessonRow from '../../components/LessonRow.uvue';import {request,money} from '../../lib/api';import type {Course} from '../../lib/api';import type {Curriculum,LessonSummary} from '../../lib/learning';import {viewWidth,courseType,openPage,shareContent} from '../../lib/presentation';import {needLogin} from '../../lib/session';
const width=viewWidth(),course=ref<Course|null>(null),curriculum=ref<Curriculum|null>(null),error=ref(''),tab=ref('介绍'),enrolling=ref(false);let id='';async function load(){error.value='';try{const result=await Promise.all([request<Course>('/catalog/courses/'+encodeURIComponent(id)),request<Curriculum>('/learning/courses/'+encodeURIComponent(id))]);course.value=result[0];curriculum.value=result[1];}catch(e){error.value=(e as Error).message;}}function playLesson(item:LessonSummary){openPage('course/player?id='+id+'&lessonId='+item.id);}function play(){openPage('course/player?id='+id);}async function buy(){if(enrolling.value||needLogin())return;if(curriculum.value&&curriculum.value.access!=='TRIAL'){play();return;}if(course.value?.price===0){enrolling.value=true;try{await request('/learning/courses/'+id+'/enroll',{method:'POST'});play();}catch(e){uni.showToast({title:(e as Error).message,icon:'none'});}finally{enrolling.value=false;}return;}openPage('order/confirm?type=course&id='+id);}function share(){if(course.value)shareContent('课程',id,course.value.title);}onLoad(options=>{id=options?.id??'';});onShow(()=>{if(id)load();});
</script>
<style>@import '../../styles/app.css';.course-cover{position:relative;overflow:hidden;border-radius:4px;}.cover-shade{position:absolute;left:0;top:0;right:0;bottom:0;background-color:rgba(23,41,45,0.32);padding:28px 20px;}.cover-title{font-family:AcademySerif;color:#FAF8F2;font-size:24px;line-height:35px;}.cover-subtitle{font-family:AcademySerif;color:#FAF8F2;font-size:13px;margin-top:8px;line-height:19px;}.cover-tag{flex-direction:row;align-items:center;align-self:flex-start;border-radius:12px;background-color:#E6D6BD;padding:4px 10px;margin-top:18px;}.cover-tag-text{font-size:10px;color:#17292D;margin-left:4px;line-height:15px;}.course-subtitle{font-family:AcademySerif;font-size:14px;line-height:25px;color:#344C54;margin-top:3px;}.course-metadata{margin-top:12px;}.course-metadata-text{font-size:11px;color:#637276;margin-left:5px;line-height:16px;}.teacher-row{padding:20px 0 0;}.teacher-copy{padding-left:12px;}.trial-text{color:#245564;font-size:13px;margin-left:6px;line-height:19px;}</style>
