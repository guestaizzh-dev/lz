<template><view class="page"><PageHead title="离线课件"/><scroll-view class="page-scroll" direction="vertical"><view class="content">
<view class="download-tabs"><button :class="['download-tab',tab==='local'?'download-tab-active':'']" @click="tab='local'">本机课件</button><button :class="['download-tab',tab==='devices'?'download-tab-active':'']" @click="showDevices">设备授权</button></view>
<text class="footer-note">课件仅供当前账号使用。最长每72小时联网校验一次，会员或营期到期更早时按其到期时间停止。退出或切换账号会删除本机缓存；设备重启或时间变化后需联网刷新。</text>
<ContentState v-if="error" :error="error" @retry="load"/>
<view v-if="tab==='local'"><ContentState v-if="!error&&!items.length" :title="platform==='WEB'?'请在App查看本机课件':'还没有离线课件'" :description="platform==='WEB'?'网页版可管理设备授权，离线下载和播放请使用Android或iOS App。':'在可研习的录播章节中选择离线下载。下载完成后，可在这里播放。'" actionLabel="我的课程" @action="openPage('course/library')"/><view v-for="item in items" :key="item.id" class="download-card"><view class="download-heading"><text class="tag">{{item.mime==='audio/mp4'?'音频':'视频'}}</text><text class="download-state">{{stateLabel(item)}}</text></view><text class="download-title">{{item.title}}</text><text class="meta">{{item.courseTitle}}</text><text v-if="item.expiresAt" class="meta">授权至北京时间 {{formatChinaTime(item.expiresAt)}}</text><view v-if="item.state==='DOWNLOADING'||item.state==='PAUSED'||item.state==='FAILED'" class="download-progress"><progress :percent="percent(item)" activeColor="#235663" backgroundColor="#E5DFD2" :stroke-width="3"/><text class="meta">{{size(item.receivedBytes)}} / {{size(item.bytes)}} · {{percent(item)}}%</text></view><text v-if="item.error" class="download-error">{{item.error}}</text><view class="download-actions"><button v-if="item.state==='READY'" class="download-button" @click="play(item)">播放课件</button><button v-if="item.state==='DOWNLOADING'" class="download-button" @click="pause(item)">暂停下载</button><button v-else-if="item.lessonId" class="download-button" :disabled="busy" @click="resume(item)">{{item.state==='READY'?'联网刷新授权':'继续下载'}}</button><button v-if="item.state!=='DOWNLOADING'" class="download-button" :disabled="busy" @click="remove(item)">删除</button></view></view></view>
<view v-else><ContentState v-if="devicesLoading" :loading="true"/><ContentState v-else-if="!devices.length&&!remoteError" title="暂无有效设备授权" description="下载产生的设备授权会在这里列出。"/><text v-if="remoteError" class="download-error">{{remoteError}}</text><view v-for="device in devices" :key="device.ref" class="download-card"><text class="download-title">设备 {{device.ref.slice(0,8).toUpperCase()}}</text><text class="meta">{{device.count}} 份有效课件 · 最晚 {{formatChinaTime(device.expiresAt)}}</text><button class="download-button" :disabled="busy" @click="revoke(device.ref)">移除此设备授权</button></view><text class="footer-note">移除后不能刷新或继续下载；完全离线设备上的已发授权最迟在原有效期结束时失效。</text></view>
</view></scroll-view></view></template>
<script setup lang="ts">
import {purchasePlatform} from '../../lib/course-sales';
import PageHead from '../../components/PageHead.uvue';import ContentState from '../../components/ContentState.uvue';import {cachedLessons,nativeOffline,selectOfflineUser} from '../../lib/offline-files';import type {CachedLesson} from '../../lib/offline-files';import {renewOffline,deleteOffline} from '../../lib/offline-learning';import {needLogin,currentUser} from '../../lib/session';import {request} from '../../lib/api';import {formatChinaTime} from '../../lib/date-time';import {openPage} from '../../lib/presentation';
const platform=purchasePlatform();const items=ref<CachedLesson[]>([]),tab=ref('local'),error=ref(''),busy=ref(false),devicesLoading=ref(false),remoteError=ref(''),devices=ref<{ref:string;count:number;expiresAt:string}[]>([]);let timer:ReturnType<typeof setInterval>|null=null,owner='';
const size=(value:number)=>!Number.isFinite(value)?'—':value<1024*1024?(Math.max(0,value)/1024).toFixed(0)+'KB':(value/1024/1024).toFixed(1)+'MB';const percent=(item:CachedLesson)=>Math.min(100,Math.max(0,Math.round((item.receivedBytes??0)/Math.max(1,item.bytes??1)*100)));const stateLabel=(item:CachedLesson)=>item.state==='READY'&&Date.parse(item.expiresAt)<=Date.now()?'需要联网刷新':({DOWNLOADING:'下载中',PAUSED:'已暂停',READY:'可离线播放',FAILED:'等待重试'} as Record<string,string>)[item.state]??'等待更新';
function load(){if(needLogin('/pages/course/downloads'))return;error.value='';if(platform==='WEB'){items.value=[];return;}try{items.value=cachedLessons();}catch(e){error.value=(e as Error).message;}}
function poll(){if(owner!==currentUser.value?.id){items.value=[];devices.value=[];return;}for(let i=0;i<items.value.length;i++)if(items.value[i].state==='DOWNLOADING')try{items.value[i]=nativeOffline<CachedLesson>('STATUS',{id:items.value[i].id});}catch{load();break;}}
function play(item:CachedLesson){try{nativeOffline('PLAY',{id:item.id});}catch(e){uni.showToast({title:(e as Error).message,icon:'none'});}}
function pause(item:CachedLesson){try{nativeOffline('PAUSE',{id:item.id});}catch(e){uni.showToast({title:(e as Error).message,icon:'none'});}}
async function resume(item:CachedLesson){if(busy.value)return;busy.value=true;try{await renewOffline(item);load();uni.showToast({title:item.state==='READY'?'授权已刷新':'已继续下载',icon:'none'});}catch(e){uni.showToast({title:(e as Error).message,icon:'none'});}finally{busy.value=false;}}
function remove(item:CachedLesson){uni.showModal({title:'删除本机课件？',content:'学习记录会保留，之后可在权限有效时重新下载。',success:async r=>{if(!r.confirm||busy.value)return;busy.value=true;try{const revoked=await deleteOffline(item.id);load();uni.showToast({title:revoked?'本机课件已删除':'本机已删除；服务端授权按原期限结束',icon:'none'});}catch(e){uni.showToast({title:(e as Error).message,icon:'none'});}finally{busy.value=false;}}});}
async function showDevices(){tab.value='devices';devicesLoading.value=true;remoteError.value='';try{const result=await request<{items:{deviceRef:string;expiresAt:string}[]}>('/learning/offline/licenses'),groups=new Map<string,{ref:string;count:number;expiresAt:string}>();for(const row of result.items){const group=groups.get(row.deviceRef)??{ref:row.deviceRef,count:0,expiresAt:row.expiresAt};group.count++;if(Date.parse(row.expiresAt)>Date.parse(group.expiresAt))group.expiresAt=row.expiresAt;groups.set(row.deviceRef,group);}devices.value=[...groups.values()];}catch(e){remoteError.value=(e as Error).message;}finally{devicesLoading.value=false;}}
function revoke(ref:string){uni.showModal({title:'移除此设备授权？',content:'会停止该设备继续下载和刷新，已离线的课件最长仍可使用至原授权到期。',success:async r=>{if(!r.confirm||busy.value)return;busy.value=true;try{await request('/learning/offline/devices/'+ref,{method:'DELETE'});if(platform!=='WEB')try{if(cachedLessons().some(item=>item.deviceHash===ref)){const user=currentUser.value?.id??'';selectOfflineUser('');selectOfflineUser(user);load();}}catch{uni.showToast({title:'设备授权已移除，本机缓存请退出并重新登录后清理',icon:'none'});}await showDevices();}catch(e){uni.showToast({title:(e as Error).message,icon:'none'});}finally{busy.value=false;}}});}
onShow(()=>{owner=currentUser.value?.id??'';load();if(timer)clearInterval(timer);timer=setInterval(poll,1000);});onHide(()=>{if(timer)clearInterval(timer);timer=null;});onUnload(()=>{if(timer)clearInterval(timer);});
</script><style>@import '../../styles/app.css';.download-tabs{flex-direction:row;border-bottom-width:1px;border-bottom-color:#E3DCCF;margin-bottom:14px;}.download-tab{font-size:15px;color:#89877C;background-color:transparent;border-width:0;margin:0;padding:12px 18px;line-height:22px;min-height:44px;}.download-tab-active{color:#235663;border-bottom-width:2px;border-bottom-color:#235663;}.download-card{padding:20px 0;border-bottom-width:1px;border-bottom-color:#E3DCCF;}.download-heading{flex-direction:row;justify-content:space-between;align-items:center;margin-bottom:8px;}.download-title{font-family:AcademySerif;font-size:18px;line-height:28px;color:#182B31;}.download-state{font-size:12px;color:#6E7E68;}.download-progress{margin-top:14px;}.download-actions{flex-direction:row;flex-wrap:wrap;margin-top:12px;}.download-button{font-size:13px;line-height:22px;min-height:44px;margin:0 8px 8px 0;padding:10px 14px;color:#235663;background-color:#EFE9DC;border-width:1px;border-color:#E3DCCF;border-radius:4px;}.download-error{font-size:13px;line-height:22px;color:#B4533F;margin-top:8px;}</style>
