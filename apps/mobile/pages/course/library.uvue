<template><view class="page"><PageHead title="学习档案"/><scroll-view :show-scrollbar="false" class="page-scroll" direction="vertical"><view class="content"><ContentState v-if="loading||error" :loading="loading" :error="error" @retry="load"/><view v-for="item in items" :key="item.course.id" class="learning-card" @click="openPage('course/player?id='+item.course.id)"><text class="tag">{{item.access==='MEMBER'?'会员研习':'我的课程'}}</text><text class="item-title">{{item.course.title}}</text><text class="meta">已完成 {{item.lessons.filter(lesson=>lesson.progress?.completedAt).length}} / {{item.lessons.length}} 讲</text><view class="row between"><text class="body-copy">继续研习</text><AppIcon name="arrow-right" :size="18"/></view></view><ContentState v-if="!loading&&!error&&!items.length" title="研习，从第一章开始" description="加入免费课程、购买课程或获得会员权限后，可在这里继续学习。"/></view></scroll-view></view></template>
<script setup lang="ts">import PageHead from '../../components/PageHead.uvue';import AppIcon from '../../components/AppIcon.uvue';import ContentState from '../../components/ContentState.uvue';import {request} from '../../lib/api';import type {Curriculum} from '../../lib/learning';import {needLogin} from '../../lib/session';import {openPage} from '../../lib/presentation';const items=ref<Curriculum[]>([]),loading=ref(false),error=ref('');async function load(){if(needLogin())return;loading.value=true;error.value='';try{items.value=(await request<{items:Curriculum[]}>('/learning/library')).items;}catch(e){error.value=(e as Error).message;}finally{loading.value=false;}}onShow(()=>load());</script>
<style>@import '../../styles/app.css';.learning-card{padding:20px 16px;margin-top:16px;background-color:#FAF8F2;border-radius:4px;border-width:1px;border-style:solid;border-color:#D8D4CA;}</style>
