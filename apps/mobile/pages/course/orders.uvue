<template>
  <view class="page"
    ><InkBackdrop /><PageHead title="购课订单" /><scroll-view
      class="page-scroll"
      direction="vertical"
      :show-scrollbar="false"
      ><view class="content">
        <text class="ui-text eyebrow">购课记录</text
        ><text class="ui-text orders-intro">课程购买、支付结果和退课进度，都可以在这里查看。</text
        ><view class="detail-tabs"
          ><view
            v-for="filter in filters"
            :key="filter.value"
            :class="['detail-tab', state === filter.value ? 'detail-tab-active' : '']"
            @click="change(filter.value)"
            ><text
              class="ui-text"
              :class="['detail-tab-text', state === filter.value ? 'detail-tab-selected' : '']"
              >{{ filter.label }}</text
            ></view
          ></view
        >
        <ContentState
          v-if="loading || error"
          :loading="loading"
          :error="error"
          :error-title="error.indexOf('登录') >= 0 ? '请先登录' : '购课订单未能加载'"
          :retryable="error.indexOf('登录') < 0"
          @retry="retry"
        />
        <view
          v-for="item in items"
          :key="item.id"
          class="course-order"
          hover-class="row-pressed"
          @click="openPage('course/purchase?orderId=' + item.id)"
          ><view class="order-heading"
            ><text class="ui-text order-date">{{ formatChinaDate(item.createdAt) }}</text
            ><text
              class="ui-text"
              :class="[
                'pill',
                item.state === 'PENDING'
                  ? 'pill-gold'
                  : item.state === 'COMPLETED'
                    ? 'pill-teal'
                    : 'pill-muted',
              ]"
              >{{ orderLabel(item) }}</text
            ></view
          ><view class="order-course"
            ><ArtImage :src="item.course.cover" kind="study" :width="64" :height="82" /><view
              class="order-copy"
              ><text class="ui-text order-title">{{ item.course.title }}</text
              ><text class="ui-text order-meta"
                >{{ item.course.teacherName }} · 共 {{ item.course.lessons }} 讲</text
              ><text v-if="item.refunds.length" class="ui-text order-refund">{{
                refundLabel(item.refunds[0].state)
              }}</text></view
            ></view
          ><view class="order-footer"
            ><text class="ui-text order-link"
              >{{ item.state === 'PENDING' ? '查看与支付' : '查看订单' }} ›</text
            ><text class="ui-text order-amount">¥{{ money(Number(item.amount)) }}</text></view
          ></view
        >
        <ContentState
          v-if="ready && !loading && !error && !items.length"
          title="还没有购课订单"
          description="可以先试听，再选择适合你的研习课程。"
          action-label="去学堂选课"
          @action="browse"
        /><button
          v-if="items.length < total && !loading && !error"
          class="ui-button secondary-button"
          @click="load(true)"
          >继续查看</button
        >
      </view></scroll-view
    ></view
  >
</template>
<script setup lang="ts">
import InkBackdrop from '../../components/InkBackdrop.uvue';
import { formatChinaDate } from '../../lib/date-time';
import PageHead from '../../components/PageHead.uvue';
import ContentState from '../../components/ContentState.uvue';
import ArtImage from '../../components/ArtImage.uvue';
import { request, money } from '../../lib/api';
import { currentUser, needLogin } from '../../lib/session';
import { openPage } from '../../lib/presentation';
import { orderLabel, refundLabel } from '../../lib/course-sales';
import type { CourseOrder } from '../../lib/course-sales';
const filters = [
    { label: '全部', value: '' },
    { label: '待支付', value: 'PENDING' },
    { label: '已支付', value: 'COMPLETED' },
    { label: '已关闭', value: 'CLOSED' },
  ],
  state = ref(''),
  items = ref<CourseOrder[]>([]),
  total = ref(0),
  loading = ref(false),
  error = ref(''),
  ready = ref(false);
let page = 1,
  owner = '',
  failedAppend = false;
async function load(append = false) {
  if (loading.value || needLogin()) return;
  loading.value = true;
  error.value = '';
  failedAppend = append;
  const next = append ? page + 1 : 1;
  try {
    const result = await request<{ items: CourseOrder[]; total: number }>(
      '/commerce/course-orders?page=' +
        next +
        (state.value ? '&state=' + encodeURIComponent(state.value) : ''),
    );
    items.value = append ? [...items.value, ...result.items] : result.items;
    total.value = result.total;
    page = next;
    failedAppend = false;
  } catch (e) {
    error.value = (e as Error).message;
  } finally {
    loading.value = false;
    ready.value = true;
  }
}
function retry() {
  void load(failedAppend);
}
function change(value: string) {
  if (loading.value || state.value === value) return;
  state.value = value;
  items.value = [];
  total.value = 0;
  void load();
}
function browse() {
  uni.switchTab({ url: '/pages/academy/index' });
}
onShow(() => {
  if (owner !== (currentUser.value?.id ?? '')) {
    owner = currentUser.value?.id ?? '';
    items.value = [];
    total.value = 0;
  }
  void load();
});
</script>
<style>
@import '../../styles/app.css';
/* 购课订单列表：卡内 16，行标题 16/24，金额 19/27 右对齐、单位 12/20。 */
.detail-tabs {
  margin-top: 8px;
}
.detail-tab-text {
  font-family: sans-serif;
  font-size: 14px;
  line-height: 24px;
  color: #5c6869;
  letter-spacing: 0;
}
.detail-tab-selected {
  color: #182b31;
  font-weight: 600;
}
.orders-intro {
  font-family: sans-serif;
  font-size: 13px;
  line-height: 22px;
  color: #5c6869;
  padding-top: 8px;
  padding-bottom: 8px;
}
.course-order {
  padding: 16px;
  background-color: #fcf9f2;
  border-style: solid;
  border-width: 1px;
  border-color: #cfc5b1;
  border-radius: 14px;
  margin-top: 12px;
}
.order-heading {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}
.order-date {
  font-family: sans-serif;
  font-size: 12px;
  line-height: 20px;
  color: #5c6869;
}
.order-course {
  flex-direction: row;
}
.order-copy {
  flex: 1;
  min-width: 0;
  padding-left: 16px;
  justify-content: center;
}
.order-title {
  font-family: AcademySerif;
  font-size: 16px;
  line-height: 24px;
  color: #182b31;
  font-weight: 600;
  max-height: 48px;
  overflow: hidden;
}
.order-meta {
  font-family: sans-serif;
  font-size: 12px;
  line-height: 20px;
  color: #5c6869;
  margin-top: 4px;
}
.order-refund {
  font-family: sans-serif;
  font-size: 12px;
  line-height: 20px;
  color: #b4533f;
  margin-top: 4px;
}
.order-footer {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-top: 12px;
  padding-top: 12px;
  border-top-width: 1px;
  border-top-style: solid;
  border-top-color: #e0d8c8;
}
.order-amount {
  font-family: AcademySerif;
  font-size: 19px;
  line-height: 27px;
  color: #182b31;
  font-weight: 600;
  text-align: right;
}
.order-link {
  font-family: sans-serif;
  font-size: 13px;
  line-height: 22px;
  color: #235663;
  padding: 11px 0;
  min-height: 44px;
}
</style>
