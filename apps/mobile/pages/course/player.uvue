<template>
<view class="page"><PageHead title="课程学习"/><scroll-view :show-scrollbar="false" class="page-scroll" direction="vertical"><view class="content">
<ContentState v-if="loading||error" :loading="loading" :error="error" @retry="load"/>
<view v-if="curriculum">
<text class="detail-title">{{curriculum!.course.title}}</text><text class="meta">{{curriculum!.cohort?'本期研习 · '+curriculum!.cohort!.title:curriculum!.access==='ENROLLED'?'已加入研习':curriculum!.access==='MEMBER'?'会员可学':'试听目录'}} · {{curriculum!.lessons.length}} 讲 · {{contentLabel(curriculum!.lessons)}}</text>
<view v-if="curriculum!.deliveryBlocked" class="delivery-notice"><text class="body-copy">此版本已停止交付：{{curriculum!.deliveryReason}}</text><text class="meta">学习记录与订单保留，请选择版本处理方案或联系书院。</text></view><button v-if="curriculum!.access==='ENROLLED'&&!curriculum!.cohort" class="retry" @click="openPage('course/versions?id='+id)">课程版本与交付处理 ›</button>
<text v-if="curriculum!.cohort" class="footer-note">本期章节按目录时间陆续开放。仅记录当前营期进度，独立购课及其他营期的学习记录分别保留。</text><button v-if="curriculum!.cohort&&curriculum!.lessons.length&&curriculum!.lessons.filter(item=>item.required).every(item=>!!item.progress?.completedAt)&&(curriculum!.lessons.some(item=>item.required)||curriculum!.lessons.every(item=>!!item.progress?.completedAt))" class="retry" @click="openPage('course/certificate?id='+id+'&cohortId='+cohortId)">查看本期研习完成记录 ›</button><button v-if="curriculum!.cohort" class="retry" @click="openPage('course/practice?id='+id+'&cohortId='+cohortId)">本期作业 · 实践打卡 ›</button><view class="lesson-filters"><button v-for="format in ['',...formats]" :key="format" :class="['lesson-filter',filter===format?'lesson-filter-active':'']" :disabled="selecting" @click="chooseFormat(format)">{{format?lessonType(format):'全部'}} {{format?curriculum!.lessons.filter(item=>item.format===format).length:curriculum!.lessons.length}}</button></view>
<ContentState v-if="selecting&&!loading" :loading="true"/><ContentState v-else-if="lessonError" :error="lessonError" @retry="retryLesson"/>
<view v-if="lesson" class="study-content">
<view class="lesson-heading"><text class="tag">第 {{lesson!.position}} 讲 · {{lessonType(lesson!.format)}}{{lesson!.trial?' · 免费试学':''}}</text><text class="section-heading">{{lesson!.title}}</text></view>
<view v-if="lesson!.format==='LIVE'" class="audio-panel live-lesson"><AppIcon name="video-camera" :size="30"/><text class="section-heading live-lesson-title">{{liveStateTitle}}</text><text v-if="liveLesson" class="meta live-lesson-time">北京时间 {{formatChinaTime(liveLesson!.scheduledAt)}}</text><text class="body-copy live-lesson-copy">{{liveLesson?.state==='LIVE'?'本场正在直播，可以进入研习。':liveLesson?.replayReady?'本场回放已审核发布，仍按本课程权限开放。':liveLesson?.state==='CANCELLED'?'本场已取消，请从购课订单查看处理方案。':liveLesson?.state==='ENDED'?'直播已结束，完整回放审核后将在这里开放。':'请按开播时间前来，预约后可在消息中心查看提醒。'}}</text><button v-if="liveLesson?.state==='LIVE'||liveLesson?.replayReady" class="primary-button" @click="enterLive">{{liveLesson?.state==='LIVE'?'进入直播':'观看回放'}}</button><button v-else-if="liveLesson&&['SCHEDULED','PREPARING'].includes(liveLesson!.state)" class="secondary-button" @click="openPage('live/detail?id='+liveLesson!.roomId)">查看安排 · 预约提醒</button><button class="retry" :disabled="selecting" @click="selectLesson(lesson!)">刷新场次</button></view>
<video v-if="lesson!.format==='VIDEO'&&mediaUrl" id="lessonVideo" class="lesson-video" :src="mediaUrl" :initial-time="resume" :controls="true" @timeupdate="videoTime" @play="playing=true" @pause="pause()" @ended="finish()" @loadedmetadata="restoreVideo" @waiting="mediaBuffering=true" @error="mediaError()"/>
<view v-if="lesson!.format==='AUDIO'" class="audio-panel"><AppIcon name="headphones" :size="36"/><text class="body-copy" :user-select="true">{{duration(audioDragging?audioDrag:position)}} / {{duration(lesson!.durationSeconds)}}</text><slider class="audio-slider" :value="audioDragging?audioDrag:position" :max="Math.max(1,lesson!.durationSeconds)" activeColor="#235663" @changing="dragAudio" @change="seekAudio"/><button class="primary-button" @click="toggleAudio()">{{playing?'暂停':'播放音频'}}</button></view>
<view v-if="['VIDEO','AUDIO'].includes(lesson!.format)" class="row playback-tools"><button v-for="rate in [1,1.25,1.5,2]" :key="rate" :class="['rate-button',speed===rate?'rate-selected':'']" @click="setRate(rate)">{{rate}}×</button></view>
<button v-if="offlineReady&&lesson!.hasMedia&&currentUser" class="retry" :disabled="offlineBusy" @click="downloadCurrent">离线下载本讲 ›</button><MediaTranscript v-if="lesson!.subtitles?.length" :key="lesson!.id" :cues="lesson!.subtitles" :position="position" @seek="seekMedia"/><view v-if="lesson!.body" class="lesson-reading"><text v-if="lesson!.format!=='TEXT'" class="lesson-reading-label">本讲文字</text><text class="body-copy lesson-body" :user-select="true">{{lesson!.body}}</text></view>
<button v-if="lesson!.format==='TEXT'&&currentUser" :class="['primary-button',readingQueued?'reading-pending':'']" :disabled="saving||readingQueued||!!lesson!.progress?.completedAt" @click="completeReading()">{{lesson!.progress?.completedAt?'已完成研习':readingQueued?'本章已读，待同步':'标记本章已读'}}</button>
<text v-if="syncError||studySync.pending||studySync.error" class="sync-error">{{syncError||(studySync.blocked?'部分记录暂不能同步：'+studySync.error+'。本机记录已保留。':studySync.pending?'已保存在本机，待联网同步 '+studySync.pending+' 条记录。':studySync.error)}}</text><button v-if="syncError||studySync.pending||studySync.error" class="retry" @click="retryStudy">重试同步</button>
<text v-if="mediaBuffering&&!mediaFailed" class="footer-note">正在缓冲，研习进度已保留…</text><text v-if="mediaNotice" class="sync-error">{{mediaNotice}}</text><button v-if="mediaFailed" class="retry" :disabled="mediaRenewing" @click="retryMedia">重新加载媒体</button>
<text class="footer-note">{{currentUser?'进度会同步到当前研习记录。':'登录后可保存学习进度。'}}</text>
<view v-if="previousLesson||nextLesson" class="lesson-navigation"><button v-if="previousLesson" class="secondary-button lesson-navigation-button" :disabled="selecting" @click="selectLesson(previousLesson!)">上一讲</button><button v-if="nextLesson" class="secondary-button lesson-navigation-button" :disabled="selecting" @click="selectLesson(nextLesson!)">下一讲{{nextLesson!.accessible?'':' · 尚未开放'}}</button></view>
</view>
<view class="section"><view class="row"><text class="section-heading">课程目录</text><button v-if="curriculum!.cohort" class="retry" :disabled="loading||selecting" @click="load()">刷新目录</button></view><LessonRow v-for="item in visibleLessons" :key="item.id" :lesson="item" :active="item.id===selectedId" @select="selectLesson($event)"/><ContentState v-if="!curriculum!.lessons.length" title="等待章节发布" description="书院发布章节后，可在这里开始研习。"/></view>
<button v-if="curriculum!.access==='TRIAL'" class="retry" @click="openPage('course/detail?id='+id)">查看课程与权益</button>
</view><SponsoredContent v-if="curriculum" surface="MEDIA_FOOTER"/></view><CourseCases v-if="curriculum&&curriculum!.access!=='TRIAL'&&!cohortId" :courseId="curriculum!.course.id"/></scroll-view></view>
</template>
<script setup lang="ts">
import SponsoredContent from '../../components/SponsoredContent.uvue';
import CourseCases from '../../components/CourseCases.uvue';
const offlineReady=ref(false),offlineBusy=ref(false);
async function checkOffline(){
// #ifdef APP-ANDROID || APP-IOS
if(currentUser.value)try{const c=await request<OfflineCapabilities>('/learning/offline/capabilities');offlineReady.value=c.nativeDownloadReady&&!!c.verificationKey&&hasOfflineKey(c.verificationKey.kid);}catch{offlineReady.value=false;}
// #endif
}
function downloadCurrent(){if(!lesson.value||!curriculum.value||offlineBusy.value)return;uni.showModal({title:'离线下载本讲',content:'确认后开始本讲的学习交付，可能影响未开始学习的退款条件。课件仅供当前账号使用，最长每72小时联网校验一次。',confirmText:'确认下载',success:async r=>{if(!r.confirm||!lesson.value||!curriculum.value)return;offlineBusy.value=true;try{await downloadLesson({id:lesson.value.id,title:lesson.value.title,courseTitle:curriculum.value.course.title,cohortId:cohortId||undefined},true);openPage('course/downloads');}catch(e){uni.showToast({title:(e as Error).message,icon:'none'});}finally{offlineBusy.value=false;}}});}

import {downloadLesson} from '../../lib/offline-learning';import {hasOfflineKey} from '../../lib/offline-files';import type {OfflineCapabilities} from '../../lib/offline-learning';
import MediaTranscript from '../../components/MediaTranscript.uvue';
import PageHead from '../../components/PageHead.uvue';import AppIcon from '../../components/AppIcon.uvue';import ContentState from '../../components/ContentState.uvue';import LessonRow from '../../components/LessonRow.uvue';import {formatChinaTime} from '../../lib/date-time';import type {LiveLessonState} from '../../lib/learning';import {request,apiBase} from '../../lib/api';import {currentUser,needLogin,sessionGeneration} from '../../lib/session';import {recordStudy,studySync,studyAcknowledgement,syncStudy,localStudy} from '../../lib/study-queue';import {duration,lessonType,contentFormats,contentLabel} from '../../lib/learning';import {studyOverview} from '../../lib/study-overview';import type {Curriculum,LessonSummary,LessonDetail,StudyProgress} from '../../lib/learning';import {openPage,showUnavailable} from '../../lib/presentation';
const liveLesson=ref<LiveLessonState|null>(null),liveStateTitle=computed(()=>({SCHEDULED:'等待开播',PREPARING:'老师正在准备',LIVE:'直播研习',ENDED:'等待回放',REPLAY_READY:'回放研习',CANCELLED:'安排已取消'} as Record<string,string>)[liveLesson.value?.state??'']??'直播安排');
function enterLive(){if(liveLesson.value&&lesson.value)openPage('live/watch?id='+liveLesson.value.id+'&roomId='+liveLesson.value.roomId+'&lessonId='+lesson.value.id+'&courseId='+id+(cohortId?'&cohortId='+encodeURIComponent(cohortId):'')+(liveLesson.value.replayReady?'&mode=replay':''));}
const curriculum=ref<Curriculum|null>(null),lesson=ref<LessonDetail|null>(null),loading=ref(false),error=ref(''),mediaUrl=ref(''),mediaFailed=ref(false),playing=ref(false),position=ref(0),resume=ref(0),speed=ref(1),saving=ref(false),syncError=ref('');const filter=ref(''),formats=computed(()=>contentFormats(curriculum.value?.lessons??[])),visibleLessons=computed(()=>(curriculum.value?.lessons??[]).filter(item=>!filter.value||item.format===filter.value));
const audioDragging=ref(false),audioDrag=ref(0),mediaBuffering=ref(false);let pendingSeek=-1,pendingSeekUntil=0;
const selectedId=ref(''),mediaNotice=ref(''),mediaRenewing=ref(false);
const lessonIndex=computed(()=>(curriculum.value?.lessons??[]).findIndex(item=>item.id===selectedId.value)),previousLesson=computed(()=>lessonIndex.value>0?curriculum.value?.lessons[lessonIndex.value-1]:undefined),nextLesson=computed(()=>lessonIndex.value>=0?curriculum.value?.lessons[lessonIndex.value+1]:undefined);
let mediaTimer:ReturnType<typeof setTimeout>|null=null,mediaGeneration=0,mediaExpires=0,visible=true,restorePlaying=false,recoveries=0;
let id='',cohortId='',owner='',requestedId='',alive=true,audio:ReturnType<typeof uni.createInnerAudioContext>|null=null,lastTick=0,elapsed=0,lastFlush=0;
const selecting=ref(false),readingQueued=ref(false),lessonError=ref('');let retryLessonId='',curriculumGeneration=0;
const contextQuery=():string=>cohortId?'?cohortId='+encodeURIComponent(cohortId):'';
async function chooseFormat(format:string){if(selecting.value)return;const target=curriculum.value?.lessons.find(item=>(!format||item.format===format)&&item.accessible&&!item.progress?.completedAt)??curriculum.value?.lessons.find(item=>(!format||item.format===format)&&item.accessible);if(format&&lesson.value?.format!==format&&target){await selectLesson(target);if(lesson.value?.id!==target.id)return;}filter.value=format;}
let ownerGeneration=0;
let checkpointLesson='',checkpointPosition=-1,checkpointCompleted=false;
watch(studyAcknowledgement,value=>{if(!value||value.generation!==sessionGeneration()||value.event.userId!==owner||value.event.courseId!==id||value.event.cohortId!==cohortId)return;const saved=value.result,target=value.event.lessonId;const row=curriculum.value?.lessons.find(item=>item.id===target);if(row&&(!row.progress?.updatedAt||!saved.updatedAt||saved.updatedAt>=row.progress.updatedAt))row.progress=saved;if(lesson.value?.id===target&&row){lesson.value.progress=row.progress;if(saved.completedAt)readingQueued.value=false;}});
async function load(){
  const generation=++curriculumGeneration,session=sessionGeneration(),actor=currentUser.value?.id??'';
  const current=()=>alive&&visible&&generation===curriculumGeneration&&session===sessionGeneration()&&actor===(currentUser.value?.id??'');
  loading.value=true;error.value='';
  try{
    const result=await request<Curriculum>('/learning/courses/'+encodeURIComponent(id)+contextQuery());if(!current())return;
    curriculum.value=result;
    if(selectedId.value){
      const selected=result.lessons.find(row=>row.id===selectedId.value);
      if(!selected?.accessible){stop();audio?.destroy();audio=null;lesson.value=null;selectedId.value='';mediaUrl.value='';lessonError.value='';retryLessonId='';}
      else if(lesson.value){lesson.value.progress=selected.progress;if(lesson.value.format==='LIVE'){const live=await request<LiveLessonState>('/live/lessons/'+lesson.value.id);if(current())liveLesson.value=live;}}
    }else{
      const requested=retryLessonId||requestedId;requestedId='';
      const target=result.lessons.find(row=>row.id===requested&&row.accessible)??studyOverview(result).next;
      if(target)await selectLesson(target);
    }
  }catch(e){
    if(!current())return;
    retryLessonId=selectedId.value||retryLessonId;stop();audio?.destroy();audio=null;lesson.value=null;curriculum.value=null;selectedId.value='';mediaUrl.value='';error.value=(e as Error).message;
  }finally{if(generation===curriculumGeneration){if(session!==sessionGeneration()){stop();audio?.destroy();audio=null;lesson.value=null;curriculum.value=null;selectedId.value='';mediaUrl.value='';error.value='登录状态已变化，请重新加载课程。';}loading.value=false;}}
}
function stop(){audioDragging.value=false;pendingSeek=-1;mediaBuffering.value=false;restorePlaying=false;mediaGeneration++;if(mediaTimer)clearTimeout(mediaTimer);mediaTimer=null;playing.value=false;audio?.pause();if(lesson.value?.format==='VIDEO')uni.createVideoContext('lessonVideo')?.pause();lastTick=0;}
async function selectLesson(item:LessonSummary){
  if(selecting.value||!alive)return;
  if(!item.accessible){if(needLogin())return;showUnavailable(item.opensAt?'章节开放安排':'课程权限',item.lockedReason??'请选择试听章节，或前往课程详情获得课程权限。');return;}
  const actor=currentUser.value?.id??'',session=sessionGeneration();selecting.value=true;lessonError.value='';retryLessonId=item.id;stop();const version=mediaGeneration;
  const current=()=>alive&&visible&&version===mediaGeneration&&session===sessionGeneration()&&actor===(currentUser.value?.id??'');
  try{
    await flush();if(syncError.value||!current())return;
    audio?.destroy();audio=null;mediaUrl.value='';liveLesson.value=null;mediaFailed.value=false;mediaNotice.value='';recoveries=0;speed.value=1;error.value='';lesson.value=null;selectedId.value='';
    const detail=await request<LessonDetail>('/learning/lessons/'+item.id+contextQuery());if(!current())return;
    const live=detail.format==='LIVE'?await request<LiveLessonState>('/live/lessons/'+item.id):null;if(!current())return;
    const ticket=detail.hasMedia?await request<MediaTicket>('/learning/lessons/'+item.id+'/media'+contextQuery(),{method:'POST'}):null;if(!current())return;
    // Publish the selected lesson only after all of its delivery prerequisites are ready.
    lesson.value=detail;selectedId.value=item.id;liveLesson.value=live;retryLessonId='';checkpointLesson='';checkpointPosition=-1;checkpointCompleted=false;
    const local=owner?localStudy({userId:owner,courseId:id,releaseId:curriculum.value?.releaseId??'',lessonId:item.id,cohortId}):null;
    readingQueued.value=local?.completed??false;position.value=local&&(!detail.progress?.lastEventAt||local.recordedAt>=detail.progress.lastEventAt)?local.positionSeconds:detail.progress?.positionSeconds??0;resume.value=position.value>=detail.durationSeconds?0:position.value;elapsed=0;lastTick=0;lastFlush=Date.now();
    if(ticket)installMedia(ticket,resume.value,false);await flush();
  }catch(e){if(current()){lessonError.value=(e as Error).message;lesson.value=null;selectedId.value='';mediaUrl.value='';}}
  finally{if(version===mediaGeneration)selecting.value=false;}
}
function retryLesson(){const target=curriculum.value?.lessons.find(item=>item.id===retryLessonId);if(target)void selectLesson(target);else void load();}
type MediaTicket={path:string;expiresAt:string};
function scheduleMedia(delay?:number){if(mediaTimer)clearTimeout(mediaTimer);mediaTimer=setTimeout(()=>void renewMedia(),delay??Math.max(1000,mediaExpires-Date.now()-60000));}
function installMedia(ticket:MediaTicket,at:number,autoplay:boolean){
  mediaExpires=Date.parse(ticket.expiresAt);resume.value=at;restorePlaying=autoplay;lastTick=0;playing.value=false;
  if(lesson.value?.format==='AUDIO'){
    const old=audio;audio=null;old?.destroy();const ctx=uni.createInnerAudioContext();audio=ctx;
    ctx.startTime=at;ctx.playbackRate=speed.value;ctx.src=apiBase+ticket.path;
    ctx.onTimeUpdate(()=>{if(audio===ctx)tick(ctx.currentTime);});ctx.onPlay(()=>{if(audio===ctx){playing.value=true;lastTick=Date.now();}});
    ctx.onPause(()=>{if(audio===ctx)pause();});ctx.onEnded(()=>{if(audio===ctx)finish();});ctx.onError(()=>{if(audio===ctx)mediaError();});
    ctx.onCanplay(()=>{if(visible&&alive&&audio===ctx&&restorePlaying){restorePlaying=false;ctx.play();}});
  }
  mediaUrl.value=apiBase+ticket.path;mediaFailed.value=false;mediaNotice.value='';scheduleMedia();
}
function restoreVideo(){if(!visible||!alive)return;const ctx=uni.createVideoContext('lessonVideo');if(resume.value>0)ctx?.seek(resume.value);ctx?.playbackRate(speed.value);if(restorePlaying){restorePlaying=false;ctx?.play();}}
async function renewMedia(){
  if(mediaRenewing.value||selecting.value||!visible||!alive||!lesson.value?.hasMedia)return;
  const version=mediaGeneration,target=selectedId.value,actor=currentUser.value?.id??'';mediaRenewing.value=true;
  try{const ticket=await request<MediaTicket>('/learning/lessons/'+target+'/media'+contextQuery(),{method:'POST'});
    if(version!==mediaGeneration||!visible||!alive||actor!==(currentUser.value?.id??''))return;
    installMedia(ticket,position.value,playing.value||restorePlaying);
  }catch(e){if(version!==mediaGeneration||!visible)return;const status=(e as Error&{status?:number}).status;
    if([401,403,404,409].includes(status??0)){stop();audio?.destroy();audio=null;mediaUrl.value='';mediaFailed.value=true;restorePlaying=false;mediaNotice.value=(e as Error).message;error.value=mediaNotice.value;lesson.value=null;selectedId.value='';}
    else{mediaNotice.value='网络暂时不稳定，将自动重试，已保存的研习记录保留。';mediaFailed.value=true;scheduleMedia(15000);}
  }finally{mediaRenewing.value=false;}
}
function retryMedia(){recoveries=0;void renewMedia();}
function seekMedia(seconds:number){seconds=Math.min(Math.max(0,seconds),lesson.value?.durationSeconds??seconds);position.value=seconds;pendingSeek=seconds;pendingSeekUntil=Date.now()+5000;lastTick=0;if(lesson.value?.format==='AUDIO')audio?.seek(seconds);else uni.createVideoContext('lessonVideo')?.seek(seconds);}

function tick(seconds:number){const now=Date.now();if(pendingSeek>=0){if(Math.abs(seconds-pendingSeek)>1.5&&now<pendingSeekUntil)return;pendingSeek=-1;lastTick=0;}mediaBuffering.value=false;position.value=seconds;if(playing.value&&lastTick>0)elapsed+=Math.min(2,Math.max(0,(now-lastTick)/1000));lastTick=now;if(now-lastFlush>=15000){lastFlush=now;flush();}}
type VideoDetail={currentTime:number};type VideoEvent={detail:VideoDetail};function videoTime(event:VideoEvent){tick(event.detail.currentTime);}
function pause(){playing.value=false;lastTick=0;flush();}function finish(){if(lesson.value)tick(lesson.value.durationSeconds);playing.value=false;lastTick=0;flush();}function mediaError(){mediaBuffering.value=false;restorePlaying=playing.value||restorePlaying;mediaFailed.value=true;playing.value=false;lastTick=0;void flush();mediaNotice.value='播放暂时中断，请检查网络或重新加载。';if(recoveries++<1)void renewMedia();}
function toggleAudio(){if(!audio)return;if(playing.value)audio.pause();else{if(lesson.value&&position.value>=lesson.value.durationSeconds){audio.seek(0);position.value=0;}audio.play();}}
type SeekDetail={value:number};type SeekEvent={detail:SeekDetail};function dragAudio(event:SeekEvent){audioDragging.value=true;audioDrag.value=event.detail.value;}function seekAudio(event:SeekEvent){audioDragging.value=false;seekMedia(event.detail.value);}
function setRate(value:number){speed.value=value;if(lesson.value?.format==='AUDIO'&&audio)audio.playbackRate=value;else uni.createVideoContext('lessonVideo')?.playbackRate(value);}
async function completeReading(){if(needLogin())return;await flush(true);}
function flush(completed=false):Promise<void>{
  if(lesson.value?.format==='LIVE'||!currentUser.value||!selectedId.value||owner!==currentUser.value.id||ownerGeneration!==sessionGeneration())return Promise.resolve();
  const target=selectedId.value,at=Math.max(0,Math.floor(position.value)),seconds=Math.min(30,Math.floor(elapsed));
  if(checkpointLesson===target&&checkpointPosition===at&&seconds===0&&(!completed||checkpointCompleted))return Promise.resolve();
  saving.value=true;
  try{
    recordStudy({userId:owner,courseId:id,releaseId:curriculum.value?.releaseId??'',lessonId:target,cohortId},at,seconds,completed);
    elapsed=Math.max(0,elapsed-seconds);checkpointLesson=target;checkpointPosition=at;checkpointCompleted=completed||checkpointCompleted;if(completed)readingQueued.value=true;syncError.value='';
  }catch(e){syncError.value=(e as Error).message;}
  finally{saving.value=false;}
  return Promise.resolve();
}
function retryStudy(){void flush();void syncStudy(true);}
onLoad(options=>{id=options?.id??'';cohortId=options?.cohortId??'';requestedId=options?.lessonId??'';});onShow(()=>{visible=true;offlineReady.value=false;void checkOffline();const next=currentUser.value?.id??'';if(owner!==next||ownerGeneration!==sessionGeneration()){selecting.value=false;stop();audio?.destroy();audio=null;elapsed=0;checkpointLesson='';checkpointPosition=-1;checkpointCompleted=false;lesson.value=null;curriculum.value=null;selectedId.value='';mediaUrl.value='';syncError.value='';lessonError.value='';retryLessonId='';owner=next;ownerGeneration=sessionGeneration();}if(id)load();if(lesson.value?.hasMedia)scheduleMedia(1000);});onHide(()=>{visible=false;curriculumGeneration++;selecting.value=false;stop();flush();});onUnload(()=>{visible=false;alive=false;curriculumGeneration++;stop();flush();audio?.destroy();});
</script>
<style>@import '../../styles/app.css';.study-content{margin-top:24px;}.live-lesson{border-width:1px;border-style:solid;border-color:#E0D8CA;border-radius:10px;background-color:#FCF9F2;}.live-lesson-title{font-size:20px;line-height:30px;margin-top:12px;}.live-lesson-copy{font-size:14px;line-height:25px;margin-top:12px;}.live-lesson-time{margin-top:8px;}.lesson-video{width:100%;height:210px;margin-top:16px;}.lesson-body{margin-top:20px;}.audio-panel{align-items:center;background-color:#EFE9DC;border-radius:4px;padding:24px 16px;margin-top:16px;}.playback-tools{margin-top:12px;}.rate-button{min-height:44px;background-color:transparent;color:#235663;font-size:13px;line-height:20px;margin:0;padding:10px 12px;border-width:0;}.sync-error{color:#B4533F;font-size:13px;line-height:21px;margin-top:12px;}.lesson-filters{flex-direction:row;flex-wrap:wrap;margin-top:16px;}.lesson-filter{min-height:40px;padding:9px 13px;margin:0 6px 6px 0;border-width:1px;border-style:solid;border-color:#D3C9B8;border-radius:20px;background-color:transparent;color:#6A7578;font-size:13px;line-height:20px;}.lesson-filter-active{background-color:#235663;border-color:#235663;color:#FCF9F2;}.lesson-heading{margin-bottom:12px;}.audio-slider{width:100%;margin-top:16px;}.rate-selected{background-color:#EFE9DC;color:#182B31;border-radius:20px;}.lesson-reading{margin-top:24px;}.lesson-reading-label{font-size:12px;color:#6A7578;line-height:20px;}.lesson-body{margin-top:10px;}.playback-tools{flex-wrap:wrap;}</style>


<style>.primary-button.reading-pending{background-color:#EFE9DC;color:#53615C;}.delivery-notice{padding:16px;background-color:#EFE9DC;border-radius:6px;margin-top:16px;margin-bottom:10px;}</style>

<style>.lesson-navigation{flex-direction:row;flex-wrap:wrap;margin-top:12px;}.lesson-navigation-button{flex:1;min-width:120px;margin:4px;}</style>
