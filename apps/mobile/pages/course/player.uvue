<template>
<view class="page"><PageHead title="课程学习"/><scroll-view :show-scrollbar="false" class="page-scroll" direction="vertical"><view class="content">
<ContentState v-if="loading||error" :loading="loading" :error="error" @retry="load"/>
<view v-if="curriculum">
<text class="detail-title">{{curriculum!.course.title}}</text><text class="meta">{{curriculum!.access==='ENROLLED'?'已加入研习':curriculum!.access==='MEMBER'?'会员可学':'试听目录'}} · {{curriculum!.lessons.length}}讲</text>
<view v-if="lesson" class="study-content">
<text class="section-heading">{{lesson!.title}}</text>
<video v-if="lesson!.format==='VIDEO'&&mediaUrl" id="lessonVideo" class="lesson-video" :src="mediaUrl" :initial-time="resume" :controls="true" @timeupdate="videoTime" @play="playing=true" @pause="pause()" @ended="finish()" @error="mediaError()"/>
<view v-if="lesson!.format==='AUDIO'" class="audio-panel"><AppIcon name="headphones" :size="36"/><text class="body-copy">{{duration(position)}} / {{duration(lesson!.durationSeconds)}}</text><slider :value="position" :max="Math.max(1,lesson!.durationSeconds)" activeColor="#245564" @change="seekAudio"/><button class="primary-button" @click="toggleAudio()">{{playing?'暂停':'播放音频'}}</button></view>
<view v-if="lesson!.format!=='TEXT'" class="row playback-tools"><button v-for="rate in [1,1.25,1.5,2]" :key="rate" class="rate-button" @click="setRate(rate)">{{rate}}×</button><text class="meta">{{speed}}×</text></view>
<text v-if="lesson!.body" class="body-copy lesson-body">{{lesson!.body}}</text>
<button v-if="lesson!.format==='TEXT'" class="primary-button" :disabled="saving||!!lesson!.progress?.completedAt" @click="completeReading()">{{lesson!.progress?.completedAt?'已完成研习':'标记本章已读'}}</button>
<text v-if="syncError" class="sync-error">{{syncError}}</text><button v-if="syncError" class="retry" @click="flush()">重试保存</button>
<text v-if="mediaFailed" class="sync-error">播放失败，请检查网络后重试。</text><button v-if="mediaFailed" class="retry" @click="selectLesson(lesson!)">重新加载媒体</button>
<text class="footer-note">{{currentUser?'进度会同步到学习档案。':'登录后可保存学习进度。'}}</text>
</view>
<view class="section"><text class="section-heading">课程目录</text><LessonRow v-for="item in curriculum!.lessons" :key="item.id" :lesson="item" @select="selectLesson($event)"/><ContentState v-if="!curriculum!.lessons.length" title="等待章节发布" description="书院发布章节后，可在这里开始研习。"/></view>
<button v-if="curriculum!.access==='TRIAL'" class="retry" @click="openPage('course/detail?id='+id)">查看课程与权益</button>
</view></view></scroll-view></view>
</template>
<script setup lang="ts">
import PageHead from '../../components/PageHead.uvue';import AppIcon from '../../components/AppIcon.uvue';import ContentState from '../../components/ContentState.uvue';import LessonRow from '../../components/LessonRow.uvue';import {request,apiBase} from '../../lib/api';import {currentUser,needLogin} from '../../lib/session';import {duration,studyEventId} from '../../lib/learning';import type {Curriculum,LessonSummary,LessonDetail,StudyProgress} from '../../lib/learning';import {openPage,showUnavailable} from '../../lib/presentation';
const curriculum=ref<Curriculum|null>(null),lesson=ref<LessonDetail|null>(null),loading=ref(false),error=ref(''),mediaUrl=ref(''),mediaFailed=ref(false),playing=ref(false),position=ref(0),resume=ref(0),speed=ref(1),saving=ref(false),syncError=ref('');let id='',requestedId='',selectedId='',selecting=false,alive=true,audio:ReturnType<typeof uni.createInnerAudioContext>|null=null,lastTick=0,elapsed=0,lastFlush=0;
type ProgressPayload={eventId:string;positionSeconds:number;elapsedSeconds:number;completed:boolean};type Pending={id:string;data:ProgressPayload};let pending:Pending|null=null,flushing:Promise<void>|null=null;
async function load(){loading.value=true;error.value='';try{const result=await request<Curriculum>('/learning/courses/'+encodeURIComponent(id));if(!alive)return;curriculum.value=result;if(selectedId){const current=result.lessons.find(row=>row.id===selectedId);if(!current?.accessible){stop();audio?.destroy();audio=null;lesson.value=null;selectedId='';mediaUrl.value='';}else if(lesson.value)lesson.value.progress=current.progress;}else if(requestedId){const target=result.lessons.find(row=>row.id===requestedId);requestedId='';if(target)await selectLesson(target);}}catch(e){error.value=(e as Error).message;}finally{loading.value=false;}}
function stop(){playing.value=false;audio?.pause();if(lesson.value?.format==='VIDEO')uni.createVideoContext('lessonVideo')?.pause();lastTick=0;}
async function selectLesson(item:LessonSummary){if(selecting||!alive)return;if(!item.accessible){if(needLogin())return;showUnavailable('课程权限','请选择试听章节，或前往课程详情获得课程权限。');return;}selecting=true;try{stop();await flush();if(pending||!alive)return;audio?.destroy();audio=null;mediaUrl.value='';mediaFailed.value=false;error.value='';lesson.value=null;selectedId='';const detail=await request<LessonDetail>('/learning/lessons/'+item.id);if(!alive)return;lesson.value=detail;selectedId=item.id;position.value=detail.progress?.positionSeconds??0;resume.value=position.value>=detail.durationSeconds?0:position.value;elapsed=0;lastTick=0;lastFlush=Date.now();if(detail.hasMedia){const ticket=await request<{path:string}>('/learning/lessons/'+item.id+'/media',{method:'POST'});if(!alive)return;mediaUrl.value=apiBase+ticket.path;if(detail.format==='AUDIO'){const ctx=uni.createInnerAudioContext();audio=ctx;ctx.src=mediaUrl.value;ctx.startTime=resume.value;ctx.playbackRate=speed.value;ctx.onTimeUpdate(()=>tick(ctx.currentTime));ctx.onPlay(()=>{playing.value=true;lastTick=Date.now();});ctx.onPause(()=>pause());ctx.onEnded(()=>finish());ctx.onError(()=>mediaError());}}await flush();}catch(e){error.value=(e as Error).message;}finally{selecting=false;}}
function tick(seconds:number){position.value=Math.floor(seconds);const now=Date.now();if(playing.value&&lastTick>0)elapsed+=Math.min(2,Math.max(0,(now-lastTick)/1000));lastTick=now;if(now-lastFlush>=15000){lastFlush=now;flush();}}
type VideoDetail={currentTime:number};type VideoEvent={detail:VideoDetail};function videoTime(event:VideoEvent){tick(event.detail.currentTime);}
function pause(){playing.value=false;lastTick=0;flush();}function finish(){if(lesson.value)tick(lesson.value.durationSeconds);playing.value=false;lastTick=0;flush();}function mediaError(){mediaFailed.value=true;playing.value=false;}
function toggleAudio(){if(!audio)return;if(playing.value)audio.pause();else{if(lesson.value&&position.value>=lesson.value.durationSeconds){audio.seek(0);position.value=0;}audio.play();}}
type SeekDetail={value:number};type SeekEvent={detail:SeekDetail};function seekAudio(event:SeekEvent){audio?.seek(event.detail.value);position.value=Math.floor(event.detail.value);}
function setRate(value:number){speed.value=value;if(lesson.value?.format==='AUDIO'&&audio)audio.playbackRate=value;else uni.createVideoContext('lessonVideo')?.playbackRate(value);}
async function completeReading(){if(needLogin())return;await flush(true);}
function flush(completed=false):Promise<void>{if(flushing)return completed?flushing.then(()=>flush(true)):flushing;if(completed&&pending&&!pending.data.completed)return flush().then(()=>{if(!pending)return flush(true);});flushing=saveProgress(completed).finally(()=>{flushing=null;});return flushing;}
async function saveProgress(completed:boolean){if(!currentUser.value||!selectedId)return;pending??={id:selectedId,data:{eventId:studyEventId(),positionSeconds:position.value,elapsedSeconds:Math.min(30,Math.round(elapsed)),completed}};saving.value=true;try{const saved=await request<StudyProgress>('/learning/lessons/'+pending.id+'/progress',{method:'POST',data:pending.data});elapsed=Math.max(0,elapsed-pending.data.elapsedSeconds);const savedId=pending.id;pending=null;syncError.value='';if(lesson.value?.id===savedId)lesson.value.progress=saved;const row=curriculum.value?.lessons.find(item=>item.id===savedId);if(row)row.progress=saved;}catch(e){syncError.value=(e as Error).message;}finally{saving.value=false;}}
onLoad(options=>{id=options?.id??'';requestedId=options?.lessonId??'';});onShow(()=>{if(id)load();});onHide(()=>{stop();flush();});onUnload(()=>{alive=false;stop();flush();audio?.destroy();});
</script>
<style>@import '../../styles/app.css';.study-content{margin-top:24px;}.lesson-video{width:100%;height:210px;margin-top:16px;}.lesson-body{margin-top:20px;}.audio-panel{align-items:center;background-color:#EEE9DF;border-radius:4px;padding:24px 16px;margin-top:16px;}.playback-tools{margin-top:12px;}.rate-button{min-height:44px;background-color:transparent;color:#245564;font-size:13px;line-height:20px;margin:0;padding:10px 12px;border-width:0;}.sync-error{color:#B95543;font-size:13px;line-height:21px;margin-top:12px;}</style>

