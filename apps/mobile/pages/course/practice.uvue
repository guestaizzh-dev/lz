<template>
  <view class="page"
    ><InkBackdrop /><PageHead title="研习作业" /><scroll-view
      class="page-scroll"
      direction="vertical"
      :show-scrollbar="false"
      ><view class="content">
        <ContentState
          v-if="loading || error"
          :loading="loading"
          :error="error"
          :error-title="
            error.indexOf('登录') >= 0
              ? '请先登录'
              : error.indexOf('权限') >= 0
                ? '无权查看本期作业'
                : '作业未能加载'
          "
          :retryable="error.indexOf('登录') < 0 && error.indexOf('权限') < 0"
          :action-label="error.indexOf('权限') >= 0 ? '返回学习档案' : ''"
          @action="openPage('course/library')"
          @retry="load"
        />
        <view v-if="result">
          <text v-if="result!.cohort" class="ui-text meta"
            >本期研习 · {{ result!.cohort!.title }}</text
          ><text v-if="result!.canParticipate === false" class="ui-text footer-note"
            >本期尚未开放或已结束，可回看已提交的研习记录与点评。</text
          ><button
            class="ui-button practice-back"
            @click="
              openPage('course/checkin?id=' + courseId + (cohortId ? '&cohortId=' + cohortId : ''))
            "
            >研习打卡 ›</button
          ><text class="ui-text body-copy practice-intro" :user-select="true"
            >把研习所得写下来，让老师与你一起推敲。</text
          >
          <text class="ui-text practice-stats"
            >已提交 {{ result!.summary.submitted }} / {{ result!.summary.total }} · 已完成
            {{ result!.summary.reviewed }} · 必修完成 {{ result!.summary.requiredReviewed }} /
            {{ result!.summary.required }}</text
          >
          <ContentState
            v-if="!result!.items.length"
            title="尚未布置研习作业"
            description="老师发布后，作业要求会在这里展示。"
            action-label="返回学习档案"
            @action="openPage('course/library')"
          />
          <view
            v-if="!selected"
            v-for="item in result!.items"
            :key="item.id"
            class="assignment-row"
            @click="select(item)"
            ><view class="row between"
              ><text class="ui-text item-title grow assignment-row-item-title">{{
                item.title
              }}</text
              ><text class="ui-text tag assignment-row-tag">{{
                item.required ? '必修' : '选修'
              }}</text></view
            ><text class="ui-text meta assignment-row-meta"
              >{{
                item.submission ? teachingState(item.submission.state) : teachingState(item.state)
              }}{{ item.dueAt ? ' · 截止 ' + date(item.dueAt) : '' }}</text
            ></view
          >
          <view v-if="selected" class="practice-editor">
            <button
              class="ui-button practice-back"
              :disabled="saving || uploading || pending !== null"
              @click="backToList"
              >‹ 返回作业列表</button
            ><text class="ui-text section-heading">{{ selected!.title }}</text
            ><text class="ui-text body-copy" :user-select="true">{{
              selected!.instructions.text
            }}</text>
            <text v-if="detail" class="ui-text meta"
              >第 {{ detail!.revision }} 次提交 · {{ teachingState(detail!.state) }}</text
            ><text v-if="detail" class="ui-text body-copy" :user-select="true">{{
              detail!.body
            }}</text>
            <view class="image-strip"
              ><image
                v-for="src in attachedImages"
                :key="src"
                :src="src"
                mode="aspectFill"
                class="homework-image"
                @click="preview(src, attachedImages)"
            /></view>
            <view v-for="review in detail?.reviews ?? []" :key="review.id" class="review-note"
              ><text class="ui-text tag review-note-tag"
                >老师点评 · {{ teachingState(review.state)
                }}{{ review.score == null ? '' : ' · ' + review.score + '分' }}</text
              ><text class="ui-text body-copy" :user-select="true">{{ review.body }}</text
              ><text class="ui-text meta">{{ date(review.reviewedAt) }}</text></view
            >
            <view
              v-if="
                selected!.state === 'PUBLISHED' &&
                selected!.canSubmit !== false &&
                (!selected!.submission || selected!.submission!.state === 'RETURNED')
              "
            >
              <textarea
                class="ui-input homework-input"
                aria-label="研习作业内容"
                v-model="body"
                :disabled="saving || pending !== null"
                maxlength="10000"
                placeholder="写下你的理解、体会与实践…"
              />
              <view class="image-strip"
                ><view v-for="(image, index) in images" :key="image.id"
                  ><image
                    :src="image.path"
                    mode="aspectFill"
                    class="homework-image"
                    @click="
                      preview(
                        image.path,
                        images.map((i) => i.path),
                      )
                    "
                  /><text
                    v-if="!pending && !saving"
                    class="ui-text image-remove"
                    @click="images.splice(index, 1)"
                    >移除</text
                  ></view
                ></view
              >
              <button
                class="ui-button secondary-button"
                :disabled="uploading || saving || pending !== null || images.length >= 6"
                @click="chooseImages"
                >{{ uploading ? '图片上传中…' : '添加研习图片（最多6张）' }}</button
              >
              <button
                class="ui-button primary-button"
                :disabled="saving || uploading"
                @click="submit"
                >{{
                  saving
                    ? '正在提交…'
                    : pending
                      ? '重试本次提交'
                      : selected!.submission
                        ? '补充后重新提交'
                        : '提交研习作业'
                }}</button
              >
              <text v-if="pending && !saving" class="ui-text practice-hint"
                >本次内容已保留，重试会核实同一次提交。确认结果后可继续编辑。</text
              >
            </view>
            <text v-else class="ui-text footer-note">{{
              selected!.canSubmit === false
                ? '提交已截止或本期已结束，可回看提交与点评。'
                : selected!.state === 'CLOSED'
                  ? '作业已关闭，可继续回看提交与点评。'
                  : '老师点评后，如需补充可再次提交。'
            }}</text>
            <text v-if="feedback" class="ui-text feedback-note">{{ feedback }}</text>
          </view>
        </view></view
      ></scroll-view
    ></view
  >
</template>
<script setup lang="ts">
import InkBackdrop from '../../components/InkBackdrop.uvue';
import { formatChinaTime } from '../../lib/date-time';
import PageHead from '../../components/PageHead.uvue';
import ContentState from '../../components/ContentState.uvue';
import { openPage } from '../../lib/presentation';
import { request, apiBase } from '../../lib/api';
import { currentUser, needLogin } from '../../lib/session';
import { studyEventId } from '../../lib/learning';
import { uploadHomeworkImage, teachingState } from '../../lib/teaching';
import type { Assignment, AssignmentList, Submission } from '../../lib/teaching';
const loading = ref(false),
  error = ref(''),
  result = ref<AssignmentList | null>(null),
  selected = ref<Assignment | null>(null),
  detail = ref<Submission | null>(null),
  body = ref(''),
  saving = ref(false),
  uploading = ref(false),
  feedback = ref('');
const images = ref<{ id: string; path: string }[]>([]),
  attachedImages = ref<string[]>([]),
  pending = ref<{
    assignmentId: string;
    requestKey: string;
    expectedRevision: number;
    body: string;
    assetIds: string[];
  } | null>(null);
let courseId = '',
  cohortId = '',
  selection = 0,
  owner = '';
const drafts = new Map<string, { body: string; images: { id: string; path: string }[] }>();
const contextQuery = () => (cohortId ? '?cohortId=' + cohortId : '');
const date = (v: string) => formatChinaTime(v);
async function load() {
  if (owner !== (currentUser.value?.id ?? '')) {
    owner = currentUser.value?.id ?? '';
    result.value = null;
    selected.value = null;
    detail.value = null;
    body.value = '';
    images.value = [];
    pending.value = null;
    drafts.clear();
  }
  if (
    !courseId ||
    needLogin('/pages/course/practice?id=' + courseId + (cohortId ? '&cohortId=' + cohortId : ''))
  )
    return;
  loading.value = true;
  error.value = '';
  try {
    result.value = await request<AssignmentList>(
      '/learning/courses/' + courseId + '/assignments' + contextQuery(),
    );
    if (selected.value) {
      const item = result.value.items.find((r) => r.id === selected.value?.id);
      if (item) await select(item, true);
      else selected.value = null;
    }
  } catch (e) {
    error.value = (e as Error).message;
  } finally {
    loading.value = false;
  }
}
async function select(item: Assignment, refresh = false) {
  if ((saving.value || uploading.value || pending.value) && !refresh) return;
  const generation = ++selection;
  selected.value = item;
  detail.value = null;
  attachedImages.value = [];
  if (!refresh) {
    const draft = drafts.get(item.id);
    body.value = draft?.body ?? '';
    images.value = draft?.images ?? [];
    feedback.value = '';
  }
  if (item.submission) {
    try {
      const row = await request<Submission>('/learning/submissions/' + item.submission.id);
      if (generation !== selection) return;
      detail.value = row;
      const urls = await Promise.all(
        row.attachments.map(
          async (a) =>
            apiBase +
            (
              await request<{ path: string }>(
                '/learning/submissions/' + row.id + '/images/' + a.assetId,
                { method: 'POST' },
              )
            ).path,
        ),
      );
      if (generation === selection) attachedImages.value = urls;
    } catch (e) {
      if (generation === selection) feedback.value = (e as Error).message;
    }
  }
}
function backToList() {
  if (!selected.value || saving.value || uploading.value || pending.value) return;
  drafts.set(selected.value.id, { body: body.value, images: [...images.value] });
  ++selection;
  selected.value = null;
  detail.value = null;
  attachedImages.value = [];
}
function preview(src: string, urls: string[]) {
  uni.previewImage({ current: src, urls });
}
function chooseImages() {
  if (uploading.value || saving.value || pending.value) return;
  uni.chooseImage({
    count: 6 - images.value.length,
    sizeType: ['compressed'],
    success: async (result) => {
      uploading.value = true;
      feedback.value = '';
      try {
        for (const path of result.tempFilePaths) {
          const asset = await uploadHomeworkImage(path);
          images.value.push({ id: asset.id, path });
        }
      } catch (e) {
        feedback.value = (e as Error).message;
      } finally {
        uploading.value = false;
      }
    },
  });
}
async function submit() {
  if (saving.value || uploading.value || !selected.value) return;
  if (!pending.value && !body.value.trim()) {
    feedback.value = '写下研习所得再提交吧';
    return;
  }
  pending.value ??= {
    assignmentId: selected.value.id,
    requestKey: studyEventId(),
    expectedRevision: selected.value.submission?.revision ?? 0,
    body: body.value.trim(),
    assetIds: images.value.map((r) => r.id),
  };
  const snapshot = pending.value;
  saving.value = true;
  feedback.value = '';
  try {
    const { assignmentId, ...data } = snapshot;
    await request('/learning/assignments/' + assignmentId + '/submissions' + contextQuery(), {
      method: 'POST',
      data,
    });
    drafts.delete(snapshot.assignmentId);
    pending.value = null;
    body.value = '';
    images.value = [];
    feedback.value = '作业已提交，等待老师点评。';
    await load();
  } catch (e) {
    feedback.value = (e as Error).message;
    const status = (e as Error & { status?: number }).status;
    if (status && status >= 400 && status < 500) {
      pending.value = null;
      if (status === 409) await load();
    }
  } finally {
    saving.value = false;
  }
}
onLoad((options) => {
  courseId = options?.id ?? '';
  cohortId = options?.cohortId ?? '';
});
onShow(() => {
  if (!uploading.value && !saving.value && !pending.value) load();
});
</script>
<style>
@import '../../styles/app.css';
/* 研习作业：页首 16、行 15/15 弱线、编辑区 24 起，评论块淡洗底。 */
.content {
  padding-top: 16px;
  padding-bottom: 40px;
}
.practice-intro {
  font-family: sans-serif;
  font-size: 13px;
  line-height: 22px;
  color: #5c6869;
  margin: 12px 0 0;
}
.practice-stats {
  font-family: sans-serif;
  font-size: 12px;
  line-height: 20px;
  color: #5c6869;
  margin-top: 12px;
}
.practice-hint {
  font-family: sans-serif;
  font-size: 12px;
  line-height: 20px;
  color: #6f6a5f;
  margin-top: 12px;
}
.assignment-row {
  padding: 15px 0;
  border-bottom-width: 1px;
  border-bottom-style: solid;
  border-bottom-color: #e0d8c8;
}
.assignment-row-item-title {
  font-size: 16px;
  line-height: 24px;
  max-height: 48px;
  overflow: hidden;
}
.assignment-row-tag {
  font-family: sans-serif;
  font-size: 11px;
  line-height: 17px;
  color: #235663;
}
.assignment-row-meta {
  font-family: sans-serif;
  font-size: 12px;
  line-height: 20px;
  color: #5c6869;
  margin-top: 4px;
}
.practice-back {
  align-self: flex-start;
  min-height: 44px;
  margin: 0 0 12px;
  padding: 11px 0;
  color: #235663;
  background-color: transparent;
  border-width: 0;
  font-family: sans-serif;
  font-size: 13px;
  line-height: 22px;
}
.practice-editor {
  margin-top: 24px;
  padding-bottom: 32px;
}
.homework-input {
  width: 100%;
  height: 180px;
  margin-top: 16px;
  background-color: #fcf9f2;
  border-width: 1px;
  border-style: solid;
  border-color: #cfc5b1;
  border-radius: 10px;
  padding: 12px;
  font-family: sans-serif;
  font-size: 15px;
  line-height: 26px;
  color: #182b31;
}
.image-strip {
  flex-direction: row;
  flex-wrap: wrap;
  margin-top: 12px;
}
.homework-image {
  width: 88px;
  height: 88px;
  border-radius: 10px;
  margin-right: 8px;
  margin-bottom: 8px;
}
.image-remove {
  font-family: sans-serif;
  font-size: 12px;
  line-height: 20px;
  color: #5c6869;
  padding: 11px 0;
  min-height: 44px;
}
.review-note {
  padding: 16px;
  background-color: #f0eadd;
  border-radius: 10px;
  margin-top: 16px;
  border-left-width: 2px;
  border-left-style: solid;
  border-left-color: #235663;
}
.review-note-tag {
  font-family: sans-serif;
  font-size: 11px;
  line-height: 17px;
  color: #8a6635;
}
.feedback-note {
  font-family: sans-serif;
  color: #b4533f;
  font-size: 13px;
  line-height: 22px;
  margin-top: 12px;
}
</style>
