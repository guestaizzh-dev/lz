<template>
  <view class="page"
    ><InkBackdrop /><PageHead :title="order ? '购课订单' : '确认课程'" /><scroll-view
      class="page-scroll"
      direction="vertical"
      :show-scrollbar="false"
      ><view class="content purchase-content">
        <ContentState
          v-if="loading || error"
          :loading="loading"
          :error="error"
          :error-title="
            error.indexOf('登录') >= 0
              ? '请先登录'
              : error.indexOf('权限') >= 0 || error.indexOf('加入') >= 0
                ? '无权限查看此课程'
                : '购课信息未能加载'
          "
          :retryable="
            error.indexOf('登录') < 0 && error.indexOf('权限') < 0 && error.indexOf('加入') < 0
          "
          @retry="load"
        />
        <view v-if="purchase && !loading && !error">
          <view v-if="quote?.charity" class="purchase-notice"
            ><text class="ui-text purchase-notice-text"
              >公益优惠：{{ quote!.charity!.title }}。</text
            ><button
              v-if="Number(quote!.price) === 0"
              class="ui-button purchase-text-button"
              @click="openPage('marketing/charity?tab=mine')"
              >确认免费公益领取 ›</button
            ></view
          ><view class="purchase-heading"
            ><text class="ui-text purchase-eyebrow">老子道学书院 · 研习课程</text
            ><text class="ui-text purchase-title">{{ purchase!.title }}</text
            ><text class="ui-text purchase-teacher">{{ purchase!.teacherName }} 主讲</text></view
          >
          <view class="purchase-course"
            ><ArtImage :src="purchase!.cover" kind="study" :width="90" :height="112" /><view
              class="purchase-course-copy"
              ><text class="ui-text purchase-format">{{ purchaseFormats }}</text
              ><text class="ui-text purchase-summary"
                >共 {{ purchase!.lessons }} 讲 · 约
                {{ Math.ceil(purchase!.durationSeconds / 60) }} 分钟</text
              ><button
                v-if="!order"
                class="ui-button purchase-text-button"
                @click="openPage('course/player?id=' + purchase!.courseId)"
                >返回试听与目录 ›</button
              ></view
            ></view
          >
          <view v-if="order" class="purchase-status"
            ><text class="ui-text purchase-status-title">{{ statusTitle }}</text
            ><text class="ui-text purchase-status-copy">{{ statusCopy }}</text
            ><text v-if="payBlockedReason" class="ui-text purchase-status-copy">{{
              payBlockedReason
            }}</text
            ><button
              v-if="order!.state === 'PENDING'"
              class="ui-button purchase-text-button"
              :disabled="busy"
              @click="refreshOrder"
              >查询支付结果 ›</button
            ></view
          >
          <view
            v-if="order?.deliveryBlocked && Number(order!.refundedAmount) === 0"
            class="purchase-notice"
            ><text class="ui-text purchase-notice-text"
              >课程暂时无法继续学习：{{
                order!.deliveryReason
              }}。订单和学习记录保留，您可以联系书院或在下方申请退课。</text
            ><button class="ui-button purchase-text-button" @click="openPage('profile/feedback')"
              >联系书院 ›</button
            ></view
          >
          <view v-if="order?.memberBenefit || quote?.memberBenefit" class="purchase-notice"
            ><text class="ui-text purchase-notice-text"
              >会员购课优惠：按原价
              {{ (order?.memberBenefit ?? quote?.memberBenefit)!.basisPoints / 100 }}% 计费，立减
              ¥{{ money(Number((order?.memberBenefit ?? quote?.memberBenefit)!.savings)) }}。</text
            ></view
          ><view
            v-if="quote?.window?.phase !== 'PUBLIC' && quote?.window?.publicOpenAt"
            class="purchase-notice"
            ><text class="ui-text purchase-notice-text"
              >公开开放：{{
                formatChinaTime(quote!.window!.publicOpenAt)
              }}（北京）。提前研习请从课程目录按已有权益进入，公开前不收取独立购课费用。</text
            ></view
          ><view class="purchase-section"
            ><text class="ui-text purchase-section-title">课程与交付</text
            ><view class="purchase-row"
              ><text class="ui-text purchase-label">学习期限</text
              ><text class="ui-text purchase-strong">{{
                purchase!.accessDays ? '支付确认后 ' + purchase!.accessDays + ' 天' : '长期有效'
              }}</text></view
            ></view
          >
          <view v-if="purchase!.liveSessions?.length" class="purchase-section"
            ><text class="ui-text purchase-section-title">直播安排</text
            ><view v-for="item in purchase!.liveSessions" :key="item.id" class="purchase-row"
              ><text class="ui-text purchase-label">{{ item.title }}</text
              ><text class="ui-text purchase-value"
                >{{ formatChinaTime(item.scheduledAt) }}（北京）</text
              ></view
            ><text class="ui-text purchase-explanation"
              >按课程权限进入直播和观看已开放的回放。时间调整会发送通知；必修直播取消，请联系书院或从订单申请退课。</text
            ></view
          >
          <view
            v-if="!order && quote?.groupOptions?.length && platform === 'ANDROID'"
            class="purchase-section"
            ><text class="ui-text purchase-section-title">购买方式</text
            ><text class="ui-text purchase-explanation"
              >2人拼团，开团后最多24小时；成团前仅可试听，失败自动原路退款。拼团不叠加优惠券。</text
            ><button
              class="ui-button purchase-text-button"
              :disabled="loading || busy"
              @click="chooseGroup('')"
              >{{ !groupOfferId && !groupId ? '✓ ' : '' }}单独购买</button
            ><button
              v-for="option in quote!.groupOptions ?? []"
              :key="option.id"
              class="ui-button purchase-text-button"
              :disabled="loading || busy"
              @click="chooseGroup(option.id)"
              >{{ groupOfferId === option.id ? '✓ ' : '' }}{{ option.title }} · ¥{{
                money(Number(option.price))
              }}</button
            ></view
          ><view v-if="order?.group" class="purchase-section"
            ><text class="ui-text purchase-section-title">{{
              order!.group!.state === 'SUCCEEDED'
                ? '拼团已成功'
                : order!.group!.state === 'FAILED'
                  ? '拼团未成功'
                  : '等待共学成团'
            }}</text
            ><text class="ui-text purchase-explanation"
              >已付款 {{ order!.group!.paidMembers }} / {{ order!.group!.requiredMembers }} 人 ·
              {{ formatChinaTime(order!.group!.expiresAt) }} 截止</text
            ><button
              class="ui-button purchase-text-button"
              @click="openPage('marketing/group?id=' + order!.group!.id)"
              >查看拼团与邀请 ›</button
            ></view
          ><view class="purchase-section"
            ><text class="ui-text purchase-section-title">费用明细</text
            ><view class="purchase-row"
              ><text class="ui-text purchase-label">课程单价</text
              ><text class="ui-text purchase-amount"
                >¥{{
                  money(Number(order?.originalPrice ?? quote?.originalPrice ?? quote?.price ?? '0'))
                }}</text
              ></view
            ><view v-if="baseDiscount > 0" class="purchase-row"
              ><text class="ui-text purchase-label">{{
                order?.group
                  ? '拼团优惠'
                  : quote?.group
                    ? '拼团优惠'
                    : order?.memberBenefit || quote?.memberBenefit
                      ? '会员购课优惠'
                      : order?.charity || quote?.charity
                        ? '公益优惠'
                        : (order?.coupon?.terms.title ?? quote?.coupon?.terms.title ?? '优惠券')
              }}</text
              ><text class="ui-text purchase-discount">−¥{{ money(baseDiscount) }}</text></view
            ><view
              v-if="(order?.voucher?.discount ?? quote?.voucher?.discount ?? 0) > 0"
              class="purchase-row"
              ><text class="ui-text purchase-label">视频代金券抵扣</text
              ><text class="ui-text purchase-discount"
                >−¥{{ money(order?.voucher?.discount ?? quote?.voucher?.discount ?? 0) }}</text
              ></view
            ><button
              v-if="!order"
              class="ui-button purchase-text-button"
              @click="openPage('marketing/coupons')"
              >领取课程优惠券 ›</button
            ><view class="purchase-row"
              ><text class="ui-text purchase-label">支付方式</text
              ><text class="ui-text purchase-value">{{
                platform === 'IOS'
                  ? 'App Store 内购（待开放）'
                  : order
                    ? paymentChannelLabel(order!.channel)
                    : platform === 'ANDROID'
                      ? paymentChannelLabel(selectedChannel)
                      : 'Android App 内支付'
              }}</text></view
            ><view v-if="!order && platform === 'ANDROID'" class="purchase-channels"
              ><button
                class="ui-button"
                v-for="choice in availableChannels"
                :key="choice.channel"
                :class="[
                  'purchase-channel',
                  selectedChannel === choice.channel ? 'purchase-channel-active' : '',
                ]"
                :disabled="busy"
                @click="chooseChannel(choice.channel)"
                >{{ choice.label }}</button
              ></view
            ><view class="purchase-total"
              ><text class="ui-text purchase-total-label">{{
                order?.paidAt ? '实付金额' : '应付金额'
              }}</text
              ><text class="ui-text purchase-total-amount">¥{{ price }}</text></view
            ></view
          >
          <view v-if="!order && quote?.couponOptions?.length" class="purchase-section">
            <view class="purchase-row"
              ><text class="ui-text purchase-section-title">优惠券</text>
              <button class="ui-button purchase-text-button" @click="chooseCoupon"
                >{{
                  quote!.coupon?.terms.title ?? (couponId === 'NONE' ? '不使用' : '自动选优惠')
                }}
                ›</button
              >
            </view>
          </view>
          <view
            v-if="!order && quote?.voucher && (quote!.voucher!.maximum > 0 || voucherQuantity > 0)"
            class="purchase-section"
            ><text class="ui-text purchase-section-title">视频代金券</text
            ><text class="ui-text purchase-explanation"
              >可用 {{ quote!.voucher!.available }} 份，本单最多使用
              {{ quote!.voucher!.maximum }} 份。</text
            ><view class="purchase-row"
              ><text class="ui-text purchase-label">{{
                voucherQuantity ? '抵扣 ¥' + money(quote!.voucher!.discount) : '暂不使用'
              }}</text
              ><button
                class="ui-button purchase-text-button"
                :disabled="busy || loading"
                @click="useVouchers(voucherQuantity ? 0 : quote!.voucher!.maximum)"
                >{{ voucherQuantity ? '不使用' : '使用代金券' }}</button
              ></view
            ><view v-if="voucherQuantity" class="purchase-row"
              ><text class="ui-text purchase-label">使用份数</text
              ><QuantityStepper
                :value="voucherQuantity"
                :min="0"
                :max="quote!.voucher!.maximum"
                :disabled="busy || loading"
                @change="useVouchers(voucherQuantity + $event)" /></view
          ></view>
          <view v-if="order?.voucher?.quantity" class="purchase-section"
            ><text class="ui-text purchase-section-title">代金券抵扣</text
            ><text class="ui-text purchase-explanation"
              >{{ order!.voucher!.quantity }}份 · 抵扣 ¥{{ money(order!.voucher!.discount)
              }}{{ order!.voucherReturned ? ' · 已退回原来源' : '' }}</text
            ></view
          >
          <view class="purchase-section"
            ><text class="ui-text purchase-section-title">退课说明</text
            ><text class="ui-text purchase-policy" :user-select="true">{{
              purchase!.refundPolicy
            }}</text
            ><text class="ui-text purchase-explanation" :user-select="true"
              >默认可在付款后 7
              日内、尚未打开付费章节时申请退课。退款须经审核并由支付渠道确认，完成后撤销对应购课权限；其他问题可联系书院客服。</text
            ><button
              class="ui-button purchase-text-button"
              aria-label="复制完整课程购买说明"
              @click="copyRules"
              >复制购买与退课说明 ›</button
            ></view
          >
          <ConsumptionReward
            :order-id="order?.id"
            :revision="order"
            :eligible="Number(order?.amount ?? quote?.price ?? 0) > 0"
          /><view v-if="!order" class="purchase-consent" @click="agreed = !agreed"
            ><view :class="['purchase-checkbox', agreed ? 'purchase-checkbox-active' : '']"
              ><text v-if="agreed" class="ui-text purchase-checkmark">✓</text></view
            ><text class="ui-text purchase-consent-copy">已阅读并理解学习期限和退课规则</text></view
          >
          <view v-if="quote && !paymentReady && !order" class="purchase-notice"
            ><text class="ui-text purchase-notice-text">{{ unavailableReason }}</text></view
          >
          <view v-if="notice" class="purchase-notice"
            ><text class="ui-text purchase-notice-text">{{ notice }}</text
            ><button
              v-if="!order"
              class="ui-button purchase-text-button"
              :disabled="busy"
              @click="refreshQuote"
              >刷新购买信息 ›</button
            ></view
          >
          <view v-if="order" class="purchase-section"
            ><text class="ui-text purchase-section-title">订单信息</text
            ><view class="purchase-row" @click="copyNumber"
              ><text class="ui-text purchase-label">订单编号</text
              ><view class="purchase-number"
                ><text class="ui-text purchase-number-text">{{ order!.orderNo }}</text
                ><text class="ui-text purchase-copy">复制</text></view
              ></view
            ><view class="purchase-row"
              ><text class="ui-text purchase-label">创建时间</text
              ><text class="ui-text purchase-value">{{ date(order!.createdAt) }}</text></view
            ><view v-if="order!.paidAt" class="purchase-row"
              ><text class="ui-text purchase-label">支付时间</text
              ><text class="ui-text purchase-value">{{ date(order!.paidAt!) }}</text></view
            ><button
              v-if="order!.canRefund"
              class="ui-button purchase-text-button"
              :disabled="busy"
              @click="showRefund = true"
              >{{ Number(order!.amount) === 0 ? '申请退课退券 ›' : '申请退课退款 ›' }}</button
            ><text
              v-else-if="order!.refundUnavailableReason"
              class="ui-text purchase-explanation"
              >{{ order!.refundUnavailableReason }}</text
            ></view
          >
          <view v-for="refund in order?.refunds ?? []" :key="refund.id" class="purchase-section"
            ><view class="purchase-row"
              ><text class="ui-text purchase-section-title">{{
                refund.automatic ? '异常收款处理' : '退课进度'
              }}</text
              ><text class="ui-text purchase-value">{{ refundLabel(refund.state) }}</text></view
            ><text class="ui-text purchase-policy">{{ refund.reason }}</text
            ><text v-if="refund.reviewNote" class="ui-text purchase-explanation"
              >书院回复：{{ refund.reviewNote }}</text
            ><text class="ui-text purchase-explanation"
              >{{
                refund.state === 'SUCCEEDED'
                  ? '已原路退回'
                  : refund.state === 'REVERSED'
                    ? '原退款已撤回'
                    : '申请退款'
              }}
              ¥{{ money(Number(refund.amount)) }} · {{ date(refund.createdAt) }}</text
            ><button
              v-if="refund.state === 'REFUNDING'"
              class="ui-button purchase-text-button"
              :disabled="busy"
              @click="refreshOrder"
              >查询退款进度 ›</button
            ></view
          >
          <view class="purchase-links"
            ><button class="ui-button purchase-text-button" @click="openPage('course/orders')"
              >全部购课订单 ›</button
            ><button class="ui-button purchase-text-button" @click="openPage('profile/feedback')"
              >联系书院客服 ›</button
            ></view
          >
        </view></view
      ></scroll-view
    >
    <BottomBar v-if="purchase && !loading && !error"
      ><text v-if="!busy && !action.enabled" class="bar-hint">{{
        !paymentReady
          ? unavailableReason
          : !agreed
            ? '阅读并勾选下方课程购买说明后即可付款'
            : '当前订单暂不可付款，可先查询支付结果'
      }}</text
      ><view v-if="!order || order!.state === 'PENDING'" class="purchase-bar-copy"
        ><text class="ui-text purchase-bar-price">¥{{ price }}</text
        ><text class="ui-text purchase-bar-label">{{
          order ? remainingLabel : '一次购买'
        }}</text></view
      ><button
        v-if="order?.state === 'PENDING'"
        class="ui-button bar-secondary"
        :disabled="busy"
        @click="cancelOrder"
        >取消订单</button
      ><button
        class="ui-button bar-primary"
        :disabled="busy || !action.enabled"
        @click="primaryAction"
        >{{ busy ? '正在处理…' : action.label }}</button
      ></BottomBar
    >
    <ComposeSheet
      :visible="showRefund"
      title="申请退课"
      subtitle="写明退课原因，书院审核后原路办理退款"
      v-model="refundReason"
      :maxlength="1000"
      :saving="busy"
      :disabled="refundReason.trim().length < 2"
      :error="refundError"
      submitLabel="提交申请"
      @close="showRefund = false"
      @submit="submitRefund"
    />
  </view>
</template>
<script setup lang="ts">
import InkBackdrop from '../../components/InkBackdrop.uvue';
import { openNativePayment } from '../../lib/native-payment';
import QuantityStepper from '../../components/QuantityStepper.uvue';
import ConsumptionReward from '../../components/ConsumptionReward.uvue';
import { lessonType } from '../../lib/learning';
import { formatChinaTime } from '../../lib/date-time';
import PageHead from '../../components/PageHead.uvue';
import BottomBar from '../../components/BottomBar.uvue';
import ContentState from '../../components/ContentState.uvue';
import ArtImage from '../../components/ArtImage.uvue';
import ComposeSheet from '../../components/ComposeSheet.uvue';
import { courseWechatAppId, courseAlipayAppId } from '../../lib/payment-config';
import { request, money } from '../../lib/api';
import { openPage } from '../../lib/presentation';
import { currentUser, needLogin } from '../../lib/session';
import { studyEventId } from '../../lib/learning';
import {
  purchasePlatform,
  orderLabel,
  refundLabel,
  paymentChannelLabel,
  coursePurchaseAction,
} from '../../lib/course-sales';
import type { CourseQuote, CourseOrder } from '../../lib/course-sales';
const platform = purchasePlatform(),
  quote = ref<CourseQuote | null>(null),
  order = ref<CourseOrder | null>(null),
  loading = ref(false),
  error = ref(''),
  notice = ref(''),
  agreed = ref(false),
  busy = ref(false),
  showRefund = ref(false),
  refundReason = ref(''),
  refundError = ref(''),
  clock = ref(Date.now()),
  selectedChannel = ref('WECHAT_NATIVE'),
  couponId = ref(''),
  voucherQuantity = ref(0),
  groupOfferId = ref(''),
  groupId = ref('');
let courseId = '',
  orderId = '',
  owner = '',
  requestKey = studyEventId(),
  refundKey = studyEventId(),
  timer: ReturnType<typeof setInterval> | null = null;
const purchaseFormats = computed(
  () =>
    (purchase.value?.contentFormats ?? [purchase.value?.format ?? '']).map(lessonType).join(' · ') +
    '研习',
);
function clientSupports(channel: string) {
  return (
    platform === 'ANDROID' &&
    (channel === 'WECHAT_NATIVE'
      ? true
      : channel === 'WECHAT_APP'
        ? !!courseWechatAppId
        : channel === 'ALIPAY_APP'
          ? !!courseAlipayAppId
          : false)
  );
}
const availableChannels = computed(() =>
  (quote.value?.channels ?? []).filter((c) => c.enabled && clientSupports(c.channel)),
);
const paymentReady = computed(
    () =>
      !!quote.value?.canRedeem ||
      (!!quote.value?.paymentEnabled &&
        availableChannels.value.some((c) => c.channel === selectedChannel.value)),
  ),
  unavailableReason = computed(
    () =>
      quote.value?.unavailableReason ||
      (!availableChannels.value.length ? '当前版本尚未开放课程支付，请先试听。' : ''),
  );
const baseDiscount = computed(() =>
  Math.max(
    0,
    Number(order.value?.discount ?? quote.value?.discount ?? 0) -
      (order.value?.voucher?.discount ?? quote.value?.voucher?.discount ?? 0),
  ),
);
const refundProcessing = computed(
  () => !!order.value?.refunds.some((r) => !r.automatic && r.state === 'REFUNDING'),
);
const purchase = computed(() => order.value?.course ?? quote.value),
  price = computed(() => money(Number(order.value?.amount ?? quote.value?.price ?? '0'))),
  remainingLabel = computed(() => {
    const seconds = Math.max(
      0,
      Math.floor(((order.value ? Date.parse(order.value.expiresAt) : 0) - clock.value) / 1000),
    );
    return seconds
      ? '剩余 ' + Math.floor(seconds / 60) + ':' + String(seconds % 60).padStart(2, '0')
      : '付款期限已结束';
  });
const action = computed(() =>
  coursePurchaseAction(
    order.value,
    quote.value,
    order.value ? clientSupports(order.value.channel) : paymentReady.value,
    agreed.value,
    clock.value,
  ),
);
const statusTitle = computed(() => (order.value ? orderLabel(order.value) : '')),
  payBlockedReason = computed(() => {
    const o = order.value;
    if (!o || o.state !== 'PENDING' || o.canPay || o.paymentStatus === 'EXPIRED') return '';
    if (o.paymentStatus === 'CHECK_REQUIRED')
      return '支付结果待支付渠道确认，请稍后查询；如已扣款请勿重复支付。';
    if (o.paymentStatus === 'UNAVAILABLE')
      return '当前支付方式或课程状态暂不可用，请查看订单或联系书院。';
    return '';
  }),
  statusCopy = computed(() =>
    !order.value
      ? ''
      : refundProcessing.value
        ? '退课已进入原路退款流程，付费章节暂停访问，可在下方查询进度。'
        : order.value.voucherReturned || Number(order.value.refundedAmount) > 0
          ? '对应购课权限已撤销，会员或其他有效授权不受影响。'
          : order.value.group?.state === 'FAILED'
            ? '本团未成功，已安排原路退款，请在下方查看进度。'
            : order.value.group && order.value.group.state !== 'SUCCEEDED'
              ? '拼团付款已确认；成团后才能研习，未成团会自动原路退款。'
              : order.value.state === 'COMPLETED'
                ? '购买已确认，课程已加入你的学习档案。'
                : order.value.state === 'CLOSED'
                  ? '该订单已关闭，不会再次发起付款。'
                  : order.value.paymentStatus === 'EXPIRED'
                    ? '付款期限已结束，订单不会再发起扣款；如需继续研习，请重新选择课程。'
                    : '支付结果以服务端确认为准；付款后可查询结果，请勿重复购买。',
  );
function date(value: string) {
  return formatChinaTime(value);
}
const returnUrl = () =>
  '/pages/course/purchase?' + (orderId ? 'orderId=' + orderId : 'courseId=' + courseId);
async function load() {
  if (loading.value || busy.value) return;
  if (owner !== (currentUser.value?.id ?? '')) {
    owner = currentUser.value?.id ?? '';
    order.value = null;
    quote.value = null;
    showRefund.value = false;
    refundReason.value = '';
    agreed.value = false;
    notice.value = '';
    requestKey = studyEventId();
    refundKey = studyEventId();
  }
  loading.value = true;
  error.value = '';
  try {
    if (orderId) {
      if (needLogin(returnUrl())) return;
      order.value = await request<CourseOrder>('/commerce/course-orders/' + orderId);
    } else {
      const requestedChannel = selectedChannel.value;
      let next = await request<CourseQuote>(
        '/commerce/courses/' +
          courseId +
          '/quote?platform=' +
          platform +
          '&voucherQuantity=' +
          voucherQuantity.value +
          (couponId.value ? '&couponId=' + encodeURIComponent(couponId.value) : '') +
          ('&channel=' + encodeURIComponent(selectedChannel.value)) +
          (groupOfferId.value ? '&groupOfferId=' + groupOfferId.value : '') +
          (groupId.value ? '&groupId=' + groupId.value : ''),
      );
      const supported = next.channels.filter((c) => c.enabled && clientSupports(c.channel));
      if (!next.canRedeem && !supported.some((c) => c.channel === selectedChannel.value))
        selectedChannel.value = supported[0]?.channel ?? 'WECHAT_APP';
      if (selectedChannel.value !== requestedChannel)
        next = await request<CourseQuote>(
          '/commerce/courses/' +
            courseId +
            '/quote?platform=' +
            platform +
            '&voucherQuantity=' +
            voucherQuantity.value +
            (couponId.value ? '&couponId=' + encodeURIComponent(couponId.value) : '') +
            '&channel=' +
            encodeURIComponent(selectedChannel.value) +
            (groupOfferId.value ? '&groupOfferId=' + groupOfferId.value : '') +
            (groupId.value ? '&groupId=' + groupId.value : ''),
        );
      if (quote.value?.quoteHash !== next.quoteHash) {
        agreed.value = false;
        requestKey = studyEventId();
      }
      quote.value = next;
      if (
        !next.canRedeem &&
        !availableChannels.value.some((c) => c.channel === selectedChannel.value)
      )
        selectedChannel.value = availableChannels.value[0]?.channel ?? 'WECHAT_APP';
    }
  } catch (e) {
    error.value = (e as Error).message;
    if (voucherQuantity.value > 0) voucherQuantity.value = 0;
  } finally {
    loading.value = false;
  }
}
function chooseCoupon() {
  const options = quote.value?.couponOptions ?? [];
  uni.showActionSheet({
    itemList: [
      '自动选最优惠',
      '不使用优惠券',
      ...options.map((o) => o.title + ' · 减¥' + money(Number(o.discount))),
    ],
    success: async (r) => {
      couponId.value =
        r.tapIndex === 0 ? '' : r.tapIndex === 1 ? 'NONE' : options[r.tapIndex - 2].id;
      voucherQuantity.value = 0;
      await refreshQuote();
    },
  });
}
async function chooseGroup(id: string) {
  voucherQuantity.value = 0;
  groupOfferId.value = id;
  groupId.value = '';
  await refreshQuote();
}
async function chooseChannel(channel: string) {
  if (busy.value || loading.value || selectedChannel.value === channel) return;
  selectedChannel.value = channel;
  await refreshQuote();
}
async function useVouchers(value: number) {
  if (busy.value || loading.value) return;
  voucherQuantity.value = value;
  await refreshQuote();
}
async function refreshQuote() {
  agreed.value = false;
  notice.value = '';
  requestKey = studyEventId();
  await load();
}
async function refreshOrder() {
  if (!order.value || busy.value) return;
  busy.value = true;
  notice.value = '';
  try {
    order.value = await request<CourseOrder>(
      '/commerce/course-orders/' + order.value.id + '/refresh',
      { method: 'POST' },
    );
    notice.value = order.value.state === 'PENDING' ? '尚未确认付款，请稍后再查询。' : '';
  } catch (e) {
    notice.value = (e as Error).message;
  } finally {
    busy.value = false;
  }
}
async function primaryAction() {
  if (busy.value || !action.value.enabled) return;
  const kind = action.value.kind;
  if (kind === 'QUERY') {
    await refreshOrder();
    return;
  }
  if (kind === 'LEARN') {
    openPage('course/player?id=' + purchase.value!.courseId);
    return;
  }
  if (kind === 'DETAIL') {
    openPage('course/detail?id=' + purchase.value!.courseId);
    return;
  }
  if (kind === 'SUPPORT') {
    openPage('profile/feedback');
    return;
  }
  if (kind === 'GROUP' && order.value?.group) {
    openPage('marketing/group?id=' + order.value.group.id);
    return;
  }
  if (kind === 'LIBRARY') {
    openPage('course/library');
    return;
  }
  if (kind === 'PENDING') {
    orderId = quote.value!.pendingOrderId!;
    await load();
    return;
  }
  if (needLogin(returnUrl())) return;
  if (!quote.value?.canRedeem && !clientSupports(order.value?.channel ?? selectedChannel.value)) {
    notice.value = '当前版本尚未开放此支付方式，请先试听。';
    return;
  }
  busy.value = true;
  notice.value = '';
  try {
    if (!order.value) {
      if (!quote.value || !paymentReady.value || !agreed.value) return;
      order.value = await request<CourseOrder>('/commerce/course-orders', {
        method: 'POST',
        data: {
          ...(groupId.value ? { groupId: groupId.value } : {}),
          ...(groupOfferId.value ? { groupOfferId: groupOfferId.value } : {}),
          courseId,
          requestKey,
          voucherQuantity: voucherQuantity.value,
          ...(couponId.value ? { couponId: couponId.value } : {}),
          quoteHash: quote.value.quoteHash,
          platform,
          channel: selectedChannel.value,
        },
      });
      orderId = order.value.id;
      if (order.value.access) {
        notice.value = '代金券兑换已确认，可以开始研习。';
        return;
      }
      if (!order.value.canPay || !clientSupports(order.value.channel)) {
        notice.value = '已找到待处理订单，请先查询支付结果。';
        return;
      }
    }
    if (order.value.channel === 'WECHAT_NATIVE') {
      await openNativePayment('COURSE', order.value.id);
      notice.value = '请在微信完成扫码付款，返回后可查询原订单。';
      return;
    }
    const payment = await request<{ provider: 'wxpay' | 'alipay'; orderInfo: string }>(
      '/commerce/course-orders/' + order.value.id + '/payment',
      { method: 'POST' },
    );
    if (payment.provider === 'wxpay') {
      const sdk = JSON.parse(payment.orderInfo) as { appid: string } | null;
      if (!sdk || sdk.appid !== courseWechatAppId || order.value.channel !== 'WECHAT_APP')
        throw new Error('支付配置与当前App不匹配，请联系书院客服。');
    } else if (payment.provider === 'alipay') {
      const appId = payment.orderInfo.match(/(?:^|&)app_id=(\d+)(?:&|$)/)?.[1];
      if (appId !== courseAlipayAppId || order.value.channel !== 'ALIPAY_APP')
        throw new Error('支付宝配置与当前App不匹配，请联系书院客服。');
    } else throw new Error('此支付渠道暂不支持，请查询订单后联系书院。');
    // #ifdef APP-ANDROID
    let paymentHint = '';
    await new Promise<void>((resolve) => {
      uni.requestPayment({
        provider: payment.provider,
        orderInfo: payment.orderInfo,
        success: () => resolve(),
        fail: (e) => {
          paymentHint =
            e.errCode === 700601
              ? '已取消付款，请先查询订单，再决定是否继续。'
              : '支付结果待确认，请查询订单后再操作。';
          resolve();
        },
      });
    });
    notice.value = paymentHint;
    // #endif
    order.value = await request<CourseOrder>(
      '/commerce/course-orders/' + order.value.id + '/refresh',
      { method: 'POST' },
    );
    if (order.value.access) notice.value = '支付已确认，点击“开始研习”即可学习。';
    else if (!notice.value) notice.value = '支付结果待确认，请稍后查询订单。';
  } catch (e) {
    notice.value = (e as Error).message;
    if (order.value)
      try {
        order.value = await request<CourseOrder>('/commerce/course-orders/' + order.value.id);
      } catch {
        order.value = { ...order.value, canPay: false, paymentStatus: 'CHECK_REQUIRED' };
      }
    else if (courseId)
      try {
        const next = await request<CourseQuote>(
          '/commerce/courses/' +
            courseId +
            '/quote?platform=' +
            platform +
            '&voucherQuantity=' +
            voucherQuantity.value +
            (couponId.value ? '&couponId=' + encodeURIComponent(couponId.value) : '') +
            ('&channel=' + encodeURIComponent(selectedChannel.value)) +
            (groupOfferId.value ? '&groupOfferId=' + groupOfferId.value : '') +
            (groupId.value ? '&groupId=' + groupId.value : ''),
        );
        if (next.quoteHash !== quote.value?.quoteHash) {
          agreed.value = false;
          requestKey = studyEventId();
          notice.value += ' 请确认更新后的课程及价格。';
        }
        quote.value = next;
      } catch {
        /* A later refresh reuses the original request key after an unknown checkout result. */
      }
  } finally {
    busy.value = false;
  }
}
function cancelOrder() {
  if (!order.value || busy.value) return;
  uni.showModal({
    title: '取消购课订单',
    content: '将先向支付渠道确认是否已付款；已付款订单不会被直接取消。',
    confirmText: '确认取消',
    success: async (result) => {
      if (!result.confirm || !order.value || busy.value) return;
      busy.value = true;
      try {
        order.value = await request<CourseOrder>(
          '/commerce/course-orders/' + order.value.id + '/cancel',
          { method: 'POST' },
        );
        notice.value = '订单已关闭。';
      } catch (e) {
        notice.value = (e as Error).message;
        try {
          order.value = await request<CourseOrder>('/commerce/course-orders/' + order.value.id);
        } catch {
          /* The order remains queryable when the connection recovers. */
        }
      } finally {
        busy.value = false;
      }
    },
  });
}
async function submitRefund() {
  if (!order.value || busy.value) return;
  busy.value = true;
  refundError.value = '';
  try {
    order.value = await request<CourseOrder>(
      '/commerce/course-orders/' + order.value.id + '/refund',
      { method: 'POST', data: { requestKey: refundKey, reason: refundReason.value } },
    );
    showRefund.value = false;
    refundReason.value = '';
    refundKey = studyEventId();
    notice.value = '退课申请已提交，可在这里查看审核和退款进度。';
  } catch (e) {
    refundError.value = (e as Error).message;
  } finally {
    busy.value = false;
  }
}
function copyNumber() {
  if (order.value) uni.setClipboardData({ data: order.value.orderNo });
}
function copyRules() {
  if (!purchase.value) return;
  const p = purchase.value;
  uni.setClipboardData({
    data:
      p.title +
      '\n主讲：' +
      p.teacherName +
      '\n学习期限：' +
      (p.accessDays ? '支付确认后 ' + p.accessDays + ' 天' : '已购版本长期有效') +
      '\n课程价格：¥' +
      price.value +
      '\n退课说明：' +
      p.refundPolicy +
      '\n默认付款后7日内且未开始付费章节可申请；审核及原路退款完成后撤销对应购课访问权。',
  });
}
onLoad((options) => {
  courseId = options?.courseId ?? '';
  orderId = options?.orderId ?? '';
  groupId.value = options?.groupId ?? '';
});
onShow(() => {
  clock.value = Date.now();
  if (!timer) timer = setInterval(() => (clock.value = Date.now()), 1000);
  void load();
});
onHide(() => {
  if (timer) clearInterval(timer);
  timer = null;
});
onUnload(() => {
  if (timer) clearInterval(timer);
});
onBackPress(() => {
  if (busy.value) {
    uni.showToast({ title: '正在确认订单，请稍候', icon: 'none' });
    return true;
  }
  if (showRefund.value) {
    showRefund.value = false;
    return true;
  }
  return false;
});
</script>
