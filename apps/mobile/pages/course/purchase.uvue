<template><view class="page"><PageHead :title="order?'购课订单':'确认课程'"/><scroll-view class="page-scroll" direction="vertical" :show-scrollbar="false"><view class="content purchase-content">
<ContentState v-if="loading||error" :loading="loading" :error="error" @retry="load"/>
<view v-if="purchase&&!loading&&!error">
<view v-if="quote?.charity" class="purchase-notice"><text class="purchase-notice-text">本次已匹配公益计划：{{quote!.charity!.title}}；按服务端择优金额交付，不叠加推广返佣。</text><button v-if="Number(quote!.price)===0" class="purchase-text-button" @click="openPage('marketing/charity?tab=mine')">确认免费公益领取 ›</button></view><view class="purchase-heading"><text class="purchase-eyebrow">老子道学书院 · 研习课程</text><text class="purchase-title">{{purchase!.title}}</text><text class="purchase-teacher">{{purchase!.teacherName}} 主讲</text></view>
<view class="purchase-course"><ArtImage :src="purchase!.cover" kind="study" :width="90" :height="112"/><view class="purchase-course-copy"><text class="purchase-format">{{purchaseFormats}}</text><text class="purchase-summary">共 {{purchase!.lessons}} 讲 · 约 {{Math.ceil(purchase!.durationSeconds/60)}} 分钟</text><text class="purchase-description">按章研习，支持进度同步与续播 · 购后自动加入学习档案</text><button v-if="!order" class="purchase-text-button" @click="openPage('course/player?id='+purchase!.courseId)">返回试听与目录 ›</button></view></view>
<view v-if="order" class="purchase-status"><text class="purchase-status-title">{{statusTitle}}</text><text class="purchase-status-copy">{{statusCopy}}</text><button v-if="order!.state==='PENDING'" class="purchase-text-button" :disabled="busy" @click="refreshOrder">查询支付结果 ›</button></view>
<view v-if="order?.deliveryBlocked&&Number(order!.refundedAmount)===0" class="purchase-notice"><text class="purchase-notice-text">当前研习版本已停止交付：{{order!.deliveryReason}}。已购记录保留，可主动选择替代版；符合停止交付补偿的订单，可从下方申请退课。</text><button class="purchase-text-button" @click="openPage('course/versions?id='+purchase!.courseId)">查看版本处理方案 ›</button></view>
<view v-if="order?.memberBenefit||quote?.memberBenefit" class="purchase-notice"><text class="purchase-notice-text">会员购课优惠：按原价 {{(order?.memberBenefit??quote?.memberBenefit)!.basisPoints/100}}% 计费，立减 ¥{{money(Number((order?.memberBenefit??quote?.memberBenefit)!.savings))}}。已与优惠券、公益价择优，不叠加；退款按实付金额办理。</text></view><view v-if="quote?.window?.phase!=='PUBLIC'&&quote?.window?.publicOpenAt" class="purchase-notice"><text class="purchase-notice-text">公开开放：{{formatChinaTime(quote!.window!.publicOpenAt)}}（北京）。提前研习请从课程目录按已有权益进入，公开前不收取独立购课费用。</text></view><view class="purchase-section"><text class="purchase-section-title">课程与交付</text><view class="purchase-row"><text class="purchase-label">学习期限</text><text class="purchase-value">{{purchase!.accessDays?'支付确认后 '+purchase!.accessDays+' 天':'已购版本长期有效'}}</text></view><view class="purchase-row"><text class="purchase-label">课程版本</text><text class="purchase-value">购买时的已发布版本</text></view><text class="purchase-explanation">购买后自动加入学习档案，课程停止新售不影响已购版本的有效访问权。</text></view>
<view v-if="purchase!.liveSessions?.length" class="purchase-section"><text class="purchase-section-title">本版本直播安排</text><view v-for="item in purchase!.liveSessions" :key="item.id" class="purchase-row"><text class="purchase-label">{{item.title}}</text><text class="purchase-value">{{formatChinaTime(item.scheduledAt)}}（北京）</text></view><text class="purchase-explanation">按本次确认的课程版本进入直播，审核回放沿用课程权限。时间调整会发送通知，必修直播取消后可查看版本处理与退课方案。</text></view>
<view v-if="!order&&quote?.groupOptions.length&&platform==='ANDROID'" class="purchase-section"><text class="purchase-section-title">购买方式</text><text class="purchase-explanation">2人拼团，开团后最多24小时；成团前仅可试听，失败自动原路退款。拼团不叠加优惠券。</text><button class="purchase-text-button" :disabled="loading||busy" @click="chooseGroup('')">{{!groupOfferId&&!groupId?'✓ ':''}}单独购买</button><button v-for="option in quote!.groupOptions" :key="option.id" class="purchase-text-button" :disabled="loading||busy" @click="chooseGroup(option.id)">{{groupOfferId===option.id?'✓ ':''}}{{option.title}} · ¥{{money(Number(option.price))}}</button></view><view v-if="order?.group" class="purchase-section"><text class="purchase-section-title">{{order!.group!.state==='SUCCEEDED'?'拼团已成功':order!.group!.state==='FAILED'?'拼团未成功':'等待共学成团'}}</text><text class="purchase-explanation">已付款 {{order!.group!.paidMembers}} / {{order!.group!.requiredMembers}} 人 · {{formatChinaTime(order!.group!.expiresAt)}} 截止</text><button class="purchase-text-button" @click="openPage('marketing/group?id='+order!.group!.id)">查看拼团与邀请 ›</button></view><view class="purchase-section"><text class="purchase-section-title">费用明细</text><view class="purchase-row"><text class="purchase-label">课程价格</text><text class="purchase-value">¥{{money(Number(order?.originalPrice??quote?.originalPrice??'0'))}}</text></view><view v-if="Number(order?.discount??quote?.discount??'0')>0" class="purchase-row"><text class="purchase-label">{{order?.group?'拼团优惠':quote?.group?'拼团优惠':order?.memberBenefit||quote?.memberBenefit?'会员购课优惠':order?.charity||quote?.charity?'公益优惠':order?.coupon?.terms.title??quote?.coupon?.terms.title??'优惠券'}}（自动择优）</text><text class="purchase-value">−¥{{money(Number(order?.discount??quote?.discount??'0'))}}</text></view><button v-if="!order" class="purchase-text-button" @click="openPage('marketing/coupons')">领取课程优惠券 ›</button><view class="purchase-row"><text class="purchase-label">支付方式</text><text class="purchase-value">{{platform==='IOS'?'App Store 内购（待开放）':order?paymentChannelLabel(order!.channel):platform==='ANDROID'?paymentChannelLabel(selectedChannel):'Android App 内支付'}}</text></view><view v-if="!order&&platform==='ANDROID'" class="purchase-channels"><button v-for="choice in availableChannels" :key="choice.channel" :class="['purchase-channel',selectedChannel===choice.channel?'purchase-channel-active':'']" :disabled="busy" @click="chooseChannel(choice.channel)">{{choice.label}}</button></view><view class="purchase-total"><text class="purchase-total-label">{{order?.paidAt?'实付金额':'应付金额'}}</text><text class="purchase-total-amount">¥{{price}}</text></view></view>
<view class="purchase-section"><text class="purchase-section-title">退课说明</text><text class="purchase-policy" :user-select="true">{{purchase!.refundPolicy}}</text><text class="purchase-explanation" :user-select="true">默认可在付款后 7 日内、尚未打开付费章节时申请退课。退款须经审核并由支付渠道确认，完成后撤销对应购课权限；其他问题可联系书院客服。</text><button class="purchase-text-button" aria-label="复制完整课程购买说明" @click="copyRules">复制购买与退课说明 ›</button></view>
<ConsumptionReward :order-id="order?.id" :revision="order" :eligible="Number(order?.amount??quote?.price??0)>0"/><view v-if="!order" class="purchase-consent" @click="agreed=!agreed"><view :class="['purchase-checkbox',agreed?'purchase-checkbox-active':'']"><text v-if="agreed" class="purchase-checkmark">✓</text></view><text class="purchase-consent-copy">已阅读并理解学习期限和退课规则</text></view>
<view v-if="quote&&!paymentReady&&!order" class="purchase-notice"><text class="purchase-notice-text">{{unavailableReason}}</text></view>
<view v-if="notice" class="purchase-notice"><text class="purchase-notice-text">{{notice}}</text><button v-if="!order" class="purchase-text-button" :disabled="busy" @click="refreshQuote">刷新购买信息 ›</button></view>
<view v-if="order" class="purchase-section"><text class="purchase-section-title">订单信息</text><view class="purchase-row" @click="copyNumber"><text class="purchase-label">订单编号</text><view class="purchase-number"><text class="purchase-number-text">{{order!.orderNo}}</text><text class="purchase-copy">复制</text></view></view><view class="purchase-row"><text class="purchase-label">创建时间</text><text class="purchase-value">{{date(order!.createdAt)}}</text></view><view v-if="order!.paidAt" class="purchase-row"><text class="purchase-label">支付时间</text><text class="purchase-value">{{date(order!.paidAt!)}}</text></view><button v-if="order!.canRefund" class="purchase-text-button" :disabled="busy" @click="showRefund=true">申请退课退款 ›</button><text v-else-if="order!.refundUnavailableReason" class="purchase-explanation">{{order!.refundUnavailableReason}}</text></view>
<view v-for="refund in order?.refunds??[]" :key="refund.id" class="purchase-section"><view class="purchase-row"><text class="purchase-section-title">{{refund.automatic?'异常收款处理':'退课进度'}}</text><text class="purchase-value">{{refundLabel(refund.state)}}</text></view><text class="purchase-policy">{{refund.reason}}</text><text v-if="refund.reviewNote" class="purchase-explanation">书院回复：{{refund.reviewNote}}</text><text class="purchase-explanation">{{refund.state==='SUCCEEDED'?'已原路退回':refund.state==='REVERSED'?'原退款已撤回':'申请退款'}} ¥{{money(Number(refund.amount))}} · {{date(refund.createdAt)}}</text><button v-if="refund.state==='REFUNDING'" class="purchase-text-button" :disabled="busy" @click="refreshOrder">查询退款进度 ›</button></view>
<view class="purchase-links"><button class="purchase-text-button" @click="openPage('course/orders')">全部购课订单 ›</button><button class="purchase-text-button" @click="openPage('profile/feedback')">联系书院客服 ›</button></view>
</view></view></scroll-view>
<BottomBar v-if="purchase&&!loading&&!error"><view v-if="!order||order!.state==='PENDING'" class="purchase-bar-copy"><text class="purchase-bar-price">¥{{price}}</text><text class="purchase-bar-label">{{order?remainingLabel:'一次购买'}}</text></view><button v-if="order?.state==='PENDING'" class="bar-secondary" :disabled="busy" @click="cancelOrder">取消订单</button><button class="bar-primary" :disabled="busy||!action.enabled" @click="primaryAction">{{busy?'正在处理…':action.label}}</button></BottomBar>
<ComposeSheet :visible="showRefund" title="申请退课" subtitle="写明退课原因，书院审核后原路办理退款" v-model="refundReason" :maxlength="1000" :saving="busy" :disabled="refundReason.trim().length<2" :error="refundError" submitLabel="提交申请" @close="showRefund=false" @submit="submitRefund"/>
</view></template>
<script setup lang="ts">
import ConsumptionReward from '../../components/ConsumptionReward.uvue';
import {lessonType} from '../../lib/learning';
import {formatChinaTime} from '../../lib/date-time';
import PageHead from '../../components/PageHead.uvue';import BottomBar from '../../components/BottomBar.uvue';import ContentState from '../../components/ContentState.uvue';import ArtImage from '../../components/ArtImage.uvue';import ComposeSheet from '../../components/ComposeSheet.uvue';
import {courseWechatAppId,courseAlipayAppId} from '../../lib/payment-config';
import {request,money} from '../../lib/api';import {openPage} from '../../lib/presentation';import {currentUser,needLogin} from '../../lib/session';import {studyEventId} from '../../lib/learning';import {purchasePlatform,orderLabel,refundLabel,paymentChannelLabel,coursePurchaseAction} from '../../lib/course-sales';import type {CourseQuote,CourseOrder} from '../../lib/course-sales';
const platform=purchasePlatform(),quote=ref<CourseQuote|null>(null),order=ref<CourseOrder|null>(null),loading=ref(false),error=ref(''),notice=ref(''),agreed=ref(false),busy=ref(false),showRefund=ref(false),refundReason=ref(''),refundError=ref(''),clock=ref(Date.now()),selectedChannel=ref('WECHAT_APP'),groupOfferId=ref(''),groupId=ref('');let courseId='',orderId='',owner='',requestKey=studyEventId(),refundKey=studyEventId(),timer:ReturnType<typeof setInterval>|null=null;
const purchaseFormats=computed(()=>(purchase.value?.contentFormats??[purchase.value?.format??'']).map(lessonType).join(' · ')+'研习');
function clientSupports(channel:string){return platform==='ANDROID'&&(channel==='WECHAT_APP'?!!courseWechatAppId:channel==='ALIPAY_APP'?!!courseAlipayAppId:false);}
const availableChannels=computed(()=>(quote.value?.channels??[]).filter(c=>c.enabled&&clientSupports(c.channel)));
const paymentReady=computed(()=>!!quote.value?.paymentEnabled&&availableChannels.value.some(c=>c.channel===selectedChannel.value)),unavailableReason=computed(()=>quote.value?.unavailableReason||(!availableChannels.value.length?'当前版本尚未开放课程支付，请先试听。':''));
const refundProcessing=computed(()=>!!order.value?.refunds.some(r=>!r.automatic&&r.state==='REFUNDING'));
const purchase=computed(()=>order.value?.course??quote.value),price=computed(()=>money(Number(order.value?.amount??quote.value?.price??'0'))),remainingLabel=computed(()=>{const seconds=Math.max(0,Math.floor(((order.value?Date.parse(order.value.expiresAt):0)-clock.value)/1000));return seconds?'剩余 '+Math.floor(seconds/60)+':'+String(seconds%60).padStart(2,'0'):'付款期限已结束';});
const action=computed(()=>coursePurchaseAction(order.value,quote.value,order.value?clientSupports(order.value.channel):paymentReady.value,agreed.value,clock.value));
const statusTitle=computed(()=>order.value?orderLabel(order.value):''),statusCopy=computed(()=>!order.value?'':refundProcessing.value?'退课已进入原路退款流程，付费章节暂停访问，可在下方查询进度。':Number(order.value.refundedAmount)>0?'对应购课权限已撤销，会员或其他有效授权不受影响。':order.value.group?.state==='FAILED'?'本团未成功，已安排原路退款，请在下方查看进度。':order.value.group&&order.value.group.state!=='SUCCEEDED'?'拼团付款已确认；成团后才能研习，未成团会自动原路退款。':order.value.state==='COMPLETED'?'服务端已确认收款，课程已加入你的学习档案。':order.value.state==='CLOSED'?'该订单已关闭，不会再次发起付款。':'支付结果以服务端确认为准；付款后可查询结果，请勿重复购买。');
function date(value:string){return formatChinaTime(value);}
const returnUrl=()=>'/pages/course/purchase?'+(orderId?'orderId='+orderId:'courseId='+courseId);
async function load(){if(loading.value||busy.value)return;if(owner!==(currentUser.value?.id??'')){owner=currentUser.value?.id??'';order.value=null;quote.value=null;showRefund.value=false;refundReason.value='';agreed.value=false;notice.value='';requestKey=studyEventId();refundKey=studyEventId();}loading.value=true;error.value='';try{if(orderId){if(needLogin(returnUrl()))return;order.value=await request<CourseOrder>('/commerce/course-orders/'+orderId);}else{const next=await request<CourseQuote>('/commerce/courses/'+courseId+'/quote?platform='+platform+'&channel='+selectedChannel.value+(groupOfferId.value?'&groupOfferId='+groupOfferId.value:'')+(groupId.value?'&groupId='+groupId.value:''));if(quote.value?.quoteHash!==next.quoteHash){agreed.value=false;requestKey=studyEventId();}quote.value=next;if(!availableChannels.value.some(c=>c.channel===selectedChannel.value))selectedChannel.value=availableChannels.value[0]?.channel??'WECHAT_APP';}}catch(e){error.value=(e as Error).message;}finally{loading.value=false;}}
async function chooseGroup(id:string){groupOfferId.value=id;groupId.value='';await refreshQuote();}
async function chooseChannel(channel:string){if(busy.value||loading.value||selectedChannel.value===channel)return;selectedChannel.value=channel;await refreshQuote();}
async function refreshQuote(){agreed.value=false;notice.value='';await load();}
async function refreshOrder(){if(!order.value||busy.value)return;busy.value=true;notice.value='';try{order.value=await request<CourseOrder>('/commerce/course-orders/'+order.value.id+'/refresh',{method:'POST'});notice.value=order.value.state==='PENDING'?'尚未确认付款，请稍后再查询。':'';}catch(e){notice.value=(e as Error).message;}finally{busy.value=false;}}
async function primaryAction(){
if(busy.value||!action.value.enabled)return;
const kind=action.value.kind;
if(kind==='QUERY'){await refreshOrder();return;}
if(kind==='LEARN'){openPage('course/player?id='+purchase.value!.courseId);return;}
if(kind==='DETAIL'){openPage('course/detail?id='+purchase.value!.courseId);return;}
if(kind==='VERSION'){openPage('course/versions?id='+purchase.value!.courseId);return;}
if(kind==='GROUP'&&order.value?.group){openPage('marketing/group?id='+order.value.group.id);return;}
if(kind==='LIBRARY'){openPage('course/library');return;}
if(kind==='PENDING'){orderId=quote.value!.pendingOrderId!;await load();return;}
if(needLogin(returnUrl()))return;
if(!clientSupports(order.value?.channel??selectedChannel.value)){notice.value='当前版本尚未开放此支付方式，请先试听。';return;}
busy.value=true;notice.value='';try{
if(!order.value){if(!quote.value||!paymentReady.value||!agreed.value)return;order.value=await request<CourseOrder>('/commerce/course-orders',{method:'POST',data:{...(groupId.value?{groupId:groupId.value}:{}),...(groupOfferId.value?{groupOfferId:groupOfferId.value}:{}),courseId,requestKey,quoteHash:quote.value.quoteHash,platform,channel:selectedChannel.value}});orderId=order.value.id;if(!order.value.canPay||!clientSupports(order.value.channel)){notice.value='已找到待处理订单，请先查询支付结果。';return;}}
const payment=await request<{provider:'wxpay'|'alipay';orderInfo:string}>('/commerce/course-orders/'+order.value.id+'/payment',{method:'POST'});
if(payment.provider==='wxpay'){
  const sdk=JSON.parse(payment.orderInfo) as {appid:string}|null;if(!sdk||sdk.appid!==courseWechatAppId||order.value.channel!=='WECHAT_APP')throw new Error('支付配置与当前App不匹配，请联系书院客服。');
}else if(payment.provider==='alipay'){
  const appId=payment.orderInfo.match(/(?:^|&)app_id=(\d+)(?:&|$)/)?.[1];if(appId!==courseAlipayAppId||order.value.channel!=='ALIPAY_APP')throw new Error('支付宝配置与当前App不匹配，请联系书院客服。');
}else throw new Error('此支付渠道暂不支持，请查询订单后联系书院。');
// #ifdef APP-ANDROID
let paymentHint='';await new Promise<void>(resolve=>{uni.requestPayment({provider:payment.provider,orderInfo:payment.orderInfo,success:()=>resolve(),fail:e=>{paymentHint=e.errCode===700601?'已取消付款，请先查询订单，再决定是否继续。':'支付结果待确认，请查询订单后再操作。';resolve();}});});
notice.value=paymentHint;
// #endif
order.value=await request<CourseOrder>('/commerce/course-orders/'+order.value.id+'/refresh',{method:'POST'});if(order.value.access)notice.value='支付已确认，点击“开始研习”即可学习。';else if(!notice.value)notice.value='支付结果待确认，请稍后查询订单。';
}catch(e){notice.value=(e as Error).message;
if(order.value)try{order.value=await request<CourseOrder>('/commerce/course-orders/'+order.value.id);}catch{order.value={...order.value,canPay:false,paymentStatus:'CHECK_REQUIRED'};}
else if(courseId)try{const next=await request<CourseQuote>('/commerce/courses/'+courseId+'/quote?platform='+platform+'&channel='+selectedChannel.value+(groupOfferId.value?'&groupOfferId='+groupOfferId.value:'')+(groupId.value?'&groupId='+groupId.value:''));if(next.quoteHash!==quote.value?.quoteHash){agreed.value=false;requestKey=studyEventId();notice.value+=' 请确认更新后的课程及价格。';}quote.value=next;}catch{/* A later refresh reuses the original request key after an unknown checkout result. */}
}finally{busy.value=false;}}
function cancelOrder(){if(!order.value||busy.value)return;uni.showModal({title:'取消购课订单',content:'将先向支付渠道确认是否已付款；已付款订单不会被直接取消。',confirmText:'确认取消',success:async result=>{if(!result.confirm||!order.value||busy.value)return;busy.value=true;try{order.value=await request<CourseOrder>('/commerce/course-orders/'+order.value.id+'/cancel',{method:'POST'});notice.value='订单已关闭。';}catch(e){notice.value=(e as Error).message;try{order.value=await request<CourseOrder>('/commerce/course-orders/'+order.value.id);}catch{/* The order remains queryable when the connection recovers. */}}finally{busy.value=false;}}});}
async function submitRefund(){if(!order.value||busy.value)return;busy.value=true;refundError.value='';try{order.value=await request<CourseOrder>('/commerce/course-orders/'+order.value.id+'/refund',{method:'POST',data:{requestKey:refundKey,reason:refundReason.value}});showRefund.value=false;refundReason.value='';refundKey=studyEventId();notice.value='退课申请已提交，可在这里查看审核和退款进度。';}catch(e){refundError.value=(e as Error).message;}finally{busy.value=false;}}
function copyNumber(){if(order.value)uni.setClipboardData({data:order.value.orderNo});}
function copyRules(){if(!purchase.value)return;const p=purchase.value;uni.setClipboardData({data:p.title+'\n主讲：'+p.teacherName+'\n学习期限：'+(p.accessDays?'支付确认后 '+p.accessDays+' 天':'已购版本长期有效')+'\n课程价格：¥'+price.value+'\n退课说明：'+p.refundPolicy+'\n默认付款后7日内且未开始付费章节可申请；审核及原路退款完成后撤销对应购课访问权。'});}
onLoad(options=>{courseId=options?.courseId??'';orderId=options?.orderId??'';groupId.value=options?.groupId??'';});onShow(()=>{clock.value=Date.now();if(!timer)timer=setInterval(()=>clock.value=Date.now(),1000);void load();});onHide(()=>{if(timer)clearInterval(timer);timer=null;});onUnload(()=>{if(timer)clearInterval(timer);});
onBackPress(()=>{if(busy.value){uni.showToast({title:'正在确认订单，请稍候',icon:'none'});return true;}if(showRefund.value){showRefund.value=false;return true;}return false;});
</script>
<style>@import '../../styles/app.css';.purchase-content{padding-top:12px;padding-bottom:28px;}.purchase-heading{padding:10px 0 22px;}.purchase-eyebrow{font-size:11px;line-height:20px;color:#788084;letter-spacing:1px;}.purchase-title{font-family:AcademySerif;font-size:24px;line-height:36px;color:#17292D;margin-top:8px;}.purchase-teacher{font-size:13px;line-height:22px;color:#637276;margin-top:8px;}.purchase-course{flex-direction:row;padding:0 0 22px;}.purchase-course-copy{flex:1;padding-left:16px;justify-content:center;}.purchase-format{font-size:11px;line-height:19px;color:#245564;}.purchase-summary{font-size:15px;line-height:26px;color:#17292D;margin-top:4px;}.purchase-description{font-size:12px;line-height:22px;color:#637276;margin-top:4px;}.purchase-section{padding:22px 0;border-top-width:1px;border-top-style:solid;border-top-color:#E3DED3;}.purchase-section-title{font-family:AcademySerif;font-size:17px;line-height:26px;color:#17292D;}.purchase-row{flex-direction:row;justify-content:space-between;align-items:center;min-height:44px;padding:7px 0;}.purchase-label{font-size:13px;line-height:22px;color:#637276;padding-right:16px;}.purchase-value{flex:1;text-align:right;font-size:13px;line-height:22px;color:#17292D;}.purchase-explanation{font-size:12px;line-height:23px;color:#788084;margin-top:8px;}.purchase-policy{font-size:14px;line-height:26px;color:#344C54;margin-top:12px;}.purchase-total{flex-direction:row;align-items:center;justify-content:space-between;padding-top:16px;}.purchase-total-label{font-size:14px;color:#17292D;}.purchase-total-amount{font-size:28px;line-height:36px;color:#245564;}.purchase-text-button{margin:0;align-self:flex-start;padding:10px 0;min-height:44px;line-height:24px;font-size:13px;color:#245564;background-color:transparent;border-width:0;}.purchase-status{padding:18px 20px;margin-bottom:22px;background-color:#EEE9DF;border-radius:6px;}.purchase-status-title{font-family:AcademySerif;font-size:20px;line-height:30px;color:#245564;}.purchase-status-copy{font-size:13px;line-height:24px;color:#637276;margin-top:8px;}.purchase-consent{flex-direction:row;align-items:center;min-height:52px;padding:10px 0;}.purchase-checkbox{width:20px;height:20px;border-width:1px;border-style:solid;border-color:#A3AEAB;border-radius:3px;align-items:center;justify-content:center;}.purchase-checkbox-active{background-color:#245564;border-color:#245564;}.purchase-checkmark{color:#FAF8F2;font-size:15px;line-height:20px;}.purchase-consent-copy{flex:1;font-size:13px;line-height:23px;color:#637276;padding-left:10px;}.purchase-notice{padding:14px 16px;background-color:#EEE9DF;border-radius:4px;margin-top:10px;}.purchase-notice-text{font-size:13px;line-height:24px;color:#637276;}.purchase-number{flex:1;align-items:flex-end;}.purchase-number-text{font-size:11px;line-height:18px;color:#637276;}.purchase-copy{font-size:12px;line-height:22px;color:#245564;}.purchase-links{flex-direction:row;justify-content:space-between;border-top-width:1px;border-top-style:solid;border-top-color:#E3DED3;padding-top:12px;}.purchase-bar-copy{justify-content:center;min-width:80px;padding-right:8px;}.purchase-bar-price{font-size:21px;line-height:28px;color:#245564;}.purchase-bar-label{font-size:10px;line-height:18px;color:#788084;}</style>
<style>.purchase-channels{flex-direction:row;flex-wrap:wrap;margin-top:6px;}.purchase-channel{min-height:44px;padding:10px 18px;margin:0 10px 8px 0;border-width:1px;border-style:solid;border-color:#D8D4CA;border-radius:6px;background-color:#F7F3EC;color:#637276;font-size:13px;line-height:22px;}.purchase-channel-active{border-color:#245564;color:#245564;background-color:#E7EFEB;}</style>
