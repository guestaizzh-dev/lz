<template><view class="page"><PageHead title="课程版本"/><scroll-view class="page-scroll" direction="vertical" :show-scrollbar="false"><view class="content version-content">
<ContentState v-if="loading||error" :loading="loading" :error="error" @retry="load"/>
<view v-if="data&&!loading&&!error">
<text class="page-title">你的研习版本</text><text class="body-copy version-intro" :user-select="true">{{data!.explanation}}</text>
<view v-if="current?.withdrawn" class="version-notice"><text class="version-notice-title">当前版本停止交付</text><text class="body-copy">{{current!.withdrawalReason}}</text><text class="meta">学习记录和订单保留。你可以确认替代版本，或前往订单申请退课。</text><button v-if="data!.orderId" class="secondary-button" @click="openPage('course/purchase?orderId='+data!.orderId)">查看订单与退课</button></view>
<view class="version-term"><text class="meta">原访问期限</text><text class="body-copy">{{data!.expiresAt?formatChinaTime(data!.expiresAt!):'长期有效'}}</text></view>
<view v-for="choice in data!.choices" :key="choice.releaseId" class="version-card">
<view class="row between"><text class="version-number">第 {{choice.version}} 版</text><text class="tag">{{choice.current?'当前研习':choice.original?(data!.orderId?'已购原版':'原研习版本'):choice.withdrawn?'停止交付':'可选择'}}</text></view>
<text class="section-heading">{{choice.title}}</text><text class="body-copy version-description" :user-select="true">{{choice.description}}</text><text class="meta">{{choice.lessons.length}} 讲 · {{contentLabel(choice.lessons)}} · 必修 {{choice.lessons.filter(l=>l.required).length}} 讲</text>
<button class="retry" @click="outline=outline===choice.releaseId?'':choice.releaseId">{{outline===choice.releaseId?'收起版本课纲':'查看版本课纲'}}</button><view v-if="outline===choice.releaseId"><text v-for="(lesson,index) in choice.lessons" :key="index" class="body-copy">{{index+1}}. {{lesson.title}} · {{lessonType(lesson.format)}}{{lesson.required?' · 必修':''}}</text></view>
<text v-if="choice.withdrawn" class="meta">{{choice.withdrawalReason}}</text>
<button v-if="!choice.current&&!choice.withdrawn" class="secondary-button version-select" :disabled="busy" @click="choose(choice)">{{current?.withdrawn?'确认替代版本':choice.version>(current?.version??0)?'查看变化并选择新版':'切回保留版本'}}</button>
</view><text v-if="notice" class="body-copy version-intro">{{notice}}</text>
</view><view class="version-links"><button class="retry" @click="openPage('course/player?id='+id)">返回课程学习</button><button class="retry" @click="openPage('course/orders')">购课订单与售后</button><button class="retry" @click="openPage('profile/feedback')">联系书院</button></view>
</view></scroll-view></view></template>
<script setup lang="ts">
import PageHead from '../../components/PageHead.uvue';import ContentState from '../../components/ContentState.uvue';
import {request} from '../../lib/api';import {currentUser,needLogin} from '../../lib/session';import {openPage} from '../../lib/presentation';import {contentLabel,lessonType,studyEventId} from '../../lib/learning';import {formatChinaTime} from '../../lib/date-time';
type VersionLesson={title:string;format:string;required:boolean};
type Choice={releaseId:string;version:number;title:string;description:string;lessons:VersionLesson[];withdrawn:boolean;withdrawalReason:string|null;current:boolean;original:boolean;confirmationHash:string};
type Versions={version:number;currentReleaseId:string;expiresAt:string|null;orderId:string|null;choices:Choice[];explanation:string};
const data=ref<Versions|null>(null),loading=ref(false),busy=ref(false),error=ref(''),notice=ref(''),outline=ref(''),current=computed(()=>data.value?.choices.find(c=>c.current));let id='',owner='',requestKey=studyEventId(),requestTarget='';
async function load(){if(loading.value||busy.value||needLogin())return;if(owner!==(currentUser.value?.id??'')){owner=currentUser.value?.id??'';data.value=null;notice.value='';}loading.value=true;error.value='';try{data.value=await request<Versions>('/learning/courses/'+id+'/versions');}catch(e){error.value=(e as Error).message;}finally{loading.value=false;}}
function choose(choice:Choice){if(busy.value||!data.value)return;uni.showModal({title:current.value?.withdrawn?'确认替代版本':'确认更换研习版本',content:choice.title+' · 第 '+choice.version+' 版\n'+choice.lessons.length+'讲，必修'+choice.lessons.filter(l=>l.required).length+'讲。原学习记录与已购原版保留；访问期限不变，升级不另收费。请确认已查看本页版本说明。',confirmText:'确认选择',success:async result=>{if(!result.confirm||busy.value||!data.value)return;if(requestTarget!==choice.confirmationHash){requestTarget=choice.confirmationHash;requestKey=studyEventId();}busy.value=true;notice.value='';try{data.value=await request<Versions>('/learning/courses/'+id+'/versions/choose',{method:'POST',data:{targetReleaseId:choice.releaseId,requestKey,expectedVersion:data.value.version,confirmationHash:choice.confirmationHash,accepted:true}});notice.value='已按你的选择更新，可返回课程继续研习。';}catch(e){notice.value=(e as Error).message;}finally{busy.value=false;}}});}
onLoad(options=>{id=options?.id??'';});onShow(()=>void load());onBackPress(()=>{if(busy.value){uni.showToast({title:'正在保存你的选择',icon:'none'});return true;}return false;});
</script><style>@import '../../styles/app.css';.version-content{padding-top:16px;padding-bottom:30px;}.version-intro{margin-top:14px;margin-bottom:20px;}.version-notice{padding:18px 16px;background-color:#EEE9DF;border-radius:6px;margin-bottom:18px;}.version-notice-title{font-family:AcademySerif;font-size:18px;line-height:28px;color:#245564;margin-bottom:8px;}.version-term{padding:12px 0 18px;}.version-card{padding:22px 0;border-top-width:1px;border-top-style:solid;border-top-color:#E3DED3;}.version-number{font-size:12px;line-height:22px;color:#637276;}.version-description{margin-top:8px;}.version-select{margin-top:16px;}.version-links{padding-top:16px;}</style>
