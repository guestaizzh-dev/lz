<template>
<view class="page">
<PageHead title="活动详情"/>
<scroll-view :show-scrollbar="false" class="page-scroll" direction="vertical">
<view class="content">
<ContentState v-if="!event" :loading="!error" :error="error" @retry="load"/>
<view v-else>
<ArtImage :src="event!.cover" kind="room" :width="width" :height="190"/>
<text class="detail-title">{{event!.title}}</text>
<text class="meta">时间：{{event!.startsAt}}</text>
<text class="meta">地点：{{event!.location}}</text>
<text class="price event-price">{{event!.price?'¥'+money(event!.price):'免费活动'}}</text>
<view class="section">
<text class="section-heading">活动介绍</text>
<text class="body-copy">{{event!.description}}</text>
</view>
</view>
</view>
</scroll-view>
<view v-if="event" class="bottom-bar">
<button class="bar-primary" @click="book">预约报名</button>
</view>
</view>
</template>
<script setup lang="ts">import PageHead from '../../components/PageHead.uvue';import ArtImage from '../../components/ArtImage.uvue';import ContentState from '../../components/ContentState.uvue';import {request,money} from '../../lib/api';import type {AcademyEvent} from '../../lib/api';import {viewWidth,showUnavailable} from '../../lib/presentation';import {needLogin} from '../../lib/session';const width=viewWidth(),event=ref<AcademyEvent|null>(null),error=ref('');let id='';async function load(){error.value='';try{event.value=await request<AcademyEvent>('/catalog/events/'+encodeURIComponent(id));}catch(e){error.value=(e as Error).message;}}function book(){if(needLogin())return;showUnavailable('暂未开放报名','预约和席位确认服务尚未接入，请等待书院开放报名。');}onLoad(options=>{id=options?.id??'';load();});</script>
<style>@import '../../styles/app.css';.event-price{margin-top:18px;}</style>