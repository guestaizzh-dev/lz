<template>
<view class="page">
<PageHead title="活动与预约"/>
<scroll-view :show-scrollbar="false" class="page-scroll" direction="vertical">
<view class="content">
<ContentState v-if="loading||error" :loading="loading" :error="error" @retry="load()"/>
<view v-else>
<view v-for="event in items" :key="event.id" class="event-card" @click="openPage('event/detail?id='+event.id)">
<ArtImage :src="event.cover" kind="room" :width="width" :height="150"/>
<text class="item-title event-title">{{event.title}}</text>
<text class="meta">{{event.startsAt.slice(0,10)}} · {{event.location}}</text>
<text class="price">{{event.price?'¥'+money(event.price):'免费活动'}}</text>
</view>
<ContentState v-if="!items.length" title="暂无活动安排" description="书院的线下研习、雅集和实践活动，将在这里公布。"/>
<button v-if="nextCursor" class="retry" @click="load(true)">更多活动</button>
</view>
</view>
</scroll-view>
</view>
</template>
<script setup lang="ts">import PageHead from '../../components/PageHead.uvue';import ArtImage from '../../components/ArtImage.uvue';import ContentState from '../../components/ContentState.uvue';import {useCatalog} from '../../lib/catalog';import type {AcademyEvent} from '../../lib/api';import {money} from '../../lib/api';import {openPage,viewWidth} from '../../lib/presentation';const width=viewWidth();const {items,loading,error,nextCursor,load}=useCatalog<AcademyEvent>('events',()=>({category:'全部'}));onLoad(()=>load());</script>
<style>@import '../../styles/app.css';.event-card{border-style:solid;border-width:0;padding-bottom:18px;margin-bottom:18px;border-bottom-width:1px;border-bottom-color:#D8D4CA;}.event-title{margin-top:12px;}.price{margin-top:8px;}</style>