<template>
  <view class="page"
    ><InkBackdrop />
    <PageHead title="活动与预约" />
    <scroll-view :show-scrollbar="false" class="page-scroll" direction="vertical">
      <view class="content">
        <text class="ui-text intro event-intro"
          >在书院相见，按场次预约。线下研习、雅集与实践活动都在这里。</text
        >
        <scroll-view
          class="horizontal-scroll event-chips"
          direction="horizontal"
          :show-scrollbar="false"
          ><view
            v-for="item in categories"
            :key="item.code"
            :class="['event-chip', category === item.code ? 'event-chip-active' : '']"
            @click="category = item.code"
            ><text
              class="ui-text"
              :class="['event-chip-text', category === item.code ? 'event-chip-text-active' : '']"
              >{{ item.label }}</text
            ></view
          ></scroll-view
        ><text v-if="categoryError" class="ui-text event-chip-error" @click="refreshCategories()"
          >{{ categoryError }} · 点击重新读取</text
        >
        <ContentState
          v-if="(loading && !items.length) || error"
          :loading="loading"
          :error="error"
          :error-title="error.indexOf('权') >= 0 ? '无权查看活动安排' : '活动列表暂时无法读取'"
          :retryable="error.indexOf('权') < 0"
          @retry="retry()"
        />
        <view v-if="!error && (!loading || items.length)">
          <view
            v-for="event in items"
            :key="event.id"
            class="event-card"
            hover-class="row-pressed"
            @click="openPage('event/detail?id=' + event.id)"
          >
            <ArtImage :src="event.cover" kind="room" :width="width" :height="160" :radius="14" />
            <view class="event-copy">
              <view class="row between"
                ><text class="ui-text pill pill-gold">{{
                  event.categoryLabel ?? event.category ?? '线下活动'
                }}</text
                ><text class="ui-text event-date">{{ formatChinaDate(event.startsAt) }}</text></view
              >
              <text class="ui-text item-title event-title">{{ event.title }}</text>
              <view class="row between event-foot"
                ><text class="ui-text event-location">{{ event.location }}</text
                ><text class="ui-text event-price">{{
                  event.price ? '¥' + money(event.price) : '免费活动'
                }}</text></view
              >
            </view>
          </view>
          <ContentState
            v-if="!items.length"
            title="暂无活动安排"
            description="书院的线下研习、雅集和实践活动，将在这里公布。"
          />
          <button v-if="nextCursor" class="ui-button retry" @click="load(true)">更多活动</button>
        </view>
      </view>
    </scroll-view>
  </view>
</template>
<script setup lang="ts">
import InkBackdrop from '../../components/InkBackdrop.uvue';
import { useCategories } from '../../lib/categories';
const { categories, categoryError, refreshCategories } = useCategories('EVENT'),
  category = ref('全部');

import { formatChinaDate } from '../../lib/date-time';
import PageHead from '../../components/PageHead.uvue';
import ArtImage from '../../components/ArtImage.uvue';
import ContentState from '../../components/ContentState.uvue';
import { useCatalog } from '../../lib/catalog';
import type { AcademyEvent } from '../../lib/api';
import { money } from '../../lib/api';
import { openPage, viewWidth } from '../../lib/presentation';
const width = viewWidth();
const { items, loading, error, nextCursor, load, retry } = useCatalog<AcademyEvent>(
  'events',
  () => ({ category: category.value }),
);
watch(category, () => load());
onLoad(() => load());
onShow(() => refreshCategories());
</script>
<style>
@import '../../styles/app.css';
.event-intro {
  padding: 0 0 12px;
}
.event-chips {
  margin-top: 0;
  margin-bottom: 12px;
}
.event-chip {
  min-height: 44px;
  justify-content: center;
  border-style: solid;
  border-width: 1px;
  border-color: #cfc5b1;
  background-color: #fcf9f2;
  border-radius: 10px;
  padding: 11px 12px;
  margin: 0 8px 0 0;
  flex-shrink: 0;
}
.event-chip-active {
  background-color: #e6ede9;
  border-color: #235663;
}
.event-chip-text {
  font-family: sans-serif;
  font-size: 13px;
  line-height: 22px;
  color: #5c6869;
  font-weight: 400;
  white-space: nowrap;
}
.event-chip-text-active {
  color: #235663;
  font-weight: 600;
}
.event-chip-error {
  font-size: 12px;
  line-height: 20px;
  color: #b4533f;
  padding: 8px 0;
}
.event-card {
  background-color: #fcf9f2;
  border-style: solid;
  border-width: 1px;
  border-color: #cfc5b1;
  border-radius: 14px;
  overflow: hidden;
  margin-bottom: 16px;
}
.event-copy {
  padding: 16px;
}
.event-date {
  flex-shrink: 0;
  font-size: 12px;
  line-height: 20px;
  color: #5c6869;
  white-space: nowrap;
}
.event-title {
  margin-top: 8px;
  font-size: 17px;
  line-height: 26px;
  max-height: 52px;
  overflow: hidden;
}
.event-foot {
  margin-top: 12px;
}
.event-location {
  flex: 1;
  min-width: 0;
  padding-right: 12px;
  font-size: 12px;
  line-height: 20px;
  color: #5c6869;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.event-price {
  flex-shrink: 0;
  font-family: AcademySerif;
  font-size: 19px;
  line-height: 27px;
  color: #b4533f;
  font-weight: 600;
}
</style>
