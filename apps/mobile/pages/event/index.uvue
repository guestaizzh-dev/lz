<template>
<view class="page">
<PageHead title="活动与预约"/>
<scroll-view :show-scrollbar="false" class="page-scroll" direction="vertical">
<view class="content">
<text class="intro event-intro">在书院相见，按场次预约。线下研习、雅集与实践活动都在这里。</text>
<scroll-view class="chip-scroll" direction="horizontal" :show-scrollbar="false"><view v-for="item in categories" :key="item.code" :class="['chip',category===item.code?'chip-active':'']" @click="category=item.code"><text :class="['chip-text',category===item.code?'chip-text-active':'']">{{item.label}}</text></view></scroll-view><text v-if="categoryError" class="muted" @click="refreshCategories()">{{categoryError}}</text>
<ContentState v-if="loading&&!items.length||error" :loading="loading" :error="error" @retry="retry()"/>
<view v-if="!error&&(!loading||items.length)">
<view v-for="event in items" :key="event.id" class="event-card" hover-class="row-pressed" @click="openPage('event/detail?id='+event.id)">
<ArtImage :src="event.cover" kind="room" :width="width" :height="160"/>
<view class="event-copy">
<view class="row between"><view class="pill pill-gold">{{event.categoryLabel??event.category??'线下活动'}}</view><text class="event-date">{{formatChinaDate(event.startsAt)}}</text></view>
<text class="item-title event-title">{{event.title}}</text>
<view class="row between event-foot"><text class="event-location">{{event.location}}</text><text class="event-price">{{event.price?'¥'+money(event.price):'免费活动'}}</text></view>
</view>
</view>
<ContentState v-if="!items.length" title="暂无活动安排" description="书院的线下研习、雅集和实践活动，将在这里公布。"/>
<button v-if="nextCursor" class="retry" @click="load(true)">更多活动</button>
</view>
</view>
</scroll-view>
</view>
</template>
<script setup lang="ts">
import {useCategories} from '../../lib/categories';const {categories,categoryError,refreshCategories}=useCategories('EVENT'),category=ref('全部');

import {formatChinaDate} from '../../lib/date-time';import PageHead from '../../components/PageHead.uvue';import ArtImage from '../../components/ArtImage.uvue';import ContentState from '../../components/ContentState.uvue';import {useCatalog} from '../../lib/catalog';import type {AcademyEvent} from '../../lib/api';import {money} from '../../lib/api';import {openPage,viewWidth} from '../../lib/presentation';const width=viewWidth();const {items,loading,error,nextCursor,load,retry}=useCatalog<AcademyEvent>('events',()=>({category:category.value}));watch(category,()=>load());onLoad(()=>load());onShow(()=>refreshCategories());</script>
<style>@import '../../styles/app.css';.event-intro{padding:2px 0 14px;}.event-card{background-color:#FCF9F2;border-style:solid;border-width:1px;border-color:#E3DCCF;border-radius:12px;overflow:hidden;margin-bottom:14px;}.event-copy{padding:14px;}.event-date{font-size:11px;line-height:18px;color:#6A7578;}.event-title{margin-top:10px;font-size:19px;line-height:28px;}.event-foot{margin-top:10px;}.event-location{flex:1;min-width:0;padding-right:12px;font-size:12px;line-height:20px;color:#6A7578;}.event-price{font-family:AcademySerif;font-size:20px;line-height:28px;color:#B4533F;font-weight:600;}</style>
