<template>
  <view class="page"
    ><InkBackdrop /><PageHead title="直播研习" /><scroll-view
      class="page-scroll"
      direction="vertical"
      ><view class="content">
        <ContentState
          v-if="!room"
          :loading="loading"
          :error="error"
          :error-title="
            error.indexOf('权') >= 0
              ? '无权查看本场直播'
              : error.indexOf('不存在') >= 0
                ? '本场直播已下线'
                : '直播安排暂时无法读取'
          "
          :retryable="error.indexOf('权') < 0 && error.indexOf('不存在') < 0"
          :action-label="
            error.indexOf('权') >= 0 || error.indexOf('不存在') >= 0 ? '返回直播列表' : ''
          "
          @action="openPage('live/index')"
          @retry="load"
        />
        <view v-else>
          <view v-if="error" class="refresh-warning"
            ><text class="ui-text refresh-text">安排暂未更新，请重试。</text
            ><button
              class="ui-button refresh-action"
              :class="loading ? 'is-disabled' : ''"
              @click="load"
              >刷新安排</button
            ></view
          >
          <view class="live-detail-hero">
            <ArtImage
              :src="room!.cover"
              kind="landscape"
              :width="width"
              :height="240"
              :radius="14"
            />
            <view class="live-detail-shade">
              <view class="row between"
                ><text class="ui-text eyebrow eyebrow-light"
                  >LIVE · {{ categories[room!.categoryCode] ?? '书院直播' }}</text
                ><text class="ui-text pill pill-gold">{{ accessLabel }}</text></view
              >
              <text class="ui-text live-detail-title">{{ room!.title }}</text>

              <view class="live-detail-host"
                ><text class="ui-text live-detail-host-label">主讲</text
                ><text class="ui-text live-detail-host-name">{{ room!.teacher.name }}</text></view
              >
            </view>
          </view>
          <view class="live-outline"
            ><text class="ui-text section-heading">本场内容</text
            ><text class="ui-text body-copy live-outline-copy" :user-select="true">{{
              room!.summary
            }}</text
            ><text v-if="room!.managedByAdmin" class="ui-text footer-note"
              >全部有效会员均可观看，不预约也能直接进入直播。</text
            ><text v-if="!room!.rtcReady" class="ui-text footer-note"
              >直播观看通道正在维护，暂时不能进入；预告、预约与回放入口不受影响。</text
            ></view
          >
          <view v-if="!room!.managedByAdmin" class="section-head live-head"
            ><view
              ><text class="ui-text eyebrow">场次安排</text
              ><text class="ui-text section-heading">研习安排</text></view
            ><text class="ui-text section-link">{{ room!.sessions.length }} 场</text></view
          >
          <view
            v-for="s in room!.sessions"
            :key="s.id"
            :class="['session', s.state === 'LIVE' ? 'session-live' : '']"
          >
            <view class="row between session-top">
              <view
                :class="[
                  'pill',
                  'session-pill',
                  s.state === 'LIVE'
                    ? 'pill-live'
                    : s.state === 'PREPARING' || s.replayReady
                      ? 'pill-gold'
                      : 'pill-muted',
                ]"
                ><view v-if="s.state === 'LIVE'" class="pill-dot" /><text
                  class="ui-text pill-text"
                  >{{
                    s.disconnected
                      ? '断流重连中'
                      : overdue(s)
                        ? '等待开播'
                        : (states[s.state] ?? s.state)
                  }}</text
                ></view
              >
              <text v-if="s.reserved" class="ui-text pill pill-teal session-pill">已预约</text>
            </view>
            <text v-if="!room!.managedByAdmin" class="ui-text session-title">{{ s.title }}</text>
            <view class="session-time"
              ><AppIcon name="calendar-blank" :size="14" /><text
                class="ui-text session-time-text"
                >{{ formatChinaTime(s.scheduledAt) }}</text
              ><text class="ui-text session-zone">北京时间</text></view
            >
            <text v-if="overdue(s)" class="ui-text session-hint"
              >已到开播时间，等待书院开播；开播后可从这里进入。</text
            >
            <text v-if="s.accessReason && s.state !== 'CANCELLED'" class="ui-text session-hint">{{
              s.accessReason
            }}</text>
            <view class="session-actions"
              ><button
                v-if="s.state === 'LIVE'"
                class="ui-button primary-button session-cta"
                :class="busy ? 'is-disabled' : ''"
                @click="watch(s, false)"
                >进入直播</button
              ><button
                v-if="s.replayReady"
                class="ui-button primary-button session-cta"
                :class="busy ? 'is-disabled' : ''"
                @click="watch(s, true)"
                >观看回放</button
              >
              <button
                class="ui-button"
                v-if="['SCHEDULED', 'PREPARING'].includes(s.state) && (!overdue(s) || s.reserved)"
                :class="[
                  'session-cta',
                  s.reserved ? 'secondary-button' : 'primary-button',
                  busy ? 'is-disabled' : '',
                ]"
                @click="reserve(s)"
                >{{ s.reserved ? '取消预约' : '预约本场' }}</button
              ></view
            >
            <text v-if="s.state === 'ENDED' && !s.replayReady" class="ui-text session-hint">{{
              replayMessage(s.replayStatus)
            }}</text
            ><text v-if="s.state === 'CANCELLED'" class="ui-text session-hint"
              >本场已取消，可关注书院其他研习安排。</text
            >
          </view>
          <ContentState
            v-if="!room!.sessions.length"
            title="暂无开播安排"
            description="新的研习安排将在这里公布。"
          />
          <view class="live-notes">
            <text class="ui-text section-heading">观看说明</text>
            <view class="live-note"
              ><text class="ui-text live-note-text"
                >预约本场后，开播前会通过「我的 · 消息」提醒；开播后即可进入观看。</text
              ></view
            >
            <view class="live-note"
              ><text class="ui-text live-note-text"
                >直播中可参与提问、投票与共研；发言经审核后向同窗公开。</text
              ></view
            >
            <view class="live-note"
              ><text class="ui-text live-note-text"
                >回放生成后在原入口观看，直播与回放使用相同观看权限。</text
              ></view
            >
          </view>

          <button
            v-if="room!.courseId"
            class="ui-button secondary-button"
            @click="goCourse(room!.courseId!)"
            >查看相关课程</button
          ><button
            v-if="room!.accessRule.mode === 'MEMBER'"
            class="ui-button secondary-button"
            @click="openPage('membership/index')"
            >查看会员权益</button
          ><RelatedContent ref="relatedRef" :resourceId="id" />
        </view> </view></scroll-view
  ></view>
</template>
<script setup lang="ts">
import InkBackdrop from '../../components/InkBackdrop.uvue';
import RelatedContent from '../../components/RelatedContent.uvue';
import ArtImage from '../../components/ArtImage.uvue';
import AppIcon from '../../components/AppIcon.uvue';
import PageHead from '../../components/PageHead.uvue';
import ContentState from '../../components/ContentState.uvue';
import { formatChinaTime } from '../../lib/date-time';
import { request, goCourse } from '../../lib/api';
import { needLogin } from '../../lib/session';
import { openPage, viewWidth } from '../../lib/presentation';
type LiveSession = {
  id: string;
  title: string;
  scheduledAt: string;
  state: string;
  reserved: boolean;
  disconnected: boolean;
  accessReason: string;
  replayReady: boolean;
  replayStatus?: string | null;
};
type LiveTeacher = { name: string };
type AccessRule = { mode: string; tier?: number };
type Live = {
  cover?: string;
  managedByAdmin?: boolean;
  title: string;
  summary: string;
  categoryCode: string;
  teacher: LiveTeacher;
  courseId: string | null;
  accessRule: AccessRule;
  rtcReady: boolean;
  sessions: LiveSession[];
};
const room = ref<Live | null>(null),
  error = ref(''),
  loading = ref(false),
  busy = ref(false),
  relatedRef = ref<InstanceType<typeof RelatedContent> | null>(null),
  width = viewWidth(),
  now = ref(Date.now());
let id = '',
  timer: ReturnType<typeof setInterval> | null = null,
  clock: ReturnType<typeof setInterval> | null = null;
const states: Record<string, string> = {
    SCHEDULED: '直播预告',
    PREPARING: '准备开播',
    LIVE: '直播中',
    ENDED: '已结束',
    REPLAY_READY: '回放就绪',
    CANCELLED: '已取消',
  },
  categories: Record<string, string> = {
    CULTURE: '文化讲解',
    QA: '研习答疑',
    PRACTICE: '实践教学',
    MEMBER: '会员专属',
    EVENT: '活动同步',
  };
const accessLabel = computed(() =>
  room.value?.accessRule.mode === 'MEMBER'
    ? '会员研习'
    : room.value?.accessRule.mode === 'COURSE'
      ? '课程学员专享'
      : '公开研习',
);
// A session the host never started keeps state SCHEDULED, so its start time, not only its state, has to drive the label.
function overdue(s: LiveSession) {
  return s.state === 'SCHEDULED' && Date.parse(s.scheduledAt) < now.value;
}
function replayMessage(state?: string | null) {
  return state === 'FAILED'
    ? '回放暂未就绪，书院正在处理，请稍后查看。'
    : state === 'READY'
      ? '回放正在确认内容，发布后可在此观看。'
      : ['WAITING', 'STARTING', 'ARMED', 'RECORDING', 'PROCESSING'].includes(state ?? '')
        ? '本场已结束，回放正在生成，请稍后查看。'
        : '本场已结束，回放发布后可在此观看。';
}
async function load() {
  if (!id || loading.value) return;
  now.value = Date.now();
  loading.value = true;
  error.value = '';
  try {
    room.value = await request('/live/rooms/' + encodeURIComponent(id));
  } catch (e) {
    error.value = (e as Error).message;
    if (!room.value) uni.showToast({ title: error.value, icon: 'none' });
  } finally {
    loading.value = false;
  }
}
async function watch(s: LiveSession, replay: boolean) {
  if (busy.value || needLogin('live/detail?id=' + id)) return;
  busy.value = true;
  try {
    const latest = await request<Live>('/live/rooms/' + encodeURIComponent(id));
    room.value = latest;
    const current = latest.sessions.find((row) => row.id === s.id);
    if (!current) throw new Error('本场安排已更新，请重新选择');
    if (current.accessReason) throw new Error(current.accessReason);
    if (replay && !current.replayReady) throw new Error('本场回放尚未发布');
    if (!replay && current.state !== 'LIVE') throw new Error('本场当前未开播，请查看最新安排');
    if (!replay && !latest.rtcReady) throw new Error('直播观看尚未开通，请稍后再试');
    openPage('live/watch?id=' + s.id + '&roomId=' + id + (replay ? '&mode=replay' : ''));
  } catch (e) {
    uni.showToast({ title: (e as Error).message, icon: 'none' });
  } finally {
    busy.value = false;
  }
}
async function reserve(s: LiveSession) {
  if (needLogin('live/detail?id=' + id) || busy.value) return;
  busy.value = true;
  try {
    await request('/live/sessions/' + s.id + '/reservation', {
      method: 'POST',
      data: { action: s.reserved ? 'CANCEL' : 'RESERVE' },
    });
    uni.showToast({ title: s.reserved ? '已取消预约' : '预约成功，开播前会提醒你', icon: 'none' });
    await load();
  } catch (e) {
    uni.showToast({ title: (e as Error).message, icon: 'none' });
  } finally {
    busy.value = false;
  }
}
onLoad((o) => {
  id = o?.id ?? '';
  load();
});
onShow(() => {
  if (id) load();
  relatedRef.value?.refresh();
  if (!timer)
    timer = setInterval(() => {
      if (room.value?.sessions.some((s) => ['PREPARING', 'LIVE'].includes(s.state))) load();
    }, 15000);
  if (!clock) clock = setInterval(() => (now.value = Date.now()), 30000);
});
function stop() {
  if (timer) clearInterval(timer);
  timer = null;
  if (clock) clearInterval(clock);
  clock = null;
}
onHide(stop);
onUnload(stop);
</script>
<style>
@import '../../styles/app.css';
.live-detail-hero {
  position: relative;
  border-radius: 14px;
  overflow: hidden;
}
.live-detail-shade {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(24, 43, 49, 0.54);
  padding: 16px;
}
.live-detail-title {
  font-family: AcademySerif;
  font-size: 24px;
  line-height: 34px;
  max-height: 68px;
  overflow: hidden;
  color: #fcf9f2;
  letter-spacing: 0.4px;
  margin-top: 16px;
}
.live-detail-host {
  flex-direction: row;
  align-items: center;
  margin-top: 12px;
}
.live-detail-host-label {
  font-size: 11px;
  line-height: 17px;
  color: #e9d7b8;
  letter-spacing: 0.6px;
  border-right-width: 1px;
  border-right-style: solid;
  border-right-color: rgba(233, 215, 184, 0.35);
  padding-right: 8px;
}
.live-detail-host-name {
  font-size: 13px;
  line-height: 22px;
  color: #f1e8d8;
  margin-left: 8px;
}
.live-outline {
  padding: 16px 0 0;
}
.live-outline-copy {
  margin-top: 12px;
}
.live-head {
  margin-top: 24px;
  margin-bottom: 8px;
}
.session {
  background-color: #fcf9f2;
  border-style: solid;
  border-width: 1px;
  border-color: #cfc5b1;
  border-radius: 14px;
  padding: 16px;
  margin-top: 12px;
}
.session-live {
  background-color: #f0eadd;
  border-color: #cfc5b1;
}
.session-top {
  margin-bottom: 12px;
}
/* 场次状态胶囊不压缩、不换行；日期与「北京时间」各自单行。 */
.session-pill {
  flex-shrink: 0;
  white-space: nowrap;
  margin-right: 8px;
}
.session-title {
  font-family: AcademySerif;
  font-size: 17px;
  line-height: 26px;
  font-weight: 600;
  color: #182b31;
  max-height: 52px;
  overflow: hidden;
}
.session-time {
  flex-direction: row;
  align-items: center;
  margin-top: 8px;
}
.session-time-text {
  font-size: 12px;
  line-height: 20px;
  color: #344c54;
  margin-left: 4px;
  white-space: nowrap;
  flex-shrink: 0;
}
.session-zone {
  font-size: 12px;
  line-height: 20px;
  color: #7a847f;
  margin-left: 8px;
  flex-shrink: 0;
  white-space: nowrap;
}
.session-hint {
  font-size: 12px;
  line-height: 20px;
  color: #5c6869;
  margin-top: 8px;
}
.session-actions {
  margin-top: 16px;
}
.session-cta {
  width: 100%;
  margin-top: 0;
  min-height: 48px;
}
.refresh-warning {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 12px 14px;
  background-color: #f0eadd;
  border-radius: 10px;
  margin-bottom: 16px;
}
.refresh-text {
  flex: 1;
  min-width: 0;
  font-size: 12px;
  line-height: 20px;
  color: #5c6869;
  padding-right: 12px;
}
.refresh-action {
  flex-shrink: 0;
  font-size: 13px;
  line-height: 22px;
  color: #235663;
  background-color: transparent;
  border-width: 0;
  padding: 10px 0;
  min-height: 44px;
  margin: 0;
}
.live-notes {
  background-color: #fcf9f2;
  border-style: solid;
  border-width: 1px;
  border-color: #cfc5b1;
  border-radius: 14px;
  padding: 16px;
  margin-top: 24px;
}
.live-note {
  flex-direction: row;
  align-items: flex-start;
  margin-top: 8px;
}
.live-note-text {
  flex: 1;
  font-size: 13px;
  line-height: 22px;
  color: #5c6869;
}
</style>
