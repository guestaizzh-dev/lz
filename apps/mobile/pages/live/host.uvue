<template><view class="page"><PageHead title="我的直播"/><scroll-view class="page-scroll" direction="vertical"><view class="content">
<ContentState v-if="loading||error" :loading="loading" :error="error" @retry="load"/>
<view v-if="selected" class="host-session"><text class="section-heading">{{selected!.title}}</text><text class="meta">北京时间 {{formatChinaTime(selected!.scheduledAt)}} · {{stateLabel(selected!.state)}}</text><NativeRtc v-if="key" :key="key" :leaseKey="key" mode="LIVE" :height="height"/><button v-if="['SCHEDULED','PREPARING','LIVE'].includes(selected!.state)&&!key" class="primary-button" :disabled="busy" @click="prepare">{{selected!.state==='SCHEDULED'?'准备本场直播':'进入开播台'}}</button><button v-if="['PREPARING','LIVE'].includes(selected!.state)" class="secondary-button" :disabled="busy" @click="end">结束本场直播</button><text class="footer-note">准备后点击「开始推流」并允许设备权限。实际推流后场次才会变为直播中；网络恢复不会重复发送开播提醒。</text></view>
<text class="section-heading">我的场次</text><view v-for="item in items" :key="item.id" class="host-row" @click="select(item)"><text class="host-title">{{item.title}}</text><text class="meta">{{formatChinaTime(item.scheduledAt)}} · {{stateLabel(item.state)}}</text><text class="host-enter">{{item.id===selected?.id?'当前场次':'进入场次 ›'}}</text></view><ContentState v-if="!loading&&!error&&!items.length" title="暂无负责的场次" description="运营为你的名师账号安排直播场次后，会在这里显示。"/>
</view></scroll-view></view></template>
<script setup lang="ts">
import {purchasePlatform} from '../../lib/course-sales';
import PageHead from '../../components/PageHead.uvue';import ContentState from '../../components/ContentState.uvue';import NativeRtc from '../../components/NativeRtc.uvue';import {request} from '../../lib/api';import {needLogin} from '../../lib/session';import {formatChinaTime} from '../../lib/date-time';import {viewWidth} from '../../lib/presentation';
type Session={id:string;title:string;state:string;version:number;scheduledAt:string;roomId:string};const items=ref<Session[]>([]),selected=ref<Session|null>(null),key=ref(''),loading=ref(false),error=ref(''),busy=ref(false),height=Math.round(viewWidth()*0.75);let requestedId='',visible=false;
const stateLabel=(state:string)=>({SCHEDULED:'待开播',PREPARING:'准备中',LIVE:'直播中',ENDED:'已结束',REPLAY_READY:'回放已发布',CANCELLED:'已取消'} as Record<string,string>)[state]??'待更新';
async function load(){if(needLogin('/pages/live/host'))return;loading.value=true;error.value='';try{items.value=await request<Session[]>('/live/hosting');if(!key.value)selected.value=items.value.find(s=>s.id===(selected.value?.id??requestedId))??items.value.find(s=>['LIVE','PREPARING','SCHEDULED'].includes(s.state))??items.value[0]??null;}catch(e){error.value=(e as Error).message;}finally{loading.value=false;}}
function select(item:Session){if(busy.value)return;if(key.value&&selected.value?.id!==item.id){uni.showModal({title:'离开当前开播台？',content:'离开会停止采集；场次不会被自动改成结束。',success:r=>{if(r.confirm){key.value='';selected.value=item;}}});return;}selected.value=item;}
async function prepare(){if(purchasePlatform()==='WEB'){uni.showToast({title:'请在Android或iOS App内开播；电脑开播请使用后台我的直播',icon:'none'});return;}if(!selected.value||busy.value)return;busy.value=true;try{if(selected.value.state==='SCHEDULED')await request('/live/sessions/'+selected.value.id+'/host-state',{method:'POST',data:{expectedVersion:selected.value.version,action:'PREPARE',reason:'老师App准备开播'}});await load();if(!selected.value)return;const lease=await request<{key:string}>('/live/sessions/'+selected.value.id+'/host',{method:'POST'});if(visible)key.value=lease.key;else await request('/live/rtc/leave',{method:'POST',data:{key:lease.key}});}catch(e){uni.showToast({title:(e as Error).message,icon:'none'});await load();}finally{busy.value=false;}}
function end(){if(!selected.value)return;uni.showModal({title:'结束本场直播？',content:'确认后会停止推流，学员不能继续进入本场。回放可由后台另行上传审核。',confirmText:'结束直播',success:async r=>{if(!r.confirm||!selected.value||busy.value)return;busy.value=true;try{const fresh=(await request<Session[]>('/live/hosting')).find(s=>s.id===selected.value?.id);if(!fresh)throw Error('场次不存在');await request('/live/sessions/'+fresh.id+'/host-state',{method:'POST',data:{expectedVersion:fresh.version,action:'END',reason:'老师App结束直播'}});key.value='';await load();}catch(e){uni.showToast({title:(e as Error).message,icon:'none'});}finally{busy.value=false;}}});}
onLoad(o=>{requestedId=o?.id??'';});onShow(()=>{visible=true;void load();});onHide(()=>{visible=false;key.value='';});onUnload(()=>{visible=false;key.value='';});
</script>
<style>@import '../../styles/app.css';.host-session{padding-bottom:22px;margin-bottom:16px;border-bottom-width:1px;border-bottom-color:#E3DCCF;}.host-row{padding:18px 0;border-bottom-width:1px;border-bottom-color:#E6E0D5;}.host-title{font-family:AcademySerif;font-size:17px;color:#182B31;line-height:26px;}.host-enter{font-size:13px;color:#235663;margin-top:8px;min-height:24px;}</style>
