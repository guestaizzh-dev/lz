<template><view class="page"><PageHead title="书院直播"/><scroll-view class="page-scroll" direction="vertical" :show-scrollbar="false"><view class="content"><view class="live-banner"><ArtImage kind="landscape" :width="width" :height="150"/><view class="live-shade"><text class="live-title">道学，在相遇中传承</text><text class="live-subtitle">经典讲解 · 研习答疑 · 生活实践</text></view></view><text class="section-heading live-heading">直播研习与安排</text><ContentState v-if="loading&&!items.length||error" :loading="loading&&!items.length" :error="error" @retry="load(failedAppend)"/><view v-for="item in items" :key="item.id" class="live-row" hover-class="live-row-active" @click="openContent(item)"><text class="item-title">{{item.title}}</text><text class="article-summary">{{item.summary}}</text><text class="section-link live-link">查看安排 ›</text></view><ContentState v-if="!loading&&!error&&!items.length" title="暂无已发布直播" description="书院发布直播资料后，会在这里展示主题和安排。"/><button v-if="hasMore" class="secondary-button" :disabled="loading" @click="load(true)">查看更多</button><text class="footer-note">提前预约研习，开播时在书院相遇。</text></view></scroll-view></view></template>
<script setup lang="ts">import PageHead from '../../components/PageHead.uvue';import ArtImage from '../../components/ArtImage.uvue';import ContentState from '../../components/ContentState.uvue';import {request} from '../../lib/api';import {viewWidth} from '../../lib/presentation';import {openContent} from '../../lib/discovery';import type {DiscoveryItem} from '../../lib/discovery';const width=viewWidth(),items=ref<DiscoveryItem[]>([]),loading=ref(false),error=ref(''),hasMore=ref(false);let page=1,failedAppend=false;async function load(append=false){if(loading.value)return;failedAppend=append;loading.value=true;error.value='';try{const next=append?page+1:1,result=await request<{items:DiscoveryItem[];hasMore:boolean}>('/discovery/search?type=LIVE&sort=recent&page='+next);items.value=append?[...items.value,...result.items]:result.items;page=next;hasMore.value=result.hasMore;}catch(e){error.value=(e as Error).message;}finally{loading.value=false;}}onShow(()=>load());</script>
<style>@import '../../styles/app.css';.live-banner{position:relative;border-radius:4px;overflow:hidden;}.live-shade{position:absolute;left:0;top:0;right:0;bottom:0;background-color:rgba(23,41,45,0.32);padding:32px 18px;}.live-title{font-family:AcademySerif;font-size:23px;color:#F4F0E7;line-height:34px;}.live-subtitle{font-size:12px;color:#F4F0E7;margin-top:12px;line-height:21px;}.live-heading{margin-top:24px;}.live-row{padding:18px 16px;margin-top:12px;background-color:#FAF8F2;border-width:1px;border-style:solid;border-color:#E2DCD1;border-radius:8px;}.live-row-active{background-color:#EDE8DE;}.live-link{padding-left:0;padding-top:10px;color:#245564;}</style>
