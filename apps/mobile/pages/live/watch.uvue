<template>
  <view :class="replay ? 'watch-document' : 'live-room-root'">
    <view v-if="!replay" id="liveStage" class="live-room" :style="{ height: stageHeight + 'px' }">
      <view class="room-video">
        <LivePlayer
          v-if="source && !error"
          :source="source"
          :height="stageHeight"
          :fit="videoFit"
          :muted="speakerMuted"
          :backgroundEnabled="backgroundAudio"
          immersive
          :controlsVisible="micOpen"
          @roomState="updateRtc"
          @closeControls="micOpen = false"
          @error="failed"
          @reconnect="load"
        />
      </view>
      <!-- #ifdef APP -->
      <view
        v-if="!panel && !micOpen && !roomFinished"
        class="room-video-touch"
        @click="cleanMode = !cleanMode"
      />
      <!-- #endif -->
      <!-- #ifdef WEB -->
      <view
        v-if="cleanMode && !panel && !micOpen && !roomFinished"
        class="room-video-touch"
        @click="cleanMode = false"
      />
      <!-- #endif -->
      <view v-if="!cleanMode" class="room-top-scrim" />
      <view v-if="!cleanMode" class="room-bottom-scrim" />
      <view v-if="!cleanMode" class="room-header" :style="{ paddingTop: safeTop + 8 + 'px' }">
        <view class="room-header-line">
          <view
            class="room-host"
            :style="{ maxWidth: Math.floor(stageWidth * 0.66) + 'px' }"
            role="button"
            aria-label="本场直播介绍"
            @click="panel = 'info'"
          >
            <image
              v-if="teacherPortrait"
              class="room-avatar"
              :src="teacherPortrait"
              mode="aspectFill"
            />
            <view v-else class="room-avatar room-avatar-placeholder"
              ><image class="room-avatar-icon" src="/static/icons/book-open-white.png"
            /></view>
            <view class="room-host-copy">
              <text class="ui-text room-host-name">{{ teacherName || '老子道学书院' }}</text>
              <view class="room-host-status"
                ><view
                  :class="['room-live-dot', rtcState === 'PLAYING' ? 'room-dot-playing' : '']"
                /><text class="ui-text room-host-caption">{{ connectionLabel }}</text></view
              >
            </view>
          </view>
          <view class="room-header-actions">
            <view
              role="button"
              class="room-circle"
              aria-label="分享直播"
              @click="shareContent('LIVE', roomId, title)"
              ><image class="room-toolbar-icon" src="/static/icons/share-network-white.png"
            /></view>
            <view role="button" class="room-circle" aria-label="退出直播间" @click="leaveRoom"
              ><image class="room-toolbar-icon" src="/static/icons/x-white.png"
            /></view>
          </view>
        </view>
        <view class="room-topic-line"
          ><text
            class="ui-text room-topic"
            :style="{ maxWidth: Math.floor(stageWidth * 0.75) + 'px' }"
            >{{ title || '书院直播' }}</text
          ><view class="room-topic-hit" @click="panel = 'info'"
        /></view>
      </view>
      <view
        v-if="!roomFinished && (!source || error || nativeWaiting)"
        class="room-play-state"
        :style="{ top: Math.max(safeTop + 110, Math.floor(stageHeight * 0.36)) + 'px' }"
      >
        <image
          class="room-state-icon"
          :src="
            error || ['ERROR', 'CLOSED'].includes(rtcState)
              ? '/static/icons/cloud-slash-white.png'
              : '/static/icons/video-camera-white.png'
          "
        />
        <text class="ui-text room-state-title">{{
          error || ['ERROR', 'CLOSED'].includes(rtcState)
            ? '连接暂时中断'
            : roomState === 'PREPARING'
              ? '主播正在准备'
              : '正在接入直播'
        }}</text>
        <text class="ui-text room-state-copy">{{
          error ||
          connectionError ||
          (roomState === 'PREPARING'
            ? '开播后画面将自动出现'
            : rtcState === 'RECONNECTING'
              ? '网络波动，正在恢复画面'
              : '正在等待主播画面，请稍候')
        }}</text>
        <button
          v-if="error || ['ERROR', 'CLOSED'].includes(rtcState)"
          class="ui-button room-retry"
          :disabled="loading"
          @click="load"
          ><text class="ui-text room-retry-label">{{
            loading ? '正在连接' : '重新连接'
          }}</text></button
        >
      </view>
      <view
        v-if="roomFinished"
        class="room-play-state"
        :style="{ top: Math.max(safeTop + 110, Math.floor(stageHeight * 0.32)) + 'px' }"
      >
        <image class="room-state-icon" src="/static/icons/video-camera-white.png" />
        <text class="ui-text room-state-title">{{
          roomState === 'CANCELLED' ? '直播已取消' : '本场直播已结束'
        }}</text>
        <text class="ui-text room-state-copy">{{
          roomState === 'REPLAY_READY'
            ? '回放已就绪，继续回顾精彩内容'
            : '感谢观看，回放就绪后可从本场入口观看'
        }}</text>
        <button
          v-if="roomState === 'REPLAY_READY'"
          class="ui-button room-retry"
          @click="switchReplay"
          ><text class="ui-text room-retry-label">观看回放</text></button
        >
        <button class="ui-button room-back" @click="leaveRoom"
          ><text class="ui-text room-back-label">返回直播列表</text></button
        >
      </view>
      <LiveDiscussion
        ref="discussionRef"
        v-if="id && key && !roomFinished"
        :sessionId="id"
        :leaseKey="key"
        immersive
        :clean="cleanMode"
        :notice="micNotice"
        @mic="openMic"
        @courses="panel = 'courses'"
        @more="panel = 'more'"
      />
      <LiveRoomSheet
        :visible="panel !== ''"
        :title="panelTitle"
        :dark="panel === 'more' || panel === 'info'"
        @close="panel = ''"
      >
        <LiveOffers v-if="panel === 'courses'" :sessionId="id" emptyHint />
        <LivePolls v-else-if="panel === 'polls'" :sessionId="id" emptyHint />
        <view v-else-if="panel === 'info'" class="room-info">
          <text class="ui-text room-info-title">{{ title || '书院直播' }}</text>
          <text class="ui-text room-info-copy">主讲：{{ teacherName || '老子道学书院' }}</text>
          <text v-if="roomSummary" class="ui-text room-info-copy">{{ roomSummary }}</text>
          <text class="ui-text room-info-note">{{
            lessonId
              ? '观看时长同步到课程学习档案'
              : '观看无需摄像头和麦克风权限，连麦前会单独征求你的同意'
          }}</text>
          <button
            v-if="teacherId"
            class="ui-button room-info-link"
            @click="openPage('teacher/detail?id=' + teacherId)"
            ><text class="ui-text room-menu-label">讲师介绍</text
            ><text class="ui-text room-menu-arrow">›</text></button
          >
          <button
            v-if="courseId"
            class="ui-button room-info-link"
            @click="
              openPage('course/player?id=' + courseId + (cohortId ? '&cohortId=' + cohortId : ''))
            "
            ><text class="ui-text room-menu-label">课程目录</text
            ><text class="ui-text room-menu-arrow">›</text></button
          >
        </view>
        <view v-else class="room-more">
          <text class="ui-text room-menu-caption">观看设置</text>
          <button class="ui-button room-menu-row" @click="speakerMuted = !speakerMuted"
            ><text class="ui-text room-menu-label">{{ speakerMuted ? '开启声音' : '静音' }}</text
            ><text class="ui-text room-menu-value">{{
              speakerMuted ? '声音已关闭' : '声音已开启'
            }}</text></button
          >
          <button
            class="ui-button room-menu-row"
            @click="
              cleanMode = true;
              panel = '';
            "
            ><text class="ui-text room-menu-label">清屏观看</text
            ><text class="ui-text room-menu-arrow">›</text></button
          >
          <button class="ui-button room-menu-row" @click="chooseVideoSizing"
            ><text class="ui-text room-menu-label">画面比例</text
            ><text class="ui-text room-menu-value">{{ videoSizingLabel }}</text></button
          >
          <button
            class="ui-button room-menu-row"
            @click="
              panel = '';
              load();
            "
            ><text class="ui-text room-menu-label">重新连接直播</text
            ><text class="ui-text room-menu-arrow">›</text></button
          >
          <!-- #ifdef APP-ANDROID -->
          <button class="ui-button room-menu-row" @click="backgroundAudio = !backgroundAudio">
            <text class="ui-text room-menu-label">后台聆听</text
            ><text class="ui-text room-menu-value">{{
              backgroundAudio ? '已开启' : '已关闭'
            }}</text>
          </button>
          <text class="ui-text room-menu-caption"
            >切换应用继续声音，摄像头暂停；通知栏可退出直播。</text
          >
          <!-- #endif -->
          <text class="ui-text room-menu-caption room-menu-section">本场内容</text>
          <button class="ui-button room-menu-row" @click="panel = 'info'"
            ><text class="ui-text room-menu-label">本场介绍与讲师</text
            ><text class="ui-text room-menu-arrow">›</text></button
          >
          <button class="ui-button room-menu-row" @click="panel = 'polls'"
            ><text class="ui-text room-menu-label">课堂投票与问卷</text
            ><text class="ui-text room-menu-arrow">›</text></button
          >
          <button class="ui-button room-menu-row" @click="leaveRoom"
            ><text class="ui-text room-menu-exit">退出直播间</text
            ><text class="ui-text room-menu-arrow">›</text></button
          >
        </view>
      </LiveRoomSheet>
    </view>
    <view v-else class="page"
      ><PageHead :title="replay ? '直播回放' : '书院直播'" /><scroll-view
        class="page-scroll"
        direction="vertical"
        ><view class="content">
          <ContentState v-if="loading || error" :loading="loading" :error="error" @retry="load" />
          <view v-if="source && !error"
            ><view class="watch-stage"
              ><video
                v-if="replay"
                id="liveReplay"
                :src="source"
                :initial-time="resume"
                :controls="true"
                :style="{ width: '100%', height: replayHeight + 'px' }"
                @timeupdate="track"
                @play="playing = true"
                @pause="pauseStudy"
                @ended="pauseStudy"
                @loadedmetadata="resumed"
                @error="failed" /><LivePlayer
                v-else
                :source="source"
                :height="playerHeight"
                @error="failed"
                @reconnect="load" /></view
            ><text class="ui-text detail-title watch-title">{{ title }}</text
            ><text class="ui-text watch-caption">{{
              replay ? '回放按本场研习权限开放' : '与书院相遇，共同研习经典'
            }}</text
            ><view class="watch-tools"
              ><view :class="['pill', replay ? 'pill-gold' : 'pill-live']"
                ><view v-if="!replay" class="pill-dot" /><text class="ui-text">{{
                  replay ? '往期研习 · 回放' : '线上共研 · 直播中'
                }}</text></view
              ><button
                class="ui-button watch-reconnect"
                :class="loading ? 'is-disabled' : ''"
                @click="load"
                >重新连接</button
              ></view
            ><text v-if="lessonId" class="ui-text watch-caption">{{
              replay ? '观看进度同步到课程学习档案' : '直播观看时长同步到课程学习档案'
            }}</text
            ><text v-if="syncError || studySync.pending" class="ui-text footer-note">{{
              syncError ||
              (studySync.blocked
                ? '部分研习记录需核验权限，已保留在本机。'
                : '本机已保存，待联网同步 ' + studySync.pending + ' 条记录。')
            }}</text
            ><button
              v-if="syncError || studySync.pending"
              class="ui-button retry"
              @click="retryStudy"
              >重试同步</button
            ><button
              v-if="courseId"
              class="ui-button retry"
              @click="
                openPage('course/player?id=' + courseId + (cohortId ? '&cohortId=' + cohortId : ''))
              "
              >返回课程目录 ›</button
            ><MediaTranscript
              v-if="replay && subtitles.length"
              :cues="subtitles"
              :position="position"
              @seek="seekReplay" /><view v-if="replay && notes" class="replay-notes"
              ><text class="ui-text section-heading">研习资料</text
              ><text class="ui-text body-copy" :user-select="true">{{ notes }}</text></view
            ><LivePolls :sessionId="id" /><LiveDiscussion
              :sessionId="id"
              :leaseKey="key" /><LiveOffers :sessionId="id"
          /></view>
          <text class="ui-text footer-note">{{
            replay
              ? '回顾本场研习，观看权限与原直播一致。'
              : '网络中断时会自动重连，长时间没有画面可点击「重新连接」。'
          }}</text>
        </view></scroll-view
      ></view
    ></view
  >
</template>
<script setup lang="ts">
import { appForeground } from '../../lib/app-lifecycle';
import { liveVideoFit } from '../../lib/live-video-fit';
import MediaTranscript from '../../components/MediaTranscript.uvue';
import type { SubtitleCue } from '../../lib/learning';
import LiveRoomSheet from '../../components/LiveRoomSheet.uvue';
import LivePolls from '../../components/LivePolls.uvue';
import PageHead from '../../components/PageHead.uvue';
import ContentState from '../../components/ContentState.uvue';
import LivePlayer from '../../components/LivePlayer.uvue';
import LiveDiscussion from '../../components/LiveDiscussion.uvue';
import LiveOffers from '../../components/LiveOffers.uvue';
import { request, apiBase, assetUrl } from '../../lib/api';
import { needLogin, currentUser, sessionGeneration } from '../../lib/session';
import type { StudyScope } from '../../lib/study-queue-state';
import { recordStudy, studySync, syncStudy, localStudy } from '../../lib/study-queue';
import type { LiveLessonState, LessonDetail } from '../../lib/learning';
import { openPage, viewWidth, shareContent } from '../../lib/presentation';
const windowInfo = uni.getWindowInfo(),
  stageHeight = ref(windowInfo.windowHeight),
  stageWidth = ref(windowInfo.windowWidth),
  safeTop = ref(Math.max(8, windowInfo.statusBarHeight ?? 0));
const videoFit = computed(() => liveVideoFit(videoSizing.value));
function chooseVideoSizing() {
  uni.showActionSheet({
    itemList: ['完整画面', '裁切铺满'],
    success: (r) => {
      videoSizing.value = ['contain', 'cover'][r.tapIndex] ?? 'contain';
    },
  });
}
const speakerMuted = ref(false),
  videoSizing = ref('contain'),
  nativeWaiting = ref(false),
  connectionError = ref(''),
  backgroundAudio = ref(true),
  backgroundReady = ref(false);
const videoSizingLabel = computed(
  () =>
    (({ auto: '自动适配', contain: '完整画面', cover: '裁切铺满' }) as Record<string, string>)[
      videoSizing.value
    ],
);
const panel = ref(''),
  micOpen = ref(false),
  cleanMode = ref(windowInfo.windowWidth > windowInfo.windowHeight),
  teacherName = ref(''),
  teacherPortrait = ref(''),
  teacherId = ref(''),
  roomSummary = ref(''),
  roomState = ref(''),
  rtcState = ref('CONNECTING'),
  micState = ref('');
const panelTitle = computed(
  () =>
    (
      ({
        info: '本场研习',
        courses: '课程与研习资料',
        polls: '课堂互动',
        more: '直播间设置',
      }) as Record<string, string>
    )[panel.value] ?? '本场研习',
);
const micNotice = computed(
  () =>
    (
      ({
        WAITING: '连麦申请已提交 · 等待邀请',
        APPROVED: '主播邀请你连麦 · 点击确认',
        CONNECTED: '正在连麦 · 点击管理',
      }) as Record<string, string>
    )[micState.value] ?? '',
);
const discussionRef = ref<InstanceType<typeof LiveDiscussion> | null>(null),
  activeMic = ref(false);
const connectionLabel = computed(() =>
  roomFinished.value
    ? '已结束'
    : loading.value
      ? '连接中'
      : roomState.value === 'PREPARING'
        ? '准备开播'
        : rtcState.value === 'PLAYING'
          ? '直播中'
          : rtcState.value === 'RECONNECTING'
            ? '恢复连接中'
            : rtcState.value === 'ERROR'
              ? '连接中断'
              : nativeWaiting.value
                ? '等待画面'
                : '连接中',
);
function updateRtc(value: {
  state: string;
  micState: string;
  consent: boolean;
  message?: string;
  backgroundReady?: boolean;
  videoWidth?: number;
  videoHeight?: number;
}) {
  rtcState.value = value.state;
  backgroundReady.value = value.backgroundReady === true;
  connectionError.value =
    value.message ?? (value.state === 'CLOSED' ? '已停止播放，点击重新连接可继续观看' : '');
  activeMic.value = value.consent;
  micState.value = value.micState;
  nativeWaiting.value = [
    'CONNECTING',
    'RECONNECTING',
    'CONNECTED',
    'IDLE',
    'ERROR',
    'CLOSED',
  ].includes(value.state);
}
function openMic() {
  // #ifdef WEB
  uni.showToast({ title: '连麦请在App中使用，网页可观看与发言', icon: 'none' });
  return;
  // #endif
  // #ifdef APP
  panel.value = '';
  micOpen.value = true;
  // #endif
}
function roomChrome(light: boolean) {
  // #ifdef APP
  uni.setNavigationBarColor({
    frontColor: light ? '#ffffff' : '#000000',
    backgroundColor: light ? '#0C1214' : '#F5F0E6',
  });
  // #endif
}
function keepAwake(value: boolean) {
  // #ifdef APP
  if (typeof uni.setKeepScreenOn === 'function') uni.setKeepScreenOn({ keepScreenOn: value });
  // #endif
}
function networkChanged(event: { isConnected: boolean }) {
  if (!alive || !visible || replay.value) return;
  if (!event.isConnected) {
    rtcState.value = 'RECONNECTING';
    nativeWaiting.value = true;
  } else if (error.value || !source.value) void load();
}
onBackPress((e) => {
  if (discussionRef.value?.dismiss()) return true;
  if (panel.value) {
    panel.value = '';
    return true;
  }
  if (micOpen.value) {
    micOpen.value = false;
    return true;
  }
  if (cleanMode.value) {
    cleanMode.value = false;
    return true;
  }
  if (e.from === 'backbutton' && activeMic.value) {
    leaveRoom();
    return true;
  }
  return false;
});
function leaveRoom() {
  const leave = () => {
    if (getCurrentPages().length > 1) uni.navigateBack();
    else uni.redirectTo({ url: '/pages/live/index' });
  };
  if (activeMic.value)
    uni.showModal({
      title: '结束连麦并退出？',
      content: '退出直播间会关闭你的麦克风和摄像头。',
      confirmText: '退出直播',
      success: (r) => {
        if (r.confirm) leave();
      },
    });
  else leave();
}
let rotated = windowInfo.windowWidth > windowInfo.windowHeight,
  beforeRotation = false;
onResize((e) => {
  stageHeight.value = e.size.windowHeight;
  stageWidth.value = e.size.windowWidth;
  safeTop.value = Math.max(8, uni.getWindowInfo().statusBarHeight ?? 0);
  const wide = e.size.windowWidth > e.size.windowHeight;
  panel.value = '';
  micOpen.value = false;
  if (wide && !rotated) {
    beforeRotation = cleanMode.value;
    cleanMode.value = true;
  } else if (!wide && rotated) cleanMode.value = beforeRotation;
  rotated = wide;
});
const subtitles = ref<SubtitleCue[]>([]),
  notes = ref('');
type ReplayTicket = { path: string; subtitles: SubtitleCue[]; notes: string };
const lessonId = ref(''),
  courseId = ref(''),
  cohortId = ref(''),
  syncError = ref('');
let studyOwner = '',
  studyGeneration = 0,
  studyReleaseId = '';
const source = ref(''),
  title = ref(''),
  loading = ref(false),
  error = ref(''),
  replay = ref(false),
  key = ref(''),
  id = ref(''),
  roomId = ref(''),
  resume = ref(0),
  playing = ref(false),
  replayHeight = Math.round((viewWidth() * 9) / 16),
  playerHeight = Math.ceil((viewWidth() * 9) / 16) + 98;
type RoomTeacher = { id: string; name: string; portrait: string | null };
type RoomSession = { id: string; title: string; state?: string };
type RoomDetail = { sessions: RoomSession[]; summary?: string; teacher?: RoomTeacher };
let studyTimer: ReturnType<typeof setInterval> | null = null,
  lastTick = 0,
  elapsed = 0,
  saving = false;
let timer: ReturnType<typeof setTimeout> | null = null,
  generation = 0,
  visible = true,
  alive = true,
  renewing = false,
  restorePlay = false,
  hiding: ReturnType<typeof setTimeout> | null = null;
const position = ref(0);
let leaving: Promise<void> | null = null;
async function release() {
  const saved = saveStudy();
  lastTick = 0;
  if (studyTimer) clearInterval(studyTimer);
  studyTimer = null;
  generation++;
  micOpen.value = false;
  activeMic.value = false;
  nativeWaiting.value = false;
  rtcState.value = 'CONNECTING';
  micState.value = '';
  source.value = '';
  backgroundReady.value = false;
  subtitles.value = [];
  notes.value = '';
  playing.value = false;
  if (timer) clearTimeout(timer);
  timer = null;
  const old = key.value;
  key.value = '';
  const previous = leaving,
    next = (async () => {
      await saved;
      if (previous) await previous;
      if (old)
        try {
          await request('/live/rtc/leave', { method: 'POST', data: { key: old } });
        } catch {}
    })();
  leaving = next;
  try {
    await next;
  } finally {
    if (leaving === next) leaving = null;
  }
}
function track(e: { detail: { currentTime: number } }) {
  position.value = e.detail.currentTime;
  const now = Date.now();
  if (playing.value && lastTick) elapsed += Math.min(2, Math.max(0, (now - lastTick) / 1000));
  lastTick = now;
}
function pauseStudy() {
  playing.value = false;
  lastTick = 0;
  void saveStudy();
}
async function saveStudy() {
  if (
    !lessonId.value ||
    !replay.value ||
    saving ||
    elapsed < 1 ||
    studyOwner !== currentUser.value?.id ||
    studyGeneration !== sessionGeneration()
  )
    return;
  saving = true;
  const seconds = Math.min(30, Math.floor(elapsed));
  try {
    recordStudy(
      {
        userId: studyOwner,
        courseId: courseId.value,
        releaseId: studyReleaseId,
        lessonId: lessonId.value,
        cohortId: cohortId.value,
      },
      position.value,
      seconds,
    );
    elapsed = Math.max(0, elapsed - seconds);
    syncError.value = '';
  } catch (e) {
    syncError.value = (e as Error).message;
  } finally {
    saving = false;
  }
}
function retryStudy() {
  void saveStudy();
  void syncStudy(true);
}

function seekReplay(seconds: number) {
  position.value = seconds;
  lastTick = 0;
  uni.createVideoContext('liveReplay')?.seek(seconds);
}
function resumed() {
  const context = uni.createVideoContext('liveReplay');
  if (resume.value > 0) context?.seek(resume.value);
  if (restorePlay) {
    context?.play();
    restorePlay = false;
  }
}
async function renewReplay() {
  if (!visible || !replay.value || renewing) return;
  renewing = true;
  const version = generation;
  try {
    const data = await request<ReplayTicket>('/live/sessions/' + id.value + '/replay-ticket', {
      method: 'POST',
    });
    if (version !== generation || !visible || studyGeneration !== sessionGeneration()) return;
    restorePlay = playing.value;
    resume.value = position.value;
    source.value = apiBase + data.path;
    subtitles.value = data.subtitles;
    notes.value = data.notes;
    timer = setTimeout(renewReplay, 4 * 60000);
  } catch (e) {
    if (version === generation) {
      if ([401, 403, 404, 409].includes((e as Error & { status: number }).status)) {
        source.value = '';
        subtitles.value = [];
        notes.value = '';
        error.value = (e as Error).message;
      } else timer = setTimeout(renewReplay, 15000);
    }
  } finally {
    renewing = false;
  }
}
let loginRequested = false,
  roomRefreshing = false;
let roomPoll: ReturnType<typeof setInterval> | null = null;
const roomFinished = computed(() =>
  ['ENDED', 'REPLAY_READY', 'CANCELLED'].includes(roomState.value),
);
async function refreshRoom() {
  if (replay.value || !visible || roomRefreshing || loading.value || !roomId.value) return;
  roomRefreshing = true;
  const current = generation;
  try {
    const room = await request<RoomDetail>('/live/rooms/' + roomId.value);
    if (current !== generation || !visible) return;
    roomState.value = room.sessions.find((s) => s.id === id.value)?.state ?? roomState.value;
    if (roomFinished.value && source.value) {
      await release();
      error.value = '';
    }
  } catch {
  } finally {
    roomRefreshing = false;
  }
}
function switchReplay() {
  replay.value = true;
  roomChrome(false);
  void load();
}
function stopRoomPoll() {
  if (roomPoll) clearInterval(roomPoll);
  roomPoll = null;
}
function startRoomPoll() {
  stopRoomPoll();
  if (!replay.value) roomPoll = setInterval(() => void refreshRoom(), 8000);
}

async function load() {
  if (!id.value || !roomId.value) {
    error.value = '直播入口不完整，请返回直播列表重新进入';
    return;
  }
  if (loading.value) return;
  if (!currentUser.value) {
    if (!loginRequested) {
      loginRequested = true;
      needLogin(
        'live/watch?id=' +
          id.value +
          '&roomId=' +
          roomId.value +
          (replay.value ? '&mode=replay' : '') +
          (lessonId.value ? '&lessonId=' + lessonId.value + '&courseId=' + courseId.value : ''),
      );
    } else error.value = '登录后可观看本场直播';
    return;
  }
  loginRequested = false;
  loading.value = true;
  error.value = '';
  const releasing = release(),
    version = generation;
  try {
    await releasing;
    if (version !== generation || !visible || !alive) return;
    studyOwner = currentUser.value?.id ?? '';
    studyGeneration = sessionGeneration();
    elapsed = 0;
    lastTick = 0;
    if (lessonId.value) {
      const live = await request<LiveLessonState>('/live/lessons/' + lessonId.value);
      if (live.id !== id.value) throw new Error('场次与课程章节不一致，请返回目录重新进入');
    }
    const room = await request<RoomDetail>('/live/rooms/' + roomId.value);
    if (version !== generation || !visible || studyGeneration !== sessionGeneration()) return;
    title.value = room.sessions.find((s) => s.id === id.value)?.title ?? '书院研习';
    teacherName.value = room.teacher?.name ?? '';
    teacherId.value = room.teacher?.id ?? '';
    teacherPortrait.value = assetUrl(room.teacher?.portrait);
    roomSummary.value = room.summary ?? '';
    roomState.value = room.sessions.find((s) => s.id === id.value)?.state ?? '';
    if (replay.value) {
      const data = await request<ReplayTicket>('/live/sessions/' + id.value + '/replay-ticket', {
        method: 'POST',
      });
      if (version !== generation || !visible || studyGeneration !== sessionGeneration()) return;
      if (lessonId.value) {
        const detail = await request<LessonDetail>(
          '/learning/lessons/' +
            lessonId.value +
            (cohortId.value ? '?cohortId=' + encodeURIComponent(cohortId.value) : ''),
        );
        if (version !== generation || !visible || studyGeneration !== sessionGeneration()) return;
        studyReleaseId = detail.releaseId;
        const scope: StudyScope = {
          userId: studyOwner,
          courseId: courseId.value,
          releaseId: studyReleaseId,
          lessonId: lessonId.value,
          cohortId: cohortId.value,
        };
        try {
          const local = localStudy(scope);
          position.value =
            local &&
            (!detail.progress?.lastEventAt || local.recordedAt >= detail.progress.lastEventAt)
              ? local.positionSeconds
              : (detail.progress?.positionSeconds ?? 0);
          recordStudy(scope, position.value, 0);
        } catch (e) {
          syncError.value = (e as Error).message;
        }
      }
      resume.value = position.value;
      source.value = apiBase + data.path;
      subtitles.value = data.subtitles;
      notes.value = data.notes;
      timer = setTimeout(renewReplay, 4 * 60000);
      if (lessonId.value) studyTimer = setInterval(() => void saveStudy(), 15000);
    } else {
      if (roomFinished.value) return;
      const data = await request<{ playerPath: string; key: string }>(
        '/live/sessions/' + id.value + '/join',
        { method: 'POST' },
      );
      if (version !== generation || !visible || studyGeneration !== sessionGeneration()) {
        await request('/live/rtc/leave', { method: 'POST', data: { key: data.key } });
        return;
      }
      key.value = data.key;
      nativeWaiting.value = true;
      source.value = apiBase + data.playerPath;
    }
  } catch (e) {
    if (version === generation) error.value = (e as Error).message;
  } finally {
    loading.value = false;
    if (alive && visible && version !== generation && !source.value) void load();
  }
}
function failed(message?: unknown) {
  if (!roomFinished.value)
    error.value =
      typeof message === 'string' && message ? message : '画面暂时无法播放，请检查网络后重新连接';
  void refreshRoom();
}
onLoad((o) => {
  lessonId.value = o?.lessonId ?? '';
  courseId.value = o?.courseId ?? '';
  id.value = o?.id ?? '';
  roomId.value = o?.roomId ?? '';
  replay.value = o?.mode === 'replay';
  cohortId.value = o?.cohortId ?? '';
  if (typeof uni.onNetworkStatusChange === 'function') uni.onNetworkStatusChange(networkChanged);
  load();
});
onShow(() => {
  if (hiding) clearTimeout(hiding);
  hiding = null;
  roomChrome(!replay.value);
  keepAwake(true);
  visible = true;
  startRoomPoll();
  if (id.value && !source.value) load();
});
onHide(() => {
  stopRoomPoll();
  keepAwake(false);
  roomChrome(false);
  visible = false;
  if (!replay.value && backgroundAudio.value && backgroundReady.value) {
    hiding = setTimeout(() => {
      hiding = null;
      if (!appForeground.value) return;
      void release();
    }, 100);
  } else void release();
});
onUnload(() => {
  if (hiding) clearTimeout(hiding);
  hiding = null;
  alive = false;
  if (typeof uni.offNetworkStatusChange === 'function') uni.offNetworkStatusChange(networkChanged);
  stopRoomPoll();
  keepAwake(false);
  roomChrome(false);
  visible = false;
  release();
});
</script>
