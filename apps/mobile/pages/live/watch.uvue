<template><view class="page"><PageHead :title="replay?'直播回放':'书院直播'"/><scroll-view class="page-scroll" direction="vertical"><view class="content">
  <ContentState v-if="loading||error" :loading="loading" :error="error" @retry="load"/>
  <view v-if="source&&!error"><video v-if="replay" id="liveReplay" :src="source" :initial-time="resume" :controls="true" :style="{width:'100%',height:replayHeight+'px'}" @timeupdate="track" @play="playing=true" @pause="pauseStudy" @ended="pauseStudy" @loadedmetadata="resumed" @error="failed"/><LivePlayer v-else :source="source" :height="playerHeight" @error="failed" @reconnect="load"/><text class="detail-title watch-title">{{title}}</text><text class="watch-caption">{{replay?'回放按本场研习权限开放':'与书院相遇，共同研习经典'}}</text><view class="watch-tools"><text class="watch-status">{{replay?'往期研习 · 回放':'线上共研 · 直播'}}</text><button class="watch-reconnect" :disabled="loading" @click="load">重新连接</button></view><text v-if="lessonId" class="watch-caption">{{replay?'观看进度同步到课程学习档案':'直播观看时长同步到课程学习档案'}}</text><text v-if="syncError||studySync.pending" class="footer-note">{{syncError||(studySync.blocked?'部分研习记录需核验权限，已保留在本机。':'本机已保存，待联网同步 '+studySync.pending+' 条记录。')}}</text><button v-if="syncError||studySync.pending" class="retry" @click="retryStudy">重试同步</button><button v-if="courseId" class="retry" @click="openPage('course/player?id='+courseId+(cohortId?'&cohortId='+cohortId:''))">返回课程目录 ›</button><MediaTranscript v-if="replay&&subtitles.length" :cues="subtitles" :position="position" @seek="seekReplay"/><view v-if="replay&&notes" class="replay-notes"><text class="section-heading">研习资料</text><text class="body-copy" :user-select="true">{{notes}}</text></view><LiveGifts v-if="!replay" :sessionId="id"/><LivePolls :sessionId="id"/><LiveDiscussion :sessionId="id" :leaseKey="key"/><LiveOffers :sessionId="id"/></view>
  <text class="footer-note">{{replay?'回顾本场研习，观看权限与原直播一致。':'网络中断时会自动重连，长时间没有画面可点击「重新连接」。'}}</text>
</view></scroll-view></view></template>
<script setup lang="ts">
import MediaTranscript from '../../components/MediaTranscript.uvue';import type {SubtitleCue} from '../../lib/learning';
import LiveGifts from '../../components/LiveGifts.uvue';
import LivePolls from '../../components/LivePolls.uvue';
import PageHead from '../../components/PageHead.uvue';import ContentState from '../../components/ContentState.uvue';import LivePlayer from '../../components/LivePlayer.uvue';import LiveDiscussion from '../../components/LiveDiscussion.uvue';import LiveOffers from '../../components/LiveOffers.uvue';
import {request,apiBase} from '../../lib/api';import {needLogin,currentUser,sessionGeneration} from '../../lib/session';import type {StudyScope} from '../../lib/study-queue-state';import {recordStudy,studySync,syncStudy,localStudy} from '../../lib/study-queue';import type {StudyProgress,LiveLessonState,LessonDetail} from '../../lib/learning';import {openPage,viewWidth} from '../../lib/presentation';
const subtitles=ref<SubtitleCue[]>([]),notes=ref('');type ReplayTicket={path:string;subtitles:SubtitleCue[];notes:string};
const lessonId=ref(''),courseId=ref(''),cohortId=ref(''),syncError=ref('');let studyOwner='',studyGeneration=0,studyReleaseId='';
const source=ref(''),title=ref(''),loading=ref(false),error=ref(''),replay=ref(false),key=ref(''),id=ref(''),roomId=ref(''),resume=ref(0),playing=ref(false),replayHeight=Math.round(viewWidth()*9/16),playerHeight=Math.ceil(viewWidth()*9/16)+98;
type RoomSession={id:string;title:string};type RoomDetail={sessions:RoomSession[]};
let studyTimer:ReturnType<typeof setInterval>|null=null,lastTick=0,elapsed=0,saving=false;
let timer:ReturnType<typeof setTimeout>|null=null,generation=0,visible=true,renewing=false,restorePlay=false;const position=ref(0);
async function release(){await saveStudy();lastTick=0;if(studyTimer)clearInterval(studyTimer);studyTimer=null;generation++;source.value='';subtitles.value=[];notes.value='';playing.value=false;if(timer)clearTimeout(timer);timer=null;const old=key.value;key.value='';if(old)try{await request('/live/rtc/leave',{method:'POST',data:{key:old}});}catch{}}
function track(e:{detail:{currentTime:number}}){position.value=e.detail.currentTime;const now=Date.now();if(playing.value&&lastTick)elapsed+=Math.min(2,Math.max(0,(now-lastTick)/1000));lastTick=now;}
function pauseStudy(){playing.value=false;lastTick=0;void saveStudy();}
async function saveStudy(){if(!lessonId.value||!replay.value||saving||elapsed<1||studyOwner!==currentUser.value?.id||studyGeneration!==sessionGeneration())return;saving=true;
  const seconds=Math.min(30,Math.floor(elapsed));
  try{recordStudy({userId:studyOwner,courseId:courseId.value,releaseId:studyReleaseId,lessonId:lessonId.value,cohortId:cohortId.value},position.value,seconds);elapsed=Math.max(0,elapsed-seconds);syncError.value='';}catch(e){syncError.value=(e as Error).message;}finally{saving=false;}}
function retryStudy(){void saveStudy();void syncStudy(true);}

function seekReplay(seconds:number){position.value=seconds;lastTick=0;uni.createVideoContext('liveReplay')?.seek(seconds);}
function resumed(){const context=uni.createVideoContext('liveReplay');if(resume.value>0)context?.seek(resume.value);if(restorePlay){context?.play();restorePlay=false;}}
async function renewReplay(){if(!visible||!replay.value||renewing)return;renewing=true;const version=generation;
  try{const data=await request<ReplayTicket>('/live/sessions/'+id.value+'/replay-ticket',{method:'POST'});if(version!==generation||!visible||studyGeneration!==sessionGeneration())return;restorePlay=playing.value;resume.value=position.value;source.value=apiBase+data.path;subtitles.value=data.subtitles;notes.value=data.notes;timer=setTimeout(renewReplay,4*60000);}
  catch(e){if(version===generation){if([401,403,404,409].includes((e as Error&{status:number}).status)){source.value='';subtitles.value=[];notes.value='';error.value=(e as Error).message;}else timer=setTimeout(renewReplay,15000);}}
  finally{renewing=false;}}
let loginRequested=false;
async function load(){if(!id.value||loading.value)return;if(!currentUser.value){if(!loginRequested){loginRequested=true;needLogin('live/watch?id='+id.value+'&roomId='+roomId.value+(replay.value?'&mode=replay':'')+(lessonId.value?'&lessonId='+lessonId.value+'&courseId='+courseId.value:''));}return;}loginRequested=false;loading.value=true;error.value='';await release();studyOwner=currentUser.value?.id??'';studyGeneration=sessionGeneration();elapsed=0;lastTick=0;const version=generation;
  try{if(lessonId.value){const live=await request<LiveLessonState>('/live/lessons/'+lessonId.value);if(live.id!==id.value)throw new Error('场次与课程章节不一致，请返回目录重新进入');}
    const room=await request<RoomDetail>('/live/rooms/'+roomId.value);title.value=room.sessions.find(s=>s.id===id.value)?.title??'书院研习';
    if(replay.value){const data=await request<ReplayTicket>('/live/sessions/'+id.value+'/replay-ticket',{method:'POST'});if(version!==generation||!visible||studyGeneration!==sessionGeneration())return;
      if(lessonId.value){const detail=await request<LessonDetail>('/learning/lessons/'+lessonId.value+(cohortId.value?'?cohortId='+encodeURIComponent(cohortId.value):''));if(version!==generation||!visible||studyGeneration!==sessionGeneration())return;studyReleaseId=detail.releaseId;const scope:StudyScope={userId:studyOwner,courseId:courseId.value,releaseId:studyReleaseId,lessonId:lessonId.value,cohortId:cohortId.value};try{const local=localStudy(scope);position.value=local&&(!detail.progress?.lastEventAt||local.recordedAt>=detail.progress.lastEventAt)?local.positionSeconds:detail.progress?.positionSeconds??0;recordStudy(scope,position.value,0);}catch(e){syncError.value=(e as Error).message;}}
      resume.value=position.value;source.value=apiBase+data.path;subtitles.value=data.subtitles;notes.value=data.notes;timer=setTimeout(renewReplay,4*60000);if(lessonId.value)studyTimer=setInterval(()=>void saveStudy(),15000);}
    else{const data=await request<{playerPath:string;key:string}>('/live/sessions/'+id.value+'/join',{method:'POST'});if(version!==generation||!visible||studyGeneration!==sessionGeneration()){await request('/live/rtc/leave',{method:'POST',data:{key:data.key}});return;}key.value=data.key;source.value=apiBase+data.playerPath;}
  }catch(e){if(version===generation)error.value=(e as Error).message;}finally{loading.value=false;}}
function failed(){error.value='画面暂时无法播放，请检查网络后重新连接';}
onLoad(o=>{lessonId.value=o?.lessonId??'';courseId.value=o?.courseId??'';id.value=o?.id??'';roomId.value=o?.roomId??'';replay.value=o?.mode==='replay';cohortId.value=o?.cohortId??'';load();});onShow(()=>{visible=true;if(id.value&&!source.value)load();});onHide(()=>{visible=false;release();});onUnload(()=>{visible=false;release();});
</script>
<style>@import '../../styles/app.css';.replay-notes{margin-top:24px;padding-top:16px;border-top-width:1px;border-top-style:solid;border-top-color:#DFD9CF;}.watch-title{margin-top:24px;font-size:23px;line-height:34px;}.watch-caption{font-size:13px;line-height:23px;color:#7A7366;margin-top:8px;margin-bottom:10px;}.watch-tools{flex-direction:row;align-items:center;justify-content:space-between;border-bottom-width:1px;border-bottom-style:solid;border-bottom-color:#DFD9CF;padding-bottom:8px;}.watch-status{font-size:12px;color:#807663;}.watch-reconnect{background-color:transparent;color:#245564;font-size:13px;line-height:24px;min-height:44px;padding:10px 8px;margin:0;border-width:0;}</style>
