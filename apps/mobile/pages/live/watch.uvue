.room-host-name,.room-topic{overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}.room-view-button:focus-visible,.room-clean-button:focus-visible{outline:2px solid #D6BB84;outline-offset:3px;}.live-room{min-height:0;}
