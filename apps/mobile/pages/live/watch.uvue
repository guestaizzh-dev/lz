@media(max-height:520px) and (orientation:landscape){.room-header{padding-top:8px!important}.room-host{height:42px}.room-topic-line{margin-top:6px}.room-top-scrim{height:110px}.room-bottom-scrim{height:130px}.room-play-state{top:24%;left:15%;right:15%}.room-clean-bar{top:8px!important}.room-clean-button{opacity:.7}.room-clean-button:hover{opacity:1}}
@media(prefers-reduced-motion:reduce){.live-room *{animation:none!important;transition:none!important}}
