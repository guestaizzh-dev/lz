<template><view :class="replay?'watch-document':'live-room-root'">
<view v-if="!replay" class="live-room" :style="{height:stageHeight+'px'}">
  <view class="room-video"><LivePlayer v-if="source&&!error" :source="source" :height="stageHeight" :fit="fillVideo?'cover':'contain'" :muted="speakerMuted" immersive :controlsVisible="micOpen" @roomState="updateRtc" @closeControls="micOpen=false" @error="failed" @reconnect="load"/></view>
  <view v-if="!cleanMode" class="room-top-scrim"/><view v-if="!cleanMode" class="room-bottom-scrim"/>
  <view v-if="!cleanMode" class="room-header" :style="{paddingTop:(safeTop+8)+'px'}"><view class="room-header-line"><view class="room-host" @click="panel='info'"><image v-if="teacherPortrait" class="room-avatar" :src="teacherPortrait" mode="aspectFill"/><view v-else class="room-avatar room-avatar-placeholder"><image class="room-avatar-icon" src="/static/icons/book-open-white.png"/></view><view class="room-host-copy"><text class="room-host-name">{{teacherName||'老子道学书院'}}</text><text class="room-host-caption">经典共读</text></view><text class="room-host-info">本场</text></view><view class="room-header-actions"><view class="room-circle" @click="shareContent('LIVE',roomId,title)"><image class="room-toolbar-icon" src="/static/icons/share-network-white.png"/></view><view class="room-circle" @click="leaveRoom"><image class="room-toolbar-icon" src="/static/icons/x-white.png"/></view></view></view><view class="room-topic-line"><text class="room-topic">{{title||'书院共研'}}</text><view class="room-live-dot"/><text class="room-live-label">{{connectionLabel}}</text></view></view>
  <view v-if="!roomFinished&&(!source||error||nativeWaiting)" class="room-play-state"><image class="room-state-icon" :src="error?'/static/icons/cloud-slash-white.png':'/static/icons/video-camera-white.png'"/><text class="room-state-title">{{error||rtcState==='ERROR'?'画面暂时中断':nativeWaiting?'正在等待主讲画面':'正在连接直播'}}</text><text class="room-state-copy">{{error||(rtcState==='ERROR'?(connectionError||'请检查网络后重新连接。'):'正在为你接入本场研习，请稍候')}}</text><button v-if="error||rtcState==='ERROR'" class="room-retry" :disabled="loading" @click="load">重新连接</button></view>

  <view v-if="roomFinished" class="room-play-state"><image class="room-state-icon" src="/static/icons/book-open-white.png"/><text class="room-state-title">{{roomState==='CANCELLED'?'本场直播已取消':'本场研习已结束'}}</text><text class="room-state-copy">{{roomState==='REPLAY_READY'?'回放已准备好，可以继续回顾本场内容。':'感谢相聚，回放就绪后可从本场入口观看。'}}</text><button v-if="roomState==='REPLAY_READY'" class="room-retry" @click="switchReplay">观看回放</button><button class="room-retry room-back" @click="leaveRoom">返回直播列表</button></view>
  <view v-if="cleanMode" class="room-clean-bar" :style="{top:(safeTop+12)+'px'}"><button class="room-clean-button" @click="cleanMode=false">恢复互动</button><button class="room-clean-button" aria-label="退出直播间" @click="leaveRoom">退出</button></view>
  <view v-if="!cleanMode&&!roomFinished" class="room-view-tools" :style="{top:(safeTop+108)+'px'}"><button class="room-view-button" @click="speakerMuted=!speakerMuted">{{speakerMuted?'开启声音':'静音'}}</button><button class="room-view-button" @click="cleanMode=true">清屏</button><button class="room-view-button" @click="fillVideo=!fillVideo">{{fillVideo?'原画':'铺满'}}</button></view>
  <LiveDiscussion ref="discussionRef" v-if="id&&key&&!roomFinished" :sessionId="id" :leaseKey="key" immersive :clean="cleanMode" :notice="micNotice" @mic="openMic" @courses="panel='courses'" @more="panel='more'"/>
  <LiveRoomSheet :visible="panel!==''" :title="panelTitle" @close="panel=''">
    <LiveOffers v-if="panel==='courses'" :sessionId="id" emptyHint/>
    <LivePolls v-else-if="panel==='polls'" :sessionId="id" emptyHint/>
    <view v-else-if="panel==='info'" class="room-info"><text class="room-info-title">{{title||'书院研习'}}</text><text class="body-copy">主讲：{{teacherName||'老子道学书院'}}</text><text v-if="roomSummary" class="body-copy">{{roomSummary}}</text><text class="footer-note">{{lessonId?'直播观看时长同步到课程学习档案。':'观看无需摄像头或麦克风权限，连麦须经邀请并由本人确认。'}}</text><button v-if="teacherId" class="secondary-button" @click="openPage('teacher/detail?id='+teacherId)">查看讲师介绍</button><button v-if="courseId" class="secondary-button" @click="openPage('course/player?id='+courseId+(cohortId?'&cohortId='+cohortId:''))">打开课程目录</button></view>
    <view v-else class="room-more"><button class="room-menu-row" @click="panel='info'">本场介绍与讲师 <text>›</text></button><button class="room-menu-row" @click="panel='polls'">课堂投票与问卷 <text>›</text></button><button class="room-menu-row" @click="cleanMode=!cleanMode;panel=''">{{cleanMode?'恢复评论':'清屏观看'}} <text>›</text></button><button class="room-menu-row" @click="fillVideo=!fillVideo;panel=''">{{fillVideo?'显示完整画面（适合课件）':'铺满屏幕'}} <text>›</text></button>
<button class="room-menu-row" @click="panel='';load()">重新连接直播 <text>›</text></button><button class="room-menu-row" @click="leaveRoom">退出直播间 <text>›</text></button></view>
  </LiveRoomSheet>
</view>
<view v-else class="page"><PageHead :title="replay?'直播回放':'书院直播'"/><scroll-view class="page-scroll" direction="vertical"><view class="content">
  <ContentState v-if="loading||error" :loading="loading" :error="error" @retry="load"/>
  <view v-if="source&&!error"><view class="watch-stage"><video v-if="replay" id="liveReplay" :src="source" :initial-time="resume" :controls="true" :style="{width:'100%',height:replayHeight+'px'}" @timeupdate="track" @play="playing=true" @pause="pauseStudy" @ended="pauseStudy" @loadedmetadata="resumed" @error="failed"/><LivePlayer v-else :source="source" :height="playerHeight" @error="failed" @reconnect="load"/></view><text class="detail-title watch-title">{{title}}</text><text class="watch-caption">{{replay?'回放按本场研习权限开放':'与书院相遇，共同研习经典'}}</text><view class="watch-tools"><view :class="['pill',replay?'pill-gold':'pill-live']"><view v-if="!replay" class="pill-dot"/><text>{{replay?'往期研习 · 回放':'线上共研 · 直播中'}}</text></view><button class="watch-reconnect" :class="loading?'is-disabled':''" @click="load">重新连接</button></view><text v-if="lessonId" class="watch-caption">{{replay?'观看进度同步到课程学习档案':'直播观看时长同步到课程学习档案'}}</text><text v-if="syncError||studySync.pending" class="footer-note">{{syncError||(studySync.blocked?'部分研习记录需核验权限，已保留在本机。':'本机已保存，待联网同步 '+studySync.pending+' 条记录。')}}</text><button v-if="syncError||studySync.pending" class="retry" @click="retryStudy">重试同步</button><button v-if="courseId" class="retry" @click="openPage('course/player?id='+courseId+(cohortId?'&cohortId='+cohortId:''))">返回课程目录 ›</button><MediaTranscript v-if="replay&&subtitles.length" :cues="subtitles" :position="position" @seek="seekReplay"/><view v-if="replay&&notes" class="replay-notes"><text class="section-heading">研习资料</text><text class="body-copy" :user-select="true">{{notes}}</text></view><LivePolls :sessionId="id"/><LiveDiscussion :sessionId="id" :leaseKey="key"/><LiveOffers :sessionId="id"/></view>
  <text class="footer-note">{{replay?'回顾本场研习，观看权限与原直播一致。':'网络中断时会自动重连，长时间没有画面可点击「重新连接」。'}}</text>
</view></scroll-view></view></view></template>
<script setup lang="ts">
import MediaTranscript from '../../components/MediaTranscript.uvue';import type {SubtitleCue} from '../../lib/learning';
import LiveRoomSheet from '../../components/LiveRoomSheet.uvue';
import LivePolls from '../../components/LivePolls.uvue';
import PageHead from '../../components/PageHead.uvue';import ContentState from '../../components/ContentState.uvue';import LivePlayer from '../../components/LivePlayer.uvue';import LiveDiscussion from '../../components/LiveDiscussion.uvue';import LiveOffers from '../../components/LiveOffers.uvue';
import {request,apiBase,assetUrl} from '../../lib/api';import {needLogin,currentUser,sessionGeneration} from '../../lib/session';import type {StudyScope} from '../../lib/study-queue-state';import {recordStudy,studySync,syncStudy,localStudy} from '../../lib/study-queue';import type {StudyProgress,LiveLessonState,LessonDetail} from '../../lib/learning';import {openPage,viewWidth,shareContent} from '../../lib/presentation';
const windowInfo=uni.getWindowInfo(),stageHeight=ref(windowInfo.windowHeight),safeTop=Math.max(8,windowInfo.statusBarHeight??0),safeBottom=windowInfo.safeAreaInsets?.bottom??0;
const speakerMuted=ref(false),fillVideo=ref(false),nativeWaiting=ref(false),connectionError=ref('');
const panel=ref(''),micOpen=ref(false),cleanMode=ref(false),teacherName=ref(''),teacherPortrait=ref(''),teacherId=ref(''),roomSummary=ref(''),roomState=ref(''),rtcState=ref('CONNECTING'),micState=ref('');
const panelTitle=computed(()=>({info:'本场研习',courses:'课程与研习资料',polls:'课堂互动',more:'直播间设置'} as Record<string,string>)[panel.value]??'本场研习');
const micNotice=computed(()=>({WAITING:'连麦申请已提交 · 等待邀请',APPROVED:'主播邀请你连麦 · 点击确认',CONNECTED:'正在连麦 · 点击管理'} as Record<string,string>)[micState.value]??'');
const discussionRef=ref<InstanceType<typeof LiveDiscussion>|null>(null),activeMic=ref(false);
const connectionLabel=computed(()=>roomFinished.value?'已结束':loading.value?'连接中':roomState.value==='PREPARING'?'准备开播':rtcState.value==='PLAYING'?'直播中':rtcState.value==='RECONNECTING'?'恢复连接中':rtcState.value==='ERROR'?'连接中断':nativeWaiting.value?'等待画面':'连接中');
function updateRtc(value:{state:string;micState:string;consent:boolean;message?:string}){rtcState.value=value.state;connectionError.value=value.state==='ERROR'?(value.message??''):'';activeMic.value=value.consent;micState.value=value.micState;nativeWaiting.value=['CONNECTING','RECONNECTING','CONNECTED','IDLE','ERROR'].includes(value.state);}
function openMic(){
 // #ifdef WEB
 uni.showToast({title:'连麦请在App中使用，网页可观看与发言',icon:'none'});return;
 // #endif
 // #ifdef APP
 panel.value='';micOpen.value=true;
 // #endif
}
function roomChrome(light:boolean){
 // #ifdef APP
 uni.setNavigationBarColor({frontColor:light?'#ffffff':'#000000',backgroundColor:light?'#0C1214':'#F5F0E6'});
 // #endif
}
function keepAwake(value:boolean){
 // #ifdef APP
 if(typeof uni.setKeepScreenOn==='function')uni.setKeepScreenOn({keepScreenOn:value});
 // #endif
}
function networkChanged(event:{isConnected:boolean}){if(!alive||!visible||replay.value)return;if(!event.isConnected){rtcState.value='RECONNECTING';nativeWaiting.value=true;}else if(error.value||!source.value)void load();}
onBackPress(e=>{if(discussionRef.value?.dismiss())return true;if(panel.value){panel.value='';return true;}if(micOpen.value){micOpen.value=false;return true;}if(cleanMode.value){cleanMode.value=false;return true;}if(e.from==='backbutton'&&activeMic.value){leaveRoom();return true;}return false;});
function leaveRoom(){const leave=()=>{if(getCurrentPages().length>1)uni.navigateBack();else uni.redirectTo({url:'/pages/live/index'});};if(activeMic.value)uni.showModal({title:'结束连麦并退出？',content:'退出直播间会关闭你的麦克风和摄像头。',confirmText:'退出直播',success:r=>{if(r.confirm)leave();}});else leave();}
let rotated=false,beforeRotation=false;
onResize(e=>{stageHeight.value=e.size.windowHeight;const wide=e.size.windowWidth>e.size.windowHeight;if(wide&&!rotated){beforeRotation=cleanMode.value;cleanMode.value=true;}else if(!wide&&rotated)cleanMode.value=beforeRotation;rotated=wide;});
const subtitles=ref<SubtitleCue[]>([]),notes=ref('');type ReplayTicket={path:string;subtitles:SubtitleCue[];notes:string};
const lessonId=ref(''),courseId=ref(''),cohortId=ref(''),syncError=ref('');let studyOwner='',studyGeneration=0,studyReleaseId='';
const source=ref(''),title=ref(''),loading=ref(false),error=ref(''),replay=ref(false),key=ref(''),id=ref(''),roomId=ref(''),resume=ref(0),playing=ref(false),replayHeight=Math.round(viewWidth()*9/16),playerHeight=Math.ceil(viewWidth()*9/16)+98;
type RoomTeacher={id:string;name:string;portrait:string|null};type RoomSession={id:string;title:string;state?:string};type RoomDetail={sessions:RoomSession[];summary?:string;teacher?:RoomTeacher};
let studyTimer:ReturnType<typeof setInterval>|null=null,lastTick=0,elapsed=0,saving=false;
let timer:ReturnType<typeof setTimeout>|null=null,generation=0,visible=true,alive=true,renewing=false,restorePlay=false;const position=ref(0);let leaving:Promise<void>|null=null;
async function release(){const saved=saveStudy();lastTick=0;if(studyTimer)clearInterval(studyTimer);studyTimer=null;generation++;micOpen.value=false;activeMic.value=false;nativeWaiting.value=false;rtcState.value='CONNECTING';micState.value='';source.value='';subtitles.value=[];notes.value='';playing.value=false;if(timer)clearTimeout(timer);timer=null;const old=key.value;key.value='';const previous=leaving,next=(async()=>{await saved;if(previous)await previous;if(old)try{await request('/live/rtc/leave',{method:'POST',data:{key:old}});}catch{}})();leaving=next;try{await next;}finally{if(leaving===next)leaving=null;}}
function track(e:{detail:{currentTime:number}}){position.value=e.detail.currentTime;const now=Date.now();if(playing.value&&lastTick)elapsed+=Math.min(2,Math.max(0,(now-lastTick)/1000));lastTick=now;}
function pauseStudy(){playing.value=false;lastTick=0;void saveStudy();}
async function saveStudy(){if(!lessonId.value||!replay.value||saving||elapsed<1||studyOwner!==currentUser.value?.id||studyGeneration!==sessionGeneration())return;saving=true;
  const seconds=Math.min(30,Math.floor(elapsed));
  try{recordStudy({userId:studyOwner,courseId:courseId.value,releaseId:studyReleaseId,lessonId:lessonId.value,cohortId:cohortId.value},position.value,seconds);elapsed=Math.max(0,elapsed-seconds);syncError.value='';}catch(e){syncError.value=(e as Error).message;}finally{saving=false;}}
function retryStudy(){void saveStudy();void syncStudy(true);}

function seekReplay(seconds:number){position.value=seconds;lastTick=0;uni.createVideoContext('liveReplay')?.seek(seconds);}
function resumed(){const context=uni.createVideoContext('liveReplay');if(resume.value>0)context?.seek(resume.value);if(restorePlay){context?.play();restorePlay=false;}}
async function renewReplay(){if(!visible||!replay.value||renewing)return;renewing=true;const version=generation;
  try{const data=await request<ReplayTicket>('/live/sessions/'+id.value+'/replay-ticket',{method:'POST'});if(version!==generation||!visible||studyGeneration!==sessionGeneration())return;restorePlay=playing.value;resume.value=position.value;source.value=apiBase+data.path;subtitles.value=data.subtitles;notes.value=data.notes;timer=setTimeout(renewReplay,4*60000);}
  catch(e){if(version===generation){if([401,403,404,409].includes((e as Error&{status:number}).status)){source.value='';subtitles.value=[];notes.value='';error.value=(e as Error).message;}else timer=setTimeout(renewReplay,15000);}}
  finally{renewing=false;}}
let loginRequested=false,roomRefreshing=false;let roomPoll:ReturnType<typeof setInterval>|null=null;
const roomFinished=computed(()=>['ENDED','REPLAY_READY','CANCELLED'].includes(roomState.value));
async function refreshRoom(){if(replay.value||!visible||roomRefreshing||loading.value||!roomId.value)return;roomRefreshing=true;const current=generation;try{const room=await request<RoomDetail>('/live/rooms/'+roomId.value);if(current!==generation||!visible)return;roomState.value=room.sessions.find(s=>s.id===id.value)?.state??roomState.value;if(roomFinished.value&&source.value){await release();error.value='';}}catch{}finally{roomRefreshing=false;}}
function switchReplay(){replay.value=true;roomChrome(false);void load();}
function stopRoomPoll(){if(roomPoll)clearInterval(roomPoll);roomPoll=null;}
function startRoomPoll(){stopRoomPoll();if(!replay.value)roomPoll=setInterval(()=>void refreshRoom(),8000);}

async function load(){if(!id.value||!roomId.value){error.value='直播入口不完整，请返回直播列表重新进入';return;}if(loading.value)return;if(!currentUser.value){if(!loginRequested){loginRequested=true;needLogin('live/watch?id='+id.value+'&roomId='+roomId.value+(replay.value?'&mode=replay':'')+(lessonId.value?'&lessonId='+lessonId.value+'&courseId='+courseId.value:''));}else error.value='登录后可观看本场直播';return;}loginRequested=false;loading.value=true;error.value='';const releasing=release(),version=generation;
  try{await releasing;if(version!==generation||!visible||!alive)return;studyOwner=currentUser.value?.id??'';studyGeneration=sessionGeneration();elapsed=0;lastTick=0;if(lessonId.value){const live=await request<LiveLessonState>('/live/lessons/'+lessonId.value);if(live.id!==id.value)throw new Error('场次与课程章节不一致，请返回目录重新进入');}
    const room=await request<RoomDetail>('/live/rooms/'+roomId.value);if(version!==generation||!visible||studyGeneration!==sessionGeneration())return;title.value=room.sessions.find(s=>s.id===id.value)?.title??'书院研习';teacherName.value=room.teacher?.name??'';teacherId.value=room.teacher?.id??'';teacherPortrait.value=assetUrl(room.teacher?.portrait);roomSummary.value=room.summary??'';roomState.value=room.sessions.find(s=>s.id===id.value)?.state??'';
    if(replay.value){const data=await request<ReplayTicket>('/live/sessions/'+id.value+'/replay-ticket',{method:'POST'});if(version!==generation||!visible||studyGeneration!==sessionGeneration())return;
      if(lessonId.value){const detail=await request<LessonDetail>('/learning/lessons/'+lessonId.value+(cohortId.value?'?cohortId='+encodeURIComponent(cohortId.value):''));if(version!==generation||!visible||studyGeneration!==sessionGeneration())return;studyReleaseId=detail.releaseId;const scope:StudyScope={userId:studyOwner,courseId:courseId.value,releaseId:studyReleaseId,lessonId:lessonId.value,cohortId:cohortId.value};try{const local=localStudy(scope);position.value=local&&(!detail.progress?.lastEventAt||local.recordedAt>=detail.progress.lastEventAt)?local.positionSeconds:detail.progress?.positionSeconds??0;recordStudy(scope,position.value,0);}catch(e){syncError.value=(e as Error).message;}}
      resume.value=position.value;source.value=apiBase+data.path;subtitles.value=data.subtitles;notes.value=data.notes;timer=setTimeout(renewReplay,4*60000);if(lessonId.value)studyTimer=setInterval(()=>void saveStudy(),15000);}
    else{if(roomFinished.value)return;const data=await request<{playerPath:string;key:string}>('/live/sessions/'+id.value+'/join',{method:'POST'});if(version!==generation||!visible||studyGeneration!==sessionGeneration()){await request('/live/rtc/leave',{method:'POST',data:{key:data.key}});return;}key.value=data.key;nativeWaiting.value=true;source.value=apiBase+data.playerPath;}
  }catch(e){if(version===generation)error.value=(e as Error).message;}finally{loading.value=false;if(alive&&visible&&version!==generation&&!source.value)void load();}}
function failed(message?:unknown){if(!roomFinished.value)error.value=typeof message==='string'&&message?message:'画面暂时无法播放，请检查网络后重新连接';void refreshRoom();}
onLoad(o=>{lessonId.value=o?.lessonId??'';courseId.value=o?.courseId??'';id.value=o?.id??'';roomId.value=o?.roomId??'';replay.value=o?.mode==='replay';cohortId.value=o?.cohortId??'';if(typeof uni.onNetworkStatusChange==='function')uni.onNetworkStatusChange(networkChanged);load();});onShow(()=>{roomChrome(!replay.value);keepAwake(true);visible=true;startRoomPoll();if(id.value&&!source.value)load();});onHide(()=>{stopRoomPoll();keepAwake(false);roomChrome(false);visible=false;release();});onUnload(()=>{alive=false;if(typeof uni.offNetworkStatusChange==='function')uni.offNetworkStatusChange(networkChanged);stopRoomPoll();keepAwake(false);roomChrome(false);visible=false;release();});
</script>
<style>@import '../../styles/app.css';.watch-stage{border-radius:12px;overflow:hidden;background-color:#182B31;}.replay-notes{margin-top:24px;padding-top:16px;border-top-width:1px;border-top-style:solid;border-top-color:#E3DCCF;}.watch-title{margin-top:20px;font-size:24px;line-height:34px;}.watch-caption{font-size:13px;line-height:23px;color:#6A7578;margin-top:8px;margin-bottom:10px;}.watch-tools{flex-direction:row;align-items:center;justify-content:space-between;border-bottom-width:1px;border-bottom-style:solid;border-bottom-color:#E3DCCF;padding-bottom:10px;margin-top:6px;}.watch-reconnect{background-color:transparent;color:#235663;font-size:13px;line-height:24px;min-height:44px;padding:10px 8px;margin:0;border-width:0;}
.watch-document{flex:1;}.live-room-root{flex:1;background-color:#0C1214;}.live-room{position:relative;width:100%;overflow:hidden;background-color:#0C1214;}.room-video{position:absolute;left:0;right:0;top:0;bottom:0;}.room-top-scrim{position:absolute;left:0;right:0;top:0;height:170px;background:linear-gradient(to bottom,rgba(0,0,0,0.62),rgba(0,0,0,0));pointer-events:none;}.room-bottom-scrim{position:absolute;left:0;right:0;bottom:0;height:310px;background:linear-gradient(to top,rgba(0,0,0,0.86),rgba(0,0,0,0));pointer-events:none;}.room-header{position:absolute;top:0;left:0;right:0;padding-left:14px;padding-right:10px;}.room-header-line{flex-direction:row;align-items:center;justify-content:space-between;}.room-host{min-width:0;width:68%;flex-shrink:1;height:50px;flex-direction:row;align-items:center;padding:4px 12px 4px 4px;margin:0;background-color:rgba(0,0,0,0.42);border-radius:30px;border-width:1px;border-style:solid;border-color:rgba(255,255,255,0.14);}.room-avatar{width:38px;height:38px;border-radius:22px;flex-shrink:0;}.room-avatar-placeholder{align-items:center;justify-content:center;background-color:#31413E;}.room-avatar-icon{width:24px;height:24px;}.room-host-copy{margin-left:8px;margin-right:10px;min-width:0;flex-shrink:1;}.room-host-name{font-family:AcademySans;font-size:15px;line-height:22px;color:#FFFFFF;font-weight:600;}.room-host-caption{font-family:AcademySans;font-size:11px;line-height:18px;color:#CDCDC6;}.room-host-info{font-family:AcademySans;color:#1D2422;background-color:#D6BB84;font-size:12px;line-height:22px;padding:2px 10px;border-radius:14px;flex-shrink:0;}.room-header-actions{flex-direction:row;align-items:center;flex-shrink:0;}.room-circle{width:44px;height:44px;flex-shrink:0;align-items:center;justify-content:center;margin:0 0 0 4px;padding:0;border-width:0;border-radius:22px;background-color:rgba(0,0,0,0.42);border-width:1px;border-style:solid;border-color:rgba(255,255,255,0.14);}.room-toolbar-icon{width:23px;height:23px;}.room-topic-line{flex-direction:row;align-items:center;margin-top:12px;}.room-topic{font-family:AcademySans;font-size:14px;line-height:22px;color:#F4F3EE;width:70%;flex-shrink:1;margin-right:10px;}.room-live-dot{width:6px;height:6px;border-radius:3px;background-color:#DD6F55;margin-right:5px;flex-shrink:0;}.room-live-label{font-size:11px;line-height:20px;color:#FFFFFF;}.room-play-state{position:absolute;top:33%;left:30px;right:30px;align-items:center;}.room-state-icon{width:38px;height:38px;margin-bottom:14px;opacity:0.7;}.room-state-title{font-size:17px;line-height:28px;color:#FFFFFF;}.room-state-copy{font-size:13px;line-height:23px;color:#B9C1BC;text-align:center;margin-top:8px;}.room-back{background-color:transparent;}
.room-retry{margin-top:18px;font-size:14px;line-height:22px;padding:11px 22px;border-radius:24px;background-color:#D6BB84;color:#182B31;border-width:0;}.room-poll-shortcut{position:absolute;right:14px;flex-direction:row;align-items:center;padding:7px 10px;margin:0;background-color:rgba(0,0,0,0.3);border-width:1px;border-style:solid;border-color:rgba(255,255,255,0.5);border-radius:20px;}.room-small-icon{width:17px;height:17px;margin-right:5px;}.room-shortcut-copy{font-size:11px;line-height:20px;color:#FFFFFF;}.room-info-title{font-family:AcademySerif;font-size:22px;line-height:33px;color:#182B31;margin-bottom:12px;}.room-menu-row{flex-direction:row;align-items:center;justify-content:space-between;min-height:54px;width:100%;padding:14px 0;margin:0;text-align:left;background-color:transparent;border-width:0;font-size:15px;line-height:24px;color:#182B31;}
.room-view-tools{position:absolute;right:12px;flex-direction:column;}.room-view-button{min-width:44px;min-height:40px;padding:8px 10px;margin:0 0 8px;border-width:1px;border-style:solid;border-color:rgba(255,255,255,0.18);background-color:rgba(0,0,0,0.4);border-radius:22px;color:#FFFFFF;font-size:11px;line-height:20px;}.room-clean-bar{position:absolute;right:12px;flex-direction:row;}.room-clean-button{min-height:44px;padding:10px 16px;margin:0 0 0 8px;border-width:0;border-radius:24px;background-color:rgba(0,0,0,0.5);color:#FFFFFF;font-size:13px;line-height:24px;}
