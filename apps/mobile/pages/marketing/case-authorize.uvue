<template>
  <view class="page"
    ><InkBackdrop /><PageHead title="授权课程案例" /><scroll-view
      class="page-scroll"
      direction="vertical"
      ><view class="content"
        ><ContentState
          v-if="loading || error"
          :loading="loading"
          :error="error"
          :error-title="kind && id ? '案例原文未能加载' : '缺少要授权的记录'"
          :retryable="!!(kind && id)"
          :action-label="kind && id ? '' : '返回书院共创'"
          @retry="load"
          @action="openPage('marketing/community')"
        /><view v-else
          ><text class="ui-text page-intro"
            >选定一段自己的心得，只提交下方明确选取的文字；原私人记录保持私密。</text
          ><text class="ui-text hint"
            >用于指定课程版本，须主讲点评与审核后展示；可在「书院共创 → 案例授权」撤回。</text
          ><input
            v-model="title"
            class="ui-input input"
            placeholder="案例标题"
            maxlength="120"
          /><picker
            :range="courses"
            range-key="title"
            :value="courseIndex"
            @change="courseIndex = Number($event.detail.value)"
            ><view class="input case-select"
              ><text class="ui-text">{{
                courses[courseIndex]?.title ?? '选择目标课程'
              }}</text></view
            ></picker
          ><textarea
            v-model="text"
            class="ui-input case-input"
            maxlength="10000"
            placeholder="编辑你愿意授权的选定心得，不要附上私人联系方式。"
          /><text class="ui-text hint"
            >作者授权说明：仅供所选课程版本的教学案例展示及主讲点评，无默认宣传或转授权；撤回后停止后续展示，不改变已售课程正文。</text
          ><view class="row case-consent" @click="consent = !consent"
            ><text class="ui-text body-copy"
              >{{ consent ? '☑' : '□' }} 我理解并同意以上授权范围</text
            ></view
          ><text v-if="notice" class="ui-text hint">{{ notice }}</text
          ><button
            class="ui-button primary-button"
            :disabled="
              busy ||
              !consent ||
              title.trim().length < 2 ||
              text.trim().length < 10 ||
              !courses.length
            "
            @click="submit"
            >提交授权与审核</button
          ></view
        ></view
      ></scroll-view
    ></view
  >
</template>
<script setup lang="ts">
import InkBackdrop from '../../components/InkBackdrop.uvue';
import PageHead from '../../components/PageHead.uvue';
import ContentState from '../../components/ContentState.uvue';
import { request } from '../../lib/api';
import { needLogin, currentUser } from '../../lib/session';
import { studyEventId } from '../../lib/learning';
import { openPage } from '../../lib/presentation';
type Course = { id: string; title: string; publishedReleaseId: string };
const title = ref(''),
  text = ref(''),
  consent = ref(false),
  courses = ref<Course[]>([]),
  courseIndex = ref(0),
  loading = ref(false),
  error = ref(''),
  busy = ref(false),
  notice = ref('');
let owner = '',
  kind = '',
  id = '',
  version = 0,
  key = studyEventId(),
  signature = '';
async function load() {
  if (needLogin()) return;
  loading.value = true;
  error.value = '';
  try {
    const [source, options] = await Promise.all([
      request<{ title: string; text: string; version: number }>(
        '/forum/private-sources/' + kind + '/' + id,
      ),
      request<{ items: Course[] }>('/community-enhancements/course-options'),
    ]);
    version = source.version;
    title.value = source.title.slice(0, 120);
    text.value = source.text;
    courses.value = options.items;
  } catch (e) {
    error.value = (e as Error).message;
  } finally {
    loading.value = false;
  }
}
async function submit() {
  if (busy.value || needLogin()) return;
  const body = {
    sourceKind: kind,
    sourceId: id,
    sourceVersion: version,
    releaseId: courses.value[courseIndex.value].publishedReleaseId,
    title: title.value.trim(),
    text: text.value.trim(),
    consent: consent.value,
  };
  if (signature !== JSON.stringify(body)) {
    signature = JSON.stringify(body);
    key = studyEventId();
  }
  busy.value = true;
  notice.value = '';
  try {
    await request('/me/community-enhancements/cases', {
      method: 'POST',
      data: { ...body, requestKey: key },
    });
    uni.showToast({ title: '授权已提交，等待主讲点评', icon: 'none' });
    openPage('marketing/community');
  } catch (e) {
    notice.value = (e as Error).message;
  } finally {
    busy.value = false;
  }
}
onLoad((o) => {
  kind = o?.kind ?? '';
  id = o?.id ?? '';
});
onShow(() => {
  if (owner !== (currentUser.value?.id ?? '')) {
    owner = currentUser.value?.id ?? '';
    title.value = '';
    text.value = '';
    consent.value = false;
    courses.value = [];
    key = studyEventId();
    signature = '';
  }
  void load();
});
</script>
<style>
@import '../../styles/app.css';
@import '../../styles/marketing.css';
/* 授权课程案例：页首 24/34 + 说明 13/22；标题与课程选择 44 高描边、正文描边圆角 10。 */
.content {
  padding-top: 16px;
  padding-bottom: 40px;
}
.page-title {
  font-family: AcademySerif;
  font-size: 24px;
  line-height: 34px;
  color: #182b31;
  font-weight: 600;
  letter-spacing: 0.4px;
}
.page-intro {
  font-family: sans-serif;
  font-size: 13px;
  line-height: 22px;
  color: #5c6869;
  margin-top: 8px;
}
.hint {
  font-family: sans-serif;
  font-size: 13px;
  line-height: 22px;
  color: #5c6869;
  margin-top: 12px;
}
.body-copy {
  font-family: sans-serif;
  font-size: 15px;
  line-height: 26px;
  color: #344c54;
}
.input {
  height: 44px;
  min-height: 44px;
  margin-top: 16px;
  padding: 0 12px;
  background-color: #fcf9f2;
  border-style: solid;
  border-width: 1px;
  border-color: #cfc5b1;
  border-radius: 10px;
  font-size: 15px;
  line-height: 24px;
  color: #182b31;
}
.case-select {
  justify-content: center;
}
.case-input {
  width: 100%;
  height: 200px;
  margin-top: 16px;
  padding: 12px;
  background-color: #fcf9f2;
  border-style: solid;
  border-width: 1px;
  border-color: #cfc5b1;
  border-radius: 10px;
  font-size: 15px;
  line-height: 26px;
  color: #182b31;
}
.case-consent {
  min-height: 44px;
  margin-top: 16px;
  align-items: center;
}
.primary-button {
  margin-top: 24px;
}
</style>
