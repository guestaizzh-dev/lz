<template><view class="page"><PageHead title="授权课程案例"/><scroll-view class="page-scroll" direction="vertical"><view class="content"><ContentState v-if="loading||error" :loading="loading" :error="error" @retry="load"/><view v-else><text class="section-heading">选定一段自己的心得</text><text class="hint">只提交下方明确选取的文字，原私人记录保持私密。用于指定课程版本，须主讲点评与审核后展示；可在「书院共创 → 案例授权」撤回。</text><input v-model="title" class="input" placeholder="案例标题" maxlength="120"/><picker :range="courses" range-key="title" :value="courseIndex" @change="courseIndex=Number($event.detail.value)"><view class="input"><text>{{courses[courseIndex]?.title??'选择目标课程'}}</text></view></picker><textarea v-model="text" class="case-input" maxlength="10000" placeholder="编辑你愿意授权的选定心得，不要附上私人联系方式。"/><text class="hint">作者授权说明：仅供所选课程版本的教学案例展示及主讲点评，无默认宣传或转授权；撤回后停止后续展示，不改变已售课程正文。</text><view class="row" @click="consent=!consent"><text class="body-copy">{{consent?'☑':'□'}} 我理解并同意以上授权范围</text></view><text v-if="notice" class="hint">{{notice}}</text><button class="primary-button" :disabled="busy||!consent||title.trim().length<2||text.trim().length<10||!courses.length" @click="submit">提交授权与审核</button></view></view></scroll-view></view></template>
<script setup lang="ts">
import PageHead from '../../components/PageHead.uvue';import ContentState from '../../components/ContentState.uvue';import {request} from '../../lib/api';import {needLogin,currentUser} from '../../lib/session';import {studyEventId} from '../../lib/learning';import {openPage} from '../../lib/presentation';
type Course={id:string;title:string;publishedReleaseId:string};const title=ref(''),text=ref(''),consent=ref(false),courses=ref<Course[]>([]),courseIndex=ref(0),loading=ref(false),error=ref(''),busy=ref(false),notice=ref('');let owner='',kind='',id='',version=0,key=studyEventId(),signature='';async function load(){if(needLogin())return;loading.value=true;error.value='';try{const [source,options]=await Promise.all([request<{title:string;text:string;version:number}>('/forum/private-sources/'+kind+'/'+id),request<{items:Course[]}>('/community-enhancements/course-options')]);version=source.version;title.value=source.title.slice(0,120);text.value=source.text;courses.value=options.items;}catch(e){error.value=(e as Error).message;}finally{loading.value=false;}}async function submit(){if(busy.value||needLogin())return;const body={sourceKind:kind,sourceId:id,sourceVersion:version,releaseId:courses.value[courseIndex.value].publishedReleaseId,title:title.value.trim(),text:text.value.trim(),consent:consent.value};if(signature!==JSON.stringify(body)){signature=JSON.stringify(body);key=studyEventId();}busy.value=true;notice.value='';try{await request('/me/community-enhancements/cases',{method:'POST',data:{...body,requestKey:key}});uni.showToast({title:'授权已提交，等待主讲点评',icon:'none'});openPage('marketing/community');}catch(e){notice.value=(e as Error).message;}finally{busy.value=false;}}onLoad(o=>{kind=o?.kind??'';id=o?.id??'';});onShow(()=>{if(owner!==(currentUser.value?.id??'')){owner=currentUser.value?.id??'';title.value='';text.value='';consent.value=false;courses.value=[];key=studyEventId();signature='';}void load();});
</script><style>@import '../../styles/app.css';@import '../../styles/marketing.css';.input{min-height:48px;padding:12px 0;border-bottom-width:1px;border-bottom-style:solid;border-bottom-color:#E3DCCF;}.case-input{width:100%;height:240px;padding:16px 0;font-size:16px;line-height:28px;color:#182B31;}.primary-button{margin-top:24px;}</style>
