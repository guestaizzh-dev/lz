<template>
  <view class="page"
    ><InkBackdrop /><PageHead title="公益研习" /><scroll-view
      class="page-scroll"
      direction="vertical"
      :show-scrollbar="false"
      ><view class="content"
        ><text class="ui-text page-title">让经典走近更多人</text
        ><text class="ui-text page-intro"
          >每项计划说明真实主办资格、受助条件、具体内容和期限。申请说明仅授权审核人员可见，批准资格后由你确认领取或购买。</text
        ><view class="filter-row"
          ><button
            class="ui-button"
            :class="['filter-pill', tab === 'catalog' ? 'filter-active' : '']"
            :disabled="busy"
            @click="switchTab('catalog')"
            >公益计划</button
          ><button
            class="ui-button"
            :class="['filter-pill', tab === 'mine' ? 'filter-active' : '']"
            :disabled="busy"
            @click="switchTab('mine')"
            >我的申请</button
          ></view
        ><ContentState
          v-if="loading || error"
          :loading="loading"
          :error="error"
          error-title="公益计划未能加载"
          @retry="load(false)"
        /><ContentState
          v-else-if="!items.length"
          :title="tab === 'mine' ? '尚未提交公益申请' : '公益计划正在准备'"
          description="实际资格、协议和交付内容核验后，书院才会开放计划。"
          :action-label="tab === 'mine' ? '查看公益计划' : '查看我的申请'"
          @action="switchTab(tab === 'mine' ? 'catalog' : 'mine')"
        />
        <view v-for="p in items" :key="p.id" class="charity-card"
          ><view class="row between"
            ><text class="ui-text charity-title grow">{{ p.title }}</text
            ><view class="charity-price"
              ><text v-if="Number(p.price) === 0" class="ui-text value-word">免费</text
              ><template v-else
                >¥<text class="ui-text value-number">{{ money(Number(p.price)) }}</text></template
              ></view
            ></view
          ><text class="ui-text body-text charity-copy"
            >{{ p.targetTitle }} ·
            {{ p.kind === 'COURSE' ? '指定课程版本' : '固定期会员，不自动续费' }}</text
          ><text class="ui-text hint charity-copy">{{ p.qualificationSummary }}</text
          ><text class="ui-text body-text charity-copy" :user-select="true"
            >参与条件：{{ p.eligibility }}</text
          ><text class="ui-text hint charity-copy"
            >{{ formatChinaTime(p.startsAt) }} 至 {{ formatChinaTime(p.endsAt) }}（北京）</text
          ><text class="ui-text hint charity-copy"
            >{{
              p.available ? '当前剩余 ' + p.remaining + ' 个名额' : '本计划当前不再接受领取或新售'
            }}；已确认交付按原约定保留。</text
          ><template v-if="p.application"
            ><text class="ui-text meta charity-copy"
              >申请状态：{{ states[p.application!.state] ?? '处理中'
              }}{{ p.application!.claimedAt ? ' · 已领取/交付' : '' }}</text
            ><text v-if="p.application!.reviewNote" class="ui-text hint charity-copy"
              >书院回复：{{ p.application!.reviewNote }}</text
            ></template
          ><button
            v-if="p.application?.claimedAt"
            class="ui-button secondary-button charity-copy"
            @click="openPage(p.kind === 'COURSE' ? 'course/library' : 'membership/index')"
            >查看已有{{ p.kind === 'COURSE' ? '课程' : '会员' }}</button
          ><button
            v-else-if="p.available && p.application?.state === 'APPROVED'"
            class="ui-button primary-button charity-copy"
            :disabled="busy || p.remaining < 1 || (Number(p.price) > 0 && platform !== 'ANDROID')"
            @click="receive(p)"
            >{{
              Number(p.price) === 0
                ? '确认免费交付'
                : platform === 'ANDROID'
                  ? '查看公益购买说明'
                  : '优惠购买仅在Android App开放'
            }}</button
          ><button
            v-else-if="p.available && (!p.application || p.application.state === 'REJECTED')"
            class="ui-button secondary-button charity-copy"
            :disabled="busy || p.remaining < 1"
            @click="begin(p)"
            >提交本次资格申请</button
          ></view
        ><button
          v-if="items.length < total"
          class="ui-button secondary-button charity-copy"
          :disabled="loading"
          @click="load(true)"
          >查看更多</button
        ></view
      ></scroll-view
    ><ComposeSheet
      :visible="!!applying"
      title="公益资格申请"
      :subtitle="applying?.title"
      v-model="statement"
      :maxlength="2000"
      placeholder="根据本计划条件，说明你的申请情况（至少10字）"
      :saving="busy"
      :error="formError"
      :disabled="statement.trim().length < 10 || !consent"
      submitLabel="提交本次申请"
      @close="!busy && (applying = null)"
      @submit="apply"
      ><text class="ui-text hint">{{ applying?.eligibility }}</text
      ><view class="charity-consent" @click="!busy && (consent = !consent)"
        ><text class="ui-text meta"
          >{{ consent ? '☑' : '□' }} 同意书院审核人员使用本次主动提交的说明进行资格审核</text
        ></view
      ></ComposeSheet
    ></view
  >
</template>
<script setup lang="ts">
import InkBackdrop from '../../components/InkBackdrop.uvue';
import { pageRefresh } from '../../lib/page-refresh';
import PageHead from '../../components/PageHead.uvue';
import ContentState from '../../components/ContentState.uvue';
import ComposeSheet from '../../components/ComposeSheet.uvue';
import { request, money } from '../../lib/api';
import { needLogin, currentUser } from '../../lib/session';
import { openPage } from '../../lib/presentation';
import { formatChinaTime } from '../../lib/date-time';
import { purchasePlatform } from '../../lib/course-sales';
type Application = {
  id: string;
  state: string;
  reviewNote: string | null;
  claimedAt: string | null;
  version: number;
};
type Program = {
  id: string;
  version: number;
  title: string;
  kind: string;
  price: string;
  targetTitle: string;
  targetId: string | null;
  eligibility: string;
  qualificationSummary: string;
  startsAt: string;
  endsAt: string;
  remaining: number;
  available: boolean;
  application: Application | null;
};
type ClaimQuote = {
  title: string;
  targetTitle: string;
  version: number;
  quoteHash: string;
  startsAt: string | null;
  days: number | null;
  kind: string;
  claimed: boolean;
};
const states: Record<string, string> = {
    PENDING: '资格审核中',
    APPROVED: '资格已通过',
    REJECTED: '暂未通过',
    REVOKED: '资格已撤回',
  },
  platform = purchasePlatform(),
  tab = ref('catalog'),
  items = ref<Program[]>([]),
  total = ref(0),
  loading = ref(false),
  error = ref(''),
  busy = ref(false),
  applying = ref<Program | null>(null),
  statement = ref(''),
  consent = ref(false),
  formError = ref('');
let page = 1,
  generation = 0,
  owner = '';
function switchTab(value: string) {
  if (value === 'mine' && needLogin('/pages/marketing/charity?tab=mine')) return;
  tab.value = value;
  void load();
}
async function load(append = false) {
  if (
    (append && loading.value) ||
    (tab.value === 'mine' && needLogin('/pages/marketing/charity?tab=mine'))
  )
    return;
  const turn = ++generation,
    next = append ? page + 1 : 1;
  loading.value = true;
  error.value = '';
  if (!append) items.value = [];
  try {
    const r = await request<{ items: Program[]; total: number }>(
      (tab.value === 'mine' ? '/me/charity/programs' : '/charity/programs') + '?page=' + next,
    );
    if (turn !== generation) return;
    items.value = append ? [...items.value, ...r.items] : r.items;
    total.value = r.total;
    page = next;
  } catch (e) {
    if (turn === generation) error.value = (e as Error).message;
  } finally {
    if (turn === generation) loading.value = false;
  }
}
function begin(p: Program) {
  if (busy.value || needLogin('/pages/marketing/charity')) return;
  applying.value = p;
  statement.value = '';
  consent.value = false;
  formError.value = '';
}
async function apply() {
  if (busy.value || !applying.value) return;
  busy.value = true;
  formError.value = '';
  try {
    await request('/me/charity/programs/' + applying.value.id + '/apply', {
      method: 'POST',
      data: { statement: statement.value.trim(), consent: consent.value },
    });
    applying.value = null;
    tab.value = 'mine';
    uni.showToast({ title: '本次申请已提交', icon: 'none' });
    await load();
  } catch (e) {
    formError.value = (e as Error).message;
  } finally {
    busy.value = false;
  }
}
async function receive(p: Program) {
  if (busy.value || needLogin('/pages/marketing/charity?tab=mine')) return;
  if (Number(p.price) > 0) {
    if (platform === 'ANDROID' && p.targetId)
      openPage(
        (p.kind === 'COURSE' ? 'course/purchase?courseId=' : 'membership/purchase?planId=') +
          p.targetId,
      );
    return;
  }
  busy.value = true;
  try {
    const quote = await request<ClaimQuote>('/me/charity/programs/' + p.id + '/claim-quote');
    uni.showModal({
      title: '确认免费交付',
      content:
        quote.targetTitle +
        '\n' +
        (quote.kind === 'MEMBERSHIP'
          ? (quote.startsAt
              ? '现有会员结束后，自 ' + formatChinaTime(quote.startsAt) + '（北京）起生效'
              : '领取后生效') +
            '，共' +
            quote.days +
            '天，不自动续费。'
          : quote.days
            ? '领取后可研习' + quote.days + '天。'
            : '领取后可长期研习该固定版本。') +
        '\n本次免费，不产生现金扣款。',
      confirmText: '确认领取',
      success: async (r) => {
        if (!r.confirm) {
          busy.value = false;
          return;
        }
        try {
          await request('/me/charity/programs/' + p.id + '/claim', {
            method: 'POST',
            data: { expectedVersion: quote.version, quoteHash: quote.quoteHash, consent: true },
          });
          uni.showToast({ title: '已确认免费交付', icon: 'none' });
          await load();
        } catch (e) {
          uni.showToast({ title: (e as Error).message, icon: 'none' });
          await load();
        } finally {
          busy.value = false;
        }
      },
      fail: () => {
        busy.value = false;
        uni.showToast({ title: '确认窗口未打开，请重试', icon: 'none' });
      },
    });
  } catch (e) {
    busy.value = false;
    uni.showToast({ title: (e as Error).message, icon: 'none' });
  }
}
onLoad((options) => {
  if (options.tab === 'mine') tab.value = 'mine';
});
onShow(() => {
  const next = currentUser.value?.id ?? '';
  if (owner !== next) {
    owner = next;
    items.value = [];
    applying.value = null;
    statement.value = '';
    consent.value = false;
    if (!next) tab.value = 'catalog';
  }
  void refreshPage();
});
onUnload(() => generation++);

const refreshPage = pageRefresh(
  async () => {
    await load();
  },
  () => !error.value && !loading.value,
  60000,
);
</script>
<style>
@import '../../styles/app.css';
@import '../../styles/marketing.css';
/* 公益研习：页首 24/34 + 说明 13/22；计划卡 16 内边距；金额 24/34 + 单位 12/20 右对齐；条款 13/22。 */
.content {
  padding-top: 16px;
  padding-bottom: 40px;
}
.page-title {
  font-family: AcademySerif;
  font-size: 24px;
  line-height: 34px;
  color: #182b31;
  font-weight: 600;
  letter-spacing: 0.4px;
}
.page-intro {
  font-family: sans-serif;
  font-size: 13px;
  line-height: 22px;
  color: #5c6869;
  margin-top: 8px;
}
.hint {
  font-family: sans-serif;
  font-size: 13px;
  line-height: 22px;
  color: #5c6869;
  margin-top: 12px;
}
.body-text {
  font-family: sans-serif;
  font-size: 15px;
  line-height: 26px;
  color: #344c54;
}
.charity-copy {
  margin-top: 12px;
}
.filter-row {
  margin-top: 16px;
  border-bottom-width: 0;
}
.filter-pill {
  flex: 1;
  min-width: 0;
  justify-content: center;
  min-height: 48px;
  padding: 12px 0;
  font-size: 14px;
  line-height: 24px;
  color: #5c6869;
}
.filter-active {
  color: #182b31;
  border-bottom-color: #235663;
  font-weight: 600;
}
.charity-card {
  padding: 16px;
  margin-top: 16px;
  background-color: #fcf9f2;
  border-style: solid;
  border-width: 1px;
  border-color: #cfc5b1;
  border-radius: 14px;
}
.charity-title {
  flex: 1;
  min-width: 0;
  font-family: AcademySerif;
  font-size: 17px;
  line-height: 26px;
  color: #182b31;
  font-weight: 600;
  max-height: 52px;
  overflow: hidden;
}
.charity-price {
  flex-direction: row;
  align-items: flex-end;
  flex-shrink: 0;
  margin-left: 12px;
}
.value-word {
  font-family: AcademySerif;
  font-size: 24px;
  line-height: 34px;
  color: #235663;
  font-weight: 600;
}
.value-prefix {
  font-family: sans-serif;
  font-size: 12px;
  line-height: 20px;
  color: #5c6869;
  margin-bottom: 6px;
}
.value-number {
  font-family: AcademySerif;
  font-size: 24px;
  line-height: 34px;
  color: #235663;
  font-weight: 600;
  margin-left: 2px;
}
.charity-consent {
  padding: 12px 0;
  min-height: 44px;
}
</style>
