<template><view class="page"><PageHead title="公益研习"/><scroll-view class="page-scroll" direction="vertical" :show-scrollbar="false"><view class="content"><text class="section-title">让经典走近更多人</text><text class="hint charity-copy">每项计划说明真实主办资格、受助条件、具体内容和期限。申请说明仅授权审核人员可见，批准资格后由你确认领取或购买。</text><view class="filter-row"><button :class="['filter-pill',tab==='catalog'?'filter-active':'']" :disabled="busy" @click="switchTab('catalog')">公益计划</button><button :class="['filter-pill',tab==='mine'?'filter-active':'']" :disabled="busy" @click="switchTab('mine')">我的申请</button></view><ContentState v-if="loading||error" :loading="loading" :error="error" @retry="load(false)"/><ContentState v-else-if="!items.length" :title="tab==='mine'?'尚未提交公益申请':'公益计划正在准备'" description="实际资格、协议和交付内容核验后，书院才会开放计划。"/>
<view v-for="p in items" :key="p.id" class="charity-card"><view class="row between"><text class="section-title grow">{{p.title}}</text><text class="charity-price">{{Number(p.price)===0?'免费':'¥'+money(Number(p.price))}}</text></view><text class="body-text charity-copy">{{p.targetTitle}} · {{p.kind==='COURSE'?'指定课程版本':'固定期会员，不自动续费'}}</text><text class="hint charity-copy">{{p.qualificationSummary}}</text><text class="body-text charity-copy" :user-select="true">参与条件：{{p.eligibility}}</text><text class="hint charity-copy">{{formatChinaTime(p.startsAt)}} 至 {{formatChinaTime(p.endsAt)}}（北京）</text><text class="hint charity-copy">{{p.available?'当前剩余 '+p.remaining+' 个名额':'本计划当前不再接受领取或新售'}}；已确认交付按原约定保留。</text><template v-if="p.application"><text class="meta charity-copy">申请状态：{{states[p.application!.state]??'处理中'}}{{p.application!.claimedAt?' · 已领取/交付':''}}</text><text v-if="p.application!.reviewNote" class="hint charity-copy">书院回复：{{p.application!.reviewNote}}</text></template><button v-if="p.application?.claimedAt" class="secondary-button charity-copy" @click="openPage(p.kind==='COURSE'?'course/library':'membership/index')">查看已有{{p.kind==='COURSE'?'课程':'会员'}}</button><button v-else-if="p.available&&p.application?.state==='APPROVED'" class="primary-button charity-copy" :disabled="busy||p.remaining<1||(Number(p.price)>0&&platform!=='ANDROID')" @click="receive(p)">{{Number(p.price)===0?'确认免费交付':platform==='ANDROID'?'查看公益购买说明':'优惠购买仅在Android App开放'}}</button><button v-else-if="p.available&&(!p.application||p.application.state==='REJECTED')" class="secondary-button charity-copy" :disabled="busy||p.remaining<1" @click="begin(p)">提交本次资格申请</button></view><button v-if="items.length<total" class="secondary-button charity-copy" :disabled="loading" @click="load(true)">查看更多</button></view></scroll-view><ComposeSheet :visible="!!applying" title="公益资格申请" :subtitle="applying?.title" v-model="statement" :maxlength="2000" placeholder="根据本计划条件，说明你的申请情况（至少10字）" :saving="busy" :error="formError" :disabled="statement.trim().length<10||!consent" submitLabel="提交本次申请" @close="!busy&&(applying=null)" @submit="apply"><text class="hint">{{applying?.eligibility}}</text><view class="charity-consent" @click="!busy&&(consent=!consent)"><text class="meta">{{consent?'☑':'□'}} 同意书院审核人员使用本次主动提交的说明进行资格审核</text></view></ComposeSheet></view></template>
<script setup lang="ts">
import PageHead from '../../components/PageHead.uvue';import ContentState from '../../components/ContentState.uvue';import ComposeSheet from '../../components/ComposeSheet.uvue';import {request,money} from '../../lib/api';import {needLogin,currentUser} from '../../lib/session';import {openPage} from '../../lib/presentation';import {formatChinaTime} from '../../lib/date-time';import {purchasePlatform} from '../../lib/course-sales';
type Application={id:string;state:string;reviewNote:string|null;claimedAt:string|null;version:number};type Program={id:string;version:number;title:string;kind:string;price:string;targetTitle:string;targetId:string|null;eligibility:string;qualificationSummary:string;startsAt:string;endsAt:string;remaining:number;available:boolean;application:Application|null};type ClaimQuote={title:string;targetTitle:string;version:number;quoteHash:string;startsAt:string|null;days:number|null;kind:string;claimed:boolean};
const states:Record<string,string>={PENDING:'资格审核中',APPROVED:'资格已通过',REJECTED:'暂未通过',REVOKED:'资格已撤回'},platform=purchasePlatform(),tab=ref('catalog'),items=ref<Program[]>([]),total=ref(0),loading=ref(false),error=ref(''),busy=ref(false),applying=ref<Program|null>(null),statement=ref(''),consent=ref(false),formError=ref('');let page=1,generation=0,owner='';
function switchTab(value:string){if(value==='mine'&&needLogin('/pages/marketing/charity?tab=mine'))return;tab.value=value;void load();}
async function load(append=false){if(append&&loading.value||tab.value==='mine'&&needLogin('/pages/marketing/charity?tab=mine'))return;const turn=++generation,next=append?page+1:1;loading.value=true;error.value='';if(!append)items.value=[];try{const r=await request<{items:Program[];total:number}>((tab.value==='mine'?'/me/charity/programs':'/charity/programs')+'?page='+next);if(turn!==generation)return;items.value=append?[...items.value,...r.items]:r.items;total.value=r.total;page=next;}catch(e){if(turn===generation)error.value=(e as Error).message;}finally{if(turn===generation)loading.value=false;}}
function begin(p:Program){if(busy.value||needLogin('/pages/marketing/charity'))return;applying.value=p;statement.value='';consent.value=false;formError.value='';}
async function apply(){if(busy.value||!applying.value)return;busy.value=true;formError.value='';try{await request('/me/charity/programs/'+applying.value.id+'/apply',{method:'POST',data:{statement:statement.value.trim(),consent:consent.value}});applying.value=null;tab.value='mine';uni.showToast({title:'本次申请已提交',icon:'none'});await load();}catch(e){formError.value=(e as Error).message;}finally{busy.value=false;}}
async function receive(p:Program){if(busy.value||needLogin('/pages/marketing/charity?tab=mine'))return;if(Number(p.price)>0){if(platform==='ANDROID'&&p.targetId)openPage((p.kind==='COURSE'?'course/purchase?courseId=':'membership/purchase?planId=')+p.targetId);return;}busy.value=true;try{const quote=await request<ClaimQuote>('/me/charity/programs/'+p.id+'/claim-quote');uni.showModal({title:'确认免费交付',content:quote.targetTitle+'\n'+(quote.kind==='MEMBERSHIP'?(quote.startsAt?'现有会员结束后，自 '+formatChinaTime(quote.startsAt)+'（北京）起生效':'领取后生效')+'，共'+quote.days+'天，不自动续费。':quote.days?'领取后可研习'+quote.days+'天。':'领取后可长期研习该固定版本。')+'\n本次免费，不产生现金扣款。',confirmText:'确认领取',success:async r=>{if(!r.confirm){busy.value=false;return;}try{await request('/me/charity/programs/'+p.id+'/claim',{method:'POST',data:{expectedVersion:quote.version,quoteHash:quote.quoteHash,consent:true}});uni.showToast({title:'已确认免费交付',icon:'none'});await load();}catch(e){uni.showToast({title:(e as Error).message,icon:'none'});await load();}finally{busy.value=false;}},fail:()=>{busy.value=false;uni.showToast({title:'确认窗口未打开，请重试',icon:'none'});}});}catch(e){busy.value=false;uni.showToast({title:(e as Error).message,icon:'none'});}}
onLoad(options=>{if(options.tab==='mine')tab.value='mine';});onShow(()=>{const next=currentUser.value?.id??'';if(owner!==next){owner=next;items.value=[];applying.value=null;statement.value='';consent.value=false;if(!next)tab.value='catalog';}void load();});onUnload(()=>generation++);
</script><style>@import '../../styles/app.css';@import '../../styles/marketing.css';.charity-copy{margin-top:12px;}.charity-card{padding:22px 0;border-bottom-width:1px;border-bottom-style:solid;border-bottom-color:#DFD9CF;}.charity-price{font-size:20px;line-height:30px;color:#245564;}.charity-consent{padding:18px 0;min-height:48px;}</style>
