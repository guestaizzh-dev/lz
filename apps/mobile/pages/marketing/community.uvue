<template><view class="page"><PageHead title="书院共创"/><scroll-view class="page-scroll" direction="vertical" :show-scrollbar="false"><view class="content"><text class="hint creation-hint">以真实研习与实践交流。置顶须审核，征文按品质评选，私人记录只在明确授权后用于课程案例。</text><scroll-view direction="horizontal" class="filter-scroll" :show-scrollbar="false"><view class="filter-row"><button v-for="item in tabs" :key="item.value" :class="['filter-pill',tab===item.value?'filter-active':'']" @click="changeTab(item.value)">{{item.title}}</button></view></scroll-view><view v-if="activeCampaign" class="creation-row"><text class="section-title">投稿至 {{activeCampaign!.title}}</text><picker :range="eligible" range-key="title" :value="threadIndex" @change="threadIndex=Number($event.detail.value)"><view class="menu-row"><text>{{eligible[threadIndex]?.title??'暂无可投稿的已审核帖子'}}</text></view></picker><button v-if="eligible.length<eligibleTotal" class="secondary-button creation-action" @click="moreThreads">加载更多我的帖子</button><button class="primary-button" :disabled="busy||!eligible.length" @click="confirmEntry">确认授权并投稿</button><button class="secondary-button creation-action" @click="activeCampaign=null">取消选择</button></view><ContentState v-if="loading||error" :loading="loading" :error="error" @retry="load(false)"/><view v-if="!loading&&!error&&!items.length" class="section"><text class="section-title">{{tab==='campaigns'?'新一期征文正在酝酿':tab==='featured'?'精选研习正在整理':'暂无记录'}}</text><text class="hint creation-hint">{{tab==='cases'?'可在研习笔记或日志中选择一条，点「授权课程案例」。':'新的消息与处理结果会保留在这里。'}}</text></view><view v-for="item in items" :key="item.id" class="creation-row"><text class="section-title">{{item.title??item.campaignTitle??'研习记录'}}</text><text v-if="tab==='campaigns'" class="hint creation-hint">{{formatChinaTime(item.endsAt??'')}} 截止（北京）</text><text v-if="item.rules" class="body-copy creation-copy" :user-select="true">{{item.rules!.text}}</text><text v-if="item.state" class="meta creation-meta">{{stateName(item.state??'')}}</text><text v-if="item.judgeNote||item.reviewNote" class="hint creation-hint">书院回复：{{item.judgeNote??item.reviewNote}}</text><text v-if="item.qualityScore" class="hint creation-hint">品质评分 {{item.qualityScore}} · 第 {{item.rank}} 名</text><text v-if="item.summary" class="body-copy creation-copy">{{item.summary}}</text><button v-if="tab==='featured'&&item.threadId" class="secondary-button creation-action" @click="openPage('community/detail?id='+item.threadId)">阅读研习心得 ›</button><text v-if="item.text" class="body-copy creation-copy" :user-select="true">{{item.text}}</text><text v-if="item.teacherComment" class="hint creation-hint" :user-select="true">主讲点评：{{item.teacherComment}}</text><button v-if="tab==='campaigns'" class="secondary-button creation-action" :disabled="busy||Date.parse(item.endsAt??'')<=clock" @click="enter(item)">{{Date.parse(item.endsAt??'')<=clock?'投稿已截止':'选择我的公开帖子投稿'}}</button><button v-if="tab==='entries'&&['SUBMITTED','SELECTED'].includes(item.state??'')" class="secondary-button creation-action" :disabled="busy" @click="withdrawEntry(item)">撤回征文授权</button><button v-if="tab==='cases'&&item.state!=='WITHDRAWN'" class="secondary-button creation-action" :disabled="busy" @click="withdrawCase(item)">撤回案例授权</button></view><button v-if="items.length<total" class="secondary-button creation-action" :disabled="loading" @click="load(true)">查看更多</button></view></scroll-view></view></template>
<script setup lang="ts">
import PageHead from '../../components/PageHead.uvue';import ContentState from '../../components/ContentState.uvue';import {openPage} from '../../lib/presentation';
import {request} from '../../lib/api';import {needLogin,currentUser} from '../../lib/session';import {formatChinaTime} from '../../lib/date-time';
type CampaignRules={text:string};type Item={id:string;threadId?:string;summary?:string;title?:string;campaignTitle?:string;state?:string;version:number;sectionId?:string;endsAt?:string;rules?:CampaignRules;judgeNote?:string;reviewNote?:string;qualityScore?:number;rank?:number;text?:string;teacherComment?:string};type Thread={id:string;title:string;state:string};const tabs=[{value:'featured',title:'精选研习'},{value:'campaigns',title:'主题征文'},{value:'entries',title:'我的投稿'},{value:'pins',title:'置顶申请'},{value:'cases',title:'案例授权'}],tab=ref('campaigns'),items=ref<Item[]>([]),loading=ref(false),error=ref(''),busy=ref(false),total=ref(0),clock=ref(Date.now());let page=1,generation=0,owner='';
function stateName(state:string){return ({ACTIVE:'征文开放',CLOSED:'已关闭',PENDING:'待审核',APPROVED:'已批准',REJECTED:'未通过',WITHDRAWN:'已撤回',SUBMITTED:'待评选 / 点评',COMMENTED:'主讲已点评，待审核',PUBLISHED:'已发布',SELECTED:'已入选'} as Record<string,string>)[state]??'处理中';}
function changeTab(value:string){if(!['campaigns','featured'].includes(value)&&needLogin('/pages/marketing/community'))return;tab.value=value;activeCampaign.value=null;void load();}
async function load(append=false){if(append&&loading.value)return;const turn=++generation,next=append?page+1:1;loading.value=true;error.value='';if(!append)items.value=[];try{const result=await request<{items:Item[];total?:number}>((tab.value==='campaigns'?'/community-enhancements/campaigns':tab.value==='featured'?'/community-enhancements/featured':'/me/community-enhancements/'+tab.value)+'?page='+next);if(turn!==generation)return;items.value=append?[...items.value,...result.items]:result.items;total.value=result.total??result.items.length;page=next;}catch(e){if(turn===generation)error.value=(e as Error).message;}finally{if(turn===generation)loading.value=false;}}
const activeCampaign=ref<Item|null>(null),eligible=ref<Thread[]>([]),eligibleTotal=ref(0),threadIndex=ref(0);let threadPage=1;
async function enter(campaign:Item){if(busy.value||needLogin('/pages/marketing/community'))return;activeCampaign.value=campaign;threadPage=0;eligible.value=[];threadIndex.value=0;await moreThreads();}
async function moreThreads(){if(busy.value||!activeCampaign.value)return;busy.value=true;try{const next=threadPage+1,result=await request<{items:Thread[];total:number}>('/forum/mine?state=PUBLISHED&size=20&page='+next+'&sectionId='+activeCampaign.value.sectionId);eligible.value=[...eligible.value,...result.items];eligibleTotal.value=result.total;threadPage=next;if(!eligible.value.length)uni.showToast({title:'请先在对应讨论区提交帖子并通过审核',icon:'none'});}catch(e){uni.showToast({title:(e as Error).message,icon:'none'});}finally{busy.value=false;}}
function confirmEntry(){const campaign=activeCampaign.value,thread=eligible.value[threadIndex.value];if(!campaign||!thread||busy.value)return;uni.showModal({title:'授权参加本次征文？',content:'《'+thread.title+'》将参加「'+campaign.title+'」评选，并按活动规则限期精选展示。原文仍受社区治理，品质评选不保证获奖。',success:async r=>{if(!r.confirm||busy.value)return;busy.value=true;try{await request('/me/community-enhancements/campaigns/'+campaign.id+'/entries',{method:'POST',data:{threadId:thread.id,consent:true}});activeCampaign.value=null;tab.value='entries';await load();uni.showToast({title:'已提交征文',icon:'none'});}catch(e){uni.showToast({title:(e as Error).message,icon:'none'});}finally{busy.value=false;}}});}

function withdrawEntry(item:Item){uni.showModal({title:'撤回本次征文授权？',content:'停止后续评选或精选展示，已获品质成长会冲回，原公开帖子仍保留。',success:async r=>{if(!r.confirm||busy.value)return;busy.value=true;try{await request('/me/community-enhancements/entries/'+item.id+'/withdraw',{method:'POST',data:{expectedVersion:item.version,action:'WITHDRAW',reason:'本人主动撤回本次征文评选和精选展示授权'}});await load();}catch(e){uni.showToast({title:(e as Error).message,icon:'none'});}finally{busy.value=false;}}});}
function withdrawCase(item:Item){uni.showModal({title:'撤回课程案例授权？',content:'停止展示本次选定心得及点评，原私人记录与已购课程正文保持。',success:async r=>{if(!r.confirm||busy.value)return;busy.value=true;try{await request('/me/community-enhancements/cases/'+item.id+'/withdraw',{method:'POST',data:{expectedVersion:item.version,action:'WITHDRAW',reason:'本人撤回本课程版本案例使用授权'}});await load();}catch(e){uni.showToast({title:(e as Error).message,icon:'none'});}finally{busy.value=false;}}});}
onShow(()=>{clock.value=Date.now();if(owner!==(currentUser.value?.id??'')){owner=currentUser.value?.id??'';tab.value='campaigns';activeCampaign.value=null;eligible.value=[];eligibleTotal.value=0;}void load();});onUnload(()=>generation++);
</script><style>@import '../../styles/app.css';@import '../../styles/marketing.css';.creation-row{padding:24px 0;border-bottom-width:1px;border-bottom-style:solid;border-bottom-color:#DFD9CF;}.creation-hint,.creation-meta{margin-top:10px;}.creation-copy{margin-top:16px;}.creation-action{margin-top:16px;}</style>
