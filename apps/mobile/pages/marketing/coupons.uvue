<template><view class="page"><PageHead title="课程优惠券"/><scroll-view class="page-scroll" direction="vertical" :show-scrollbar="false"><view class="content"><view class="invite-row"><input class="invite-input" v-model="inviteCode" placeholder="粘贴拼团邀请编号" maxlength="36"/><button class="text-button" @click="openGroup">查看拼团</button></view><text class="hint coupon-hint">一单一券，购课时自动选择当前渠道最优优惠。每单至少实付¥0.01。未到期券在取消订单或成功退款后返还。</text><view class="filter-row"><button :class="['filter-pill',tab==='center'?'filter-active':'']" @click="switchTab('center')">领券中心</button><button :class="['filter-pill',tab==='wallet'?'filter-active':'']" @click="switchTab('wallet')">我的券</button></view><ContentState v-if="loading||error" :loading="loading" :error="error" @retry="load(false)"/><ContentState v-else-if="!items.length" title="暂无优惠券" description="后续课程优惠会在这里发布。"/><view v-for="item in items" :key="item.id" class="coupon-card"><view class="row between"><text class="section-title">{{terms(item).title}}</text><text class="coupon-value">{{terms(item).discountKind==='FIXED'?'减 ¥'+money(Number(terms(item).discountValue)):'实付 '+Number(terms(item).discountValue)/100+'%'}}</text></view><text class="hint coupon-hint">{{Number(terms(item).threshold)>0?'课程原价满 ¥'+money(Number(terms(item).threshold))+' 可用':'无金额门槛'}} · {{terms(item).courseIds.length?'指定课程':'全部正式课程'}}</text><text class="hint coupon-hint">{{formatChinaTime(item.expiresAt??item.endsAt??'')}} 到期（北京）</text><text v-if="tab==='wallet'" class="meta">{{stateName(item.state??'')}}</text><button v-else class="secondary-button coupon-action" :disabled="busy||item.remaining===0||(item.claimed??0)>=(item.perUserLimit??0)" @click="claim(item)">{{item.remaining===0?'已领完':(item.claimed??0)>=(item.perUserLimit??0)?'已领取':'领取优惠券'}}</button></view><button v-if="items.length<total" class="secondary-button coupon-action" :disabled="loading" @click="load(true)">查看更多</button></view></scroll-view></view></template>
<script setup lang="ts">
import {openPage} from '../../lib/presentation';
import PageHead from '../../components/PageHead.uvue';import ContentState from '../../components/ContentState.uvue';import {request,money} from '../../lib/api';import {needLogin,currentUser} from '../../lib/session';import {studyEventId} from '../../lib/learning';import {formatChinaTime} from '../../lib/date-time';
type Terms={title:string;discountKind:string;discountValue:string;threshold:string;courseIds:string[]};type CouponScope={courseIds:string[]};type Coupon={id:string;title?:string;discountKind?:string;discountValue?:string;threshold?:string;scope?:CouponScope;termsSnapshot?:Terms;expiresAt?:string;endsAt?:string;state?:string;remaining?:number;claimed?:number;perUserLimit?:number};
const inviteCode=ref('');function openGroup(){if(!/^[0-9a-f-]{36}$/i.test(inviteCode.value.trim())){uni.showToast({title:'请填写完整邀请编号',icon:'none'});return;}openPage('marketing/group?id='+inviteCode.value.trim());}
const tab=ref('center'),items=ref<Coupon[]>([]),loading=ref(false),error=ref(''),busy=ref(false),total=ref(0);let page=1,generation=0,owner='';const claimKeys:Record<string,string>={};
function terms(item:Coupon):Terms{return item.termsSnapshot??{title:item.title??'',discountKind:item.discountKind??'FIXED',discountValue:item.discountValue??'0',threshold:item.threshold??'0',courseIds:item.scope?.courseIds??[]};}
function stateName(state:string){return ({AVAILABLE:'可使用',LOCKED:'待支付订单已占用',USED:'已使用',EXPIRED:'已过期',REVOKED:'已撤销'} as Record<string,string>)[state]??'处理中';}
async function load(append=false){if(append&&loading.value)return;const turn=++generation,next=append?page+1:1;loading.value=true;error.value='';if(!append)items.value=[];try{const r=await request<{items:Coupon[];total:number}>((tab.value==='center'?'/marketing/coupons':'/me/marketing/coupons')+'?page='+next);if(turn!==generation)return;items.value=append?[...items.value,...r.items]:r.items;page=next;total.value=r.total;}catch(e){if(turn===generation)error.value=(e as Error).message;}finally{if(turn===generation)loading.value=false;}}
function switchTab(value:string){if(value==='wallet'&&needLogin('/pages/marketing/coupons'))return;tab.value=value;void load();}
async function claim(item:Coupon){if(busy.value||needLogin('/pages/marketing/coupons'))return;busy.value=true;claimKeys[item.id]??=studyEventId();try{await request('/me/marketing/coupons/'+item.id+'/claim',{method:'POST',data:{requestKey:claimKeys[item.id]}});uni.showToast({title:'已领取，购课时自动匹配',icon:'none'});await load();}catch(e){uni.showToast({title:(e as Error).message,icon:'none'});}finally{busy.value=false;}}
onLoad(options=>{if(options?.tab==='wallet')tab.value='wallet';});
onShow(()=>{if(owner!==(currentUser.value?.id??'')){owner=currentUser.value?.id??'';for(const key of Object.keys(claimKeys))delete claimKeys[key];if(!owner)tab.value='center';}void load();});onUnload(()=>generation++);
</script><style>@import '../../styles/app.css';@import '../../styles/marketing.css';.coupon-card{padding:20px 0;border-bottom-width:1px;border-bottom-style:solid;border-bottom-color:#DFD9CF;}.coupon-value{font-size:20px;line-height:30px;color:#245564;}.coupon-hint{margin-top:8px;}.coupon-action{margin-top:14px;}</style>
