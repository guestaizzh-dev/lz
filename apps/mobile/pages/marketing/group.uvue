<template>
  <view class="page"
    ><InkBackdrop /><PageHead title="共学拼团" /><scroll-view
      class="page-scroll"
      direction="vertical"
      ><view class="content"
        ><ContentState
          v-if="loading || error"
          :loading="loading"
          :error="error"
          :error-title="id ? '拼团信息未能加载' : '邀请编号缺失'"
          :retryable="!!id"
          :action-label="id ? '' : '返回课程库'"
          @retry="load"
          @action="openPage('course/library')"
        /><view v-else-if="group"
          ><text class="ui-text detail-title">{{ group!.title }}</text
          ><text class="ui-text page-intro">{{
            group!.state === 'SUCCEEDED'
              ? '共学已成团'
              : group!.state === 'FAILED'
                ? '本团未成功'
                : '邀一位学友，一起研习'
          }}</text
          ><view class="card group-facts"
            ><view class="row between"
              ><text class="ui-text group-price-label">团价</text
              ><view class="group-price"
                >¥<text class="ui-text value-number">{{ money(Number(group!.price)) }}</text></view
              ></view
            ><text class="ui-text group-meta"
              >{{ group!.requiredMembers }} 人成团 · {{ group!.paidMembers }} 人已付款 ·
              {{ group!.reservedMembers }} 人已预留名额</text
            ><text class="ui-text group-meta"
              >{{ formatChinaTime(group!.expiresAt) }} 截止（北京时间）</text
            ></view
          ><text class="ui-text group-terms"
            >成团后加入学习档案，成团前仅可试听。未成团将自动发起原路退款，可在购课订单查看进度。</text
          ><button
            v-if="
              group!.state === 'OPEN' &&
              !group!.myState &&
              group!.reservedMembers < group!.requiredMembers
            "
            class="ui-button primary-button group-action"
            @click="join"
            >参加共学</button
          ><button
            v-if="group!.state === 'OPEN'"
            class="ui-button secondary-button group-action"
            @click="invite"
            >复制邀请信息</button
          ><button
            class="ui-button secondary-button group-action"
            @click="openPage('course/orders')"
            >查看我的购课订单</button
          ><text class="ui-text field-label group-invite-label">邀请编号</text
          ><view class="group-invite"
            ><text class="ui-text group-code" :user-select="true">{{ group!.id }}</text></view
          ></view
        ></view
      ></scroll-view
    ></view
  >
</template>
<script setup lang="ts">
import InkBackdrop from '../../components/InkBackdrop.uvue';
import PageHead from '../../components/PageHead.uvue';
import ContentState from '../../components/ContentState.uvue';
import { request, money } from '../../lib/api';
import { openPage } from '../../lib/presentation';
import { formatChinaTime } from '../../lib/date-time';
import { needLogin } from '../../lib/session';
type Group = {
  id: string;
  title: string;
  courseId: string;
  state: string;
  expiresAt: string;
  requiredMembers: number;
  paidMembers: number;
  reservedMembers: number;
  myState: string | null;
  price: string;
};
const group = ref<Group | null>(null),
  loading = ref(false),
  error = ref('');
let id = '';
async function load() {
  loading.value = true;
  error.value = '';
  try {
    group.value = await request<Group>('/marketing/groups/' + id);
  } catch (e) {
    error.value = (e as Error).message;
  } finally {
    loading.value = false;
  }
}
function join() {
  if (group.value && !needLogin('/pages/marketing/group?id=' + id))
    openPage('course/purchase?courseId=' + group.value.courseId + '&groupId=' + id);
}
function invite() {
  if (group.value)
    uni.setClipboardData({
      data:
        '邀你一起研习《' +
        group.value.title +
        '》：2人共学 ¥' +
        money(Number(group.value.price)) +
        '，截止 ' +
        formatChinaTime(group.value.expiresAt) +
        '（北京）。在书院App「课程优惠券」输入邀请编号 ' +
        id +
        ' 查看并参加；成团前不能学习，失败自动退款。',
    });
}
onLoad((o) => (id = o?.id ?? ''));
onShow(() => load());
</script>
<style>
@import '../../styles/app.css';
@import '../../styles/marketing.css';
/* 共学拼团：标题 24/34 + 说明 13/22；团价 24/34 单位 12/20 右对齐；条款 13/22；邀请编号 44 高描边。 */
.content {
  padding-top: 16px;
  padding-bottom: 40px;
}
.page-intro {
  font-family: sans-serif;
  font-size: 13px;
  line-height: 22px;
  color: #5c6869;
  margin-top: 8px;
}
.group-facts {
  margin-top: 16px;
}
.group-price-label {
  font-family: sans-serif;
  font-size: 13px;
  line-height: 22px;
  color: #5c6869;
}
.group-price {
  flex-direction: row;
  align-items: flex-end;
}
.value-prefix {
  font-family: sans-serif;
  font-size: 12px;
  line-height: 20px;
  color: #5c6869;
  margin-bottom: 6px;
}
.value-number {
  font-family: AcademySerif;
  font-size: 24px;
  line-height: 34px;
  color: #235663;
  font-weight: 600;
  margin-left: 2px;
}
.group-meta {
  font-family: sans-serif;
  font-size: 12px;
  line-height: 20px;
  color: #5c6869;
  margin-top: 8px;
}
.group-terms {
  font-family: sans-serif;
  font-size: 13px;
  line-height: 22px;
  color: #5c6869;
  margin-top: 16px;
}
.group-action {
  margin-top: 16px;
}
.field-label {
  font-family: sans-serif;
  font-size: 13px;
  line-height: 22px;
  color: #5c6869;
}
.group-invite-label {
  margin-top: 24px;
}
.group-invite {
  margin-top: 8px;
  height: 44px;
  min-height: 44px;
  padding: 0 12px;
  justify-content: center;
  background-color: #fcf9f2;
  border-style: solid;
  border-width: 1px;
  border-color: #cfc5b1;
  border-radius: 10px;
}
.group-code {
  font-family: sans-serif;
  font-size: 15px;
  line-height: 24px;
  color: #182b31;
}
</style>
