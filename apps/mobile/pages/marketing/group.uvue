<template><view class="page"><PageHead title="共学拼团"/><scroll-view class="page-scroll" direction="vertical"><view class="content"><ContentState v-if="loading||error" :loading="loading" :error="error" @retry="load"/><view v-else-if="group"><text class="detail-title">{{group!.title}}</text><text class="section-heading">{{group!.state==='SUCCEEDED'?'共学已成团':group!.state==='FAILED'?'本团未成功':'邀一位学友，一起研习'}}</text><text class="body-copy">团价 ¥{{money(Number(group!.price))}} · {{group!.requiredMembers}}人成团</text><text class="hint">{{group!.paidMembers}} 人已付款 · {{group!.reservedMembers}} 人已占位</text><text class="hint">{{formatChinaTime(group!.expiresAt)}} 截止（北京时间）</text><text class="body-copy">成团后加入学习档案，成团前仅可试听。未成团将自动发起原路退款，可在购课订单查看进度。</text><button v-if="group!.state==='OPEN'&&!group!.myState&&group!.reservedMembers<group!.requiredMembers" class="primary-button" @click="join">参加共学</button><button v-if="group!.state==='OPEN'" class="secondary-button" @click="invite">复制邀请信息</button><button class="secondary-button" @click="openPage('course/orders')">查看我的购课订单</button><text class="hint">邀请编号：{{group!.id}}</text></view></view></scroll-view></view></template>
<script setup lang="ts">
import PageHead from '../../components/PageHead.uvue';import ContentState from '../../components/ContentState.uvue';import {request,money} from '../../lib/api';import {openPage} from '../../lib/presentation';import {formatChinaTime} from '../../lib/date-time';import {needLogin} from '../../lib/session';
type Group={id:string;title:string;courseId:string;state:string;expiresAt:string;requiredMembers:number;paidMembers:number;reservedMembers:number;myState:string|null;price:string};const group=ref<Group|null>(null),loading=ref(false),error=ref('');let id='';async function load(){loading.value=true;error.value='';try{group.value=await request<Group>('/marketing/groups/'+id);}catch(e){error.value=(e as Error).message;}finally{loading.value=false;}}function join(){if(group.value&&!needLogin('/pages/marketing/group?id='+id))openPage('course/purchase?courseId='+group.value.courseId+'&groupId='+id);}function invite(){if(group.value)uni.setClipboardData({data:'邀你一起研习《'+group.value.title+'》：2人共学 ¥'+money(Number(group.value.price))+'，截止 '+formatChinaTime(group.value.expiresAt)+'（北京）。在书院App「课程优惠券」输入邀请编号 '+id+' 查看并参加；成团前不能学习，失败自动退款。'});}onLoad(o=>id=o?.id??'');onShow(()=>load());
</script><style>@import '../../styles/app.css';@import '../../styles/marketing.css';.body-copy{margin-top:20px;}.hint{margin-top:12px;}.primary-button,.secondary-button{margin-top:16px;}</style>
