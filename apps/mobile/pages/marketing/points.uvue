<template>
  <view class="page"
    ><InkBackdrop /><PageHead title="积分商城" /><scroll-view
      class="page-scroll"
      direction="vertical"
      :show-scrollbar="false"
      ><view class="content"
        ><text class="ui-text page-title">以学积善，兑一份心意</text
        ><text class="ui-text page-intro"
          >积分不是现金。实物普通配送包邮，咨询共用真实可售时段。兑换前请确认内容与取消规则。</text
        ><view class="row between points-balance-row"
          ><text class="ui-text points-balance-label">可用积分</text
          ><view class="points-balance"
            ><text class="ui-text value-number">{{ balance }}</text
            ><text class="ui-text value-unit">积分</text></view
          ></view
        ><view class="filter-row"
          ><button
            class="ui-button"
            :class="['filter-pill', tab === 'rewards' ? 'filter-active' : '']"
            :disabled="busy || !!pending"
            @click="switchTab('rewards')"
            >可兑换</button
          ><button
            class="ui-button"
            :class="['filter-pill', tab === 'records' ? 'filter-active' : '']"
            :disabled="busy || !!pending"
            @click="switchTab('records')"
            >兑换记录</button
          ></view
        ><ContentState
          v-if="loading || error"
          :loading="loading"
          :error="error"
          error-title="积分信息未能加载"
          @retry="load(false)"
        />
        <view v-if="selected" class="points-confirm"
          ><text class="ui-text points-confirm-title">{{ selected!.title }}</text
          ><view class="points-cost"
            ><text class="ui-text value-number">{{ selected!.pointsCost }}</text
            ><text class="ui-text value-unit">积分</text></view
          ><text class="ui-text hint points-copy">{{ selected!.description }}</text
          ><text v-if="selected!.couponEndsAt" class="ui-text hint points-copy"
            >{{ formatChinaTime(selected!.couponEndsAt) }} 到期（北京）</text
          ><template v-if="selected!.kind === 'PHYSICAL'"
            ><view class="points-choice" @click="chooseAddress"
              ><text class="ui-text body-text">{{
                address ? address!.recipient + '　' + address!.phone : '选择收货地址 ›'
              }}</text
              ><text v-if="address" class="ui-text hint points-copy">{{
                addressText(address!)
              }}</text></view
            ><button
              class="ui-button text-button"
              :disabled="busy || !!pending"
              @click="openPage('shop/addresses')"
              >管理收货地址</button
            ></template
          ><template v-if="selected!.kind === 'CONSULTATION'"
            ><text class="ui-text body-text points-copy">选择咨询时间（北京）</text
            ><ContentState
              v-if="!slots.length"
              title="暂无可约时段"
              description="请稍后再来；当前不会扣除积分。"
            /><view
              v-for="slot in slots"
              :key="slot.id"
              :class="['points-slot', slotId === slot.id ? 'points-slot-active' : '']"
              @click="chooseSlot(slot)"
              ><text class="ui-text body-text"
                >{{ formatChinaTime(slot.startsAt) }} — {{ formatChinaTime(slot.endsAt) }}</text
              ><text class="ui-text hint">{{
                slot.available > 0 ? '可预约' : '已约满'
              }}</text></view
            ><input
              class="ui-input points-input"
              v-model="name"
              :disabled="busy || !!pending"
              maxlength="50"
              placeholder="本次预约联系人姓名"
            /><input
              class="ui-input points-input"
              v-model="phone"
              :disabled="busy || !!pending"
              type="number"
              maxlength="11"
              placeholder="本次预约联系电话"
            /><text class="ui-text hint"
              >时段及服务说明若有变更，将要求重新确认。取消截止后未到场不自动退分，请联系书院处理争议。</text
            ></template
          ><view class="points-consent" @click="toggleConsent"
            ><text class="ui-text meta"
              >{{ consent ? '☑' : '□' }} 已确认兑换内容、取消规则及本次履约所需信息使用</text
            ></view
          ><text v-if="formError" class="ui-text form-feedback">{{ formError }}</text
          ><button class="ui-button primary-button" :disabled="busy || !consent" @click="redeem">{{
            busy
              ? '正在确认…'
              : pending
                ? '重试核查原兑换'
                : '确认兑换 · ' + selected!.pointsCost + '积分'
          }}</button
          ><button
            class="ui-button text-button points-copy"
            :disabled="busy || !!pending"
            @click="selected = null"
            >返回列表</button
          ></view
        >
        <template v-else-if="tab === 'rewards'"
          ><ContentState
            v-if="!loading && !error && !rewards.length"
            title="心意尚在准备"
            description="书院开放可履约的兑换内容后，会在这里展示。"
            action-label="查看兑换记录"
            @action="switchTab('records')"
          /><view v-for="reward in rewards" :key="reward.id" class="points-entry"
            ><view class="row between"
              ><text class="ui-text points-title">{{ reward.title }}</text
              ><view class="points-cost"
                ><text class="ui-text value-number">{{ reward.pointsCost }}</text
                ><text class="ui-text value-unit">积分</text></view
              ></view
            ><text class="ui-text hint points-copy">{{ reward.description }}</text
            ><text v-if="reward.couponEndsAt" class="ui-text hint points-copy"
              >{{ formatChinaTime(reward.couponEndsAt) }} 到期（北京）</text
            ><text class="ui-text hint points-copy"
              >可供 {{ reward.remaining }} 份 · 每人每日 {{ reward.perUserDaily }} 次（北京）</text
            ><button
              class="ui-button secondary-button points-copy"
              :disabled="
                busy ||
                reward.remaining < 1 ||
                !reward.available ||
                Number(reward.pointsCost) > Number(balance)
              "
              @click="select(reward)"
              >{{
                !reward.available
                  ? (reward.unavailableReason ?? '暂不可兑换')
                  : reward.remaining < 1
                    ? '已兑完'
                    : Number(reward.pointsCost) > Number(balance)
                      ? '积分不足'
                      : '查看并兑换'
              }}</button
            ></view
          ></template
        >
        <template v-else
          ><ContentState
            v-if="!loading && !error && !records.length"
            title="还没有兑换记录"
            description="每笔积分扣除、交付与退回都可在这里查看。"
            action-label="查看可兑换"
            @action="switchTab('rewards')"
          /><view v-for="record in records" :key="record.id" class="points-entry"
            ><view class="row between"
              ><text class="ui-text points-title">{{ record.rewardSnapshot.title }}</text
              ><text class="ui-text meta">{{ states[record.state] ?? '处理中' }}</text></view
            ><text class="ui-text hint points-copy"
              >{{ record.pointsCost }}积分 · {{ formatChinaTime(record.createdAt) }}（北京）</text
            ><text v-if="record.returnReason" class="ui-text hint points-copy"
              >处理说明：{{ record.returnReason }}</text
            ><text
              v-if="record.returnInstructions"
              class="ui-text body-text points-copy"
              :user-select="true"
              >寄回说明：{{ record.returnInstructions }}</text
            ><text
              v-if="record.returnTrackingNo"
              class="ui-text hint points-copy"
              :user-select="true"
              >寄回 {{ record.returnCarrier }} {{ record.returnTrackingNo }}</text
            ><button
              v-if="record.rewardSnapshot.kind === 'COUPON'"
              class="ui-button secondary-button points-copy"
              @click="openPage('marketing/coupons?tab=wallet')"
              >查看我的优惠券</button
            ><button
              v-if="record.appointmentId"
              class="ui-button secondary-button points-copy"
              @click="openPage('booking/mine')"
              >查看预约 / 取消与退分</button
            ><button
              v-else-if="record.orderId"
              class="ui-button secondary-button points-copy"
              @click="openPage('shop/order-detail?id=' + record.orderId)"
              >查看发货与物流</button
            ><button
              v-if="
                record.rewardSnapshot.kind === 'PHYSICAL' &&
                ['FULFILLING', 'COMPLETED'].includes(record.state)
              "
              class="ui-button text-button points-copy"
              :disabled="busy"
              @click="beginReturn(record)"
              >取消兑换 / 申请退货退分</button
            ><button
              v-if="record.state === 'RETURN_APPROVED'"
              class="ui-button secondary-button points-copy"
              :disabled="busy"
              @click="beginShipment(record)"
              >填写寄回物流</button
            ></view
          ></template
        ><button
          v-if="!selected && (tab === 'rewards' ? rewards.length : records.length) < total"
          class="ui-button secondary-button points-copy"
          :disabled="loading"
          @click="load(true)"
          >查看更多</button
        ></view
      ></scroll-view
    >
    <ComposeSheet
      :visible="!!returning"
      title="取消兑换 / 积分售后"
      v-model="reason"
      placeholder="请说明取消或退货原因，至少2字"
      :maxlength="500"
      :saving="busy"
      :error="formError"
      :disabled="reason.trim().length < 2"
      submitLabel="提交申请"
      @close="!busy && (returning = null)"
      @submit="submitReturn"
      ><text class="ui-text hint"
        >未发货立即退分；已发货先审核，按书院提供的实际退货说明寄回，核实入库后退回原积分。</text
      ></ComposeSheet
    >
    <ComposeSheet
      :visible="!!shipping"
      title="填写实际寄回物流"
      v-model="trackingNo"
      placeholder="实际寄回运单号"
      :maxlength="40"
      :saving="busy"
      :error="formError"
      :disabled="!trackingNo.trim() || !carrier.trim()"
      submitLabel="提交物流"
      @close="!busy && (shipping = null)"
      @submit="submitShipment"
      ><input
        class="ui-input points-input"
        v-model="carrier"
        maxlength="40"
        placeholder="快递公司名称"
    /></ComposeSheet>
  </view>
</template>
<script setup lang="ts">
import InkBackdrop from '../../components/InkBackdrop.uvue';
import PageHead from '../../components/PageHead.uvue';
import ContentState from '../../components/ContentState.uvue';
import ComposeSheet from '../../components/ComposeSheet.uvue';
import { request } from '../../lib/api';
import { needLogin, currentUser } from '../../lib/session';
import { studyEventId } from '../../lib/learning';
import { formatChinaTime } from '../../lib/date-time';
import { openPage } from '../../lib/presentation';
import { addressText } from '../../lib/shopping';
import type { Address } from '../../lib/shopping';
import type { Slot } from '../../lib/bookings';
type Reward = {
  id: string;
  version: number;
  title: string;
  kind: string;
  pointsCost: string;
  remaining: number;
  perUserDaily: number;
  available: boolean;
  description: string;
  offeringId: string | null;
  offeringVersion: number | null;
  couponEndsAt?: string | null;
  unavailableReason?: string | null;
};
type RewardSnapshot = { title: string; kind: string };
type Redemption = {
  id: string;
  version: number;
  pointsCost: string;
  rewardSnapshot: RewardSnapshot;
  state: string;
  createdAt: string;
  orderId: string | null;
  appointmentId: string | null;
  returnReason: string | null;
  returnInstructions: string | null;
  returnCarrier: string | null;
  returnTrackingNo: string | null;
};
type Pending = { id: string; data: Record<string, unknown> };
const states: Record<string, string> = {
  FULFILLING: '待履约',
  COMPLETED: '已完成',
  REFUNDED: '已退分',
  RETURN_REQUESTED: '退货待审核',
  RETURN_APPROVED: '已同意，请寄回',
  RETURN_SHIPPED: '待核实收货',
};
const tab = ref('rewards'),
  balance = ref('0'),
  rewards = ref<Reward[]>([]),
  records = ref<Redemption[]>([]),
  selected = ref<Reward | null>(null),
  addresses = ref<Address[]>([]),
  address = ref<Address | null>(null),
  slots = ref<Slot[]>([]),
  slotId = ref(''),
  name = ref(''),
  phone = ref(''),
  consent = ref(false),
  busy = ref(false),
  loading = ref(false),
  error = ref(''),
  formError = ref(''),
  total = ref(0),
  pending = ref<Pending | null>(null),
  returning = ref<Redemption | null>(null),
  shipping = ref<Redemption | null>(null),
  reason = ref(''),
  carrier = ref(''),
  trackingNo = ref('');
let page = 1,
  generation = 0,
  owner = '';
function switchTab(value: string) {
  selected.value = null;
  tab.value = value;
  void load();
}
async function load(append = false) {
  if ((append && loading.value) || needLogin('/pages/marketing/points')) return;
  const turn = ++generation,
    next = append ? page + 1 : 1;
  loading.value = true;
  error.value = '';
  try {
    const [summary, data] = await Promise.all([
      request<{ available: string }>('/me/progression'),
      request<{ items: Reward[] | Redemption[]; total: number }>(
        (tab.value === 'rewards' ? '/points/rewards' : '/me/points/redemptions') + '?page=' + next,
      ),
    ]);
    if (turn !== generation) return;
    balance.value = summary.available;
    total.value = data.total;
    if (tab.value === 'rewards') {
      const rows = data.items as Reward[];
      rewards.value = append ? [...rewards.value, ...rows] : rows;
    } else {
      const rows = data.items as Redemption[];
      records.value = append ? [...records.value, ...rows] : rows;
    }
    page = next;
  } catch (e) {
    if (turn === generation) error.value = (e as Error).message;
  } finally {
    if (turn === generation) loading.value = false;
  }
}
async function select(reward: Reward) {
  if (busy.value) return;
  selected.value = reward;
  slotId.value = '';
  slots.value = [];
  consent.value = false;
  formError.value = '';
  busy.value = true;
  const turn = ++generation;
  try {
    if (reward.kind === 'PHYSICAL') {
      const rows = await request<Address[]>('/shopping/addresses');
      if (turn !== generation) return;
      addresses.value = rows;
      address.value =
        rows.find((a) => a.id === address.value?.id) ??
        rows.find((a) => a.isDefault) ??
        rows[0] ??
        null;
    }
    if (reward.offeringId) {
      const rows = await request<Slot[]>('/bookings/offerings/' + reward.offeringId + '/slots');
      if (turn === generation) slots.value = rows;
    }
  } catch (e) {
    formError.value = (e as Error).message;
  } finally {
    busy.value = false;
  }
}
function chooseAddress() {
  if (busy.value || pending.value) return;
  if (!addresses.value.length) {
    openPage('shop/addresses');
    return;
  }
  uni.showActionSheet({
    itemList: addresses.value.map((a) => a.recipient + ' · ' + addressText(a)),
    success: (r) => {
      address.value = addresses.value[r.tapIndex];
      consent.value = false;
    },
  });
}
function chooseSlot(slot: Slot) {
  if (!busy.value && !pending.value && slot.available > 0) {
    slotId.value = slot.id;
    consent.value = false;
  }
}
function toggleConsent() {
  if (!busy.value && !pending.value) consent.value = !consent.value;
}
async function redeem() {
  if (busy.value || !selected.value) return;
  const reward = selected.value;
  if (!pending.value) {
    if (reward.kind === 'PHYSICAL' && !address.value) {
      formError.value = '请先选择收货地址';
      return;
    }
    if (
      reward.kind === 'CONSULTATION' &&
      (!slotId.value || !name.value.trim() || !/^1[3-9]\d{9}$/.test(phone.value))
    ) {
      formError.value = '请选择时段并填写联系人及11位手机号';
      return;
    }
    pending.value = {
      id: reward.id,
      data: {
        requestKey: studyEventId(),
        expectedVersion: reward.version,
        consent: consent.value,
        ...(reward.kind === 'PHYSICAL'
          ? { addressId: address.value!.id }
          : reward.kind === 'CONSULTATION'
            ? {
                slotId: slotId.value,
                offeringVersion: reward.offeringVersion,
                name: name.value.trim(),
                phone: phone.value,
              }
            : {}),
      },
    };
  }
  busy.value = true;
  formError.value = '';
  try {
    await request('/me/points/rewards/' + pending.value.id + '/redeem', {
      method: 'POST',
      data: pending.value.data,
    });
    pending.value = null;
    selected.value = null;
    tab.value = 'records';
    uni.showToast({ title: '兑换已确认', icon: 'none' });
    await load();
  } catch (e) {
    formError.value = (e as Error).message;
    const status = (e as Error & { status?: number }).status;
    if (status && status >= 400 && status < 500) {
      pending.value = null;
      consent.value = false;
      formError.value += '；请返回列表刷新后重新确认。';
    } else formError.value += '；请重试核查同一兑换，不会重复扣分。';
  } finally {
    busy.value = false;
  }
}
function beginReturn(record: Redemption) {
  returning.value = record;
  reason.value = '';
  formError.value = '';
}
function beginShipment(record: Redemption) {
  shipping.value = record;
  carrier.value = '';
  trackingNo.value = '';
  formError.value = '';
}
async function submitReturn() {
  if (busy.value || !returning.value) return;
  busy.value = true;
  formError.value = '';
  try {
    await request('/me/points/redemptions/' + returning.value.id + '/cancel', {
      method: 'POST',
      data: { expectedVersion: returning.value.version, reason: reason.value.trim() },
    });
    returning.value = null;
    await load();
  } catch (e) {
    formError.value = (e as Error).message;
  } finally {
    busy.value = false;
  }
}
async function submitShipment() {
  if (busy.value || !shipping.value) return;
  busy.value = true;
  formError.value = '';
  try {
    await request('/me/points/redemptions/' + shipping.value.id + '/return-shipment', {
      method: 'POST',
      data: {
        expectedVersion: shipping.value.version,
        carrier: carrier.value.trim(),
        trackingNo: trackingNo.value.trim(),
      },
    });
    shipping.value = null;
    await load();
  } catch (e) {
    formError.value = (e as Error).message;
  } finally {
    busy.value = false;
  }
}
onShow(() => {
  const next = currentUser.value?.id ?? '';
  if (owner !== next) {
    owner = next;
    pending.value = null;
    selected.value = null;
    address.value = null;
    addresses.value = [];
    records.value = [];
    balance.value = '0';
    name.value = '';
    phone.value = '';
    returning.value = null;
    shipping.value = null;
  }
  if (selected.value && !pending.value) void select(selected.value);
  else void load();
});
onUnload(() => generation++);
</script>
<style>
@import '../../styles/app.css';
@import '../../styles/marketing.css';
/* 积分商城：页首 24/34 + 说明 13/22；余额与积分 24/34 + 单位 12/20 右对齐；兑换卡 16 内边距；输入 44 高描边圆角 10。 */
.content {
  padding-top: 16px;
  padding-bottom: 40px;
}
.page-title {
  font-family: AcademySerif;
  font-size: 24px;
  line-height: 34px;
  color: #182b31;
  font-weight: 600;
  letter-spacing: 0.4px;
  max-height: 68px;
  overflow: hidden;
}
.page-intro {
  font-family: sans-serif;
  font-size: 13px;
  line-height: 22px;
  color: #5c6869;
  margin-top: 8px;
}
.hint {
  font-family: sans-serif;
  font-size: 13px;
  line-height: 22px;
  color: #5c6869;
  margin-top: 12px;
}
.body-text {
  font-family: sans-serif;
  font-size: 15px;
  line-height: 26px;
  color: #344c54;
}
.points-copy {
  margin-top: 12px;
}
.points-balance-row {
  margin-top: 16px;
  padding: 16px;
  background-color: #fcf9f2;
  border-style: solid;
  border-width: 1px;
  border-color: #cfc5b1;
  border-radius: 14px;
}
.points-balance-label {
  font-family: sans-serif;
  font-size: 13px;
  line-height: 22px;
  color: #5c6869;
}
.points-balance {
  flex-direction: row;
  align-items: flex-end;
}
.value-number {
  font-family: AcademySerif;
  font-size: 24px;
  line-height: 34px;
  color: #235663;
  font-weight: 600;
}
.value-unit {
  font-family: sans-serif;
  font-size: 12px;
  line-height: 20px;
  color: #5c6869;
  margin-left: 3px;
  margin-bottom: 6px;
}
.filter-row {
  margin-top: 16px;
  border-bottom-width: 0;
}
.filter-pill {
  flex: 1;
  min-width: 0;
  justify-content: center;
  min-height: 48px;
  padding: 12px 0;
  font-size: 14px;
  line-height: 24px;
  color: #5c6869;
}
.filter-active {
  color: #182b31;
  border-bottom-color: #235663;
  font-weight: 600;
}
.points-entry {
  padding: 16px;
  margin-top: 16px;
  background-color: #fcf9f2;
  border-style: solid;
  border-width: 1px;
  border-color: #cfc5b1;
  border-radius: 14px;
}
.points-title {
  flex: 1;
  min-width: 0;
  font-family: AcademySerif;
  font-size: 17px;
  line-height: 26px;
  color: #182b31;
  font-weight: 600;
  max-height: 52px;
  overflow: hidden;
}
.points-cost {
  flex-direction: row;
  align-items: flex-end;
  flex-shrink: 0;
  margin-left: 12px;
}
.points-confirm {
  padding: 16px;
  margin-top: 16px;
  background-color: #fcf9f2;
  border-style: solid;
  border-width: 1px;
  border-color: #cfc5b1;
  border-radius: 14px;
}
.points-confirm-title {
  font-family: AcademySerif;
  font-size: 17px;
  line-height: 26px;
  color: #182b31;
  font-weight: 600;
}
.points-choice {
  padding: 0 12px;
  min-height: 48px;
  justify-content: center;
  margin-top: 16px;
  background-color: #f0eadd;
  border-style: solid;
  border-width: 1px;
  border-color: #cfc5b1;
  border-radius: 10px;
}
.points-slot {
  padding: 12px;
  margin-top: 12px;
