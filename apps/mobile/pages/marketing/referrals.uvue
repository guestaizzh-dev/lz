<template>
  <view class="page"
    ><InkBackdrop /><PageHead title="课程推广" /><scroll-view
      class="page-scroll"
      direction="vertical"
      :show-scrollbar="false"
      ><view class="content"
        ><ContentState
          v-if="loading || error"
          :loading="loading"
          :error="error"
          error-title="推广信息未能加载"
          @retry="load(false)"
        /><template v-else
          ><text class="ui-text page-title">分享好课，同行共学</text
          ><text class="ui-text page-intro"
            >仅一级推广，自购不计佣。被邀请人首次确认有效邀请码后保留 7
            天，下单时冻结来源；成团或课程实际交付后核对渠道费，观察 15
            天，售后中暂不可提现。最低提现 ¥100。</text
          ><view v-if="!profile || profile!.state === 'REJECTED'" class="referral-section"
            ><text v-if="profile?.reviewNote" class="ui-text hint">{{ profile!.reviewNote }}</text
            ><textarea
              class="ui-input referral-area"
              v-model="statement"
              placeholder="简单介绍你的课程推广方式（至少10字）"
              maxlength="500"
            /><view class="referral-consent" @click="consent = !consent"
              ><text class="ui-text meta"
                >{{ consent ? '☑' : '□' }} 我同意单层推广规则，提交真实收款资料，不自购计佣</text
              ></view
            ><button class="ui-button primary-button" :disabled="busy" @click="apply"
              >申请成为推广者</button
            ></view
          ><view v-else class="referral-section"
            ><text class="ui-text body-text">{{ stateName(profile!.state) }}</text
            ><text v-if="profile!.reviewNote" class="ui-text hint referral-copy">{{
              profile!.reviewNote
            }}</text
            ><template v-if="profile!.state === 'APPROVED'"
              ><text class="ui-text referral-code" :selectable="true">{{ profile!.code }}</text
              ><button class="ui-button secondary-button" @click="copyCode">复制邀请码</button
              ><text class="ui-text hint referral-copy"
                >请将邀请码发给受邀人，由对方在本页确认。系统不会自动覆盖已有的有效邀请来源。</text
              ></template
            ></view
          ><view class="referral-section"
            ><text class="ui-text section-title">佣金与提现</text
            ><view class="row between referral-copy"
              ><text class="ui-text meta">可提现</text
              ><view class="referral-amount"
                >¥<text class="ui-text value-number">{{
                  money(Number(balance.available) > 0 ? Number(balance.available) : 0)
                }}</text></view
              ></view
            ><text class="ui-text hint referral-copy"
              >观察期中 ¥{{ money(Number(balance.observing))
              }}<text class="ui-text" v-if="Number(balance.available) < 0">
                · 退款待抵扣 ¥{{ money(-Number(balance.available)) }}</text
              ></text
            ><button
              v-if="profile?.state === 'APPROVED' && !withdrawing"
              class="ui-button secondary-button referral-copy"
              :disabled="Number(balance.available) < 10000"
              @click="withdrawing = true"
              >申请提现</button
            ><view v-if="withdrawing"
              ><text class="ui-text hint referral-copy"
                >实际银行转账由财务核对后处理，批准申请不代表已到账。</text
              ><input
                class="ui-input referral-input"
                v-model="amount"
                type="digit"
                placeholder="提现金额（元，最低100）"
              /><input
                class="ui-input referral-input"
                v-model="recipient"
                placeholder="真实收款人姓名"
                maxlength="80"
              /><input
                class="ui-input referral-input"
                v-model="bank"
                placeholder="收款银行及支行"
                maxlength="120"
              /><input
                class="ui-input referral-input"
                v-model="account"
                type="number"
                placeholder="收款银行账号"
                maxlength="30"
              /><view class="row referral-actions"
                ><button
                  class="ui-button secondary-button referral-action"
                  :disabled="busy"
                  @click="withdrawing = false"
                  >暂不申请</button
                ><button
                  class="ui-button primary-button referral-action referral-action-confirm"
                  :disabled="busy"
                  @click="withdraw"
                  >确认申请</button
                ></view
              ></view
            ></view
          ><view class="referral-section"
            ><text class="ui-text section-title">收到邀请码</text
            ><text class="ui-text hint referral-copy">仅填写你首次收到且确认使用的推广邀请码。</text
            ><input
              class="ui-input referral-input"
              v-model="inviteCode"
              placeholder="输入16位推广邀请码"
              maxlength="16"
            /><button class="ui-button secondary-button" :disabled="busy" @click="attribute"
              >确认使用邀请码</button
            ></view
          ><view class="filter-row"
            ><button
              class="ui-button"
              :class="['filter-pill', tab === 'ledger' ? 'filter-active' : '']"
              @click="tab = 'ledger'"
              >佣金明细</button
            ><button
              class="ui-button"
              :class="['filter-pill', tab === 'withdrawals' ? 'filter-active' : '']"
              @click="tab = 'withdrawals'"
              >提现记录</button
            ></view
          ><ContentState
            v-if="
              (tab === 'ledger' && !items.length) || (tab === 'withdrawals' && !withdrawals.length)
            "
            title="暂无记录"
            description="实际交付、费用核对或提现申请后，记录会保存在这里。"
            action-label="浏览课程"
            @action="openPage('course/library')"
          /><template v-if="tab === 'ledger'"
            ><view v-for="item in items" :key="item.id" class="referral-entry"
              ><view class="row between"
                ><text class="ui-text body-text">{{
                  item.reversalOfId ? '退课冲回' : '课程推广佣金'
                }}</text
                ><text class="ui-text meta"
                  >{{ Number(item.delta) > 0 ? '+' : '' }}¥{{ money(Number(item.delta)) }}</text
                ></view
              ><text class="ui-text hint referral-copy"
                >{{ formatChinaTime(item.createdAt) }}（北京）</text
              ><text v-if="!item.reversalOfId" class="ui-text hint"
                >观察期至 {{ formatChinaTime(item.availableAt) }}（北京），售后状态另行复验</text
              ></view
            ></template
          ><template v-else
            ><view v-for="item in withdrawals" :key="item.id" class="referral-entry"
              ><view class="row between"
                ><text class="ui-text body-text">{{ stateName(item.state) }}</text
                ><text class="ui-text meta">¥{{ money(Number(item.amount)) }}</text></view
              ><text class="ui-text hint referral-copy"
                >{{ formatChinaTime(item.createdAt) }}（北京）</text
              ><text v-if="item.failureCode" class="ui-text hint">{{ item.failureCode }}</text
              ><text v-if="item.paidAt" class="ui-text hint"
                >实际付款 {{ formatChinaTime(item.paidAt) }}（北京）</text
              ></view
            ></template
          ><button
            v-if="items.length < total || withdrawals.length < withdrawalTotal"
            class="ui-button secondary-button referral-copy"
            :disabled="loading"
            @click="load(true)"
            >查看更多记录</button
          ></template
        ></view
      ></scroll-view
    ></view
  >
</template>
<script setup lang="ts">
import InkBackdrop from '../../components/InkBackdrop.uvue';
import PageHead from '../../components/PageHead.uvue';
import ContentState from '../../components/ContentState.uvue';
import { request, money } from '../../lib/api';
import { needLogin, currentUser } from '../../lib/session';
import { studyEventId } from '../../lib/learning';
import { apiBase } from '../../lib/environment';
import { openPage } from '../../lib/presentation';
import { formatChinaTime } from '../../lib/date-time';
type Profile = { id: string; code: string | null; state: string; reviewNote: string | null };
type Balance = { available: string; observing: string };
type Entry = {
  id: string;
  createdAt: string;
  availableAt: string;
  delta: string;
  reversalOfId: string | null;
};
type Withdrawal = {
  id: string;
  createdAt: string;
  amount: string;
  state: string;
  paidAt: string | null;
  failureCode: string | null;
};
type Overview = {
  profile: Profile | null;
  balance: Balance;
  items: Entry[];
  total: number;
  withdrawals: Withdrawal[];
  withdrawalTotal: number;
};
const profile = ref<Profile | null>(null),
  balance = ref<Balance>({ available: '0', observing: '0' }),
  items = ref<Entry[]>([]),
  withdrawals = ref<Withdrawal[]>([]),
  total = ref(0),
  withdrawalTotal = ref(0),
  tab = ref('ledger'),
  statement = ref(''),
  consent = ref(false),
  inviteCode = ref(''),
  withdrawing = ref(false),
  recipient = ref(''),
  bank = ref(''),
  account = ref(''),
  amount = ref(''),
  busy = ref(false),
  loading = ref(false),
  error = ref('');
let generation = 0,
  page = 1,
  key = '',
  owner = '';
function stateName(state: string) {
  return (
    (
      {
        PENDING: '待审核',
        APPROVED: '已批准',
        SUSPENDED: '已暂停推广',
        REJECTED: '已拒绝',
        PAID: '已实际付款',
      } as Record<string, string>
    )[state] ?? '处理中'
  );
}
async function load(append = false) {
  if (append && loading.value) return;
  if (
    needLogin('/pages/marketing/referrals' + (inviteCode.value ? '?code=' + inviteCode.value : ''))
  )
    return;
  const turn = ++generation,
    next = append ? page + 1 : 1;
  loading.value = true;
  error.value = '';
  try {
    const r = await request<Overview>('/me/referrals?page=' + next);
    if (turn !== generation) return;
    profile.value = r.profile;
    balance.value = r.balance;
    items.value = append ? [...items.value, ...r.items] : r.items;
    withdrawals.value = append ? [...withdrawals.value, ...r.withdrawals] : r.withdrawals;
    total.value = r.total;
    withdrawalTotal.value = r.withdrawalTotal;
    page = next;
  } catch (e) {
    if (turn === generation) error.value = (e as Error).message;
  } finally {
    if (turn === generation) loading.value = false;
  }
}
async function perform(path: string, data: Record<string, unknown>, done: string) {
  if (busy.value) return false;
  busy.value = true;
  const user = currentUser.value?.id;
  try {
    await request(path, { method: 'POST', data });
    if (user !== currentUser.value?.id) return false;
    uni.showToast({ title: done, icon: 'none' });
    await load();
    return true;
  } catch (e) {
    uni.showToast({ title: (e as Error).message, icon: 'none' });
    return false;
  } finally {
    busy.value = false;
  }
}
function apply() {
  void perform(
    '/me/referrals/apply',
    { statement: statement.value.trim(), consent: consent.value },
    '申请已提交',
  );
}
function attribute() {
  void perform(
    '/me/referrals/attribute',
    { code: inviteCode.value.trim().toUpperCase() },
    '已确认邀请，已有有效来源将保留',
  );
}
function copyCode() {
  if (profile.value?.code)
    uni.setClipboardData({
      data:
        '老子道学书院课程邀请：' +
        profile.value.code +
        '\n' +
        apiBase +
        '/referrals/open/' +
        profile.value.code,
    });
}
async function withdraw() {
  if (!/^\d+(\.\d{1,2})?$/.test(amount.value.trim())) {
    uni.showToast({ title: '请输入正确金额，最多两位小数', icon: 'none' });
    return;
  }
  const minor = Math.round(Number(amount.value) * 100);
  if (minor < 10000 || minor > Number(balance.value.available)) {
    uni.showToast({ title: '请核对可提现金额，最低100元', icon: 'none' });
    return;
  }
  key ||= studyEventId();
  const saved = await perform(
    '/me/referrals/withdrawals',
    {
      requestKey: key,
      amount: minor,
      recipient: recipient.value.trim(),
      bank: bank.value.trim(),
      account: account.value.trim(),
    },
    '申请已提交，请等待财务审核',
  );
  if (saved) {
    key = '';
    withdrawing.value = false;
    recipient.value = '';
    bank.value = '';
    account.value = '';
    amount.value = '';
  }
}
onLoad((options) => {
  if (/^[A-F0-9]{16}$/.test(options.code ?? '')) inviteCode.value = options.code!;
});
onShow(() => {
  const next = currentUser.value?.id ?? '';
  if (owner !== next) {
    owner = next;
    key = '';
    recipient.value = '';
    bank.value = '';
    account.value = '';
    amount.value = '';
    statement.value = '';
    consent.value = false;
    withdrawing.value = false;
    items.value = [];
    withdrawals.value = [];
    profile.value = null;
    balance.value = { available: '0', observing: '0' };
  }
  void load();
});
onUnload(() => generation++);
</script>
<style>
@import '../../styles/app.css';
@import '../../styles/marketing.css';
/* 课程推广：页首 24/34 + 说明 13/22；区块为纸面卡 16 内边距；输入 44 高描边圆角 10；金额 24/34 单位 12/20 右对齐。 */
.content {
  padding-top: 16px;
  padding-bottom: 40px;
}
.page-title {
  font-family: AcademySerif;
  font-size: 24px;
  line-height: 34px;
  color: #182b31;
  font-weight: 600;
  letter-spacing: 0.4px;
}
.page-intro {
  font-family: sans-serif;
  font-size: 13px;
  line-height: 22px;
  color: #5c6869;
  margin-top: 8px;
}
.hint {
  font-family: sans-serif;
  font-size: 13px;
  line-height: 22px;
  color: #5c6869;
  margin-top: 12px;
}
.body-text {
  font-family: sans-serif;
  font-size: 15px;
  line-height: 26px;
  color: #344c54;
}
.section-title {
  font-family: AcademySerif;
  font-size: 19px;
  line-height: 28px;
  color: #182b31;
  font-weight: 600;
}
.referral-copy {
  margin-top: 12px;
}
.referral-section {
  padding: 16px;
  margin-top: 16px;
  background-color: #fcf9f2;
  border-style: solid;
  border-width: 1px;
  border-color: #cfc5b1;
  border-radius: 14px;
}
.referral-input {
  height: 44px;
  min-height: 44px;
  padding: 0 12px;
  margin-top: 12px;
  background-color: #fcf9f2;
  border-style: solid;
  border-width: 1px;
  border-color: #cfc5b1;
  border-radius: 10px;
  font-size: 15px;
  line-height: 24px;
  font-family: sans-serif;
  color: #182b31;
}
.referral-area {
  width: 100%;
  height: 110px;
  padding: 12px;
  margin-top: 12px;
  background-color: #fcf9f2;
  border-style: solid;
  border-width: 1px;
  border-color: #cfc5b1;
  border-radius: 10px;
  font-size: 15px;
  line-height: 26px;
  font-family: sans-serif;
  color: #182b31;
}
.referral-consent {
  padding: 12px 0;
  min-height: 44px;
}
.referral-code {
  font-family: AcademySerif;
  font-size: 24px;
  line-height: 34px;
  color: #235663;
  padding: 12px 0;
}
.referral-amount {
  flex-direction: row;
  align-items: flex-end;
}
.value-prefix {
  font-family: sans-serif;
  font-size: 12px;
  line-height: 20px;
  color: #5c6869;
  margin-bottom: 6px;
}
.value-number {
  font-family: AcademySerif;
  font-size: 24px;
  line-height: 34px;
  color: #235663;
  font-weight: 600;
  margin-left: 2px;
}
.referral-actions {
  margin-top: 16px;
  flex-direction: row;
  align-items: center;
}
.referral-action {
  flex: 1;
  min-height: 48px;
  margin-top: 0;
}
.referral-action-confirm {
  margin-left: 12px;
}
.referral-entry {
  padding: 15px 0;
  border-bottom-width: 1px;
  border-bottom-style: solid;
  border-bottom-color: #e0d8c8;
}
.filter-row {
  margin-top: 24px;
  border-bottom-width: 0;
}
.filter-pill {
  flex: 1;
  min-width: 0;
  justify-content: center;
  min-height: 48px;
  padding: 12px 0;
  font-size: 14px;
  line-height: 24px;
  color: #5c6869;
}
.filter-active {
  color: #182b31;
  border-bottom-color: #235663;
  font-weight: 600;
}
.form-feedback {
  font-family: sans-serif;
  font-size: 13px;
  line-height: 22px;
  color: #b4533f;
  margin-top: 10px;
}
</style>
