<template><view class="page"><PageHead title="签名礼遇"/><scroll-view class="page-scroll" direction="vertical" :show-scrollbar="false"><view class="content"><text class="section-title">一份书香，伴你研习</text><text class="hint gift-copy">仅按原会员固定版本提供实际预留的签名书籍或文创，每段会员一份。普通配送包邮，仅开放配送地区；到期未领取失效，已确认领取继续履约。</text><view class="filter-row"><button :class="['filter-pill',tab==='available'?'filter-active':'']" :disabled="busy||!!pending" @click="switchTab('available')">我的礼遇</button><button :class="['filter-pill',tab==='claims'?'filter-active':'']" :disabled="busy||!!pending" @click="switchTab('claims')">领取记录</button></view><ContentState v-if="loading||error" :loading="loading" :error="error" @retry="load(false)"/>
<view v-if="selected" class="gift-confirm"><text class="section-title">{{selected!.title}}</text><text class="body-text gift-copy">{{selected!.productTitle}} · {{selected!.skuTitle}}</text><text class="hint gift-copy">{{selected!.description}}</text><view class="gift-address" @click="chooseAddress"><text class="body-text">{{address?address!.recipient+'　'+address!.phone:'选择收货地址 ›'}}</text><text v-if="address" class="hint gift-copy">{{addressText(address!)}}</text></view><button class="text-button" :disabled="busy||!!pending" @click="openPage('shop/addresses')">管理收货地址</button><view class="gift-consent" @click="!busy&&!pending&&(consent=!consent)"><text class="meta">{{consent?'☑':'□'}} 已确认本次签名商品、普通配送及取消退货规则，无额外现金支付</text></view><text v-if="formError" class="form-feedback">{{formError}}</text><button class="primary-button" :disabled="busy||!consent||!address" @click="claim">{{busy?'正在确认…':pending?'核查原领取请求':'确认领取'}}</button><button class="text-button gift-copy" :disabled="busy||!!pending" @click="selected=null">返回礼遇</button></view>
<template v-else-if="tab==='available'"><ContentState v-if="!loading&&!error&&!items.length" title="暂无可领取的签名礼遇" description="仅含此项实际权益的会员版本提供；旧会员权益保持原约定。"/><view v-for="item in items" :key="item.id" class="gift-entry"><text class="section-title">{{item.title}}</text><text class="body-text gift-copy">{{item.productTitle}} · {{item.skuTitle}}</text><text class="hint gift-copy">{{item.description}}</text><text class="hint gift-copy">{{formatChinaTime(item.startsAt)}} 至 {{formatChinaTime(item.endsAt)}}（北京）</text><text v-if="item.blockedReason" class="hint gift-copy">{{item.blockedReason}}</text><button class="secondary-button gift-copy" :disabled="busy||!item.canClaim" @click="select(item)">{{item.state==='CLAIMED'?'已领取，请查看记录':item.canClaim?'选择地址并领取':'当前不可领取'}}</button></view></template>
<template v-else><ContentState v-if="!loading&&!error&&!records.length" title="还没有领取记录" description="确认领取后，可在这里查看发货与办理售后。"/><view v-for="record in records" :key="record.id" class="gift-entry"><view class="row between"><text class="section-title grow">{{record.title}}</text><text class="meta">{{states[record.state]??'处理中'}}</text></view><text class="hint gift-copy">{{formatChinaTime(record.createdAt)}}（北京） · 无额外现金付款</text><text v-if="record.returnReason" class="hint gift-copy">申请说明：{{record.returnReason}}</text><text v-if="record.returnInstructions" class="body-text gift-copy" :user-select="true">寄回说明：{{record.returnInstructions}}</text><text v-if="record.returnTrackingNo" class="hint gift-copy" :user-select="true">{{record.returnCarrier}} {{record.returnTrackingNo}}</text><button class="secondary-button gift-copy" @click="openPage('shop/order-detail?id='+record.orderId)">发货与物流</button><button v-if="['FULFILLING','COMPLETED'].includes(record.state)" class="text-button gift-copy" :disabled="busy" @click="beginReturn(record)">取消领取 / 申请退货</button><button v-if="record.state==='RETURN_APPROVED'" class="secondary-button gift-copy" :disabled="busy" @click="beginShipment(record)">填写实际寄回物流</button></view><button v-if="records.length<total" class="secondary-button gift-copy" :disabled="loading" @click="load(true)">查看更多</button></template></view></scroll-view>
<ComposeSheet :visible="!!returning" title="取消领取 / 商品退货" v-model="reason" :saving="busy" :error="formError" :disabled="reason.trim().length<2" placeholder="说明取消或退货原因，至少2字" submitLabel="提交申请" @close="!busy&&(returning=null)" @submit="submitReturn"><text class="hint">未发货返还当前会员领取额度；发货后先审核，实际寄回并核实入库后返还。到期或撤销会员不恢复新领取资格，不退现金。</text></ComposeSheet>
<ComposeSheet :visible="!!shipping" title="填写实际寄回物流" v-model="trackingNo" :saving="busy" :error="formError" :disabled="!carrier.trim()||!trackingNo.trim()" placeholder="实际寄回运单号" submitLabel="提交物流" @close="!busy&&(shipping=null)" @submit="submitShipment"><input class="gift-input" v-model="carrier" maxlength="40" placeholder="快递公司名称"/></ComposeSheet></view></template>
<script setup lang="ts">
import PageHead from '../../components/PageHead.uvue';import ContentState from '../../components/ContentState.uvue';import ComposeSheet from '../../components/ComposeSheet.uvue';import {request} from '../../lib/api';import {needLogin,currentUser} from '../../lib/session';import {studyEventId} from '../../lib/learning';import {formatChinaTime} from '../../lib/date-time';import {openPage} from '../../lib/presentation';import {addressText} from '../../lib/shopping';import type {Address} from '../../lib/shopping';
type Gift={id:string;title:string;description:string;productTitle:string;skuTitle:string;cover:string;startsAt:string;endsAt:string;state:string;canClaim:boolean;blockedReason:string};type Claim={id:string;version:number;title:string;state:string;createdAt:string;orderId:string;returnReason:string|null;returnInstructions:string|null;returnCarrier:string|null;returnTrackingNo:string|null};type ClaimRequest={requestKey:string;addressId:string;consent:boolean};type Pending={id:string;data:ClaimRequest};
const states:Record<string,string>={FULFILLING:'待发货/收货',COMPLETED:'已收货',CANCELLED:'已取消返还',RETURN_REQUESTED:'退货审核中',RETURN_APPROVED:'已同意，请寄回',RETURN_SHIPPED:'待核实入库'},tab=ref('available'),items=ref<Gift[]>([]),records=ref<Claim[]>([]),selected=ref<Gift|null>(null),addresses=ref<Address[]>([]),address=ref<Address|null>(null),consent=ref(false),loading=ref(false),busy=ref(false),error=ref(''),formError=ref(''),total=ref(0),pending=ref<Pending|null>(null),returning=ref<Claim|null>(null),shipping=ref<Claim|null>(null),reason=ref(''),carrier=ref(''),trackingNo=ref('');let page=1,generation=0,owner='';
function switchTab(value:string){selected.value=null;tab.value=value;void load();}
async function load(append=false){if(loading.value&&append||needLogin('/pages/membership/gifts'))return;const run=++generation,next=append?page+1:1;loading.value=true;error.value='';try{if(tab.value==='available'){const r=await request<{items:Gift[]}>('/me/member-gifts');if(run===generation)items.value=r.items;}else{const r=await request<{items:Claim[];total:number}>('/me/member-gifts/claims?page='+next);if(run===generation){records.value=append?[...records.value,...r.items]:r.items;total.value=r.total;page=next;}}}catch(e){if(run===generation)error.value=(e as Error).message;}finally{if(run===generation)loading.value=false;}}
async function select(item:Gift){if(busy.value)return;selected.value=item;consent.value=false;formError.value='';busy.value=true;const run=++generation;try{const rows=await request<Address[]>('/shopping/addresses');if(run!==generation)return;addresses.value=rows;address.value=rows.find(a=>a.id===address.value?.id)??rows.find(a=>a.isDefault)??rows[0]??null;}catch(e){formError.value=(e as Error).message;}finally{busy.value=false;}}
function chooseAddress(){if(busy.value||pending.value)return;if(!addresses.value.length){openPage('shop/addresses');return;}uni.showActionSheet({itemList:addresses.value.map(a=>a.recipient+' '+a.province+a.city+a.district),success:r=>{address.value=addresses.value[r.tapIndex];}});}
async function claim(){if(busy.value||!selected.value||!address.value||!consent.value)return;busy.value=true;formError.value='';pending.value??={id:selected.value.id,data:{requestKey:studyEventId(),addressId:address.value.id,consent:true}};try{await request('/me/member-gifts/'+pending.value.id+'/claim',{method:'POST',data:pending.value.data});pending.value=null;selected.value=null;tab.value='claims';uni.showToast({title:'已确认领取',icon:'none'});await load();}catch(e){formError.value=(e as Error).message;if([400,403,404,409].includes((e as Error&{status?:number}).status??0))pending.value=null;}finally{busy.value=false;}}
function beginReturn(row:Claim){returning.value=row;reason.value='';formError.value='';}function beginShipment(row:Claim){shipping.value=row;carrier.value='';trackingNo.value='';formError.value='';}
async function submitReturn(){if(!returning.value||busy.value)return;busy.value=true;formError.value='';try{await request('/me/member-gifts/claims/'+returning.value.id+'/cancel',{method:'POST',data:{expectedVersion:returning.value.version,reason:reason.value.trim()}});returning.value=null;await load();}catch(e){formError.value=(e as Error).message;}finally{busy.value=false;}}
async function submitShipment(){if(!shipping.value||busy.value)return;busy.value=true;formError.value='';try{await request('/me/member-gifts/claims/'+shipping.value.id+'/return-shipment',{method:'POST',data:{expectedVersion:shipping.value.version,reason:'本人提交实际寄回物流',carrier:carrier.value.trim(),trackingNo:trackingNo.value.trim()}});shipping.value=null;await load();}catch(e){formError.value=(e as Error).message;}finally{busy.value=false;}}
onShow(()=>{const next=currentUser.value?.id??'';if(owner!==next){owner=next;items.value=[];records.value=[];selected.value=null;pending.value=null;returning.value=null;shipping.value=null;address.value=null;addresses.value=[];reason.value='';carrier.value='';trackingNo.value='';}if(selected.value&&!pending.value)void select(selected.value);else void load();});onUnload(()=>generation++);
</script><style>@import '../../styles/app.css';@import '../../styles/marketing.css';.gift-copy{margin-top:12px;}.gift-entry{padding:22px 0;border-bottom-width:1px;border-bottom-style:solid;border-bottom-color:#DFD9CF;}.gift-confirm{padding:18px;background-color:#EFECE4;border-radius:8px;margin-top:16px;}.gift-address{margin-top:18px;padding:14px;border-width:1px;border-style:solid;border-color:#D8D4CA;border-radius:6px;}.gift-consent{padding:18px 0;min-height:48px;}.gift-input{font-family:AcademySans;min-height:48px;border-bottom-width:1px;border-bottom-style:solid;border-bottom-color:#D8D4CA;}</style>
