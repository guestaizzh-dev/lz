<template>
  <view class="page"
    ><InkBackdrop /><PageHead title="会员中心" /><scroll-view
      class="page-scroll"
      direction="vertical"
      :show-scrollbar="false"
      ><view class="content member-center">
        <view class="member-pass"
          ><view class="row between"
            ><view
              ><text class="pass-caption">道学书院 · 会员礼遇</text
              ><text class="pass-name">{{
                currentUser
                  ? loading
                    ? '正在核对会员'
                    : gradeNames[data?.displayTier ?? data?.member?.tier ?? 0]
                  : '欢迎加入书院'
              }}</text></view
            ><view class="pass-mark"
              ><image
                class="pass-crown"
                src="/static/icons/crown-white.png"
                mode="aspectFit" /></view></view
          ><text class="pass-status">{{
            !currentUser
              ? '登录后管理会员与专属权益'
              : data?.serviceReady === false
                ? '会员购买暂未开放'
                : data?.member?.state === 'REFUND_HELD'
                  ? '退款办理中 · 本次权益暂停'
                  : '一次开通，长期礼遇'
          }}</text
          ><view class="pass-wallet"
            ><view
              ><text class="pass-wallet-label">可用视频代金券</text
              ><view class="row pass-wallet-number"
                ><text class="pass-balance">{{
                  data && data!.serviceReady !== false ? data!.voucher.available : '—'
                }}</text
                ><text class="pass-unit">份</text
                ><text class="pass-wallet-value">{{
                  data && data!.serviceReady !== false
                    ? '抵扣 ¥' +
                      money(
                        data!.voucher.availableValue ??
                          data!.voucher.available * data!.voucher.value,
                      )
                    : '待开放'
                }}</text></view
              ></view
            ><view class="pass-wallet-actions"
              ><view class="pass-wallet-link" @click="openWallet(true)"
                ><text class="pass-link-text">我的券 ›</text></view
              ><view class="pass-wallet-link" @click="openWallet(false)"
                ><text class="pass-link-text">购券 ›</text></view
              ></view
            ></view
          ></view
        >
        <ContentState v-if="loading || error" :loading="loading" :error="error" @retry="load" />
        <template v-else-if="data"
          ><text v-if="data!.serviceReady === false" class="service-note"
            >可先查看各档权益，购买与视频券服务暂未开放。已有套餐及订单可从下方历史入口查看。</text
          >
          <view class="member-section-head"
            ><view
              ><text class="member-section-title">升级书院礼遇</text
              ><text class="section-description">选择适合你的等级，权益一目了然</text></view
            ></view
          >
          <view class="registered-row"
            ><text class="registered-title">注册会员</text
            ><text class="member-footnote">免费注册 · 商品原价 · 不赠券</text></view
          >
          <view
            v-for="grade in data!.grades"
            :key="grade.tier"
            :class="[
              'grade-card',
              'grade-tone-' + grade.tier,
              data!.member?.tier === grade.tier ? 'grade-current' : '',
            ]"
            @click="choose(grade)"
          >
            <view class="row between"
              ><view class="row"
                ><view :class="['grade-symbol', 'grade-symbol-' + grade.tier]"
                  ><AppIcon name="crown" :size="17" :active="true" /></view
                ><text class="grade-title">{{ grade.title }}</text></view
              ><view class="row"
                ><text class="grade-price">¥{{ money(grade.price) }}</text
                ><text class="grade-term"> 一次开通</text></view
              ></view
            >
            <view class="grade-benefits"
              ><view class="grade-benefit"
                ><text class="grade-benefit-value">{{ discountText(grade.goodsBasisPoints) }}</text
                ><text class="grade-benefit-label">生活馆商品</text></view
              ><view class="grade-benefit"
                ><text class="grade-benefit-value">{{ discountText(grade.bookBasisPoints) }}</text
                ><text class="grade-benefit-label">图书专享</text></view
              ><view class="grade-benefit"
                ><text class="grade-benefit-value">{{ grade.voucherQuantity }}份</text
                ><text class="grade-benefit-label">视频代金券</text></view
              ></view
            >
            <view class="grade-footer"
              ><text class="grade-gift-value"
                >{{ data!.member?.tier === grade.tier ? '当前等级 · ' : '' }}赠券价值 ¥{{
                  money(grade.voucherQuantity * data!.voucher.value)
                }}</text
              ><text class="grade-entry">{{
                !grade.active
                  ? '暂未开放'
                  : (data!.member?.tier ?? 0) >= grade.tier
                    ? '已享此档权益'
                    : data!.member
                      ? '补差 ¥' +
                        money(Math.max(0, grade.price - data!.member!.priceCredit)) +
                        ' 升级 ›'
                      : '查看并开通 ›'
              }}</text></view
            >
          </view>
          <view class="member-rules"
            ><text class="ui-text member-section-title">购买前了解</text
            ><text class="member-rule"
              >会员费购买等级资格，不转为消费余额。升级只补差价、补赠券差额，不重复发券。</text
            ><text class="member-rule"
              >图书使用独立折扣，不与其他促销折上折。视频按课程价格购买，可使用代金券抵扣。</text
            ><text class="member-rule">{{ data!.refundPolicy }}</text></view
          >
          <view class="member-links"
            ><button
              v-if="data!.serviceReady !== false"
              class="ui-button member-link"
              @click="openPage('membership/center-orders')"
              >会员及购券记录 ›</button
            ><button class="ui-button member-link" @click="openPage('membership/orders')"
              >历史套餐与售后 ›</button
            ><button class="ui-button member-link" @click="openPage('membership/gifts')"
              >历史签名礼遇 ›</button
            ></view
          >
        </template>
      </view></scroll-view
    ></view
  >
</template>
<script setup lang="ts">
import InkBackdrop from '../../components/InkBackdrop.uvue';
import PageHead from '../../components/PageHead.uvue';
import ContentState from '../../components/ContentState.uvue';
import AppIcon from '../../components/AppIcon.uvue';
import { money } from '../../lib/api';
import { currentUser, needLogin } from '../../lib/session';
import { openPage } from '../../lib/presentation';
import { getMemberOverview, gradeNames, discountText } from '../../lib/member-center';
import type { CenterOverview, MemberGrade } from '../../lib/member-center';
const data = ref<CenterOverview | null>(null),
  loading = ref(true),
  error = ref('');
let revision = 0;
async function load() {
  const turn = ++revision;
  loading.value = !data.value;
  error.value = '';
  try {
    const result = await getMemberOverview(!!currentUser.value);
    if (turn === revision) data.value = result;
  } catch (e) {
    if (turn === revision) error.value = (e as Error).message;
  } finally {
    if (turn === revision) loading.value = false;
  }
}
function openWallet(wallet: boolean) {
  if (data.value?.serviceReady === false) {
    uni.showToast({ title: '视频代金券服务暂未开放', icon: 'none' });
    return;
  }
  openPage('membership/vouchers' + (wallet ? '?tab=wallet' : ''));
}
function choose(grade: MemberGrade) {
  if (!grade.active || (data.value?.member?.tier ?? 0) >= grade.tier) return;
  const target = '/pages/membership/center-purchase?kind=MEMBER_LIFETIME&tier=' + grade.tier;
  if (needLogin(target)) return;
  openPage('membership/center-purchase?kind=MEMBER_LIFETIME&tier=' + grade.tier);
}
onShow(() => {
  data.value = null;
  void load();
});
onUnload(() => {
  revision++;
});
</script>
