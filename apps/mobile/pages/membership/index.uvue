<template>
<view class="page">
<PageHead title="会员中心"/>
<scroll-view :show-scrollbar="false" class="page-scroll" direction="vertical">
<view class="content">
<view class="membership-card">
<AppIcon name="crown" :size="34" :active="true"/>
<text class="membership-title">书院会员</text>
<text class="membership-copy">让研习成为日常</text>
<text class="membership-status">{{member?member!.plan.title+' · 到期 '+formatChinaDate(member!.endsAt):currentUser?'暂未开通会员':'登录后查看会员状态'}}</text>
</view>
<view class="detail-tabs">
<view v-for="item in ['入门会员','进阶会员','至尊会员']" :key="item" :class="['detail-tab',tier===item?'detail-tab-active':'']" @click="chooseTier(item)">
<text :class="['detail-tab-text',tier===item?'detail-tab-selected':'']">{{item}}</text>
</view>
</view>
<view class="section">
<text class="section-heading">{{tier}} · 会员套餐</text>
<view class="rights-grid">
<view v-for="item in rights" :key="item.label" class="rights-item">
<AppIcon :name="item.icon" :size="25"/>
<text class="rights-label">{{item.label}}</text>
</view>
</view>
<ContentState v-if="loading||error" :loading="loading" :error="error" @retry="load"/>
<view v-for="plan in visiblePlans" :key="plan.id" :class="['plan-row',selectedPlanId===plan.id?'plan-selected':'']" @click="selectedPlanId=plan.id"><view class="plan-top"><text class="item-title grow">{{plan.termLabel??plan.title}} · {{plan.days}}天</text><text class="price">¥{{money(plan.price)}}</text></view><text :class="['plan-choice',selectedPlanId===plan.id?'plan-choice-active':'']">{{selectedPlanId===plan.id?'已选择此套餐':'点击选择套餐'}}</text><text class="plan-choice">内容范围：{{membershipContentLabel(plan.contentTier??plan.tier)}}</text><text class="plan-copy" :user-select="true">{{plan.description}}</text></view>
<view v-if="benefitSummary&&benefitSummary!.memberships.length" class="section"><text class="section-heading">我的实际权益</text><view v-for="period in benefitSummary!.memberships" :key="period.id" class="plan-row"><view class="plan-top"><text class="item-title grow">{{period.plan.title}}</text><text class="plan-choice">{{period.state==='REFUND_PENDING'?'退款办理中 · 暂停':period.state==='QUEUED'?'待生效':'当前有效'}}</text></view><text class="footer-note">{{formatChinaDate(period.startsAt)}} 至 {{formatChinaDate(period.endsAt)}}</text><text v-for="benefit in period.benefits" :key="benefit.code" class="body-copy">{{membershipBenefitLabel(benefit)}}</text></view><text v-if="benefitSummary!.membershipTotal>50" class="footer-note">另有更多待生效授权，可联系书院核查排队记录。</text></view>
<view v-if="benefitSummary&&benefitSummary!.quotas.length" class="section"><text class="section-heading">可用额度</text><view v-for="quota in benefitSummary!.quotas" :key="(quota.periodId??quota.grantId??'')+quota.name" class="plan-row"><text class="item-title">{{quota.name}}</text><text class="body-copy">剩余 {{quota.remaining}} / {{quota.quota}} · 已使用及预占 {{quota.used}}</text></view></view>
<view v-if="benefitSummary&&benefitSummary!.usage.total>0" class="section"><text class="section-heading">近期权益用量</text><view v-for="usage in benefitSummary!.usage.items" :key="usage.id" class="plan-row"><view class="plan-top"><text class="item-title">{{usage.name}} · {{usage.quantity}}</text><text class="plan-choice">{{benefitUsageLabel(usage.state)}}</text></view><text class="footer-note">{{formatChinaDate(usage.createdAt)}}</text></view><button v-if="benefitSummary!.usage.total>benefitSummary!.usage.items.length" :class="['outline-action',usageLoading?'is-disabled':'']" @click="loadMoreUsage">{{usageLoading?'加载中…':'查看更多用量'}}</button></view>
<button class="outline-action" @click="openPage('membership/gifts')">签名书籍与文创礼遇 ›</button><button class="outline-action" @click="openPage('membership/orders')">我的会员订单与售后 ›</button><text v-if="!loading&&!error&&!visiblePlans.length" class="footer-note">此层级套餐尚未发布。</text><text v-if="member" class="footer-note">{{member!.plan.description}}</text>
</view>
</view>
</scroll-view>
<BottomBar>
<button class="bar-primary" :class="loading||error||!selectedPlan?'is-disabled':''" @click="activate">{{currentUser?'查看'+(selectedPlan?selectedPlan!.days+'天套餐':'套餐')+'开通说明':'登录查看会员'}}</button>
</BottomBar>
</view>
</template>
<script setup lang="ts">
import {formatChinaDate} from '../../lib/date-time';
import BottomBar from '../../components/BottomBar.uvue';import PageHead from '../../components/PageHead.uvue';import AppIcon from '../../components/AppIcon.uvue';import ContentState from '../../components/ContentState.uvue';import {request,money} from '../../lib/api';import type {Membership,MembershipPlan,MembershipBenefits} from '../../lib/learning';import {membershipContentLabel,membershipBenefitLabel,benefitUsageLabel} from '../../lib/learning';import {currentUser,needLogin} from '../../lib/session';import {openPage} from '../../lib/presentation';const tier=ref('入门会员'),plans=ref<MembershipPlan[]>([]),member=ref<Membership|null>(null),loading=ref(false),error=ref(''),selectedPlanId=ref(''),benefitSummary=ref<MembershipBenefits|null>(null);const usageLoading=ref(false);let usagePage=1,loadRevision=0;const selectedPlan=computed(()=>plans.value.find(p=>p.id===selectedPlanId.value)??null);function chooseTier(value:string){tier.value=value;selectedPlanId.value=plans.value.find(p=>p.tier===['入门会员','进阶会员','至尊会员'].indexOf(value)+1)?.id??'';}const visiblePlans=computed(()=>plans.value.filter(plan=>plan.tier===['入门会员','进阶会员','至尊会员'].indexOf(tier.value)+1));const rights=[{label:'经典研习',icon:'book-open'},{label:'会员内容',icon:'crown'}];async function load(){const revision=++loadRevision,owner=currentUser.value?.id??'';loading.value=true;error.value='';benefitSummary.value=null;member.value=null;usagePage=1;try{const planRows=await request<MembershipPlan[]>('/learning/plans'),memberRow=owner?await request<Membership|null>('/learning/membership'):null,benefitRows=owner?await request<MembershipBenefits>('/learning/benefits'):null;if(revision!==loadRevision||owner!==(currentUser.value?.id??''))return;plans.value=planRows;member.value=memberRow;benefitSummary.value=benefitRows;if(!plans.value.some(p=>p.id===selectedPlanId.value))chooseTier(tier.value);}catch(e){if(revision===loadRevision)error.value=(e as Error).message;}finally{if(revision===loadRevision)loading.value=false;}}async function loadMoreUsage(){if(!benefitSummary.value||usageLoading.value)return;usageLoading.value=true;const revision=loadRevision,owner=currentUser.value?.id??'';try{const result=await request<MembershipBenefits>('/learning/benefits?page='+(usagePage+1));if(revision!==loadRevision||owner!==(currentUser.value?.id??'')||!benefitSummary.value)return;benefitSummary.value.usage.items.push(...result.usage.items);benefitSummary.value.usage.total=result.usage.total;usagePage++;}catch(e){error.value=(e as Error).message;}finally{usageLoading.value=false;}}function activate(){if(!selectedPlan.value)return;const url='/pages/membership/purchase?planId='+selectedPlan.value.id;if(needLogin(url))return;openPage('membership/purchase?planId='+selectedPlan.value.id);}onShow(()=>load());onUnload(()=>{loadRevision++;});</script>
<style>@import '../../styles/app.css';.membership-card{background-color:#17292D;border-radius:8px;align-items:center;padding:28px 18px;}.membership-title{font-family:AcademySerif;color:#E6D6BD;font-size:28px;margin-top:12px;letter-spacing:3px;line-height:41px;}.membership-copy{font-family:AcademySans;color:#E6D6BD;font-size:12px;margin-top:8px;letter-spacing:2px;line-height:18px;}.membership-status{text-align:center;font-size:12px;color:#D8D4CA;margin-top:23px;line-height:16px;}.rights-grid{flex-direction:row;flex-wrap:wrap;margin-top:18px;}.rights-item{width:50%;align-items:center;padding:20px 0;}.rights-label{font-family:AcademySans;font-size:13px;color:#245564;margin-top:9px;line-height:19px;}.plan-row{padding:16px;margin-top:12px;border-width:1px;border-style:solid;border-color:#E2DCD1;border-radius:8px;background-color:#FAF8F2;}.plan-selected{border-color:#245564;background-color:#F5F2EA;}.plan-top{flex-direction:row;align-items:center;justify-content:space-between;}.plan-choice{font-size:12px;line-height:18px;color:#6B7578;margin:8px 0 0;}.plan-choice-active{color:#245564;font-weight:600;}.plan-copy{font-family:AcademySans;font-size:13px;line-height:22px;color:#5F6A6D;margin-top:10px;}</style>

