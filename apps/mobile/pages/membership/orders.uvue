<template>
  <view class="page"
    ><InkBackdrop /><PageHead title="会员订单" /><scroll-view
      class="page-scroll"
      direction="vertical"
      :show-scrollbar="false"
      ><view class="content">
        <text class="ui-text orders-intro">会员购买、生效日期和退款进度，都可以在这里查看。</text
        ><view class="detail-tabs"
          ><view
            v-for="filter in filters"
            :key="filter.value"
            :class="['detail-tab', state === filter.value ? 'detail-tab-active' : '']"
            @click="change(filter.value)"
            ><text
              class="ui-text"
              :class="['detail-tab-text', state === filter.value ? 'detail-tab-selected' : '']"
              >{{ filter.label }}</text
            ></view
          ></view
        >
        <ContentState
          v-if="loading || error"
          :loading="loading"
          :error="error"
          :error-title="error.indexOf('登录') >= 0 ? '请先登录' : '会员订单未能加载'"
          :retryable="error.indexOf('登录') < 0"
          @retry="retry"
        />
        <view
          v-for="item in items"
          :key="item.id"
          class="course-order"
          @click="openPage('membership/purchase?orderId=' + item.id)"
          ><view class="order-heading"
            ><text class="ui-text order-date">{{ formatChinaDate(item.createdAt) }}</text
            ><text class="ui-text order-state">{{ orderLabel(item) }}</text></view
          ><view class="order-course"
            ><view class="order-copy"
              ><text class="ui-text order-title">{{ item.plan.title }}</text
              ><text class="ui-text order-meta">{{
                item.membership
                  ? '生效 ' +
                    formatChinaDate(item.membership.startsAt) +
                    ' 至 ' +
                    formatChinaDate(item.membership.endsAt)
                  : '共 ' + item.plan.days + ' 天'
              }}</text
              ><text v-if="item.refunds.length" class="ui-text order-refund">{{
                refundLabel(item.refunds[0].state)
              }}</text></view
            ></view
          ><view class="order-footer"
            ><text class="ui-text order-link"
              >{{
                item.state === 'PENDING' && item.paymentStatus !== 'EXPIRED'
                  ? '查看与支付'
                  : '查看订单'
              }}
              ›</text
            ><text class="ui-text order-amount">¥{{ money(Number(item.amount)) }}</text></view
          ></view
        >
        <ContentState
          v-if="ready && !loading && !error && !items.length"
          title="还没有会员订单"
          description="在会员中心查看适合自己的权益范围与套餐期限。"
          action-label="查看会员套餐"
          @action="browse"
        /><button
          v-if="items.length < total && !loading && !error"
          class="ui-button secondary-button"
          @click="load(true)"
          >继续查看</button
        >
      </view></scroll-view
    ></view
  >
</template>
<script setup lang="ts">
import InkBackdrop from '../../components/InkBackdrop.uvue';
import { formatChinaDate } from '../../lib/date-time';
import PageHead from '../../components/PageHead.uvue';
import ContentState from '../../components/ContentState.uvue';
import { request, money } from '../../lib/api';
import { currentUser, needLogin } from '../../lib/session';
import { openPage } from '../../lib/presentation';
import { refundLabel } from '../../lib/course-sales';
import { membershipOrderLabel as orderLabel } from '../../lib/membership-sales';
import type { MembershipOrder } from '../../lib/membership-sales';
const filters = [
    { label: '全部', value: '' },
    { label: '待支付', value: 'PENDING' },
    { label: '已支付', value: 'COMPLETED' },
    { label: '已关闭', value: 'CLOSED' },
  ],
  state = ref(''),
  items = ref<MembershipOrder[]>([]),
  total = ref(0),
  loading = ref(false),
  error = ref(''),
  ready = ref(false);
let page = 1,
  owner = '',
  failedAppend = false;
async function load(append = false) {
  if (loading.value || needLogin()) return;
  loading.value = true;
  error.value = '';
  failedAppend = append;
  const next = append ? page + 1 : 1;
  try {
    const result = await request<{ items: MembershipOrder[]; total: number }>(
      '/commerce/membership-orders?page=' +
        next +
        (state.value ? '&state=' + encodeURIComponent(state.value) : ''),
    );
    items.value = append ? [...items.value, ...result.items] : result.items;
    total.value = result.total;
    page = next;
    failedAppend = false;
  } catch (e) {
    error.value = (e as Error).message;
  } finally {
    loading.value = false;
    ready.value = true;
  }
}
function retry() {
  void load(failedAppend);
}
function change(value: string) {
  if (loading.value || state.value === value) return;
  state.value = value;
  items.value = [];
  total.value = 0;
  void load();
}
function browse() {
  openPage('membership/index');
}
onShow(() => {
  if (owner !== (currentUser.value?.id ?? '')) {
    owner = currentUser.value?.id ?? '';
    items.value = [];
    total.value = 0;
  }
  void load();
});
</script>
<style>
@import '../../styles/app.css';
/* 会员订单列表：行上下 15 + 弱线；金额 19/27 右对齐，单位 12/20。 */
.orders-intro {
  font-family: sans-serif;
  font-size: 13px;
  line-height: 22px;
  color: #5c6869;
  padding-top: 16px;
  padding-bottom: 4px;
}
.detail-tabs {
  margin-top: 8px;
}
.detail-tab-text {
  font-family: sans-serif;
  font-size: 14px;
  line-height: 24px;
  color: #5c6869;
  letter-spacing: 0;
}
.detail-tab-selected {
  color: #182b31;
  font-weight: 600;
}
.course-order {
  padding: 15px 0;
  border-bottom-width: 1px;
  border-bottom-style: solid;
  border-bottom-color: #e0d8c8;
}
.order-heading {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8px;
}
.order-date {
  font-family: sans-serif;
  font-size: 12px;
  line-height: 20px;
  color: #5c6869;
}
.order-state {
  font-family: sans-serif;
  font-size: 12px;
  line-height: 20px;
  color: #235663;
  font-weight: 600;
}
.order-course {
  flex-direction: row;
}
.order-copy {
  flex: 1;
  min-width: 0;
  justify-content: center;
}
.order-title {
  font-family: AcademySerif;
  font-size: 16px;
  line-height: 24px;
  color: #182b31;
  font-weight: 600;
}
.order-meta {
  font-family: sans-serif;
  font-size: 12px;
  line-height: 20px;
  color: #5c6869;
  margin-top: 4px;
}
.order-refund {
  font-family: sans-serif;
  font-size: 12px;
  line-height: 20px;
  color: #b4533f;
  margin-top: 4px;
}
.order-footer {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-top: 12px;
}
.order-link {
  font-family: sans-serif;
  font-size: 13px;
  line-height: 22px;
  color: #235663;
  padding: 11px 0;
  min-height: 44px;
}
.order-amount {
  font-family: AcademySerif;
  font-size: 19px;
  line-height: 27px;
  color: #182b31;
  font-weight: 600;
  text-align: right;
}
</style>
