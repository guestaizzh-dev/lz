<template><view class="page"><PageHead title="会员订单"/><scroll-view class="page-scroll" direction="vertical" :show-scrollbar="false"><view class="content">
<text class="orders-intro">会员购买、生效日期和退款进度，都可以在这里查看。</text><view class="detail-tabs"><view v-for="filter in filters" :key="filter.value" :class="['detail-tab',state===filter.value?'detail-tab-active':'']" @click="change(filter.value)"><text :class="['detail-tab-text',state===filter.value?'detail-tab-selected':'']">{{filter.label}}</text></view></view>
<ContentState v-if="loading||error" :loading="loading" :error="error" @retry="retry"/>
<view v-for="item in items" :key="item.id" class="course-order" @click="openPage('membership/purchase?orderId='+item.id)"><view class="order-heading"><text class="order-date">{{formatChinaDate(item.createdAt)}}</text><text class="order-state">{{orderLabel(item)}}</text></view><view class="order-course"><view class="order-copy"><text class="order-title">{{item.plan.title}}</text><text class="order-meta">{{item.plan.title}} · 共 {{item.plan.days}} 天</text><text v-if="item.refunds.length" class="order-refund">{{refundLabel(item.refunds[0].state)}}</text></view></view><view class="order-footer"><text class="order-amount">¥{{money(Number(item.amount))}}</text><text class="order-link">{{item.state==='PENDING'?'查看与支付':'查看订单'}} ›</text></view></view>
<ContentState v-if="!loading&&!error&&!items.length" title="还没有会员订单" description="在会员中心查看适合自己的权益范围与套餐期限。"/><button v-if="!loading&&!error&&!items.length" class="secondary-button" @click="browse">查看会员套餐</button><button v-if="items.length<total&&!loading&&!error" class="secondary-button" @click="load(true)">继续查看</button>
</view></scroll-view></view></template>
<script setup lang="ts">
import {formatChinaDate} from '../../lib/date-time';
import PageHead from '../../components/PageHead.uvue';import ContentState from '../../components/ContentState.uvue';import {request,money} from '../../lib/api';import {currentUser,needLogin} from '../../lib/session';import {openPage} from '../../lib/presentation';import {refundLabel} from '../../lib/course-sales';import {membershipOrderLabel as orderLabel} from '../../lib/membership-sales';import type {MembershipOrder} from '../../lib/membership-sales';
const filters=[{label:'全部',value:''},{label:'待支付',value:'PENDING'},{label:'已支付',value:'COMPLETED'},{label:'已关闭',value:'CLOSED'}],state=ref(''),items=ref<MembershipOrder[]>([]),total=ref(0),loading=ref(false),error=ref('');let page=1,owner='',failedAppend=false;
async function load(append=false){if(loading.value||needLogin())return;loading.value=true;error.value='';failedAppend=append;const next=append?page+1:1;try{const result=await request<{items:MembershipOrder[];total:number}>('/commerce/membership-orders?page='+next+(state.value?'&state='+encodeURIComponent(state.value):''));items.value=append?[...items.value,...result.items]:result.items;total.value=result.total;page=next;failedAppend=false;}catch(e){error.value=(e as Error).message;}finally{loading.value=false;}}
function retry(){void load(failedAppend);}function change(value:string){if(loading.value||state.value===value)return;state.value=value;items.value=[];total.value=0;void load();}function browse(){openPage('membership/index');}onShow(()=>{if(owner!==(currentUser.value?.id??'')){owner=currentUser.value?.id??'';items.value=[];total.value=0;}void load();});
</script>
<style>@import '../../styles/app.css';.orders-intro{font-size:13px;line-height:24px;color:#6A7578;padding-top:10px;padding-bottom:8px;}.course-order{padding:18px 0;border-bottom-width:1px;border-bottom-style:solid;border-bottom-color:#E3DCCF;}.order-heading{flex-direction:row;justify-content:space-between;margin-bottom:14px;}.order-date{font-size:11px;line-height:20px;color:#7C878A;}.order-state{font-size:12px;line-height:20px;color:#235663;}.order-course{flex-direction:row;}.order-copy{flex:1;min-width:0;padding-left:0;justify-content:center;}.order-title{font-family:AcademySerif;font-size:17px;line-height:26px;color:#182B31;}.order-meta{font-size:12px;line-height:22px;color:#6A7578;margin-top:5px;}.order-refund{font-size:11px;line-height:20px;color:#B4533F;margin-top:4px;}.order-footer{flex-direction:row;justify-content:space-between;align-items:center;margin-top:14px;}.order-amount{font-size:18px;line-height:27px;color:#182B31;}.order-link{font-size:13px;line-height:24px;color:#235663;}</style>
