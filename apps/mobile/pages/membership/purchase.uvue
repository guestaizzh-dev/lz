<template><view class="page"><PageHead :title="order?'会员订单':'确认会员套餐'"/><scroll-view class="page-scroll" direction="vertical" :show-scrollbar="false"><view class="content">
<ContentState v-if="loading||error" :loading="loading" :error="error" @retry="load"/><view v-if="quote?.charity" class="detail-section"><text class="body-copy">已匹配公益计划：{{quote!.charity!.title}}，按本次确认金额及固定版本生效。</text><button v-if="Number(quote!.price)===0" class="secondary-button" @click="openPage('marketing/charity?tab=mine')">确认免费公益领取</button></view>
<view v-if="purchase&&!loading&&!error">
<view class="member-heading"><text class="meta">老子道学书院 · 日常研习</text><text class="member-title">{{purchase!.title}}</text><text class="member-duration">{{purchase!.days}}天 · 手动续费</text></view>
<view v-if="order" class="member-notice"><text class="item-title">{{membershipOrderLabel(order!)}}</text><text class="body-copy">{{order!.membership?membershipPeriodLabel(order!.membership!.state):order!.state==='CLOSED'?'本次订单未开通会员':order!.paymentStatus==='EXPIRED'?'付款期限已结束，本次订单不会扣款；如需开通请重新选择套餐。':'付款后请查询结果，勿重复付款。'}}</text><text v-if="order!.closeReason&&order!.closeReason!=='USER_CANCEL'" class="footer-note">{{order!.refunds.length?'本次收款正在原路处理，详情见下方。':'订单已结束，如需帮助请联系书院。'}}</text></view>
<view class="member-section"><text class="section-heading">生效与期限</text><text class="body-copy">{{periodCopy}}</text><text class="footer-note">{{purchase!.schedule.mode==='QUEUED'?'跨层级会员将在现有及已确认排队套餐结束后生效。':purchase!.schedule.mode==='RENEW'?'续费接在已确认套餐之后，不覆盖原会员记录。':'支付确认后开通，不自动扣费续期。'}}</text></view>
<view class="member-section"><text class="section-heading">本次购买权益</text><text class="body-copy">{{membershipContentLabel(purchase!.contentTier)}}</text><text class="body-copy" :user-select="true">{{purchase!.description}}</text><text class="footer-note">按本次套餐版本交付；以后改价、改版不会改写此订单。</text></view>
<view class="member-section"><view class="row between"><text class="section-heading">{{order?.paidAt?'实付金额':'应付金额'}}</text><text class="member-price">¥{{price}}</text></view><text class="footer-note">{{order?paymentChannelLabel(order!.channel):platform==='IOS'?'App Store 内购待开放':'Android App 内支付'}}</text><view v-if="!order" class="member-channels"><button v-for="choice in choices" :key="choice.channel" :class="['channel-button',selectedChannel===choice.channel?'channel-selected':'']" :disabled="busy" @click="selectedChannel=choice.channel">{{choice.label}}</button></view></view>
<view class="member-section"><text class="section-heading">退款与续费说明</text><text class="body-copy" :user-select="true">{{purchase!.refundPolicy}}</text><text v-if="order?.membership?.state==='REFUND_PENDING'" class="footer-note">这段会员正在办理退款，当前暂停使用。原授权记录、生效日期及其他购买保持不变；退款失败时书院将继续核查与重试。</text><button class="text-action" @click="copyRules">复制完整购买说明 ›</button></view>
<ConsumptionReward :order-id="order?.id" :revision="order" :eligible="Number(order?.amount??quote?.price??0)>0"/><view v-if="!order" class="member-consent" @click="agreed=!agreed"><view :class="['consent-box',agreed?'consent-selected':'']"><text v-if="agreed" class="consent-check">✓</text></view><text class="member-consent-text">我已确认生效时间、权益范围与退款规则</text></view>
<view v-if="notice||(!order&&!paymentReady)" class="member-notice"><text class="body-copy">{{notice||quote?.unavailableReason||'当前App尚未开放会员付款，暂不收取费用。'}}</text><button v-if="!order" class="text-action" :disabled="busy" @click="load">刷新购买信息 ›</button></view>
<view v-if="order" class="member-section"><text class="section-heading">订单信息</text><text class="body-copy" @click="copyNumber">{{order!.orderNo}} · 复制</text><text class="footer-note">创建于 {{formatChinaTime(order!.createdAt)}}</text><text v-if="order!.paidAt" class="footer-note">支付于 {{formatChinaTime(order!.paidAt!)}}</text><button class="text-action" :disabled="busy" @click="refreshOrder">查询支付与退款结果 ›</button><button v-if="order!.canRefund||order!.canRequestReview" class="text-action" :disabled="busy" @click="showRefund=true">{{order!.canRefund?'申请退未来整段会员':'申请退订与退款核查'}} ›</button><text v-else-if="order!.state==='COMPLETED'" class="footer-note">{{order!.refundUnavailableReason}}</text><button v-if="order!.refundUrl" class="text-action" @click="copyAppleRefund">复制Apple退款入口 ›</button></view>
<view v-for="refund in order?.refunds??[]" :key="refund.id" class="member-section"><view class="row between"><text class="item-title">{{refund.state==='APPROVED'?'请确认退款方案':refundLabel(refund.state)}}</text><text class="meta">¥{{money(Number(refund.approvedAmount??refund.requestedAmount))}}</text></view><text class="body-copy" :user-select="true">{{refund.description}}</text><text v-if="refund.reviewNote" class="footer-note">处理意见：{{refund.reviewNote}}</text><view v-if="refund.assessmentSnapshot" class="member-notice"><text class="body-copy">退款方案须经你确认，确认后退订此次购买的剩余会员；其他购买保持不变。</text><text v-if="refund.approvedAmount" class="body-copy">拟原路退回 ¥{{money(Number(refund.approvedAmount))}} · 扣除 ¥{{money(Number(refund.assessmentSnapshot!.deductionAmount??'0'))}}</text><text class="footer-note">核查于 {{formatChinaTime(refund.assessmentSnapshot!.assessedAt)}} · 原期限 {{formatChinaTime(refund.assessmentSnapshot!.startsAt)}} 至 {{formatChinaTime(refund.assessmentSnapshot!.endsAt)}}</text><text v-for="(use,index) in refund.assessmentSnapshot!.usage" :key="index" class="footer-note">{{use.name}} · {{use.quantity}}次 · {{use.state==='HELD'?'占用中':'已使用'}}</text><view v-if="refund.state==='APPROVED'" class="member-links"><button class="text-action" :disabled="busy" @click="decideRefund(refund.id,refund.version,'DECLINE')">不同意，保留会员</button><button class="text-action" :disabled="busy" @click="decideRefund(refund.id,refund.version,'ACCEPT')">确认金额并退订</button></view><text v-if="refund.acceptedAt" class="footer-note">已于 {{formatChinaTime(refund.acceptedAt)}} 确认退款方案</text></view><text class="footer-note">{{formatChinaTime(refund.createdAt)}}</text></view>
<view class="member-links"><button class="text-action" @click="openPage('membership/orders')">全部会员订单 ›</button><button class="text-action" @click="openPage('profile/feedback')">联系书院 ›</button></view>
</view></view></scroll-view>
<BottomBar v-if="purchase&&!loading&&!error"><button v-if="order?.canCancel" class="bar-secondary" :disabled="busy" @click="cancelOrder">{{order?.channel==='APPLE_IAP'?'关闭过期确认':'取消订单'}}</button><button class="bar-primary" :disabled="busy||(!order&&!quote?.pendingOrderId&&(!paymentReady||!agreed))" @click="primary">{{busy?'正在处理…':primaryLabel}}</button></BottomBar>
<ComposeSheet :visible="showRefund" title="申请会员退款" subtitle="说明退订原因；已生效或已使用权益需核查金额，并由你确认退款方案" v-model="refundReason" :maxlength="1000" :saving="busy" :disabled="refundReason.trim().length<2" :error="refundError" submitLabel="提交申请" @close="showRefund=false" @submit="submitRefund"/>
</view></template>
<script setup lang="ts">
import ConsumptionReward from '../../components/ConsumptionReward.uvue';
import PageHead from '../../components/PageHead.uvue';import BottomBar from '../../components/BottomBar.uvue';import ContentState from '../../components/ContentState.uvue';import ComposeSheet from '../../components/ComposeSheet.uvue';
import {request,money} from '../../lib/api';import {formatChinaTime} from '../../lib/date-time';import {currentUser,needLogin} from '../../lib/session';import {openPage} from '../../lib/presentation';import {studyEventId,membershipContentLabel} from '../../lib/learning';import {purchasePlatform,paymentChannelLabel,refundLabel} from '../../lib/course-sales';import {courseWechatAppId,courseAlipayAppId} from '../../lib/payment-config';import {membershipOrderLabel,membershipPeriodLabel} from '../../lib/membership-sales';import type {MembershipOrder,MembershipQuote} from '../../lib/membership-sales';
const platform=purchasePlatform(),quote=ref<MembershipQuote|null>(null),order=ref<MembershipOrder|null>(null),loading=ref(false),error=ref(''),notice=ref(''),busy=ref(false),agreed=ref(false),selectedChannel=ref('WECHAT_APP'),showRefund=ref(false),refundReason=ref(''),refundError=ref('');let planId='',orderId='',owner='',revision=0,requestKey=studyEventId(),refundKey=studyEventId();
const purchase=computed(()=>order.value?.plan??quote.value),price=computed(()=>money(Number(order.value?.amount??quote.value?.price??0))),choices=computed(()=>quote.value?.channels.filter(c=>c.enabled&&clientSupports(c.channel))??[]),paymentReady=computed(()=>!!quote.value?.paymentEnabled&&choices.value.some(c=>c.channel===selectedChannel.value));
const periodCopy=computed(()=>order.value?.membership?formatChinaTime(order.value.membership.startsAt)+' 至 '+formatChinaTime(order.value.membership.endsAt):quote.value?.startsAt?formatChinaTime(quote.value.startsAt)+' 至 '+formatChinaTime(quote.value.endsAt!):purchase.value?.schedule.anchor?formatChinaTime(purchase.value.schedule.anchor)+' 起，连续 '+purchase.value.days+'天':'支付确认后立即生效，连续 '+(purchase.value?.days??0)+'天。实际日期会保存在订单中。');
const primaryLabel=computed(()=>order.value?order.value.state!=='PENDING'?'查看我的会员':order.value.canPay&&clientSupports(order.value.channel)?'继续支付':'查询订单结果':quote.value?.pendingOrderId?'查看待支付订单':paymentReady.value?'确认购买':'会员付款暂未开放');
function clientSupports(channel:string){return platform==='ANDROID'&&(channel==='WECHAT_APP'?!!courseWechatAppId:channel==='ALIPAY_APP'?!!courseAlipayAppId:false);}
function returnUrl(){return '/pages/membership/purchase?'+(orderId?'orderId='+orderId:'planId='+planId);}
async function load(){if(loading.value||busy.value)return;const identity=currentUser.value?.id??'';if(owner!==identity){owner=identity;order.value=null;quote.value=null;notice.value='';agreed.value=false;showRefund.value=false;refundReason.value='';requestKey=studyEventId();refundKey=studyEventId();}const current=++revision;loading.value=true;error.value='';try{if(orderId){if(needLogin(returnUrl()))return;const result=await request<MembershipOrder>('/commerce/membership-orders/'+orderId);if(current===revision)order.value=result;}else{const result=await request<MembershipQuote>('/commerce/memberships/'+planId+'/quote?platform='+platform);if(current!==revision)return;if(result.quoteHash!==quote.value?.quoteHash){agreed.value=false;requestKey=studyEventId();}quote.value=result;if(!choices.value.some(c=>c.channel===selectedChannel.value))selectedChannel.value=choices.value[0]?.channel??'WECHAT_APP';}}catch(e){if(current===revision)error.value=(e as Error).message;}finally{if(current===revision)loading.value=false;}}
async function refreshOrder(){if(!order.value||busy.value)return;busy.value=true;notice.value='';try{order.value=await request<MembershipOrder>('/commerce/membership-orders/'+order.value.id+'/refresh',{method:'POST'});}catch(e){notice.value=(e as Error).message;}finally{busy.value=false;}}
async function primary(){if(busy.value)return;if(order.value?.state!=='PENDING'&&order.value){openPage('membership/index');return;}if(!order.value&&quote.value?.pendingOrderId){orderId=quote.value.pendingOrderId;await load();return;}if(order.value&&(!order.value.canPay||!clientSupports(order.value.channel))){await refreshOrder();return;}if(needLogin(returnUrl()))return;busy.value=true;notice.value='';try{if(!order.value){if(!quote.value||!paymentReady.value||!agreed.value)return;order.value=await request<MembershipOrder>('/commerce/membership-orders',{method:'POST',data:{planId,platform,channel:selectedChannel.value,quoteHash:quote.value.quoteHash,requestKey}});orderId=order.value.id;}if(!order.value.canPay||!clientSupports(order.value.channel)){notice.value='请先查询订单结果后再继续。';return;}const payment=await request<{provider:'wxpay'|'alipay';orderInfo:string}>('/commerce/membership-orders/'+order.value.id+'/payment',{method:'POST'});if(payment.provider==='wxpay'){const sdk=JSON.parse(payment.orderInfo) as {appid:string};if(order.value.channel!=='WECHAT_APP'||sdk.appid!==courseWechatAppId)throw new Error('支付应用配置不匹配，请联系书院核查。');}else if(payment.provider==='alipay'){if(order.value.channel!=='ALIPAY_APP'||payment.orderInfo.match(/(?:^|&)app_id=(\d+)(?:&|$)/)?.[1]!==courseAlipayAppId)throw new Error('支付宝应用配置不匹配，请联系书院核查。');}else throw new Error('此支付方式暂不支持，请查询订单。');
// #ifdef APP-ANDROID
await new Promise<void>(resolve=>{uni.requestPayment({provider:payment.provider,orderInfo:payment.orderInfo,success:()=>resolve(),fail:()=>{notice.value='支付结果待确认，请先查询，勿重复付款。';resolve();}});});
// #endif
order.value=await request<MembershipOrder>('/commerce/membership-orders/'+order.value.id+'/refresh',{method:'POST'});
}catch(e){notice.value=(e as Error).message;if(order.value)try{order.value=await request<MembershipOrder>('/commerce/membership-orders/'+order.value.id);}catch{order.value={...order.value,canPay:false,paymentStatus:'CHECK_REQUIRED'};}else try{const next=await request<MembershipQuote>('/commerce/memberships/'+planId+'/quote?platform='+platform);if(quote.value?.quoteHash!==next.quoteHash){agreed.value=false;requestKey=studyEventId();}quote.value=next;}catch{/* Retain the original request key until the order can be checked. */}}finally{busy.value=false;}}
function cancelOrder(){if(!order.value||busy.value)return;uni.showModal({title:'取消会员订单',content:'先确认是否已付款，已付款订单将保留并转入售后。',confirmText:'确认取消',success:async result=>{if(!result.confirm||!order.value||busy.value)return;busy.value=true;try{order.value=await request<MembershipOrder>('/commerce/membership-orders/'+order.value.id+'/cancel',{method:'POST'});}catch(e){notice.value=(e as Error).message;order.value={...order.value,canPay:false};}finally{busy.value=false;}}});}
async function submitRefund(){if(!order.value||busy.value)return;busy.value=true;refundError.value='';try{order.value=await request<MembershipOrder>('/commerce/membership-orders/'+order.value.id+'/refund',{method:'POST',data:{requestKey:refundKey,reason:refundReason.value}});showRefund.value=false;refundKey=studyEventId();refundReason.value='';notice.value='退款申请已提交，可在此查看处理进度。';}catch(e){refundError.value=(e as Error).message;}finally{busy.value=false;}}
function decideRefund(id:string,version:number,action:string){if(busy.value||!order.value)return;const proposal=order.value.refunds.find(r=>r.id===id);if(!proposal)return;uni.showModal({title:action==='ACCEPT'?'确认退款并退订？':'保留原会员？',content:action==='ACCEPT'?'本次原路退回 ¥'+money(Number(proposal.approvedAmount))+'。确认后暂停本段权益，退款成功后结束此次购买的剩余会员；其他购买不变。':'拒绝本次方案，按原生效时间和到期日期恢复会员，不产生退款。',confirmText:action==='ACCEPT'?'确认退订':'保留会员',success:async result=>{if(!result.confirm||busy.value)return;busy.value=true;notice.value='';try{order.value=await request<MembershipOrder>('/commerce/membership-orders/'+orderId+'/refunds/'+id+'/decision',{method:'POST',data:{expectedVersion:version,action}});notice.value=action==='ACCEPT'?'方案已确认，正在办理原路退款。':'已保留原会员及原有效期限。';}catch(e){notice.value=(e as Error).message;}finally{busy.value=false;}}});}
function copyAppleRefund(){if(order.value?.refundUrl)uni.setClipboardData({data:order.value.refundUrl});}
function copyNumber(){if(order.value)uni.setClipboardData({data:order.value.orderNo});}function copyRules(){if(purchase.value)uni.setClipboardData({data:purchase.value.title+'\n金额：¥'+price.value+'\n期限：'+periodCopy.value+'\n权益：'+purchase.value.description+'\n退款与续费：'+purchase.value.refundPolicy});}
onLoad(options=>{planId=options?.planId??'';orderId=options?.orderId??'';});onShow(()=>void load());onUnload(()=>{revision++;});onBackPress(()=>{if(busy.value){uni.showToast({title:'正在确认订单，请稍候',icon:'none'});return true;}if(showRefund.value){showRefund.value=false;return true;}return false;});
</script>
<style>@import '../../styles/app.css';.member-heading{padding:12px 0 20px;}.member-title{font-family:AcademySerif;font-size:27px;line-height:38px;color:#182B31;margin-top:10px;font-weight:600;}.member-duration{font-size:13px;line-height:23px;color:#6A7578;margin-top:8px;}.member-section{padding:16px;background-color:#FCF9F2;border-style:solid;border-width:1px;border-color:#E3DCCF;border-radius:12px;margin-top:12px;}.member-price{font-family:AcademySerif;font-size:28px;line-height:36px;color:#235663;font-weight:600;}.member-notice{padding:14px 16px;background-color:#EFE9DC;border-left-width:2px;border-left-style:solid;border-left-color:#A67C46;border-radius:0 10px 10px 0;margin:12px 0;}.member-consent{flex-direction:row;align-items:center;min-height:52px;padding:10px 0;}.consent-box{width:20px;height:20px;border-width:1px;border-style:solid;border-color:#A3AEAB;border-radius:4px;align-items:center;justify-content:center;}.consent-selected{background-color:#235663;border-color:#235663;}.consent-check{color:#FCF9F2;font-size:15px;}.member-consent-text{flex:1;font-size:13px;line-height:23px;color:#6A7578;padding-left:10px;}.member-links,.member-channels{flex-direction:row;justify-content:space-between;}.text-action{align-self:flex-start;margin:0;padding:10px 0;min-height:44px;font-size:13px;line-height:24px;color:#235663;background-color:transparent;border-width:0;}.channel-button{padding:10px 18px;margin:10px 10px 0 0;font-size:13px;line-height:24px;background-color:#FCF9F2;border-width:1px;border-style:solid;border-color:#D3C9B8;border-radius:22px;color:#6A7578;}.channel-selected{background-color:#E6EDE9;color:#235663;border-color:#235663;font-weight:600;}</style>
