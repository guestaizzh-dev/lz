<template>
  <view class="page"
    ><InkBackdrop /><PageHead title="确认订单" /><scroll-view
      class="page-scroll"
      direction="vertical"
      :show-scrollbar="false"
      ><view class="content">
        <ContentState v-if="loading" :loading="true" />
        <view v-else class="checkout-body">
          <view class="card" @click="chooseAddress"
            ><view class="row between"
              ><text class="ui-text card-eyebrow">收货地址</text
              ><text class="ui-text card-action">{{ address ? '更换 ›' : '添加 ›' }}</text></view
            ><template v-if="address"
              ><text class="ui-text address-recipient"
                >{{ address!.recipient }}　{{ address!.phone }}</text
              ><text class="ui-text address-detail" :user-select="true">{{
                addressText(address!)
              }}</text></template
            ><text v-else class="ui-text address-empty"
              >还没有收货地址。添加后即可核算配送费用与可售商品。</text
            ></view
          >
          <view v-if="error" class="checkout-error"
            ><text class="ui-text error-title">{{
              errorTone(error) === 'net'
                ? '网络连接中断'
                : errorTone(error) === 'gone'
                  ? '订单信息已失效'
                  : '订单需要重新确认'
            }}</text
            ><text class="ui-text error-copy">{{ error }}</text
            ><view class="error-actions"
              ><button class="ui-button error-primary" @click="load">重新核算订单</button
              ><button class="ui-button error-outline" @click="openPage('shop/orders')"
                >查看商品订单</button
              ></view
            ><button
              v-if="shippingMode === 'PRIORITY'"
              class="ui-button error-link"
              @click="chooseShipping('STANDARD')"
              >改用普通配送重新核算</button
            ><text class="ui-text error-note"
              >已提交过的订单请先到商品订单查看结果，避免重复下单。</text
            ></view
          >
          <view v-if="quote" class="card checkout-section"
            ><text class="ui-text section-heading">商品</text
            ><view v-for="line in quote!.items" :key="line.skuId" class="goods-row"
              ><ArtImage
                :src="line.cover"
                :kind="artwork(line.cover)"
                :width="72"
                :height="78"
              /><view class="grow goods-copy"
                ><text class="ui-text item-title">{{ line.title }}</text
                ><text class="ui-text meta">{{ line.skuTitle }}　× {{ line.quantity }}</text
                ><text class="ui-text goods-price">¥{{ money(line.subtotal) }}</text></view
              ></view
            ></view
          >
          <view class="card checkout-section"
            ><text class="ui-text section-heading">费用</text
            ><template v-if="quote"
              ><view class="sum-row"
                ><text class="ui-text sum-label">商品金额</text
                ><text class="ui-text sum-value">¥{{ money(quote!.subtotal) }}</text></view
              ><view class="sum-row"
                ><text class="ui-text sum-label">配送费</text
                ><text class="ui-text sum-value">{{
                  quote!.shipping === 0 ? '免配送费' : '¥' + money(quote!.shipping)
                }}</text></view
              ><view v-if="quote!.discount > 0" class="sum-row"
                ><text class="ui-text sum-label">商品优惠（已择优）</text
                ><text class="ui-text sum-value">−¥{{ money(quote!.discount) }}</text></view
              ></template
            ><template v-else
              ><view class="sum-row"
                ><text class="ui-text sum-label">商品金额</text
                ><text class="ui-text sum-value">核算后显示</text></view
              ><view class="sum-row"
                ><text class="ui-text sum-label">配送费</text
                ><text class="ui-text sum-value">核算后显示</text></view
              ></template
            ><view class="sum-row sum-row-last"
              ><text class="ui-text sum-label-total">合计</text
              ><text class="ui-text sum-value-total">{{
                quote ? '¥' + money(quote!.total) : '—'
              }}</text></view
            ><text v-if="quote && quote!.shippingDiscount > 0" class="ui-text fee-note"
              >会员已减免基础配送费 ¥{{
                money(quote!.shippingDiscount)
              }}，特殊地区附加配送费另计。</text
            ><text v-if="quote && quote!.shippingSurcharge > 0" class="ui-text fee-note"
              >配送费含本地区附加费用 ¥{{ money(quote!.shippingSurcharge) }}。</text
            ><text v-if="!quote && address" class="ui-text fee-note"
              >正在按当前地址核算金额与库存。</text
            ><text v-if="!quote && !address" class="ui-text fee-note"
              >填写收货地址后，这里显示商品金额、配送费与合计。</text
            ></view
          >
          <view v-if="quote && quote!.priorityAvailable" class="card checkout-section"
            ><text class="ui-text section-heading">配送方式</text
            ><button
              class="ui-button secondary-button mode-button"
              :class="busy ? 'is-disabled' : ''"
              @click="chooseShipping('STANDARD')"
              >{{ shippingMode === 'STANDARD' ? '✓ 普通配送' : '普通配送' }}</button
            ><button
              class="ui-button secondary-button mode-button"
              :class="busy ? 'is-disabled' : ''"
              @click="chooseShipping('PRIORITY')"
              >{{ shippingMode === 'PRIORITY' ? '✓ ' : '' }}优先配送 · 另加 ¥{{
                money(quote!.priorityOptionFee ?? 0)
              }}</button
            ><text class="ui-text section-note">{{ quote!.priorityDescription }}</text></view
          >
          <view v-if="quote && quote!.paymentEnabled" class="card checkout-section"
            ><text class="ui-text section-heading">支付方式</text
            ><view
              v-for="choice in quote!.channels.filter((c) => c.enabled)"
              :key="choice.channel"
              class="channel-row"
              @click="channel = choice.channel"
              ><text class="ui-text channel-label">{{ choice.label }}</text
              ><text
                :class="[
                  'ui-text',
                  'channel-state',
                  channel === choice.channel ? 'channel-state-on' : '',
                ]"
                >{{ channel === choice.channel ? '已选择' : '选择' }}</text
              ></view
            ></view
          >
          <ConsumptionReward :eligible="Number(quote?.total ?? 0) > 0" />
          <view class="card checkout-section"
            ><text class="ui-text section-heading">配送与售后</text
            ><text class="ui-text term-copy" :user-select="true">{{
              quote
                ? quote!.refundPolicy
                : '配送时长、售后与退款规则以提交订单时的核算结果为准，下单前会再次展示。'
            }}</text
            ><view class="consent-row" @click="agreed = !agreed"
              ><view :class="['consent-box', agreed ? 'consent-box-on' : '']"
                ><text v-if="agreed" class="ui-text consent-check">✓</text></view
              ><text class="ui-text consent-text grow"
                >我已确认商品规格、数量、收货信息和售后规则</text
              ></view
            ></view
          >
          <text v-if="quote && !quote!.paymentEnabled" class="ui-text fee-note">{{
            quote!.unavailableReason
          }}</text>
        </view>
      </view></scroll-view
    ><BottomBar
      ><text class="ui-text checkout-total">{{
        quote ? '合计 ¥' + money(quote!.total) : '待核算'
      }}</text
      ><button
        class="ui-button bar-primary"
        :class="
          busy || loading || (quote && (!agreed || !quote!.paymentEnabled)) ? 'is-disabled' : ''
        "
        @click="!address ? chooseAddress() : !quote ? load() : !agreed ? (agreed = true) : submit()"
        >{{
          busy
            ? '正在确认…'
            : !address
              ? '添加收货地址后继续'
              : !quote
                ? error
                  ? '重新核算配送与费用'
                  : '正在核算配送与费用…'
                : !agreed
                  ? '勾选售后规则后确认下单'
                  : quote!.paymentEnabled
                    ? '确认下单'
                    : '收款尚未开放'
        }}</button
      ></BottomBar
    ></view
  >
</template>
<script setup lang="ts">
import InkBackdrop from '../../components/InkBackdrop.uvue';
import ConsumptionReward from '../../components/ConsumptionReward.uvue';
import PageHead from '../../components/PageHead.uvue';
import ArtImage from '../../components/ArtImage.uvue';
import BottomBar from '../../components/BottomBar.uvue';
import ContentState from '../../components/ContentState.uvue';
import { request, money } from '../../lib/api';
import { currentUser, needLogin } from '../../lib/session';
import { artwork, openPage } from '../../lib/presentation';
import { studyEventId } from '../../lib/learning';
import { purchasePlatform } from '../../lib/course-sales';
import { addressText } from '../../lib/shopping';
import type { Address } from '../../lib/shopping';
import type { ProductQuote, ProductOrder } from '../../lib/product-sales';
const addresses = ref<Address[]>([]),
  address = ref<Address | null>(null),
  quote = ref<ProductQuote | null>(null),
  loading = ref(false),
  busy = ref(false),
  error = ref(''),
  agreed = ref(false),
  channel = ref('WECHAT_APP'),
  shippingMode = ref('STANDARD');
let pending: Record<string, unknown> | null = null;
// 只做展示分档，不参与请求、金额与权限判断。
const errorTone = (text: string) =>
  /网络|中断|超时|繁忙|连接/.test(text)
    ? 'net'
    : /不存在|无法打开|已删除|已失效|无效/.test(text)
      ? 'gone'
      : 'bad';
let items: { skuId: string; quantity: number }[] = [],
  key = studyEventId(),
  generation = 0,
  owner = '';
async function load() {
  if (busy.value || needLogin()) return;
  const turn = ++generation,
    newOwner = currentUser.value?.id ?? '';
  if (owner !== newOwner) {
    shippingMode.value = 'STANDARD';
    address.value = null;
    quote.value = null;
    key = studyEventId();
    owner = newOwner;
    pending = null;
  }
  loading.value = true;
  error.value = '';
  try {
    const list = await request<Address[]>('/shopping/addresses');
    if (turn !== generation) return;
    addresses.value = list;
    address.value =
      list.find((a) => a.id === address.value?.id) ??
      list.find((a) => a.isDefault) ??
      list[0] ??
      null;
    if (!address.value) {
      quote.value = null;
      return;
    }
    if (!items.length) throw new Error('未选择商品，请返回商品或购物车重新选择');
    const payload: Record<string, unknown> = {
      addressId: address.value.id,
      platform: purchasePlatform(),
      items,
    };
    if (shippingMode.value === 'PRIORITY') payload.shippingMode = 'PRIORITY';
    const next = await request<ProductQuote>('/commerce/products/quote', {
      method: 'POST',
      data: payload,
    });
    if (turn !== generation) return;
    if (quote.value?.quoteHash !== next.quoteHash) {
      agreed.value = false;
      if (!pending) key = studyEventId();
    }
    quote.value = next;
    if (!next.channels.some((c) => c.channel === channel.value && c.enabled))
      channel.value = next.channels.find((c) => c.enabled)?.channel ?? 'WECHAT_APP';
  } catch (e) {
    if (turn === generation) {
      quote.value = null;
      error.value = (e as Error).message;
    }
  } finally {
    if (turn === generation) loading.value = false;
  }
}
async function chooseShipping(value: string) {
  if (busy.value || pending) return;
  shippingMode.value = value;
  await load();
}
function chooseAddress() {
  if (busy.value) return;
  if (pending) {
    uni.showToast({ title: '请先核查前次提交的订单', icon: 'none' });
    return;
  }
  if (!addresses.value.length) {
    openPage('shop/addresses');
    return;
  }
  uni.showActionSheet({
    itemList: [
      ...addresses.value.map(
        (a) => a.recipient + ' ' + a.phone.slice(-4) + ' · ' + a.province + a.city,
      ),
      '添加或管理地址',
    ],
    success: (result) => {
      if (result.tapIndex === addresses.value.length) {
        openPage('shop/addresses');
        return;
      }
      address.value = addresses.value[result.tapIndex] ?? null;
      void load();
    },
  });
}
async function submit() {
  if (
    busy.value ||
    !quote.value ||
    !address.value ||
    !agreed.value ||
    !quote.value.paymentEnabled ||
    needLogin()
  )
    return;
  busy.value = true;
  error.value = '';
  pending = pending ?? {
    ...(shippingMode.value === 'PRIORITY' ? { shippingMode: 'PRIORITY' } : {}),
    addressId: address.value.id,
    platform: purchasePlatform(),
    items,
    quoteHash: quote.value.quoteHash,
    requestKey: key,
    channel: channel.value,
  };
  try {
    const row = await request<ProductOrder>('/commerce/product-orders', {
      method: 'POST',
      data: pending,
    });
    pending = null;
    uni.redirectTo({ url: '/pages/shop/order-detail?id=' + encodeURIComponent(row.id) });
  } catch (e) {
    try {
      const existing = await request<ProductOrder>('/commerce/product-orders/request/' + key);
      pending = null;
      uni.redirectTo({ url: '/pages/shop/order-detail?id=' + existing.id });
    } catch {
      const status = (e as Error & { status: number }).status;
      if (status >= 400 && status < 500) {
        pending = null;
        error.value = (e as Error).message;
      } else
        error.value = (e as Error).message + '；请先查看商品订单或重试同一次提交，勿重复下单。';
      agreed.value = false;
    }
  } finally {
    busy.value = false;
  }
}

onLoad((o) => {
  if (o?.type !== 'product' && !o?.items) {
    uni.redirectTo({ url: '/pages/course/purchase?courseId=' + encodeURIComponent(o?.id ?? '') });
    return;
  }
  try {
    items = o?.items
      ? ((JSON.parse(decodeURIComponent(o.items ?? '') ?? '[]') ?? []) as {
          skuId: string;
          quantity: number;
        }[])
      : [
          {
            skuId: o?.skuId ?? '',
            quantity: Math.max(1, Math.min(99, parseInt(o?.quantity ?? '1') || 1)),
          },
        ];
  } catch {
    items = [];
  }
});
onShow(() => void load());
onUnload(() => {
  generation++;
});
</script>
<style>
