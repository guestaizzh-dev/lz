<template>
  <view class="page"
    ><InkBackdrop /><PageHead title="确认付款" /><scroll-view
      class="page-scroll"
      direction="vertical"
      :show-scrollbar="false"
      ><view class="content pay-content">
        <ContentState v-if="loading && !order" :loading="true" />
        <view v-else-if="order" class="pay-card">
          <view class="pay-summary">
            <text class="ui-text pay-heading">{{
              paid ? '付款已确认' : closed ? '订单已关闭' : expired ? '付款已超时' : '应付金额'
            }}</text>
            <view class="pay-money"
              ><text class="ui-text pay-currency">¥</text
              ><text class="ui-text pay-amount">{{
                money(Number(order?.amount ?? order?.payableTotal ?? 0))
              }}</text></view
            >
            <text class="ui-text pay-subject">{{ subject }}</text>
          </view>
          <view class="pay-sheet">
            <view class="pay-method-row"
              ><view class="pay-method-name"
                ><view class="pay-method-mark"></view
                ><text class="ui-text pay-method">微信支付</text></view
              ><text v-if="!paid && !closed && !expired && payment" class="ui-text pay-time"
                >剩余 {{ countdown }}</text
              ><text v-else-if="paid" class="ui-text pay-complete">已到账</text></view
            >
            <view v-if="paid" class="pay-result"
              ><view class="pay-success-circle"
                ><AppIcon name="check" :size="28" :active="true" /></view
              ><text class="ui-text pay-result-title">支付成功</text
              ><text class="ui-text pay-copy">可返回订单，查看交付进度与权益</text></view
            >
            <view v-else-if="closed || expired" class="pay-result"
              ><text class="ui-text pay-result-title">{{
                closed ? '本单已关闭' : '付款码已失效'
              }}</text
              ><text class="ui-text pay-copy">如已扣款，请查询最终结果，勿重复付款。</text></view
            >
            <view v-else-if="payment" class="pay-code"
              ><image
                v-if="!imageError"
                class="pay-image"
                :src="payment!.qrImageUrl"
                mode="aspectFit"
                :show-menu-by-longpress="true"
                @error="imageError = true"
              /><view v-else class="pay-image-error"
                ><text class="ui-text pay-copy">付款码未能加载</text
                ><button
                  class="ui-button pay-inline"
                  :class="busy ? 'is-disabled' : ''"
                  :disabled="busy"
                  @click="generate"
                  >重新加载</button
                ></view
              ><text class="ui-text pay-scan-hint">打开微信「扫一扫」付款</text></view
            >
            <view v-else class="pay-result"
              ><text class="ui-text pay-copy">{{
                busy ? '正在准备付款码…' : '付款码暂不可用'
              }}</text></view
            >
            <view class="pay-merchant-row"
              ><text class="ui-text pay-merchant-label">收款方</text
              ><text class="ui-text pay-merchant">{{
                payment?.merchantName ?? '北京华夏知古文化院'
              }}</text></view
            >
          </view>
          <text v-if="notice" class="ui-text pay-notice">{{ notice }}</text>
          <view class="pay-actions">
            <button
              v-if="payment && !paid && !closed && !expired"
              class="ui-button pay-primary"
              :class="saving || imageError ? 'is-disabled' : ''"
              :disabled="saving || imageError"
              @click="saveCode"
              ><text
                class="ui-text pay-primary-label"
                :class="saving || imageError ? 'pay-disabled-label' : ''"
                >{{ saving ? '正在保存…' : '保存付款码' }}</text
              ></button
            >
            <text v-if="payment && !paid && !closed && !expired" class="ui-text pay-guide"
              >微信扫一扫 → 相册 → 选择付款码</text
            >
            <button
              v-if="!paid"
              class="ui-button pay-secondary"
              :class="busy ? 'is-disabled' : ''"
              :disabled="busy"
              @click="check(true)"
              ><text
                class="ui-text pay-secondary-label"
                :class="busy ? 'pay-disabled-label' : ''"
                >{{ busy ? '正在核实付款…' : '我已付款，查询结果' }}</text
              ></button
            >
            <button
              v-if="!payment && !paid && !closed && !expired"
              class="ui-button pay-secondary pay-retry"
              :class="busy ? 'is-disabled' : ''"
              :disabled="busy"
              @click="generate"
              ><text class="ui-text pay-secondary-label" :class="busy ? 'pay-disabled-label' : ''"
                >重新获取付款码</text
              ></button
            >
            <button v-if="paid" class="ui-button pay-primary" @click="returnOrder"
              ><text class="ui-text pay-primary-label">返回订单，查看交付</text></button
            >
          </view>
          <view class="pay-detail-section"
            ><button class="ui-button pay-detail-toggle" @click="showDetails = !showDetails"
              ><view class="pay-detail-row"
                ><text class="ui-text pay-detail-label">订单信息</text
                ><text class="ui-text pay-detail-action">{{
                  showDetails ? '收起 −' : '展开 ＋'
                }}</text></view
              ></button
            ><view v-if="showDetails" class="pay-details"
              ><text class="ui-text pay-detail-caption">订单编号</text
              ><text class="ui-text pay-order" :user-select="true">{{ order?.orderNo ?? '' }}</text
              ><button class="ui-button pay-inline" @click="copyOrder">复制订单号</button></view
            ></view
          >
          <view v-if="!paid" class="pay-footer"
            ><text class="ui-text pay-footnote">付款后自动核实，已扣款请勿重复支付</text
            ><button class="ui-button pay-return" @click="returnOrder">返回原订单</button></view
          >
        </view>
        <template v-else>
          <ContentState
            :error="notice || '未找到付款订单'"
            :error-title="notice ? '付款结果待确认' : '未找到付款订单'"
            :retryable="false"
            action-label="返回原订单"
            @action="returnOrder"
          />
          <text class="ui-text pay-safe-note"
            >如已扣款，请勿重复付款：返回原订单查询最终结果即可，书院按渠道结果核对。</text
          >
        </template>
      </view></scroll-view
    ></view
  >
</template>
<script setup lang="ts">
import InkBackdrop from '../../components/InkBackdrop.uvue';
import PageHead from '../../components/PageHead.uvue';
import AppIcon from '../../components/AppIcon.uvue';
import ContentState from '../../components/ContentState.uvue';
import { request, money, apiBase } from '../../lib/api';
import { currentUser, needLogin } from '../../lib/session';
import { nativeOrderPaths } from '../../lib/native-payment';
type NativeCode = { codeUrl: string; qrImageUrl: string; expiresAt: string; merchantName: string };
type PaymentSubject = { title: string };
type PaymentLine = { title?: string };
type PaymentOrder = {
  id: string;
  orderNo: string;
  state: string;
  channel?: string;
  amount?: string;
  payableTotal?: string;
  paidAmount?: string;
  paidTotal?: string;
  expiresAt: string;
  serverTime?: string;
  course?: PaymentSubject;
  plan?: PaymentSubject;
  booking?: PaymentSubject;
  cohort?: PaymentSubject;
  pack?: PaymentSubject;
  items?: PaymentLine[];
};
const order = ref<PaymentOrder | null>(null),
  payment = ref<NativeCode | null>(null),
  loading = ref(true),
  busy = ref(false),
  saving = ref(false),
  notice = ref(''),
  imageError = ref(false),
  showDetails = ref(false),
  clock = ref(Date.now());
let id = '',
  kind = '',
  owner = '',
  visible = false,
  generation = 0,
  offset = 0,
  timer: ReturnType<typeof setInterval> | null = null,
  lastCheck = 0;
const paid = computed(
    () => !!order.value && Number(order.value.paidAmount ?? order.value.paidTotal ?? 0) > 0,
  ),
  closed = computed(() => order.value?.state === 'CLOSED'),
  expired = computed(() => !!order.value && Date.parse(order.value.expiresAt) <= clock.value),
  countdown = computed(() => {
    const seconds = Math.max(
      0,
      Math.ceil(
        (Date.parse(payment.value?.expiresAt ?? order.value?.expiresAt ?? '') - clock.value) / 1000,
      ),
    );
    return Math.floor(seconds / 60) + ':' + String(seconds % 60).padStart(2, '0');
  });
const subject = computed(
  () =>
    order.value?.course?.title ??
    order.value?.plan?.title ??
    order.value?.booking?.title ??
    order.value?.cohort?.title ??
    order.value?.pack?.title ??
    order.value?.items?.[0]?.title ??
    '书院订单',
);
function copyOrder() {
  if (order.value) uni.setClipboardData({ data: order.value.orderNo });
}
function active(turn: number) {
  return turn === generation && owner === currentUser.value?.id && visible;
}
function path() {
  const base = nativeOrderPaths[kind];
  if (!base || !/^[0-9a-f-]{36}$/i.test(id)) throw Error('付款入口无效，请返回原订单');
  return base + id;
}
function assign(row: PaymentOrder) {
  order.value = row;
  if (row.serverTime && Number.isFinite(Date.parse(row.serverTime)))
    offset = Date.parse(row.serverTime) - Date.now();
  clock.value = Date.now() + offset;
  if (paid.value || closed.value || expired.value) payment.value = null;
}
async function check(manual = false) {
  if (busy.value || !order.value || paid.value || !visible) return;
  const turn = generation;
  busy.value = true;
  lastCheck = Date.now();
  try {
    const row = await request<PaymentOrder>(path() + '/refresh', { method: 'POST' });
    if (!active(turn)) return;
    assign(row);
    notice.value = paid.value
      ? ''
      : closed.value
        ? '订单已关闭'
        : expired.value
          ? '已超过付款期限，请返回订单查看最终状态'
          : manual
            ? '暂未确认到账。如已扣款，请稍后再查，勿重复付款。'
            : '';
  } catch (e) {
    if (active(turn)) notice.value = (e as Error).message + '；请勿重复付款。';
  } finally {
    if (active(turn)) busy.value = false;
  }
}
async function generate() {
  if (busy.value || !visible) return;
  const turn = generation;
  busy.value = true;
  notice.value = '';
  try {
    const row = await request<PaymentOrder>(path() + '/refresh', { method: 'POST' });
    if (!active(turn)) return;
    assign(row);
    if (paid.value || closed.value || expired.value) return;
    if (row.channel !== 'WECHAT_NATIVE') throw Error('此订单不属于微信扫码支付，请返回原订单');
    const result = await request<{ provider: string; orderInfo: string }>(path() + '/payment', {
      method: 'POST',
    });
    if (!active(turn)) return;
    if (result.provider !== 'wxnative') throw Error('付款方式不匹配，请返回原订单');
    const code = JSON.parse(result.orderInfo) as NativeCode;
    if (
      !code.qrImageUrl.startsWith(apiBase + '/payments/wechat/native-qr?ticket=') ||
      !Number.isFinite(Date.parse(code.expiresAt))
    )
      throw Error('付款码暂不可用，请返回订单查询');
    payment.value = code;
    imageError.value = false;
    lastCheck = Date.now();
  } catch (e) {
    if (active(turn)) notice.value = (e as Error).message + '；订单已保留，请先查询结果。';
  } finally {
    if (active(turn)) {
      busy.value = false;
      loading.value = false;
    }
  }
}
async function start() {
  if (needLogin('/pages/payment/native?kind=' + kind + '&id=' + id)) return;
  owner = currentUser.value?.id ?? '';
  loading.value = true;
  try {
    path();
    await generate();
  } catch (e) {
    notice.value = (e as Error).message;
    loading.value = false;
  }
}
async function saveCode() {
  if (!payment.value || saving.value || paid.value || closed.value || expired.value) return;
  saving.value = true;
  const turn = generation;
  // #ifdef APP
  try {
    const image = await new Promise<string>((resolve, reject) =>
      uni.downloadFile({
        url: payment.value!.qrImageUrl,
        timeout: 15000,
        success: (r) =>
          r.statusCode === 200
            ? resolve(r.tempFilePath)
            : reject(Error('付款码已失效，请刷新订单')),
        fail: () => reject(Error('图片下载失败，请检查网络后重试')),
      }),
    );
    if (!active(turn)) return;
    await new Promise<void>((resolve, reject) =>
      uni.saveImageToPhotosAlbum({
        filePath: image,
        success: () => resolve(),
        fail: () => reject(Error('未能保存图片，请允许相册权限，或截屏后用微信识别')),
      }),
    );
    if (active(turn)) notice.value = '已保存，请打开微信扫一扫，从相册选择付款码。';
  } catch (e) {
    if (active(turn)) notice.value = (e as Error).message;
  }
  // #endif
  // #ifndef APP
  notice.value = '可长按或右键保存付款码，也可使用另一台手机微信扫码。';
  // #endif
  if (active(turn)) saving.value = false;
}
function returnOrder() {
  const pages: Record<string, string> = {
    CENTER: 'membership/center-purchase?id=',
    COURSE: 'course/purchase?orderId=',
    MEMBERSHIP: 'membership/purchase?orderId=',
    PHYSICAL: 'shop/order-detail?id=',
    DIGITAL: 'shop/digital-order?id=',
    BOOKING: 'booking/purchase?orderId=',
    COHORT: 'cohort/purchase?orderId=',
  };
  const target = pages[kind];
  if (target) {
    uni.redirectTo({ url: '/pages/' + target + encodeURIComponent(id) });
    return;
  }
  if (getCurrentPages().length > 1) uni.navigateBack();
  else uni.switchTab({ url: '/pages/index/index' });
}
function stop() {
  visible = false;
  generation++;
  busy.value = false;
  saving.value = false;
  if (timer) clearInterval(timer);
  timer = null;
}
watch(
  () => currentUser.value?.id,
  (value) => {
    if (owner && owner !== value) {
      stop();
      order.value = null;
      payment.value = null;
      loading.value = false;
      notice.value = '账号已变化，请返回本人订单重新付款';
    }
  },
);
onLoad((options) => {
  id = options?.id ?? '';
  kind = options?.kind ?? '';
});
onShow(() => {
  visible = true;
  clock.value = Date.now() + offset;
  if (!timer)
    timer = setInterval(() => {
      clock.value = Date.now() + offset;
      if (Date.now() - lastCheck >= 6000) void check();
    }, 1000);
  if (!order.value) void start();
  else void check();
});
onHide(stop);
onUnload(stop);
</script>
<style>
