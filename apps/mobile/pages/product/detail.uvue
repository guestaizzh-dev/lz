<template>
<view class="page">
<PageHead title="书院好物" action="share" @action="share"/>
<scroll-view :show-scrollbar="false" class="page-scroll" direction="vertical">
<view class="content">
<ContentState v-if="!product" :loading="!error" :error="error" @retry="load"/>
<view v-else>
<ArtImage :src="product!.cover" :kind="artwork(product!.cover,product!.category)" :width="width" :height="260"/>
<text class="detail-title">{{product!.title}}</text>
<text class="intro">{{product!.subtitle}}</text><view v-for="promotion in (product!.promotions??[]).filter(p=>!selected||p.skuId===selected!.id)" :key="promotion.id+promotion.skuId" class="product-promotion"><text class="item-title">{{promotion.title}}</text><text class="body-copy">{{promotion.kind==='PRODUCT_FLASH'?'活动单价 ¥'+money(promotion.price??0):'指定规格满 ¥'+money(promotion.rules.threshold??0)+' 减 ¥'+money(promotion.rules.reduction??0)}}</text><text class="meta">{{formatChinaTime(promotion.startsAt)}} 至 {{formatChinaTime(promotion.endsAt)}}（北京）</text><text class="footer-note">活动剩余 {{promotion.remaining}} 件，服务端核对限购并在结算择优；同商品不叠加会员折扣。页面展示不占库存。</text></view>
<view class="row between product-price">
<text class="price">¥{{money(selected?.price??product!.price)}}</text>
<text class="tag">{{product!.category}}</text>
</view>
<view class="menu-row">
<text class="menu-label product-label">规格</text>
<text class="menu-value">{{selected?.title??'尚未配置可售规格'}}</text>
</view>
<view v-if="product!.skus?.length" class="sku-options"><button v-for="item in product!.skus" :key="item.id" :class="['sku-button',skuId===item.id?'sku-selected':'']" @click="choose(item.id)">{{item.title}}</button></view>
<text v-if="selected&&product!.type!=='SERVICE'" class="meta">{{selected!.available>0?'当前可售 '+selected!.available+' 件':'暂时售罄'}}</text>
<view v-if="product!.type!=='SERVICE'" class="menu-row">
<text class="menu-label product-label">数量</text>
<view class="quantity-action icon-control"><AppIcon name="minus" :size="15"/><button class="icon-hit-target" aria-label="减少数量" :disabled="quantity<=1" @click="quantity=Math.max(1,quantity-1)"></button></view>
<text class="quantity">{{quantity}}</text>
<view class="quantity-action icon-control"><AppIcon name="plus" :size="15"/><button class="icon-hit-target" aria-label="增加数量" :disabled="!selected||quantity>=selected!.available||quantity>=99" @click="quantity=Math.min(99,selected?.available??1,quantity+1)"></button></view>
</view>
<view class="detail-tabs">
<view v-for="item in ['商品详情','文化溯源','售后说明']" :key="item" :class="['detail-tab',tab===item?'detail-tab-active':'']" @click="tab=item">
<text :class="['detail-tab-text',tab===item?'detail-tab-selected':'']">{{item}}</text>
</view>
</view>
<text v-if="tab==='商品详情'" class="body-copy" :user-select="true">{{product!.description}}</text>
<view v-else-if="tab==='文化溯源'"><text class="body-copy" :user-select="true">{{product!.culturalOrigin}}</text><text v-if="!product!.evidence?.length" class="meta">以上为商品文化介绍，尚无审核通过的公开证据。</text><SourceEvidence :items="product!.evidence??[]"/></view>
<text v-else class="body-copy" :user-select="true">{{product!.refundPolicy??'请在确认订单页面核查配送与售后规则。'}}</text>
<RelatedContent ref="relatedRef" :resourceId="id"/>
<text v-if="product!.isDemo" class="demo-note">开发示例 · 不提供真实交易</text>
</view>
</view>
</scroll-view>
<BottomBar v-if="product"><button v-if="product!.type==='SERVICE'" class="bar-primary" :disabled="!selected?.serviceOfferingId" @click="serviceBook">选择服务时段</button>
<button v-if="product!.type!=='SERVICE'" class="bar-secondary" :disabled="busy||!selected||selected!.available<quantity||product!.type!=='PHYSICAL'" @click="cart()">{{busy?'加入中…':'加入购物车'}}</button>
<button v-if="product!.type!=='SERVICE'" class="bar-primary" :disabled="!selected||selected!.available<quantity||product!.type!=='PHYSICAL'" @click="buy()">确认规格与配送</button>
</BottomBar>
</view>
</template>
<script setup lang="ts">
import {formatChinaTime} from '../../lib/date-time';
import SourceEvidence from '../../components/SourceEvidence.uvue';
import RelatedContent from '../../components/RelatedContent.uvue';
import BottomBar from '../../components/BottomBar.uvue';
import PageHead from '../../components/PageHead.uvue';import AppIcon from '../../components/AppIcon.uvue';import ArtImage from '../../components/ArtImage.uvue';import ContentState from '../../components/ContentState.uvue';import {request,money} from '../../lib/api';import type {Product} from '../../lib/api';import {viewWidth,artwork,openPage,shareContent,showUnavailable} from '../../lib/presentation';import {needLogin} from '../../lib/session';
const width=viewWidth(),product=ref<Product|null>(null),error=ref(''),quantity=ref(1),tab=ref('商品详情'),skuId=ref(''),busy=ref(false);const selected=computed(()=>product.value?.skus?.find(item=>item.id===skuId.value)??null);let id='';async function load(){error.value='';try{product.value=await request<Product>('/catalog/products/'+encodeURIComponent(id));if(!product.value.skus?.some(item=>item.id===skuId.value))skuId.value=product.value.skus?.[0]?.id??'';}catch(e){product.value=null;error.value=(e as Error).message;}}function choose(value:string){skuId.value=value;quantity.value=1;}
function copySource(url:string){uni.setClipboardData({data:url});}
async function share(){
  if(!product.value)return;
  try{
    const result=await request<{url:string,shortUrl:string}>('/share/links',{
      method:'POST',
      data:{
        resourceType:'PRODUCT',
        resourceId:id,
        title:product.value.title,
        description:product.value.subtitle,
        coverUrl:product.value.cover
      }
    });
    uni.setClipboardData({
      data:result.shortUrl,
      success:()=>{
        uni.showToast({title:'分享链接已复制',icon:'success'});
      }
    });
  }catch(e){
    uni.showToast({title:'生成分享链接失败',icon:'none'});
  }
}async function cart(){if(busy.value||needLogin()||!selected.value)return;busy.value=true;try{await request('/shopping/cart/'+selected.value.id,{method:'PUT',data:{quantity:quantity.value}});uni.showToast({title:'购物车数量已更新',icon:'none'});}catch(e){uni.showToast({title:(e as Error).message,icon:'none'});await load();}finally{busy.value=false;}}function serviceBook(){if(!selected.value?.serviceOfferingId)return;openPage('booking/confirm?offeringId='+selected.value.serviceOfferingId+'&skuId='+selected.value.id);}function buy(){if(needLogin())return;if(!selected.value){showUnavailable('商品尚未开放','书院配置商品规格后，可以查看下单信息。');return;}openPage('order/confirm?type=product&id='+id+'&skuId='+skuId.value+'&quantity='+quantity.value);}onLoad(options=>{id=options?.id??'';});onShow(()=>{if(id)load();});

const relatedRef=ref<InstanceType<typeof RelatedContent>|null>(null);
onShow(()=>{relatedRef.value?.refresh();});
</script>
<style>@import '../../styles/app.css';.product-price{margin:16px 0 10px;}.product-label{margin-left:0;}.quantity-action{border-style:solid;border-width:0;width:36px;height:40px;align-items:center;justify-content:center;padding:0;margin:0;background-color:transparent;border-width:0;}.quantity{font-size:14px;color:#17292D;padding:0 12px;line-height:21px;}.sku-options{flex-direction:row;flex-wrap:wrap;margin-top:12px;}.sku-button{font-size:12px;line-height:22px;color:#637276;background-color:#FAF8F2;min-height:44px;border-radius:3px;border-style:solid;border-width:1px;border-color:#D8D4CA;padding:10px 14px;margin:0 8px 8px 0;}.sku-selected{color:#245564;background-color:#E5ECE9;border-color:#245564;}.product-promotion{padding:16px;margin-top:16px;background-color:#EEE9DF;border-radius:4px;}</style>
