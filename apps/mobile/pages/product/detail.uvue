<template>
<view class="page">
<PageHead title="书院好物" action="share" @action="share"/>
<scroll-view :show-scrollbar="false" class="page-scroll" direction="vertical">
<view class="content">
<ContentState v-if="!product" :loading="!error" :error="error" @retry="load"/>
<view v-else>
<ArtImage :src="product!.cover" :kind="artwork(product!.cover,product!.category)" :width="width" :height="260" :radius="12"/>
<text class="detail-title">{{product!.title}}</text>
<text class="intro">{{product!.subtitle}}</text><view v-for="promotion in (product!.promotions??[]).filter(p=>!selected||p.skuId===selected!.id)" :key="promotion.id+promotion.skuId" class="product-promotion"><text class="item-title">{{promotion.title}}</text><text class="body-copy">{{promotion.kind==='PRODUCT_FLASH'?'活动单价 ¥'+money(promotion.price??0):'指定规格满 ¥'+money(promotion.rules.threshold??0)+' 减 ¥'+money(promotion.rules.reduction??0)}}</text><text class="meta">{{formatChinaTime(promotion.startsAt)}} 至 {{formatChinaTime(promotion.endsAt)}}（北京）</text><text class="footer-note">活动剩余 {{promotion.remaining}} 件，服务端核对限购并在结算择优；同商品不叠加会员折扣。页面展示不占库存。</text></view>
<view class="row between product-price">
<text class="price">¥{{money(selected?.price??product!.price)}}</text>
<text class="tag">{{product!.category}}</text>
</view>
<view class="menu-row">
<text class="menu-label product-label">规格</text>
<text class="menu-value">{{selected?.title??'尚未配置可售规格'}}</text>
</view>
<view v-if="product!.skus?.length" class="sku-options"><button v-for="item in product!.skus" :key="item.id" :class="['sku-button',skuId===item.id?'sku-selected':'']" @click="choose(item.id)">{{item.title}}</button></view>
<text v-if="selected&&product!.type==='PHYSICAL'" :class="['stock-note',selected!.available>0?'':'stock-out']">{{selected!.available>0?'当前可售 '+selected!.available+' 件':'暂时售罄'}}</text>
<view v-if="product!.type==='PHYSICAL'" class="menu-row">
<text class="menu-label product-label">数量</text>
<view class="stepper">
<button class="stepper-button" :class="quantity<=1?'is-disabled':''" :disabled="quantity<=1" aria-label="减少数量" @click="dec">−</button>
<text class="stepper-value">{{quantity}}</text>
<button class="stepper-button" :class="canAdd?'':'is-disabled'" :disabled="!canAdd" aria-label="增加数量" @click="inc">+</button>
</view>
</view>
<view class="detail-tabs">
<view v-for="item in ['商品详情','文化溯源','售后说明']" :key="item" :class="['detail-tab',tab===item?'detail-tab-active':'']" @click="tab=item">
<text :class="['detail-tab-text',tab===item?'detail-tab-selected':'']">{{item}}</text>
</view>
</view>
<text v-if="tab==='商品详情'" class="body-copy" :user-select="true">{{product!.description}}</text>
<view v-else-if="tab==='文化溯源'"><text class="body-copy" :user-select="true">{{product!.culturalOrigin}}</text><text v-if="!product!.evidence?.length" class="meta">以上为商品文化介绍，尚无审核通过的公开证据。</text><SourceEvidence :items="product!.evidence??[]"/></view>
<text v-else class="body-copy" :user-select="true">{{product!.refundPolicy??'请在确认订单页面核查配送与售后规则。'}}</text>
<RelatedContent ref="relatedRef" :resourceId="id"/>
<text v-if="product!.isDemo" class="demo-note">开发示例 · 不提供真实交易</text>
</view>
</view>
</scroll-view>
<BottomBar v-if="product"><button v-if="product!.type==='SERVICE'" class="bar-primary" :class="selected?.serviceOfferingId?'':'is-disabled'" @click="serviceBook">选择服务时段</button>
<button v-if="product!.type==='DIGITAL'" class="bar-primary grow" :disabled="!selected" @click="digitalBuy">查看资料与交付规则</button>
<button v-if="product!.type==='PHYSICAL'" class="bar-secondary" :class="canBuy&&!busy?'':'is-disabled'" @click="cart()">{{busy?'加入中…':'加入购物车'}}</button>
<button v-if="product!.type==='PHYSICAL'" class="bar-primary" :class="canBuy?'':'is-disabled'" @click="buy()">确认规格与配送</button>
</BottomBar>
</view>
</template>
<script setup lang="ts">
import {formatChinaTime} from '../../lib/date-time';
import SourceEvidence from '../../components/SourceEvidence.uvue';
import RelatedContent from '../../components/RelatedContent.uvue';
import BottomBar from '../../components/BottomBar.uvue';
import PageHead from '../../components/PageHead.uvue';import ArtImage from '../../components/ArtImage.uvue';import ContentState from '../../components/ContentState.uvue';import {request,money} from '../../lib/api';import type {Product} from '../../lib/api';import {viewWidth,artwork,openPage,shareContent,showUnavailable} from '../../lib/presentation';import {needLogin} from '../../lib/session';
const width=viewWidth(),product=ref<Product|null>(null),error=ref(''),quantity=ref(1),tab=ref('商品详情'),skuId=ref(''),busy=ref(false);const selected=computed(()=>product.value?.skus?.find(item=>item.id===skuId.value)??null);const canAdd=computed(()=>!!selected.value&&quantity.value<selected.value.available&&quantity.value<99),canBuy=computed(()=>!!selected.value&&product.value?.type==='PHYSICAL'&&selected.value.available>=quantity.value);function dec(){quantity.value=Math.max(1,quantity.value-1);}function inc(){if(canAdd.value)quantity.value=quantity.value+1;}let id='';async function load(){error.value='';try{product.value=await request<Product>('/catalog/products/'+encodeURIComponent(id));if(!product.value.skus?.some(item=>item.id===skuId.value))skuId.value=product.value.skus?.[0]?.id??'';}catch(e){product.value=null;error.value=(e as Error).message;}}function choose(value:string){skuId.value=value;quantity.value=1;}
function copySource(url:string){uni.setClipboardData({data:url});}
async function share(){
  if(!product.value)return;
  try{
    const result=await request<{url:string,shortUrl:string}>('/share/links',{
      method:'POST',
      data:{
        resourceType:'PRODUCT',
        resourceId:id,
        title:product.value.title,
        description:product.value.subtitle,
        coverUrl:product.value.cover
      }
    });
    uni.setClipboardData({
      data:result.shortUrl,
      success:()=>{
        uni.showToast({title:'分享链接已复制',icon:'success'});
      }
    });
  }catch(e){
    uni.showToast({title:'生成分享链接失败',icon:'none'});
  }
}async function cart(){const sku=selected.value;if(busy.value||needLogin()||!sku||!canBuy.value){if(sku&&!canBuy.value)uni.showToast({title:'该规格暂时售罄',icon:'none'});return;}busy.value=true;try{await request('/shopping/cart/'+sku.id,{method:'PUT',data:{quantity:quantity.value}});uni.showToast({title:'购物车数量已更新',icon:'none'});}catch(e){uni.showToast({title:(e as Error).message,icon:'none'});await load();}finally{busy.value=false;}}function digitalBuy(){if(needLogin()||!selected.value)return;openPage('shop/digital-order?skuId='+selected.value.id);}function serviceBook(){if(!selected.value?.serviceOfferingId)return;openPage('booking/confirm?offeringId='+selected.value.serviceOfferingId+'&skuId='+selected.value.id);}function buy(){if(needLogin())return;if(!selected.value){showUnavailable('商品尚未开放','书院配置商品规格后，可以查看下单信息。');return;}if(!canBuy.value){uni.showToast({title:'该规格暂时售罄',icon:'none'});return;}openPage('order/confirm?type=product&id='+id+'&skuId='+skuId.value+'&quantity='+quantity.value);}onLoad(options=>{id=options?.id??'';});onShow(()=>{if(id)load();});

const relatedRef=ref<InstanceType<typeof RelatedContent>|null>(null);
onShow(()=>{relatedRef.value?.refresh();});
</script>
<style>@import '../../styles/app.css';.product-price{margin:18px 0 10px;}.product-label{margin-left:0;}.stepper{flex-direction:row;align-items:center;border-style:solid;border-width:1px;border-color:#D3C9B8;border-radius:23px;overflow:hidden;}.stepper-button{width:44px;height:44px;min-height:44px;flex-shrink:0;padding:0;margin:0;background-color:transparent;border-style:solid;border-width:0;color:#235663;font-size:22px;line-height:44px;text-align:center;}.stepper-value{min-width:34px;text-align:center;font-size:14px;color:#182B31;line-height:20px;}.stock-note{font-family:AcademySans;font-size:12px;line-height:20px;color:#6A7578;margin-top:8px;}.stock-out{color:#B4533F;}.sku-options{flex-direction:row;flex-wrap:wrap;margin-top:10px;}.sku-button{font-size:14px;line-height:24px;color:#344C54;background-color:#FCF9F2;min-height:44px;border-radius:6px;border-style:solid;border-width:1px;border-color:#D3C9B8;padding:10px 16px;margin:0 8px 8px 0;}.sku-selected{color:#235663;background-color:#E7EEE9;border-color:#235663;font-weight:600;}.product-promotion{padding:16px;margin-top:16px;background-color:#EFE9DC;border-radius:8px;}</style>
