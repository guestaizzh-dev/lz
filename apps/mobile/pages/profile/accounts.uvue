<template>
  <view class="page"
    ><InkBackdrop /><PageHead title="账号与登录" /><scroll-view
      class="page-scroll"
      direction="vertical"
      :show-scrollbar="false"
      ><view class="content"
        ><text class="ui-text intro"
          >手机号是书院账号的找回方式。绑定与解绑都需重新验证手机号，已有订单、笔记和权益保持归属。</text
        ><ContentState v-if="loading || error" :loading="loading" :error="error" @retry="load" />
        <view
          v-for="provider in ['WECHAT', 'APPLE']"
          :key="provider"
          class="account-row"
          @click="
            bound(provider)
              ? prepareUnbind(provider)
              : available.includes(provider) && bind(provider)
          "
          ><view class="grow"
            ><text class="ui-text account-name">{{ provider === 'WECHAT' ? '微信' : 'Apple' }}</text
            ><text v-if="bound(provider)" class="ui-text account-meta"
              >验证于 {{ formatChinaDate(bound(provider)!.verifiedAt) }}</text
            ><text v-else class="ui-text account-meta">验证手机号后即可绑定</text></view
          ><view
            :class="[
              'pill',
              'account-pill',
              bound(provider)
                ? 'pill-teal'
                : available.includes(provider)
                  ? 'pill-gold'
                  : 'pill-muted',
            ]"
            ><text class="ui-text pill-text">{{
              bound(provider) ? '已绑定' : available.includes(provider) ? '可绑定' : '暂未开通'
            }}</text></view
          ><AppIcon
            v-if="bound(provider) || available.includes(provider)"
            name="arrow-right"
            :size="16"
        /></view>
        <view v-if="action" class="verification"
          ><text class="ui-text section-heading">{{
            action === 'BIND' ? '验证手机号后绑定' : '验证手机号后解绑'
          }}</text
          ><text class="ui-text meta">请输入当前书院账号绑定的完整手机号。{{ phoneHint }}</text
          ><input
            class="ui-input account-input"
            type="number"
            maxlength="11"
            placeholder="当前账号绑定的手机号"
            v-model="phone"
            :disabled="busy"
          /><view class="row"
            ><input
              class="ui-input account-input grow"
              type="number"
              maxlength="6"
              placeholder="6位验证码"
              v-model="code"
              :disabled="busy"
            /><button
              class="ui-button account-action"
              :disabled="busy || countdown > 0 || sending"
              @click="send"
              >{{ countdown > 0 ? countdown + '秒后重发' : '获取验证码' }}</button
            ></view
          ><text v-if="formError" class="ui-text form-error">{{ formError }}</text
          ><button class="ui-button primary-button" :disabled="busy" @click="confirm">{{
            busy ? '处理中…' : action === 'BIND' ? '确认绑定' : '确认解绑'
          }}</button
          ><button class="ui-button account-action" :disabled="busy" @click="cancel"
            >取消</button
          ></view
        >
        <text class="ui-text footer-note"
          >第三方身份不能同时绑定两个书院账号。如提示冲突，请先用原手机号登录，在原账号中处理；系统不会自动合并订单或覆盖私人资料。</text
        ></view
      ></scroll-view
    ></view
  >
</template>
<script setup lang="ts">
import InkBackdrop from '../../components/InkBackdrop.uvue';
import PageHead from '../../components/PageHead.uvue';
import ContentState from '../../components/ContentState.uvue';
import { request } from '../../lib/api';
import { currentUser, needLogin, saveSession, sessionGeneration } from '../../lib/session';
import type { LoginResult } from '../../lib/session';
import { availableSocialProviders, authorizeSocial } from '../../lib/social-login';
import type { SocialProvider, SocialTicket } from '../../lib/social-login';
import { formatChinaDate } from '../../lib/date-time';
type Binding = { id: string; provider: SocialProvider; verifiedAt: string; version: number };
const items = ref<Binding[]>([]),
  available = ref<string[]>([]),
  loading = ref(false),
  error = ref(''),
  busy = ref(false),
  sending = ref(false),
  phone = ref(''),
  phoneHint = ref(''),
  code = ref(''),
  formError = ref(''),
  countdown = ref(0),
  action = ref(''),
  selected = ref<SocialProvider>('WECHAT');
let ticket: SocialTicket | null = null,
  challengeId = '',
  timer: ReturnType<typeof setInterval> | null = null,
  active = true;
const bound = (provider: string) => items.value.find((item) => item.provider === provider);
function cancel() {
  action.value = '';
  ticket = null;
  code.value = '';
  challengeId = '';
  formError.value = '';
}
async function load() {
  if (needLogin()) return;
  const generation = sessionGeneration();
  loading.value = true;
  error.value = '';
  try {
    const result = await request<{ items: Binding[]; phone: string | null }>('/me/identities');
    const choices = await availableSocialProviders();
    if (!active || generation !== sessionGeneration()) return;
    items.value = result.items;
    phoneHint.value = result.phone ? '已绑定：' + result.phone : '';
    available.value = choices;
  } catch (e) {
    if (active && generation === sessionGeneration()) error.value = (e as Error).message;
  } finally {
    if (active && generation === sessionGeneration()) loading.value = false;
  }
}
async function bind(provider: string) {
  if (busy.value) return;
  selected.value = provider as SocialProvider;
  busy.value = true;
  formError.value = '';
  const generation = sessionGeneration();
  try {
    const result = await authorizeSocial(selected.value, true);
    if (!active || generation !== sessionGeneration()) return;
    ticket = result.ticket;
    action.value = 'BIND';
    code.value = '';
    challengeId = '';
  } catch (e) {
    if (active && generation === sessionGeneration()) error.value = (e as Error).message;
  } finally {
    if (active) busy.value = false;
  }
}
function prepareUnbind(provider: string) {
  cancel();
  selected.value = provider as SocialProvider;
  action.value = 'UNBIND';
}
async function send() {
  if (sending.value || countdown.value > 0) return;
  if (!/^1[3-9]\d{9}$/.test(phone.value)) {
    formError.value = '请输入完整的11位手机号';
    return;
  }
  const generation = sessionGeneration();
  sending.value = true;
  formError.value = '';
  try {
    const result = await request<{ challengeId: string; retryAfter: number }>('/auth/sms', {
      method: 'POST',
      data: { phone: phone.value },
    });
    if (!active || generation !== sessionGeneration()) return;
    challengeId = result.challengeId;
    countdown.value = result.retryAfter;
    if (timer) clearInterval(timer);
    timer = setInterval(() => {
      countdown.value = Math.max(0, countdown.value - 1);
      if (countdown.value === 0 && timer) {
        clearInterval(timer);
        timer = null;
      }
    }, 1000);
  } catch (e) {
    if (active && generation === sessionGeneration()) formError.value = (e as Error).message;
  } finally {
    if (active) sending.value = false;
  }
}
async function confirm() {
  if (busy.value) return;
  if (!challengeId || !/^\d{6}$/.test(code.value)) {
    formError.value = '请获取并填写验证码';
    return;
  }
  const generation = sessionGeneration();
  busy.value = true;
  formError.value = '';
  try {
    if (action.value === 'BIND' && (!ticket || Date.parse(ticket.expiresAt) <= Date.now()))
      throw new Error('授权已过期，请取消后重新绑定');
    const path =
        action.value === 'BIND'
          ? '/me/identities/phone'
          : '/me/identities/' + selected.value + '/unbind',
      result = await request<LoginResult>(path, {
        method: 'POST',
        data: {
          phone: phone.value,
          code: code.value,
          challengeId,
          ...(action.value === 'BIND' && ticket
            ? { ticketId: ticket.ticketId, state: ticket.state }
            : {}),
        },
      });
    if (!active || generation !== sessionGeneration()) return;
    saveSession(result);
    cancel();
    uni.showToast({ title: '账号登录方式已更新', icon: 'none' });
    await load();
  } catch (e) {
    if (active && generation === sessionGeneration()) formError.value = (e as Error).message;
  } finally {
    if (active) busy.value = false;
  }
}
watch(phone, () => {
  code.value = '';
  challengeId = '';
  countdown.value = 0;
  if (timer) {
    clearInterval(timer);
    timer = null;
  }
});
watch(
  () => currentUser.value?.id,
  () => {
    cancel();
    items.value = [];
    phone.value = '';
    phoneHint.value = '';
  },
);
onShow(() => void load());
onUnload(() => {
  active = false;
  ticket = null;
  if (timer) clearInterval(timer);
});
</script>
<style>
@import '../../styles/app.css';
.intro {
  margin-top: 16px;
  font-size: 13px;
  line-height: 22px;
  color: #5c6869;
}
.account-row {
  flex-direction: row;
  align-items: center;
  padding: 15px 0;
  border-bottom-style: solid;
  border-bottom-width: 1px;
  border-bottom-color: #e0d8c8;
}
.account-pill {
  align-self: center;
}
.account-name {
  font-family: AcademySerif;
  font-size: 16px;
  line-height: 24px;
  color: #182b31;
  font-weight: 600;
}
.account-meta {
  margin-top: 4px;
  font-size: 12px;
  line-height: 20px;
  color: #5c6869;
}
.account-action {
  min-height: 44px;
  padding: 11px 8px;
  margin: 0;
  background-color: transparent;
  color: #235663;
  border-width: 0;
  font-size: 13px;
  line-height: 22px;
  flex-shrink: 0;
}
.verification {
  margin-top: 32px;
  padding: 16px;
  background-color: #fcf9f2;
  border-style: solid;
  border-width: 1px;
  border-color: #cfc5b1;
  border-radius: 14px;
}
.account-input {
  height: 46px;
  min-height: 46px;
  margin-top: 12px;
  padding: 0 12px;
  font-size: 15px;
  line-height: 22px;
  background-color: #fcf9f2;
  border-style: solid;
  border-width: 1px;
  border-color: #cfc5b1;
  border-radius: 10px;
  color: #182b31;
}
.form-error {
  font-size: 13px;
  line-height: 22px;
  color: #b4533f;
  margin-top: 12px;
}
</style>
