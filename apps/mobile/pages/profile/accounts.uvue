<template><view class="page"><PageHead title="账号与登录"/><scroll-view class="page-scroll" direction="vertical" :show-scrollbar="false"><view class="content"><text class="intro">手机号是书院账号的找回方式。绑定与解绑都需重新验证手机号，已有订单、笔记和权益保持归属。</text><ContentState v-if="loading||error" :loading="loading" :error="error" @retry="load"/>
<view v-for="provider in ['WECHAT','APPLE']" :key="provider" class="account-row"><view class="grow"><text class="section-heading">{{provider==='WECHAT'?'微信':'Apple'}}</text><text class="meta">{{bound(provider)?'已绑定 · '+formatChinaDate(bound(provider)!.verifiedAt):'尚未绑定'}}</text></view><button v-if="bound(provider)" class="account-action" :disabled="busy" @click="prepareUnbind(provider)">解绑</button><button v-else-if="available.includes(provider)" class="account-action" :disabled="busy" @click="bind(provider)">绑定</button><text v-else class="meta">暂未开通</text></view>
<view v-if="action" class="verification"><text class="section-heading">{{action==='BIND'?'验证手机号后绑定':'验证手机号后解绑'}}</text><text class="meta">请输入当前书院账号绑定的完整手机号。{{phoneHint}}</text><input class="account-input" type="number" maxlength="11" placeholder="当前账号绑定的手机号" v-model="phone" :disabled="busy"/><view class="row"><input class="account-input grow" type="number" maxlength="6" placeholder="6位验证码" v-model="code" :disabled="busy"/><button class="account-action" :disabled="busy||countdown>0||sending" @click="send">{{countdown>0?countdown+'秒后重发':'获取验证码'}}</button></view><text v-if="formError" class="form-error">{{formError}}</text><button class="primary-button" :disabled="busy" @click="confirm">{{busy?'处理中…':action==='BIND'?'确认绑定':'确认解绑'}}</button><button class="account-action" :disabled="busy" @click="cancel">取消</button></view>
<text class="footer-note">第三方身份不能同时绑定两个书院账号。如提示冲突，请先用原手机号登录，在原账号中处理；系统不会自动合并订单或覆盖私人资料。</text></view></scroll-view></view></template>
<script setup lang="ts">
import PageHead from '../../components/PageHead.uvue';import ContentState from '../../components/ContentState.uvue';
import {request} from '../../lib/api';import {currentUser,needLogin,saveSession,sessionGeneration} from '../../lib/session';import type {LoginResult} from '../../lib/session';
import {availableSocialProviders,authorizeSocial} from '../../lib/social-login';import type {SocialProvider,SocialTicket} from '../../lib/social-login';import {formatChinaDate} from '../../lib/date-time';
type Binding={id:string;provider:SocialProvider;verifiedAt:string;version:number};
const items=ref<Binding[]>([]),available=ref<string[]>([]),loading=ref(false),error=ref(''),busy=ref(false),sending=ref(false),phone=ref(''),phoneHint=ref(''),code=ref(''),formError=ref(''),countdown=ref(0),action=ref(''),selected=ref<SocialProvider>('WECHAT');let ticket:SocialTicket|null=null,challengeId='',timer:ReturnType<typeof setInterval>|null=null,active=true;
const bound=(provider:string)=>items.value.find(item=>item.provider===provider);
function cancel(){action.value='';ticket=null;code.value='';challengeId='';formError.value='';}
async function load(){if(needLogin())return;const generation=sessionGeneration();loading.value=true;error.value='';try{const result=await request<{items:Binding[];phone:string|null}>('/me/identities');const choices=await availableSocialProviders();if(!active||generation!==sessionGeneration())return;items.value=result.items;phoneHint.value=result.phone?'已绑定：'+result.phone:'';available.value=choices;}catch(e){if(active&&generation===sessionGeneration())error.value=(e as Error).message;}finally{if(active&&generation===sessionGeneration())loading.value=false;}}
async function bind(provider:string){if(busy.value)return;selected.value=provider as SocialProvider;busy.value=true;formError.value='';const generation=sessionGeneration();try{const result=await authorizeSocial(selected.value,true);if(!active||generation!==sessionGeneration())return;ticket=result.ticket;action.value='BIND';code.value='';challengeId='';}catch(e){if(active&&generation===sessionGeneration())error.value=(e as Error).message;}finally{if(active)busy.value=false;}}
function prepareUnbind(provider:string){cancel();selected.value=provider as SocialProvider;action.value='UNBIND';}
async function send(){if(sending.value||countdown.value>0)return;if(!/^1[3-9]\d{9}$/.test(phone.value)){formError.value='请输入完整的11位手机号';return;}const generation=sessionGeneration();sending.value=true;formError.value='';try{const result=await request<{challengeId:string;retryAfter:number}>('/auth/sms',{method:'POST',data:{phone:phone.value}});if(!active||generation!==sessionGeneration())return;challengeId=result.challengeId;countdown.value=result.retryAfter;if(timer)clearInterval(timer);timer=setInterval(()=>{countdown.value=Math.max(0,countdown.value-1);if(countdown.value===0&&timer){clearInterval(timer);timer=null;}},1000);}catch(e){if(active&&generation===sessionGeneration())formError.value=(e as Error).message;}finally{if(active)sending.value=false;}}
async function confirm(){if(busy.value)return;if(!challengeId||!/^\d{6}$/.test(code.value)){formError.value='请获取并填写验证码';return;}const generation=sessionGeneration();busy.value=true;formError.value='';try{if(action.value==='BIND'&&(!ticket||Date.parse(ticket.expiresAt)<=Date.now()))throw new Error('授权已过期，请取消后重新绑定');const path=action.value==='BIND'?'/me/identities/phone':'/me/identities/'+selected.value+'/unbind',result=await request<LoginResult>(path,{method:'POST',data:{phone:phone.value,code:code.value,challengeId,...(action.value==='BIND'&&ticket?{ticketId:ticket.ticketId,state:ticket.state}:{})}});if(!active||generation!==sessionGeneration())return;saveSession(result);cancel();uni.showToast({title:'账号登录方式已更新',icon:'none'});await load();}catch(e){if(active&&generation===sessionGeneration())formError.value=(e as Error).message;}finally{if(active)busy.value=false;}}
watch(phone,()=>{code.value='';challengeId='';countdown.value=0;if(timer){clearInterval(timer);timer=null;}});watch(()=>currentUser.value?.id,()=>{cancel();items.value=[];phone.value='';phoneHint.value='';});onShow(()=>void load());onUnload(()=>{active=false;ticket=null;if(timer)clearInterval(timer);});
</script>
<style>@import '../../styles/app.css';.account-row{flex-direction:row;align-items:center;min-height:88px;padding:16px 0;border-bottom-width:1px;border-bottom-color:#DFD9CF;}.account-action{min-height:44px;padding:10px 12px;font-size:14px;line-height:24px;margin:0;background-color:transparent;color:#245564;border-width:0;}.verification{margin-top:28px;padding:18px;background-color:#EEE9DF;border-radius:8px;}.account-input{height:48px;margin-top:12px;margin-bottom:12px;padding:0 12px;font-size:16px;background-color:#F9F6EF;border-radius:6px;color:#17292D;}.form-error{font-size:13px;line-height:24px;color:#B95543;margin-bottom:12px;}</style>
