<template><view class="page"><PageHead title="个人资料"/><scroll-view class="page-scroll" direction="vertical" :show-scrollbar="false"><view class="content"><ContentState v-if="loading||error" :loading="loading" :error="error" @retry="load"/><template v-if="profile"><view class="avatar-editor"><image v-if="avatar" class="avatar-preview" :src="avatar" mode="aspectFill"/><view v-else class="avatar-preview avatar-empty"><AppIcon name="user" :size="36"/></view><button class="avatar-action" :disabled="saving||uploading" @click="choose">{{uploading?'正在上传…':'更换头像'}}</button><button v-if="avatar" class="avatar-remove" :disabled="saving||uploading" @click="avatarAssetId=null;avatar=''">移除头像</button></view><text class="field-label">昵称</text><input class="nickname-input" v-model="nickname" :disabled="saving" maxlength="30" placeholder="学友怎么称呼你"/><text class="meta">{{nickname.length}} / 30 · 头像与昵称会显示在公开讨论中</text><text v-if="saveError" class="form-error">{{saveError}}</text><button class="primary-button" :disabled="saving||uploading||!nickname.trim()" @click="save">{{saving?'保存中…':'保存资料'}}</button></template></view></scroll-view></view></template>
<script setup lang="ts">
import PageHead from '../../components/PageHead.uvue';import ContentState from '../../components/ContentState.uvue';import AppIcon from '../../components/AppIcon.uvue';import {request,assetUrl} from '../../lib/api';import {currentUser,needLogin} from '../../lib/session';import {uploadHomeworkImage} from '../../lib/teaching';
type Profile={id:string;nickname:string;avatar:string|null;avatarAssetId:string|null;version:number};const profile=ref<Profile|null>(null),nickname=ref(''),avatarAssetId=ref<string|null>(null),avatar=ref(''),loading=ref(false),error=ref(''),saveError=ref(''),saving=ref(false),uploading=ref(false);let owner='';
async function load(){if(loading.value||needLogin())return;loading.value=true;error.value='';try{profile.value=await request<Profile>('/me/profile');nickname.value=profile.value.nickname;avatarAssetId.value=profile.value.avatarAssetId;avatar.value=assetUrl(profile.value.avatar);}catch(e){error.value=(e as Error).message;}finally{loading.value=false;}}
function choose(){if(saving.value||uploading.value)return;uni.chooseImage({count:1,sizeType:['compressed'],success:async data=>{uploading.value=true;saveError.value='';try{const path=data.tempFilePaths[0],asset=await uploadHomeworkImage(path,'/me/profile/avatar');avatarAssetId.value=asset.id;avatar.value=path;}catch(e){saveError.value=(e as Error).message;}finally{uploading.value=false;}}});}
async function save(){if(saving.value||uploading.value||!profile.value||needLogin())return;saving.value=true;saveError.value='';try{const value=await request<Profile>('/me/profile',{method:'PATCH',data:{nickname:nickname.value.trim(),avatarAssetId:avatarAssetId.value,expectedVersion:profile.value.version}});profile.value=value;if(currentUser.value)currentUser.value={...currentUser.value,nickname:value.nickname,avatar:value.avatar};uni.showToast({title:'资料已保存',icon:'none'});uni.navigateBack();}catch(e){saveError.value=(e as Error).message;}finally{saving.value=false;}}
onShow(()=>{const id=currentUser.value?.id??'';if(owner!==id){owner=id;profile.value=null;nickname.value='';avatar.value='';avatarAssetId.value=null;}if(!profile.value)load();});
</script><style>@import '../../styles/app.css';.avatar-editor{align-items:center;padding:28px 0 20px;}.avatar-preview{width:88px;height:88px;border-radius:44px;background-color:#EFE9DC;}.avatar-empty{align-items:center;justify-content:center;}.avatar-action,.avatar-remove{background-color:transparent;border-width:0;font-size:14px;line-height:24px;min-height:44px;padding:10px 20px;color:#235663;margin:8px 0 0;}.avatar-remove{font-size:12px;color:#7C878A;margin:0;}.nickname-input{font-family:AcademySans;min-height:48px;padding:10px 12px;background-color:#EFE9DC;border-radius:6px;font-size:16px;line-height:28px;margin:12px 0;}.form-error{color:#B4533F;font-size:13px;line-height:24px;margin-top:16px;}.primary-button{margin-top:24px;}</style>
