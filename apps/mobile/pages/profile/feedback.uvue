<template><view class="page"><PageHead title="客服与反馈"/><scroll-view class="page-scroll" direction="vertical" :show-scrollbar="false"><view class="content"><text class="intro">使用问题、内容建议，都可以在这里告诉我们。回复会出现在反馈记录与站内消息中。</text><button class="primary-button" @click="begin">写反馈</button><ContentState v-if="loading||error" :loading="loading" :error="error" @retry="retry"/>
<template v-if="detail"><button class="feedback-back" @click="detail=null">‹ 返回反馈记录</button><view class="feedback-card"><text class="tag">{{states[detail!.state]}}</text><text class="body-copy" :user-select="true">{{detail!.body}}</text><text class="meta">{{date(detail!.createdAt)}}</text></view><view v-for="reply in detail!.replies" :key="reply.id" class="feedback-reply"><text class="tag">书院回复</text><text class="body-copy" :user-select="true">{{reply.body}}</text><text class="meta">{{date(reply.createdAt)}}</text></view><ContentState v-if="!detail!.replies.length" title="等待书院回复" description="回复后会收到站内消息。"/></template>
<template v-else><view v-if="support.supportPhone||support.supportEmail" class="feedback-card"><text class="tag">书院客服</text><text v-if="support.supportHours" class="meta">{{support.supportHours}}</text><button v-if="support.supportPhone" class="feedback-contact" @click="callSupport">{{support.supportPhone}} · 拨打电话</button><button v-if="support.supportEmail" class="feedback-contact" @click="copyEmail">{{support.supportEmail}} · 复制邮箱</button></view><text v-if="supportError" class="footer-note">{{supportError}}</text><button v-if="supportError" class="feedback-contact" @click="loadSupport">重新读取联系方式</button><text v-if="!supportError&&!support.supportPhone&&!support.supportEmail" class="meta">书院暂未公布电话与邮箱，可提交站内反馈。</text><view v-for="item in items" :key="item.id" class="feedback-card" @click="open(item.id)"><view class="row between"><text class="tag">{{states[item.state]}}</text><text class="meta">{{date(item.createdAt)}}</text></view><text class="body-copy">{{item.body}}</text><text class="feedback-link">查看回复 ›</text></view><ContentState v-if="currentUser&&!loading&&!error&&!items.length" title="暂无反馈记录" description="提交后可在这里追踪处理情况。"/><button v-if="!currentUser" class="secondary-button" @click="login">登录查看我的反馈</button><button v-if="items.length<total" class="secondary-button" :disabled="loading" @click="load(true)">查看更多反馈</button></template>
</view></scroll-view><ComposeSheet :visible="visible" title="写反馈" subtitle="仅自己与书院客服可见" placeholder="描述你遇到的问题或建议…" v-model="body" :maxlength="5000" :saving="saving" :error="editorError" :disabled="!body.trim()" submitLabel="提交反馈" @close="visible=false" @submit="submit"><button class="feedback-back" @click="chooseKind">{{kinds[kind]}} · 点击选择反馈类型</button></ComposeSheet></view></template>
<script setup lang="ts">
import {formatChinaDate} from '../../lib/date-time';
import PageHead from '../../components/PageHead.uvue';import ContentState from '../../components/ContentState.uvue';import ComposeSheet from '../../components/ComposeSheet.uvue';import {request} from '../../lib/api';import {studyEventId} from '../../lib/learning';import {currentUser,needLogin,sessionGeneration} from '../../lib/session';
const support=ref({supportPhone:'',supportEmail:'',supportHours:''}),supportError=ref('');
function login(){needLogin('/pages/profile/feedback');}
function copyEmail(){if(support.value.supportEmail)uni.setClipboardData({data:support.value.supportEmail});}
async function loadSupport(){supportError.value='';try{support.value=await request<{supportPhone:string;supportEmail:string;supportHours:string}>('/configuration');}catch{supportError.value='暂时无法读取客服联系信息，请重试。';}}
function callSupport(){if(support.value.supportPhone)uni.makePhoneCall({phoneNumber:support.value.supportPhone,fail:()=>uni.showModal({title:'无法打开拨号',content:support.value.supportPhone,confirmText:'复制号码',success:r=>{if(r.confirm)uni.setClipboardData({data:support.value.supportPhone});}})});}
type Reply={id:string;body:string;createdAt:string};type Feedback={id:string;body:string;state:string;createdAt:string;replies:Reply[]};const items=ref<Feedback[]>([]),detail=ref<Feedback|null>(null),total=ref(0),loading=ref(false),error=ref(''),body=ref(''),kind=ref('ISSUE'),visible=ref(false),saving=ref(false),editorError=ref('');let page=1,owner='',requestKey='',sentBody='',sentKind='';
const states:Record<string,string>={OPEN:'待处理',PROCESSING:'处理中',CLOSED:'已结束'},kinds:Record<string,string>={ISSUE:'使用问题',SUGGESTION:'产品建议',CONTENT:'内容问题',OTHER:'其他反馈'};
const date=(value:string)=>formatChinaDate(value);
let failedAppend=false,failedDetail='';
function retry(){if(failedDetail)open(failedDetail);else load(failedAppend);}
async function load(append=false){if(owner!==(currentUser.value?.id??'')){owner=currentUser.value?.id??'';items.value=[];detail.value=null;body.value='';visible.value=false;}if(!currentUser.value||loading.value)return;const generation=sessionGeneration();failedDetail='';failedAppend=append;loading.value=true;error.value='';try{const next=append?page+1:1,result=await request<{items:Feedback[];total:number}>('/me/feedback?page='+next);if(generation!==sessionGeneration())return;items.value=append?[...items.value,...result.items]:result.items;page=next;total.value=result.total;}catch(e){if(generation===sessionGeneration())error.value=(e as Error).message;}finally{if(generation===sessionGeneration())loading.value=false;}}
function begin(){if(!needLogin()){editorError.value='';visible.value=true;}}
function chooseKind(){const values=Object.keys(kinds);uni.showActionSheet({itemList:values.map(k=>kinds[k]),success:r=>{kind.value=values[r.tapIndex];}});}
async function open(id:string){if(loading.value||!currentUser.value)return;const generation=sessionGeneration();failedDetail=id;loading.value=true;error.value='';try{const result=await request<Feedback>('/me/feedback/'+id);if(generation!==sessionGeneration())return;detail.value=result;failedDetail='';}catch(e){if(generation===sessionGeneration())error.value=(e as Error).message;}finally{if(generation===sessionGeneration())loading.value=false;}}
async function submit(){if(saving.value||needLogin())return;saving.value=true;editorError.value='';try{if(!requestKey||sentBody!==body.value.trim()||sentKind!==kind.value){requestKey=studyEventId();sentBody=body.value.trim();sentKind=kind.value;}const row=await request<{id:string}>('/me/feedback',{method:'POST',data:{requestKey,body:sentBody,kind:sentKind}});visible.value=false;body.value='';requestKey='';await load();await open(row.id);}catch(e){editorError.value=(e as Error).message;}finally{saving.value=false;}}
watch(()=>currentUser.value?.id,()=>{items.value=[];detail.value=null;body.value='';visible.value=false;loading.value=false;error.value='';requestKey='';sentBody='';});
onLoad(()=>loadSupport());onShow(()=>{if(!visible.value)load();});
</script><style>@import '../../styles/app.css';.feedback-contact{align-self:flex-start;text-align:left;min-height:44px;padding:10px 0;margin:0;background-color:transparent;border-width:0;color:#245564;font-size:14px;line-height:24px;}.feedback-card{padding:18px 16px;background-color:#FAF8F2;border-radius:8px;margin-top:16px;}.feedback-reply{padding:16px;background-color:#EEE9DF;border-left-width:2px;border-left-style:solid;border-left-color:#C3B79F;margin-top:12px;}.feedback-link{font-size:13px;line-height:24px;color:#245564;margin-top:8px;}.feedback-back{margin:8px 0;min-height:44px;padding:10px 0;background-color:transparent;border-width:0;align-self:flex-start;font-size:14px;line-height:24px;color:#245564;}</style>
