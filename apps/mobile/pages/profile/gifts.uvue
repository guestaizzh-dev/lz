<template>
  <view class="page"
    ><InkBackdrop /><PageHead title="礼物余额" /><scroll-view
      class="page-scroll"
      direction="vertical"
      :show-scrollbar="false"
      ><view class="content">
        <ContentState v-if="loading || error" :loading="loading" :error="error" @retry="load" />
        <view v-if="wallet" class="wallet-summary"
          ><text class="ui-text eyebrow">书香点 · 与免费积分独立</text
          ><text class="ui-text wallet-number"
            >{{ wallet!.balance }}<text class="ui-text wallet-unit"> 书香点</text></text
          ><text class="ui-text meta">价值 {{ money(Number(wallet!.balance)) }} 元 · 不设过期</text
          ><text v-if="wallet!.systemHold" class="ui-text wallet-warning"
            >渠道撤销正在核查，暂不能继续赠礼。请联系客服，原交易与余额记录已保留。</text
          ></view
        >
        <text v-if="notice" class="ui-text footer-note" :user-select="true">{{ notice }}</text>
        <view class="wallet-tabs"
          ><button
            class="ui-button"
            v-for="item in tabs"
            :key="item.key"
            :class="['wallet-tab', tab === item.key ? 'wallet-tab-active' : '']"
            @click="changeTab(item.key)"
            >{{ item.title }}</button
          ></view
        >
        <view v-if="tab === 'topup'"
          ><text class="ui-text section-heading">选择充值金额</text
          ><view class="wallet-packs"
            ><button
              class="ui-button"
              v-for="pack in packs"
              :key="pack.id"
              :class="['wallet-pack', selected?.id === pack.id ? 'wallet-pack-active' : '']"
              :disabled="busy"
              @click="
                selected = pack;
                agreed = false;
              "
              ><text class="ui-text wallet-pack-title">{{ pack.credits }} 书香点</text
              ><text class="ui-text meta">{{ storePrice(pack) }}</text></button
            ></view
          ><ContentState
            v-if="!loading && !packs.length"
            title="暂无可购买的充值包"
            description="书院开放后可在这里购买。未开放时不会收取费用。"
            actionLabel="联系书院客服"
            @action="openPage('profile/feedback')"
          />
          <view v-if="platform === 'ANDROID'" class="wallet-actions"
            ><button
              class="ui-button"
              v-for="channel in channels"
              :key="channel.channel"
              :class="['wallet-button', selectedChannel === channel.channel ? 'wallet-choice' : '']"
              @click="selectedChannel = channel.channel"
              >{{ channel.label }}</button
            ></view
          >
          <text class="ui-text footer-note"
            >100 书香点 = 人民币 1
            元，只可在已开通礼物的直播中赠送。未消费余额可申请原路退款；已经赠礼的部分不支持自助退款。Apple购买的退款由Apple审核。</text
          ><view v-if="selected" class="wallet-consent" @click="agreed = !agreed"
            ><text class="ui-text wallet-check">{{ agreed ? '☑' : '□' }}</text
            ><text class="ui-text wallet-consent-copy"
              >我已了解所选金额、余额用途与退款规则</text
            ></view
          ><button
            v-if="packs.length"
            class="ui-button primary-button"
            :disabled="busy || !enabled || !selected || !agreed || !selectedReady"
            @click="buy"
            >{{ busy ? '处理中…' : enabled ? '确认购买' : '购买暂未开放' }}</button
          ><text v-if="!enabled" class="ui-text footer-note">{{ unavailable }}</text
          ><button
            v-if="platform === 'IOS'"
            class="ui-button secondary-button"
            :disabled="busy"
            @click="restore"
            >恢复未完成的Apple交易</button
          ><text v-if="platform === 'IOS'" class="ui-text footer-note"
            >不要重复购买。已完成的余额由书院账号保存，重新登录原账号即可查看。</text
          ></view
        >
        <view v-else-if="tab === 'ledger'"
          ><ContentState
            v-if="wallet && !wallet!.items.length"
            title="暂无余额记录"
            description="充值、赠礼及退款都会在这里留存。"
            actionLabel="去充值"
            @action="changeTab('topup')"
          /><view v-for="row in wallet?.items ?? []" :key="row.id" class="wallet-row"
            ><view class="wallet-row-head"
              ><text class="ui-text wallet-row-title">{{ giftLedgerLabel(row.kind) }}</text
              ><text
                class="ui-text"
                :class="Number(row.delta) > 0 ? 'wallet-credit' : 'wallet-debit'"
                >{{ Number(row.delta) > 0 ? '+' : '' }}{{ row.delta }}</text
              ></view
            ><text class="ui-text meta"
              >{{ formatChinaTime(row.createdAt) }} · 余额 {{ row.balanceAfter }}</text
            ><text v-if="row.snapshot?.title" class="ui-text meta">{{
              row.snapshot?.title ?? ''
            }}</text></view
          ><view class="wallet-actions"
            ><button
              class="ui-button wallet-button"
              :disabled="busy || page <= 1"
              @click="
                page--;
                loadLedger();
              "
              >上一页</button
            ><text class="ui-text meta">第 {{ page }} 页</text
            ><button
              class="ui-button wallet-button"
              :disabled="busy || page * 20 >= (wallet?.total ?? 0)"
              @click="
                page++;
                loadLedger();
              "
              >下一页</button
            ></view
          ></view
        >
        <view v-else
          ><ContentState
            v-if="!orders.length && !loading"
            title="暂无充值订单"
            description="购买后可在这里核对支付、未消费余额与退款。"
            actionLabel="联系书院客服"
            @action="openPage('profile/feedback')"
          /><view v-for="order in orders" :key="order.id" class="wallet-row"
            ><view class="wallet-row-head"
              ><text class="ui-text wallet-row-title">{{ order.pack.title }}</text
              ><text class="ui-text wallet-state">{{ giftState(order.state) }}</text></view
            ><text class="ui-text meta"
              >{{ money(Number(order.amount)) }} 元 · {{ order.pack.credits }} 书香点</text
            ><text class="ui-text meta" :user-select="true">{{ order.orderNo }}</text
            ><text class="ui-text meta"
              >{{ formatChinaTime(order.createdAt) }} ·
              {{ paymentChannelLabel(order.channel) }}</text
            ><text v-if="Number(order.refundedAmount) > 0" class="ui-text meta"
              >已退款 {{ money(Number(order.refundedAmount)) }} 元</text
            ><text
              v-if="Number(order.refundableCredits) > 0 && order.state === 'COMPLETED'"
              class="ui-text meta"
              >本笔未消费余额 {{ order.refundableCredits }} 书香点</text
            ><view v-for="refund in order.refunds" :key="refund.id" class="wallet-refund"
              ><text class="ui-text meta"
                >{{ giftState(refund.state) }} · {{ money(Number(refund.amount)) }} 元</text
              ><text v-if="refund.reviewNote" class="ui-text meta"
                >书院回复：{{ refund.reviewNote }}</text
              ></view
            ><view class="wallet-actions"
              ><button
                v-if="order.state === 'PENDING'"
                class="ui-button wallet-button"
                :disabled="busy"
                @click="refreshOrder(order)"
                >查询支付</button
              ><button
                v-if="order.canPay && clientSupports(order.channel)"
                class="ui-button wallet-button"
                :disabled="busy"
                @click="pay(order)"
                >继续支付</button
              ><button
                v-if="order.state === 'PENDING' && order.channel !== 'APPLE_IAP'"
                class="ui-button wallet-button"
                :disabled="busy"
                @click="cancel(order)"
                >取消订单</button
              ><button
                v-if="order.canRefund"
                class="ui-button wallet-button"
                :disabled="busy"
                @click="
                  refundTarget = order;
                  refundReason = '';
                  refundError = '';
                "
                >退回未消费余额</button
              ><button
                v-if="order.channel === 'APPLE_IAP'"
                class="ui-button wallet-button"
                @click="appleRefund"
                >Apple退款说明</button
              ></view
            ></view
          ><view class="wallet-actions"
            ><button
              class="ui-button wallet-button"
              :disabled="busy || orderPage <= 1"
              @click="
                orderPage--;
                loadOrders();
              "
              >上一页</button
            ><text class="ui-text meta">第 {{ orderPage }} 页</text
            ><button
              class="ui-button wallet-button"
              :disabled="busy || orderPage * 20 >= orderTotal"
              @click="
                orderPage++;
                loadOrders();
              "
              >下一页</button
            ></view
          ></view
        >
        <button class="ui-button secondary-button" @click="openPage('profile/feedback')"
          >联系书院客服</button
        >
      </view></scroll-view
    ><ComposeSheet
      :visible="refundTarget !== null"
      title="退回未消费余额"
      :subtitle="
        '本笔未消费余额 ' +
        (refundTarget?.refundableCredits ?? '0') +
        ' 书香点，提交后先冻结余额，审核后原路退款。'
      "
      v-model="refundReason"
      placeholder="请填写退款原因，便于书院处理"
      :maxlength="500"
      :saving="busy"
      :disabled="refundReason.trim().length < 2"
      :error="refundError"
      submitLabel="提交退款"
      @close="refundTarget = null"
      @submit="requestRefund"
  /></view>
</template>
<script setup lang="ts">
import InkBackdrop from '../../components/InkBackdrop.uvue';
import PageHead from '../../components/PageHead.uvue';
import ContentState from '../../components/ContentState.uvue';
import ComposeSheet from '../../components/ComposeSheet.uvue';
import { request, money } from '../../lib/api';
import { needLogin, currentUser } from '../../lib/session';
import { purchasePlatform, paymentChannelLabel } from '../../lib/course-sales';
import { courseWechatAppId, courseAlipayAppId } from '../../lib/payment-config';
import { studyEventId } from '../../lib/learning';
import { openPage } from '../../lib/presentation';
import { formatChinaTime } from '../../lib/date-time';
import { giftState, giftLedgerLabel } from '../../lib/gifts';
import type { GiftPack, GiftOrder } from '../../lib/gifts';
import { buyAppleGift, restoreAppleGifts, appleGiftProducts } from '../../lib/apple-gifts';
type GiftSnapshot = { title?: string };
type WalletEntry = {
  id: string;
  delta: string;
  kind: string;
  balanceAfter: string;
  createdAt: string;
  snapshot?: GiftSnapshot;
};
type Wallet = { balance: string; systemHold: boolean; items: WalletEntry[]; total: number };
type Channel = { channel: string; label: string; enabled: boolean };
const platform = purchasePlatform(),
  tab = ref('topup'),
  tabs = [
    { key: 'topup', title: '充值' },
    { key: 'ledger', title: '余额明细' },
    { key: 'orders', title: '订单与退款' },
  ],
  wallet = ref<Wallet | null>(null),
  packs = ref<GiftPack[]>([]),
  selected = ref<GiftPack | null>(null),
  orders = ref<GiftOrder[]>([]),
  orderTotal = ref(0),
  channels = ref<Channel[]>([]),
  selectedChannel = ref(''),
  enabled = ref(false),
  loading = ref(false),
  error = ref(''),
  notice = ref(''),
  unavailable = ref(''),
  agreed = ref(false),
  busy = ref(false),
  page = ref(1),
  orderPage = ref(1),
  refundTarget = ref<GiftOrder | null>(null),
  refundReason = ref(''),
  refundError = ref(''),
  storeProducts = ref<{ id: string; displayPrice: string; priceMinor: string; currency: string }[]>(
    [],
  );
let owner = '',
  requestKey = studyEventId(),
  refundKey = studyEventId();
function clientSupports(channel: string) {
  return (
    platform === 'ANDROID' &&
    (channel === 'WECHAT_APP'
      ? !!courseWechatAppId
      : channel === 'ALIPAY_APP'
        ? !!courseAlipayAppId
        : false)
  );
}
const selectedReady = computed(() =>
  platform === 'IOS'
    ? !!selected.value?.mapping &&
      storeProducts.value.some(
        (p) =>
          p.id === selected.value?.mapping?.productId &&
          p.currency === 'CNY' &&
          p.priceMinor === selected.value?.price,
      )
    : clientSupports(selectedChannel.value),
);
function storePrice(pack: GiftPack) {
  return platform === 'IOS'
    ? (storeProducts.value.find((p) => p.id === pack.mapping?.productId)?.displayPrice ??
        '商店价格待核对')
    : money(Number(pack.price)) + ' 元';
}
async function loadLedger() {
  try {
    wallet.value = await request<Wallet>('/gifts/wallet?page=' + page.value);
  } catch (e) {
    error.value = (e as Error).message;
  }
}
async function loadOrders() {
  try {
    const result = await request<{ items: GiftOrder[]; total: number }>(
      '/gifts/orders?page=' + orderPage.value,
    );
    orders.value = result.items;
    orderTotal.value = result.total;
  } catch (e) {
    error.value = (e as Error).message;
  }
}
async function load() {
  if (needLogin('/pages/profile/gifts')) return;
  loading.value = true;
  error.value = '';
  try {
    await loadLedger();
    const data = await request<{
      items: GiftPack[];
      enabled: boolean;
      reason: string;
      channels?: Channel[];
    }>('/gifts/packs?platform=' + platform);
    packs.value = data.items;
    enabled.value = data.enabled;
    unavailable.value = data.reason;
    channels.value = (data.channels ?? []).filter((c) => c.enabled && clientSupports(c.channel));
    selectedChannel.value = channels.value.some((c) => c.channel === selectedChannel.value)
      ? selectedChannel.value
      : (channels.value[0]?.channel ?? '');
    selected.value = data.items.find((p) => p.id === selected.value?.id) ?? data.items[0] ?? null;
    agreed.value = false;
    if (platform === 'IOS' && data.enabled && data.items.length)
      try {
        storeProducts.value = await appleGiftProducts(
          data.items.flatMap((p) => (p.mapping ? [p.mapping.productId] : [])),
        );
      } catch (e) {
        notice.value = (e as Error).message;
      }
    if (tab.value === 'orders') await loadOrders();
  } catch (e) {
    error.value = (e as Error).message;
  } finally {
    loading.value = false;
  }
}
function changeTab(next: string) {
  tab.value = next;
  error.value = '';
  if (next === 'orders') void loadOrders();
  else if (next === 'ledger') void loadLedger();
}
async function pay(order: GiftOrder) {
  if (busy.value) return;
  busy.value = true;
  notice.value = '';
  try {
    await performPayment(order);
  } catch (e) {
    notice.value = (e as Error).message;
  } finally {
    await loadOrders();
    await loadLedger();
    busy.value = false;
  }
}
async function performPayment(order: GiftOrder) {
  if (!clientSupports(order.channel)) throw Error('当前App未配置此支付方式');
  const payment = await request<{ provider: 'wxpay' | 'alipay'; orderInfo: string }>(
    '/gifts/orders/' + order.id + '/payment',
    { method: 'POST' },
  );
  if (payment.provider === 'wxpay') {
    if (
      order.channel !== 'WECHAT_APP' ||
      (JSON.parse(payment.orderInfo) as { appid?: string } | null)?.appid !== courseWechatAppId
    )
      throw Error('微信收款配置与当前App不一致');
  } else if (payment.provider === 'alipay') {
    if (
      order.channel !== 'ALIPAY_APP' ||
      payment.orderInfo.match(/(?:^|&)app_id=(\d+)(?:&|$)/)?.[1] !== courseAlipayAppId
    )
      throw Error('支付宝收款配置与当前App不一致');
  } else throw Error('收款方式不受支持');
  // #ifdef APP-ANDROID
  await new Promise<void>((resolve) =>
    uni.requestPayment({
      provider: payment.provider,
      orderInfo: payment.orderInfo,
      success: () => resolve(),
      fail: () => {
        notice.value = '付款结果待核对，请查询订单，勿重复付款';
        resolve();
      },
    }),
  );
  // #endif
  const result = await request<GiftOrder>('/gifts/orders/' + order.id + '/refresh', {
    method: 'POST',
  });
  if (result.state === 'COMPLETED') notice.value = '收款已确认，书香点已入账';
  else if (!notice.value) notice.value = '付款结果待确认，请稍后查询订单';
}
async function buy() {
  if (busy.value || !selected.value || !agreed.value || !enabled.value || !selectedReady.value)
    return;
  busy.value = true;
  notice.value = '';
  try {
    if (platform === 'IOS') {
      notice.value = await buyAppleGift(selected.value.mapping!, selected.value.quoteHash);
    } else {
      const order = await request<GiftOrder>('/gifts/orders', {
        method: 'POST',
        data: {
          packId: selected.value.id,
          requestKey,
          quoteHash: selected.value.quoteHash,
          platform,
          channel: selectedChannel.value,
          accepted: true,
        },
      });
      requestKey = studyEventId();
      tab.value = 'orders';
      await performPayment(order);
    }
    await loadLedger();
    await loadOrders();
  } catch (e) {
    notice.value = (e as Error).message;
    tab.value = 'orders';
    await loadOrders();
  } finally {
    busy.value = false;
    agreed.value = false;
  }
}
async function restore() {
  if (busy.value) return;
  busy.value = true;
  try {
    notice.value = await restoreAppleGifts();
    await loadLedger();
    await loadOrders();
  } catch (e) {
    notice.value = (e as Error).message;
  } finally {
    busy.value = false;
  }
}
async function refreshOrder(order: GiftOrder) {
  if (busy.value) return;
  busy.value = true;
  try {
    await request('/gifts/orders/' + order.id + '/refresh', { method: 'POST' });
    notice.value = '已查询最新支付及退款状态';
    await loadOrders();
    await loadLedger();
  } catch (e) {
    notice.value = (e as Error).message;
  } finally {
    busy.value = false;
  }
}
function cancel(order: GiftOrder) {
  uni.showModal({
    title: '取消充值订单？',
    content: '系统会先核对是否已经付款，已付款订单不会直接取消。',
    success: async (r) => {
      if (!r.confirm || busy.value) return;
      busy.value = true;
      try {
        await request('/gifts/orders/' + order.id + '/cancel', { method: 'POST' });
        await loadOrders();
      } catch (e) {
        notice.value = (e as Error).message;
      } finally {
        busy.value = false;
      }
    },
  });
}
async function requestRefund() {
  if (!refundTarget.value || busy.value) return;
  busy.value = true;
  refundError.value = '';
  try {
    await request('/gifts/orders/' + refundTarget.value.id + '/refund', {
      method: 'POST',
      data: { requestKey: refundKey, reason: refundReason.value },
    });
    refundKey = studyEventId();
    refundTarget.value = null;
    await loadLedger();
    await loadOrders();
    notice.value = '退款申请已提交，未消费余额已冻结，审核进度可在原订单查看';
  } catch (e) {
    refundError.value = (e as Error).message;
  } finally {
    busy.value = false;
  }
}
function appleRefund() {
  uni.showModal({
    title: 'Apple购买退款',
    content:
      'Apple交易由Apple审核退款，书院不能代为批准。前往 reportaproblem.apple.com，使用购买时的Apple账号申请。',
    confirmText: '复制网址',
    success: (r) => {
      if (r.confirm) uni.setClipboardData({ data: 'https://reportaproblem.apple.com/' });
    },
  });
}
onLoad((o) => {
  if (o?.orderId) tab.value = 'orders';
});
onShow(() => {
  if (owner !== currentUser.value?.id) {
    wallet.value = null;
    orders.value = [];
    notice.value = '';
    refundTarget.value = null;
    owner = currentUser.value?.id ?? '';
  }
  void load();
});
</script>
<style>
@import '../../styles/app.css';
.wallet-summary {
  padding: 16px 0 24px;
}
.wallet-number {
  font-family: AcademySerif;
  font-size: 26px;
  line-height: 36px;
  color: #182b31;
}
.wallet-unit {
  font-family: sans-serif;
  font-size: 12px;
  line-height: 20px;
  color: #5c6869;
}
.wallet-warning {
  font-size: 13px;
  line-height: 22px;
  color: #b4533f;
  margin-top: 8px;
}
.wallet-tabs {
  flex-direction: row;
  margin-bottom: 16px;
}
.wallet-tab {
  flex: 1;
  background-color: transparent;
  font-size: 15px;
  line-height: 22px;
  color: #5c6869;
  margin: 0;
  padding: 12px 0;
  min-height: 48px;
  border-width: 0;
  border-radius: 0;
}
.wallet-tab-active {
  color: #182b31;
  font-weight: 600;
  border-bottom-width: 2px;
  border-bottom-style: solid;
  border-bottom-color: #235663;
}
.wallet-packs {
  flex-direction: row;
  flex-wrap: wrap;
  margin-top: 16px;
}
.wallet-pack {
  width: 48%;
  padding: 16px 12px;
  margin: 0 4% 8px 0;
  background-color: #fcf9f2;
  border-style: solid;
  border-width: 1px;
  border-color: #cfc5b1;
  border-radius: 14px;
  align-items: center;
}
.wallet-pack-active {
  background-color: #e6ede9;
  border-color: #235663;
}
.wallet-pack-title {
  font-family: AcademySerif;
  font-size: 16px;
  line-height: 24px;
  color: #182b31;
}
.wallet-actions {
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  margin-top: 12px;
}
.wallet-button {
  margin: 0 8px 8px 0;
  padding: 11px 14px;
  min-height: 44px;
  font-size: 13px;
  line-height: 22px;
  color: #235663;
  background-color: transparent;
  border-style: solid;
  border-width: 1px;
  border-color: #c9bfad;
  border-radius: 22px;
}
.wallet-choice {
  border-color: #235663;
  background-color: #e6ede9;
}
.wallet-consent {
  flex-direction: row;
  align-items: flex-start;
  margin: 12px 0;
  min-height: 44px;
}
.wallet-check {
  font-size: 19px;
  line-height: 28px;
  color: #235663;
  margin-right: 8px;
}
.wallet-consent-copy {
  flex: 1;
  font-size: 13px;
  line-height: 22px;
  color: #344c54;
}
.wallet-row {
  padding: 15px 0;
