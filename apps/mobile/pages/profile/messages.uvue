<template>
  <view class="page"
    ><InkBackdrop /><PageHead title="书院消息" /><scroll-view
      class="page-scroll"
      direction="vertical"
      :show-scrollbar="false"
      ><view class="content"
        ><view class="message-toolbar"
          ><text class="ui-text toolbar-copy">{{
            unread > 0 ? unread + ' 条未读消息' : '课程动态与书院通知，都会留在这里。'
          }}</text
          ><button
            v-if="unread > 0"
            class="ui-button toolbar-link"
            :class="reading ? 'toolbar-link-off' : ''"
            @click="confirmReadAll"
            >全部已读</button
          ><button
            class="ui-button toolbar-link"
            @click="uni.navigateTo({ url: '/pages/profile/settings' })"
            >通知设置</button
          ></view
        ><ContentState
          v-if="loading || error"
          :loading="loading"
          :error="error"
          @retry="load(failedAppend)"
        /><ContentState
          v-if="!loading && !error && !items.length"
          title="暂无新消息"
          description="课程点评与书院通知，将在这里与你相见。"
          actionLabel="去设置通知"
          @action="uni.navigateTo({ url: '/pages/profile/settings' })"
        /><view v-for="item in items" :key="item.id" class="message-row"
          ><view class="row between"
            ><text class="ui-text item-title grow">{{ item.title }}</text
            ><text
              class="ui-text"
              :class="['message-state', !item.readAt ? 'message-unread' : '']"
              >{{ item.readAt ? '已读' : '未读' }}</text
            ></view
          ><text class="ui-text message-copy" :user-select="true">{{ item.body }}</text
          ><text class="ui-text message-time">{{ formatChinaTime(item.createdAt) }}</text
          ><button
            class="ui-button message-open"
            :disabled="opening === item.id"
            @click="open(item)"
            >{{
              opening === item.id
                ? '正在打开…'
                : item.target
                  ? item.target.label + ' ›'
                  : item.readAt
                    ? '消息已读'
                    : '标记已读'
            }}</button
          ></view
        ><button
          v-if="items.length < total && !loading"
          class="ui-button secondary-button"
          @click="load(true)"
          >查看更多消息</button
        ></view
      ></scroll-view
    ></view
  >
</template>
<script setup lang="ts">
import InkBackdrop from '../../components/InkBackdrop.uvue';
import { pageRefresh } from '../../lib/page-refresh';
import { formatChinaTime } from '../../lib/date-time';
import PageHead from '../../components/PageHead.uvue';
import ContentState from '../../components/ContentState.uvue';
import { request } from '../../lib/api';
import { currentUser, needLogin, sessionGeneration } from '../../lib/session';
import { openNotification } from '../../lib/notifications';
import type { Message } from '../../lib/teaching';
const items = ref<Message[]>([]),
  loading = ref(false),
  error = ref(''),
  unread = ref(0),
  total = ref(0),
  reading = ref(false),
  opening = ref('');
let page = 1,
  owner = '',
  sequence = 0,
  failedAppend = false;
function reset() {
  sequence++;
  items.value = [];
  unread.value = 0;
  total.value = 0;
  loading.value = false;
  reading.value = false;
  opening.value = '';
  page = 1;
  error.value = '';
}
watch(
  () => currentUser.value?.id,
  () => {
    owner = currentUser.value?.id ?? '';
    reset();
  },
);
async function load(append = false) {
  if (owner !== (currentUser.value?.id ?? '')) {
    owner = currentUser.value?.id ?? '';
    reset();
  }
  if (loading.value || needLogin('/pages/profile/messages')) return;
  const seq = ++sequence,
    generation = sessionGeneration();
  failedAppend = append;
  loading.value = true;
  error.value = '';
  try {
    const next = append ? page + 1 : 1,
      result = await request<{ items: Message[]; total: number; unread: number }>(
        '/me/messages?page=' + next + '&size=20',
      );
    if (seq !== sequence || generation !== sessionGeneration()) return;
    items.value = append
      ? [
          ...items.value,
          ...result.items.filter((row) => !items.value.some((old) => old.id === row.id)),
        ]
      : result.items;
    unread.value = result.unread;
    total.value = result.total;
    page = next;
  } catch (e) {
    if (seq === sequence && generation === sessionGeneration()) error.value = (e as Error).message;
  } finally {
    if (seq === sequence) loading.value = false;
  }
}
async function open(item: Message) {
  if (opening.value) return;
  opening.value = item.id;
  const generation = sessionGeneration();
  try {
    await openNotification(item.id);
    if (generation !== sessionGeneration()) return;
    if (!item.readAt) {
      item.readAt = new Date().toISOString();
      unread.value = Math.max(0, unread.value - 1);
    }
  } catch (e) {
    if (generation === sessionGeneration())
      uni.showToast({ title: (e as Error).message, icon: 'none' });
  } finally {
    if (generation === sessionGeneration()) opening.value = '';
  }
}
function confirmReadAll() {
  if (!unread.value || reading.value) return;
  uni.showModal({
    title: '全部标为已读？',
    content: '未读消息会标记为已读，内容仍保留在列表中。',
    confirmText: '标为已读',
    success: (r) => {
      if (r.confirm) void readAll();
    },
  });
}
async function readAll() {
  if (reading.value || !unread.value) return;
  reading.value = true;
  const generation = sessionGeneration();
  try {
    await request('/me/messages/read-all', { method: 'POST' });
    if (generation !== sessionGeneration()) return;
    items.value = items.value.map((item) => ({
      ...item,
      readAt: item.readAt ?? new Date().toISOString(),
    }));
    unread.value = 0;
  } catch (e) {
    if (generation === sessionGeneration()) error.value = (e as Error).message;
  } finally {
    if (generation === sessionGeneration()) reading.value = false;
  }
}
onLoad((options) => {
  if (options?.id)
    void openNotification(options.id).catch((e) =>
      uni.showToast({ title: (e as Error).message, icon: 'none' }),
    );
});
onShow(() => refreshPage());

const refreshPage = pageRefresh(
  async () => {
    await load();
  },
  () => !error.value && !loading.value,
  15000,
);
</script>
<style>
@import '../../styles/app.css';
.message-toolbar {
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  padding: 16px 0 8px;
  border-bottom-style: solid;
  border-bottom-width: 1px;
  border-bottom-color: #e0d8c8;
}
.toolbar-copy {
  flex: 1;
  min-width: 0;
  font-size: 13px;
  line-height: 22px;
  color: #5c6869;
  padding-right: 12px;
}
.toolbar-link {
  min-height: 44px;
  padding: 11px 8px;
  margin: 0;
  background-color: transparent;
  border-width: 0;
  color: #235663;
  font-size: 13px;
  line-height: 22px;
}
.toolbar-link-off {
  color: #6f6a5f;
}
.message-row {
  padding: 16px 0;
  border-bottom-width: 1px;
  border-bottom-style: solid;
  border-bottom-color: #e0d8c8;
}
.message-copy {
  margin-top: 6px;
  font-size: 15px;
  line-height: 26px;
  color: #344c54;
}
.message-time {
  margin-top: 4px;
  font-size: 12px;
  line-height: 20px;
  color: #5c6869;
}
.message-open {
  align-self: flex-start;
  min-height: 44px;
  margin: 4px 0 0;
  padding: 11px 0;
  line-height: 22px;
  font-size: 13px;
  color: #235663;
  background-color: transparent;
  border-width: 0;
}
.message-state {
  font-size: 12px;
  line-height: 20px;
  color: #7a847f;
  margin-left: 12px;
}
.message-unread {
  color: #235663;
  font-weight: 600;
}
</style>
