<template><view class="page"><PageHead title="书院消息"/><scroll-view class="page-scroll" direction="vertical" :show-scrollbar="false"><view class="content"><text class="page-title">书院来信</text><text class="meta">{{unread}} 条未读消息</text><ContentState v-if="loading||error" :loading="loading" :error="error" @retry="load()"/><ContentState v-if="!loading&&!error&&!items.length" title="暂无新消息" description="课程点评与书院通知，将在这里与你相见。"/><view v-for="item in items" :key="item.id" class="message-row" @click="open(item)"><view class="row between"><text class="item-title grow">{{item.title}}</text><text class="tag">{{item.readAt?'已读':'未读'}}</text></view><text class="body-copy">{{item.body}}</text><text class="meta">{{new Date(item.createdAt).toLocaleString('zh-CN')}}</text><text v-if="item.kind==='ASSIGNMENT_REVIEW'&&item.resourceId" class="message-link">查看课程作业 ›</text></view><button v-if="items.length<total&&!loading" class="secondary-button" @click="load(true)">查看更多消息</button></view></scroll-view></view></template>
<script setup lang="ts">
import PageHead from '../../components/PageHead.uvue';import ContentState from '../../components/ContentState.uvue';import {request} from '../../lib/api';import {needLogin} from '../../lib/session';import {openPage} from '../../lib/presentation';import type {Message} from '../../lib/teaching';
const items=ref<Message[]>([]),loading=ref(false),error=ref(''),unread=ref(0),total=ref(0);let page=1;
async function load(append=false){if(loading.value||needLogin())return;loading.value=true;error.value='';try{const next=append?page+1:1;const result=await request<{items:Message[];total:number;unread:number}>('/me/messages?page='+next+'&size=20');items.value=append?[...items.value,...result.items]:result.items;unread.value=result.unread;total.value=result.total;page=next;}catch(e){error.value=(e as Error).message;}finally{loading.value=false;}}
async function open(item:Message){try{await request('/me/messages/'+item.id+'/read',{method:'POST'});if(!item.readAt){item.readAt=new Date().toISOString();unread.value=Math.max(0,unread.value-1);}if(item.kind==='ASSIGNMENT_REVIEW'&&item.resourceId)openPage('course/practice?id='+item.resourceId);}catch(e){uni.showToast({title:(e as Error).message,icon:'none'});}}
onShow(()=>load());
</script><style>@import '../../styles/app.css';.message-row{padding:24px 0;border-bottom-width:1px;border-bottom-color:#D8D4CA;}.message-link{font-size:13px;line-height:24px;color:#245564;margin-top:8px;}</style>
