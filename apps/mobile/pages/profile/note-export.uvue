<template>
  <view class="page"
    ><InkBackdrop /><PageHead title="整理导出" /><scroll-view
      class="page-scroll"
      direction="vertical"
      :show-scrollbar="false"
      ><view class="content">
        <text class="ui-text intro export-intro"
          >将自己的笔记、划线与收藏整理为 Markdown 文件，可用常见笔记软件打开。</text
        >
        <view class="section"
          ><text class="ui-text section-heading">导出内容</text
          ><button class="ui-button export-option" :disabled="busy" @click="chooseScope"
            ><text class="ui-text body-copy">{{ scopeLabels[scope] }}</text
            ><text class="ui-text meta">选择 ›</text></button
          ><view v-if="articleId" class="export-source"
            ><text class="ui-text body-copy grow">仅这篇文章 · {{ articleTitle }}</text
            ><button class="ui-button small-action" :disabled="busy" @click="articleId = ''"
              >改为全部文章</button
            ></view
          ><input
            class="ui-input export-search"
            v-model="keyword"
            maxlength="80"
            :disabled="busy"
            placeholder="按标题、笔记或引用中的文字筛选"
        /></view>
        <view class="section"
          ><text class="ui-text section-heading">记录日期</text
          ><text class="ui-text meta">按北京时间筛选，包含所选的开始与结束当天。</text
          ><view class="export-dates"
            ><picker
              class="grow"
              mode="date"
              :value="fromDay || today"
              :end="toDay || today"
              :disabled="busy"
              @change="fromDay = $event.detail.value"
              ><view class="export-date"
                ><text class="ui-text body-copy">{{ fromDay || '开始日期 · 不限' }}</text></view
              ></picker
            ><text class="ui-text meta export-range">至</text
            ><picker
              class="grow"
              mode="date"
              :value="toDay || today"
              :start="fromDay || '1900-01-01'"
              :end="today"
              :disabled="busy"
              @change="toDay = $event.detail.value"
              ><view class="export-date"
                ><text class="ui-text body-copy">{{ toDay || '结束日期 · 不限' }}</text></view
              ></picker
            ></view
          ><button
            v-if="fromDay || toDay"
            class="ui-button small-action"
            :disabled="busy"
            @click="
              fromDay = '';
              toDay = '';
            "
            >清除日期限制</button
          ></view
        >
        <view class="section"
          ><text class="ui-text section-heading">整理方式</text
          ><button class="ui-button export-option" :disabled="busy" @click="chooseSort"
            ><text class="ui-text body-copy">{{ sortLabels[sort] }}</text
            ><text class="ui-text meta">选择 ›</text></button
          ></view
        >
        <text class="ui-text intro"
          >仅导出当前账号的私人记录；收藏只包含标题与简介，不附带文章全文。已下架原文保留你的笔记引用；收藏只保留“内容已下架”提示。</text
        ><text class="ui-text meta export-privacy"
          >文件包含私人内容，请自行选择保存位置。分享给他人后，书院无法撤回对方已保存的副本。</text
        >
        <view v-if="error || notice" class="export-result"
          ><text class="ui-text result-title">整理结果</text
          ><text v-if="error" class="ui-text form-error">{{ error }}</text
          ><text v-if="notice" class="ui-text export-notice">{{ notice }}</text
          ><text v-if="counts" class="ui-text export-counts">{{ counts }}</text></view
        ><button class="ui-button primary-button export-submit" :disabled="busy" @click="run">{{
          busy ? '正在整理…' : '导出 Markdown'
        }}</button>
      </view></scroll-view
    ></view
  >
</template>
<script setup lang="ts">
import InkBackdrop from '../../components/InkBackdrop.uvue';
import PageHead from '../../components/PageHead.uvue';
import { chinaDay } from '../../lib/date-time';
import { needLogin, currentUser } from '../../lib/session';
import { exportNotes } from '../../lib/note-export';
import type { NoteExportOptions } from '../../lib/note-export';
const scope = ref<NonNullable<NoteExportOptions['scope']>>('all'),
  sort = ref<NonNullable<NoteExportOptions['sort']>>('article'),
  fromDay = ref(''),
  toDay = ref(''),
  keyword = ref(''),
  articleId = ref(''),
  articleTitle = ref(''),
  busy = ref(false),
  error = ref(''),
  notice = ref(''),
  counts = ref(''),
  today = chinaDay();
const scopeLabels = {
    all: '笔记、划线与收藏',
    notes: '有心得的笔记',
    highlights: '所有划线标注',
    favorites: '仅收藏',
  },
  sortLabels = { article: '按文章归集', newest: '最新记录在前', oldest: '最早记录在前' };
function chooseScope() {
  uni.showActionSheet({
    itemList: ['笔记、划线与收藏', '有心得的笔记', '所有划线标注', '仅收藏'],
    success: (r) => {
      scope.value = ['all', 'notes', 'highlights', 'favorites'][r.tapIndex] as NonNullable<
        NoteExportOptions['scope']
      >;
      notice.value = '';
    },
  });
}
function chooseSort() {
  uni.showActionSheet({
    itemList: ['按文章归集', '最新记录在前', '最早记录在前'],
    success: (r) => {
      sort.value = ['article', 'newest', 'oldest'][r.tapIndex] as NonNullable<
        NoteExportOptions['sort']
      >;
      notice.value = '';
    },
  });
}
async function run() {
  if (busy.value || needLogin()) return;
  error.value = '';
  notice.value = '';
  counts.value = '';
  if (fromDay.value && toDay.value && fromDay.value > toDay.value) {
    error.value = '开始日期不能晚于结束日期';
    return;
  }
  busy.value = true;
  try {
    const result = await exportNotes({
      scope: scope.value,
      sort: sort.value,
      fromDay: fromDay.value,
      toDay: toDay.value,
      q: keyword.value.trim(),
      articleId: articleId.value,
    });
    if (result.state === 'empty') notice.value = '所选范围暂无记录，请调整筛选。';
    else if (result.state === 'cancelled') notice.value = '已取消分享，你的私人记录未受影响。';
    else {
      notice.value =
        (result.state === 'downloaded'
          ? '已提交浏览器下载：'
          : '已打开系统文件分享，请在接收应用中确认保存：') + result.filename;
      counts.value = result.counts.notes + ' 条笔记及标注 · ' + result.counts.favorites + ' 条收藏';
    }
  } catch (e) {
    error.value = (e as Error).message;
  } finally {
    busy.value = false;
  }
}
watch(
  () => currentUser.value?.id,
  () => {
    articleId.value = '';
    articleTitle.value = '';
    keyword.value = '';
    fromDay.value = '';
    toDay.value = '';
    notice.value = '';
    counts.value = '';
  },
);
onLoad((o) => {
  const sourceId = o?.articleId ?? '',
    sourceTitle = o?.title ?? '所选文章',
    sourceScope = o?.scope ?? '';
  if (/^[a-f0-9-]{36}$/i.test(sourceId)) {
    articleId.value = sourceId;
    articleTitle.value = sourceTitle.slice(0, 120);
  }
  if (['notes', 'highlights', 'favorites'].includes(sourceScope))
    scope.value = sourceScope as NonNullable<NoteExportOptions['scope']>;
});
</script>
<style>
@import '../../styles/app.css';
.export-option {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  min-height: 52px;
  background-color: transparent;
  border-width: 0;
  border-bottom-width: 1px;
  border-bottom-style: solid;
  border-bottom-color: #e0d8c8;
  border-radius: 0;
  padding: 14px 0;
  margin: 0;
}
.export-source {
  flex-direction: row;
  align-items: center;
  padding: 12px 0;
}
.export-search {
  height: 46px;
  min-height: 46px;
  padding: 0 12px;
  background-color: #fcf9f2;
  border-style: solid;
  border-width: 1px;
  border-color: #cfc5b1;
  border-radius: 10px;
  color: #182b31;
  font-size: 15px;
  line-height: 22px;
  margin-top: 12px;
}
.export-dates {
  flex-direction: row;
  align-items: center;
  margin-top: 12px;
}
.export-date {
  width: 100%;
  height: 46px;
  min-height: 46px;
  padding: 0 12px;
  justify-content: center;
  background-color: #fcf9f2;
  border-style: solid;
  border-width: 1px;
  border-color: #cfc5b1;
  border-radius: 10px;
}
.small-action {
  min-height: 44px;
  padding: 11px 0;
  margin: 8px 0;
  background-color: transparent;
  border-width: 0;
  color: #235663;
  font-size: 13px;
  line-height: 22px;
  align-self: flex-start;
}
.export-privacy {
  margin-top: 12px;
  font-size: 13px;
  line-height: 22px;
  color: #7a847f;
}
.export-result {
  margin-top: 16px;
  padding: 16px;
  background-color: #f0eadd;
  border-radius: 14px;
}
.result-title {
  font-size: 13px;
  line-height: 22px;
  color: #182b31;
  font-weight: 600;
}
.export-notice {
  font-size: 13px;
  line-height: 22px;
  color: #344c54;
  margin-top: 8px;
}
.export-counts {
  font-size: 12px;
  line-height: 20px;
  color: #5c6869;
  margin-top: 4px;
}
.export-range {
  margin: 0 8px;
  flex-shrink: 0;
}
.export-intro {
  margin-top: 16px;
}
.form-error {
  font-size: 13px;
  line-height: 22px;
  color: #b4533f;
  margin-top: 8px;
}
.export-submit {
  margin-top: 24px;
  margin-bottom: 40px;
}
.body-copy {
  font-size: 15px;
  line-height: 26px;
  color: #344c54;
}
</style>
