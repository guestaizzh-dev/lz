<template>
<view class="page">
<PageHead title="服务与隐私说明"/>
<scroll-view :show-scrollbar="false" class="page-scroll" direction="vertical">
<view class="content">

<text class="detail-title">安心研习，尊重隐私。</text>
<text class="footer-note">试运营服务说明 · 更新日期：2026 年 10 月 21 日。经营主体与实际联系渠道须由书院核实公示；当前可从反馈入口提交问题，不将测试内容或预览通道作为正式交易承诺。</text>
<view v-if="currentUser" class="section"><view class="row between"><text class="section-heading">个性化内容推荐</text><switch :checked="personalized" :disabled="saving" color="#235663" @change="changePreference"/></view><text class="body-copy">依据兴趣、阅读、收藏、点赞及有效购买推荐，退款后撤销对应购买信号。关闭后仅展示公开精选，不影响购课和学习。</text><text v-if="preferenceError" class="hint">{{preferenceError}}</text></view><view v-for="section in sections" :key="section.title" class="section">
<text class="section-heading">{{section.title}}</text>
<text class="body-copy" :user-select="true">{{section.text}}</text>
</view>
</view>
</scroll-view>
</view>
</template>
<script setup lang="ts">
import {request} from '../../lib/api';import {currentUser} from '../../lib/session';
const personalized=ref(false),saving=ref(false),preferenceError=ref('');
onShow(async()=>{if(!currentUser.value)return;try{personalized.value=(await request<{enabled:boolean}>('/discovery/recommendation-preference')).enabled;preferenceError.value='';}catch(e){preferenceError.value=(e as Error).message;}});
async function changePreference(e:UniSwitchChangeEvent){if(saving.value)return;saving.value=true;const old=personalized.value;personalized.value=e.detail.value;try{const r=await request<{enabled:boolean}>('/discovery/recommendation-preference',{method:'POST',data:{enabled:e.detail.value}});personalized.value=r.enabled;preferenceError.value='';}catch(error){personalized.value=old;preferenceError.value=(error as Error).message;}finally{saving.value=false;}}
import PageHead from '../../components/PageHead.uvue';
const sections=[{title:'安装包与第三方能力',text:'App使用DCloud uni-app x运行时；实时直播/咨询使用ZEGO RTC，只在进入对应实时服务时连接，观众观看不需要摄像头或麦克风。微信登录/分享、微信或支付宝支付仅在实际开通且安装包包含相应模块时调用；Apple购买仅在iOS已配置产品时调用。uni-push为可选消息能力，当前无系统推送预览包不包含其SDK，站内消息仍可用。未启用统计广告SDK，不以通讯录或定位获取研习兴趣。'},{title:'权限与本机文件',text:'发图片/资料时由你主动选择文件；实时连麦或主持开播时才请求麦克风、摄像头，拒绝后可继续看公开内容或作为观众观看。研习导出仅在你主动操作时生成。音视频离线文件加密并受账号、设备与有效许可限制；退出后无法继续使用原账号文件。恢复显示设置仅重置字号筛选，不清除未同步记录；重新安装或清除应用数据会删除本机未同步内容，请先联网同步。'},{title:'版本与账号归属',text:'隐私与设置中可查看版本并检查书院公布的安装包地址。不同手机号账号的订单、笔记及权益不会自动合并；绑定冲突请从反馈提交核查，不提供一键合并或虚构找回口令。短信/登录渠道未开通时不承诺可发送验证码。'},{title:'账号与服务',text:'浏览公开文章无需登录。登录使用手机号和验证码，账号用于保存个人学习、收藏、笔记与修行记录。请勿冒用他人手机号。示例课程与商品不用于真实交易；正式内容是否可购买以已开通的渠道和实际报价为准。'},{title:'第三方账号授权',text:'微信和 Apple 登录仅在实际开通且安装包包含对应能力时提供。授权码交由服务端验证；首次使用须以短信确认本人手机号，绑定原账号。仅保存核验后的身份哈希，Apple 撤销凭据加密保存。遇到账号冲突不会自动合并订单、笔记或权益；可在账号与登录中验证本人手机号后解绑，注销时一并清除绑定并提交平台撤销。'},{title:'私人记录',text:'研习笔记和修行日志默认仅本人可见，不会自动用于公开帖子、课程案例或宣传。收藏记录用于个人回看；兴趣标签用于内容分类和后续推荐。'},{title:'消息与设备通知',text:'站内消息用于订单、预约、课程、直播、审核和客服回复。系统推送默认关闭，可在设置中按类型选择。仅在主动开启后初始化uni-push，向服务端登记加密保存的推送标识与当前登录会话；退出解绑。通知栏仅提示有新消息，详情须登录本人账号查看。拒绝系统通知不影响站内消息。正式厂商通道及SDK清单以实际发布配置公示为准。'},{title:'信息与权限',text:'本阶段使用手机号、登录会话、你主动保存的笔记、日志和兴趣标签。服务器处理必要的访问与安全记录。相册、摄像头和麦克风将在对应功能使用时单独说明并征求授权。拒绝非必要权限不影响公开浏览。'},{title:'修改、删除与注销',text:'你可取消收藏，修改或删除笔记、日志，退出当前会话，并申请注销。当前注销会删除私人记录、清除手机号与个人资料并撤销全部会话。已发生交易的财务记录及必要售后追溯事实会保留，私人地址与个人字段按注销流程清除。未结订单、退款或预约须先处理；注销已购权限须明确确认。'},{title:'内容与使用约定',text:'经典阅读、文化研习与实践交流不替代医疗或其他专业服务。转载与使用现代译注、音视频或用户内容须取得适用授权。公开交流将适用社区审核和举报规则。'}];
</script>
<style>@import '../../styles/app.css';</style>
