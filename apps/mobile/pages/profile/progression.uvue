<template><view class="page"><PageHead title="积分与成长"/><scroll-view class="page-scroll" direction="vertical" :show-scrollbar="false"><view class="content"><view v-if="summary" class="progression-summary"><text class="section-heading">{{summary!.level}}</text><view class="row between"><view><text class="balance">{{summary!.available}}</text><text class="meta">可用积分</text></view><view><text class="balance">{{summary!.growth}}</text><text class="meta">成长值</text></view></view><text v-if="summary!.nextLevelAt" class="meta">下一称号需要 {{summary!.nextLevelAt}} 成长值</text><text v-if="summary!.debt!=='0'" class="footer-note">待抵扣 {{summary!.debt}} 积分：原奖励已撤回，后续获得或退回的积分先抵扣，不影响已确认的兑换交付。</text><text v-if="summary!.reserved!=='0'" class="meta">冻结积分 {{summary!.reserved}}</text><text v-if="summary!.processing" class="footer-note">正在核对消费奖励，核对完成前暂不开放兑换，请稍后刷新。</text><text class="footer-note" :user-select="true">{{summary!.consumptionRule}}</text><text class="footer-note">每日有效打卡获得1积分、2成长值；多任务同日只奖励一次。公开帖子首次审核通过每日最多3积分，成长值每天最多20；撤回或下架冲回原奖励。可在积分商城查看当前开放的兑换内容。</text></view><button class="secondary-button" @click="openPage('marketing/points')">积分商城与兑换记录</button><view class="detail-tabs"><view v-for="name in ['积分明细','成长记录','消费结算']" :key="name" :class="['detail-tab',tab===name?'detail-tab-active':'']" @click="tab=name;load()"><text :class="['detail-tab-text',tab===name?'detail-tab-selected':'']">{{name}}</text></view></view><ContentState v-if="loading||error" :loading="loading" :error="error" @retry="load(failedAppend)"/><view v-for="row in items" :key="row.id" class="progression-row"><view class="row between"><text class="item-title grow">{{row.reason}}</text><text class="delta">{{tab==='消费结算'?'当前 ':''}}{{tab!=='消费结算'&&Number(row.delta)>0?'+':''}}{{row.delta}}</text></view><text v-if="row.debtChange&&row.debtChange!=='0'" class="meta">{{Number(row.debtChange)>0?'可用余额不足，新增待抵扣':'本次用于抵扣'}} {{Math.abs(Number(row.debtChange))}} 积分 · 剩余待抵扣 {{row.debtAfter}}</text><text v-if="row.rewardState" class="meta">{{row.statusText??consumptionStates[row.rewardState!]??row.rewardState}} · {{row.growth}} 成长值</text><text v-if="row.rewardState==='OBSERVATION'&&row.eligibleAt" class="meta">预计 {{formatChinaTime(row.eligibleAt)}}（北京）结算</text><text class="meta">{{formatChinaTime(row.createdAt)}}</text><button v-if="row.order&&consumptionOrderPath(row.order)" class="text-action" @click="openPage(consumptionOrderPath(row.order!))">查看原订单 ›</button></view><ContentState v-if="!loading&&!error&&!items.length" title="还没有记录" description="有效研习活动产生的积分与成长记录，会在这里显示。"/><button v-if="items.length<total" class="secondary-button" :disabled="loading" @click="load(true)">查看更多记录</button></view></scroll-view></view></template>
<script setup lang="ts">
import {consumptionStates,consumptionOrderPath} from '../../lib/consumption';
import {openPage} from '../../lib/presentation';import {formatChinaTime} from '../../lib/date-time';
import PageHead from '../../components/PageHead.uvue';import ContentState from '../../components/ContentState.uvue';import {request} from '../../lib/api';import {currentUser,needLogin} from '../../lib/session';
type SourceOrder={id:string;kind:string;orderNo?:string};type ConsumptionRow={statusText?:string|null;id:string;order:SourceOrder;points:string;createdAt:string;state:string;growth:number;eligibleAt:string};
type Summary={processing:boolean;consumptionRule:string;available:string;reserved:string;debt:string;growth:number;level:string;nextLevelAt:number|null};type Record={statusText?:string|null;id:string;delta:string|number;reason:string;createdAt:string;debtChange?:string;debtAfter?:string;order?:SourceOrder;rewardState?:string;eligibleAt?:string;growth?:number};
const summary=ref<Summary|null>(null),items=ref<Record[]>([]),loading=ref(false),error=ref(''),tab=ref('积分明细'),total=ref(0);let owner='',page=1,generation=0;
let failedAppend=false;
async function load(append=false){if(owner!==(currentUser.value?.id??'')){owner=currentUser.value?.id??'';summary.value=null;items.value=[];total.value=0;}if(needLogin('/pages/profile/progression')||append&&loading.value)return;const turn=++generation,next=append?page+1:1;failedAppend=append;loading.value=true;error.value='';if(!append)items.value=[];try{const [info,data]=await Promise.all([request<Summary>('/me/progression'),request<{items:Record[];total:number}>('/me/progression/'+(tab.value==='积分明细'?'points':tab.value==='成长记录'?'growth':'consumption')+'?page='+next)]);if(turn!==generation)return;summary.value=info;items.value=append?[...items.value,...normalize(data.items)]:normalize(data.items);total.value=data.total;page=next;}catch(e){if(turn===generation)error.value=(e as Error).message;}finally{if(turn===generation)loading.value=false;}}
function normalize(rows:Record[]){return tab.value==='消费结算'?rows.map(r=>{const reward=r as unknown as ConsumptionRow;return{id:reward.id,reason:reward.order.orderNo??'消费订单',delta:reward.points,createdAt:reward.createdAt,order:reward.order,rewardState:reward.state,statusText:reward.statusText,eligibleAt:reward.eligibleAt,growth:reward.growth};}):rows;}
onShow(()=>load());
</script><style>@import '../../styles/app.css';.progression-summary{padding:20px;background-color:#EFE9DC;border-radius:8px;}.balance{font-size:28px;line-height:42px;color:#235663;margin-top:10px;}.progression-row{padding:18px 0;border-bottom-width:1px;border-bottom-style:solid;border-bottom-color:#E3DCCF;}.delta{font-size:18px;line-height:28px;color:#235663;}</style>
