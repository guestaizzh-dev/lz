<template>
  <view class="page"
    ><InkBackdrop />
    <PageHead title="隐私与设置" />
    <scroll-view :show-scrollbar="false" class="page-scroll" direction="vertical">
      <view class="content">
        <view class="menu-group"
          ><view
            v-if="currentUser"
            class="menu-row"
            @click="uni.navigateTo({ url: '/pages/profile/edit' })"
            ><AppIcon name="user" :size="22" /><text class="ui-text menu-label">个人资料</text
            ><AppIcon name="arrow-right" :size="16"
          /></view>
          <view
            v-if="currentUser"
            class="menu-row"
            @click="uni.navigateTo({ url: '/pages/profile/accounts' })"
            ><AppIcon name="shield-check" :size="22" /><text class="ui-text menu-label"
              >账号与登录</text
            ><AppIcon name="arrow-right" :size="16"
          /></view>
          <view v-if="currentUser" class="menu-row" @click="addresses()"
            ><AppIcon name="package" :size="22" /><text class="ui-text menu-label">收货地址</text
            ><AppIcon name="arrow-right" :size="16"
          /></view>
          <view class="menu-row" @click="privacy">
            <AppIcon name="shield-check" :size="22" />
            <text class="ui-text menu-label">服务与隐私说明</text>
            <AppIcon name="arrow-right" :size="16" />
          </view>
        </view>
        <view v-if="currentUser" class="section notification-section"
          ><text class="ui-text section-heading">消息与通知</text
          ><text class="ui-text intro">站内消息始终保留。系统通知可按自己的节奏开启。</text
          ><ContentState
            v-if="preferencesLoading || preferencesError"
            :loading="preferencesLoading"
            :error="preferencesError"
            @retry="loadPreferences"
          /><template v-if="preferences"
            ><view class="preference-row"
              ><text class="ui-text preference-label">接收系统通知</text
              ><text
                :class="[
                  'ui-text',
                  'switch-state',
                  preferences!.pushEnabled ? 'switch-state-on' : '',
                ]"
                >{{ preferences!.pushEnabled ? '已开启' : '已关闭' }}</text
              ><switch
                :checked="preferences!.pushEnabled"
                :disabled="preferenceSaving"
                :color="preferences!.pushEnabled ? '#235663' : '#D8D1C2'"
                aria-label="接收系统通知"
                @change="setPreference('pushEnabled', $event.detail.value)" /></view
            ><template v-if="preferences!.pushEnabled"
              ><view v-for="item in preferenceChoices" :key="item.key" class="preference-row"
                ><text class="ui-text preference-label">{{ item.title }}</text
                ><text
                  :class="[
                    'ui-text',
                    'switch-state',
                    preferences![item.key] ? 'switch-state-on' : '',
                  ]"
                  >{{ preferences![item.key] ? '已开启' : '已关闭' }}</text
                ><switch
                  :checked="preferences![item.key]"
                  :disabled="preferenceSaving"
                  :color="preferences![item.key] ? '#235663' : '#D8D1C2'"
                  :aria-label="item.title"
                  @change="setPreference(item.key, $event.detail.value)" /></view
              ><text class="ui-text meta">{{ permission }}</text
              ><text v-if="!preferences!.gatewayReady" class="ui-text meta"
                >系统推送暂未开通，所有通知仍可在书院消息中查看。</text
              ><button class="ui-button setting-action" @click="openNotificationPermission"
                >打开系统通知设置</button
              ><text v-if="pushError" class="ui-text footer-note">{{ pushError }}</text></template
            ></template
          ><button
            class="ui-button setting-action"
            @click="uni.navigateTo({ url: '/pages/profile/messages' })"
            >查看书院消息 ›</button
          ></view
        >
        <view class="section"
          ><text class="ui-text section-heading">本机显示</text
          ><text class="ui-text intro"
            >恢复阅读字号与筛选设置。账号、未同步的研习记录与私人内容会保留。</text
          ><button class="ui-button setting-action" @click="resetDisplay"
            >恢复显示设置</button
          ></view
        >
        <view v-if="currentUser" class="section">
          <text class="ui-text section-heading">我的研习方向</text>
          <text class="ui-text intro">选择感兴趣的内容，可随时修改。</text>
          <view class="interest-grid">
            <view
              v-for="item in choices"
              :key="item"
              :class="['interest-chip', tags.includes(item) ? 'interest-chip-selected' : '']"
              @click="toggle(item)"
            >
              <text
                class="ui-text"
                :class="[tags.includes(item) ? 'interest-text-selected' : 'interest-text']"
                >{{ item }}</text
              >
            </view>
          </view>
          <button
            :class="['ui-button', 'primary-button', busy ? 'is-disabled' : '']"
            :disabled="busy"
            @click="saveTags"
            >保存研习方向</button
          >
          <button class="ui-button retry" :disabled="busy" @click="signOut">退出当前账号</button>
          <button class="ui-button close-account" :disabled="busy" @click="closeAccount"
            >申请注销账号</button
          >
        </view>
        <text v-if="error" class="ui-text footer-note">{{ error }}</text>
        <view class="section"
          ><text class="ui-text section-heading">版本与更新</text
          ><text class="ui-text intro"
            >当前版本 {{ appVersion }}。更新入口仅使用书院已核实的发布地址。</text
          ><button
            class="ui-button setting-action"
            :disabled="checkingUpdate"
            @click="checkUpdate"
            >{{ checkingUpdate ? '正在检查…' : '检查新版本' }}</button
          ><text v-if="updateNotice" class="ui-text meta">{{ updateNotice }}</text></view
        ><text class="ui-text demo-note">老子道学书院 · {{ appVersion }}</text>
      </view>
    </scroll-view>
  </view>
</template>
<script setup lang="ts">
import InkBackdrop from '../../components/InkBackdrop.uvue';
import PageHead from '../../components/PageHead.uvue';
import ContentState from '../../components/ContentState.uvue';
import {
  notificationPermission,
  openNotificationPermission,
  refreshPush,
} from '../../lib/notifications';
import type { NotificationPreferences } from '../../lib/notifications';
import AppIcon from '../../components/AppIcon.uvue';
import { request } from '../../lib/api';
import { removeStudyUser } from '../../lib/study-queue';
import { currentUser, clearSession, sessionGeneration } from '../../lib/session';
const choices = [
    '经典研习',
    '实践修行',
    '生活应用',
    '少儿启蒙',
    '名师解读',
    '文创',
    '养生交流',
    '线下活动',
  ],
  tags = ref<string[]>([]),
  busy = ref(false),
  error = ref('');
const back = () => uni.navigateBack(),
  privacy = () => uni.navigateTo({ url: '/pages/profile/privacy' });
const appVersion = uni.getAppBaseInfo().appVersion,
  checkingUpdate = ref(false),
  updateNotice = ref('');
async function checkUpdate() {
  if (checkingUpdate.value) return;
  checkingUpdate.value = true;
  updateNotice.value = '';
  try {
    const info = await request<{
      androidVersion: string;
      androidCode: number;
      androidUrl: string;
      iosVersion: string;
      iosCode: number;
      iosUrl: string;
      notes: string;
    }>('/configuration/release');
    const ios = uni.getSystemInfoSync().platform === 'ios',
      version = ios ? info.iosVersion : info.androidVersion,
      url = ios ? info.iosUrl : info.androidUrl,
      code = ios ? info.iosCode : info.androidCode;
    if (!version || !code || !url) {
      updateNotice.value = '书院暂未公布新的正式安装包。';
      return;
    }
    if (Number(uni.getAppBaseInfo().appVersionCode) >= code) {
      updateNotice.value = '当前已是所公布的最新版本。';
      return;
    }
    uni.showModal({
      title: '发现新版本 ' + version,
      content: info.notes || '可以更新书院最新版本，更新前请同步学习记录。',
      confirmText: '复制下载地址',
      success: (r) => {
        if (r.confirm)
          uni.setClipboardData({
            data: url,
            success: () => {
              updateNotice.value = '下载地址已复制，可在系统浏览器打开。更新前请同步学习记录。';
            },
          });
      },
    });
  } catch (e) {
    updateNotice.value = (e as Error).message;
  } finally {
    checkingUpdate.value = false;
  }
}
const addresses = () => uni.navigateTo({ url: '/pages/shop/addresses' });
function toggle(value: string) {
  if (busy.value) return;
  tags.value = tags.value.includes(value)
    ? tags.value.filter((item) => item !== value)
    : [...tags.value, value];
}
async function saveTags() {
  if (busy.value) return;
  busy.value = true;
  error.value = '';
  try {
    await request('/me/tags', { method: 'PATCH', data: { tags: tags.value } });
    if (currentUser.value) currentUser.value = { ...currentUser.value, tags: tags.value };
    uni.showToast({ title: '已保存', icon: 'none' });
  } catch (e) {
    error.value = (e as Error).message;
  } finally {
    busy.value = false;
  }
}
async function signOut() {
  busy.value = true;
  try {
    try {
      await request('/me/push-device', { method: 'DELETE' });
      await request('/auth/logout', { method: 'POST' });
    } catch {}
    clearSession();
    back();
  } catch (e) {
    error.value = (e as Error).message;
  } finally {
    busy.value = false;
  }
}
type ClosureStatus = {
  purchasedVideoVouchers?: number;
  pendingBookings: number;
  pendingOrders: number;
  pendingRefunds: number;
  unresolvedPaidOrders: number;
  paidCourses: number;
  paidMemberships: number;
  receiptReference: string;
};
async function closeAccount() {
  if (busy.value) return;
  busy.value = true;
  error.value = '';
  try {
    const status = await request<ClosureStatus>('/me/close-account/status');
    if (status.pendingBookings) {
      uni.showModal({
        title: '先处理书院之约',
        content: '仍有有效预约、活动报名或训练营，请先取消或完成服务后再注销。',
        showCancel: false,
      });
      return;
    }
    if ((status.purchasedVideoVouchers ?? 0) > 0) {
      error.value = '还有已购视频代金券，请先在会员中心处理未使用的份数。';
      return;
    }
    if (status.pendingOrders || status.pendingRefunds || status.unresolvedPaidOrders) {
      uni.showModal({
        title: '请先处理订单与售后',
        content: '还有待付款、退款或履约中的交易。处理完成后可注销，当前账号和学习权限会保留。',
        confirmText: '查看订单',
        success: (result) => {
          if (result.confirm)
            uni.showActionSheet({
              itemList: ['购课订单', '会员订单', '商品订单'],
              success: (r) =>
                uni.navigateTo({
                  url:
                    r.tapIndex === 1
                      ? '/pages/membership/orders'
                      : r.tapIndex === 2
                        ? '/pages/shop/orders'
                        : '/pages/course/orders',
                }),
            });
        },
      });
      return;
    }
    uni.showModal({
      title:
        status.paidCourses || status.paidMemberships
          ? '确认放弃已购学习与会员权限？'
          : '注销书院账号',
      content:
        (status.paidCourses || status.paidMemberships
          ? '你还有 ' +
            status.paidCourses +
            ' 门已购课程、' +
            status.paidMemberships +
            ' 段已购会员。注销将放弃剩余学习与会员权限，不会自动退款。需要退款请先返回订单申请。\n\n'
          : '') +
        '私人笔记、日志、学习进度、地址及个人资料将清除，所有登录与会员权限将失效，无法恢复。交易记录按售后要求保留。请先保存订单编号；注销后可凭编号联系书院客服。',
      confirmText: status.paidCourses || status.paidMemberships ? '放弃并注销' : '确认注销',
      success: async (result) => {
        if (!result.confirm) return;
        busy.value = true;
        error.value = '';
        try {
          const receipt = await request<{ receiptReference: string }>('/me/close-account', {
            method: 'POST',
            data: {
              confirmation: '确认注销',
              forfeitPaidAccess: status.paidCourses > 0 || status.paidMemberships > 0,
            },
          });
          const closedUser = currentUser.value?.id ?? '';
          try {
            if (closedUser) removeStudyUser(closedUser);
          } finally {
            clearSession();
          }
          uni.showModal({
            title: '账号已注销',
            content:
              '售后追溯编号：' +
              receipt.receiptReference +
              '\n可保存此编号及订单付款凭证，联系书院客服核查历史交易。',
            confirmText: '复制编号',
            cancelText: '完成',
            success: (r) => {
              if (r.confirm) uni.setClipboardData({ data: receipt.receiptReference });
              back();
            },
          });
        } catch (e) {
          error.value = (e as Error).message;
        } finally {
          busy.value = false;
        }
      },
    });
  } catch (e) {
    error.value = (e as Error).message;
  } finally {
    busy.value = false;
  }
}
const preferences = ref<NotificationPreferences | null>(null),
  preferencesLoading = ref(false),
  preferencesError = ref(''),
  preferenceSaving = ref(false),
  pushError = ref(''),
  permission = ref('');
const preferenceChoices = [
  { key: 'transactions', title: '订单、预约与客服' },
  { key: 'learning', title: '课程、训练营与直播' },
  { key: 'community', title: '交流审核与老师答复' },
] as { key: 'transactions' | 'learning' | 'community'; title: string }[];
async function loadPreferences() {
  if (!currentUser.value) return;
  const generation = sessionGeneration();
  preferencesLoading.value = true;
  preferencesError.value = '';
  try {
    const row = await request<NotificationPreferences>('/me/notification-preferences');
    if (generation === sessionGeneration()) preferences.value = row;
  } catch (e) {
    if (generation === sessionGeneration()) preferencesError.value = (e as Error).message;
  } finally {
    if (generation === sessionGeneration()) preferencesLoading.value = false;
  }
}
async function setPreference(
  key: 'pushEnabled' | 'transactions' | 'learning' | 'community',
  value: boolean,
) {
  if (!preferences.value || preferenceSaving.value) return;
  preferenceSaving.value = true;
  preferencesError.value = '';
  pushError.value = '';
  const generation = sessionGeneration(),
    next = { ...preferences.value, [key]: value };
  try {
    const row = await request<NotificationPreferences>('/me/notification-preferences', {
      method: 'PATCH',
      data: {
        expectedVersion: next.version,
        pushEnabled: next.pushEnabled,
        transactions: next.transactions,
        learning: next.learning,
        community: next.community,
      },
    });
    if (generation !== sessionGeneration()) return;
    preferences.value = row;
    try {
      await refreshPush();
    } catch {
      pushError.value = '系统通知暂不可用，请检查系统权限；站内消息不受影响。';
    }
  } catch (e) {
    if (generation === sessionGeneration()) {
      preferencesError.value = (e as Error).message;
      await loadPreferences();
    }
  } finally {
    if (generation === sessionGeneration()) preferenceSaving.value = false;
  }
}
function resetDisplay() {
  uni.showModal({
    title: '恢复显示设置',
    content: '阅读字号与临时筛选将恢复默认，不清除私人记录或未同步研习。',
    confirmText: '恢复默认',
    success: (r) => {
      if (r.confirm) {
        for (const key of ['readerFontSize', 'academyFormat', 'searchQuery'])
          uni.removeStorageSync(key);
        uni.showToast({ title: '已恢复显示设置', icon: 'none' });
      }
    },
  });
}
watch(
  () => currentUser.value?.id,
  () => {
    preferences.value = null;
    preferencesError.value = '';
    preferencesLoading.value = false;
    preferenceSaving.value = false;
    tags.value = [...(currentUser.value?.tags ?? [])];
  },
);
onShow(() => {
  permission.value = notificationPermission();
  void loadPreferences();
  void refreshPush().catch(() => {});
});
onLoad(() => {
  tags.value = [...(currentUser.value?.tags ?? [])];
});
</script>
<style>
@import '../../styles/app.css';
.menu-group {
  margin-top: 16px;
}
.menu-row {
  min-height: 54px;
  padding: 15px 0;
}
.menu-label {
  font-size: 16px;
  line-height: 24px;
  margin-left: 12px;
}
.retry {
  margin-top: 12px;
  min-height: 46px;
  border-color: #c9bfad;
  font-size: 13px;
  line-height: 22px;
  padding: 12px 20px;
}
.section-heading {
  font-size: 19px;
  line-height: 28px;
}
.intro {
  margin-top: 8px;
  font-size: 13px;
  line-height: 22px;
  color: #5c6869;
}
.preference-row {
  flex-direction: row;
  align-items: center;
  min-height: 54px;
  padding: 15px 0;
  border-bottom-style: solid;
  border-bottom-width: 1px;
  border-bottom-color: #e0d8c8;
}
.preference-label {
  flex: 1;
  min-width: 0;
  padding-right: 12px;
  font-size: 15px;
  line-height: 26px;
  color: #344c54;
}
.switch-state {
  font-size: 12px;
  line-height: 20px;
  color: #5c6869;
  margin-right: 8px;
}
.setting-action {
  align-self: flex-start;
  min-height: 44px;
  padding: 11px 0;
  margin: 4px 0;
  border-width: 0;
  background-color: transparent;
  color: #235663;
  font-size: 13px;
  line-height: 22px;
}
.interest-grid {
  flex-direction: row;
  flex-wrap: wrap;
  margin-top: 16px;
}
.interest-chip {
  padding: 11px 14px;
  border-radius: 10px;
  margin-right: 8px;
  margin-bottom: 8px;
  background-color: #f0eadd;
  border-style: solid;
  border-width: 1px;
  border-color: transparent;
}
.interest-chip-selected {
  background-color: #e6ede9;
  border-color: #235663;
}
.switch-state-on {
  color: #235663;
  font-weight: 600;
}
.interest-text {
  font-size: 13px;
  line-height: 22px;
  color: #344c54;
}
.interest-text-selected {
  font-size: 13px;
  line-height: 22px;
  color: #235663;
  font-weight: 600;
}
.close-account {
  border-style: solid;
  border-width: 0;
  color: #b4533f;
  background-color: transparent;
  font-size: 13px;
  margin-top: 24px;
  min-height: 44px;
  line-height: 22px;
  padding: 11px 0;
  align-self: flex-start;
}
.demo-note {
  font-size: 12px;
  line-height: 20px;
  color: #7a847f;
}
</style>
