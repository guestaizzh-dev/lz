<template><view class="page"><PageHead title="阅读足迹"/><scroll-view class="page-scroll" direction="vertical" :show-scrollbar="false"><view class="content"><ContentState v-if="error||loading" :loading="loading" :error="error" @retry="load(failedAppend)"/><view v-for="item in items" :key="item.id" class="history-item" @click="goArticle(item.id)"><text class="tag">{{item.category}} · {{item.author}}</text><text class="item-title">{{item.title}}</text><text class="article-summary">{{item.summary}}</text><text class="meta">{{formatChinaTime(item.lastReadAt)}} · {{readingDuration(item.readDuration)}}</text></view><ContentState v-if="!loading&&!error&&!items.length" title="尚无阅读足迹" description="读过的经典与文章，都能在这里接着看。" actionLabel="去读文章" @action="openPage('discover/index')"/><button v-if="hasMore" class="retry" :disabled="loading" @click="load(true)">加载更多</button></view></scroll-view></view></template>
<script setup lang="ts">
import {formatChinaTime,readingDuration} from '../../lib/date-time';
import {openPage} from '../../lib/presentation';
import PageHead from '../../components/PageHead.uvue';import ContentState from '../../components/ContentState.uvue';import {request,goArticle} from '../../lib/api';import {currentUser,needLogin} from '../../lib/session';
type History={id:string;title:string;summary:string;category:string;author:string;lastReadAt:string;readDuration:number};
const items=ref<History[]>([]),loading=ref(false),error=ref(''),hasMore=ref(false);let page=1,owner='';
let failedAppend=false;
async function load(append=false){if(owner!==(currentUser.value?.id??'')){owner=currentUser.value?.id??'';items.value=[];hasMore.value=false;}if(needLogin()||loading.value)return;failedAppend=append;loading.value=true;error.value='';try{const next=append?page+1:1;const data=await request<{items:History[];hasMore:boolean}>('/me/reading-history?page='+next);items.value=append?[...items.value,...data.items]:data.items;page=next;hasMore.value=data.hasMore;}catch(e){error.value=(e as Error).message;}finally{loading.value=false;}}
onShow(()=>load());
</script>
<style>@import '../../styles/app.css';.history-item{padding:20px 0;border-bottom-style:solid;border-bottom-width:1px;border-bottom-color:#DFD9CF;}</style>
