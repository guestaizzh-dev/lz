<template>
  <view class="page"
    ><InkBackdrop /><PageHead title="搜索书院" />
    <scroll-view class="page-scroll" direction="vertical" :show-scrollbar="false"
      ><view class="content">
        <view class="search"
          ><AppIcon name="magnifying-glass" :size="17" /><input
            class="search-input"
            confirm-type="search"
            placeholder="文章、课程、名师、商品、活动…"
            maxlength="80"
            v-model="keyword"
            @confirm="search()"
          /><text class="section-link" @click="search()">搜索</text></view
        >
        <scroll-view
          direction="horizontal"
          :show-scrollbar="false"
          class="horizontal-scroll type-row"
          ><text
            v-for="t in types"
            :key="t.value"
            :class="type === t.value ? 'type-chip-active' : 'type-chip'"
            @click="
              type = t.value;
              search();
            "
            >{{ t.label }}</text
          ></scroll-view
        >
        <scroll-view
          v-if="tags.length"
          direction="horizontal"
          :show-scrollbar="false"
          class="horizontal-scroll tag-row"
          ><text
            :class="!tag ? 'tag-chip-active' : 'tag-chip'"
            @click="
              tag = '';
              search();
            "
            >全部标签</text
          ><text
            v-for="t in tags"
            :key="t.name"
            :class="tag === t.name ? 'tag-chip-active' : 'tag-chip'"
            @click="
              tag = t.name;
              search();
            "
            >{{ t.name }}</text
          ></scroll-view
        >
        <view class="row between sort-row"
          ><text class="meta">共 {{ total }} 条内容</text
          ><view class="row sort-group"
            ><text
              v-for="s in sorts"
              :key="s.value"
              :class="sort === s.value ? 'sort-chip-active' : 'sort-chip'"
              @click="
                sort = s.value;
                search();
              "
              >{{ s.label }}</text
            ></view
          ></view
        >
        <ContentState
          v-if="error || loading"
          :loading="loading"
          :error="error"
          @retry="search(failedAppend)"
        />
        <view v-for="item in items" :key="item.id" class="result" @click="openContent(item)"
          ><view class="result-top"
            ><ArtImage
              v-if="item.cover"
              :src="item.cover"
              kind="study"
              :width="88"
              :height="88"
            /><view class="grow result-copy"
              ><text class="tag"
                >{{ typeNames[item.type] }}{{ item.visibility === 'MEMBER' ? ' · 会员专享' : ''
                }}{{ item.isDemo ? ' · 示例' : '' }}</text
              ><text class="item-title result-title">{{ item.title }}</text
              ><text class="article-summary result-summary">{{ item.summary }}</text
              ><text class="meta result-meta">{{ item.tags.join(' · ') }}</text></view
            ></view
          ></view
        >
        <ContentState
          v-if="!loading && !error && !items.length"
          title="没有找到相关内容"
          description="试试更短的关键词，或切换标签和类型。"
        />
        <button
          v-if="hasMore"
          :class="['retry', loading ? 'is-disabled' : '']"
          @click="search(true)"
          >加载更多</button
        >
      </view></scroll-view
    ></view
  >
</template>
<script setup lang="ts">
import InkBackdrop from '../../components/InkBackdrop.uvue';
import PageHead from '../../components/PageHead.uvue';
import AppIcon from '../../components/AppIcon.uvue';
import ContentState from '../../components/ContentState.uvue';
import ArtImage from '../../components/ArtImage.uvue';
import { request } from '../../lib/api';
import { typeNames, openContent } from '../../lib/discovery';
import type { DiscoveryItem } from '../../lib/discovery';
const keyword = ref(''),
  type = ref(''),
  tag = ref(''),
  sort = ref('relevance'),
  items = ref<DiscoveryItem[]>([]),
  tags = ref<{ name: string; count: number }[]>([]),
  loading = ref(false),
  error = ref(''),
  total = ref(0),
  hasMore = ref(false);
let page = 1,
  sequence = 0,
  appliedQuery = '';
const types = [
  { value: '', label: '全部' },
  ...Object.keys(typeNames).map((value) => ({ value, label: typeNames[value] })),
];
const sorts = [
  { value: 'relevance', label: '相关' },
  { value: 'recent', label: '最新' },
  { value: 'popular', label: '热度' },
];
let failedAppend = false;
async function search(append = false) {
  if (append && loading.value) return;
  const seq = ++sequence;
  const next = append ? page + 1 : 1;
  failedAppend = append;
  loading.value = true;
  error.value = '';
  if (!append) items.value = [];
  try {
    if (!append)
      appliedQuery =
        '?q=' +
        encodeURIComponent(keyword.value.trim()) +
        '&sort=' +
        sort.value +
        (type.value ? '&type=' + type.value : '') +
        (tag.value ? '&tag=' + encodeURIComponent(tag.value) : '');
    const query = appliedQuery + '&page=' + next;
    const r = await request<{ items: DiscoveryItem[]; total: number; hasMore: boolean }>(
      '/discovery/search' + query,
    );
    if (seq !== sequence) return;
    items.value = append ? [...items.value, ...r.items] : r.items;
    total.value = r.total;
    hasMore.value = r.hasMore;
    page = next;
  } catch (e) {
    if (seq === sequence) error.value = (e as Error).message;
  } finally {
    if (seq === sequence) loading.value = false;
  }
}
onLoad(async (options) => {
  keyword.value = options?.q ?? '';
  search();
  try {
    tags.value = await request('/discovery/tags');
  } catch {}
});
</script>
<style>
@import '../../styles/app.css';
.type-row {
  flex-direction: row;
  margin-bottom: 8px;
}
.type-chip,
.type-chip-active {
  min-height: 44px;
  font-size: 13px;
  line-height: 22px;
  padding: 11px 12px;
  margin-right: 8px;
  border-radius: 10px;
  background-color: #f0eadd;
  color: #5c6869;
  flex-shrink: 0;
}
.type-chip-active {
  background-color: #235663;
  color: #fcf9f2;
  font-weight: 600;
}
.tag-row {
  flex-direction: row;
  margin-bottom: 8px;
}
.tag-chip,
.tag-chip-active {
  min-height: 40px;
  font-size: 13px;
  line-height: 22px;
  padding: 9px 12px;
  margin-right: 8px;
  border-radius: 10px;
  border-style: solid;
  border-width: 1px;
  border-color: #cfc5b1;
  color: #5c6869;
  flex-shrink: 0;
}
.tag-chip-active {
  border-color: #235663;
  background-color: #e6ede9;
  color: #235663;
  font-weight: 600;
}
.sort-row {
  align-items: center;
  min-height: 44px;
  margin-bottom: 8px;
}
.sort-group {
  margin-right: -8px;
}
.sort-chip,
.sort-chip-active {
  font-size: 13px;
  line-height: 22px;
  padding: 11px 8px;
  color: #5c6869;
}
.sort-chip-active {
  color: #182b31;
  font-weight: 600;
}
.result {
  padding: 16px 0;
  border-bottom-style: solid;
  border-bottom-width: 1px;
  border-bottom-color: #e0d8c8;
}
.result-top {
  flex-direction: row;
  align-items: flex-start;
}
.result-copy {
  padding-left: 12px;
}
.result-title {
  font-size: 16px;
  line-height: 24px;
  max-height: 48px;
  overflow: hidden;
  margin-top: 4px;
}
.result-summary {
  max-height: 44px;
  overflow: hidden;
  margin-top: 4px;
}
.result-meta {
  margin-top: 4px;
}
</style>
