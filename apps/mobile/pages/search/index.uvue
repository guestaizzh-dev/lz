<template>
<view class="page"><PageHead title="搜索书院"/>
<scroll-view class="page-scroll" direction="vertical" :show-scrollbar="false"><view class="content">
<view class="search"><AppIcon name="magnifying-glass" :size="17"/><input class="search-input" confirm-type="search" placeholder="文章、课程、名师、商品、活动…" maxlength="80" v-model="keyword" @confirm="search()"/><text class="section-link" @click="search()">搜索</text></view>
<scroll-view direction="horizontal" :show-scrollbar="false" class="horizontal-scroll filter-row"><text v-for="t in types" :key="t.value" :class="type===t.value?'filter-active':'filter'" @click="type=t.value;search()">{{t.label}}</text></scroll-view>
<scroll-view v-if="tags.length" direction="horizontal" :show-scrollbar="false" class="horizontal-scroll filter-row"><text :class="!tag?'filter-active':'filter'" @click="tag='';search()">全部标签</text><text v-for="t in tags" :key="t.name" :class="tag===t.name?'filter-active':'filter'" @click="tag=t.name;search()">{{t.name}}</text></scroll-view>
<view class="row between"><text class="meta">共 {{total}} 条内容</text><view class="row"><text v-for="s in sorts" :key="s.value" :class="sort===s.value?'filter-active':'filter'" @click="sort=s.value;search()">{{s.label}}</text></view></view>
<ContentState v-if="error||loading" :loading="loading" :error="error" @retry="search(failedAppend)"/>
<view v-for="item in items" :key="item.id" class="result" @click="openContent(item)"><text class="tag">{{typeNames[item.type]}}{{item.visibility==='MEMBER'?' · 会员专享':''}}{{item.isDemo?' · 示例':''}}</text><text class="item-title">{{item.title}}</text><text class="article-summary">{{item.summary}}</text><text class="meta">{{item.tags.join(' · ')}}</text></view>
<ContentState v-if="!loading&&!error&&!items.length" title="没有找到相关内容" description="试试更短的关键词，或切换标签和类型。"/>
<button v-if="hasMore" :class="['retry',loading?'is-disabled':'']" @click="search(true)">加载更多</button>
</view></scroll-view></view>
</template>
<script setup lang="ts">
import PageHead from '../../components/PageHead.uvue';import AppIcon from '../../components/AppIcon.uvue';import ContentState from '../../components/ContentState.uvue';
import {request} from '../../lib/api';import {typeNames,openContent} from '../../lib/discovery';import type {DiscoveryItem} from '../../lib/discovery';
const keyword=ref(''),type=ref(''),tag=ref(''),sort=ref('relevance'),items=ref<DiscoveryItem[]>([]),tags=ref<{name:string;count:number}[]>([]),loading=ref(false),error=ref(''),total=ref(0),hasMore=ref(false);let page=1,sequence=0,appliedQuery='';
const types=[{value:'',label:'全部'},...Object.keys(typeNames).map(value=>({value,label:typeNames[value]}))];const sorts=[{value:'relevance',label:'相关'},{value:'recent',label:'最新'},{value:'popular',label:'热度'}];
let failedAppend=false;
async function search(append=false){if(append&&loading.value)return;const seq=++sequence;const next=append?page+1:1;failedAppend=append;loading.value=true;error.value='';if(!append)items.value=[];try{if(!append)appliedQuery='?q='+encodeURIComponent(keyword.value.trim())+'&sort='+sort.value+(type.value?'&type='+type.value:'')+(tag.value?'&tag='+encodeURIComponent(tag.value):'');const query=appliedQuery+'&page='+next;const r=await request<{items:DiscoveryItem[];total:number;hasMore:boolean}>('/discovery/search'+query);if(seq!==sequence)return;items.value=append?[...items.value,...r.items]:r.items;total.value=r.total;hasMore.value=r.hasMore;page=next;}catch(e){if(seq===sequence)error.value=(e as Error).message;}finally{if(seq===sequence)loading.value=false;}}
onLoad(async options=>{keyword.value=options?.q??'';search();try{tags.value=await request('/discovery/tags');}catch{}});
</script>
<style>@import '../../styles/app.css';.filter-row{flex-direction:row;margin-bottom:12px;}.filter,.filter-active{font-size:13px;line-height:20px;padding:7px 12px;margin-right:8px;border-radius:16px;border-style:solid;border-width:1px;border-color:transparent;color:#6B7578;flex-shrink:0;}.filter-active{color:#245564;background-color:#E9EFEB;border-color:#B7C6C0;font-weight:600;}.result{padding:20px 0;border-bottom-style:solid;border-bottom-width:1px;border-bottom-color:#E4DFD4;}</style>
