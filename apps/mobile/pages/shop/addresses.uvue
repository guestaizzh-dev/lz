<template>
  <view class="page"
    ><InkBackdrop /><PageHead title="收货地址" /><scroll-view
      class="page-scroll"
      direction="vertical"
      :show-scrollbar="false"
      ><view class="content">
        <ContentState
          v-if="!editing && (loading || error)"
          :loading="loading"
          :error="error"
          :error-title="
            errorTone(error) === 'net'
              ? '网络连接中断'
              : errorTone(error) === 'gone'
                ? '地址列表不存在'
                : '地址信息需要重新确认'
          "
          :retryable="errorTone(error) === 'net'"
          :action-label="errorTone(error) === 'net' ? '' : '返回书院好物'"
          @retry="load()"
          @action="openPage('shop/index')"
        />
        <view v-if="editing">
          <text class="ui-text section-heading address-form-title">{{
            selectedId ? '编辑地址' : '添加地址'
          }}</text>
          <view class="address-field"
            ><text class="ui-text field-label">收货人</text
            ><input
              class="ui-input field-input"
              v-model="form.recipient"
              maxlength="30"
              placeholder="姓名"
          /></view>
          <view class="address-field"
            ><text class="ui-text field-label">联系电话</text
            ><input
              class="ui-input field-input"
              type="number"
              v-model="form.phone"
              maxlength="11"
              placeholder="11位手机号"
          /></view>
          <view class="address-field"
            ><text class="ui-text field-label">所在地区</text
            ><view class="field-select" @click="regionVisible = true"
              ><text class="ui-text region-value">{{
                form.province
                  ? [form.province, form.city, form.district].join(' / ')
                  : '选择省、市、区县 ›'
              }}</text></view
            ></view
          >
          <view class="address-field"
            ><text class="ui-text field-label">详细地址</text
            ><textarea
              class="ui-input field-area"
              v-model="form.detail"
              maxlength="150"
              placeholder="街道、楼栋、门牌号"
            />
          </view>
          <view class="switch-row"
            ><text class="ui-text switch-label">设为默认地址</text
            ><view class="row"
              ><text class="ui-text switch-state">{{ form.isDefault ? '默认地址' : '非默认' }}</text
              ><switch :checked="form.isDefault" color="#235663" @change="setDefault" /></view
          ></view>
          <text v-if="error" class="ui-text form-feedback">{{ error }}</text
          ><button
            class="ui-button primary-button"
            :class="busy ? 'is-disabled' : ''"
            :disabled="busy"
            @click="save()"
            >{{ busy ? '保存中…' : '保存地址' }}</button
          ><button
            class="ui-button text-action"
            :class="busy ? 'is-disabled' : ''"
            :disabled="busy"
            @click="cancel()"
            >取消</button
          >
        </view>
        <view v-if="!editing">
          <view v-for="item in items" :key="item.id" class="address-row"
            ><view class="row between"
              ><text class="ui-text item-title">{{ item.recipient }}　{{ item.phone }}</text
              ><text v-if="item.isDefault" class="ui-text default-label">默认</text></view
            ><text class="ui-text address-copy" :user-select="true">{{ addressText(item) }}</text
            ><view class="row address-actions"
              ><button
                class="ui-button text-action"
                :class="busy ? 'is-disabled' : ''"
                :disabled="busy"
                @click="edit(item)"
                >编辑</button
              ><button
                class="ui-button text-action remove-action"
                :class="busy ? 'is-disabled' : ''"
                :disabled="busy"
                @click="remove(item)"
                >删除</button
              ></view
            ></view
          >
          <ContentState
            v-if="!loading && !error && !items.length"
            title="留下好物的去处"
            description="收货地址仅用于你的商品配送，订单会保存提交当时的收货信息。"
            actionLabel="添加收货地址"
            @action="edit()"
          />
          <button
            v-if="items.length"
            class="ui-button primary-button"
            :class="loading || busy || items.length >= 20 ? 'is-disabled' : ''"
            :disabled="loading || busy || items.length >= 20"
            @click="edit()"
            >添加收货地址</button
          ><text class="ui-text address-note"
            >最多保存 20 个地址。订单会保存当时的收货信息，修改地址不会改变已提交的订单。</text
          >
        </view></view
      ></scroll-view
    ><RegionPicker
      :visible="regionVisible"
      @close="regionVisible = false"
      @select="Object.assign(form, $event)"
  /></view>
</template>
<script setup lang="ts">
import InkBackdrop from '../../components/InkBackdrop.uvue';
import RegionPicker from '../../components/RegionPicker.uvue';
import PageHead from '../../components/PageHead.uvue';
import ContentState from '../../components/ContentState.uvue';
import { request } from '../../lib/api';
import { currentUser, needLogin } from '../../lib/session';
import { addressText } from '../../lib/shopping';
import { openPage } from '../../lib/presentation';
import type { Address, AddressInput } from '../../lib/shopping';
const blank = (): AddressInput => ({
  recipient: '',
  phone: '',
  province: '',
  city: '',
  district: '',
  detail: '',
  isDefault: false,
});
const regionVisible = ref(false);
const items = ref<Address[]>([]),
  form = ref<AddressInput>(blank()),
  editing = ref(false),
  selectedId = ref(''),
  loading = ref(false),
  busy = ref(false),
  error = ref('');
let alive = true,
  turn = 0;
// 只做展示分档，不参与请求、金额与权限判断。
const errorTone = (text: string) =>
  /网络|中断|超时|繁忙|连接/.test(text)
    ? 'net'
    : /不存在|无法打开|已删除|已失效|无效/.test(text)
      ? 'gone'
      : 'bad';
async function load() {
  const owner = currentUser.value?.id;
  items.value = [];
  if (needLogin()) return;
  const version = ++turn;
  loading.value = true;
  error.value = '';
  try {
    const data = await request<Address[]>('/shopping/addresses');
    if (alive && turn === version && currentUser.value?.id === owner) items.value = data;
  } catch (e) {
    error.value = (e as Error).message;
  } finally {
    if (version === turn) loading.value = false;
  }
}
function edit(item?: Address) {
  selectedId.value = item?.id ?? '';
  form.value = item
    ? {
        recipient: item.recipient,
        phone: item.phone,
        province: item.province,
        city: item.city,
        district: item.district,
        detail: item.detail,
        isDefault: item.isDefault,
      }
    : { ...blank(), isDefault: items.value.length === 0 };
  editing.value = true;
  error.value = '';
}
function cancel() {
  editing.value = false;
  form.value = blank();
  selectedId.value = '';
  error.value = '';
}
function setDefault(event: { detail: { value: boolean } }) {
  form.value.isDefault = event.detail.value;
}
async function save() {
  if (busy.value || needLogin()) return;
  if (!/^1[3-9]\d{9}$/.test(form.value.phone)) {
    error.value = '请填写有效的手机号';
    return;
  }
  if (
    [
      form.value.recipient,
      form.value.province,
      form.value.city,
      form.value.district,
      form.value.detail,
    ].some((value) => !value.trim())
  ) {
    error.value = '请完整填写收货信息';
    return;
  }
  busy.value = true;
  error.value = '';
  try {
    await request('/shopping/addresses' + (selectedId.value ? '/' + selectedId.value : ''), {
      method: selectedId.value ? 'PATCH' : 'POST',
      data: { ...form.value },
    });
    cancel();
    await load();
    uni.showToast({ title: '地址已保存', icon: 'none' });
  } catch (e) {
    error.value = (e as Error).message;
  } finally {
    busy.value = false;
  }
}
function remove(item: Address) {
  if (busy.value) return;
  uni.showModal({
    title: '删除地址',
    content: '删除这个收货地址？',
    confirmText: '删除',
    success: async (result) => {
      if (!result.confirm || busy.value || needLogin()) return;
      busy.value = true;
      try {
        await request('/shopping/addresses/' + item.id, { method: 'DELETE' });
        await load();
      } catch (e) {
        error.value = (e as Error).message;
      } finally {
        busy.value = false;
      }
    },
  });
}
onShow(() => {
  if (!editing.value) load();
});
onUnload(() => {
  alive = false;
  turn++;
  form.value = blank();
});
</script>
<style>
@import '../../styles/app.css';
.default-label {
  font-size: 12px;
  line-height: 20px;
  color: #8a6635;
  flex-shrink: 0;
}
.address-form-title {
  margin: 16px 0 4px;
}
.address-field {
  padding: 12px 0;
}
.field-label {
  font-family: sans-serif;
  font-size: 13px;
  line-height: 22px;
  color: #5c6869;
}
.field-input {
  height: 46px;
  min-height: 46px;
  margin-top: 8px;
  padding: 0 12px;
  background-color: #fcf9f2;
  border-style: solid;
  border-width: 1px;
  border-color: #cfc5b1;
  border-radius: 10px;
  font-size: 15px;
  line-height: 26px;
  color: #182b31;
}
.field-select {
  height: 46px;
  min-height: 46px;
  margin-top: 8px;
  padding: 0 12px;
  background-color: #fcf9f2;
  border-style: solid;
  border-width: 1px;
  border-color: #cfc5b1;
  border-radius: 10px;
  justify-content: center;
}
.field-area {
  height: 96px;
  margin-top: 8px;
  padding: 12px;
  background-color: #fcf9f2;
  border-style: solid;
  border-width: 1px;
  border-color: #cfc5b1;
  border-radius: 10px;
  font-size: 15px;
  line-height: 26px;
  color: #182b31;
  width: 100%;
}
.region-value {
  font-size: 15px;
  line-height: 26px;
  color: #235663;
}
.switch-row {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  min-height: 44px;
  padding: 12px 0;
  margin-top: 4px;
  border-top-width: 1px;
  border-top-style: solid;
  border-top-color: #e0d8c8;
}
.switch-label {
  font-size: 15px;
  line-height: 26px;
  color: #182b31;
}
.switch-state {
  font-size: 12px;
  line-height: 20px;
  color: #5c6869;
  margin-right: 12px;
}
.form-feedback {
  font-size: 13px;
  line-height: 22px;
  color: #b4533f;
  margin-top: 10px;
}
.primary-button {
  margin-top: 16px;
}
.text-action {
  min-height: 44px;
  padding: 11px 8px;
  margin: 0;
  font-size: 13px;
  line-height: 22px;
  color: #235663;
  background-color: transparent;
  border-style: solid;
  border-width: 0;
  text-align: center;
}
.remove-action {
  color: #b4533f;
  margin-left: 12px;
}
.text-action.is-disabled {
  opacity: 1;
  color: #9aa5a1;
}
.address-row {
  padding: 15px 0;
  border-bottom-width: 1px;
  border-bottom-style: solid;
  border-bottom-color: #e0d8c8;
}
.address-copy {
  font-size: 13px;
  line-height: 22px;
  color: #5c6869;
  margin-top: 8px;
}
.address-actions {
  justify-content: flex-end;
  margin-top: 4px;
}
.address-note {
  font-size: 13px;
  line-height: 22px;
  color: #5c6869;
  margin-top: 12px;
}
</style>
