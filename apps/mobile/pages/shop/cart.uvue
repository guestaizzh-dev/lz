<template>
  <view class="page"
    ><InkBackdrop /><PageHead title="购物车" /><scroll-view
      class="page-scroll"
      direction="vertical"
      :show-scrollbar="false"
      ><view class="content">
        <ContentState v-if="loading" :loading="true" />
        <ContentState
          v-else-if="error && !cart?.items.length"
          :error="error"
          :error-title="
            errorTone(error) === 'net'
              ? '网络连接中断'
              : errorTone(error) === 'gone'
                ? '购物车内容不存在'
                : '购物车信息需要重新确认'
          "
          :retryable="errorTone(error) === 'net'"
          :action-label="errorTone(error) === 'net' ? '' : '去看看好物'"
          @retry="load()"
          @action="openPage('shop/index')"
        />
        <template v-else>
          <text v-if="error" class="ui-text cart-error">{{ error }}</text>
          <view v-for="item in cart?.items ?? []" :key="item.id" class="cart-row">
            <view class="cart-main">
              <view class="cart-select" @click="toggle(item)"
                ><view
                  :class="[
                    'select-box',
                    selected.includes(item.skuId) ? 'select-box-on' : '',
                    !item.available ? 'select-box-disabled' : '',
                  ]"
                  ><text v-if="selected.includes(item.skuId)" class="select-check">✓</text></view
                ></view
              >
              <view class="cart-image" @click="goProduct(item.product.id)"
                ><ArtImage
                  :src="item.product.cover"
                  :kind="artwork(item.product.cover)"
                  :width="84"
                  :height="92"
                  :radius="8"
              /></view>
              <view class="cart-copy">
                <text class="ui-text cart-title" @click="goProduct(item.product.id)">{{
                  item.product.title
                }}</text>
                <text class="ui-text cart-spec">{{ item.sku.title }}</text>
                <text class="ui-text cart-price">¥{{ money(item.sku.price) }}</text>
                <text v-if="!item.available" class="ui-text unavailable">{{
                  item.unavailableReason
                }}</text>
              </view>
            </view>
            <view class="row between cart-actions">
              <button class="ui-button cart-remove" :disabled="busy" @click="remove(item)"
                ><text class="cart-remove-label">移除</text></button
              >
              <QuantityStepper
                :value="item.quantity"
                :max="Math.min(99, item.sku.available)"
                :disabled="busy || !item.available"
                @change="change(item, $event)"
              />
            </view>
          </view>
          <ContentState
            v-if="!cart?.items.length"
            title="把喜欢的好物留下"
            description="选择商品规格后，可以加入购物车。"
            actionLabel="去看看好物"
            @action="openPage('shop/index')"
          />
          <view v-if="cart?.items.length" class="cart-service" @click="openPage('shop/addresses')"
            ><text class="ui-text cart-service-label">收货地址管理</text
            ><text class="ui-text cart-service-arrow">›</text></view
          >
          <text v-if="cart?.items.length" class="ui-text cart-note"
            >价格、库存及运费以确认订单页为准，加入购物车不锁定库存。</text
          >
        </template>
      </view></scroll-view
    ><BottomBar v-if="cart?.items.length">
      <view class="cart-summary"
        ><view class="row cart-total-row"
          ><text class="cart-total-label">合计</text
          ><text class="cart-total">¥{{ money(selectedTotal) }}</text></view
        ><text class="cart-selected-note">{{
          selected.length ? '已选 ' + selected.length + ' 项 · 运费另计' : '请选择商品'
        }}</text></view
      >
      <button
        class="ui-button bar-primary cart-checkout"
        :class="busy || !selected.length ? 'is-disabled' : ''"
        :disabled="busy || !selected.length"
        @click="checkout"
        ><text
          class="cart-checkout-label"
          :class="busy || !selected.length ? 'commerce-label-disabled' : ''"
          >{{ selected.length ? '去结算（' + selected.length + '）' : '去结算' }}</text
        ></button
      ></BottomBar
    ></view
  >
</template>
<script setup lang="ts">
import InkBackdrop from '../../components/InkBackdrop.uvue';
import QuantityStepper from '../../components/QuantityStepper.uvue';
import BottomBar from '../../components/BottomBar.uvue';
import PageHead from '../../components/PageHead.uvue';
import ArtImage from '../../components/ArtImage.uvue';
import ContentState from '../../components/ContentState.uvue';
import { request, money, goProduct } from '../../lib/api';
import { currentUser, needLogin } from '../../lib/session';
import { artwork, openPage } from '../../lib/presentation';
import type { Cart, CartItem } from '../../lib/shopping';
const cart = ref<Cart | null>(null),
  loading = ref(false),
  busy = ref(false),
  error = ref('');
let version = 0,
  alive = true,
  selectionOwner = '';
const selected = ref<string[]>([]),
  selectedTotal = computed(
    () =>
      cart.value?.items
        .filter((i) => selected.value.includes(i.skuId) && i.available)
        .reduce((sum, i) => sum + i.subtotal, 0) ?? 0,
  );
// 只做展示分档，不参与请求、金额与权限判断。
const errorTone = (text: string) =>
  /网络|中断|超时|繁忙|连接/.test(text)
    ? 'net'
    : /不存在|无法打开|已删除|已失效|无效/.test(text)
      ? 'gone'
      : 'bad';
function toggle(item: CartItem) {
  if (!item.available) return;
  if (!selected.value.includes(item.skuId) && selected.value.length >= 30) {
    uni.showToast({ title: '每次最多结算30个规格', icon: 'none' });
    return;
  }
  selected.value = selected.value.includes(item.skuId)
    ? selected.value.filter((id) => id !== item.skuId)
    : [...selected.value, item.skuId];
}
function checkout() {
  if (busy.value) return;
  const items =
    cart.value?.items
      .filter((i) => i.available && selected.value.includes(i.skuId))
      .map((i) => ({ skuId: i.skuId, quantity: i.quantity })) ?? [];
  if (!items.length) {
    uni.showToast({ title: '请选择可售商品', icon: 'none' });
    return;
  }
  openPage('order/confirm?type=product&items=' + encodeURIComponent(JSON.stringify(items)));
}
async function load(preserve = false) {
  const owner = currentUser.value?.id;
  if (selectionOwner !== (owner ?? '')) {
    selected.value = [];
    selectionOwner = owner ?? '';
  }
  if (!preserve) cart.value = null;
  if (needLogin()) return;
  const turn = ++version;
  loading.value = !cart.value;
  error.value = '';
  try {
    const data = await request<Cart>('/shopping/cart');
    if (alive && turn === version && currentUser.value?.id === owner) {
      cart.value = data;
      selected.value = selected.value.filter((id) =>
        data.items.some((i) => i.skuId === id && i.available),
      );
    }
  } catch (e) {
    error.value = (e as Error).message;
  } finally {
    if (turn === version) loading.value = false;
  }
}
async function change(item: CartItem, delta: number) {
  if (busy.value || needLogin()) return;
  if (delta < 0 && item.quantity <= 1) return;
  if (delta > 0 && (item.quantity >= 99 || item.quantity >= item.sku.available)) return;
  busy.value = true;
  try {
    await request('/shopping/cart/' + item.skuId, {
      method: 'PUT',
      data: { quantity: item.quantity + delta },
    });
    await load(true);
  } catch (e) {
    error.value = (e as Error).message;
  } finally {
    busy.value = false;
  }
}
function remove(item: CartItem) {
  if (busy.value) return;
  uni.showModal({
    title: '移除好物',
    content: '将此规格从购物车移除？',
    confirmText: '移除',
    success: async (result) => {
      if (!result.confirm || busy.value || needLogin()) return;
      busy.value = true;
      try {
        await request('/shopping/cart/' + item.id, { method: 'DELETE' });
        await load(true);
      } catch (e) {
        error.value = (e as Error).message;
      } finally {
        busy.value = false;
      }
    },
  });
}
onShow(() => load());
onUnload(() => {
  alive = false;
  version++;
});
</script>
<style>
@import '../../styles/app.css';
.content {
  padding-top: 8px;
  padding-bottom: 24px;
}
.cart-row {
  padding: 14px 12px 8px;
  margin-bottom: 12px;
  border-width: 1px;
  border-style: solid;
  border-color: #e5ded1;
  border-radius: 14px;
  background-color: #fcf9f2;
}
.cart-main {
  flex-direction: row;
  align-items: flex-start;
}
.cart-select {
  width: 28px;
  min-height: 92px;
  flex-shrink: 0;
  align-items: flex-start;
  justify-content: center;
}
.select-box {
  width: 20px;
  height: 20px;
  border-width: 1px;
  border-style: solid;
  border-color: #c9bfad;
  border-radius: 10px;
  align-items: center;
  justify-content: center;
}
.select-box-on {
  background-color: #235663;
  border-color: #235663;
}
.select-box-disabled {
  opacity: 0.35;
}
.select-check {
  font-family: sans-serif;
  color: #fcf9f2;
  font-size: 12px;
  line-height: 18px;
}
.cart-image {
  flex-shrink: 0;
}
.cart-copy {
  flex: 1;
  min-width: 0;
  padding-left: 12px;
}
.cart-title {
  font-family: sans-serif;
  font-size: 15px;
  line-height: 22px;
  font-weight: 600;
  color: #182b31;
}
.cart-spec {
  align-self: flex-start;
  font-size: 12px;
  line-height: 18px;
  color: #6a7578;
  background-color: #f0ede7;
  padding: 3px 7px;
  border-radius: 5px;
  margin-top: 6px;
}
.cart-price {
  font-family: sans-serif;
  font-size: 19px;
  line-height: 28px;
  color: #b4533f;
  font-weight: 600;
  margin-top: 8px;
}
.unavailable {
  color: #b4533f;
  font-size: 12px;
  line-height: 18px;
  margin-top: 4px;
}
.cart-actions {
  margin-top: 4px;
  margin-left: 28px;
}
.cart-remove {
  min-height: 44px;
  padding: 0 6px;
  margin: 0;
  background-color: transparent;
  align-items: center;
  justify-content: center;
}
.cart-remove-label {
  font-family: sans-serif;
  color: #6a7578;
  font-size: 12px;
  line-height: 44px;
}
.cart-service {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-top: 4px;
  padding: 14px;
  background-color: #fcf9f2;
  border-radius: 12px;
}
.cart-service-label {
  font-size: 14px;
  line-height: 22px;
  color: #344c54;
}
.cart-service-arrow {
  font-size: 20px;
  line-height: 24px;
  color: #6a7578;
}
.cart-note {
  font-size: 12px;
  line-height: 20px;
  color: #8a8d84;
  margin: 12px 4px 0;
}
.cart-error {
  font-size: 13px;
  line-height: 22px;
  color: #b4533f;
  background-color: #f1e8d8;
  border-radius: 10px;
  padding: 12px;
  margin-bottom: 8px;
}
.cart-summary {
  flex: 1;
  min-width: 0;
  margin-right: 12px;
}
.cart-total-row {
  align-items: center;
  flex-wrap: wrap;
}
.cart-total-label {
  font-family: sans-serif;
  font-size: 13px;
  line-height: 24px;
  color: #344c54;
  margin-right: 6px;
}
.cart-total {
  font-family: sans-serif;
  font-size: 21px;
  line-height: 28px;
  color: #b4533f;
  font-weight: 600;
}
.cart-selected-note {
  font-family: sans-serif;
  font-size: 11px;
  line-height: 18px;
  color: #6a7578;
}
.cart-checkout {
  flex: 0;
  flex-shrink: 0;
  min-width: 124px;
  height: 48px;
  min-height: 48px;
  padding: 0 16px;
  align-items: center;
  justify-content: center;
}
.cart-checkout-label {
  font-family: sans-serif;
  font-size: 15px;
  line-height: 48px;
  color: #fcf9f2;
  text-align: center;
  font-weight: 600;
}
.commerce-label-disabled {
  color: #8a887f;
}
</style>
