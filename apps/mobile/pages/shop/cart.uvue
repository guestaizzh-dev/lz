<template>
<view class="page"><PageHead title="购物车"/><scroll-view class="page-scroll" direction="vertical" :show-scrollbar="false"><view class="content">
<ContentState v-if="loading||error" :loading="loading" :error="error" @retry="load()"/>
<view v-for="item in cart?.items??[]" :key="item.id" class="cart-row">
<view class="row between" @click="toggle(item)"><view class="row cart-select"><view :class="['select-box',selected.includes(item.skuId)?'select-box-on':'']"><text v-if="selected.includes(item.skuId)" class="select-check">✓</text></view><text class="select-label">{{selected.includes(item.skuId)?'已选择':'选择商品'}}</text></view><text v-if="!item.available" class="meta">暂不可结算</text></view>
<view class="row" @click="goProduct(item.product.id)"><ArtImage :src="item.product.cover" :kind="artwork(item.product.cover)" :width="76" :height="86"/><view class="cart-copy grow"><text class="item-title">{{item.product.title}}</text><text class="meta">{{item.sku.title}}</text><text class="price">¥{{money(item.sku.price)}}</text><text v-if="!item.available" class="unavailable">{{item.unavailableReason}}</text></view></view>
<view class="row between cart-actions"><button class="text-action" :class="busy?'is-disabled':''" @click="remove(item)">移除</button><view class="row stepper"><button class="quantity-button" :class="busy||item.quantity<=1?'is-disabled':''" aria-label="减少数量" @click="change(item,-1)"><AppIcon name="minus" :size="14"/></button><text class="quantity">{{item.quantity}}</text><button class="quantity-button" :class="busy||item.quantity>=99||item.quantity>=item.sku.available?'is-disabled':''" aria-label="增加数量" @click="change(item,1)"><AppIcon name="plus" :size="14"/></button></view></view>
</view>
<ContentState v-if="!loading&&!error&&!cart?.items.length" title="把喜欢的好物留下" description="选择商品规格后，可以加入购物车。" actionLabel="去看看好物" @action="openPage('shop/index')"/>
<button class="retry" @click="openPage('shop/addresses')">管理收货地址</button>
<text class="footer-note">购物车不锁定库存。价格和库存以提交订单时为准。</text>
<text class="footer-note">实物商品单独结算，下单前将重新核算配送费用。</text>
</view></scroll-view><BottomBar v-if="cart?.items.length"><text class="cart-total">已选合计 ¥{{money(selectedTotal)}}</text><button class="bar-primary" :class="busy||!selected.length?'is-disabled':''" @click="checkout">确认配送与结算</button></BottomBar></view>
</template>
<script setup lang="ts">
import BottomBar from '../../components/BottomBar.uvue';
import PageHead from '../../components/PageHead.uvue';import ArtImage from '../../components/ArtImage.uvue';import ContentState from '../../components/ContentState.uvue';import AppIcon from '../../components/AppIcon.uvue';import {request,money,goProduct} from '../../lib/api';import {currentUser,needLogin} from '../../lib/session';import {artwork,openPage} from '../../lib/presentation';import type {Cart,CartItem} from '../../lib/shopping';
const cart=ref<Cart|null>(null),loading=ref(false),busy=ref(false),error=ref('');let version=0,alive=true,selectionOwner='';
const selected=ref<string[]>([]),selectedTotal=computed(()=>cart.value?.items.filter(i=>selected.value.includes(i.skuId)&&i.available).reduce((sum,i)=>sum+i.subtotal,0)??0);
function toggle(item:CartItem){if(!item.available)return;if(!selected.value.includes(item.skuId)&&selected.value.length>=30){uni.showToast({title:'每次最多结算30个规格',icon:'none'});return;}selected.value=selected.value.includes(item.skuId)?selected.value.filter(id=>id!==item.skuId):[...selected.value,item.skuId];}
function checkout(){const items=cart.value?.items.filter(i=>i.available&&selected.value.includes(i.skuId)).map(i=>({skuId:i.skuId,quantity:i.quantity}))??[];if(!items.length){uni.showToast({title:'请选择可售商品',icon:'none'});return;}openPage('order/confirm?type=product&items='+encodeURIComponent(JSON.stringify(items)));}
async function load(){const owner=currentUser.value?.id;if(selectionOwner!==(owner??'')){selected.value=[];selectionOwner=owner??'';}cart.value=null;if(needLogin())return;const turn=++version;loading.value=true;error.value='';try{const data=await request<Cart>('/shopping/cart');if(alive&&turn===version&&currentUser.value?.id===owner){cart.value=data;selected.value=selected.value.filter(id=>data.items.some(i=>i.skuId===id&&i.available));}}catch(e){error.value=(e as Error).message;}finally{if(turn===version)loading.value=false;}}
async function change(item:CartItem,delta:number){if(busy.value||needLogin())return;if(delta<0&&item.quantity<=1)return;if(delta>0&&(item.quantity>=99||item.quantity>=item.sku.available))return;busy.value=true;try{await request('/shopping/cart/'+item.skuId,{method:'PUT',data:{quantity:item.quantity+delta}});await load();}catch(e){error.value=(e as Error).message;}finally{busy.value=false;}}
function remove(item:CartItem){if(busy.value)return;uni.showModal({title:'移除好物',content:'将此规格从购物车移除？',confirmText:'移除',success:async result=>{if(!result.confirm||busy.value||needLogin())return;busy.value=true;try{await request('/shopping/cart/'+item.id,{method:'DELETE'});await load();}catch(e){error.value=(e as Error).message;}finally{busy.value=false;}}});}
onShow(()=>load());onUnload(()=>{alive=false;version++;});
</script>
<style>@import '../../styles/app.css';.cart-select{min-height:44px;padding:11px 0;}.select-box{width:20px;height:20px;border-width:1px;border-style:solid;border-color:#A3AEAB;border-radius:4px;align-items:center;justify-content:center;margin-right:8px;}.select-box-on{background-color:#245564;border-color:#245564;}.select-check{color:#FAF8F2;font-size:13px;line-height:18px;}.select-label{font-family:AcademySans;font-size:13px;line-height:22px;color:#245564;}.cart-row{padding:18px 0;border-bottom-style:solid;border-bottom-width:1px;border-bottom-color:#E4DFD4;}.cart-copy{padding-left:13px;}.cart-actions{margin-top:10px;}.stepper{flex-direction:row;align-items:center;border-style:solid;border-width:1px;border-color:#E2DCD1;border-radius:23px;overflow:hidden;}.quantity-button{background-color:transparent;color:#245564;margin:0;width:40px;height:44px;min-height:44px;padding:0;align-items:center;justify-content:center;border-width:0;border-style:solid;}.quantity{color:#17292D;font-size:14px;min-width:30px;text-align:center;padding:0;line-height:21px;}.text-action{color:#788084;background-color:transparent;margin:0;padding:10px 0;font-size:13px;line-height:24px;border-width:0;border-style:solid;}.unavailable{color:#B95543;font-size:11px;line-height:18px;margin-top:5px;}.cart-total{font-family:AcademySans;color:#17292D;font-size:14px;line-height:21px;margin-right:14px;}</style>
