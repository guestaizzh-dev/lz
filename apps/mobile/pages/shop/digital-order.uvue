  font-size: 13px;
  line-height: 22px;
  color: #b4533f;
  margin-top: 12px;
}
.sum-row {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 14px 0;
  border-bottom-width: 1px;
  border-bottom-style: solid;
  border-bottom-color: #e0d8c8;
}
.sum-row-last {
  border-bottom-width: 0;
  padding-bottom: 0;
}
.sum-label {
  font-size: 14px;
  line-height: 24px;
  color: #344c54;
}
.sum-value {
  font-size: 15px;
  line-height: 26px;
  color: #182b31;
  text-align: right;
  margin-left: 12px;
  width: 64%;
}
.sum-label-total {
  font-size: 15px;
  line-height: 26px;
  color: #182b31;
  font-weight: 600;
}
.sum-value-total {
  font-family: AcademySerif;
  font-size: 19px;
  line-height: 28px;
  color: #b4533f;
  font-weight: 600;
  text-align: right;
  margin-left: 12px;
}
