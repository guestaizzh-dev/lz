  color: #235663;
  font-weight: 600;
}
.consent-row {
  flex-direction: row;
  align-items: flex-start;
  padding: 16px 0 0;
}
.consent-box {
  width: 20px;
  height: 20px;
  border-width: 1px;
  border-style: solid;
  border-color: #cfc5b1;
  border-radius: 4px;
  align-items: center;
  justify-content: center;
  margin-right: 12px;
  flex-shrink: 0;
  margin-top: 1px;
}
.consent-box-on {
  background-color: #235663;
  border-color: #235663;
}
.consent-check {
  color: #fcf9f2;
  font-size: 13px;
  line-height: 18px;
}
.consent-text {
  font-size: 13px;
  line-height: 22px;
  color: #344c54;
}
.file-row {
  flex-direction: row;
  align-items: center;
  padding: 14px 0;
  border-bottom-width: 1px;
  border-bottom-style: solid;
  border-bottom-color: #e0d8c8;
}
.file-action {
  flex-shrink: 0;
  margin-left: 12px;
  min-height: 44px;
  padding: 11px 10px;
  font-size: 13px;
  line-height: 22px;
  color: #235663;
  background-color: transparent;
  border-style: solid;
  border-width: 0;
}
.file-action.is-disabled {
  opacity: 1;
  color: #9aa5a1;
}
.text-button {
  min-height: 44px;
  margin: 0;
  padding: 11px 0;
  font-size: 13px;
