<template>
  <view class="page"
    ><InkBackdrop /><PageHead title="数字资料" /><scroll-view
      class="page-scroll"
      direction="vertical"
      :show-scrollbar="false"
      ><view class="content">
        <ContentState v-if="loading && !quote && !order" :loading="true" />
        <ContentState
          v-else-if="error"
          :error="error"
          :error-title="
            errorTone(error) === 'net'
              ? '网络连接中断'
              : errorTone(error) === 'gone'
                ? '资料地址无效'
                : '资料信息需要重新确认'
          "
          :retryable="errorTone(error) === 'net'"
          :action-label="errorTone(error) === 'net' ? '' : '返回我的资料'"
          @retry="load"
          @action="openPage('shop/digital')"
        />
        <view v-if="quote && !order" class="detail-card"
          ><text class="ui-text eyebrow">数字资料</text
          ><text class="ui-text detail-title">{{ quote!.title }}</text
          ><text class="ui-text body-line digital-copy">{{ quote!.description }}</text
          ><text class="ui-text meta"
            >{{ quote!.releaseNo }} ·
            {{ quote!.accessDays ? quote!.accessDays + '天领取期限' : '长期领取' }}</text
          ><view v-if="quote!.voucherEligible" class="sum-row">
            <text class="ui-text sum-label">代金券 · 可用 {{ quote!.voucher.available }} 份</text>
            <QuantityStepper
              :value="voucherQuantity"
              :min="0"
              :max="quote!.voucher.maximum"
              :disabled="loading || busy"
              @change="changeVouchers"
            /> </view
          ><view v-if="quote!.voucher.discount" class="sum-row"
            ><text class="ui-text sum-label">代金券抵扣</text
            ><text class="ui-text sum-value">−¥{{ money(quote!.voucher.discount) }}</text></view
          >
          <button class="ui-button text-button" @click="showRules(quote!.refundPolicy)"
            >交付与退款规则</button
          ><view
            v-for="item in quote!.channels.filter((c) => c.enabled)"
            :key="item.channel"
            class="sum-row"
            @click="channel = item.channel"
            ><text class="ui-text sum-label">{{ item.label }}</text
            ><text
              :class="[
                'ui-text',
                'choice-state',
                channel === item.channel ? 'choice-state-on' : '',
              ]"
              >{{ channel === item.channel ? '已选择' : '选择' }}</text
            ></view
          ><view class="sum-row sum-row-last digital-price-row"
            ><text class="ui-text sum-label-total">应付</text
            ><text class="ui-text sum-value-total">¥{{ money(Number(quote!.price)) }}</text></view
          ><view class="consent-row" @click="agreed = !agreed"
            ><view :class="['consent-box', agreed ? 'consent-box-on' : '']"
              ><text v-if="agreed" class="ui-text consent-check">✓</text></view
            ><text class="ui-text consent-text grow">我已阅读并同意资料交付与售后规则</text></view
          ><text v-if="!quote!.paymentEnabled" class="ui-text field-note">{{
            quote!.unavailableReason
          }}</text></view
        >
        <template v-if="order"
          ><view class="detail-card"
            ><text class="ui-text eyebrow">数字资料</text
            ><text class="ui-text detail-title">{{ order!.pack?.title ?? '数字资料' }}</text
            ><text class="ui-text state-label">{{ digitalState(order!) }}</text
            ><text class="ui-text body-line digital-copy">{{ order!.pack?.description }}</text
            ><view class="sum-row"
              ><text class="ui-text sum-label">订单编号</text
              ><text class="ui-text sum-value" :user-select="true">{{ order!.orderNo }}</text></view
            ><view class="sum-row"
              ><text class="ui-text sum-label">下单时间</text
              ><text class="ui-text sum-value">{{ formatChinaTime(order!.createdAt) }}</text></view
            ><view v-if="order!.delivery?.expiresAt" class="sum-row"
              ><text class="ui-text sum-label">领取截至</text
              ><text class="ui-text sum-value">{{
                formatChinaTime(order!.delivery!.expiresAt!)
              }}</text></view
            ><view class="sum-row sum-row-last"
              ><text class="ui-text sum-label-total">实付</text
              ><text class="ui-text sum-value-total"
                >¥{{ money(Number(order!.paidTotal)) }}</text
              ></view
            ><text v-if="order!.delivery?.revokedAt" class="ui-text field-note"
              >本单领取权益已撤销。</text
            ></view
          >
          <view v-if="order!.delivery" class="detail-card"
            ><text class="ui-text section-heading">购买时的资料</text
            ><view v-for="file in order!.pack?.files ?? []" :key="file.id" class="file-row"
              ><view class="grow"
                ><text class="ui-text item-title">{{ file.name }}</text
                ><text class="ui-text meta">{{ Math.ceil(file.bytes / 1024) }} KB</text></view
              ><button
                class="ui-button text-button file-action"
                :class="busy || !order!.canReceive ? 'is-disabled' : ''"
                :disabled="busy || !order!.canReceive"
                @click="receive(file)"
                >{{ order!.canReceive ? '领取 / 打开' : '暂不可领取' }}</button
              ></view
            ><ForumMedia
              v-if="mediaFile && order!.canReceive"
              :digitalDeliveryId="order!.delivery!.id"
              :assetId="mediaFile!.id"
              :type="mediaFile!.mime.startsWith('video/') ? 'video' : 'audio'"
          /></view>
          <view class="detail-card"
            ><text class="ui-text section-heading">售后与交付说明</text
            ><button class="ui-button text-button" @click="showRules(order!.refundPolicy)"
              >交付与退款规则</button
            ><view v-for="refund in order!.refunds" :key="refund.id" class="refund-entry"
              ><text class="ui-text item-title">{{ refundLabel(refund.state) }}</text
              ><text class="ui-text body-line">{{ refund.description }}</text
              ><text v-if="refund.reviewNote" class="ui-text meta">{{
                refund.reviewNote
              }}</text></view
            ><button
              v-if="order!.canRefund"
              class="ui-button secondary-button"
              :class="busy ? 'is-disabled' : ''"
              :disabled="busy"
              @click="refundOpen = true"
              >申请未领取退款</button
            ><button
              class="ui-button text-button"
              @click="openPage('profile/feedback?orderId=' + order!.id)"
              >联系书院核查</button
            ></view
          ></template
        >
        <text v-if="notice" class="ui-text field-note">{{ notice }}</text></view
      ></scroll-view
    ><BottomBar v-if="quote || order"
      ><button
        v-if="quote && !order"
        class="ui-button bar-primary"
        :class="busy || !agreed || !quote!.paymentEnabled || !channel ? 'is-disabled' : ''"
        :disabled="busy || !agreed || !quote!.paymentEnabled || !channel"
        @click="checkout"
        >{{ busy ? '正在确认…' : !agreed ? '勾选交付与售后规则' : '确认购买' }}</button
      ><template v-if="order"
        ><button
          class="ui-button bar-secondary"
          :class="busy ? 'is-disabled' : ''"
          :disabled="busy"
          @click="refresh"
          >查询状态</button
        ><button
          v-if="order!.state === 'PENDING'"
          class="ui-button text-button bar-cancel"
          :class="busy ? 'is-disabled' : ''"
          :disabled="busy"
          @click="cancel"
          >取消订单</button
        ><button
          v-if="order!.state === 'PENDING'"
          class="ui-button bar-primary"
          :class="busy ? 'is-disabled' : ''"
          :disabled="busy"
          @click="pay"
          >继续付款</button
        ></template
      ></BottomBar
    >
    <ComposeSheet
      :visible="refundOpen"
      title="申请资料退款"
      :saving="busy"
      @close="refundOpen = false"
      @submit="refund"
    >
      <textarea
        v-model="reason"
        class="ui-input compose-input"
        placeholder="请说明退款原因"
        :maxlength="1000"
      /><text class="ui-text meta">{{ formError }}</text></ComposeSheet
    ></view
  >
</template>
<script setup lang="ts">
import InkBackdrop from '../../components/InkBackdrop.uvue';
import PageHead from '../../components/PageHead.uvue';
import QuantityStepper from '../../components/QuantityStepper.uvue';
import ContentState from '../../components/ContentState.uvue';
import BottomBar from '../../components/BottomBar.uvue';
import ComposeSheet from '../../components/ComposeSheet.uvue';
import ForumMedia from '../../components/ForumMedia.uvue';
import { request, money, apiBase } from '../../lib/api';
import { needLogin, currentUser, sessionGeneration } from '../../lib/session';
import { studyEventId } from '../../lib/learning';
import { purchasePlatform } from '../../lib/course-sales';
import { openPage } from '../../lib/presentation';
import { formatChinaTime } from '../../lib/date-time';
import { digitalState, payDigitalOrder } from '../../lib/digital';
import type { DigitalOrder, DigitalQuote, DigitalFile } from '../../lib/digital';
const order = ref<DigitalOrder | null>(null),
  quote = ref<DigitalQuote | null>(null),
  loading = ref(false),
  busy = ref(false),
  error = ref(''),
  notice = ref(''),
  agreed = ref(false),
  voucherQuantity = ref(0),
  channel = ref(''),
  refundOpen = ref(false),
  reason = ref(''),
  formError = ref(''),
  mediaFile = ref<DigitalFile | null>(null);
let id = '',
  skuId = '',
  requestKey = studyEventId(),
  refundKey = studyEventId(),
  sequence = 0;
const refundLabel = (state: string) =>
  (
    ({
      REQUESTED: '等待处理',
      REFUNDING: '原路退款中',
      SUCCEEDED: '已退款',
      FAILED: '退款待核查',
      REJECTED: '申请未通过',
    }) as Record<string, string>
  )[state] ?? '处理中';
// 只做展示分档，不参与请求、金额与权限判断。
const errorTone = (text: string) =>
  /网络|中断|超时|繁忙|连接/.test(text)
    ? 'net'
    : /不存在|无法打开|已删除|已失效|无效/.test(text)
      ? 'gone'
      : 'bad';
function showRules(content: string) {
  uni.showModal({ title: '交付与退款规则', content, showCancel: false });
}
async function changeVouchers(value: number) {
  if (busy.value || loading.value) return;
  const previous = voucherQuantity.value;
  voucherQuantity.value = Math.max(0, previous + value);
  await load();
  if (error.value) voucherQuantity.value = previous;
  requestKey = studyEventId();
}
async function load() {
  if (needLogin()) return;
  const turn = ++sequence,
    owner = sessionGeneration();
  loading.value = true;
  error.value = '';
  try {
    if (id) {
      const row = await request<DigitalOrder>('/commerce/digital-orders/' + id);
      if (turn === sequence && owner === sessionGeneration()) order.value = row;
    } else if (skuId) {
      const row = await request<DigitalQuote>(
        '/commerce/digital-products/' +
          skuId +
          '/quote?platform=' +
          purchasePlatform() +
          '&voucherQuantity=' +
          voucherQuantity.value,
      );
      if (turn === sequence && owner === sessionGeneration()) {
        quote.value = row;
        channel.value =
          row.channels.find((c) => c.enabled)?.channel ??
          (Number(row.price) === 0 ? 'WECHAT_NATIVE' : '');
      }
    } else error.value = '资料地址无效';
  } catch (e) {
    if (turn === sequence) error.value = (e as Error).message;
  } finally {
    if (turn === sequence) loading.value = false;
  }
}
async function operate(action: () => Promise<void>) {
  if (busy.value) return;
  const owner = sessionGeneration();
  busy.value = true;
  notice.value = '';
  try {
    await action();
  } catch (e) {
    if (owner === sessionGeneration()) notice.value = (e as Error).message;
  } finally {
    busy.value = false;
  }
}
async function checkout() {
  if (!quote.value || !agreed.value) return;
  await operate(async () => {
    const owner = sessionGeneration(),
      result = await request<DigitalOrder>('/commerce/digital-orders', {
        method: 'POST',
        data: {
          skuId,
          requestKey,
          channel: channel.value,
          platform: purchasePlatform(),
          voucherQuantity: voucherQuantity.value,
          quoteHash: quote.value!.quoteHash,
        },
      });
    if (owner !== sessionGeneration()) return;
    id = result.id;
    order.value = result;
    quote.value = null;
    notice.value = result.state === 'COMPLETED' ? '购买成功' : '订单已保存';
  });
}
async function refresh() {
  await operate(async () => {
    const owner = sessionGeneration(),
      result = await request<DigitalOrder>('/commerce/digital-orders/' + id + '/refresh', {
        method: 'POST',
      });
    if (owner === sessionGeneration()) order.value = result;
  });
}
async function cancel() {
  await operate(async () => {
    const owner = sessionGeneration(),
      result = await request<DigitalOrder>('/commerce/digital-orders/' + id + '/cancel', {
        method: 'POST',
      });
    if (owner === sessionGeneration()) order.value = result;
  });
}
async function pay() {
  if (!order.value) return;
  await operate(async () => {
    const owner = sessionGeneration(),
      result = await payDigitalOrder(order.value!);
    if (owner === sessionGeneration()) {
      order.value = result.order;
      notice.value = result.notice;
    }
  });
}
async function refund() {
  if (reason.value.trim().length < 2) {
    formError.value = '请填写至少两个字的原因';
    return;
  }
  await operate(async () => {
    const owner = sessionGeneration(),
      result = await request<DigitalOrder>('/commerce/digital-orders/' + id + '/refunds', {
        method: 'POST',
        data: { requestKey: refundKey, reason: reason.value },
      });
    if (owner === sessionGeneration()) {
      order.value = result;
      refundOpen.value = false;
      refundKey = studyEventId();
    }
  });
}
function receive(file: DigitalFile) {
  if (!order.value?.canReceive || busy.value) return;
  uni.showModal({
    title: '确认领取资料',
    content: '开始观看或领取后，将不再支持未使用退款。',
    confirmText: '确认领取',
    success: (result) => {
      if (!result.confirm) return;
      if (file.mime.startsWith('video/') || file.mime.startsWith('audio/')) {
        mediaFile.value = file;
        return;
      }
      void operate(async () => {
        const owner = sessionGeneration(),
          ticket = await request<{ path: string }>(
            '/me/digital/' + order.value!.delivery!.id + '/files/' + file.id,
            { method: 'POST' },
          );
        if (owner !== sessionGeneration()) return;
        const path = await new Promise<string>((resolve, reject) =>
          uni.downloadFile({
            url: apiBase + ticket.path,
            success: (r) =>
              r.statusCode === 200
                ? resolve(r.tempFilePath)
                : reject(Error('领取失败，请重新获取文件')),
            fail: () => reject(Error('下载中断，请重试')),
          }),
        );
        if (owner !== sessionGeneration()) return;
        if (file.mime.startsWith('image/')) uni.previewImage({ urls: [path] });
        else
          uni.openDocument({
            filePath: path,
            showMenu: true,
            fail: () => {
              notice.value = '文件已下载；当前设备无法打开，可联系书院获取帮助。';
            },
          });
        await load();
      });
    },
  });
}
watch(
  () => currentUser.value?.id,
  () => {
    sequence++;
    order.value = null;
    quote.value = null;
    mediaFile.value = null;
    refundOpen.value = false;
  },
);
onLoad((options) => {
  id = options?.id ?? '';
  skuId = options?.skuId ?? '';
});
onShow(() => void load());
onHide(() => {
  sequence++;
  loading.value = false;
  mediaFile.value = null;
});
</script>
<style>
