<template>
<view class="page"><PageHead title="数字资料"/><scroll-view class="page-scroll" direction="vertical" :show-scrollbar="false"><view class="content"><ContentState v-if="loading||error" :loading="loading" :error="error" @retry="load"/>
<view v-if="quote&&!order" class="digital-section"><text class="detail-title">{{quote!.title}}</text><text class="price digital-section-price">¥{{money(Number(quote!.price))}}</text><text class="body-copy digital-section-copy">{{quote!.description}}</text><text class="meta digital-section-meta">版本 {{quote!.releaseNo}} · {{quote!.accessDays?quote!.accessDays+'天领取期限':'长期领取'}}</text><text class="body-copy digital-section-copy">{{quote!.refundPolicy}}</text><view v-for="item in quote!.channels.filter(c=>c.enabled)" :key="item.channel" class="menu-row" @click="channel=item.channel"><text class="body-copy digital-section-copy">{{item.label}}</text><text class="tag">{{channel===item.channel?'已选择':'选择'}}</text></view><button class="secondary-button" @click="agreed=!agreed">{{agreed?'已同意':'请阅读并同意'}}资料交付与售后规则</button><text v-if="!quote!.paymentEnabled" class="meta digital-section-meta">{{quote!.unavailableReason}}</text></view>
<template v-if="order"><view class="digital-section"><text class="detail-title">{{order!.pack?.title??'数字资料'}}</text><text class="tag">{{digitalState(order!)}}</text><text class="body-copy digital-section-copy">{{order!.pack?.description}}</text><text class="meta digital-section-meta">订单 {{order!.orderNo}}</text><text class="meta digital-section-meta">{{formatChinaTime(order!.createdAt)}}</text><text class="price digital-section-price">实付 ¥{{money(Number(order!.paidTotal))}}</text><text v-if="order!.delivery?.expiresAt" class="meta digital-section-meta">领取截至 {{formatChinaTime(order!.delivery!.expiresAt!)}}</text><text v-if="order!.delivery?.revokedAt" class="body-copy digital-section-copy">本单领取权益已撤销。</text></view>
<view v-if="order!.delivery" class="digital-section"><text class="section-heading">购买时的资料</text><text class="meta digital-section-meta">首次领取即开始交付，请确认后继续。文件打不开可在原订单联系客服核查。</text><view v-for="file in order!.pack?.files??[]" :key="file.id" class="menu-row"><view class="grow"><text class="item-title">{{file.name}}</text><text class="meta digital-section-meta">{{Math.ceil(file.bytes/1024)}} KB</text></view><button class="text-button" :disabled="busy||!order!.canReceive" @click="receive(file)">{{order!.canReceive?'领取 / 打开':'暂不可领取'}}</button></view><ForumMedia v-if="mediaFile&&order!.canReceive" :digitalDeliveryId="order!.delivery!.id" :assetId="mediaFile!.id" :type="mediaFile!.mime.startsWith('video/')?'video':'audio'"/></view>
<view class="digital-section"><text class="section-heading">售后与交付说明</text><text class="body-copy digital-section-copy">{{order!.refundPolicy}}</text><view v-for="refund in order!.refunds" :key="refund.id"><text class="item-title">{{refundLabel(refund.state)}}</text><text class="body-copy digital-section-copy">{{refund.description}}</text><text v-if="refund.reviewNote" class="meta digital-section-meta">{{refund.reviewNote}}</text></view><button v-if="order!.canRefund" class="secondary-button" :disabled="busy" @click="refundOpen=true">申请未领取退款</button><button class="text-button" @click="openPage('profile/feedback?orderId='+order!.id)">联系书院核查</button></view></template>
<text v-if="notice" class="body-copy digital-section-copy">{{notice}}</text></view></scroll-view><BottomBar><button v-if="quote&&!order" class="primary-button grow" :disabled="busy||!agreed||!quote!.paymentEnabled||!channel" @click="checkout">{{busy?'正在确认…':'确认购买'}}</button><template v-if="order"><button class="secondary-button grow" :disabled="busy" @click="refresh">查询状态</button><button v-if="order!.state==='PENDING'" class="text-button" :disabled="busy" @click="cancel">取消订单</button><button v-if="order!.state==='PENDING'" class="primary-button grow" :disabled="busy" @click="pay">继续付款</button></template></BottomBar>
<ComposeSheet :visible="refundOpen" title="申请资料退款" :saving="busy" @close="refundOpen=false" @submit="refund"><textarea v-model="reason" class="compose-input" placeholder="请说明退款原因" :maxlength="1000"/><text class="meta digital-section-meta">{{formError}}</text></ComposeSheet></view>
</template>
<script setup lang="ts">
import PageHead from '../../components/PageHead.uvue';import ContentState from '../../components/ContentState.uvue';import BottomBar from '../../components/BottomBar.uvue';import ComposeSheet from '../../components/ComposeSheet.uvue';import ForumMedia from '../../components/ForumMedia.uvue';import {request,money,apiBase} from '../../lib/api';import {needLogin,currentUser,sessionGeneration} from '../../lib/session';import {studyEventId} from '../../lib/learning';import {purchasePlatform} from '../../lib/course-sales';import {openPage} from '../../lib/presentation';import {formatChinaTime} from '../../lib/date-time';import {digitalState,payDigitalOrder} from '../../lib/digital';import type {DigitalOrder,DigitalQuote,DigitalFile} from '../../lib/digital';
const order=ref<DigitalOrder|null>(null),quote=ref<DigitalQuote|null>(null),loading=ref(false),busy=ref(false),error=ref(''),notice=ref(''),agreed=ref(false),channel=ref(''),refundOpen=ref(false),reason=ref(''),formError=ref(''),mediaFile=ref<DigitalFile|null>(null);let id='',skuId='',requestKey=studyEventId(),refundKey=studyEventId(),sequence=0;
const refundLabel=(state:string)=>({REQUESTED:'等待处理',REFUNDING:'原路退款中',SUCCEEDED:'已退款',FAILED:'退款待核查',REJECTED:'申请未通过'} as Record<string,string>)[state]??'处理中';
async function load(){if(needLogin())return;const turn=++sequence,owner=sessionGeneration();loading.value=true;error.value='';try{if(id){const row=await request<DigitalOrder>('/commerce/digital-orders/'+id);if(turn===sequence&&owner===sessionGeneration())order.value=row;}else if(skuId){const row=await request<DigitalQuote>('/commerce/digital-products/'+skuId+'/quote?platform='+purchasePlatform());if(turn===sequence&&owner===sessionGeneration()){quote.value=row;channel.value=row.channels.find(c=>c.enabled)?.channel??'';}}else error.value='资料地址无效';}catch(e){if(turn===sequence)error.value=(e as Error).message;}finally{if(turn===sequence)loading.value=false;}}
async function operate(action:()=>Promise<void>){if(busy.value)return;const owner=sessionGeneration();busy.value=true;notice.value='';try{await action();}catch(e){if(owner===sessionGeneration())notice.value=(e as Error).message;}finally{busy.value=false;}}
async function checkout(){if(!quote.value||!agreed.value)return;await operate(async()=>{const owner=sessionGeneration(),result=await request<DigitalOrder>('/commerce/digital-orders',{method:'POST',data:{skuId,requestKey,channel:channel.value,platform:purchasePlatform(),quoteHash:quote.value!.quoteHash}});if(owner!==sessionGeneration())return;id=result.id;order.value=result;quote.value=null;notice.value='订单已保存，可继续付款或稍后从我的资料进入。';});}
async function refresh(){await operate(async()=>{const owner=sessionGeneration(),result=await request<DigitalOrder>('/commerce/digital-orders/'+id+'/refresh',{method:'POST'});if(owner===sessionGeneration())order.value=result;});}
async function cancel(){await operate(async()=>{const owner=sessionGeneration(),result=await request<DigitalOrder>('/commerce/digital-orders/'+id+'/cancel',{method:'POST'});if(owner===sessionGeneration())order.value=result;});}
async function pay(){if(!order.value)return;await operate(async()=>{const owner=sessionGeneration(),result=await payDigitalOrder(order.value!);if(owner===sessionGeneration()){order.value=result.order;notice.value=result.notice;}});}
async function refund(){if(reason.value.trim().length<2){formError.value='请填写至少两个字的原因';return;}await operate(async()=>{const owner=sessionGeneration(),result=await request<DigitalOrder>('/commerce/digital-orders/'+id+'/refunds',{method:'POST',data:{requestKey:refundKey,reason:reason.value}});if(owner===sessionGeneration()){order.value=result;refundOpen.value=false;refundKey=studyEventId();}});}
function receive(file:DigitalFile){if(!order.value?.canReceive||busy.value)return;uni.showModal({title:'确认领取资料',content:'首次领取后即开始本版数字资料交付。请确认文件名称，质量或无法打开的问题仍可联系书院。',confirmText:'确认领取',success:result=>{if(!result.confirm)return;if(file.mime.startsWith('video/')||file.mime.startsWith('audio/')){mediaFile.value=file;return;}void operate(async()=>{const owner=sessionGeneration(),ticket=await request<{path:string}>('/me/digital/'+order.value!.delivery!.id+'/files/'+file.id,{method:'POST'});if(owner!==sessionGeneration())return;const path=await new Promise<string>((resolve,reject)=>uni.downloadFile({url:apiBase+ticket.path,success:r=>r.statusCode===200?resolve(r.tempFilePath):reject(Error('领取失败，请重新获取文件')),fail:()=>reject(Error('下载中断，请重试'))}));if(owner!==sessionGeneration())return;if(file.mime.startsWith('image/'))uni.previewImage({urls:[path]});else uni.openDocument({filePath:path,showMenu:true,fail:()=>{notice.value='文件已下载；当前设备无法打开，可联系书院获取帮助。';}});await load();});}});}
watch(()=>currentUser.value?.id,()=>{sequence++;order.value=null;quote.value=null;mediaFile.value=null;refundOpen.value=false;});onLoad(options=>{id=options?.id??'';skuId=options?.skuId??'';});onShow(()=>void load());onHide(()=>{sequence++;loading.value=false;mediaFile.value=null;});
</script>
<style>@import '../../styles/app.css';.digital-section{padding:20px;margin-top:16px;background-color:#FCF9F2;border-radius:10px;border-width:1px;border-style:solid;border-color:#DED6C8;}.digital-section-copy{margin-top:12px;}.digital-section-price{margin-top:12px;}.digital-section-meta{margin-top:8px;}.compose-input{min-height:120px;width:100%;font-size:16px;line-height:28px;}</style>
