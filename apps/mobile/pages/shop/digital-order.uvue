  padding: 16px;
  margin-top: 16px;
  background-color: #fcf9f2;
  border-radius: 14px;
  border-width: 1px;
  border-style: solid;
  border-color: #cfc5b1;
}
.detail-title {
  font-family: AcademySerif;
  font-size: 24px;
  line-height: 34px;
  color: #182b31;
  font-weight: 600;
  margin-top: 8px;
}
