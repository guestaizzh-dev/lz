<template>
<view class="page"><PageHead title="我的资料"/><scroll-view class="page-scroll" direction="vertical" :show-scrollbar="false"><view class="content"><text class="intro">购买时的资料版本会保留，可在原订单领取文件、查看有效期与售后。</text><ContentState v-if="loading||error" :loading="loading" :error="error" @retry="load(true)"/><view v-for="row in rows" :key="row.id" class="digital-card" @click="openPage('shop/digital-order?id='+row.id)"><view class="row between"><text class="meta">{{formatChinaTime(row.createdAt)}}</text><text class="tag">{{digitalState(row)}}</text></view><text class="item-title digital-title">{{row.pack?.title??'数字资料订单'}}</text><text class="body-copy digital-copy">{{row.pack?.description}}</text><view class="row between"><text class="meta">查看资料与订单 ›</text><text class="price">¥{{money(Number(row.payableTotal))}}</text></view></view><ContentState v-if="!loading&&!error&&!rows.length" title="尚无资料订单" description="可到书院好物查看数字资料，购买后在这里领取。"/><button v-if="!loading&&rows.length<total" class="secondary-button" @click="load(false)">加载更多</button></view></scroll-view></view>
</template>
<script setup lang="ts">
import PageHead from '../../components/PageHead.uvue';import ContentState from '../../components/ContentState.uvue';import {request,money} from '../../lib/api';import {currentUser,needLogin,sessionGeneration} from '../../lib/session';import {openPage} from '../../lib/presentation';import {formatChinaTime} from '../../lib/date-time';import {digitalState} from '../../lib/digital';import type {DigitalOrder} from '../../lib/digital';
const rows=ref<DigitalOrder[]>([]),loading=ref(false),error=ref(''),total=ref(0);let page=1,sequence=0;
async function load(reset=true){if(loading.value)return;if(needLogin())return;const turn=++sequence,owner=sessionGeneration();if(reset){page=1;rows.value=[];}loading.value=true;error.value='';try{const result=await request<{items:DigitalOrder[];total:number}>('/commerce/digital-orders?page='+page+'&size=20');if(turn!==sequence||owner!==sessionGeneration())return;rows.value=reset?result.items:[...rows.value,...result.items];total.value=result.total;page++;}catch(e){if(turn===sequence)error.value=(e as Error).message;}finally{if(turn===sequence)loading.value=false;}}
watch(()=>currentUser.value?.id,()=>{sequence++;rows.value=[];loading.value=false;});onShow(()=>void load(true));onHide(()=>{sequence++;loading.value=false;});
</script>
<style>@import '../../styles/app.css';.digital-card{padding:20px;margin-top:16px;background-color:#FCF9F2;border-radius:10px;border-width:1px;border-style:solid;border-color:#DED6C8;}.digital-title{margin-top:14px;}.digital-copy{margin-top:8px;margin-bottom:16px;}</style>
