<template>
  <view class="page"
    ><InkBackdrop /><PageHead title="订单详情" /><scroll-view
      class="page-scroll"
      direction="vertical"
      :show-scrollbar="false"
      ><view class="content">
        <ContentState v-if="loading && !order" :loading="true" />
        <ContentState
          v-else-if="error"
          :error="error"
          :error-title="
            errorTone(error) === 'net'
              ? '网络连接中断'
              : errorTone(error) === 'gone'
                ? '订单不存在'
                : '订单信息需要重新确认'
          "
          :retryable="errorTone(error) === 'net'"
          :action-label="errorTone(error) === 'net' ? '' : '查看全部订单'"
          @retry="load"
          @action="openPage('shop/orders')" />
        <template v-if="order"
          ><view v-if="order!.memberGift" class="detail-card"
            ><text class="ui-text item-title">会员签名礼遇</text
            ><text class="ui-text body-line">此单无额外现金支付，取消与退货请在签名礼遇办理。</text
            ><button class="ui-button secondary-button" @click="openPage('membership/gifts')"
              >查看领取记录 / 申请售后</button
            ></view
          ><view v-if="order!.pointsRedemption" class="detail-card"
            ><text class="ui-text item-title"
              >积分兑换 · {{ order!.pointsRedemption!.points }} 积分</text
            ><text class="ui-text body-line"
              >此单无现金支付，取消、退货及退分请在兑换记录办理。</text
            ><button class="ui-button secondary-button" @click="openPage('marketing/points')"
              >查看兑换记录 / 申请积分售后</button
            ></view
          >
          <view class="detail-heading"
            ><text class="ui-text eyebrow">商品订单</text
            ><text class="ui-text section-heading order-state-title">{{
              productOrderLabel(order!)
            }}</text
            ><text v-if="order!.state === 'PENDING'" class="ui-text meta"
              >付款截止 {{ formatChinaTime(order!.expiresAt) }}</text
            ><text v-if="order!.paymentNotice" class="ui-text form-feedback">{{
              order!.paymentNotice
            }}</text
            ><text v-if="notice" class="ui-text form-feedback">{{ notice }}</text
            ><button
              class="ui-button text-action query-action"
              :class="busy ? 'is-disabled' : ''"
              :disabled="busy"
              @click="query"
              >刷新付款与售后进度</button
            ></view
          >
          <view v-for="line in order!.items" :key="line.id" class="detail-card"
            ><view class="row"
              ><ArtImage
                :src="line.cover"
                :kind="artwork(line.cover)"
                :width="68"
                :height="76"
              /><view class="grow detail-copy"
                ><text class="ui-text item-title">{{ line.title }}</text
                ><text class="ui-text meta">{{ line.skuTitle }}　× {{ line.quantity }}</text
                ><text class="ui-text line-amount">¥{{ money(Number(line.payable)) }}</text></view
              ></view
            ><view class="sum-row sum-row-last detail-line-foot"
              ><text class="ui-text sum-label"
                >已发 {{ line.shippedQuantity }} · 售后数量 {{ line.refundedQuantity }}</text
              ><button
                v-if="
                  Number(order!.paidAmount) > 0 &&
                  line.quantity > line.refundedQuantity &&
                  order!.state !== 'CLOSED'
                "
                class="ui-button text-action refund-action"
                :class="busy ? 'is-disabled' : ''"
                :disabled="busy"
                @click="beginRefund(line)"
                >申请售后</button
              ></view
            ></view
          >
          <view v-if="order!.address" class="detail-card"
            ><text class="ui-text section-heading">收货信息</text
            ><text v-if="order!.shippingMode === 'PRIORITY'" class="ui-text detail-copy"
              >优先配送：{{ order!.priorityDescription }} · 额外运费 ¥{{
                money(order!.priorityFee)
              }}</text
            ><text class="ui-text body-line" :user-select="true"
              >{{ order!.address!.recipient }}　{{ order!.address!.phone }}</text
            ><text class="ui-text meta" :user-select="true"
              >{{ order!.address!.province }}{{ order!.address!.city
              }}{{ order!.address!.district }} {{ order!.address!.detail }}</text
            ></view
          >
          <view v-for="parcel in order!.shipments" :key="parcel.id" class="detail-card"
            ><view class="row between"
              ><text class="ui-text section-heading">{{
                parcel.kind === 'RETURN'
                  ? '退货包裹'
                  : parcel.kind === 'EXCHANGE'
                    ? '换货包裹'
                    : '配送包裹'
              }}</text
              ><text class="ui-text state-label">{{
                parcel.state === 'DELIVERED' ? '已收货' : '运输中'
              }}</text></view
            ><text class="ui-text body-line">{{ parcel.carrier }}</text
            ><text class="ui-text body-line" :user-select="true">{{ parcel.trackingNo }}</text
            ><text class="ui-text meta">发出 {{ formatChinaTime(parcel.shippedAt) }}</text
            ><ShipmentTracking :orderId="order!.id" :shipmentId="parcel.id" /><button
              class="ui-button text-action"
              @click="copy(parcel.trackingNo)"
              >复制单号查询物流</button
            ><button
              v-if="parcel.kind !== 'RETURN' && parcel.state === 'SHIPPED'"
              class="ui-button secondary-button"
              :class="busy ? 'is-disabled' : ''"
              :disabled="busy"
              @click="receive(parcel)"
              >确认此包裹已收到</button
            ></view
          >
          <view v-if="order!.refunds.length" class="detail-card"
            ><text class="ui-text section-heading">售后进度</text
            ><view v-for="refund in order!.refunds" :key="refund.id" class="refund-entry"
              ><view class="sum-row sum-row-last refund-head"
                ><text class="ui-text item-title">{{
                  refund.kind === 'EXCHANGE' && refund.state === 'SUCCEEDED'
                    ? '换货已发出'
                    : productRefundLabel(refund.state)
                }}</text
                ><text v-if="refund.kind !== 'EXCHANGE'" class="ui-text sum-value-total"
                  >¥{{ money(Number(refund.amount)) }}</text
                ></view
              ><text class="ui-text body-line" :user-select="true">{{ refund.reason }}</text
              ><text v-if="refund.reviewNote" class="ui-text meta"
                >书院回复：{{ refund.reviewNote }}</text
              ><text
                v-if="refund.returnInstructions"
                class="ui-text detail-copy"
                :user-select="true"
                >退货收货信息：{{ refund.returnInstructions }}</text
              ><button
                v-if="
                  refund.state === 'RETURNING' &&
                  !order!.shipments.some((s) => s.kind === 'RETURN' && s.refundId === refund.id)
                "
                class="ui-button secondary-button"
                @click="beginReturn(refund)"
                >填写寄回物流单号</button
              ></view
            ></view
          >
          <view class="detail-card"
            ><text class="ui-text section-heading">费用</text
            ><view class="sum-row"
              ><text class="ui-text sum-label">商品金额</text
              ><text class="ui-text sum-value">¥{{ money(Number(order!.subtotal)) }}</text></view
            ><view v-if="Number(order!.discount) > 0" class="sum-row"
              ><text class="ui-text sum-label">商品优惠（已择优）</text
              ><text class="ui-text sum-value">−¥{{ money(Number(order!.discount)) }}</text></view
            ><view class="sum-row"
              ><text class="ui-text sum-label">配送费用</text
              ><text class="ui-text sum-value">¥{{ money(Number(order!.shipping)) }}</text></view
            ><view class="sum-row sum-row-last"
              ><text class="ui-text sum-label-total">应付合计</text
              ><text class="ui-text sum-value-total"
                >¥{{ money(Number(order!.amount)) }}</text
              ></view
            ><text v-if="Number(order!.refundedAmount) > 0" class="ui-text meta refunded-note"
              >渠道已确认退款 ¥{{ money(Number(order!.refundedAmount)) }}</text
            ></view
          >
          <view class="detail-card"
            ><text class="ui-text section-heading">订单信息</text
            ><text class="ui-text meta" :user-select="true">订单编号 {{ order!.orderNo }}</text
            ><text class="ui-text meta">下单 {{ formatChinaTime(order!.createdAt) }}</text
            ><text v-if="order!.paidAt" class="ui-text meta"
              >付款 {{ formatChinaTime(order!.paidAt!) }}</text
            ><button class="ui-button text-action" @click="copy(order!.orderNo)"
              >复制订单编号</button
            ><text class="ui-text term-copy" :user-select="true">{{ order!.refundPolicy }}</text
            ><button class="ui-button secondary-button" @click="openPage('profile/feedback')"
              >联系书院处理订单</button
            ></view
          >
          <ConsumptionReward
            :order-id="order!.id"
            :revision="order" /></template></view></scroll-view
    ><BottomBar v-if="order?.state === 'PENDING'"
      ><button
        class="ui-button bar-secondary"
        :class="busy ? 'is-disabled' : ''"
        :disabled="busy"
        @click="cancel"
        >取消订单</button
      ><button
        class="ui-button bar-primary"
        :class="busy || !order!.canPay ? 'is-disabled' : ''"
        :disabled="busy || !order!.canPay"
        @click="pay"
        >{{
          busy
            ? '处理中…'
            : order!.canPay
              ? '继续付款'
              : order!.paymentNotice
                ? '优惠已失效'
                : '请先查询付款状态'
        }}</button
      ></BottomBar
    >
    <ComposeSheet
      :visible="!!refundLine"
      title="申请商品售后"
      :subtitle="refundLine?.title"
      v-model="reason"
      placeholder="请说明取消或退货原因，便于书院处理"
      :maxlength="1000"
      :saving="busy"
      :error="formError"
      :disabled="reason.trim().length < 2"
      submitLabel="提交申请"
      @close="refundLine = null"
      @submit="submitRefund"
      ><view v-if="refundLine" class="row between"
        ><text class="ui-text body-line">{{
          refundKind === 'EXCHANGE'
            ? '同规格换货'
            : refundKind === 'REFUND_ONLY'
              ? '未发货退款'
              : '退货退款'
        }}</text
        ><view class="row refund-stepper"
          ><button
            class="ui-button refund-step"
            :class="refundQuantity <= 1 ? 'is-disabled' : ''"
            :disabled="refundQuantity <= 1"
            @click="refundQuantity--"
            >−</button
          ><text class="ui-text refund-qty">{{ refundQuantity }}</text
          ><button
            class="ui-button refund-step"
            :class="refundQuantity >= refundLimit ? 'is-disabled' : ''"
            :disabled="refundQuantity >= refundLimit"
            @click="refundQuantity++"
            >＋</button
          ></view
        ></view
      ><text class="ui-text term-copy">{{
        refundKind === 'EXCHANGE'
          ? '换货不重复收款，书院同意后再寄回。'
          : '预计退款 ¥' + money(refundEstimate) + '；退货需书院同意后再寄回。'
      }}</text></ComposeSheet
    >
    <ComposeSheet
      :visible="!!returnRefund"
      title="填写退货单号"
      v-model="trackingNo"
      placeholder="填写实际寄回的物流单号"
      :maxlength="40"
      :saving="busy"
      :error="formError"
      :disabled="!trackingNo.trim()"
      submitLabel="提交物流"
      @close="returnRefund = null"
      @submit="submitReturn"
      ><view class="menu-row" @click="chooseCarrier"
        ><text class="ui-text menu-label">承运商</text
        ><text class="ui-text menu-value">{{ carrierChoices[carrierIndex].label }} ›</text></view
      ></ComposeSheet
    >
  </view>
</template>
<script setup lang="ts">
import InkBackdrop from '../../components/InkBackdrop.uvue';
import ConsumptionReward from '../../components/ConsumptionReward.uvue';
import ShipmentTracking from '../../components/ShipmentTracking.uvue';
import PageHead from '../../components/PageHead.uvue';
import ArtImage from '../../components/ArtImage.uvue';
import ContentState from '../../components/ContentState.uvue';
import BottomBar from '../../components/BottomBar.uvue';
import ComposeSheet from '../../components/ComposeSheet.uvue';
import { request, money } from '../../lib/api';
import { currentUser, needLogin } from '../../lib/session';
import { openPage, artwork } from '../../lib/presentation';
import { formatChinaTime } from '../../lib/date-time';
import { studyEventId } from '../../lib/learning';
import {
  productOrderLabel,
  productRefundLabel,
  payProductOrder,
  carrierChoices,
} from '../../lib/product-sales';
import type {
  ProductOrder,
  ProductLine,
  ProductRefund,
  ProductShipment,
} from '../../lib/product-sales';
const refundKind = ref('REFUND_ONLY');
const order = ref<ProductOrder | null>(null),
  loading = ref(false),
  busy = ref(false),
  error = ref(''),
  notice = ref(''),
  refundLine = ref<ProductLine | null>(null),
  refundQuantity = ref(1),
  reason = ref(''),
  formError = ref(''),
  returnRefund = ref<ProductRefund | null>(null),
  trackingNo = ref(''),
  carrierIndex = ref(0);
let id = '',
  owner = '',
  generation = 0,
  refundKey = studyEventId();
const refundLimit = computed(() => {
  const l = refundLine.value;
  if (!l) return 0;
  const all = l.quantity - l.refundedQuantity;
  return Math.max(
    0,
    Math.min(
      all,
      refundKind.value === 'REFUND_ONLY'
        ? l.quantity - l.shippedQuantity - l.refundOnlyQuantity
        : l.shippedQuantity - (l.refundedQuantity - l.refundOnlyQuantity),
    ),
  );
});
const refundEstimate = computed(() => {
  const l = refundLine.value;
  if (!l) return 0;
  const base = Number(l.payable) - Number(l.shipping),
    q = l.refundMoneyQuantity;
  const principal =
      Math.floor((base * (q + refundQuantity.value)) / l.quantity) -
      Math.floor((base * q) / l.quantity),
    freight =
      refundKind.value === 'REFUND_ONLY'
        ? Math.floor(
            (Number(l.shipping) * (l.refundOnlyQuantity + refundQuantity.value)) / l.quantity,
          ) - Math.floor((Number(l.shipping) * l.refundOnlyQuantity) / l.quantity)
        : 0;
  return principal + freight;
});
// 只做展示分档，不参与请求、金额与权限判断。
const errorTone = (text: string) =>
  /网络|中断|超时|繁忙|连接/.test(text)
    ? 'net'
    : /不存在|无法打开|已删除|已失效|无效/.test(text)
      ? 'gone'
      : 'bad';

async function load() {
  const newOwner = currentUser.value?.id ?? '';
  if (owner !== newOwner) {
    order.value = null;
    refundLine.value = null;
    returnRefund.value = null;
    owner = newOwner;
  }
  if (needLogin() || busy.value) return;
  const turn = ++generation;
  loading.value = true;
  error.value = '';
  try {
    const row = await request<ProductOrder>('/commerce/product-orders/' + id);
    if (turn === generation) order.value = row;
  } catch (e) {
    if (turn === generation) error.value = (e as Error).message;
  } finally {
    if (turn === generation) loading.value = false;
  }
}
function copy(value: string) {
  uni.setClipboardData({ data: value });
}
async function query() {
  if (busy.value) return;
  busy.value = true;
  notice.value = '';
  try {
    order.value = await request<ProductOrder>('/commerce/product-orders/' + id + '/refresh', {
      method: 'POST',
    });
  } catch (e) {
    notice.value = (e as Error).message;
  } finally {
    busy.value = false;
  }
}
async function pay() {
  if (busy.value || !order.value?.canPay) return;
  busy.value = true;
  notice.value = '';
  try {
    const result = await payProductOrder(order.value);
    order.value = result.order;
    notice.value = result.notice;
  } catch (e) {
    notice.value = (e as Error).message;
  } finally {
    busy.value = false;
  }
}
function cancel() {
  if (busy.value) return;
  uni.showModal({
    title: '取消这笔商品订单？',
    content: '会先核查支付结果，确认未付款后释放库存。',
    confirmText: '取消订单',
    success: async (r) => {
      if (!r.confirm || busy.value) return;
      busy.value = true;
      try {
        order.value = await request<ProductOrder>('/commerce/product-orders/' + id + '/cancel', {
          method: 'POST',
        });
      } catch (e) {
        notice.value = (e as Error).message;
      } finally {
        busy.value = false;
      }
    },
  });
}
function receive(parcel: ProductShipment) {
  if (busy.value) return;
  uni.showModal({
    title: '确认已收到此包裹？',
    content: '请在实际收到并检查商品后确认。该操作只确认本包裹，不影响其他包裹。',
    confirmText: '确认收到',
    success: async (r) => {
      if (!r.confirm || busy.value) return;
      busy.value = true;
      try {
        order.value = await request<ProductOrder>(
          '/commerce/product-orders/' + id + '/shipments/' + parcel.id + '/receive',
          { method: 'POST' },
        );
      } catch (e) {
        notice.value = (e as Error).message;
      } finally {
        busy.value = false;
      }
    },
  });
}
function beginRefund(line: ProductLine) {
  if (busy.value) return;
  const options: { label: string; kind: string }[] = [];
  if (line.quantity - line.shippedQuantity - line.refundOnlyQuantity > 0)
    options.push({ label: '未发货部分退款', kind: 'REFUND_ONLY' });
  if (line.shippedQuantity > line.refundedQuantity - line.refundOnlyQuantity)
    options.push(
      { label: '已收货部分退货退款', kind: 'RETURN_REFUND' },
      { label: '已收货部分同规格换货', kind: 'EXCHANGE' },
    );
  if (!options.length) return;
  const show = (kind: string) => {
    refundKind.value = kind;
    refundLine.value = line;
    refundQuantity.value = 1;
    reason.value = '';
    formError.value = '';
    refundKey = studyEventId();
  };
  if (options.length === 1) {
    show(options[0].kind);
    return;
  }
  uni.showActionSheet({
    itemList: options.map((o) => o.label),
    success: (r) => show(options[r.tapIndex].kind),
  });
}

async function submitRefund() {
  if (busy.value || !refundLine.value || reason.value.trim().length < 2) return;
  busy.value = true;
  formError.value = '';
  try {
    order.value = await request<ProductOrder>('/commerce/product-orders/' + id + '/refund', {
      method: 'POST',
      data: {
        requestKey: refundKey,
        kind: refundKind.value,
        reason: reason.value.trim(),
        items: [{ orderItemId: refundLine.value.id, quantity: refundQuantity.value }],
      },
    });
    refundLine.value = null;
    uni.showToast({ title: '售后申请已提交', icon: 'none' });
  } catch (e) {
    formError.value = (e as Error).message;
  } finally {
    busy.value = false;
  }
}
function beginReturn(refund: ProductRefund) {
  if (busy.value) return;
  returnRefund.value = refund;
  trackingNo.value = '';
  formError.value = '';
  carrierIndex.value = 0;
}
function chooseCarrier() {
  uni.showActionSheet({
    itemList: carrierChoices.map((c) => c.label),
    success: (r) => (carrierIndex.value = r.tapIndex),
  });
}
async function submitReturn() {
  if (busy.value || !returnRefund.value) return;
  if (!/^[A-Za-z0-9-]{6,40}$/.test(trackingNo.value.trim())) {
    formError.value = '请填写6—40位真实物流单号';
    return;
  }
  busy.value = true;
  try {
    order.value = await request<ProductOrder>(
      '/commerce/product-refunds/' + returnRefund.value.id + '/return',
      {
        method: 'POST',
        data: {
          expectedVersion: returnRefund.value.version,
          carrierCode: carrierChoices[carrierIndex.value].value,
          trackingNo: trackingNo.value.trim(),
        },
      },
    );
    returnRefund.value = null;
  } catch (e) {
    formError.value = (e as Error).message;
  } finally {
    busy.value = false;
  }
}
onLoad((o) => {
  id = o?.id ?? '';
});
onShow(() => void load());
onUnload(() => {
  generation++;
});
</script>
<style>
@import '../../styles/app.css';
.detail-heading {
  padding: 16px 0 4px;
}
.order-state-title {
  font-family: AcademySerif;
  font-size: 24px;
  line-height: 34px;
  color: #182b31;
  margin-top: 6px;
}
.detail-card {
  padding: 16px;
  background-color: #fcf9f2;
  border-style: solid;
  border-width: 1px;
  border-color: #cfc5b1;
  border-radius: 14px;
  margin-top: 16px;
}
.detail-copy {
  padding-left: 13px;
}
.state-label {
  font-size: 12px;
  line-height: 20px;
  color: #235663;
  font-weight: 600;
  flex-shrink: 0;
}
.body-line {
  font-size: 13px;
  line-height: 22px;
  color: #344c54;
  margin-top: 8px;
}
.line-amount {
  font-family: AcademySerif;
  font-size: 17px;
  line-height: 26px;
  color: #b4533f;
  font-weight: 600;
  margin-top: 8px;
}
.term-copy {
  font-size: 13px;
  line-height: 22px;
  color: #5c6869;
  margin-top: 10px;
}
.form-feedback {
  font-size: 13px;
  line-height: 22px;
  color: #b4533f;
  margin-top: 10px;
}
.query-action {
  margin-top: 12px;
}
.detail-line-foot {
  padding-top: 12px;
  border-bottom-width: 0;
}
.refund-action {
  flex-shrink: 0;
}
.refund-action.is-disabled {
  opacity: 1;
  color: #9aa5a1;
}
.refund-entry {
  padding: 14px 0;
  border-bottom-width: 1px;
  border-bottom-style: solid;
  border-bottom-color: #e0d8c8;
}
.refund-head {
  padding: 0 0 8px;
  border-bottom-width: 0;
}
.refunded-note {
  margin-top: 10px;
}
.sum-row {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 14px 0;
  border-bottom-width: 1px;
  border-bottom-style: solid;
  border-bottom-color: #e0d8c8;
}
.sum-row-last {
  border-bottom-width: 0;
  padding-bottom: 0;
}
.sum-label {
  font-size: 14px;
  line-height: 24px;
  color: #344c54;
  flex-shrink: 1;
}
.sum-value {
  font-size: 15px;
  line-height: 26px;
  color: #182b31;
  text-align: right;
  margin-left: 12px;
}
.sum-label-total {
  font-size: 15px;
  line-height: 26px;
  color: #182b31;
  font-weight: 600;
