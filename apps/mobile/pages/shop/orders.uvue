<template>
<view class="page"><PageHead title="商品订单"/><scroll-view class="page-scroll" direction="vertical" :show-scrollbar="false"><view class="content"><scroll-view direction="horizontal" :show-scrollbar="false" class="horizontal-scroll order-tabs row"><text v-for="tab in tabs" :key="tab.value" :class="state===tab.value?'order-tab active':'order-tab'" @click="state=tab.value;load()">{{tab.label}}</text></scroll-view>
<ContentState v-if="loading&&!rows.length||error" :loading="loading" :error="error" @retry="load()"/><view v-for="order in rows" :key="order.id" class="order-card" @click="openPage('shop/order-detail?id='+order.id)"><view class="row between"><text class="meta">{{formatChinaTime(order.createdAt)}}</text><text class="order-state">{{productOrderLabel(order)}}</text></view><view v-for="line in order.items" :key="line.id" class="row order-line"><ArtImage :src="line.cover" :kind="artwork(line.cover)" :width="62" :height="68"/><view class="grow order-copy"><text class="item-title">{{line.title}}</text><text class="meta">{{line.skuTitle}}　× {{line.quantity}}</text></view></view><view class="row between"><text class="meta">查看付款、配送与售后 ›</text><text class="price">¥{{money(Number(order.amount))}}</text></view></view>
<ContentState v-if="!loading&&!error&&!rows.length" title="还没有这类商品订单" description="选择喜欢的好物，确认规格与收货信息后再下单。" actionLabel="去看看好物" @action="openPage('shop/index')"/><button v-if="rows.length<total" class="secondary-button" :disabled="loading" @click="load(true)">{{loading?'加载中…':'加载更多'}}</button><button class="text-action" @click="openPage('profile/service?kind=orders')">查看旧订单记录</button></view></scroll-view></view>
</template>
<script setup lang="ts">
import PageHead from '../../components/PageHead.uvue';import ArtImage from '../../components/ArtImage.uvue';import ContentState from '../../components/ContentState.uvue';import {request,money} from '../../lib/api';import {currentUser,needLogin} from '../../lib/session';import {openPage,artwork} from '../../lib/presentation';import {formatChinaTime} from '../../lib/date-time';import {productOrderLabel} from '../../lib/product-sales';import type {ProductOrder} from '../../lib/product-sales';
const rows=ref<ProductOrder[]>([]),state=ref(''),loading=ref(false),error=ref(''),total=ref(0),tabs=[{value:'',label:'全部'},{value:'PENDING',label:'待付款'},{value:'PAID',label:'待发货'},{value:'FULFILLING',label:'配送中'},{value:'COMPLETED',label:'已签收'}];let page=1,generation=0,owner='';
async function load(append=false){if(needLogin()||append&&loading.value)return;const newOwner=currentUser.value?.id??'';if(owner!==newOwner){rows.value=[];owner=newOwner;}const turn=++generation,next=append?page+1:1;loading.value=true;error.value='';if(!append)rows.value=[];try{const result=await request<{items:ProductOrder[];total:number}>('/commerce/product-orders?page='+next+(state.value?'&state='+state.value:''));if(turn!==generation)return;rows.value=append?[...rows.value,...result.items]:result.items;page=next;total.value=result.total;}catch(e){if(turn===generation)error.value=(e as Error).message;}finally{if(turn===generation)loading.value=false;}}
onShow(()=>void load());onUnload(()=>{generation++;});
</script>
<style>@import '../../styles/app.css';.order-tabs{padding:8px 0 18px;}.order-tab{flex-shrink:0;font-size:13px;line-height:24px;color:#637276;margin-right:22px;padding:8px 0;}.active{color:#245564;border-bottom-width:2px;border-bottom-style:solid;border-bottom-color:#245564;}.order-card{padding:20px 0;border-bottom-width:1px;border-bottom-style:solid;border-bottom-color:#DFD9CF;}.order-line{margin:16px 0;}.order-copy{min-width:0;padding-left:12px;}.order-state{font-size:12px;color:#31564F;line-height:22px;}</style>
