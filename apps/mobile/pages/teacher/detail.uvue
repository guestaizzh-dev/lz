<template>
  <view class="page"
    ><InkBackdrop />
    <PageHead :title="teacher?.name ?? '名师详情'" action="share" @action="share" />
    <scroll-view :show-scrollbar="false" class="page-scroll" direction="vertical">
      <view class="content">
        <ContentState
          v-if="!teacher"
          :loading="!error"
          :error="error"
          errorTitle="老师资料暂时打不开"
          @retry="load"
        />
        <view v-else>
          <view v-if="error" class="refresh-warning"
            ><text class="ui-text warning-copy">资料暂未更新：{{ error }}</text
            ><button class="ui-button text-button" @click="load">重试</button></view
          >
          <view class="teacher-profile row">
            <TeacherAvatar :portrait="teacher!.portrait" :demo="teacher!.isDemo" :size="82" />
            <view class="teacher-copy">
              <text class="ui-text detail-title">{{ teacher!.name }}</text>
              <text class="ui-text meta teacher-role">{{ teacher!.title }}</text>
              <text class="ui-text teacher-expertise">{{ teacher!.expertise.join(' · ') }}</text>
            </view>
          </view>
          <view class="detail-tabs">
            <view
              v-for="item in ['老师介绍', '研习课程', '研习安排', '问答']"
              :key="item"
              :class="['detail-tab', tab === item ? 'detail-tab-active' : '']"
              @click="tab = item"
            >
              <text
                class="ui-text"
                :class="['detail-tab-text', tab === item ? 'detail-tab-selected' : '']"
                >{{ item }}</text
              >
            </view>
          </view>
          <view v-if="tab === '老师介绍'" class="section">
            <text class="ui-text section-heading">研习与传承</text>
            <text class="ui-text body-copy" :user-select="true">{{ teacher!.bio }}</text>
            <view v-if="teacher!.teachingDirection" class="profile-section"
              ><text class="ui-text section-heading">授课方向</text
              ><text class="ui-text body-copy" :user-select="true">{{
                teacher!.teachingDirection
              }}</text></view
            >
            <view v-if="teacher!.lineageSummary" class="profile-section"
              ><text class="ui-text section-heading">传承背景</text
              ><text class="ui-text body-copy" :user-select="true">{{
                teacher!.lineageSummary
              }}</text></view
            >
            <view v-if="teacher!.achievementSummary" class="profile-section"
              ><text class="ui-text section-heading">教学成果</text
              ><text class="ui-text body-copy" :user-select="true">{{
                teacher!.achievementSummary
              }}</text></view
            >
            <view v-if="teacher!.introductions?.length" class="profile-section"
              ><text class="ui-text section-heading">听老师讲 · 看老师说</text
              ><view v-for="item in teacher!.introductions" :key="item.id" class="profile-card"
                ><text class="ui-text item-title">{{ item.title }}</text
                ><text class="ui-text intro">{{ item.summary }}</text
                ><button
                  class="ui-button secondary-button"
                  @click="openPage('article/detail?id=' + item.id)"
                  >观看 / 收听介绍</button
                ></view
              ></view
            >
            <view v-if="teacher!.interpretations?.length" class="profile-section"
              ><text class="ui-text section-heading">会员专属解读</text
              ><view v-for="item in teacher!.interpretations" :key="item.id" class="profile-card"
                ><text class="ui-text tag"
                  >{{
                    ['', '铜牌', '银牌', '金牌', '钻石'][item.membershipTier] ?? '会员'
                  }}权益内容</text
                ><text class="ui-text item-title">{{ item.title }}</text
                ><text class="ui-text intro">{{ item.summary }}</text
                ><button
                  class="ui-button secondary-button"
                  @click="openPage('article/detail?id=' + item.id)"
                  >查看解读与权益要求</button
                ></view
              ></view
            >

            <SourceEvidence :items="teacher!.evidence ?? []" title="师资与传承来源" />
          </view>
          <view v-else-if="tab === '研习课程'">
            <view v-if="teacher!.representativeCourses?.length" class="section"
              ><text class="ui-text section-heading">代表课程</text
              ><CourseRow
                v-for="course in teacher!.representativeCourses"
                :key="course.id"
                :course="course"
            /></view>
            <text
              v-if="teacher!.representativeCourses?.length && otherCourses.length"
              class="ui-text section-heading"
              >更多研习</text
            ><CourseRow v-for="course in otherCourses" :key="course.id" :course="course" />
            <ContentState
              v-if="courseLoading || courseError"
              :loading="courseLoading"
              :error="courseError"
              errorTitle="课程列表暂时打不开"
              @retry="retryCourses"
            /><ContentState
              v-if="!courseLoading && !courseError && !courses.length"
              title="暂无已发布课程"
            />
            <button
              v-if="nextCursor"
              class="ui-button retry"
              :disabled="courseLoading || courseLoadingMore"
              @click="loadCourses(true)"
              >{{ courseLoadingMore ? '加载中…' : '更多课程' }}</button
            >
          </view>
          <view v-else-if="tab === '研习安排'" class="section"
            ><text class="ui-text intro">直播、活动与咨询安排实时汇总，时间均为北京时间。</text
            ><view v-for="item in teacher!.schedule ?? []" :key="item.id" class="profile-card"
              ><text class="ui-text tag">{{
                item.state === 'LIVE' ? '正在直播' : (scheduleKinds[item.kind] ?? '研习安排')
              }}</text
              ><text class="ui-text item-title">{{ item.title }}</text
              ><text class="ui-text meta"
                >{{ formatChinaTime(item.startsAt)
                }}{{ item.endsAt ? ' — ' + formatChinaTime(item.endsAt) : '' }}</text
              ><text class="ui-text meta">{{ item.location }}</text
              ><button class="ui-button secondary-button" @click="openSchedule(item)">{{
                item.kind === 'LIVE'
                  ? '查看直播'
                  : item.kind === 'EVENT'
                    ? '查看活动与报名'
                    : '查看咨询时段'
              }}</button></view
            ><ContentState
              v-if="!teacher!.schedule?.length"
              title="暂无近期安排"
              description="新的直播、活动与咨询时段开放后会在这里公布。"
            /><text v-if="teacher!.scheduleHasMore" class="ui-text footer-note"
              >此处展示最近30项安排，更多时段可进入相应直播、活动或咨询页面查看。</text
            ></view
          >
          <TeacherQuestions v-else :teacherId="id" />
          <RelatedContent
            ref="relatedRef"
            v-if="teacher"
            :resourceId="id"
            :excludeIds="curatedIds"
          />
        </view> </view
    ></scroll-view>
    <BottomBar v-if="teacher">
      <button class="ui-button bar-primary" @click="consult">查看咨询与见面时段</button>
    </BottomBar>
  </view>
</template>
<script setup lang="ts">
import InkBackdrop from '../../components/InkBackdrop.uvue';
import SourceEvidence from '../../components/SourceEvidence.uvue';
import RelatedContent from '../../components/RelatedContent.uvue';
import TeacherQuestions from '../../components/TeacherQuestions.uvue';
import BottomBar from '../../components/BottomBar.uvue';
import { formatChinaTime } from '../../lib/date-time';
import type { TeacherSchedule } from '../../lib/api';
const scheduleKinds: Record<string, string> = {
  LIVE: '在线直播',
  EVENT: '活动 / 见面',
  CONSULTATION: '咨询时段',
};
function openSchedule(item: TeacherSchedule) {
  openPage(
    item.kind === 'LIVE'
      ? 'live/detail?id=' + item.resourceId
      : item.kind === 'EVENT'
        ? 'event/detail?id=' + item.resourceId
        : 'booking/confirm?teacherId=' + id,
  );
}
import PageHead from '../../components/PageHead.uvue';
import TeacherAvatar from '../../components/TeacherAvatar.uvue';
import CourseRow from '../../components/CourseRow.uvue';
import ContentState from '../../components/ContentState.uvue';
import { request } from '../../lib/api';
import type { Teacher, Course } from '../../lib/api';
import { useCatalog } from '../../lib/catalog';
import { openPage } from '../../lib/presentation';
const teacher = ref<Teacher | null>(null),
  error = ref(''),
  tab = ref('老师介绍');
let id = '';
const {
  items: courses,
  nextCursor,
  loading: courseLoading,
  loadingMore: courseLoadingMore,
  error: courseError,
  retry: retryCourses,
  load: loadCourses,
} = useCatalog<Course>('courses', () => ({ category: '全部', teacherId: id }));
async function load() {
  error.value = '';
  try {
    teacher.value = await request<Teacher>('/catalog/teachers/' + encodeURIComponent(id));
    await loadCourses();
  } catch (e) {
    error.value = (e as Error).message;
  }
}
function consult() {
  openPage('booking/confirm?teacherId=' + id);
}
async function share() {
  if (!teacher.value) return;
  try {
    const result = await request<{ url: string; shortUrl: string }>('/share/links', {
      method: 'POST',
      data: {
        resourceType: 'TEACHER',
        resourceId: id,
        title: teacher.value.name,
        description: teacher.value.title,
        coverUrl: teacher.value.portrait,
      },
    });
    uni.setClipboardData({
      data: result.shortUrl,
      success: () => {
        uni.showToast({ title: '分享链接已复制', icon: 'success' });
      },
    });
  } catch (e) {
    uni.showToast({ title: '生成分享链接失败', icon: 'none' });
  }
}
onLoad((options) => {
  id = options?.id ?? '';
  if (options?.tab === 'questions') tab.value = '问答';
});

const relatedRef = ref<InstanceType<typeof RelatedContent> | null>(null);
const curatedIds = computed(() =>
  [
    ...(teacher.value?.representativeCourses ?? []),
    ...(teacher.value?.introductions ?? []),
    ...(teacher.value?.interpretations ?? []),
  ].map((item) => item.id),
);
const otherCourses = computed(() =>
  courses.value.filter(
    (course) => !teacher.value?.representativeCourses?.some((c) => c.id === course.id),
  ),
);
onShow(() => {
  relatedRef.value?.refresh();
  if (id) load();
});
</script>
<style>
@import '../../styles/app.css';
/* 老师卡上下内边距统一 16，与列表页老师卡、作者卡一致。 */
.teacher-profile {
  flex-direction: row;
  align-items: flex-start;
  padding: 16px 0;
}
.teacher-copy {
  min-width: 0;
  flex: 1;
  padding-left: 16px;
}
.detail-title {
  font-size: 24px;
  line-height: 34px;
  margin-top: 0;
}
.teacher-role {
  font-size: 13px;
  line-height: 22px;
  color: #5c6869;
  margin-top: 4px;
}
.teacher-expertise {
  font-size: 13px;
  line-height: 22px;
  color: #5c6869;
  margin-top: 4px;
}
.body-copy {
  font-size: 15px;
  line-height: 26px;
}
.profile-section {
  margin-top: 24px;
}
.profile-card {
  padding: 16px 0;
  border-bottom-style: solid;
  border-bottom-width: 1px;
  border-bottom-color: #e0d8c8;
}
.detail-tabs {
  margin-top: 24px;
  border-top-width: 0;
  border-bottom-width: 0;
}
.detail-tab-text {
  font-size: 15px;
  line-height: 22px;
  color: #5c6869;
}
.detail-tab-selected {
  color: #182b31;
  font-weight: 600;
}
.refresh-warning {
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 12px;
  background-color: #f1e8d8;
  border-radius: 10px;
  margin-bottom: 12px;
}
.warning-copy {
  flex: 1;
  font-size: 13px;
  line-height: 22px;
  color: #5c6869;
  margin-right: 8px;
}
</style>
