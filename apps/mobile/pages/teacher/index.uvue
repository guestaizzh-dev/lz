<template>
  <view class="page"
    ><InkBackdrop />
    <PageHead title="名师" />
    <scroll-view :show-scrollbar="false" class="page-scroll" direction="vertical">
      <view class="content">
        <view class="search">
          <AppIcon name="magnifying-glass" :size="16" />
          <input
            class="ui-input search-input"
            placeholder="搜索名师"
            v-model="query"
            @confirm="load()"
          />
        </view>
        <ContentState
          v-if="(loading && !items.length) || error"
          :loading="loading"
          :error="error"
          errorTitle="名师列表暂时打不开"
          @retry="retry()"
        />
        <view v-if="!error && (!loading || items.length)">
          <text v-if="items.length" class="ui-text eyebrow list-eyebrow">书院师承</text>
          <view
            v-for="teacher in items"
            :key="teacher.id"
            class="teacher-card"
            hover-class="row-pressed"
            @click="openPage('teacher/detail?id=' + teacher.id)"
          >
            <view class="row teacher-top">
              <TeacherAvatar :portrait="teacher.portrait" :demo="teacher.isDemo" :size="58" />
              <view class="teacher-copy grow">
                <text class="ui-text teacher-name">{{ teacher.name }}</text>
                <text class="ui-text meta teacher-role">{{ teacher.title }}</text>
              </view>
              <AppIcon name="arrow-right" :size="15" />
            </view>
            <text class="ui-text teacher-bio">{{ teacher.bio }}</text>
            <view v-if="teacher.expertise.length" class="teacher-tags"
              ><text v-for="item in teacher.expertise" :key="item" class="ui-text teacher-tag">{{
                item
              }}</text></view
            >
          </view>
          <ContentState v-if="!items.length" title="暂无相关名师" />
          <button v-if="nextCursor" class="ui-button retry" @click="load(true)">更多名师</button>
          <SponsoredContent surface="TEACHER_LIST" />
        </view>
      </view>
    </scroll-view>
  </view>
</template>
<script setup lang="ts">
import InkBackdrop from '../../components/InkBackdrop.uvue';
import SponsoredContent from '../../components/SponsoredContent.uvue';
import PageHead from '../../components/PageHead.uvue';
import AppIcon from '../../components/AppIcon.uvue';
import TeacherAvatar from '../../components/TeacherAvatar.uvue';
import ContentState from '../../components/ContentState.uvue';
import { useCatalog } from '../../lib/catalog';
import type { Teacher } from '../../lib/api';
import { openPage } from '../../lib/presentation';
const query = ref('');
const { items, loading, error, nextCursor, load, retry } = useCatalog<Teacher>('teachers', () => ({
  category: '全部',
  q: query.value,
}));
let timer: ReturnType<typeof setTimeout> | null = null;
watch(query, () => {
  if (timer !== null) clearTimeout(timer);
  timer = setTimeout(() => load(), 300);
});
onUnload(() => {
  if (timer !== null) clearTimeout(timer);
});
onLoad(() => load());
</script>
<style>
@import '../../styles/app.css';
/* 老师卡四边内边距统一 16，上下留白与作者卡一致。 */
.list-eyebrow {
  margin-top: 0;
  margin-bottom: 8px;
}
.teacher-card {
  background-color: #fcf9f2;
  border-style: solid;
  border-width: 1px;
  border-color: #cfc5b1;
  border-radius: 14px;
  padding: 16px;
  margin-top: 12px;
}
.teacher-top {
  margin-bottom: 12px;
}
.teacher-copy {
  padding-left: 14px;
}
.teacher-name {
  font-family: AcademySerif;
  font-size: 19px;
  line-height: 28px;
  color: #182b31;
  font-weight: 600;
}
.teacher-role {
  font-size: 13px;
  line-height: 22px;
  color: #5c6869;
  margin-top: 4px;
}
.teacher-bio {
  font-family: sans-serif;
  font-size: 13px;
  line-height: 22px;
  color: #5c6869;
  max-height: 44px;
  overflow: hidden;
}
.teacher-tags {
  flex-direction: row;
  flex-wrap: wrap;
  margin-top: 12px;
}
.teacher-tag {
  font-size: 12px;
  line-height: 20px;
  color: #235663;
  background-color: #e6ede9;
  border-radius: 10px;
  padding: 3px 9px;
  margin: 0 8px 6px 0;
}
</style>
