# Use separate random hexadecimal database passwords (URI safe).
DATABASE_OWNER_PASSWORD=CHANGE_ME
DATABASE_APP_PASSWORD=CHANGE_ME
DATABASE_NAME=academy
ADMIN_HOST=admin.example.com
APP_HOST=app.example.com
TLS_DIRECTORY=/etc/academy/tls
# Three independent random secrets. Encryption/media keys must be 64 hex digits.
OTP_HASH_SECRET=CHANGE_ME
DOMAIN_ENCRYPTION_KEY=CHANGE_ME
MEDIA_TOKEN_SECRET=CHANGE_ME
# Set false for an admin-only deployment; App SMS authentication returns 503.
SMS_ENABLED=true
# Switch to aliyun after server credentials and actual delivery verification.
SMS_PROVIDER=tencent
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIBABA_CLOUD_SECURITY_TOKEN=
ALIYUN_SMS_SIGN_NAME=北京华夏知古文化院
ALIYUN_SMS_TEMPLATE_CODE=SMS_512591994
SMS_SECRET_ID=CHANGE_ME
SMS_SECRET_KEY=CHANGE_ME
SMS_SDK_APP_ID=CHANGE_ME
SMS_TEMPLATE_ID=CHANGE_ME
SMS_SIGN_NAME=CHANGE_ME
SMS_REGION=ap-guangzhou
COURSE_WECHAT_ENABLED=false
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_SERIAL=
WECHAT_PAY_API_V3_KEY=
# Host directory; merchant.pem and public-keys.json, readable by container UID 1000.
PAYMENT_KEYS_DIRECTORY=./payment-keys
