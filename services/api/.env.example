# Local development. Start the test database with scripts/dev-db.mjs.
NODE_ENV=development
PORT=3000
API_HOST=127.0.0.1
DATABASE_URL=postgresql://daoxue:CHANGE_ME@127.0.0.1:55432/daoxue_dev
CORS_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:9071
DEV_OTP_CODE=123456
ORDER_RESERVATION_PREVIEW=false
PUBLIC_API_URL=http://127.0.0.1:3000/api/v1
PUBLIC_APP_URL=http://127.0.0.1:9071
# Only set these to an actually published signed package or App Store listing.
PUBLIC_ANDROID_DOWNLOAD_URL=
PUBLIC_IOS_DOWNLOAD_URL=
# Production must remove DEV_OTP_CODE and use HTTPS and independent keys.
OTP_HASH_SECRET=
DOMAIN_ENCRYPTION_KEY=
MEDIA_TOKEN_SECRET=
MEDIA_DIR=.media
SMS_ENABLED=true
# tencent (existing default) or aliyun. Remove DEV_OTP_CODE for real delivery.
SMS_PROVIDER=tencent
# Aliyun: server-only credentials, never include in App or source control.
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
# Optional for temporary STS credentials; must be refreshed before expiry.
ALIBABA_CLOUD_SECURITY_TOKEN=
ALIYUN_SMS_SIGN_NAME=北京华夏知古文化院
ALIYUN_SMS_TEMPLATE_CODE=SMS_512591994
# Optional preview login: only the pinned ordinary account behind 19900001002,
# maximum seven days; SMS and all real payment switches must remain disabled.
PREVIEW_LOGIN_ENABLED=false
PREVIEW_LOGIN_USER_ID=
PREVIEW_LOGIN_CODE=
PREVIEW_LOGIN_EXPIRES_AT=
SMS_SECRET_ID=
SMS_SECRET_KEY=
SMS_SDK_APP_ID=
SMS_TEMPLATE_ID=
SMS_SIGN_NAME=
SMS_REGION=ap-guangzhou
# Exact reverse proxy address/subnet; never true or *.
TRUST_PROXY=
# Enable only after real merchant, signed Android App and HTTPS callback verification.
COURSE_WECHAT_ENABLED=false
COURSE_PAYMENT_WORKER_ENABLED=true
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_SERIAL=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PRIVATE_KEY_FILE=
# JSON map of trusted WeChat certificate serial / PUB_KEY_ID to PEM public key.
WECHAT_PAY_PUBLIC_KEYS_FILE=
# Alipay App payment: production gateway only, disabled until merchant/native acceptance.
COURSE_ALIPAY_ENABLED=false
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_PRIVATE_KEY_FILE=
# Locally controlled JSON: {"active":"current","keys":{"current":"PEM","previous":"PEM"}}.
# At most three trusted RSA2 keys. Retire the old key after callback overlap, never trust a supplied key URL.
ALIPAY_PUBLIC_KEYS_FILE=
# Apple Server API and V2 JWS verification. Production rejects Sandbox and arbitrary root certificates.
APPLE_IAP_ENABLED=false
APPLE_NATIVE_PURCHASE_READY=false
APPLE_BUNDLE_ID=
APPLE_KEY_ID=
APPLE_ISSUER_ID=
APPLE_APP_ID=
APPLE_ENVIRONMENT=Sandbox
APPLE_PRIVATE_KEY_FILE=
APPLE_ROOT_CA_FILE=../../infra/apple-root-cas/AppleRootCA-G3.cer

# Independent membership checkout gate; verified shared channels and native App configuration are still required.
MEMBERSHIP_SALES_ENABLED=false
MEMBERSHIP_PAYMENT_WORKER_ENABLED=true

# Fixed-duration iOS memberships remain gated until native/channel acceptance.
APPLE_MEMBERSHIP_SALES_ENABLED=false

# Physical store remains closed until verified native/channel acceptance.
PRODUCT_SALES_ENABLED=false

# Keep disabled until real channel, native and service/refund acceptance.
BOOKING_SALES_ENABLED=false
BOOKING_PAYMENT_WORKER_ENABLED=true
# Training camp payments remain disabled until digital channel/native acceptance.
COHORT_SALES_ENABLED=false
COHORT_PAYMENT_WORKER_ENABLED=true

# ZEGO RTC. ServerSecret/CallbackSecret remain on the API server; AppSign is not used.
ZEGO_RTC_ENABLED=false
ZEGO_APP_ID=
ZEGO_SERVER_SECRET=
ZEGO_CALLBACK_SECRET=
# Copy the Web SDK server address from the ZEGO console and verify connectivity.
ZEGO_RTC_SERVER=
ZEGO_WHIP_DOMAIN=
# Enable only after ZEGO confirms room/publishing privilege authentication and negative access tests pass.
ZEGO_ROOM_TOKEN_AUTH_ENABLED=false

# Explicit operator acceptance; does not assert provider permission verification.
ZEGO_ALLOW_UNVERIFIED_TOKEN_AUTH=false
# Official Linux server recorder; no COS/OSS needed. Enable after installing and testing the binary.
ZEGO_LOCAL_RECORDING_ENABLED=false
ZEGO_RECORDER_BINARY=/opt/zego-recorder/academy-recorder
ZEGO_RECORDER_LIBRARY_DIR=/opt/zego-recorder

# Required by course/replay uploads. Docker installs these binaries; local development needs matching paths.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# uni-push 2.0 URLized uniCloud gateway. Configure both sides with the same secret.
PUSH_ENABLED=false
PUSH_GATEWAY_URL=
PUSH_GATEWAY_SECRET=

# App login identities are separate from payment/IAP credentials. Keep both disabled until configured.
SOCIAL_WECHAT_ENABLED=false
SOCIAL_WECHAT_APP_ID=
SOCIAL_WECHAT_SECRET=
SOCIAL_APPLE_ENABLED=false
SOCIAL_APPLE_CLIENT_ID=
SOCIAL_APPLE_TEAM_ID=
SOCIAL_APPLE_KEY_ID=
# P-256 Sign in with Apple key, server only; literal \n line breaks are accepted.
SOCIAL_APPLE_PRIVATE_KEY=

# License service only. Native offline downloading/playback remain unavailable until verified.
OFFLINE_LICENSE_ENABLED=false
OFFLINE_LICENSE_KEY_ID=
# Server-only RSA private key, >=2048 bits. Ship only the pinned public key in future native builds.
OFFLINE_LICENSE_PRIVATE_KEY=

# 原生专项和正式渠道验收后才能开启
RTC_NATIVE_PUBLISH_READY=false
OFFLINE_NATIVE_PLAYBACK_READY=false
GIFT_SALES_ENABLED=false
APPLE_GIFT_SALES_ENABLED=false

# 快递100企业实时查询，正式授权及隐私告知核验后开启。无配置时只显示真实运单。
LOGISTICS_TRACKING_ENABLED=false
KUAIDI100_CUSTOMER=
KUAIDI100_KEY=
