{
  "name": "@daoxue/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-live.mjs && tsc -p tsconfig.json && node --env-file=.env dist/main.js",
    "build": "node scripts/prepare-live.mjs && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "pnpm build && node --env-file=.env test/run-tests.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "pnpm build && node --env-file=.env prisma/manual-seed.mjs",
    "admin:bootstrap": "node --env-file=.env --import tsx prisma/admin-bootstrap.ts"
  },
  "dependencies": {
    "@apple/app-store-server-library": "3.1.0",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@nestjs/swagger": "12.0.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "alipay-sdk": "4.14.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "dotenv": "17.2.3",
    "helmet": "8.1.0",
    "pg": "8.16.3",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "ws": "8.22.0",
    "zego-express-engine-webrtc": "3.13.0"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "24.7.2",
    "@types/pg": "8.15.5",
    "@types/qrcode": "1.5.5",
    "@types/ws": "8.18.2",
    "prisma": "7.10.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
