generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "esm"
  generatedFileExtension = "ts"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  TEACHER
  OPERATOR
  MODERATOR
  SUPPORT
  FINANCE
  ADMIN
}

enum AccountStatus {
  ACTIVE
  FROZEN
  DELETED
}

model User {
  id String @id @default(uuid())
  phone String? @unique
  username String? @unique
  passwordHash String?
  nickname String
  avatar String?
  tags String[]
  roles Role[] @default([USER])
  status AccountStatus @default(ACTIVE)
  sessions AuthSession[]
  notes Note[]
  favorites Favorite[]
  practiceLogs PracticeLog[]
  enrollments Enrollment[]
  memberships Membership[]
  studyProgress StudyProgress[]
  studyEvents StudyEvent[]
  addresses Address[]
  cartItems CartItem[]
  orders Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version Int @default(1)
  phoneCipher String?
  phoneHash String?
  avatarAssetId String?
  deletedAt DateTime? @db.Timestamptz(6)
  lastSeenAt DateTime? @db.Timestamptz(6)
}

model AuthSession {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  accessHash String @unique
  accessExpiresAt DateTime
  refreshHash String @unique
  csrfToken String
  expiresAt DateTime
  revokedAt DateTime?
  consumedTokens ConsumedRefresh[]
  createdAt DateTime @default(now())
  kind String @default("ADMIN")
  @@index([userId, revokedAt])
  updatedAt DateTime @default(now()) @db.Timestamptz(6)
  version Int @default(1)
  csrfHash String?
  deviceId String?
}

model OtpChallenge {
  id String @id @default(uuid())
  phone String
  codeHash String
  attempts Int @default(0)
  consumedAt DateTime?
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([phone, createdAt])
  phoneHash String @default("")
  purpose String @default("")
  providerRequestId String?
  deliveryState String @default("")
}

model Note {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  articleId String
  articleTitle String
  articleVersion Int
  blockId String
  quote String
  text String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId, updatedAt])
  version Int @default(1)
  releaseId String?
  rangeStart Int?
  rangeEnd Int?
  ranges Json?
  deletedAt DateTime? @db.Timestamptz(6)
}

model Favorite {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  articleId String
  createdAt DateTime @default(now())
  @@unique([userId, articleId])
}

model PracticeLog {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  day String
  text String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([userId, day])
  version Int @default(1)
  deletedAt DateTime? @db.Timestamptz(6)
}

model ConsumedRefresh {
  hash String @id
  sessionId String
  session AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  id String @unique @default(dbgenerated("gen_random_uuid()::text"))
  expiresAt DateTime @default(now()) @db.Timestamptz(6)
  requestHash String?
  resultCipher String?
}

model AuditLog {
  id String @id @default(uuid())
  actorId String
  action String
  resource String
  resourceId String?
  changes Json
  createdAt DateTime @default(now())
  @@index([resource, resourceId, createdAt])
  resourceType String @default("")
  resourceKey String @default("")
  requestId String @default("")
  reason String?
  beforeSnapshot Json @default("{}")
  afterSnapshot Json @default("{}")
  ipHash String?
}

model RateLimit {
  key String @id
  count Int
  expiresAt DateTime
  id String @unique @default(dbgenerated("gen_random_uuid()::text"))
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @db.Timestamptz(6)
  version Int @default(1)
}

enum PublishStatus {
  DRAFT
  REVIEW
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum Visibility {
  PUBLIC
  MEMBER
}

enum CourseFormat {
  VIDEO
  AUDIO
  LIVE
  COHORT
  OFFLINE
}

enum ProductType {
  PHYSICAL
  DIGITAL
  SERVICE
}

model Teacher {
  id String @id @default(uuid())
  version Int @default(1)
  name String
  title String
  bio String
  portrait String?
  expertise String[]
  status PublishStatus @default(DRAFT)
  isDemo Boolean @default(false)
  courses Course[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  resourceKind String @default("TEACHER")
  userId String?
  lineageSummary String?
  achievementSummary String?
  teachingDirection String @default("")
  servicePolicy String?
  portraitAssetId String?
}

model Article {
  id String @id @default(uuid())
  version Int @default(1)
  title String
  summary String
  category String
  author String
  source String
  cover String
  blocks Json
  tags String[]
  visibility Visibility @default(PUBLIC)
  membershipTier Int @default(1)
  status PublishStatus @default(DRAFT)
  isDemo Boolean @default(false)
  featured Boolean @default(false)
  publishedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, publishedAt])
  resourceKind String @default("ARTICLE")
  authorDisplay String @default("")
  authorUserId String?
  currentReleaseId String?
  draftSourceSnapshot Json @default("{}")
  draftTemplateCode String?
}

model Course {
  memberDiscountEligible Boolean @default(false)
  earlyAccessAt DateTime? @db.Timestamptz(6)
  publicOpenAt DateTime? @db.Timestamptz(6)
  id String @id @default(uuid())
  version Int @default(1)
  publishedReleaseId String?
  membershipTier Int?
  accessDays Int?
  refundPolicy String @default("未开始学习可申请退款，具体以订单售前规则为准")
  title String
  subtitle String
  description String
  category String
  format CourseFormat @default(VIDEO)
  cover String
  price Int
  chaptersCount Int @default(0)
  durationMinutes Int @default(0)
  tags String[]
  teacherId String
  teacher Teacher @relation(fields: [teacherId], references: [id])
  chapters CourseChapter[]
  releases CourseRelease[]
  enrollments Enrollment[]
  status PublishStatus @default(DRAFT)
  featured Boolean @default(false)
  isDemo Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, category])
  resourceKind String @default("COURSE")
  completionPolicy Json @default("{}")
}

enum LessonFormat {
  TEXT
  VIDEO
  AUDIO
  LIVE
  OFFLINE
}

model CourseChapter {
  eventSessionId String?
  id String @id @default(uuid())
  courseId String
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title String
  position Int
  format LessonFormat
  body String @default("")
  mediaId String?
  liveSessionId String?
  durationSeconds Int @default(0)
  trial Boolean @default(false)
  required Boolean @default(true)
  @@unique([courseId, position])
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @db.Timestamptz(6)
  version Int @default(1)
  stableKey String @default(dbgenerated("gen_random_uuid()::text"))
  archivedAt DateTime? @db.Timestamptz(6)
  subtitleText String @default("")
}

model CourseRelease {
  memberPolicySnapshot Json @default("{}")
  id String @id @default(uuid())
  courseId String
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  version Int
  title String
  lessons Lesson[]
  enrollments Enrollment[]
  createdAt DateTime @default(now())
  @@unique([courseId, version])
  descriptionSnapshot String @default("")
  teacherSnapshot Json @default("{}")
  accessDays Int?
  refundPolicySnapshot Json @default("{}")
  completionPolicySnapshot Json @default("{}")
  withdrawnAt DateTime? @db.Timestamptz(6)
  withdrawalReason String?
  replacementReleaseId String?
  deliveryVersion Int @default(1)
}

model CourseVersionChoice {
  id String @id @default(uuid())
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  userId String
  enrollmentId String
  grantKey String
  courseId String
  fromReleaseId String
  toReleaseId String
  requestKey String
  requestHash String
  action String
  consentSnapshot Json
  @@unique([userId, requestKey])
  @@index([enrollmentId, createdAt])
}

model Lesson {
  id String @id @default(uuid())
  releaseId String
  release CourseRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  sourceId String
  title String
  position Int
  format LessonFormat
  body String
  mediaId String?
  durationSeconds Int
  trial Boolean
  required Boolean
  progress StudyProgress[]
  events StudyEvent[]
  @@unique([releaseId, position])
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  liveSessionId String?
  eventSessionId String?
  subtitleText String @default("")
}

model Enrollment {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId String
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  releaseId String
  release CourseRelease @relation(fields: [releaseId], references: [id])
  source String
  expiresAt DateTime?
  revokedAt DateTime?
  createdAt DateTime @default(now())
  @@unique([userId, courseId])
  @@unique([id, userId, courseId])
  updatedAt DateTime @default(now()) @db.Timestamptz(6)
  version Int @default(1)
  cohortId String?
  orderItemId String?
  grantKey String @default(dbgenerated("gen_random_uuid()::text"))
  startsAt DateTime @default(now()) @db.Timestamptz(6)
  grantActorId String?
  grantReason String?
  startedAt DateTime? @db.Timestamptz(6)
}

model MembershipPlan {
  id String @id @default(uuid())
  title String
  tier Int
  days Int
  price Int
  description String
  active Boolean @default(false)
  memberships Membership[]
  @@unique([tier, days])
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @db.Timestamptz(6)
  version Int @default(1)
  code String @default(dbgenerated("gen_random_uuid()::text"))
  currentVersionId String?
}

model Membership {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId String
  plan MembershipPlan @relation(fields: [planId], references: [id])
  tier Int
  startsAt DateTime
  endsAt DateTime
  source String
  revokedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId, startsAt, endsAt])
  updatedAt DateTime @default(now()) @db.Timestamptz(6)
  version Int @default(1)
  planVersionId String?
  orderItemId String?
  grantKey String @default(dbgenerated("gen_random_uuid()::text"))
  actorId String?
  reason String?
}

model StudyProgress {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId String
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  positionSeconds Int @default(0)
  watchedSeconds Int @default(0)
  completedAt DateTime?
  updatedAt DateTime @updatedAt
  @@unique([userId, lessonId])
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  version Int @default(1)
  lastEventAt DateTime? @db.Timestamptz(6)
  deviceId String?
}

model StudyEvent {
  offlineRegistrationId String?
  id String @id
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId String
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  payloadHash String
  result Json
  createdAt DateTime @default(now())
  receivedAt DateTime @default(now()) @db.Timestamptz(6)
  cohortRegistrationId String?
}

model MediaAsset {
  id String @id @default(uuid())
  storageKey String @unique
  name String
  mime String
  bytes Int
  uploaderId String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @db.Timestamptz(6)
  version Int @default(1)
  sha256 String @default("")
  status String @default("")
  visibility String @default("")
  durationSeconds Int?
  providerAssetId String?
  variants Json @default("{}")
  failureCode String?
}

model MediaUpload {
  id String @id @default(uuid())
  uploaderId String
  purpose String @default("COURSE")
  forumSectionId String?
  fingerprint String
  name String
  mime String
  bytes Int
  receivedBytes Int @default(0)
  state String @default("UPLOADING")
  assetId String? @unique
  attempts Int @default(0)
  leaseUntil DateTime? @db.Timestamptz(6)
  leaseToken String?
  failure String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  expiresAt DateTime @db.Timestamptz(6)
  @@index([uploaderId, fingerprint, state])
  @@index([state, leaseUntil])
  @@index([purpose, expiresAt])
}

model Product {
  id String @id @default(uuid())
  version Int @default(1)
  title String
  subtitle String
  description String
  category String
  type ProductType @default(PHYSICAL)
  cover String
  price Int
  culturalOrigin String
  status PublishStatus @default(DRAFT)
  featured Boolean @default(false)
  memberDiscountEligible Boolean @default(false)
  isDemo Boolean @default(false)
  skus ProductSku[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, category])
  resourceKind String @default("PRODUCT")
  partnerId String?
  deliveryTemplateId String?
  afterSalesPolicy Json @default("{}")
}

model ProductSku {
  id String @id @default(uuid())
  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  title String
  price Int
  stock Int @default(0)
  reserved Int @default(0)
  active Boolean @default(false)
  version Int @default(1)
  cartItems CartItem[]
  orderItems OrderItem[]
  @@index([productId, active])
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @db.Timestamptz(6)
  code String @default(dbgenerated("gen_random_uuid()::text"))
  specs Json @default("{}")
  digitalReleaseId String?
  serviceOfferingId String?
  signedCopy Boolean @default(false)
}

// Pending reservations only. No endpoint can mark an order as paid until
// verified channel transactions and fulfilment are installed.
enum OrderStatus {
  PENDING
  CLOSED
}

model DeliveryZone {
  priorityFee Int?
  priorityDescription String?
  priorityUntil DateTime? @db.Timestamptz(6)
  priorityProofAssetId String?
  province String @id
  fee Int
  surcharge Int @default(0)
  freeAbove Int?
  enabled Boolean @default(false)
  version Int @default(1)
}

model Order {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id])
  requestId String
  requestHash String
  status OrderStatus @default(PENDING)
  address Json
  subtotal Int
  shipping Int
  total Int
  quoteId String
  expiresAt DateTime
  closedAt DateTime?
  closeReason String?
  createdAt DateTime @default(now())
  items OrderItem[]
  @@unique([userId, requestId])
  @@index([status, expiresAt])
  @@index([userId, createdAt])
}

model OrderItem {
  id String @id @default(uuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  skuId String
  sku ProductSku @relation(fields: [skuId], references: [id])
  productId String
  title String
  skuTitle String
  cover String
  unitPrice Int
  quantity Int
  subtotal Int
  @@unique([orderId, skuId])
}

model CartItem {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  skuId String
  sku ProductSku @relation(fields: [skuId], references: [id], onDelete: Cascade)
  quantity Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([userId, skuId])
  version Int @default(1)
  offerId String @default("")
}

model Address {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipient String
  phone String
  province String
  city String
  district String
  detail String
  isDefault Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId, isDefault])
  version Int @default(1)
  recipientCipher String @default("")
  phoneCipher String @default("")
  provinceCode String @default("")
  cityCode String @default("")
  districtCode String @default("")
  detailCipher String @default("")
}

model Event {
  id String @id @default(uuid())
  title String
  description String
  category String
  studyTour Boolean @default(false)
  studyTourBrief String @default("")
  cover String
  location String
  startsAt DateTime
  endsAt DateTime
  capacity Int
  price Int
  status PublishStatus @default(DRAFT)
  isDemo Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, startsAt])
  version Int @default(1)
  resourceKind String @default("EVENT")
  organizerPartnerId String?
  teacherId String?
  cancelPolicy Json @default("{}")
  responsibleUserId String
}

model AuthIdentity {
  id String @id @default(dbgenerated("gen_random_uuid()::text"))
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @db.Timestamptz(6)
  version Int @default(1)
  userId String
  provider String
  appScope String
  subjectHash String
  unionSubjectHash String?
  verifiedAt DateTime @db.Timestamptz(6)
  refreshCipher String?
}

model SocialChallenge {
  id String @id @default(uuid())
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  provider String
  appScope String
  stateHash String
  userId String?
  sessionId String?
  codeHash String? @unique
  subjectHash String?
  refreshCipher String?
  verifiedAt DateTime? @db.Timestamptz(6)
  finishedAt DateTime? @db.Timestamptz(6)
  expiresAt DateTime @db.Timestamptz(6)
  @@index([expiresAt])
}

model AccessRole {
  id String @id @default(dbgenerated("gen_random_uuid()::text"))
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @db.Timestamptz(6)
  version Int @default(1)
  code String @unique
  name String
  permissionCodes String[] @default([])
  active Boolean @default(true)
}

model UserRole {
  id String @id @default(dbgenerated("gen_random_uuid()::text"))
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @db.Timestamptz(6)
  version Int @default(1)
  userId String
  roleId String
  grantedBy String
  reason String
  revokedAt DateTime? @db.Timestamptz(6)
}

model Tag {
  id String @id @default(dbgenerated("gen_random_uuid()::text"))
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @db.Timestamptz(6)
  version Int @default(1)
  code String @unique
  name String
  parentId String?
  active Boolean @default(true)
}

model UserTag {
  id String @id @default(dbgenerated("gen_random_uuid()::text"))
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  userId String
  tagId String
}

model ConsentRecord {
  id String @id @default(dbgenerated("gen_random_uuid()::text"))
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  userId String
  policyCode String
  policyVersion String
  purpose String
  accepted Boolean
  actedAt DateTime @db.Timestamptz(6)
  source String
}

model MemberGiftPool {
  id String @id @default(dbgenerated("gen_random_uuid()::text"))
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @db.Timestamptz(6)
  version Int @default(1)
  skuId String
  offerId String @unique
  title String
  description String
  proofAssetId String
  creatorId String
  capacity Int
  allocated Int @default(0)
  claimed Int @default(0)
  released Int @default(0)
  state String @default("OPEN")
}

model MemberGiftAllocation {
  id String @id @default(dbgenerated("gen_random_uuid()::text"))
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @db.Timestamptz(6)
  version Int @default(1)
  poolId String
  userId String
  sourceKey String @unique
  orderItemId String? @unique
  membershipId String? @unique
  expiresAt DateTime @db.Timestamptz(6)
  state String @default("HELD")
}

model MemberGiftClaim {
  id String @id @default(dbgenerated("gen_random_uuid()::text"))
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @db.Timestamptz(6)
  version Int @default(1)
  allocationId String
  userId String
  orderId String @unique
  usageId String @unique
  requestKey String
  requestHash String
  state String @default("FULFILLING")
  returnPreviousState String?
  returnReason String?
  returnInstructionsCipher String?
  returnCarrier String?
  returnTrackingNo String?
  returnProofAssetId String?
  @@unique([userId,requestKey])
}

model Resource {
  id String @id @default(dbgenerated("gen_random_uuid()::text"))
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @db.Timestamptz(6)
  version Int @default(1)
  kind String
  title String
  summary String @default("")
  coverAssetId String?
  ownerId String?
  publishState String @default("DRAFT")
  visibility String @default("PUBLIC")
  membershipTier Int?
  categoryCode String
  isDemo Boolean @default(false)
  featuredRank Int?
  publishedAt DateTime? @db.Timestamptz(6)
}

model ResourceTag {
  id String @id @default(dbgenerated("gen_random_uuid()::text"))
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  resourceId String
  tagId String
}

model SourceEvidence {
  id String @id @default(dbgenerated("gen_random_uuid()::text"))
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @db.Timestamptz(6)
  version Int @default(1)
  kind String
  title String
  author String?
  edition String?
  sourceUrl String?
  proofAssetId String?
  rightsHolder String?
  licenseScope String?
  validFrom DateTime? @db.Timestamptz(6)
  validUntil DateTime? @db.Timestamptz(6)
  reviewState String
  reviewerId String?
  reviewNote String?
}

model ResourceEvidence {
  id String @id @default(dbgenerated("gen_random_uuid()::text"))
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  resourceId String
  evidenceId String
  purpose String
}

model ContentRelation {
  id String @id @default(dbgenerated("gen_random_uuid()::text"))
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @db.Timestamptz(6)
  version Int @default(1)
  fromId String
  toId String
  relationType String
  rank Int @default(0)
  startsAt DateTime? @db.Timestamptz(6)
  endsAt DateTime? @db.Timestamptz(6)
  approvedBy String?
}

model ArticleRelease {
  id String @id @default(dbgenerated("gen_random_uuid()::text"))
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  articleId String
  releaseNo Int
  sourceSnapshot Json
  authorSnapshot Json
  reviewerId String
  templateCode String @default("PLAIN")
  publishedAt DateTime @db.Timestamptz(6)
